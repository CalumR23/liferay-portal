	And the ticket with keywords "Renewal Subscription(s) for Korzen - ${staticProjectName}" should have the product "prd_provisioning_request"
	And the ticket with keywords "Renewal Subscription(s) for Korzen - ${staticProjectName}" should have the provisioning component "opportunity_invoiced"
