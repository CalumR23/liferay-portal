<html>
<head>
<title>LiferayUniversityPassportAccess</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LiferayUniversityPassportAccess</td></tr>
</thead>
<tbody>
<tr>
	<td>HEADER</td>
	<td>//h1[contains(.,'Liferay University Passport Access')]</td>
	<td></td>
</tr>
<tr>
	<td>END_USER_FIRST_NAME</td>
	<td>//input[contains(@name,'PassportAccessPortlet_endUserFirstName')]</td>
	<td></td>
</tr>
<tr>
	<td>END_USER_LAST_NAME</td>
	<td>//input[contains(@name,'PassportAccessPortlet_endUserLastName')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME</td>
	<td>//input[contains(@name,'PassportAccessPortlet_companyName')]</td>
	<td></td>
</tr>
<tr>
	<td>END_USER_EMAIL_ADDRESS</td>
	<td>//input[contains(@name,'PassportAccessPortlet_endUserWorkEmailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>END_USER_AGREE_TO_TERMS_AND_CONDITIONS_CHECKBOX</td>
	<td>//input[contains(@name,'PassportAccessPortlet_agreement')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[contains(.,'Submit')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>