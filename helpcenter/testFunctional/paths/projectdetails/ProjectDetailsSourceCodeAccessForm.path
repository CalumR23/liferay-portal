<html>
<head>
<title>ProjectDetailsSourceCodeAccessForm</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectDetailsSourceCodeAccessForm</td></tr>
</thead>

<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>NAME_FIELD</td>
	<td>//input[contains(@id,'fullName')]</td>
	<td></td>
</tr>
<tr>
	<td>NAME_FIELD_ERROR</td>
	<td>//input[contains(@id,'fullName')]//following-sibling::div[contains(@class,'form-feedback-item-error')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD_ERROR</td>
	<td>//input[contains(@id,'emailAddress')]//following-sibling::div[contains(@class,'form-feedback-item-error')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_USERNAME_FIELD</td>
	<td>//input[contains(@id,'gitHubUserName')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_USERNAME_FIELD_ERROR</td>
	<td>//input[contains(@id,'gitHubUserName')]//following-sibling::div[contains(@class,'form-feedback-item-error')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[contains(.,'Submit')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>MESSAGE_TITLE</td>
	<td>//div[@class='modal-body-title']</td>
	<td></td>
</tr>
<tr>
	<td>MESSAGE_BODY</td>
	<td>//div[contains(@class,'modal-body-text')]</td>
	<td></td>
</tr>
<tr>
	<td>MESSAGE_GITHUB_LINK</td>
	<td>//div[contains(@class,'modal-body-text')]/a</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//button[contains(.,'Close')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>