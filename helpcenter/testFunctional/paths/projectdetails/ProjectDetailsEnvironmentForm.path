<html>
<head>
<title>ProjectDetailsEnvironmentForm</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectDetailsEnvironmentForm</td></tr>
</thead>

<tbody>
<tr>
	<td>NAME_FIELD</td>
	<td>//input[contains(@id,'accountEnvironmentName')]</td>
	<td></td>
</tr>
<tr>
	<td>NAME_FIELD_EMPTY</td>
	<td>//input[contains(@id,'accountEnvironmentName') and @value='']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@id,'accountEnvironmentProduct')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMERCE_VERSION_SELECT</td>
	<td>//select[contains(@id,'envCommerce')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_VERSION_SELECT</td>
	<td>//select[contains(@id,'envLFR')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_VERSION_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envLFR') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>OPERATING_SYSTEM_SELECT</td>
	<td>//select[contains(@id,'envOS')]</td>
	<td></td>
</tr>
<tr>
	<td>OPERATING_SYSTEM_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envOS') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>JAVA_VERSION_SELECT</td>
	<td>//select[contains(@id,'envJVM')]</td>
	<td></td>
</tr>
<tr>
	<td>JAVA_VERSION_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envJVM') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>APPLICATION_SERVER_SELECT</td>
	<td>//select[contains(@id,'envAS')]</td>
	<td></td>
</tr>
<tr>
	<td>APPLICATION_SERVER_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envAS') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>DATABASE_SELECT</td>
	<td>//select[contains(@id,'envDB')]</td>
	<td></td>
</tr>
<tr>
	<td>DATABASE_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envDB') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>CLOUD_SERVICES_SELECT</td>
	<td>//select[contains(@id,'envCS')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOUD_SERVICES_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envCS') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSER_SELECT</td>
	<td>//select[contains(@id,'envBrowser')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSER_SELECT_DISABLED</td>
	<td>//select[contains(@id,'envBrowser') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_SELECT_OPTION</td>
	<td>//select[contains(@id,'envSearch')]/option[@label='${key_option}']</td>
	<td></td>
</tr>
<tr>
	<td>PORTAL_EXT_UPLOAD_FIELD</td>
	<td>//input[contains(@id,'portalExt')]</td>
	<td></td>
</tr>
<tr>
	<td>PATCH_LEVEL_UPLOAD_FIELD</td>
	<td>//input[contains(@id,'patchLevel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>