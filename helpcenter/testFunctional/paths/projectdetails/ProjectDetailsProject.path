<html>
<head>
<title>ProjectDetailsProject</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectDetailsProject</td></tr>
</thead>
<tbody>
<tr>
	<td>PROJECT_HEADER</td>
	<td>//h1[contains(.,'${key_projectName}')]</td>
	<td></td>
</tr>
<tr>
	<td>OVERVIEW_TAB</td>
	<td>//li[contains(@class,'tab') and @data-tab-name='overview']/a</td>
	<td></td>
</tr>
<tr>
	<td>OVERVIEW_TAB_ACTIVE</td>
	<td>//li[contains(@class,'tab active') and @data-tab-name='highlights']/a</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_MEMBERS_TAB</td>
