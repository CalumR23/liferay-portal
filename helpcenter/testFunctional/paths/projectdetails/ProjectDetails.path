<html>
<head>
<title>ProjectDetails</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectDetails</td></tr>
</thead>

<tbody>
<tr>
	<td>PROJECT_DETAILS_HEADER</td>
	<td>//h1[contains(.,'Select a Project')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PROJECT_RESULTS-->

<tr>
	<td>NAME_COLUMN_LABEL</td>
	<td>//th[@class='lfr-name-column project-name']</td>
	<td></td>
</tr>
<tr>
	<td>STATE_COLUMN_LABEL</td>
	<td>//th[@class='lfr-state-column']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NAME</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[contains(@class,'lfr-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_STATE</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[contains(@class,'lfr-state-column')]/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>