<html>
<head>
<title>UserAccount</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">UserAccount</td></tr>
</thead>

<tbody>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--DETAILS-->

<tr>
	<td>TITLE_SELECT</td>
	<td>//select[contains(@name,'prefix')]</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_NAME_FIELD</td>
	<td>//input[contains(@name,'screenName')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[@name='_2_emailAddress']</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[contains(@name,'firstName')]</td>
	<td></td>
</tr>
<tr>
	<td>MIDDLE_NAME_FIELD</td>
	<td>//input[contains(@name,'middleName')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[contains(@name,'lastName')]</td>
	<td></td>
</tr>
<tr>
	<td>SUFFIX_SELECT</td>
	<td>//select[contains(@name,'suffix')]</td>
	<td></td>
</tr>
<tr>
	<td>GENDER_SELECT</td>
	<td>//select[contains(@name,'male')]</td>
	<td></td>
</tr>
<tr>
	<td>JOB_TITLE_FIELD</td>
	<td>//input[contains(@name,'jobTitle')]</td>
	<td></td>
</tr>
<tr>
	<td>PREFERRED_NAME_FIELD</td>
	<td>//input[@id='pqai_osbNickname']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[contains(@name,'osbCountry')]</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_FIELD</td>
	<td>//input[@id='eada_osbPhoneNumber']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PHONE_NUMBER-->

<tr>
	<td>NUMBER_FIELD</td>
	<td>//input[contains(@name,'phoneNumber')]</td>
	<td></td>
</tr>
<tr>
	<td>EXTENSION_FIELD</td>
	<td>//input[contains(@name,'phoneExtension')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_SELECT</td>
	<td>//select[contains(@name,'phoneTypeId')]</td>
	<td></td>
</tr>
<tr>
	<td>PRIMARY_BUTTON</td>
	<td>//input[contains(@name,'phonePrimary')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PASSWORD-->

<tr>
	<td>NEW_PASSWORD_FIELD</td>
	<td>//input[contains(@name,'password1')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTER_AGAIN_FIELD</td>
	<td>//input[contains(@name,'password2')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>