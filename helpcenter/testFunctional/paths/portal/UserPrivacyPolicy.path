<html>
<head>
<title>UserPrivacyPolicy</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">UserPrivacyPolicy</td></tr>
</thead>

<tbody>
<tr>
	<td>COMPANY_FIELD</td>
	<td>//input[contains(@id,'osbCompany')]</td>
	<td></td>
</tr>
<tr>
	<td>DEPARTMENT_SELECT</td>
	<td>//select[contains(@name,'osbDepartment')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT</td>
	<td>//select[contains(@name,'osbCompanyRole')]</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRY_SELECT</td>
	<td>//select[contains(@name,'osbIndustry')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[contains(@name,'osbCountry')]</td>
	<td></td>
</tr>
<tr>
	<td>HOW_DID_YOU_HEAR_ABOUT_LIFERAY_SELECT</td>
	<td>//select[contains(@name,'osbHowDidYouHearAboutLiferay')]</td>
	<td></td>
</tr>
<tr>
	<td>AGREE_TO_TERMS_OF_USE_CHECKBOX</td>
	<td>//input[contains(@name,'agreedToTermsOfUseCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_ACCOUNT_BUTTON</td>
	<td>//input[@value='Update Account']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>