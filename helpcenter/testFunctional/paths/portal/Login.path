<html>
<head>
<title>Login</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Login</td></tr>
</thead>

<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'LoginPortlet_login')] | //input[contains(@id,'58_login')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[contains(@id,'LoginPortlet_password')] | //input[contains(@id,'58_password')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'Sign In')] | //input[@value='Sign In']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>