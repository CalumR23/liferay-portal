<html>
<head>
<title>LCSSupport</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LCSSupport</td></tr>
</thead>
<tbody>
<tr>
	<td>CORP_PROJECT_ID_FIELD</td>
	<td>//input[contains(@name,'SupportAdminPortlet_corpProjectId')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//button[contains(.,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_ROW</td>
	<td>//tr[contains(.,'${key_projectName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NAME</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CORP_PROJECT_ID</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SUBSCRIPTION_TYPE</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SERVERS_USED</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SERVERS_ALLOWED</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SUBSCRIPTION_END_DATE</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_SUPPORT_END_DATE</td>
	<td>//tr[contains(.,'${key_projectName}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>