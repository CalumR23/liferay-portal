<html>
<head>
<title>OSBAdminProjectUsers</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminProjectUsers</td></tr>
</thead>
<tbody>
<tr>
	<td>CURRENT_TAB</td>
	<td>//li[contains(@class,'tab')]/a[contains(.,'Current')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_TAB</td>
	<td>//li[contains(@class,'tab')]/a[contains(.,'Available')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_ASSOCIATIONS_BUTTON</td>
	<td>//button[contains(.,'Update Associations')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SEARCH RESULT -->
<tr>
	<td>SEARCH_RESULT_ALL_ROWS_CHECKBOX</td>
	<!-- Update path when LRIS-29476 is done -->
	<td>//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_CHECKBOX</td>
	<td>//tr[contains(.,'${key_emailAddress}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_EMAIL_ADDRESS</td>
	<td>//tr/td[contains(@class,'email-address') and contains(.,'${key_emailAddress}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ROLE_SELECT</td>
	<td>//tr[contains(.,'${key_emailAddress}')]//select[contains(@name,'role')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>