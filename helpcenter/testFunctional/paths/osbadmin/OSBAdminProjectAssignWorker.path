	<td>ROLE_SELECT</td>
	<td>//select[contains(@id,'role')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//a[contains(@href,'updateAccountWorker')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_WORKER_EMAIL</td>
	<td>//td[contains(@class,'email-address-column') and contains(.,'${key_email}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_BUTTON</td>
	<td>//td[contains(@class,'action')]//a[contains(.,'Action')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_WORKER_ROLE_SELECT</td>
	<td>//tr[contains(.,'${key_emailAddress}')]//select[contains(@id,'osbportlet_role')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_WORKER_ACTION_BUTTON</td>
	<td>//tr[contains(.,'${key_emailAddress}')]//td[contains(@class,'action')]//a[contains(.,'Action')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_MENU_ITEM</td>
	<td>//a/span[text()='Update']</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_MENU_ITEM</td>
	<td>//a/span[text()='Remove']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>