</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>//tr[contains(.,'${key_productName}')]/td[contains(@class,'lfr-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_ACTIONS_MENU</td>
	<td>//tr[contains(.,'${key_productName}')]/td[contains(@class,'lfr-entry-action-column')]//a</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_MENU_ITEM</td>
	<td>//a/span[text()='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_MENU_ITEM</td>
	<td>//a/span[text()='Delete']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>