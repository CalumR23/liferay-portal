<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminSalesOrderDetail</td></tr>
</thead>

<tbody>
<tr>
	<td>START_DATE_FIELD</td>
	<td>//input[contains(@id,'startDate')]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWED_COUNT</td>
	<td>//td[contains(.,'Renewed Count')]</td>
	<td></td>
</tr>
<tr>
	<td>RENEW_SUPPORT_BUTTON</td>
	<td>//button/span[text()='Renew Support']</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_SUPPORT_TICKETS_CHECKBOX</td>
	<td>//td[contains(.,'${key_product}')]//..//input[contains(@name,'supportTickets')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_SUPPORT_LIFETIME_SELECT</td>
	<td>//td[contains(.,'${key_product}')]//..//select[contains(@name,'supportLifetime')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_SUPPORT_END_DATE</td>
	<td>//td[contains(.,'${key_product}')]//..//td[contains(@class,'support-end-date')]</td>
