</tr>
<tr>
	<td>RESULT_ROW_VERSION_SELECT</td>
	<td>//td[contains(.,'${key_product}')]//..//select[contains(@name,'version')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>