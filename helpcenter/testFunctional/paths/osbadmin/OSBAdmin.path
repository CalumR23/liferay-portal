<html>
<head>
<title>OSBAdmin</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdmin</td></tr>
</thead>

<tbody>
<tr>
	<td>OSB_ADMIN_TITLE</td>
	<td>//*[@data-qa-id='headerTitle'] and contains(.,'OSB Admin')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//a[contains(.,'Projects')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNTS_TAB</td>
	<td>//a[contains(.,'Accounts')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNERS_TAB</td>
	<td>//a[contains(.,'Partners')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTITLEMENTS_TAB</td>
	<td>//a[contains(.,'Entitlements')]</td>
	<td></td>
</tr>
<tr>
	<td>SALES_TAB</td>
	<td>//a[contains(.,'Sales')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_TAB</td>
	<td>//a[contains(.,'Support')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PROJECT_BUTTON</td>
	<td>//a[contains(@class,'btn') and text()='Add Project']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PARTNER_BUTTON</td>
	<td>//a[contains(@class,'btn') and text()='Add Partner']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SEARCH_TOGGLE-->

<tr>
	<td>SEARCH_TOGGLE_CARET</td>
	<td>//button[contains(@class,'toggle-advanced')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--BASIC SEARCH-->

<tr>
	<td>BASIC_SEARCH_KEYWORD_FIELD</td>
	<td>//input[contains(@id,'searchkeywords')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ADVANCED SEARCH-->

<tr>
	<td>ADVANCED_SEARCH_EXPANDED</td>
	<td>//div[contains(@class,'toggler-content-expanded')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_KORONEIKI_ACCOUNT_KEY_FIELD</td>
	<td>//input[contains(@id,'koroneikiAccountKey')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_SUPPORT_SELECT</td>
	<td>//select[contains(@id,'support')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_HAS_EXPIRED_SUPPORT_SELECT</td>
	<td>//select[contains(@id,'expiredSupport')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_STATUS_SELECT</td>
	<td>//select[contains(@id,'statuses')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SEARCH RESULT-->

<tr>
	<td>SEARCH_RESULT_FIRST_ROW_PROJECT_NAME</td>
	<td>//tr[@data-qa-id='row']//td[contains(@class,'project-name')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_FIRST_ROW_STATUS</td>
	<td>//tr[@data-qa-id='row']//td[contains(@class,'status')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_FIRST_EXPIRED_PROJECT_NAME</td>
	<td>//tr/td[contains(@class,'status')]/a[text()=' Expired ']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_NAME</td>
	<td>//tr[contains(.,'${key_name}')]//td[contains(@class,'name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_PROJECT</td>
	<td>//tr[contains(.,'${key_name}')]//td[contains(@class,'project-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_PROJECT_NAME</td>
	<td>//tr[contains(.,'${key_name}')]//td[contains(@class,'project-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_CODE</td>
	<td>//td[contains(@class,'code')]/a[.='${key_code}']/parent::td/parent::tr//td[contains(@class,'code')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_STATUS</td>
	<td>//td[contains(@class,'code')]/a[.='${key_code}']/parent::td/parent::tr//td[contains(@class,'status-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_EMAIL</td>
	<td>//tr[contains(.,'${key_code}')]//td[contains(@class,'email')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_BUTTON</td>
	<td>//td[contains(@class,'code')]/a[.='${key_code}']/parent::td/parent::tr//a[contains(.,'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_BUTTON_VIA_NAME</td>
	<td>//tr[contains(.,'${key_name}')]//a[contains(.,'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_MENU_DELETE</td>
	<td>//a[contains(@id,'menu__delete')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>