<html>
<head>
<title>Koroneiki</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Koroneiki</td></tr>
</thead>

<tbody>
<tr>
	<td>HOME_LINK</td>
	<td>//a[@href='https://webserver-lrkoroneiki-uat.lfr.cloud']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_ENTITY_BUTTON</td>
	<td>//*[local-name()='svg' and contains(@class,'plus')]/parent::a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ENTITY_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_entityName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTITY_ACTIONS_LINK</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_entityName}')]/td[contains(@class,'lfr-entry-action-column')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--MENULIST-->

<tr>
	<td>MENULIST_ACTION</td>
	<td>//a[@role='menuitem' and contains(.,'${key_action}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--TAB-->

<tr>
	<td>TAB</td>
	<td>//a[contains(@class,'nav-link') and contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>