<html>
<head>
<title>CustomerUser</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerUser</td></tr>
</thead>

<tbody>
<tr>
	<td>USER_NAME</td>
	<td>//div//*[.='Liferay Contact']/following-sibling::*[.='${key_userName}']</td>
	<td></td>
</tr>
<tr>
	<td>USER_EMAIL_ADDRESS</td>
	<td>//div//*[.='Liferay Contact']/following-sibling::*[.='${key_userEmailAddress}']</td>
	<td></td>
</tr>
<tr>
	<td>USER_ROLES</td>
	<td>//div//*[.='Liferay Contact']/following-sibling::*[.='${key_userRoles}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TEAM_MEMBER_VALUE</td>
	<td>//p[contains(.,'${key_teamMemberValue}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>