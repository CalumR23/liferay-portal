<html>
<head>
<title>CustomerActivationKey</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerActivationKey</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTIONS</td>
	<td>//button[text()="Actions"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_NEW_ACTIVATION_KEY</td>
	<td>//div[text()="Generate New"]</td>
	<td></td>
</tr>

<!--GENERATE_ACTIVATION_KEYS_FORM-->

<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_OPTION</td>
	<td>//*[@for='basicInput' and text()='${field}']/following-sibling::*//*[contains(@class, 'form-control')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_OPTION_DISABLED</td>
	<td>//label[text()='${field}']/following-sibling::*//*[@disabled]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_INPUT</td>
	<td>//input/ancestor::label[text()='${field} ']</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_TEXTAREA</td>
	<td>//textarea/ancestor::label[text()='${field} ']</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_SUBSCRIPTION</td>
	<td>//p[text()="${value}"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS_FORM_NEXT</td>
	<td>//button[text()="Next"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_ACTIVATION_KEYS</td>
	<td>//button[@class="btn btn-primary"]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>