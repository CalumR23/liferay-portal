<html>
<head>
<title>CustomerProject</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerProject</td></tr>
</thead>

<tbody>
<tr>
	<td>CUSTOMER_PROJECT_NAME</td>
	<td>//div//*[@title='${key_projectName}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_STATE</td>
	<td>//div//*[@title='${key_projectName}']//..//*[.='${key_projectState}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_ENDS_ON</td>
	<td>//div//*[@title='${key_projectName}']//..//*[.='${key_projectEndDate}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_CODE</td>
	<td>//div//*[@title='${key_projectName}']//*[.='${key_projectCode}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PROJECT_SUPPORT_REGION</td>
	<td>//div//*[@title='${key_projectName}']//..//*[.='${key_projectSupportRegion}']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_SEARCH_PROJECTS_FIELD</td>
	<td>//input[@placeholder='Find a project']</td>
	<td></td>
</tr>


</tbody>
</table>
</body>
</html>