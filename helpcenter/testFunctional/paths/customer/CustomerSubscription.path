<html>
<head>
<title>CustomerSubscription</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CustomerSubscription</td></tr>
</thead>

<tbody>
<tr>
	<td>SUBSCRIPTION_NAME</td>
	<td>//*[contains(.,"Support Level")]/..//div[contains(@class,"h5") and contains(.,'${key_subscriptionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DATE</td>
	<td>//*[contains(.,"Support Level")]/..//*[@title='06/30/2021 - 03/30/2023']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN</td>
	<td>//*[@class='dropdown']//*[@type='button']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ALL</td>
	<td>//*[@class='dropdown-item'][contains(text(),'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ALL_SELECTED</td>
	<td>//div[@class='dropdown']/button[@type='button' and contains(.,'All')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_ACTIVE</td>
	<td>//*[@class='dropdown-item'][contains(text(),'Active')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_EXPIRED</td>
	<td>//*[@class='dropdown-item'][contains(text(),'Expired')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DROPDOWN_FUTURE</td>
	<td>//*[@class='dropdown-item'][contains(text(),'Future')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_DETAILS_PAGE_TAB</td>
	<td>//button[contains(text(),'${key_subscriptionTab}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_ACTIVATION_TAB</td>
	<td>//button[contains(text(),'Product Activation')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION</td>
	<td>//button[contains(.,'${key_subscriptionActivationTab}')]/ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SELECT_FILTER</td>
	<td>//button[@value='${key_subscriptionFilter}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SELECT_HEADER</td>
	<td>//h6[@class='mr-2 my-auto']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>