<html>
<head>
<title>MyWorkflowTasks</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MyWorkflowTasks</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@name,'MyWorkflowTaskPortlet_keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_TO_MY_ROLES_TAB</td>
	<td>//a[@title='Assigned to My Roles']</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_TO_ME_TAB</td>
	<td>//a[@title='Assigned to Me']</td>
	<td></td>
</tr>
<tr>
	<td>OTHER_ASSIGNEES_TAB</td>
	<td>//a[@title='Other Assignees']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADVANCED_SEARCH-->
<tr>
	<td>ADVANCED_SEARCH_TOGGLE</td>
	<td>//button[contains(@id,'searchtoggleAdvanced')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_TOGGLE_EXPANDED</td>
	<td>//button[contains(@id,'searchtoggleAdvanced') and contains(@class,'expanded')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_MATCH_SELECT</td>
	<td>//select[contains(@id,'andOperator')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_PROJECT_CODE_FIELD</td>
	<td>//input[contains(@id,'accountEntryCode')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_PROJECT_NAME_FIELD</td>
	<td>//input[contains(@id,'accountEntryName')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_ASSIGNEE_TYPE_SELECT</td>
	<td>//select[contains(@id,'assigneeClassName')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_ROLE_NAME_FIELD</td>
	<td>//input[contains(@id,'roleName')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_USER_EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'userEmailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_COMPLETED_SELECT</td>
	<td>//select[contains(@id,'completed')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_OPPORTUNITY_TYPE_SELECT</td>
	<td>//select[contains(@id,'salesforceOpportunityType')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--WORKFLOW_INDEX-->
<tr>
	<td>ASSET_TITLE</td>
	<td>//tr[contains(.,'${key_assetTitle}')]/td[contains(@class,'asset-title')]/a</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_NEXT_PAGE_LINK</td>
	<td>//a/span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_NEXT_PAGE_LINK_DISABLED</td>
	<td>//li[@class='disabled']/a/span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>