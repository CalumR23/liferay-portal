<html>
<head>
<title>MyWorkflowTasksAsset</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyWorkflowTasksAsset</td></tr>
</thead>

<tbody>
<tr>
	<td>DROPDOWN_TOGGLE</td>
	<td>//a[contains(@class,'dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_TO_ME_LINK</td>
	<td>//a[contains(.,'Assign to Me')]</td>
	<td></td>
</tr>
<tr>
	<td>APPROVE_LINK</td>
	<td>//a[contains(.,'Approve')]</td>
	<td></td>
</tr>
<tr>
	<td>REJECT_LINK</td>
	<td>//a[contains(.,'Reject')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PROJECT_DETAILS-->

<tr>
	<td>WORKFLOW_TASK_TITLE</td>
	<td>//h3[@class='task-content-title']/span</td>
	<td></td>
</tr>
<tr>
	<td>WORKFLOW_TASK_HEADER</td>
	<td>//h1[@class='workflow-task-header']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DIFFERENCE_FIELD</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DIFFERENCE_OLD_VALUE</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DIFFERENCE_NEW_VALUE</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_PRODUCT</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[1] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_LICENSES</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[2] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_LICENSE_LIFETIME</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[3] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_SUPPORT_TICKETS</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[4] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_SLA</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[5] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_SUPPORT_LIFETIME</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[6] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_SUPPORT_END_DATE</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[7] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_VERSION</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[8] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_SIZING</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[9] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[9]</td>
	<td></td>
</tr>
<tr>
	<td>OFFERING_QUANTITY</td>
	<td>//h3[contains(.,'Order Summary')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[10] | //h3[contains(.,'Linked Pending Objects')]/following-sibling::table//tr[contains(.,'${key_product}')]/td[10]</td>
	<td></td>
</tr>
<tr>
	<td>WARNING_MESSAGE</td>
	<td>//h3[contains(.,'Warning Messages')]/following-sibling::ul/li[contains(.,'${key_warningMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>