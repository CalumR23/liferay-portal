<html>
<head>
<title>LargeFileUploader</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LargeFileUploader</td></tr>
</thead>
<tbody>
<tr>
	<td>HEADER</td>
	<td>//h1[contains(.,'Attach File to Ticket')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENT_FIELD</td>
	<td>//input[@class='attachment']</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENT_FIELD_ERROR_MESSAGE</td>
	<td>//div[contains(@class, 'alert-danger') and contains(.,'Error validating file attachment. Please re-upload file.')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENT_FILE_NAME</td>
	<td>//span[@class='attachment-name' and text()='${key_fileName}']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_FIELD</td>
	<td>//textarea[contains(@name,'comment')]</td>
	<td></td>
</tr>
<tr>
	<td>DATA_REGION_INFO_MESSAGE</td>
	<td>//div[@class='alert alert-info' and contains(.,'server')]</td>
	<td></td>
</tr>
<tr>
	<td>DATA_REGION_INFO_MESSAGE_FILE_UPLOAD_LOCATION</td>
	<td>//div[@class='alert alert-info' and contains(.,'server')]/span[contains(.,'Your file will be uploaded to a file server in')]</td>
	<td></td>
</tr>
<tr>
	<td>DATA_REGION_INFO_MESSAGE_ARTICLE_LINK</td>
	<td>//div[@class='alert alert-info' and contains(.,'server')]/div[contains(.,'Please note that the location of the server')]/a</td>
	<td></td>
</tr>
<tr>
	<td>NO_PERSONAL_DATA_CHECKBOX</td>
	<td>//input[contains(@name,'noPersonalData')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[text()='Submit']</td>
	<td></td>
</tr>
<tr>
	<td>CLEAR_BUTTON</td>
	<td>//button[text()='Clear']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>