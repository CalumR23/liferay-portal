<html>
<head>
<title>LargeFileUploader</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LargeFileUploader</td></tr>
</thead>
<tbody>
<tr>
	<td>HEADER</td>
	<td>//h1[contains(.,'Attach File to Ticket')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENT_FIELD</td>
	<td>//input[@class='attachment']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_FIELD</td>
	<td>//textarea[contains(@name,'comment')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[text()='Submit']</td>
	<td></td>
</tr>
<tr>
	<td>CLEAR_BUTTON</td>
	<td>//button[text()='Clear']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>