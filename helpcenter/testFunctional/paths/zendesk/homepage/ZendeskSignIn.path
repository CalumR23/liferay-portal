<html>
<head>
<title>ZendeskSignIn</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskSignIn</td></tr>
</thead>

<tbody>
<tr>
	<td>SIGN_IN_IFRAME</td>
	<td>//iframe[contains(@src,'login')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_FIELD</td>
	<td>//input[@id='user_email']</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[@id='user_password']</td>
	<td></td>
</tr>
<tr>
	<td>REMEMBER_ME_CHECKBOX</td>
	<td>//input[@id='remember_me']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//input[@value='Sign in']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>