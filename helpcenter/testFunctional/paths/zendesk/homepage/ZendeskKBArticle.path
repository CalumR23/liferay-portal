<html>
<head>
<title>ZendeskKBArticle</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskKBArticle</td></tr>
</thead>
<tbody>
<tr>
	<td>ARTICLE_TITLE</td>
	<td>//h1[@title='${key_articleTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>FAST_TRACK</td>
	<td>//aside[@class='initiative-blurb']/span[contains(.,'Fast Track')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_HEADER</td>
	<td>//section[@id='${key_articleSection}']/h2</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_CONTENT</td>
	<td>//section[@id='${key_articleSection}']/div | //section[@id='${key_articleSection}']/ul</td>
	<td></td>
</tr>
<tr>
	<td>GATED_SECTION</td>
	<td>//section[@id='${key_articleSection}' and @class='gated']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIBER_EXCLUSIVE_CONTENT_MESSAGE_TITLE</td>
	<td>//div[@class='gate-signin-prompt']/div[@class='small-title']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIBER_EXCLUSIVE_CONTENT_SUBSCRIPTION_MESSAGE_CONTENT</td>
	<td>//div[@class='gate-signin-prompt']/div[@class='gate-prompt-description subscription-required']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIBER_EXCLUSIVE_CONTENT_SIGN_IN_MESSAGE_CONTENT</td>
	<td>//div[@class='gate-signin-prompt']/div[@class='gate-prompt-description login-required']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIBER_EXCLUSIVE_CONTENT_SUBSCRIPTION_MESSAGE_LINK</td>
	<td>//div[@class='gate-signin-prompt']//a[@class='external-link-prompt']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIBER_EXCLUSIVE_CONTENT_SIGN_IN_MESSAGE_BUTTON</td>
	<td>//div[@class='gate-signin-prompt']/a[@class='btn btn-primary btn-sm']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html> 