<html>
<head>
<title>ZendeskKCApp</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskKCApp</td></tr>
</thead>

<tbody>
<tr>
	<td>KNOWLEDGE_CAPTURE_IFRAME</td>
	<td>//iframe[contains(@name,'app_Knowledge-Capture-App_ticket_sidebar')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ARTICLE_IFRAME</td>
	<td>//div[contains(@data-garden-id,'forms.input_group')]//input[contains(@data-garden-id,'forms.input')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ARTICLE_FIELD</td>
	<td>//input[contains(@data-test-id,'search-input')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_KNOWLEDGE_BUTTON</td>
	<td>//button[contains(@aria-label,'Create Knowledge')]</td>
	<td></td>
</tr>
<tr>
	<td>DXPC_FAST_TRACK_ARTICLE_TEMPLATE_LINK</td>
	<td>//a[contains(@data-garden-id,'buttons.anchor') and text()='DXPC Fast Track Article']</td>
	<td></td>
</tr>
<tr>
	<td>FAST_TRACK_ARTICLE_TEMPLATE_LINK</td>
	<td>//a[contains(@data-garden-id,'buttons.anchor') and text()='Fast Track Article']</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_CREATE_KNOWLEDGE_BUTTON</td>
	<td>//div[contains(@data-garden-id,'grid.col')]//button[contains(@data-garden-id,'buttons.button')]</td>
	<td></td>
</tr>
<tr>
	<td>GOT_IT_BUTTON</td>
	<td>//div//button[(text()='Got it')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ARTICLE-->

<tr>
	<td>SELECT_ARTICLE</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${key_articleName}')]//td//div//input</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${key_articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_NAME</td>
	<td>//div[contains(@data-garden-id,'notifications.title')]//h3[(text()='${key_articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_STATUS</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${key_articleName}')]//a/div[@title='${key_reviewStatus}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ARTICLE_SETTINGS-->

<tr>
	<td>ARTICLE_SETTINGS</td>
	<td>//button[contains(@data-garden-id, 'buttons.button')]//span[(text()='Article settings')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SETTINGS_DELETE_OPTION</td>
	<td>//li[text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SETTINGS_DELETE_BUTTON</td>
	<td>//button[contains(@data-garden-id,'buttons.button') and text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--KNOWLEDGE_CAPTURE_POPUP-->

<tr>
	<td>KNOWLEDGE_CAPTURE_POPUP_IFRAME</td>
	<td>//iframe[contains(@name,'app_Knowledge-Capture-App_modal')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_CAPTURE_POPUP_ARTICLE_NAME</td>
	<td>//article//h1[(text()='${key_articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_CAPTURE_POPUP_ARTICLE_DESCRIPTION</td>
	<td>//div/*[(text()='${key_articleDescription}')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_CAPTURE_POPUP_CLOSE_LINK</td>
	<td>//header[contains(@class,'modal-header')]//a[contains(@class,'close')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>