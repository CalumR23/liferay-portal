<html>
<head>
<title>ZendeskRequestIndex</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskRequestIndex</td></tr>
</thead>

<tbody>
<tr>
	<td>MY_REQUESTS_TAB</td>
	<td>//ul[@class='navbar-nav']/li/a[contains(.,'My requests')]</td>
	<td></td>
</tr>
<tr>
	<td>ORGANIZATION_REQUESTS_TAB</td>
	<td>//ul[@class='navbar-nav']/li/a[contains(.,'Organization requests')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@id='quick-search']</td>
	<td></td>
</tr>
<tr>
	<td>ORGANIZATION_SELECT</td>
	<td>//select[@name='organization_id']</td>
	<td></td>
</tr>
<tr>
	<td>ORGANIZATION_UNFOLLOW_BUTTON</td>
	<td>//a[@class='organization-unsubscribe']</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_SELECT</td>
	<td>//select[@name='status']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--REQUEST-->

<tr>
	<td>REQUEST_SUBJECT</td>
	<td>//tr[contains(.,'${key_requestSubject}')]/td[@class='request-info requests-table-info']/a</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_ID</td>
	<td>//tr[contains(.,'${key_requestSubject}')]/td[contains(.,'#')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_CREATED</td>
	<td>//tr[contains(.,'${key_requestSubject}')]/td/time</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_LAST_ACTIVITY</td>
	<td>//tr[contains(.,'${key_requestSubject}')]/td/time/parent::td/following-sibling::td/time</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_STATUS</td>
	<td>//tr[contains(.,'${key_requestSubject}')]/td[@class='requests-table-status']/span</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>