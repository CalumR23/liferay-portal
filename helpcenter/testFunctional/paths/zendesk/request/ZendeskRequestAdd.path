<html>
<head>
<title>ZendeskRequestAdd</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskRequestAdd</td></tr>
</thead>
<tbody>
<tr>
	<td>PLEASE_CHOOSE_YOUR_ISSUE_BELOW_LINK</td>
	<td>//label[contains(.,'Please choose your issue below')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>ORGANIZATION_DROPDOWN_LINK</td>
	<td>//label[contains(.,'Organization')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DROPDOWN_LINK</td>
	<td>//label[contains(.,'Product')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_DROPDOWN_LINK</td>
	<td>//label[contains(.,'Component')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>SYSTEM_STATUS_DROPDOWN_LINK</td>
	<td>//label[contains(.,'System Status')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_LINK</td>
	<td>//label[contains(.,'${key_dropdownLabel}')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>OPTION</td>
	<td>//div[@class='nesty-panel']/ul/li[contains(.,'${key_option}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBJECT_FIELD</td>
	<td>//label[contains(.,'Subject')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_FIELD_IFRAME</td>
	<td>//label[contains(.,'Description')]//following-sibling::div//iframe</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_FIELD</td>
	<td>//body[contains(@id,'tinymce')]//p</td>
	<td></td>
</tr>
<tr>
	<td>URGENT_FOR_PANDEMIC_RESPONSE_DROPDOWN_LINK</td>
	<td>//label[contains(.,'Urgent for Pandemic Response')]//following-sibling::a[@class='nesty-input']</td>
	<td></td>
</tr>
<tr>
	<td>LARGE_FILE_ATTACHMENT_WARNING</td>
	<td>//p[@id='request_description_hint']</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_FIELD_LINK</td>
	<td>//label[contains(.,'Attachments')]//following-sibling::div[@id='upload-dropzone']/span/a</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_FIELD</td>
	<td>//label[contains(.,'Attachments')]//following-sibling::div[@id='upload-dropzone']/input</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_FIELD_ERROR_MESSAGE</td>
	<td>//div[contains(@class, 'alert-danger')]//*[contains(.,'Error validating file attachment. Please re-upload file.')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//input[@value='Submit']</td>
	<td></td>
</tr>
<tr>
	<td>NO_ACCESS_MESSAGE_MAIN_TEXT</td>
	<td>//h2[contains(.,'We are sorry, but you do not have access to submit a support ticket.')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_ACCESS_MESSAGE_ADDITIONAL_TEXT</td>
	<td>//h4[contains(.,'Please contact your account administrator or email support.')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_ACCESS_MESSAGE_EMAIL_LINK</td>
	<td>//h4[contains(.,'Please contact your account administrator or email support.')]/a[@href='mailto:provisioning@liferay.com']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>