<html>
<head>
<title>ZendeskTicketView</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskTicketView</td></tr>
</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>ZendeskTicketAdd</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DISMISS_TICKET_INTERFACE_TOUR_LINK</td>
	<td>//button[.='Dismiss']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_SUBJECT</td>
	<td>//input[@name='subject']</td>
	<td></td>
</tr>
<tr>
	<td>DEADLINE_BUTTON</td>
	<td>//button[contains(@class,'small counting')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_COMMENT_AUTHOR</td>
	<td>//article[@data-test-id='omni-log-comment-item']/div[contains(.,'${key_commentContent}')]//span[@data-test-id='omni-log-item-sender']/a</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_LARGE_FILE_COMMENT_CONTENT</td>
	<td>//article[@data-test-id='omni-log-comment-item']/div[contains(.,'${key_commentContent}')]//div[@data-test-id='omni-log-item-message']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_LARGE_FILE_COMMENT_ATTACHMENT</td>
	<td>//article[@data-test-id='omni-log-comment-item']/div[contains(.,'${key_commentContent}')]//div[@data-test-id='omni-log-item-message']//a[contains(.,'${key_fileName}')]</td>
	<td></td>
</tr>
<tr>
	<td>APPS_BUTTON</td>
	<td>//button[contains(@title,'Apps')]</td>
	<td></td>
</tr>
<tr>
	<td>HIDE_APPS_BUTTON</td>
	<td>//button[contains(@title,'Apps') and contains(@aria-pressed,'true')]</td>
	<td></td>
</tr>
<tr>
	<td>LARGE_ATTACHMENT_IFRAME</td>
	<td>//iframe[contains(@name,'app_Large-File-Uploader')]</td>
	<td></td>
</tr>
<tr>
	<td>LARGE_ATTACHMENT_LINK</td>
	<td>//a[contains(.,'Add Large Files over 20 MB here')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>