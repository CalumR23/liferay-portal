<html>
<head>
<title>ZendeskTicketView</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskTicketView</td></tr>
</thead>
<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>ZendeskTicketAdd</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TICKET_SUBJECT</td>
	<td>//input[@name='subject']</td>
	<td></td>
</tr>
<tr>
	<td>DEADLINE_BUTTON</td>
	<td>//button[contains(@class,'small counting')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_COMMENT_AUTHOR</td>
	<td>//div[@class='ember-view audits']/div[contains(.,'${key_commentContent}')]//div[@class='actor']/span[@class='name']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_LARGE_FILE_COMMENT_CONTENT</td>
	<td>//div[@class='ember-view audits']/div[contains(.,'${key_commentContent}')]//div[@class='comment']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_LARGE_FILE_COMMENT_ATTACHMENT</td>
	<td>//div[@class='ember-view audits']/div[contains(.,'${key_commentContent}')]//div[@class='comment']//a[contains(.,'${key_fileName}')]</td>
	<td></td>
</tr>
<tr>
	<td>LARGE_ATTACHMENT_LINK</td>
	<td>//a[contains(.,'Add Large Files over 20 MB here')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>