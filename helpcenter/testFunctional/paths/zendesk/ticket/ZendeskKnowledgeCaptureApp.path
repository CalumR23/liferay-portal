<html>
<head>
<title>ZendeskKnowledgeCaptureApp</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskKnowledgeCaptureApp</td></tr>
</thead>
<tbody>
<tr>
	<td>IFRAME_KNOWLEDGE</td>
	<td>//iframe[contains(@name,'app_Knowledge-Capture-App_ticket_sidebar')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_KNOWLEDGE</td>
	<td>//button[contains(@aria-label,'Create Knowledge')]</td>
	<td></td>
</tr>
<tr>
	<td>TEMPLATE_DXPCFASTTRACKARTICLE</td>
	<td>//a[contains(@data-garden-id,'buttons.anchor') and text()='DXPC Fast Track Article']</td>
	<td></td>
</tr>
<tr>
	<td>TEMPLATE_FASTTRACKARTICLE</td>
	<td>//a[contains(@data-garden-id,'buttons.anchor') and text()='Fast Track Article']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_ARTICLE_NAME</td>
	<td>//div[contains(@data-test-id,'contentEditorTitle')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_ARTICLE_NAME</td>
	<td>//input[contains(@data-test-id,'contentEditorTitle')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_TEMPLATE_ARTICLE</td>
	<td>//body[contains(@id,'tinymce')]/*</td>
	<td></td>
</tr>
<tr>
	<td>IFRAME_ARTICLE_DESCRIPTION</td>
	<td>//iframe[contains(@id,'tinymce')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_TEMPLATE_DXPCFASTTRACKARTICLE_VALUE</td>
	<td>//input[contains(@data-test-id,'contentEditorTitle')]@value</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_ARTICLE</td>
	<td>//div[contains(@data-test-id,'createButton-button')]</td>
	<td></td>
</tr>
<tr>
	<td>OPTION_TEMPLATE</td>
	<td>//div[contains(@data-test-id,'updateButton-menu-button')]</td>
	<td></td>
</tr>
<tr>
	<td>PUBLISH_ARTICLE</td>
	<td>//div[contains(@data-test-id,'updateButton-publishOption')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_GOT_IT</td>
	<td>//div//button[(text()='Got it')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ARTICLE</td>
	<td>//input[contains(@data-test-id,'search-input')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSERT_ARTICLE</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_ARTICLE</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${articleName}')]//a/div[@title='${reviewStatus}']</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_CREATE_KNOWLEDGE</td>
	<td>//div[contains(@data-garden-id,'grid.col')]//button[contains(@data-garden-id,'buttons.button')]</td>
	<td></td>
</tr>
<tr>
	<td>IFRAME_SEARCH_ARTICLE</td>
	<td>//div[contains(@data-garden-id,'forms.input_group')]//input[contains(@data-garden-id,'forms.input')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_ARTICLE_NAME</td>
	<td>//div[contains(@data-garden-id,'notifications.title')]//h3[(text()='${articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>IFRAME_KNOWLEDGE_POPUP</td>
	<td>//iframe[contains(@name,'app_Knowledge-Capture-App_modal')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_POPUP_NAME</td>
	<td>//article//h1[(text()='${articleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOWLEDGE_POPUP_DESCRIPTION</td>
	<td>//div/*[(text()='${articleDescription}')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ARTICLE</td>
	<td>//tr[contains(@data-test-id,'article') and contains(.,'${articleName}')]//td//div//input</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SETTINGS</td>
	<td>//button[contains(@data-garden-id, 'buttons.button')]//span[(text()='Article settings')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SETTINGS_DELETE</td>
	<td>//li[text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SETTINGS_CONFIRMDELETE</td>
	<td>//button[contains(@data-garden-id,'buttons.button') and text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_ARTICLE</td>
	<td>//header[contains(@class,'modal-header')]//a[contains(@class,'close')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>