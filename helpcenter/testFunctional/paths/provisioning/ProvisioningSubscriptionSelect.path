<html>
<head>
<title>ProvisioningSubscriptionSelect</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscriptionSelect</td></tr>
</thead>

<tbody>
<tr>
	<td>SELECT_IFRAME</td>
	<td>//iframe[contains(@class,'dialog-iframe-node')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ALL_CHECKBOX</td>
	<td>//label[contains(.,'Select Items')]/input</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_SEARCH_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ENTITY_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_entityName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTITY_CHECKBOX</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_entityName}')]/td[contains(@class,'lfr-checkbox-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DONE_BUTTON</td>
	<td>//button[contains(.,'Done')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>