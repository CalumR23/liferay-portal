<html>
<head>
<title>ProvisioningTeamAssignMembers</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningTeamAssignMembers</td></tr>
</thead>

<tbody>
<tr>
	<td>ASSIGN_MEMBERS_IFRAME</td>
	<td>//iframe[contains(@class,'dialog-iframe-node')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_MEMBERS_SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_MEMBERS_SEARCH_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_CHECKBOX</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-checkbox-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_CHECKBOX_DISABLED</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-checkbox-column')]/input[@disabled]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-name-email-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_EMAIL_ADDRESS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-name-email-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_ROLE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-role-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-status-column')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DONE_BUTTON</td>
	<td>//button[contains(.,'Done')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>