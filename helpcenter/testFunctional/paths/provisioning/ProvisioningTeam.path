<html>
<head>
<title>ProvisioningTeam</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningTeam</td></tr>
</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>ProvisioningAccount</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TEAM_HEADER</td>
	<td>//h3[@class='team-name']</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_CREATED_DATE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Created')]</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_LAST_MODIFIED_DATE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Last Modifed')]</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_EDIT_BUTTON</td>
	<td>//a[contains(.,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_DELETE_BUTTON</td>
	<td>//button[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_MEMBERS_BUTTON</td>
	<td>//span[contains(.,'Assign Members')]/a</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-name-email-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_LINK</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-name-email-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_EMAIL_ADDRESS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-name-email-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-status-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_UNASSIGN_LINK</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_memberEmailAddress}')]/td[contains(@class,'lfr-entry-action-column')]//a[contains(@id,'unassign')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-account-name-code-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_CODE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-account-name-code-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SUPPORT_END_DATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-support-end-date-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_REGION</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-region-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SLA</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-sla-tier-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_TIER</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-sla-tier-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_STATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-account-state-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TEAM_DETAILS_NAME</td>
	<td>//div[contains(@class,'details-table')]/div/label[contains(.,'Team Name')]/following-sibling::span</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>