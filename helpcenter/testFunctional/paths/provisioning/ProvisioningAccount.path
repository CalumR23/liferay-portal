<html>
<head>
<title>ProvisioningAccount</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccount</td></tr>
</thead>
<tbody>
<tr>
	<td>ACCOUNT_HEADER</td>
	<td>//h3[@class='account-name']</td>
	<td></td>
</tr>
<tr>
	<td>TAB</td>
	<td>//li[@data-tab-name='${key_tabName}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_STATUS</td>
	<td>//div[contains(.,'Status')]/parent::li/span</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SUPPORT_REGION</td>
	<td>//div[contains(.,'Sup. Region')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_COUNTRY</td>
	<td>//div[contains(.,'Country')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SLA</td>
	<td>//div[contains(.,'SLA')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_TIER</td>
	<td>//div[contains(.,'Tier')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_EWSA</td>
	<td>//div[contains(.,'EWSA')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DEVELOPERS</td>
	<td>//div[contains(.,'Developers')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_PARTNER</td>
	<td>//div[contains(.,'Partner')]/parent::li</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SEARCH_FIELD</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//input[@title='Search']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_ROW</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-product-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SUPPORT_LIFE</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-support-life-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_PROVISIONED</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-provisioned-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_PURCHASED</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-purchased-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_STATUS</td>
	<td>//div[@class='subscription-details']/div[@class='details-table']/div[${key_pageValue}]//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-status-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_EXPAND_BUTTON</td>
	<td>//div[@class='subscriptions full-view']/div[@class='side-panel']/button</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_COLLAPSE_BUTTON</td>
	<td>//div[@class='subscriptions']/div[@class='side-panel']/ul/li[@class='nav-item panel-collapse']/button</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_TAB</td>
	<td>//li[@class='nav-item']/button[contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>NOTE_EMPTY_TEXT</td>
	<td>//div[@class='notes']/div[@class='empty-state']</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_ROW</td>
	<td>//div[@class='notes']/div[@class='${key_noteType}-notes']/div[@class='note' and contains(.,'${key_noteContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_AUTHOR_PORTRAIT</td>
	<td>//div[@class='notes']/div[@class='${key_noteType}-notes']/div[@class='note' and contains(.,'${key_noteContent}')]/div[@class='note-metadata']//h4[@class='note-author']</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_AUTHOR</td>
	<td>//div[@class='notes']/div[@class='${key_noteType}-notes']/div[@class='note' and contains(.,'${key_noteContent}')]/div[@class='note-metadata']//h4[@class='note-author']</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_CREATE_DATE</td>
	<td>//div[@class='notes']/div[@class='${key_noteType}-notes']/div[@class='note' and contains(.,'${key_noteContent}')]/div[@class='note-metadata']//div[@class='note-create-date']</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_CONTENT</td>
	<td>//div[@class='notes']/div[@class='${key_noteType}-notes']/div[@class='note' and contains(.,'${key_noteContent}')]/section[@class='note-content']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>