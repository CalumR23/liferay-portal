<html>
<head>
<title>ProvisioningAccountCloseAccount</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountCloseAccount</td></tr>
</thead>

<tbody>
<tr>
	<td>ACCOUNT_CLOSE_MESSAGE</td>
	<td>//p[contains(.,'Are you sure you want to close the account listed below?')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//td[contains(.,'${key_accountName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_CODE</td>
	<td>//td[contains(.,'${key_accountCode}')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_ACCOUNT_BUTTON</td>
	<td>//button[contains(.,'Close Account')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>