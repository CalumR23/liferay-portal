<html>
<head>
<title>ProvisioningSubscriptionForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscriptionForm</td></tr>
</thead>
<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>//button[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_OPPORTUNITY_KEY_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'salesforceOpportunityKey')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'quantity')]</td>
	<td></td>
</tr>
<tr>
	<td>PERPETUAL_CHECBOX</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'perpetual')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'startDate')]</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'endDate')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_SIZE_SELECT</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//select[contains(@id,'sizing')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//button[@title='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>