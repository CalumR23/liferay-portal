<html>
<head>
<title>ProvisioningSubscriptionForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscriptionForm</td></tr>
</thead>
<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>//button[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_OPPORTUNITY_KEY_FIELD</td>
	<td>//input[contains(@name,'salesforceOpportunityKey')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_FIELD</td>
	<td>//input[contains(@name,'quantity')]</td>
	<td></td>
</tr>
<tr>
	<td>PERPETUAL_CHECBOX</td>
	<td>//input[contains(@name,'perpetual')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD</td>
	<td>//input[contains(@name,'startDate')]</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_FIELD</td>
	<td>//input[contains(@name,'endDate')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_SIZE_SELECT</td>
	<td>//select[contains(@name,'sizing')]</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_END_DATE_FIELD</td>
	<td>//input[contains(@name,'gracePeriodEndDate')]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_SELECT</td>
	<td>//select[contains(@name,'status')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>