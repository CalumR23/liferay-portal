<html>
<head>
<title>ProvisioningSubscriptionForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscriptionForm</td></tr>
</thead>
<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>//button[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_TERM_SELECT</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//select[contains(@id,'subscriptionTerm')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_OPPORTUNITY_KEY_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'salesforceOpportunityKey')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_OPPORTUNITY_KEY_BULK_INPUT_BUTTON</td>
	<td>//td[contains(.,'${key_entityName}')]/following-sibling::td//input[contains(@aria-label,'Salesforce Opportunity Key Bulk Input')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_FIELD</td>
	<td>//td[contains(.,'${key_entityName}')]/following-sibling::td//input[@aria-label='Purchased Bulk Input' or @aria-label='Purchased']</td>
	<td></td>
</tr>
<tr>
	<td>PERPETUAL_CHECBOX</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@id,'perpetual')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD</td>
	<td>//td[contains(text(),'${key_entityName}')]/following-sibling::td//input[@name='Start Date Bulk Input' or @name='startDate']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD_DISABLED</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[@name='Start Date Bulk Input' or @name='startDate']/following-sibling::input[@disabled='true']</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[@name='Start Date Bulk Input' or @name='startDate']/following-sibling::div/button</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_FIELD</td>
	<td>//td[contains(text(),'${key_entityName}')]/following-sibling::td//input[@name='End Date Bulk Input' or @name='gracePeriodStartDate']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_FIELD_DISABLED</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[@name='End Date Bulk Input' or @name='gracePeriodStartDate']/following-sibling::input[@disabled='true']</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[@name='End Date Bulk Input' or @name='gracePeriodStartDate']/following-sibling::div/button</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_SIZE_SELECT</td>
	<td>//td[text()='${key_entityName}']/following-sibling::td//select[@aria-label='Instance Size Bulk Input' or @aria-label='Instance Size']</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_FIELD</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@aria-label,'Grace Period')]</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_FIELD_DISABLED</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//input[contains(@aria-label,'Grace Period') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_BUTTON</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//button[contains(@aria-label,'Grace Period')]</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_BUTTON_DISABLED</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//button[contains(@aria-label,'Grace Period') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_MONTH_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='month']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_YEAR_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='year']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_DAY_BUTTON</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//button[.='${key_day}' and not(contains(@class,'disabled'))]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_SELECT</td>
	<td>//td[text()='${key_entityName}']/following-sibling::td//select[@aria-label='Subscription Status Bulk Input' or @aria-label='Status']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//button[@title='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON_DISABLED</td>
	<td>//tr[contains(.,'${key_entityName}')]/td//button[@title='Delete' and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON_DISABLED</td>
	<td>//button[contains(.,'Save') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_BUTTON</td>
	<td>//button[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>