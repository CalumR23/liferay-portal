<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningUser</td></tr>
</thead>
<tbody>
<tr>
	<td>USER_HEADER</td>
	<td>//h3[@class='contact-name']</td>
	<td></td>
</tr>
<tr>
	<td>USER_STATUS</td>
	<td>//ul[@class='header-details']/li[contains(.,'Status')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_NUMBER_OF_ACCOUNTS</td>
	<td>//ul[@class='header-details']/li[contains(.,'No. of Accounts')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>