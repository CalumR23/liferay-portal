<html>
<head>
<title>ProvisioningSubscriptionExtend</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscriptionExtend</td></tr>
</thead>

<tbody>
<tr>
	<td>GRACE_PERIOD_END_DATE_FIELD</td>
	<td>//div[contains(@class, 'date-picker')]/div//input[contains(@class,'form-control input-group-inset input-group-inset-after')]</td>
	<td></td>
</tr>
<tr>
	<td>GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//input[contains(@name,'endDate')]/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_MONTH_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='month']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_YEAR_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='year']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_DAY_BUTTON</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//button[.='${key_day}' and not(contains(@class,'disabled'))]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_BUTTON</td>
	<td>//div[contains(@class,'btn-group-item') and contains(.,'Extend')]/button</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>