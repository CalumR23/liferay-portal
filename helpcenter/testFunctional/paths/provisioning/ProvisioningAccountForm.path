<html>
<head>
<title>ProvisioningAccountForm</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountForm</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_ACCOUNT_HEADER</td>
	<td>//h3[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>REQUIRED_FIELD_ERROR_MESSAGE</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::div[contains(@id,'Helper')]/div[@class='required']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>