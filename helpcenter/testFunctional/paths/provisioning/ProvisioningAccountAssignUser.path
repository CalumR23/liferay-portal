<html>
<head>
<title>ProvisioningAccountAssignUser</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountAssignUser</td></tr>
</thead>
<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@name,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD_READ_ONLY</td>
	<td>//input[contains(@name,'emailAddress') and @type='hidden']</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_LINK</td>
	<td>//button[@title='Add']</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_DROPDOWN</td>
	<td>//div[contains(@class,'dropdown-menu autocomplete')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_DROPDOWN_VISIBLE</td>
	<td>//div[contains(@class,'dropdown-menu show')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_LINK</td>
	<td>//button[contains(@class,'dropdown-item') and contains(.,'${key_role}')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_ROLE_LINK</td>
	<td>//span[contains(@class,'label-lg') and contains(.,'${key_role}')]//button[@class='close']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON_DISABLED</td>
	<td>//button[contains(.,'Save') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>