<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountAssignUser</td></tr>
</thead>
<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD_READ_ONLY</td>
	<td>//input[contains(@id,'emailAddress') and @readonly='true']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_LINK</td>
	<td>//a[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_CHECKBOX</td>
	<td>//label[contains(.,'${key_role}')]/input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>