<html>
<head>
<title>ProvisioningSubscription</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscription</td></tr>
</thead>
<tbody>
<tr>
	<td>SUBSCRIPTION_HEADER</td>
	<td>//h3[@class='subscription-name']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATUS</td>
	<td>//ul[@class='header-details']/li[contains(.,'Status')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_INSTANCE_SIZE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Instance Size')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SUPPORT_LIFE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Support Life')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_GRACE_PERIOD</td>
	<td>//ul[@class='header-details']/li[contains(.,'Grace Period')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TERM_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_CHECKBOX</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-checkbox-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td>TERM_START_END_DATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-start-end-date-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_GRACE_PERIOD</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-grace-period-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_PROVISIONED</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-provisioned-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_PURCHASED</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-purchased-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_SALESFORCE_OPPORTUNITY_KEY</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-salesforce-opportunity-key-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>TERM_INSTANCE_SIZE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-instance-size-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-status-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_ACTION</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-entry-action-column')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>