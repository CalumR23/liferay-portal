<html>
<head>
<title>ProvisioningSubscription</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningSubscription</td></tr>
</thead>
<tbody>
<tr>
	<td>SUBSCRIPTION_HEADER</td>
	<td>//h3[@class='subscription-name']</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_STATE</td>
	<td>//ul[@class='header-details']/li[contains(.,'State')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_INSTANCE_SIZE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Instance Size')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SUPPORT_LIFE</td>
	<td>//ul[@class='header-details']/li[contains(.,'Support Life')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_GRACE_PERIOD</td>
	<td>//ul[@class='header-details']/li[contains(.,'Grace Period')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_PROVISIONED</td>
	<td>//ul[@class='header-details']/li[contains(.,'Provisioned')]/a[contains(@href,'AccountsPortlet')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_LICENSE_BUTTON</td>
	<td>//a[contains(.,'Generate License')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@name,'AccountsPortlet_keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>CLEAR_SEARCH_LINK</td>
	<td>//a[contains(@class,'tbar-link') and contains(.,'Clear')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_FILTER_LINK</td>
	<td>//span[contains(@class,'tbar-label') and contains(.,'${key_filter}')]//button[@aria-label='Close']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TERM_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_CHECKBOX</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-checkbox-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td>TERM_START_END_DATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-start-end-date-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_GRACE_PERIOD</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-grace-period-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_PROVISIONED</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-provisioned-column')]/a[contains(@href,'AccountsPortlet')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_PURCHASED</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-purchased-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_SALESFORCE_OPPORTUNITY_KEY</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-salesforce-opportunity-key-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>TERM_INSTANCE_SIZE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-instance-size-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-status-column')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_ACTION_BUTTON</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_startDateEndDate}')]/td[contains(@class,'lfr-entry-action-column')]//a</td>
	<td></td>
</tr>
<tr>
	<td>TERM_DROPDOWN_ACTION_BUTTON</td>
	<td>//ul[contains(@class,'dropdown-menu')]/li/a[contains(.,'${key_action}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TAB</td>
	<td>//li[@class='nav-item']/a[contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TAB_COUNTER</td>
	<td>//li[@class='nav-item']/a[contains(.,'${key_tabName}')]/span[contains(@class,'badge-secondary')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ALL_CHECKBOX</td>
	<td>//div[contains(@class,'details-table')]//label[contains(.,'Select Items')]/input</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_SEARCH_FIELD</td>
	<td>//div[contains(@class,'details-table')]//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ALL_DOWNLOAD_BUTTON</td>
	<td>//div[contains(@class,'details-table')]//*[local-name()='svg' and contains(@class,'download')]/parent::a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ALL_RENEW_BUTTON</td>
	<td>//div[contains(@class,'details-table')]//*[local-name()='svg' and contains(@class,'time')]/parent::a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ALL_ACTION_BUTTON</td>
	<td>//div[contains(@class,'details-table')]//*[local-name()='svg' and contains(@class,'ellipsis')]/parent::button</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ALL_DROPDOWN_ACTION_BUTTON</td>
	<td>//div[contains(@class,'dropdown-menu')]//li/a[contains(.,'${key_action}')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_CHECKBOX</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-checkbox-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-name-description-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_DESCRIPTION</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-name-description-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_EXPIRATION_DATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-expiration-date-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_PRODUCT</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-product-type-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TYPE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-product-type-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_DETAILS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_licenseKeyword}')]/td[contains(@class,'lfr-details-column')]/a//dt[contains(.,'${key_label}')]/following-sibling::dd</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>