<html>
<head>
<title>ProvisioningProductBundleForm</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningProductBundleForm</td></tr>
</thead>

<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT_BUTTON</td>
	<td>//button[contains(@id,'ProductBundlesPortlet') and contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>//tr[contains(.,'${key_productName}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DELETE_BUTTON</td>
	<td>//tr[contains(.,'${key_productName}')]/td/button[contains(@onclick,'removeProduct')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>