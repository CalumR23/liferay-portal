<html>
<head>
<title>ProvisioningAccountAssignContact</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountAssignContact</td></tr>
</thead>
<tbody>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[contains(@name,'firstName')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[contains(@name,'lastName')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_FIELD</td>
	<td>//input[contains(@name,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_LINK</td>
	<td>//button[@title='Add']</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_DROPDOWN</td>
	<td>//div[contains(@class,'dropdown-menu autocomplete')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_SELECT_DROPDOWN_VISIBLE</td>
	<td>//div[contains(@class,'dropdown-menu show')]</td>
	<td></td>
</tr>
<tr>
	<td>ROLE_LINK</td>
	<td>//button[contains(@class,'dropdown-item') and contains(.,'${key_role}')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>ProvisioningAccountAssignUser</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>