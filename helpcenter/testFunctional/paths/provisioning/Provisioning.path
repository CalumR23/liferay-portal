<html>
<head>
<title>Provisioning</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Provisioning</td></tr>
</thead>
<tbody>
<tr>
	<td>PROVISIONING_HEADER</td>
	<td>//h2[contains(.,'Provisioning')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_FIELD</td>
	<td>//input[@placeholder='Search Accounts']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_BUTTON</td>
	<td>//input[@placeholder='Search Accounts']/following-sibling::a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_DROPDOWN_RESULT</td>
	<td>//li[contains(.,'${key_result}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_DROPDOWN_RESULT_NAME</td>
	<td>//li[contains(.,'${key_result}')]/a/div[@class='main-item']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_DROPDOWN_RESULT_CODE</td>
	<td>//li[contains(.,'${key_result}')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_DROPDOWN_SEE_ALL_RESULTS</td>
	<td>//a[contains(@class,'all-results')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ACCOUNTS_DROPDOWN_NO_RESULTS</td>
	<td>//span[contains(@class,'dropdown-item disabled')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_ACCOUNT_BUTTON</td>
	<td>//a[@aria-label='New Account']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_PRODUCT_BUTTON</td>
	<td>//a[@aria-label='New Product']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_PRODUCT_BUNDLE_BUTTON</td>
	<td>//a[@aria-label='New Product Bundle']</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-name-code-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_CODE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-name-code-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SUPPORT_END_DATE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-support-end-date-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_PARTNER</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-partner-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_REGION</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-region-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SLA</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-sla-tier-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_TIER</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-sla-tier-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_accountName}')]/td[contains(@class,'lfr-status-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_TYPE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-type-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DELETE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productName}')]/td[contains(@class,'lfr-entry-action-column')]//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_BUNDLE_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productBundleName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_BUNDLE_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productBundleName}')]/td[contains(@class,'lfr-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_BUNDLE_DELETE</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_productBundleName}')]/td[contains(@class,'lfr-entry-action-column')]//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>USER_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_NAME</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]/td[contains(@class,'lfr-name-email-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>USER_EMAIL_ADDRESS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]/td[contains(@class,'lfr-name-email-column')]/a/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>USER_ENTITLEMENTS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]/td[contains(@class,'lfr-entitlements-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>USER_NUMBER_OF_ACCOUNTS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]/td[contains(@class,'lfr-no.-of-accounts-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>USER_STATUS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_userName}')]/td[contains(@class,'lfr-status-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TAB</td>
	<td>//li[@data-tab-name='${key_tabName}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>