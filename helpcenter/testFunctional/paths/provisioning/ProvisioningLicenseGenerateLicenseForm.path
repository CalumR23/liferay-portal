<html>
<head>
<title>ProvisioningLicenseGenerateLicenseForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicenseGenerateLicenseForm</td></tr>
</thead>
<tbody>
<tr>
	<td>INPUT_FIELD</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>TEXTAREA_FIELD</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::textarea)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::select)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CHECKBOX</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/input[@type='checkbox'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ENTITY_BUTTON</td>
	<td>//h5[contains(.,'${key_field}')]/following-sibling::form/div/label/following-sibling::button[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_BUTTON</td>
	<td>//tr[not(@class='table-divider')][${key_positionValue}]/td/button[contains(.,'Choose')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON</td>
	<td>//tr[not(@class='table-divider') and contains(@id,'${key_productPurchaseId}')]/td/button[contains(.,'Choose')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_BUTTON_DISABLED</td>
	<td>//tr[not(@class='table-divider')][${key_positionValue}]/td/button[contains(.,'Choose') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>SECTIONED_CHOOSE_PRODUCT_PURCHASE_BUTTON</td>
	<td>//tr[@class='table-divider' and contains(.,'${key_section}')]/following-sibling::tr[not(@class='table-divider')][${key_positionValue}]/td/button[contains(.,'Choose')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTIONED_CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON</td>
	<td>//tr[@class='table-divider' and contains(.,'${key_section}')]/following-sibling::tr[not(@class='table-divider') and contains(@id,'${key_productPurchaseId}')]/td/button[contains(.,'Choose')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTIONED_CHOOSE_PRODUCT_PURCHASE_BUTTON_DISABLED</td>
	<td>//tr[@class='table-divider' and contains(.,'${key_section}')]/following-sibling::tr[not(@class='table-divider')][${key_positionValue}]/td/button[contains(.,'Choose') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_FIELDS_BUTTON</td>
	<td>xpath=(//button[contains(@class,'add-fields')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_FIELDS_BUTTON</td>
	<td>xpath=(//button[contains(@class,'delete-fields')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_BUTTON</td>
	<td>//button[contains(.,'Generate')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_BUTTON_DISABLED</td>
	<td>//button[contains(.,'Generate') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_STEP_BUTTON</td>
	<td>//button[contains(.,'Previous Step')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD</td>
	<td>xpath=(//input[@name='startDate']/following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>xpath=(//input[@name='startDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_FIELD</td>
	<td>xpath=(//input[@name='expirationDate']/following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_VIA_KEY_FIELD</td>
	<td>//tr[not(@class='table-divider') and contains(@id,'${key_productPurchaseId}')]/td//input[@name='expirationDate']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>xpath=(//input[@name='expirationDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCE_SIZE_SELECT</td>
	<td>xpath=(//select[@id='instanceSize'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_MONTH_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='month']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_YEAR_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='year']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_DAY_BUTTON</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//button[.='${key_day}' and not(contains(@class,'disabled'))]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>