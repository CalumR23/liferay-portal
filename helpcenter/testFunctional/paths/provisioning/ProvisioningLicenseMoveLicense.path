<html>
<head>
<title>ProvisioningLicenseMoveLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicenseMoveLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>MOVE_LICENSE_IFRAME</td>
	<td>//iframe[contains(@class,'dialog-iframe-node')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_BUTTON</td>
	<td>//tr[not(@class='table-divider')][${key_positionValue}]/td/button[contains(.,'Choose')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_PRODUCT_PURCHASE_LABEL</td>
	<td>//tr[not(@class='table-divider')][${key_positionValue}]/td[contains(.,'Current')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON</td>
	<td>//tr[not(@class='table-divider')]/td/button[contains(.,'Choose') and contains(@data-productpurchasekey,'${key_productPurchaseId}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>