<html>
<head>
<title>ProvisioningLicenseDownloadLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicenseDownloadLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>DOWNLOAD_LICENSES_HEADER</td>
	<td>//h3[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_ROW</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_NAME</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_DESCRIPTION</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[1]/div[@class='secondary-information']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_PRODUCT</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_VERSION</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TYPE</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_START_DATE</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_EXPIRATION_DATE</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_HOST_NAME</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_IP_ADDRESSES</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_MAC_ADDRESSES</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[9]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_STATUS</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td[10]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_DELETE_BUTTON</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td/button[@title='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_DELETE_BUTTON_DISABLED</td>
	<td>//tr[contains(.,'${key_licenseKeyword}')]/td/button[@title='Delete' and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>//input[contains(@name,'licenseKeyId') and @value='${key_licenseKeyIdList}']/following-sibling::button[contains(.,'Download')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>