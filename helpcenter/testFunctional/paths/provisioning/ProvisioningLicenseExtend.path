<html>
<head>
<title>ProvisioningLicenseExtend</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicenseExtend</td></tr>
</thead>

<tbody>
<tr>
	<td>SUBSCRIPTION_TERM_SELECT</td>
	<td>//select[@id='product']</td>
	<td></td>
</tr>
<tr>
	<td>BULK_INPUT_ROW</td>
	<td>//tr//td[text()='Bulk Input']</td>
	<td></td>
</tr>
<tr>
	<td>BULK_INPUT_START_DATE_FIELD</td>
	<td>//td[contains(.,'Bulk Input')]/following-sibling::*//input[contains(@name,'startDate')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>BULK_INPUT_START_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//td[contains(.,'Bulk Input')]/following-sibling::*//input[contains(@name,'startDate')]//..//button[contains(@class,'date-picker-dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>BULK_INPUT_EXPIRATION_DATE_FIELD</td>
	<td>//td[contains(.,'Bulk Input')]/following-sibling::*//input[contains(@name,'expirationDate')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>BULK_INPUT_EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//td[contains(.,'Bulk Input')]/following-sibling::*//input[contains(@name,'expirationDate')]//..//button[contains(@class,'date-picker-dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD</td>
	<td>//input[@name='startDate']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//input[@name='startDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_FIELD</td>
	<td>//input[@name='expirationDate']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON</td>
	<td>//input[@name='expirationDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_MONTH_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='month']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_YEAR_SELECT</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//select[@name='year']</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE_PICKER_DAY_BUTTON</td>
	<td>//div[contains(@class,'show')]/div[@class='date-picker-calendar']//button[.='${key_day}' and not(contains(@class,'disabled'))]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_FIELD_POSITION</td>
	<td>xpath=(//td[contains(.,'${key_product}')]/following-sibling::*//input[contains(@name,'startDate')]//following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_PICKER_DROPDOWN_BUTTON_POSITION</td>
	<td>xpath=(//input[@name='startDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_FIELD_POSITION</td>
	<td>xpath=(//td[contains(.,'${key_product}')]/following-sibling::*//input[contains(@name,'expirationDate')]//following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON_POSITION</td>
	<td>xpath=(//input[@name='expirationDate']/following-sibling::input/following-sibling::div/button[contains(@class,'date-picker-dropdown-toggle')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_BUTTON</td>
	<td>//tr/td[contains(.,'${key_product}')]//following::button[contains(@class,'btn-secondary') and contains(.,'Extend')][${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_BUTTON_DISABLED</td>
	<td>//button[contains(@class,'btn-secondary') and contains(.,'Extend') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_BUTTON_DISABLED_BY_POSITION</td>
	<td>xpath=(//button[contains(@class,'btn-secondary') and contains(.,'Extend')])[${key_positionValue}]/parent::td/form/following-sibling::button[@disabled]</td>
	<td></td>
</tr>
<tr>
	<td>BACK_BUTTON</td>
	<td>//a[contains(@id,'TabsBack')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>