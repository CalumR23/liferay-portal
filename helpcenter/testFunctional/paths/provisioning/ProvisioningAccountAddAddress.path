<html>
<head>
<title>ProvisioningAccountAddAddress</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningAccountAddAddress</td></tr>
</thead>
<tbody>
<tr>
	<td>ADD_ADDRESS_HEADER</td>
	<td>//h3[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_FIELD</td>
	<td>//label[contains(.,'Account')]/following-sibling::input[@disabled and @placeholder='${key_accountName}']</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>CHECKBOX</td>
	<td>//label[contains(.,'${key_field}')]/following-sibling::input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>