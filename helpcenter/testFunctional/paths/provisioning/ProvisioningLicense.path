<html>
<head>
<title>ProvisioningLicense</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicense</td></tr>
</thead>

<tbody>
<tr>
	<td>LICENSE_HEADER</td>
	<td>//h3[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_FIELD_VALUE</td>
	<td>xpath=(//dt[contains(.,'${key_field}')]/following-sibling::dd[1])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_FIELD_VALUE_LINK</td>
	<td>xpath=(//dt[contains(.,'${key_field}')]/following-sibling::dd[1]/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>REPLACE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Replace')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>EXTEND_BUTTON</td>
	<td>xpath=(//a[contains(@class,'btn-secondary') and contains(.,'Extend')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVATE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Activate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DEACTIVATE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Deactivate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MAKE_COMPLIMENTARY_BUTTON</td>
	<td>xpath=(//button[contains(.,'Make Complimentary')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_COMPLIMENTARY_BUTTON</td>
	<td>xpath=(//button[contains(.,'Remove Complimentary')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Move')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>xpath=(//a[contains(.,'Download')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>