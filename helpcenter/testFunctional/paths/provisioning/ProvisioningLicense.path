<html>
<head>
<title>ProvisioningLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProvisioningLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>LICENSE_HEADER</td>
	<td>//h3[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_FIELD_VALUE</td>
	<td>xpath=(//dt[contains(.,'${key_field}')]/following-sibling::dd[1])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVATE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Activate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DEACTIVATE_BUTTON</td>
	<td>xpath=(//button[contains(.,'Deactivate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_BUTTON</td>
	<td>xpath=(//*[local-name()='svg' and contains(@class,'move-folder')]/parent::button)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>xpath=(//*[local-name()='svg' and contains(@class,'download')]/parent::a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>