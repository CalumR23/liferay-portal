<html>
<head>
<title>Downloads</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Downloads</td></tr>
</thead>

<tbody>
<tr>
	<td>DOWNLOADS_HEADER</td>
	<td>//h1[contains(.,'Downloads')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOADS_SUBTITLE</td>
	<td>//h5[@class='section-subtitle']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@id,'DownloadsDisplayPortlet_productAssetCategoryId')]</td>
	<td></td>
</tr>
<tr>
	<td>FILE_TYPE_SELECT</td>
	<td>//select[contains(@id,'DownloadsDisplayPortlet_fileTypeAssetCategoryId')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--DOWNLOADS_RESULTS-->

<tr>
	<td>RELEASED_COLUMN_LABEL</td>
	<td>//th[@class='lfr-released-column ']</td>
	<td></td>
</tr>
<tr>
	<td>NAME_COLUMN_LABEL</td>
	<td>//th[@class='lfr-name-column ']</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_DATE</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-released-column')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_HEADER</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/h3/a</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'${key_linkValue}')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_RELEASE_NOTES_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Release Notes')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_RELEASE_HIGHTLIGHTS_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Release Highlights')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_IMPORTANT_CHANGES_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Important Changes')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_INSTALLATION_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Installation')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_INSTALLATION_INSTRUCTIONS_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Installation Instructions')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_MATRIX_LINK</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='section-links']/a[contains(.,'Matrix')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_INFO_MESSAGE</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[contains(@class,'alert alert-info')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_ADDITIONAL_NOTES</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='additional-notes']/p</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SELECT</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='downloads']/div[@class='dropdown-row']/select[contains(@class,'download-dropdown')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='downloads']/div[@class='dropdown-row']/a[contains(.,'Download')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SIZE</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='downloads']/div[@class='download-details small']/span[@class='details'][1]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_MD5</td>
	<td>//a[.='${key_downloadName}']/parent::h3/parent::td/parent::tr/td[contains(@class,'lfr-name-column')]/div[@class='downloads']/div[@class='download-details small']/span[@class='details'][2]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PAGINATION-->

<tr>
	<td>GO_TO_PREVIOUS_PAGE_LINK</td>
	<td>//a/span[@class='icon-caret-left']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_PAGE_NUMBER_LINK</td>
	<td>//ul[@class='pagination']/li/a[contains(.,'${key_pageNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_PAGE_NUMBER</td>
	<td>//li[@class='active']/a[contains(.,'${key_pageNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_NEXT_PAGE_LINK</td>
	<td>//a/span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>