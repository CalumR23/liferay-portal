<html>
<head>
<title>LicenseManagement</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LicenseManagement</td></tr>
</thead>
<tbody>
<tr>
	<td>GENERATE_NEW_LICENSE_BUTTON</td>
	<td>//a[contains(.,'Generate New License')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@id,'searchkeywords')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD_DISABLED</td>
	<td>//input[contains(@id,'searchkeywords') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_SUBMIT_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_TOGGLE_BUTTON</td>
	<td>//button[contains(@id,'searchtoggleAdvanced')]</td>
	<td></td>
</tr>
<tr>
	<td>KORONEIKI_ACCOUNT_KEY_FIELD</td>
	<td>//input[contains(@id,'koroneikiAccountKey')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--LICENSE_RESULTS-->
<tr>
	<td>LICENSE_PROJECT</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-project-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_NAME_DESCRIPTION</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-name-/-description-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_PRODUCT</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-product-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TYPE</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-type-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_START_DATE</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-start-date-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_EXPIRATION_DATE</td>
	<td>//tr[contains(.,'${key_licenseName}')]/td[contains(@class,'lfr-expiration-date-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>