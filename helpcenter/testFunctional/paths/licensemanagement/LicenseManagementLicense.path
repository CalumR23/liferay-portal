<html>
<head>
<title>LicenseManagementLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LicenseManagementLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>DOWNLOAD_LICENSE_FILE_LINK</td>
	<td>xpath=(//a[contains(.,'Download License File')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_LICENSE_LINK</td>
	<td>xpath=(//a[contains(.,'Move License')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MAKE_COMPLIMENTARY_LINK</td>
	<td>xpath=(//a[contains(.,'Make Complimentary')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_COMPLIMENTARY_LINK</td>
	<td>xpath=(//a[contains(.,'Remove Complimentary')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVATE_LINK</td>
	<td>xpath=(//a[contains(.,'Activate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DEACTIVATE_LINK</td>
	<td>xpath=(//a[contains(.,'Deactivate')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_AGGREGATE_LICENSE_FILE_LINK</td>
	<td>//a[contains(.,'Download Aggregate License File')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_NEW_LICENSE_KEY_BUTTON</td>
	<td>//a[contains(.,'Add New License Key')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>