<html>
<head>
<title>LicenseManagementGenerateNewLicenseForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LicenseManagementGenerateNewLicenseForm</td></tr>
</thead>
<tbody>
<tr>
	<td>ACCOUNT_VALUE</td>
	<td>//span[contains(@id,'koroneikiAccountName')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_VALUE_READ_ONLY</td>
	<td>//h2[contains(.,'Account')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_SELECT</td>
	<td>//input[contains(@class,'select-account-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@id,'productEntryId')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_LIFERAY_VERSION_SELECT</td>
	<td>//select[contains(@id,'productVersion')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_SELECT</td>
	<td>//select[contains(@id,'licenseEntryId')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRODUCT_PURCHASE_BUTTON</td>
	<td>//button[contains(@onclick,'${key_productPurchaseId}')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_DETACHED_PRODUCT_PURCHASE_BUTTON</td>
	<td>//tr[@class='splitter' and contains(.,'Detached')]/following-sibling::tr/td/button[contains(@onclick,'selectProductPurchase')]</td>
	<td></td>
</tr>
<tr>
	<td>HOST_NAME_FIELD</td>
	<td>xpath=(//input[contains(@id,'hostName')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>IP_ADDRESSES_FIELD</td>
	<td>xpath=(//textarea[contains(@id,'ipAddresses')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MAC_ADDRESSES_FIELD</td>
	<td>xpath=(//textarea[contains(@id,'macAddresses')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MAXIMUM_CONNECTIONS_SELECT</td>
	<td>xpath=(//select[contains(@id,'maxHttpSessions')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_ROW_BUTTON</td>
	<td>xpath=(//button[contains(@class,'add-row')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_ROW_BUTTON</td>
	<td>xpath=(//button[contains(@class,'delete-row')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>COMPLIMENTARY_CHECKBOX</td>
	<td>//input[contains(@id,'complimentary')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERATE_BUTTON</td>
	<td>//button[contains(.,'Generate')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>