<html>
<head>
<title>MockMock</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MockMock</td></tr>
</thead>
<tbody>
<tr>
	<td>MOCKMOCK_HEADER_LINK</td>
	<td>//a[@class='brand' and contains(.,'MockMock')]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_HOME_LINK</td>
	<td>//a[contains(.,'Home')]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_NO_EMAILS_MESSAGE</td>
	<td>//div[@class='container' and contains(.,'No emails in queue')]/h2</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_EMAIL_COUNT_MESSAGE</td>
	<td>//div[@class='container' and contains(.,'You have ${key_emailCount}')]/h1</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_HAVE_EMAILS_MESSAGE</td>
	<td>//div[@class='container' and contains(.,'You have')]/h1</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_DELETE_ALL_LINK</td>
	<td>//small[@class='deleteLink']</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_FROM_FIELD</td>
	<td>//span[contains(@title, '${key_columnEntry2}') and contains(@title,'${key_recipientEmailAddress}')]/parent::td/parent::tr[contains(.,'${key_columnEntry1}') and contains(.,'${key_columnEntry3}')]/td</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_TO_FIELD</td>
	<td>//span[contains(@title, '${key_columnEntry2}') and contains(@title,'${key_recipientEmailAddress}')]/parent::td/parent::tr[contains(.,'${key_columnEntry1}') and contains(.,'${key_columnEntry3}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_SUBJECT_FIELD</td>
	<td>//span[contains(@title, '${key_columnEntry2}') and contains(@title,'${key_recipientEmailAddress}')]/parent::td/parent::tr[contains(.,'${key_columnEntry1}') and contains(.,'${key_columnEntry3}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_SUBJECT_FIELD_LINK</td>
	<td>//span[contains(@title, '${key_columnEntry2}') and contains(@title,'${key_recipientEmailAddress}')]/parent::td/parent::tr[contains(.,'${key_columnEntry1}') and contains(.,'${key_columnEntry3}')]/td[3]/a</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_DELETE_LINK</td>
	<td>//span[contains(@title, '${key_columnEntry2}') and contains(@title,'${key_recipientEmailAddress}')]/parent::td/parent::tr[contains(.,'${key_columnEntry1}') and contains(.,'${key_columnEntry3}')]/td[4]/a</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_MESSAGE_BODY</td>
	<td>//div[@class='well' and contains(.,"${key_asset}")]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_MESSAGE_BODY_HTML_FORMATTED</td>
	<td>//div[@name="bodyHTML_Formatted"]//div[@class='well' and contains(.,'${key_asset}')]</td>
	<td></td>
</tr>
<tr>
	<td>MOCKMOCK_MESSAGE_BODY_KB_URL</td>
	<td>//a[contains(.,'Article Link')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>