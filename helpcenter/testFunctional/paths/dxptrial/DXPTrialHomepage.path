<html>
<head>
<title>DXPTrialHomepage</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">DXPTrialHomepage</td></tr>
</thead>
<tbody>
<tr>
	<td>HELLO_HEADER</td>
	<td>//h1[contains(@class,'trial-download-hello')]</td>
	<td></td>
</tr>
<tr>
	<td>HELLO_SUBTITLE</td>
	<td>//h3[contains(.,'Liferay DXP up and running.')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--DOWNLOAD_SECTION-->
<tr>
	<td>DOWNLOAD_SECTION_HEADER</td>
	<td>//h2[contains(@class,'step-one trial-download-step-title')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SECTION_PRODUCT_NAME</td>
	<td>//div[contains(@class,'download-selection')]//h3</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SECTION_DOWNLOAD_SELECT</td>
	<td>//div[contains(@class,'download-selection')]//select</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SECTION_DOWNLOAD_BUTTON</td>
	<td>//div[contains(@class,'download-selection')]//a[contains(.,'Download')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_SECTION_DOWNLOAD_INSTRUCTIONS</td>
	<td>//div[contains(@class,'download-selection')]//div[@class='download-instructions']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EMAIL_SECTION-->
<tr>
	<td>EMAIL_SECTION_HEADER</td>
	<td>//h2[contains(@class,'trial-download-step-title step-two')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_SECTION_EMAIL_INSTRUCTION</td>
	<td>//div[contains(@class,'step-two-block')]//p</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_SECTION_EMAIL_INSTRUCTION_LICENSE_LINK</td>
	<td>//div[contains(@class,'step-two-block')]//p/a</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_SECTION_TRIAL_KEY_BUTTON</td>
	<td>//div[contains(@class,'step-two-block')]//div[contains(@class,'trial-key-button')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--DEPLOY_SECTION-->
<tr>
	<td>DEPLOY_SECTION_HEADER</td>
	<td>//h2[contains(@class,'trial-download-step-title step-three')]</td>
	<td></td>
</tr>
<tr>
	<td>DEPLOY_SECTION_VIDEO_LINK</td>
	<td>//a[contains(.,'Watch How')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--DEVELOPER_TOOLS_SECTION-->
<tr>
	<td>DEVELOPER_TOOLS_SECTION_HEADER</td>
	<td>//h2[contains(.,'Liferay Developer Tools')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_TOOLS_LEARN_MORE_BUTTON</td>
	<td>//a[contains(.,'Learn More')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>