<html>
<head>
<title>DXPTrialSignIn</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">DXPTrialSignIn</td></tr>
</thead>
<tbody>
<tr>
	<td>DXP_TRIAL_HEADER</td>
	<td>//div[@class='trial-headings-container']/h1</td>
	<td></td>
</tr>
<tr>
	<td>DXP_TRIAL_SUBHEADER</td>
	<td>//div[@class='trial-headings-container']/h3</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_EMAIL_ADDRESS_FIELD</td>
	<td>//input[@name='_58_login']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_PASSWORD_FIELD</td>
	<td>//div[contains(@class,'login-form-container')]//input[@name='_58_password']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_BUTTON</td>
	<td>//button[contains(.,'Create Account')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CREATE_ACCOUNT-->
<tr>
	<td>CREATE_ACCOUNT_EMAIL_FIELD</td>
	<td>//input[@name='_58_emailAddress']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_PASSWORD_FIELD</td>
	<td>//div[contains(@class,'create-account-form-container')]//input[@name='_58_password']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_FIRST_NAME_FIELD</td>
	<td>//input[@name='_58_firstName']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_LAST_NAME_FIELD</td>
	<td>//input[@name='_58_lastName']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_PHONE_NUMBER_FIELD</td>
	<td>//input[@name='_58_number']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_COMPANY_FIELD</td>
	<td>//input[@type='text' and contains(@name,'osbCompany')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_INDUSTRY_SELECT</td>
	<td>//select[contains(@name,'osbIndustry')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_COUNTRY_SELECT</td>
	<td>//select[contains(@name,'osbCountry')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_REGION_SELECT</td>
	<td>//select[contains(@name,'osbRegion')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ACCOUNT_AGREE_TO_TERMS_OF_USE_CHECKBOX</td>
	<td>//input[@name='_58_agreedToTermsOfUseCheckbox']</td>
	<td></td>
</tr>
<tr>
	<td>START_FREE_TRIAL_BUTTON</td>
	<td>//button[contains(.,'Start Free Trial')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>