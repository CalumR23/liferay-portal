definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I go the download with the name ${downloadName}"
	macro gotoDownload {
		var key_downloadName = "${downloadName}";

		AssertClick(
			locator1 = "Downloads#DOWNLOAD_HEADER",
			value1 = "${downloadName}");
	}

	@prose = "I go to the Downloads page"
	macro gotoDownloadsPage {
		Open(locator1 = "${supportURL}/group/customer/downloads");

		AssertVisible(locator1 = "Downloads#DOWNLOADS_HEADER");
	}

	@prose = "I go to the next page of the download search results"
	macro gotoResultsNextPage {
		Click(locator1 = "Downloads#GO_TO_NEXT_PAGE_LINK");
	}

	@prose = "I go to page number ${pageNumber} of the download search results"
	macro gotoResultsPageNumber {
		var key_pageNumber = "${pageNumber}";

		Click(locator1 = "Downloads#GO_TO_PAGE_NUMBER_LINK");
	}

	@prose = "I go to the previous page of the download search results"
	macro gotoResultsPreviousPage {
		Click(locator1 = "Downloads#GO_TO_PREVIOUS_PAGE_LINK");
	}

	@prose = "I set the search filters to the ${productName} product and ${fileType} file type"
	macro setSearchFilters {
		Select(
			locator1 = "Downloads#PRODUCT_SELECT",
			value1 = "${productName}");

		Select(
			locator1 = "Downloads#FILE_TYPE_SELECT",
			value1 = "${fileType}");
	}

	@prose = "the download with the name ${downloadName} should be visible with the following values ${table}"
	macro viewDownload {
		var key_downloadName = "${downloadName}";

		AssertVisible(locator1 = "Downloads#DOWNLOAD_SELECT");
		AssertVisible(locator1 = "Downloads#DOWNLOAD_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Date") {
				AssertTextEquals(
					locator1 = "Downloads#DOWNLOAD_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "Downloads#DOWNLOAD_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Link") {
				var key_linkValue = "${value}";

				AssertTextEquals(
					locator1 = "Downloads#DOWNLOAD_LINK",
					value1 = "${value}");
			}
			else if ("${field}" == "Info Message") {
				AssertTextEquals.assertPartialText(
					locator1 = "Downloads#DOWNLOAD_INFO_MESSAGE",
					value1 = "${value}");
			}
			else if ("${field}" == "Size") {
				AssertTextEquals(
					locator1 = "Downloads#DOWNLOAD_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "MD5") {
				AssertTextEquals(
					locator1 = "Downloads#DOWNLOAD_MD5",
					value1 = "${value}");
			}
			else {
				fail("No such download field ${field}");
			}
		}
	}

	@prose = "the download with the name ${downloadName} should be visible"
	macro viewDownloadHeader {
		var key_downloadName = "${downloadName}";

		AssertTextEquals(
			locator1 = "Downloads#DOWNLOAD_HEADER",
			value1 = "${downloadName}");
	}

	@prose = "the download with the name ${downloadName} should not be visible"
	macro viewNoDownloadHeader {
		var key_downloadName = "${downloadName}";

		AssertElementNotPresent(locator1 = "Downloads#DOWNLOAD_HEADER");
	}

	@prose = "the current page number of the download results page should be page ${pageNumber}"
	macro viewResultsCurrentPageNumber {
		var key_pageNumber = "${pageNumber}";

		AssertElementPresent(locator1 = "Downloads#CURRENT_PAGE_NUMBER");
	}

	@prose = "I should see the downloaded file ${fileName}"
	macro viewDownloadedFile {
		echo("Expected file name: ${fileName}");

		var tempDir = PropsUtil.get("output.dir.name");

		var filePath = "${tempDir}/${fileName}";

		var fileExists = FileUtil.exists("${filePath}");

		if ("${fileExists}" == "true") {
			echo("File named ${fileName} was downloaded.");
		}
		else {
			fail("File named ${fileName} NOT FOUND in folder ${tempDir}!");
		}
	}

	@prose = "I should not see the downloaded file ${fileName}"
	macro viewNoDownloadedFile {
		echo("Expected file name: ${fileName}");

		var tempDir = PropsUtil.get("output.dir.name");

		var filePath = "${tempDir}/${fileName}";

		var fileExists = FileUtil.exists("${filePath}");

		if ("${fileExists}" == "false") {
			echo("File named ${fileName} was not downloaded.");
		}
		else {
			fail("File named ${fileName} WAS FOUND in folder ${tempDir}!");
		}
	}
}