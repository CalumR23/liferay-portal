definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the team ${teamName} to the following roles ${table}"
	macro _assignContactRolesToContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-email-address/${contactEmailAddress}/roles?contactRoleKeys=${contactRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the team ${teamName} to the following roles executed by ${agentName} ${table}"
	macro _assignContactRolesToContactExecutedByAgent {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-email-address/${contactEmailAddress}/roles?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1\&contactRoleKeys=${contactRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the team ${teamName} to the following roles via uuid ${table}"
	macro _assignContactRolesToContactViaUuid {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

