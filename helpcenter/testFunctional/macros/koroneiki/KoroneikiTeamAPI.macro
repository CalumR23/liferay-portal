	macro _getTeamAuditEntryKey {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if ((!("${oldValue}" == "")) && (!("${newValue}" == ""))) {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");
		}
		else if (!("${newValue}" == "")) {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.newValue=='${newValue}')].key");
		}
		else {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}')].key");
		}

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "&quot;", "");

		echo("Audit entry key value: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getTeamAuditEntryKeyRegardingAdditionalEntities {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if ((!("${oldValue}" == "")) && (!("${newValue}" == "")))  {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");
		}
		else if (!("${newValue}" == "")) {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.description=='${description}' && @.newValue=='${newValue}')].key");
		}
		else {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}')].key");
		}

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "&quot;", "");

		echo("Audit entry key value: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getTeamExternalLinkKey {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} for team ${teamName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getTeamKeyViaTeamName {
		if (contains("${teamName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamName}", " ");
		}
		else {
			var keyword = "${teamName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamName}')].key");

		var teamKey = StringUtil.replace("${teamKey}", "[", "");

		var teamKey = StringUtil.replace("${teamKey}", "]", "");

		var teamKey = StringUtil.replace("${teamKey}", "&quot;", "");

		echo("Team key value for ${teamName}: ${teamKey}");

		return "${teamKey}";
	}

