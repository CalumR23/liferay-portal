	@prose = "the contact with the email address ${contactEmailAddress} should not be visible via nested field on the team ${teamName}"
	macro _viewNoContactViaNestedField {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}?nestedFields=contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamFields = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamFields}", "contacts")) {
			var allTeamContacts = JSONCurlUtil.get("${curl}", "$.contacts");

			if (contains("${allTeamContacts}", "${contactEmailAddress}")) {
				fail("The team with the name ${teamName} contains the contact ${contactEmailAddress}");
			}
		}
		else {
			echo("No contacts present on ${teamName} and therefore there is no contacts nested field visible");
		}
	}

