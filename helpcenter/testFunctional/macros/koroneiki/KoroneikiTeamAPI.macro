				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].website");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the team ${teamName} field ${field} from the old value ${oldValue} to the new value ${newValue}"
	macro _viewTeamAuditEntry {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].action");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "[", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "]", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "&quot;", "");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].field");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "[", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "]", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "&quot;", "");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].oldValue");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "[", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "]", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "&quot;", "");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].newValue");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "[", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "]", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "&quot;", "");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the team ${teamName} field ${field} from the old value ${oldValue} to the new value ${newValue} via the audit entry key"
	macro _viewTeamAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKey(
			teamName = "${teamName}",
			action = "${action}",
			field = "${field}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var actionFromAPI = JSONCurlUtil.get("${curl}", "$.action");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.field");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.oldValue");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.newValue");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} with the following values ${table}"
	macro _viewTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} via the external link key with the following values ${table}"
	macro _viewTeamExternalLinkViaExternalLinkKey {
		var externalLinkKey = KoroneikiTeamAPI._getTeamExternalLinkKey(
			entityId = "${entityId}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityName");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

