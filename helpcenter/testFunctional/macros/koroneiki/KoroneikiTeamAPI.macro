	@prose = "I should be able to view an audit entry for the summary ${summary} related to the team with the name ${teamName} field ${field} from the old value ${oldValue} to the new value ${newValue} regarding ${description} executed by ${agentName} via the audit entry key"
	macro _viewTeamAuditEntryRegardingAdditionalEntitiesViaAuditEntryKey {
		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKeyRegardingAdditionalEntities(
			teamName = "${teamName}",
			description = "${description}",
			summary = "${summary}",
			field = "${field}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.summary");

		echo("Expected Action Value: ${summary}");
		echo("Actual Action Value: ${summaryFromAPI}");

		if (!("${summary}" == "${summaryFromAPI}")) {
			fail("Actual summary value ${summaryFromAPI} does not match expected summary value ${summary}");
		}

		var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.description");

		echo("Expected Description Value: ${description}");
		echo("Actual Description Value: ${descriptionFromAPI}");

		if (!("${description}" == "${descriptionFromAPI}")) {
			fail("Actual description value ${descriptionFromAPI} does not match expected description value ${description}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.field");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.oldValue");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		if (!("${newValue}" == "")) {
			var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.newValue");

			echo("Expected New Value: ${newValue}");
			echo("Actual New Value: ${newValueFromAPI}");

			if (!("${newValue}" == "${newValueFromAPI}")) {
				fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
			}
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.agentName");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}");

		if (contains("${auditEntry}", "agentUID")) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.agentUID");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "I should be able to view an audit entry for the summary ${summary} related to the team ${teamName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName} via the audit entry key"
	macro _viewTeamAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKey(
			teamName = "${teamName}",
			summary = "${summary}",
			field = "${field}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.summary");

		echo("Expected Action Value: ${summary}");
		echo("Actual Action Value: ${summaryFromAPI}");

		if (!("${summary}" == "${summaryFromAPI}")) {
			fail("Actual summary value ${summaryFromAPI} does not match expected summary value ${summary}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.field");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.oldValue");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		if (!("${newValue}" == "")) {
			var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.newValue");

			echo("Expected New Value: ${newValue}");
			echo("Actual New Value: ${newValueFromAPI}");

			if (!("${newValue}" == "${newValueFromAPI}")) {
				fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
			}
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.agentName");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}");

		if (contains("${auditEntry}", "agentUID")) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.agentUID");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} with the following values ${table}"
	macro _viewTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].url");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\/", "/");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} via the external link key with the following values ${table}"
	macro _viewTeamExternalLinkViaExternalLinkKey {
		var externalLinkKey = KoroneikiTeamAPI._getTeamExternalLinkKey(
			entityId = "${entityId}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityName");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.url");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view a koroneiki team with the name ${teamName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId}"
	macro _viewTeamViaExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamName}')].name");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "[", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "]", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "&quot;", "");

		echo("Expected Name Value: ${teamName}");
		echo("Actual Name Value: ${teamNameFromAPI}");

		if (!(contains("${teamName}", "${teamNameFromAPI}"))) {
			fail("Actual team name value ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}
	}

	@prose = "I should be able to view a koroneiki team with the name ${teamName} with the external link nested field value ${teamExternalLinkNestedFieldValue}"
	macro _viewTeamWithExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.name");

		echo("Expected Name Value: ${teamName}");
		echo("Actual Name Value: ${teamNameFromAPI}");

		if (!(contains("${teamName}", "${teamNameFromAPI}"))) {
			fail("Actual team name value ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}

		var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

		var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

		var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

		var externalLinkObjectNumber = "0";

		while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
			var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

			var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

			var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

			var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

			var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");

			var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
		}
		var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

		var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

		var teamExternalLinkNestedFieldValueFromAPI = "${externalLinksObjectsEdit}";

		echo("Expected External Link Nested Field Value: ${teamExternalLinkNestedFieldValue}");
		echo("Actual External Link Nested Field Value: ${teamExternalLinkNestedFieldValueFromAPI}");

		if (!(contains("${teamExternalLinkNestedFieldValue}", "${teamExternalLinkNestedFieldValueFromAPI}"))) {
			fail("Actual team external link nested field value ${teamExternalLinkNestedFieldValueFromAPI} does not match expected team external link nested field value ${teamExternalLinkNestedFieldValue}");
		}
	}
}