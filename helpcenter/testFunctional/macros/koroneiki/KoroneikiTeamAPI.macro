	@prose = "I should be able to view an audit entry for the summary ${summary} related to the team ${teamName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName}"
	macro _viewTeamAuditEntry {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries?pageSize=100
