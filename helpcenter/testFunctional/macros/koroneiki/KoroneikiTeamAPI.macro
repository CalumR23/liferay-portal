definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I create an external link on a team ${teamName} with the following values ${table}"
	macro _createTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a koroneiki team with the name ${teamName}"
	macro _deleteTeam {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on the team ${teamName}"
	macro _deleteTeamExternalLink {
		var externalLinkKey = KoroneikiTeamAPI._getTeamExternalLinkKey(
			entityId = "${entityId}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getTeamAuditEntryKey {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.field=='${fieldName}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "&quot;", "");

		echo("Audit entry key value for change to ${fieldName} from ${oldValue} to ${newValue} on team ${teamName}: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getTeamExternalLinkKey {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} for team ${teamName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getTeamKeyViaTeamName {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamName}')].key");

		var teamKey = StringUtil.replace("${teamKey}", "[", "");

		var teamKey = StringUtil.replace("${teamKey}", "]", "");

		var teamKey = StringUtil.replace("${teamKey}", "&quot;", "");

		echo("Team key value for ${teamName}: ${teamKey}");

		return "${teamKey}";
	}

	@prose = "I tear down the external links for the team ${teamName} on koroneiki with the following entity id values ${table}"
	macro _tearDownTeamExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allTeams = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allTeams}", "${teamName}")) {
				var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allTeamExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allTeamExternalLinks}", "${entityId}")) {
					KoroneikiTeamAPI._deleteTeamExternalLink(
						teamName = "${teamName}",
						entityId = "${entityId}");

					echo("Entity ID of external link for ${teamName} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the teams on koroneiki with the following names ${table}"
	macro _tearDownTeams {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var teamName = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allTeams = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allTeams}", "${teamName}")) {
				KoroneikiTeamAPI._deleteTeam(teamName = "${teamName}");

				echo("Name of team deleted: ${teamName}");
			}
		}
	}

	@prose = "I update a team with the name ${teamName} to have the new name ${teamNameEdit}"
	macro updateTeam {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"name": "${teamNameEdit}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a koroneiki team with the name ${teamName}"
	macro _viewNoTeam {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeams = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeams}", "${teamName}")) {
			fail("The team with the name ${teamName} is still present in Koroneiki");
		}
	}

	@prose = "I should not be able to view an assigned account with the name ${accountName} for the team ${teamName}"
	macro _viewNoTeamAssignedAccount {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/assigned-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamAccounts}", "${accountName}")) {
			fail("The account with the name ${accountName} is still present on the Koroneiki team ${teamName}");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the team ${teamName}"
	macro _viewNoTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the team ${teamName}");
		}
	}

	@prose = "I should be able to view a koroneiki team with the name ${teamName}"
	macro _viewTeam {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.name");

		echo("Expected Name Value: ${teamName}");
		echo("Actual Name Value: ${teamNameFromAPI}");

		if (!(contains("${teamName}", "${teamNameFromAPI}"))) {
			fail("Actual team name value ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}
	}

	@prose = "I should be able to view an assigned account with the name ${accountName} for the team ${teamName} and the following values ${table}"
	macro _viewTeamAssignedAccount {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/assigned-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].code");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].contactEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].description");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].faxNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].industry");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Notes") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].notes");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].phoneNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].profileEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Sold By") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].soldBy");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].status");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].tier");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].website");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view an audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} with the following values ${table}"
	macro _viewTeamAuditEntry {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");

			if ("${field}" == "action") {
				var value = StringUtil.lowerCase("${value}");
			}

			var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.field=='${fieldName}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].${field}");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view an audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} via the audit entry key with the following values ${table}"
	macro _viewTeamAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKey(
			teamName = "${teamName}",
			fieldName = "${fieldName}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");

			if ("${field}" == "action") {
				var value = StringUtil.lowerCase("${value}");
			}

			var valueFromAPI = JSONCurlUtil.get("${curl}", "$.${field}");

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} with the following values ${table}"
	macro _viewTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the team ${teamName} via the external link key with the following values ${table}"
	macro _viewTeamExternalLinkViaExternalLinkKey {
		var externalLinkKey = KoroneikiTeamAPI._getTeamExternalLinkKey(
			entityId = "${entityId}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityName");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view a koroneiki team with the name ${teamName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId}"
	macro _viewTeamViaExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamName}')].name");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "[", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "]", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "&quot;", "");

		echo("Expected Name Value: ${teamName}");
		echo("Actual Name Value: ${teamNameFromAPI}");

		if (!(contains("${teamName}", "${teamNameFromAPI}"))) {
			fail("Actual team name value ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}
	}
}