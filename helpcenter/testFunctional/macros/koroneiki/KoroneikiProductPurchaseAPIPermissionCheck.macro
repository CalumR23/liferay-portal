definition {
	var apiToken = PropsUtil.get("koroneiki.non.permission.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I attempt to create an external link for a product purchase made by account ${accountName} for the product ${productName} with the following values as a non permissioned user ${table}"
	macro _createProductPurchaseExternalLinkAttempt {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName} as a permissioned user"
	macro _deleteProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName} as a non permissioned user"
	macro _deleteProductPurchaseAttempt {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to delete an external link with the entity id ${entityId} on a product purchase made by account ${accountName} for the product ${productName} as a non permissioned user"
	macro _deleteProductPurchaseExternalLinkAttempt {
		var externalLinkKey = KoroneikiProductPurchaseAPI._getProductPurchaseExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I set the permissions for the product purchase made by the account ${accountName} for the product ${productName} to have the following values for a non permissioned user as a permissioned user ${table}"
	macro _setProductPurchasePermissions {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/product-purchase-permissions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

