		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/product-purchase-permissions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

