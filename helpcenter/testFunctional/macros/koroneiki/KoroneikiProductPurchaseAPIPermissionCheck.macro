	@prose = "I attempt to unset the following permissions for the product purchase made by the account ${accountName} for the product ${productName} for a permissioned user as a non permissioned user ${table}"
	macro _unsetProductPurchasePermissionsAttempt {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
