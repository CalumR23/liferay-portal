				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"originalEndDate": "${originalEndDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"quantity": ${quantity},
					"startDate": "${startDate}",
					"status": "${status}"
				}
				''';
		}
		else {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"originalEndDate": "${originalEndDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"properties": {
						${properties}
					},
					"quantity": ${quantity},
					"startDate": "${startDate}",
					"status": "${status}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName} as a non permissioned user"
	macro _viewNoProductPurchase {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountProductPurchases}", "${productKey}")) {
			fail("The product purchase made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}

		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var accountProductPurchase = JSONCurlUtil.get("${curl}", "$");

		if (contains("${accountProductPurchase}", "${productKey}")) {
			fail("The product purchase made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}

	}

	@prose = "the external link with the entity id ${entityId} on the product purchase made by account ${accountName} for the product ${productName} should not be visible to non permissioned users"
	macro _viewNoProductPurchaseExternalLink {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductPurchaseExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductPurchaseExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the product purchase made by the account ${accountName} for the product ${productName} is visible to non permissioned users");
		}

		var externalLinkKey = KoroneikiProductPurchaseAPI._getProductPurchaseExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productPurchaseExternalLink = JSONCurlUtil.get("${curl}", "$");

		if (contains("${productPurchaseExternalLink}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the product purchase made by the account ${accountName} for the product ${productName} is visible to non permissioned users");
		}
	}

	@prose = "I should not be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId} as a non permissioned user"
	macro _viewNoProductPurchaseViaExternalLink {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/by-external-link/${domain}/${entityName}/${entityId} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var accountProductPurchase = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${accountProductPurchase}", "${accountKey}")) || (contains("${accountProductPurchase}", "${productKey}"))) {
			fail("The product purchase made by ${accountName} for the product ${productName} is visible to non permissioned users");
		}
	}

	@prose = "I should be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName} with the following values as a permissioned user ${table}"
	macro _viewProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.endDate");
			}
			else if ("${field}" == "Original End Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.originalEndDate");
			}
			else if ("${field}" == "Perpetual") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.perpetual");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else if ("${field}" == "Quantity") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.quantity");
			}
			else if ("${field}" == "Start Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.startDate");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.status");
			}
			else {
				fail("No such product purchase field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");
				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");
				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}
}