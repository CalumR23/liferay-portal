		}
	}

	@prose = "I update a koroneiki account with the name ${accountName} to have the following values ${table}"
	macro _updateAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Parent Account Name") {
				var parentAccountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${value}");
			}
			else if ("${field}" == "Parent Account Key") {
				var parentAccountKey = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Region") {
				var region = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(agentName))) {
			var agentName = "";
		}

		if (!(isSet(code))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "code=")) {
				var value = JSONCurlUtil.get("${curl}", "$.code");

				var code = "${value}";
			}
			else {
				var code = "";
			}
		}
		if (!(isSet(contactEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "contactEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");

				var contactEmailAddress = "${value}";
			}
			else {
				var contactEmailAddress = "";
			}
		}
		if (!(isSet(description))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(faxNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "faxNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.faxNumber");

				var faxNumber = "${value}";
			}
			else {
				var faxNumber = "";
			}
		}
		if (!(isSet(internal))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "internal=")) {
				var value = JSONCurlUtil.get("${curl}", "$.internal");

				var internal = "${value}";
			}
			else {
				var internal = "false";
			}
		}
		if (!(isSet(name))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(parentAccountKey))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "parentAccountKey=")) {
				var value = JSONCurlUtil.get("${curl}", "$.parentAccountKey");

				var parentAccountKey = "${value}";
			}
			else {
				var parentAccountKey = "";
			}
		}
		if (!(isSet(phoneNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "phoneNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.phoneNumber");

				var phoneNumber = "${value}";
			}
			else {
				var phoneNumber = "";
			}
		}
		if (!(isSet(profileEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "profileEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");

				var profileEmailAddress = "${value}";
			}
			else {
				var profileEmailAddress = "";
			}
		}
		if (!(isSet(region))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "region=")) {
				var value = JSONCurlUtil.get("${curl}", "$.region");

				var region = "${value}";
			}
			else {
				var region = "";
			}
		}
		if (!(isSet(status))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "status=")) {
				var value = JSONCurlUtil.get("${curl}", "$.status");

				var status = "${value}";
			}
			else {
				var status = "";
			}
		}
		if (!(isSet(tier))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "tier=")) {
				var value = JSONCurlUtil.get("${curl}", "$.tier");

				var tier = "${value}";
			}
			else {
				var tier = "";
			}
		}
		if (!(isSet(website))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "website=")) {
				var value = JSONCurlUtil.get("${curl}", "$.website");

				var website = "${value}";
			}
			else {
				var website = "";
			}
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"code": "${code}",
					"contactEmailAddress": "${contactEmailAddress}",
					"description": "${description}",
					"faxNumber": "${faxNumber}",
					"internal": ${internal},
					"name": "${name}",
					"parentAccountKey": "${parentAccountKey}",
					"phoneNumber": "${phoneNumber}",
					"profileEmailAddress": "${profileEmailAddress}",
					"region": "${region}",
					"status": "${status}",
					"tier": "${tier}",
					"website": "${website}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"code": "${code}",
					"contactEmailAddress": "${contactEmailAddress}",
					"description": "${description}",
					"faxNumber": "${faxNumber}",
					"internal": ${internal},
					"name": "${name}",
					"parentAccountKey": "${parentAccountKey}",
					"phoneNumber": "${phoneNumber}",
					"profileEmailAddress": "${profileEmailAddress}",
					"region": "${region}",
					"status": "${status}",
					"tier": "${tier}",
					"website": "${website}"
				}
				''';			
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I update a koroneiki account with the name ${accountName} including nested fields to have the following values ${table}"
	macro _updateAccountIncludingNestedFields {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Contact Nested Field") {
				var contactsNestedField = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Parent Account Name") {
				var parentAccountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${value}");
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Postal Address Nested Field") {
				var postalAddressesNestedField = "${value}";
			}
			else if ("${field}" == "Product Purchase Nested Field") {
				var productPurchasesNestedField = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Region") {
				var region = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=contacts,customerContacts,externalLinks,postalAddresses,productPurchases,workerContacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(code))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "code=")) {
				var value = JSONCurlUtil.get("${curl}", "$.code");

				var code = "${value}";
			}
			else {
				var code = "";
			}
		}
		if (!(isSet(contactEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "contactEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");

				var contactEmailAddress = "${value}";
			}
			else {
				var contactEmailAddress = "";
			}
		}
		if (!(isSet(contactsNestedField))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "contacts=")) {
				var value = JSONCurlUtil.get("${curl}", "$.contacts");

				var value = StringUtil.replace("${value}", "[", "");

				var value = StringUtil.replace("${value}", "]", "");

				var contactsNestedField = "${value}";
			}
			else {
				var contactsNestedField = "";
			}
		}
		if (!(isSet(description))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(externalLinksNestedField))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "externalLinks=")) {
				var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

				var externalLinkObjectNumber = "0";

				while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
					var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");
				}

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

				var externalLinksNestedField = "${externalLinksObjectsEdit}";
			}
			else {
				var externalLinksNestedField = "";
			}
		}
		if (!(isSet(faxNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "faxNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.faxNumber");

				var faxNumber = "${value}";
			}
			else {
				var faxNumber = "";
			}
		}
		if (!(isSet(internal))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "internal=")) {
				var value = JSONCurlUtil.get("${curl}", "$.internal");

				var internal = "${value}";
			}
			else {
				var internal = "false";
			}
		}
		if (!(isSet(name))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(parentAccountKey))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "parentAccountKey=")) {
				var value = JSONCurlUtil.get("${curl}", "$.parentAccountKey");

				var parentAccountKey = "${value}";
			}
			else {
				var parentAccountKey = "";
			}
		}
		if (!(isSet(phoneNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "phoneNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.phoneNumber");

				var phoneNumber = "${value}";
			}
			else {
				var phoneNumber = "";
			}
		}
		if (!(isSet(postalAddressesNestedField))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "postalAddresses=")) {				
				var value = JSONCurlUtil.get("${curl}", "$.postalAddresses");

				var value = StringUtil.replace("${value}", "[", "");

				var value = StringUtil.replace("${value}", "]", "");

				var postalAddressesNestedField = "${value}";
			}
			else {
				var postalAddressesNestedField = "";
			}
		}
		if (!(isSet(productPurchasesNestedField))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "productPurchases=")) {
				var productPurchasesObjects = JSONCurlUtil.get("${curl}", "$.productPurchases");

				var productPurchasesObjectsEdit = JSONCurlUtil.get("${curl}", "$.productPurchases");

				var numberOfProductPurchases = StringUtil.count("${productPurchasesObjects}", "accountKey");

				var productPurchaseObjectNumber = "0";

				while (!("${productPurchaseObjectNumber}" == "${numberOfProductPurchases}")) {
					var productPurchaseObject = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}]");

					var accountKey = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].accountKey");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;accountKey&quot;:&quot;${accountKey}&quot;,", "");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].dateCreated");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					if (contains("${productPurchaseObject}", "externalLinks")) {
						var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks");

						var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

						var externalLinkObjectNumber = "0";

						while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
							var externalLinkDateCreated = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks[${externalLinkObjectNumber}].dateCreated");

							var externalLinkKey = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks[${externalLinkObjectNumber}].key");

							var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;dateCreated&quot;:&quot;${externalLinkDateCreated}&quot;,", "");

							var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", ",&quot;key&quot;:&quot;${externalLinkKey}&quot;", "");

							var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
						}
					}

					var key = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].key");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;key&quot;:&quot;${key}&quot;,", "");

					var product = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].product");

					var product = StringUtil.replace("${product}", "=", "&quot;:&quot;");

					var product = StringUtil.replace("${product}", ", ", "&quot;,&quot;");

					var product = StringUtil.replace("${product}", "{","{&quot;");

					var product = StringUtil.replace("${product}", "}","&quot;}");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;product&quot;:${product},", "");

					var productPurchaseObjectNumber = MathUtil.sum("${productPurchaseObjectNumber}", "1");
				}

				var productPurchasesObjectsEdit = StringUtil.replaceFirst("${productPurchasesObjectsEdit}", "[", "");

				var productPurchasesObjectsEdit = StringUtil.reverse("${productPurchasesObjectsEdit}");

				var productPurchasesObjectsEdit = StringUtil.replaceFirst("${productPurchasesObjectsEdit}", "]", "");

				var productPurchasesObjectsEdit = StringUtil.reverse("${productPurchasesObjectsEdit}");

				var productPurchasesNestedField = "${productPurchasesObjectsEdit}";
			}
			else {
				var productPurchasesNestedField = "";
			}
		}
		if (!(isSet(profileEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "profileEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");

				var profileEmailAddress = "${value}";
			}
			else {
				var profileEmailAddress = "";
			}
		}
		if (!(isSet(region))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "region=")) {
				var value = JSONCurlUtil.get("${curl}", "$.region");

				var region = "${value}";
			}
			else {
				var region = "";
			}
		}
		if (!(isSet(status))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "status=")) {
				var value = JSONCurlUtil.get("${curl}", "$.status");

				var status = "${value}";
			}
			else {
				var status = "";
			}
		}
		if (!(isSet(tier))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "tier=")) {
				var value = JSONCurlUtil.get("${curl}", "$.tier");

				var tier = "${value}";
			}
			else {
				var tier = "";
			}
		}
		if (!(isSet(website))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "website=")) {
				var value = JSONCurlUtil.get("${curl}", "$.website");

				var website = "${value}";
			}
			else {
				var website = "";
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=contacts,customerContacts,externalLinks,postalAddresses,productPurchases,workerContacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"contacts": [${contactsNestedField}],
				"description": "${description}",
				"externalLinks": [${externalLinksNestedField}],
				"faxNumber": "${faxNumber}",
				"internal": ${internal},
				"name": "${name}",
				"parentAccountKey": "${parentAccountKey}",
				"phoneNumber": "${phoneNumber}",
				"postalAddresses": [${postalAddressesNestedField}],
				"productPurchases": [${productPurchasesNestedField}],
				"profileEmailAddress": "${profileEmailAddress}",
				"region": "${region}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I unset the following permissions for a koroneiki account with the name ${accountName} for a permissioned user ${table}"
	macro _unsetAccountPermissions {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Contact") {
				var value = StringUtil.lowerCase("${value}");

				var assignContact = "${value}";
			}
			else if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignContact))) {
			var assignContact = "false";
		}
		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignContact": "${assignContact}",
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I should be able to view a koroneiki account with the name ${accountName} and the following values ${table}"
	macro _viewAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=assignedTeams,contacts,customerContacts,entitlements,externalLinks,postalAddresses,productPurchases,workerContacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assigned Team Nested Field") {
				var assignedTeamsObjects = JSONCurlUtil.get("${curl}", "$.assignedTeams");

				var assignedTeamsObjectsEdit = JSONCurlUtil.get("${curl}", "$.assignedTeams");

				var numberOfAssignedTeams = StringUtil.count("${assignedTeamsObjects}", "name");

				var assignedTeamObjectNumber = "0";

				while (!("${assignedTeamObjectNumber}" == "${numberOfAssignedTeams}")) {
					var assignedTeamObject = JSONCurlUtil.get("${curl}", "$.assignedTeams[${assignedTeamObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.assignedTeams[${assignedTeamObjectNumber}].dateCreated");

					var assignedTeamsObjectsEdit = StringUtil.replace("${assignedTeamsObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var dateModified = JSONCurlUtil.get("${curl}", "$.assignedTeams[${assignedTeamObjectNumber}].dateModified");

					var assignedTeamsObjectsEdit = StringUtil.replace("${assignedTeamsObjectsEdit}", "&quot;dateModified&quot;:&quot;${dateModified}&quot;,", "");

					var system = JSONCurlUtil.get("${curl}", "$.assignedTeams[${assignedTeamObjectNumber}].system");

					var assignedTeamsObjectsEdit = StringUtil.replace("${assignedTeamsObjectsEdit}", ",&quot;system&quot;:${system}", "");

					var assignedTeamObjectNumber = MathUtil.sum("${assignedTeamObjectNumber}", "1");
				}

				var assignedTeamsObjectsEdit = StringUtil.replaceFirst("${assignedTeamsObjectsEdit}", "[", "");

				var assignedTeamsObjectsEdit = StringUtil.reverse("${assignedTeamsObjectsEdit}");

				var assignedTeamsObjectsEdit = StringUtil.replaceFirst("${assignedTeamsObjectsEdit}", "]", "");

				var assignedTeamsObjectsEdit = StringUtil.reverse("${assignedTeamsObjectsEdit}");

				var valueFromAPI = "${assignedTeamsObjectsEdit}";
			}
			else if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.code");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");
			}
			else if ("${field}" == "Contact Nested Field") {
				var contactsObjects = JSONCurlUtil.get("${curl}", "$.contacts");

				var contactsObjectsEdit = JSONCurlUtil.get("${curl}", "$.contacts");

				var numberOfContacts = StringUtil.count("${contactsObjects}", "uuid");

				var contactObjectNumber = "0";

				while (!("${contactObjectNumber}" == "${numberOfContacts}")) {
					var contactObject = JSONCurlUtil.get("${curl}", "$.contacts[${contactObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.contacts[${contactObjectNumber}].dateCreated");

					var contactsObjectsEdit = StringUtil.replace("${contactsObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var dateModified = JSONCurlUtil.get("${curl}", "$.contacts[${contactObjectNumber}].dateModified");

					var contactsObjectsEdit = StringUtil.replace("${contactsObjectsEdit}", "&quot;dateModified&quot;:&quot;${dateModified}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.contacts[${contactObjectNumber}].key");

					var contactsObjectsEdit = StringUtil.replace("${contactsObjectsEdit}", "&quot;key&quot;:&quot;${key}&quot;,", "");

					var teams = JSONCurlUtil.get("${curl}", "$.contacts[${contactObjectNumber}].teams");

					var contactsObjectsEdit = StringUtil.replace("${contactsObjectsEdit}", "&quot;teams&quot;:${teams},", "");

					var contactObjectNumber = MathUtil.sum("${contactObjectNumber}", "1");
				}

				var contactsObjectsEdit = StringUtil.replaceFirst("${contactsObjectsEdit}", "[", "");

				var contactsObjectsEdit = StringUtil.reverse("${contactsObjectsEdit}");

				var contactsObjectsEdit = StringUtil.replaceFirst("${contactsObjectsEdit}", "]", "");

				var contactsObjectsEdit = StringUtil.reverse("${contactsObjectsEdit}");

				var valueFromAPI = "${contactsObjectsEdit}";
			}
			else if ("${field}" == "Customer Contact Nested Field") {
				var customerContactsObjects = JSONCurlUtil.get("${curl}", "$.customerContacts");

				var customerContactsObjectsEdit = JSONCurlUtil.get("${curl}", "$.customerContacts");

				var numberOfCustomerContacts = StringUtil.count("${customerContactsObjects}", "uuid");

				var customerContactObjectNumber = "0";

				while (!("${customerContactObjectNumber}" == "${numberOfCustomerContacts}")) {
					var customerContactObject = JSONCurlUtil.get("${curl}", "$.customerContacts[${customerContactObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.customerContacts[${customerContactObjectNumber}].dateCreated");

					var customerContactsObjectsEdit = StringUtil.replace("${customerContactsObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var dateModified = JSONCurlUtil.get("${curl}", "$.customerContacts[${customerContactObjectNumber}].dateModified");

					var customerContactsObjectsEdit = StringUtil.replace("${customerContactsObjectsEdit}", "&quot;dateModified&quot;:&quot;${dateModified}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.customerContacts[${customerContactObjectNumber}].key");

					var customerContactsObjectsEdit = StringUtil.replace("${customerContactsObjectsEdit}", "&quot;key&quot;:&quot;${key}&quot;,", "");

					var teams = JSONCurlUtil.get("${curl}", "$.customerContacts[${customerContactObjectNumber}].teams");

					var customerContactsObjectsEdit = StringUtil.replace("${customerContactsObjectsEdit}", "&quot;teams&quot;:${teams},", "");

					var customerContactObjectNumber = MathUtil.sum("${customerContactObjectNumber}", "1");
				}

				var customerContactsObjectsEdit = StringUtil.replaceFirst("${customerContactsObjectsEdit}", "[", "");

				var customerContactsObjectsEdit = StringUtil.reverse("${customerContactsObjectsEdit}");

				var customerContactsObjectsEdit = StringUtil.replaceFirst("${customerContactsObjectsEdit}", "]", "");

				var customerContactsObjectsEdit = StringUtil.reverse("${customerContactsObjectsEdit}");

				var valueFromAPI = "${customerContactsObjectsEdit}";
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Entitlement Nested Field") {
				var entitlementsObjects = JSONCurlUtil.get("${curl}", "$.entitlements");

				var entitlementsObjects = StringUtil.replace("${entitlementsObjects}", "[", "");

				var entitlementsObjects = StringUtil.replace("${entitlementsObjects}", "]", "");

				var valueFromAPI = "${entitlementsObjects}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

				var externalLinkObjectNumber = "0";

				while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
					var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");

					var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
				}
				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

				var valueFromAPI = "${externalLinksObjectsEdit}";
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.faxNumber");
			}
			else if ("${field}" == "Internal") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.internal");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Parent Account Name") {
				var value = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${value}");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.parentAccountKey");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.phoneNumber");
			}
			else if ("${field}" == "Postal Address Nested Field") {
				var value = StringUtil.replace("${value}", ",&quot;streetAddressLine2&quot;:&quot;&quot;", "");

				var value = StringUtil.replace("${value}", ",&quot;streetAddressLine3&quot;:&quot;&quot;", "");

				var postalAddressesObjects = JSONCurlUtil.get("${curl}", "$.postalAddresses");

				var postalAddressesObjectsEdit = JSONCurlUtil.get("${curl}", "$.postalAddresses");

				var numberOfPostalAddresses = StringUtil.count("${postalAddressesObjects}", "addressCountry");

				var postalAddressObjectNumber = "0";

				while (!("${postalAddressObjectNumber}" == "${numberOfPostalAddresses}")) {
					var postalAddressObject = JSONCurlUtil.get("${curl}", "$.postalAddresses[${postalAddressObjectNumber}]");

					var id = JSONCurlUtil.get("${curl}", "$.postalAddresses[${postalAddressObjectNumber}].id");

					var postalAddressesObjectsEdit = StringUtil.replace("${postalAddressesObjectsEdit}", "&quot;id&quot;:${id},", "");

					var postalAddressObjectNumber = MathUtil.sum("${postalAddressObjectNumber}", "1");
				}

				var postalAddressesObjectsEdit = StringUtil.replaceFirst("${postalAddressesObjectsEdit}", "[", "");

				var postalAddressesObjectsEdit = StringUtil.reverse("${postalAddressesObjectsEdit}");

				var postalAddressesObjectsEdit = StringUtil.replaceFirst("${postalAddressesObjectsEdit}", "]", "");

				var postalAddressesObjectsEdit = StringUtil.reverse("${postalAddressesObjectsEdit}");

				var valueFromAPI = "${postalAddressesObjectsEdit}";
			}
			else if ("${field}" == "Product Purchase Nested Field") {
				var productPurchasesObjects = JSONCurlUtil.get("${curl}", "$.productPurchases");

				var productPurchasesObjectsEdit = JSONCurlUtil.get("${curl}", "$.productPurchases");

				var numberOfProductPurchases = StringUtil.count("${productPurchasesObjects}", "accountKey");

				var productPurchaseObjectNumber = "0";

				while (!("${productPurchaseObjectNumber}" == "${numberOfProductPurchases}")) {
					var productPurchaseObject = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}]");

					var accountKey = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].accountKey");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;accountKey&quot;:&quot;${accountKey}&quot;,", "");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].dateCreated");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					if (contains("${productPurchaseObject}", "externalLinks")) {
						var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks");

						var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

						var externalLinkObjectNumber = "0";

						while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
							var externalLinkDateCreated = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks[${externalLinkObjectNumber}].dateCreated");

							var externalLinkKey = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].externalLinks[${externalLinkObjectNumber}].key");

							var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;dateCreated&quot;:&quot;${externalLinkDateCreated}&quot;,", "");

							var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", ",&quot;key&quot;:&quot;${externalLinkKey}&quot;", "");

							var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
						}
					}
					var key = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].key");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;key&quot;:&quot;${key}&quot;,", "");

					var product = JSONCurlUtil.get("${curl}", "$.productPurchases[${productPurchaseObjectNumber}].product");

					var product = StringUtil.replace("${product}", "=", "&quot;:&quot;");

					var product = StringUtil.replace("${product}", ", ", "&quot;,&quot;");

					var product = StringUtil.replace("${product}", "{","{&quot;");

					var product = StringUtil.replace("${product}", "}","&quot;}");

					var productPurchasesObjectsEdit = StringUtil.replace("${productPurchasesObjectsEdit}", "&quot;product&quot;:${product},", "");

					var productPurchaseObjectNumber = MathUtil.sum("${productPurchaseObjectNumber}", "1");
				}
				var productPurchasesObjectsEdit = StringUtil.replaceFirst("${productPurchasesObjectsEdit}", "[", "");

				var productPurchasesObjectsEdit = StringUtil.reverse("${productPurchasesObjectsEdit}");

				var productPurchasesObjectsEdit = StringUtil.replaceFirst("${productPurchasesObjectsEdit}", "]", "");

				var productPurchasesObjectsEdit = StringUtil.reverse("${productPurchasesObjectsEdit}");

				var valueFromAPI = "${productPurchasesObjectsEdit}";
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");
			}
			else if ("${field}" == "Region") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.region");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.status");
			}
			else if ("${field}" == "Tier") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.tier");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.website");
			}
			else if ("${field}" == "Worker Contact Nested Field") {
				var workerContactsObjects = JSONCurlUtil.get("${curl}", "$.workerContacts");

				var workerContactsObjectsEdit = JSONCurlUtil.get("${curl}", "$.workerContacts");

				var numberOfWorkerContacts = StringUtil.count("${workerContactsObjects}", "uuid");

				var workerContactObjectNumber = "0";

				while (!("${workerContactObjectNumber}" == "${numberOfWorkerContacts}")) {
					var workerContactObject = JSONCurlUtil.get("${curl}", "$.workerContacts[${workerContactObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.workerContacts[${workerContactObjectNumber}].dateCreated");

					var workerContactsObjectsEdit = StringUtil.replace("${workerContactsObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var dateModified = JSONCurlUtil.get("${curl}", "$.workerContacts[${workerContactObjectNumber}].dateModified");

					var workerContactsObjectsEdit = StringUtil.replace("${workerContactsObjectsEdit}", "&quot;dateModified&quot;:&quot;${dateModified}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.workerContacts[${workerContactObjectNumber}].key");

					var workerContactsObjectsEdit = StringUtil.replace("${workerContactsObjectsEdit}", "&quot;key&quot;:&quot;${key}&quot;,", "");

					var teams = JSONCurlUtil.get("${curl}", "$.workerContacts[${workerContactObjectNumber}].teams");

					var workerContactsObjectsEdit = StringUtil.replace("${workerContactsObjectsEdit}", "&quot;teams&quot;:${teams},", "");

					var workerContactObjectNumber = MathUtil.sum("${workerContactObjectNumber}", "1");
				}

				var workerContactsObjectsEdit = StringUtil.replaceFirst("${workerContactsObjectsEdit}", "[", "");

				var workerContactsObjectsEdit = StringUtil.reverse("${workerContactsObjectsEdit}");

				var workerContactsObjectsEdit = StringUtil.replaceFirst("${workerContactsObjectsEdit}", "]", "");

				var workerContactsObjectsEdit = StringUtil.reverse("${workerContactsObjectsEdit}");

				var valueFromAPI = "${workerContactsObjectsEdit}";
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view an audit entry for the summary ${summary} related to the account ${accountName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName}"
	macro _viewAccountAuditEntry {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		if (!("${field}" == "Address")) {
			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if ((!("${oldValue}" == "")) && (!("${newValue}" == "")))  {
			var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].summary");

			echo("Action From API Value: ${summaryFromAPI}");
		}
		else if (!("${newValue}" == "")) {
			var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.newValue=='${newValue}')].summary");

			echo("Action From API Value: ${summaryFromAPI}");
		}
		else {
			var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}')].summary");

			echo("Action From API Value: ${summaryFromAPI}");
		}

		var summaryFromAPI = StringUtil.replace("${summaryFromAPI}", "[", "");

		echo("Action From API Value: ${summaryFromAPI}");

		var summaryFromAPI = StringUtil.replace("${summaryFromAPI}", "]", "");

		echo("Action From API Value: ${summaryFromAPI}");

		var summaryFromAPI = StringUtil.replace("${summaryFromAPI}", "&quot;", "");

		echo("Action From API Value: ${summaryFromAPI}");

		echo("Expected Action Value: ${summary}");
		echo("Actual Action Value: ${summaryFromAPI}");

		if (!("${summary}" == "${summaryFromAPI}")) {
			fail("Actual summary value ${summaryFromAPI} does not match expected summary value ${summary}");
		}

