definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I create an account on koroneiki with the following values ${table}"
	macro _createAccount {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var industry = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Sold By") {
				var soldBy = "${value}";
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(code))) {
			var code = "";
		}
		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}
		if (!(isSet(industry))) {
			var industry = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(notes))) {
			var notes = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}
		if (!(isSet(soldBy))) {
			var soldBy = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}
		if (!(isSet(tier))) {
			var tier = "";
		}
		if (!(isSet(website))) {
			var website = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"description": "${description}",
				"faxNumber": "${faxNumber}",
				"industry": "${industry}",
				"logoId": "0",
				"name": "${name}",
				"notes": "${notes}",
				"phoneNumber": "${phoneNumber}",
				"profileEmailAddress": "${profileEmailAddress}",
				"soldBy": "${soldBy}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a child account for an account with the name ${accountName} on koroneiki with the following values ${table}"
	macro _createChildAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var industry = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Sold By") {
				var soldBy = "${value}";
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(code))) {
			var code = "";
		}
		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}
		if (!(isSet(industry))) {
			var industry = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(notes))) {
			var notes = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}
		if (!(isSet(soldBy))) {
			var soldBy = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}
		if (!(isSet(tier))) {
			var tier = "";
		}
		if (!(isSet(website))) {
			var website = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/child-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"description": "${description}",
				"faxNumber": "${faxNumber}",
				"industry": "${industry}",
				"logoId": "0",
				"name": "${name}",
				"notes": "${notes}",
				"phoneNumber": "${phoneNumber}",
				"profileEmailAddress": "${profileEmailAddress}",
				"soldBy": "${soldBy}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete an account on koroneiki with the name ${accountName}"
	macro _deleteAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getAccountKeyViaAccountName {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var accountKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].key");

		var accountKey = StringUtil.replace("${accountKey}", "[", "");

		var accountKey = StringUtil.replace("${accountKey}", "]", "");

		var accountKey = StringUtil.replace("${accountKey}", "&quot;", "");

		echo("Account Key value for ${accountName}: ${accountKey}");

		return "${accountKey}";
	}

	@prose = "I tear down the accounts on koroneiki with the following names ${table}"
	macro _tearDownAccounts {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var totalCount = JSONCurlUtil.get("${curl}", "$.totalCount");

		if (!("${totalCount}" == "0")) {
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var accountName = "${row[0]}";

				var accountArrayValue = "0";

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var totalCount = JSONCurlUtil.get("${curl}", "$.totalCount");

				var accountDeleted = "false";

				while ((!("${accountArrayValue}" == "${totalCount}")) && ("${accountDeleted}" == "false")) {
					var curl = '''
						--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var accountNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[${accountArrayValue}].name");

					var accountNameFromAPI = StringUtil.replace("${accountNameFromAPI}", "[", "");

					var accountNameFromAPI = StringUtil.replace("${accountNameFromAPI}", "]", "");

					var accountNameFromAPI = StringUtil.replace("${accountNameFromAPI}", "&quot;", "");

					if ("${accountName}" == "${accountNameFromAPI}") {
						var curl = '''
							--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
							--header "API_Token: ${apiToken}"
							-H "accept: application/json"
							-H "Content-Type: application/json"
							''';

						var accountKey = JSONCurlUtil.get("${curl}", "$.items[${accountArrayValue}].key");

						var accountKey = StringUtil.replace("${accountKey}", "[", "");

						var accountKey = StringUtil.replace("${accountKey}", "]", "");

						var accountKey = StringUtil.replace("${accountKey}", "&quot;", "");

						var curl = '''
							--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
							--header "API_Token: ${apiToken}"
							-H "accept: application/json"
							-H "Content-Type: application/json"
							''';

						com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");

						var accountDeleted = "true";

						echo("Name of account deleted: ${accountName}");
					}
					else {
						var accountArrayValue = MathUtil.sum("${accountArrayValue}", "1");
					}
				}
			}
		}
	}

	@prose = "I update a koroneiki account with the name ${accountName} to have the following values ${table}"
	macro _updateAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var industry = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
