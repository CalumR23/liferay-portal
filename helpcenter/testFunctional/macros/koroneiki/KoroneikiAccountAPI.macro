	@prose = "I create an account on koroneiki with the following values ${table}"
	macro _createAccount {
		var properties = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Account Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "Assigned Team Nested Field") {
				var assignedTeamsNestedField = "${value1}";
			}
			else if ("${field}" == "Code") {
				var code = "${value1}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value1}";
			}
			else if ("${field}" == "Contact Nested Field") {
				var contactsNestedField = "${value1}";
			}
			else if ("${field}" == "Data Region") {
				var dataRegion = "${value1}";
			}
			else if ("${field}" == "Description") {
				var description = "${value1}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value1}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value1}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value1}";
			}
			else if ("${field}" == "Language") {
				var language = "${value1}";
			}
			else if ("${field}" == "Name") {
				var name = "${value1}";
			}
			else if ("${field}" == "Parent Account Name") {
				var parentAccountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${value1}");
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value1}";
			}
			else if ("${field}" == "Postal Address Nested Field") {
				var postalAddressesNestedField = "${value1}";
			}
			else if ("${field}" == "Product Purchase Nested Field") {
				var productPurchasesNestedField = "${value1}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value1}";
			}
			else if ("${field}" == "Region") {
				var region = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value1}";
			}
			else if ("${field}" == "Website") {
				var website = "${value1}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}

		if (!(isSet(assignedTeamsNestedField))) {
			var assignedTeamsNestedField = "";
		}

		if (!(isSet(code))) {
			var code = "";
		}

		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}

		if (!(isSet(contactsNestedField))) {
			var contactsNestedField = "";
		}

		if (!(isSet(dataRegion))) {
			var dataRegion = "";
		}

		if (!(isSet(description))) {
			var description = "";
		}

		if (!(isSet(externalLinksNestedField))) {
			var externalLinksNestedField = "";
		}

		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}

		if (!(isSet(internal))) {
			var internal = "false";
		}

		if (!(isSet(language))) {
			var language = "";
		}

		if (!(isSet(name))) {
			var name = "";
		}

		if (!(isSet(parentAccountKey))) {
			var parentAccountKey = "";
		}

		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}

		if (!(isSet(postalAddressesNestedField))) {
			var postalAddressesNestedField = "";
		}

		if (!(isSet(productPurchasesNestedField))) {
			var productPurchasesNestedField = "";
		}

		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}

		if (!(isSet(region))) {
			var region = "";
		}

		if (!(isSet(status))) {
			var status = "";
		}

		if (!(isSet(tier))) {
			var tier = "";
		}

		if (!(isSet(website))) {
			var website = "";
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"assignedTeams": [${assignedTeamsNestedField}],
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"contacts": [${contactsNestedField}],
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"externalLinks": [${externalLinksNestedField}],
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"parentAccountKey": "${parentAccountKey}",
						"phoneNumber": "${phoneNumber}",
						"postalAddresses": [${postalAddressesNestedField}],
						"productPurchases": [${productPurchasesNestedField}],
						"profileEmailAddress": "${profileEmailAddress}",
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
					''';
			}
			else {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"assignedTeams": [${assignedTeamsNestedField}],
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"contacts": [${contactsNestedField}],
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"externalLinks": [${externalLinksNestedField}],
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"parentAccountKey": "${parentAccountKey}",
						"phoneNumber": "${phoneNumber}",
						"postalAddresses": [${postalAddressesNestedField}],
						"productPurchases": [${productPurchasesNestedField}],
						"profileEmailAddress": "${profileEmailAddress}",
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
					''';
			}
		}
		else {
			if ("${agentName}" == "") {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"assignedTeams": [${assignedTeamsNestedField}],
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"contacts": [${contactsNestedField}],
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"externalLinks": [${externalLinksNestedField}],
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"parentAccountKey": "${parentAccountKey}",
						"phoneNumber": "${phoneNumber}",
						"postalAddresses": [${postalAddressesNestedField}],
						"productPurchases": [${productPurchasesNestedField}],
						"profileEmailAddress": "${profileEmailAddress}",
						"properties": {
							${properties}
						},
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
					''';
			}
			else {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"assignedTeams": [${assignedTeamsNestedField}],
						"code": "${code}",
						"contactEmailAddress": "${contactEmailAddress}",
						"contacts": [${contactsNestedField}],
						"dataRegion": "${dataRegion}",
						"description": "${description}",
						"externalLinks": [${externalLinksNestedField}],
						"faxNumber": "${faxNumber}",
						"internal": ${internal},
						"language": "${language}",
						"name": "${name}",
						"parentAccountKey": "${parentAccountKey}",
						"phoneNumber": "${phoneNumber}",
						"postalAddresses": [${postalAddressesNestedField}],
						"productPurchases": [${productPurchasesNestedField}],
						"profileEmailAddress": "${profileEmailAddress}",
						"properties": {
							${properties}
						},
						"region": "${region}",
						"status": "${status}",
						"tier": "${tier}",
						"website": "${website}"
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an account entitlement definition related to the product purchase of the product ${productName} with the following values ${table}"
	macro _createAccountEntitlementDefinition {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else {
				fail("No such entitlment definition field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}

		if (!(isSet(description))) {
			var description = "";
		}

		if (!(isSet(name))) {
			var name = "";
		}

