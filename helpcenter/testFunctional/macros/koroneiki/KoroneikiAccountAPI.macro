			var agentName = "";
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}

		if (!(isSet(productPurchaseKey))) {
			var productPurchaseKey = "";
		}

		if (!(isSet(startDate))) {
			var startDate = "";
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
					--header "API_Token: ${apiToken}"
