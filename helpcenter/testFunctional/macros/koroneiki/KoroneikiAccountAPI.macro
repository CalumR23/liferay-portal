	macro _getAccountAuditEntryKey {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		if ("${field}" != "Address") {
			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/audit-entries?pageSize=100 --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (("${oldValue}" != "") && ("${newValue}" != "")) {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");
		}
		else if ("${newValue}" != "") {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.newValue=='${newValue}')].key");
		}
		else {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}')].key");
		}

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "\"", "");

		echo("Audit entry key value: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getAccountCode {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var accountCode = JSONCurlUtil.get("${curl}", "$.code");
		return "${accountCode}";
	}

