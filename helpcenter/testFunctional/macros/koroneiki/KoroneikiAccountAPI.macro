	macro _getAccountKeyViaAccountFieldNameAndValue {
		var fieldName = StringUtil.replace("${fieldName}", " ", "");

		var fieldName = StringUtil.lowerCaseFirstLetter("${fieldName}");

		if (contains("${fieldValue}", " ")) {
			var keyword = StringUtil.extractFirst("${fieldValue}", " ");
		}
		else {
			var keyword = "${fieldValue}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var accountKey = JSONCurlUtil.get("${curl}", "$.items[?(@.${fieldName}=='${fieldValue}')].key");

		var accountKey = StringUtil.replace("${accountKey}", "[", "");

		var accountKey = StringUtil.replace("${accountKey}", "]", "");

		var accountKey = StringUtil.replace("${accountKey}", "&quot;", "");

		echo("Account Key value for account with ${fieldName} value ${fieldValue}: ${accountKey}");

		return "${accountKey}";
	}

