	@prose = "I should be able to view a koroneiki account with the ${fieldName} ${fieldValue} and the following values ${table}"
	macro _viewAccountViaAccountFieldNameAndValue {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountFieldNameAndValue(
			fieldName = "${fieldName}",
			fieldValue = "${fieldValue}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Account Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.code");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");
			}
			else if ("${field}" == "Data Region") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.dataRegion");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.faxNumber");
			}
			else if ("${field}" == "Internal") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.internal");
			}
			else if ("${field}" == "Language") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.language");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.phoneNumber");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");
			}
			else if ("${field}" == "Region") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.region");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.status");
			}
			else if ("${field}" == "Tier") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.tier");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.website");
			}
			else {
				fail("No such account field ${field}");
			}

			if ("${field}" == "Account Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");

				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

