		}

		if (!(isSet(tier))) {
			var tier = "";
		}

		if (!(isSet(website))) {
			var website = "";
		}

		if ("${properties}" == "") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
