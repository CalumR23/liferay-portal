	macro _getAccountId {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var accountId = StringUtil.replace("${accountKey}", "KOR-", "");

		return "${accountId}";
	}

	macro _getAccountKeyViaAccountFieldNameAndValue {
		var fieldName = StringUtil.replace("${fieldName}", " ", "");

		var fieldName = StringUtil.lowerCaseFirstLetter("${fieldName}");

		if (contains("${fieldValue}", " ")) {
			var keyword = StringUtil.extractFirst("${fieldValue}", " ");
		}
		else {
			var keyword = "${fieldValue}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100 --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var accountKey = JSONCurlUtil.get("${curl}", "$.items[?(@.${fieldName}=='${fieldValue}')].key");

		var accountKey = StringUtil.replace("${accountKey}", "[", "");

		var accountKey = StringUtil.replace("${accountKey}", "]", "");

		var accountKey = StringUtil.replace("${accountKey}", "\"", "");

		echo("Account Key value for account with ${fieldName} value ${fieldValue}: ${accountKey}");

		return "${accountKey}";
	}

	macro _getAccountKeyViaAccountName {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.replace("${accountName}", " ", "+");
		}
		else {
			var keyword = "${accountName}";
		}

		if (contains("${accountName}", "Liferay, Inc.")) {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="code%20eq%20'LIFERAYINC'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}
		else {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}

		var accountKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].key");

		var accountKey = StringUtil.replace("${accountKey}", "[", "");

		var accountKey = StringUtil.replace("${accountKey}", "]", "");

		var accountKey = StringUtil.replace("${accountKey}", "\"", "");

		echo("Account Key value for ${accountName}: ${accountKey}");

		return "${accountKey}";
	}

	macro _getAccountKeyViaAccountNameAndProperty {
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter=property_${propertyName}+eq+%27${propertyValue}%27 --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
