	@prose = "I should be able to view an audit entry for the summary ${summary} related to the account ${accountName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName}"
	macro _viewAccountAuditEntry {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		if ("${field}" != "Address") {
			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/audit-entries?pageSize=100 --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (("${oldValue}" != "") && ("${newValue}" != "")) {
			var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].summary");

			echo("Action From API Value: ${summaryFromAPI}");
		}
		else if ("${newValue}" != "") {
			var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.summary=='${summary}' && @.field=='${field}' && @.newValue=='${newValue}')].summary");

			echo("Action From API Value: ${summaryFromAPI}");
		}
		else {
