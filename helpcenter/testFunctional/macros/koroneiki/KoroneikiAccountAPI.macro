	@prose = "I update a koroneiki account with the name ${accountName} including assigned teams to have the following values ${table}"
	macro _updateAccountIncludingAssignedTeams {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var properties = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Account Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
