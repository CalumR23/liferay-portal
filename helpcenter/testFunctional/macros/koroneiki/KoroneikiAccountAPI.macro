	@prose = "I set the permissions for a koroneiki account with the name ${accountName} to have the following values for a non permissioned user ${table}"
	macro _setAccountPermissions {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Contact") {
				var value = StringUtil.lowerCase("${value}");

				var assignContact = "${value}";
			}
			else if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignContact))) {
			var assignContact = "false";
		}
		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignContact": "${assignContact}",
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I synchronize the account entitlement definition with the name ${entitlementDefinitionName}"
	macro _synchronizeAccountEntitlementDefinition {
		var entitlementDefinitionKey = KoroneikiAccountAPI._getAccountEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}/synchronize
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-H "Content-Length: 0"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I synchronize the account entitlement definition with the name ${entitlementDefinitionName} executed by ${agentName}"
	macro _synchronizeAccountEntitlementDefinitionExecutedByAgent {
		var entitlementDefinitionKey = KoroneikiAccountAPI._getAccountEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}/synchronize?agentName=${agentName}\&agentUID=koroneikiagent
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-H "Content-Length: 0"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I tear down the account entitlement definitions on koroneiki with the following name values ${table}"
	macro _tearDownAccountEntitlementDefinitions {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entitlementDefinitionName = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccountEntitlementDefinitions = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccountEntitlementDefinitions}", "${entitlementDefinitionName}")) {
				KoroneikiAccountAPI._deleteAccountEntitlementDefinition(entitlementDefinitionName = "${entitlementDefinitionName}");

				echo("Name of entitlement definition deleted: ${entitlementDefinitionName}");
			}
		}
	}

	@prose = "I tear down the external links for the account ${accountName} on koroneiki with the following entity id values ${table}"
	macro _tearDownAccountExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.extractFirst("${accountName}", " ");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allAccountExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allAccountExternalLinks}", "${entityId}")) {
					KoroneikiAccountAPI._deleteAccountExternalLink(
						accountName = "${accountName}",
						entityId = "${entityId}");

					echo("Entity ID of external link for ${accountName} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the external links for the account ${accountName} on koroneiki with the following entity id and domain values ${table}"
	macro _tearDownAccountExternalLinksViaIdAndDomain {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";
			var domain = "${row[1]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.extractFirst("${accountName}", " ");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allAccountExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if ((contains("${allAccountExternalLinks}", "${entityId}")) && (contains("${allAccountExternalLinks}", "${domain}"))) {
					KoroneikiAccountAPI._deleteAccountExternalLinkViaIdAndDomain(
						accountName = "${accountName}",
						domain = "${domain}",
						entityId = "${entityId}");

					echo("Entity ID and domain of external link for ${accountName} deleted: ${entityId} and ${domain}");
				}
			}
		}
	}

	@prose = "I tear down the permissions for a koroneiki account with the name ${accountName} set for a non permissioned user"
	macro _tearDownAccountPermissions {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.extractFirst("${accountName}", " ");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"assignContact": "true",
					"assignTeam": "true",
					"delete": "true",
					"permissions": "true",
					"roleNames": [
						"${roleName}"
					],
					"update": "true",
					"view": "true"
				}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I tear down the accounts on koroneiki with the following names ${table}"
	macro _tearDownAccounts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var accountName = "${row[0]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.extractFirst("${accountName}", " ");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				KoroneikiAccountAPI._deleteAccount(accountName = "${accountName}");

				echo("Name of account deleted: ${accountName}");
			}
		}
	}

	@prose = "I tear down the accounts on koroneiki with the following ${fieldName} values ${table}"
	macro _tearDownAccountsViaAccountFieldNameAndValue {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldValue = "${row[0]}";

			if (contains("${fieldValue}", " ")) {
				var keyword = StringUtil.extractFirst("${fieldValue}", " ");
			}
			else {
				var keyword = "${fieldValue}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
