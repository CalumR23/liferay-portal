	@prose = "I create a postal address for an account with the name ${accountName} on koroneiki with the following values ${table}"
	macro _createAccountPostalAddress {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Country") {
				var addressCountry = "${value}";
			}
			else if ("${field}" == "Locality") {
				var addressLocality = "${value}";
			}
			else if ("${field}" == "Region") {
				var addressRegion = "${value}";
			}
			else if ("${field}" == "Type") {
				var addressType = "${value}";
			}
			else if ("${field}" == "Mailing") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var mailing = "${value}";
			}
			else if ("${field}" == "Postal Code") {
				var postalCode = "${value}";
			}
			else if ("${field}" == "Primary") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var primary = "${value}";
			}
			else if ("${field}" == "Street Address Line 1") {
				var streetAddressLine1 = "${value}";
			}
			else if ("${field}" == "Street Address Line 2") {
				var streetAddressLine2 = "${value}";
			}
			else if ("${field}" == "Street Address Line 3") {
				var streetAddressLine3 = "${value}";
			}
			else {
				fail("No such postal address field ${field}");
			}
		}

		if (!(isSet(addressCountry))) {
			var addressCountry = "";
		}
		if (!(isSet(addressLocality))) {
			var addressLocality = "";
		}
		if (!(isSet(addressRegion))) {
			var addressRegion = "";
		}
		if (!(isSet(addressType))) {
			var addressType = "";
		}
		if (!(isSet(mailing))) {
			var mailing = "false";
		}
		if (!(isSet(postalCode))) {
			var postalCode = "";
		}
		if (!(isSet(primary))) {
			var primary = "false";
		}
		if (!(isSet(streetAddressLine1))) {
			var streetAddressLine1 = "";
		}
		if (!(isSet(streetAddressLine2))) {
			var streetAddressLine2 = "";
		}
		if (!(isSet(streetAddressLine3))) {
			var streetAddressLine3 = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/postal-addresses
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"addressCountry": "${addressCountry}",
				"addressLocality": "${addressLocality}",
				"addressRegion": "${addressRegion}",
				"addressType": "${addressType}",
				"mailing": ${mailing},
				"postalCode": "${postalCode}",
				"primary": ${primary},
				"streetAddressLine1": "${streetAddressLine1}",
				"streetAddressLine2": "${streetAddressLine2}",
				"streetAddressLine3": "${streetAddressLine3}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a product consumption for an account with the name ${accountName} and the product ${productName} on koroneiki with the following values ${table}"
	macro _createAccountProductConsumption {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
			}
			else {
				fail("No such product consumption field ${field}");
			}
		}

		if ("${properties}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"productKey": "${productKey}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"productKey": "${productKey}",
					"properties": {
						${properties}
					}
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a product purchase for an account with the name ${accountName} and the product ${productName} on koroneiki with the following values ${table}"
	macro _createAccountProductPurchase {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}
		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}
		if (!(isSet(quantity))) {
			var quantity = "1";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}

		if ("${properties}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"quantity": ${quantity},
					"startDate": "${startDate}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"properties": {
						${properties}
					},
					"quantity": ${quantity},
					"startDate": "${startDate}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete an account on koroneiki with the name ${accountName}"
	macro _deleteAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on the account ${accountName}"
	macro _deleteAccountExternalLink {
		var externalLinkKey = KoroneikiAccountAPI._getAccountExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}");

		var curl = '''
