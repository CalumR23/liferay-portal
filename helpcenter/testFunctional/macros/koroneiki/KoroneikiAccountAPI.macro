				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.productConsumptions[?(@.key=='${productConsumptionKey}')].externalLinks");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].productConsumptions[?(@.key=='${productConsumptionKey}')].properties.${value1}");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.productConsumptions[?(@.key=='${productConsumptionKey}')].properties.${value1}");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "[", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "]", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "\"", "");
			}
			else if ("${field}" == "Product Purchase") {
				if ("${value1}" == "true") {
					var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].productConsumptions[?(@.key=='${productConsumptionKey}')].productPurchaseKey");

					var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

					var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

					var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
					var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.productConsumptions[?(@.key=='${productConsumptionKey}')].productPurchaseKey");

					var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "[", "");

					var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "]", "");

					var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "\"", "");
