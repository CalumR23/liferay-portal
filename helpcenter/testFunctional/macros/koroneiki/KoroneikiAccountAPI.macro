	@prose = "the worker contact with the email address ${contactEmailAddress} should not be visible via nested field on the account ${accountName}"
	macro _viewNoWorkerContactViaNestedField {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=workerContacts --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountFields = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountFields}", "contacts")) {
			var allAccountContacts = JSONCurlUtil.get("${curl}", "$.contacts");

			if (contains("${allAccountContacts}", "${contactEmailAddress}")) {
				fail("The account with the name ${accountName} contains the contact ${contactEmailAddress}");
			}
		}
		else {
			echo("No contacts present on ${accountName} and therefore there is no contacts nested field visible");
		}
	}

	@prose = "I should be able to view a product under the ${filterName} filter with the name ${productName} on the account ${accountName} with the following values ${table}"
	macro _viewProduct {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		if ("${filterName}" == "All") {
			var curl1 = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}
		else {
			var filterName = StringUtil.lowerCase("${filterName}");

			var curl1 = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey}\&filter="state%20eq%20'${filterName}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}

		var curl2 = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product/${productKey}/product-purchase-view --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "External Link Nested Field") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].product.externalLinks");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.product.externalLinks");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].product.name");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.product.name");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].product.properties.${value1}");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.product.properties.${value1}");
			}
			else {
				fail("No such product field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value from all products API call: ${valueFromAPI1}");

				echo("Actual property field ${value1} value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${value2}", "${valueFromAPI1}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI1} from the all products API does not match expected property field ${value1} value ${value2}");
				}

				if (!(contains("${value2}", "${valueFromAPI2}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI2} from the specific product API does not match expected property field ${value1} value ${value2}");
				}
			}
			else if (contains("${field}", "Nested Field")) {
				echo("Expected Partial ${field} Value: ${value1}");

				echo("Actual ${field} Value from all products API call: ${valueFromAPI1}");

				echo("Actual ${field} Value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${valueFromAPI1}", "${value1}"))) {
					fail("Actual ${field} value ${valueFromAPI1} from the all products API does not contain the expected value ${value1}");
				}

				if (!(contains("${valueFromAPI2}", "${value1}"))) {
					fail("Actual ${field} value ${valueFromAPI2} from the specific product API does not contain the expected value ${value1}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");

				echo("Actual ${field} Value from all products API call: ${valueFromAPI1}");

				echo("Actual ${field} Value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${value1}", "${valueFromAPI1}"))) {
					fail("Actual ${field} value ${valueFromAPI1} does not match expected ${field} value ${value1}");
				}

				if (!(contains("${value1}", "${valueFromAPI2}"))) {
					fail("Actual ${field} value ${valueFromAPI2} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

