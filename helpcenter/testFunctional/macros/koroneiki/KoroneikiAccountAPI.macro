				var allAccountExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allAccountExternalLinks}", "${entityId}")) {
					KoroneikiAccountAPI._deleteAccountExternalLink(
						accountName = "${accountName}",
						entityId = "${entityId}");

					echo("Entity ID of external link for ${accountName} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the external links for the account ${accountName} on koroneiki with the following entity id and domain values ${table}"
	macro _tearDownAccountExternalLinksViaIdAndDomain {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";
			var domain = "${row[1]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.replace("${accountName}", " ", "+");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
