	@prose = "I create an account on koroneiki with the following values ${table}"
	macro _createAccount {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Contact Nested Field") {
				var contactsNestedField = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Parent Account Name") {
				var parentAccountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${value}");
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Postal Address Nested Field") {
				var postalAddressesNestedField = "${value}";
			}
			else if ("${field}" == "Product Purchase Nested Field") {
				var productPurchasesNestedField = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Region") {
				var region = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(code))) {
			var code = "";
		}
		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}
		if (!(isSet(contactsNestedField))) {
			var contactsNestedField = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(externalLinksNestedField))) {
			var externalLinksNestedField = "";
		}
		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}
		if (!(isSet(internal))) {
			var internal = "false";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(parentAccountKey))) {
			var parentAccountKey = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(postalAddressesNestedField))) {
			var postalAddressesNestedField = "";
		}
		if (!(isSet(productPurchasesNestedField))) {
			var productPurchasesNestedField = "";
		}
		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}
		if (!(isSet(region))) {
			var region = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}
		if (!(isSet(tier))) {
			var tier = "";
		}
		if (!(isSet(website))) {
			var website = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"code": "${code}",
					"contactEmailAddress": "${contactEmailAddress}",
					"contacts": [${contactsNestedField}],
					"description": "${description}",
					"externalLinks": [${externalLinksNestedField}],
					"faxNumber": "${faxNumber}",
					"internal": ${internal},
					"name": "${name}",
					"parentAccountKey": "${parentAccountKey}",
					"phoneNumber": "${phoneNumber}",
					"postalAddresses": [${postalAddressesNestedField}],
					"productPurchases": [${productPurchasesNestedField}],
					"profileEmailAddress": "${profileEmailAddress}",
					"region": "${region}",
					"status": "${status}",
					"tier": "${tier}",
					"website": "${website}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"code": "${code}",
					"contactEmailAddress": "${contactEmailAddress}",
					"contacts": [${contactsNestedField}],
					"description": "${description}",
					"externalLinks": [${externalLinksNestedField}],
					"faxNumber": "${faxNumber}",
					"internal": ${internal},
					"name": "${name}",
					"parentAccountKey": "${parentAccountKey}",
					"phoneNumber": "${phoneNumber}",
					"postalAddresses": [${postalAddressesNestedField}],
					"productPurchases": [${productPurchasesNestedField}],
					"profileEmailAddress": "${profileEmailAddress}",
					"region": "${region}",
					"status": "${status}",
					"tier": "${tier}",
					"website": "${website}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an account entitlement definition related to the product purchase of the product ${productName} with the following values ${table}"
	macro _createAccountEntitlementDefinition {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else {
				fail("No such entitlment definition field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"definition": "SELECT DISTINCT(Koroneiki_Account.accountId) FROM Koroneiki_Account INNER JOIN Koroneiki_ProductPurchase ON Koroneiki_ProductPurchase.accountId = Koroneiki_Account.accountId INNER JOIN Koroneiki_ProductEntry ON Koroneiki_ProductEntry.productEntryId = Koroneiki_ProductPurchase.productEntryId WHERE ((Koroneiki_ProductPurchase.startDate IS NULL) OR ((Koroneiki_ProductPurchase.startDate <= '\'[\$NOW$]\'') AND (Koroneiki_ProductPurchase.endDate >= '\'[\$NOW$]\''))) AND (Koroneiki_ProductEntry.productEntryKey in ('\'${productKey}\''))",
					"description": "${description}",
					"name": "${name}",
					"status": "${status}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"definition": "SELECT DISTINCT(Koroneiki_Account.accountId) FROM Koroneiki_Account INNER JOIN Koroneiki_ProductPurchase ON Koroneiki_ProductPurchase.accountId = Koroneiki_Account.accountId INNER JOIN Koroneiki_ProductEntry ON Koroneiki_ProductEntry.productEntryId = Koroneiki_ProductPurchase.productEntryId WHERE ((Koroneiki_ProductPurchase.startDate IS NULL) OR ((Koroneiki_ProductPurchase.startDate <= '\'[\$NOW$]\'') AND (Koroneiki_ProductPurchase.endDate >= '\'[\$NOW$]\''))) AND (Koroneiki_ProductEntry.productEntryKey in ('\'${productKey}\''))",
					"description": "${description}",
					"name": "${name}",
					"status": "${status}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an external link for the account ${accountName} with the following values ${table}"
	macro _createAccountExternalLink {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"domain": "${domain}",
					"entityId": "${entityId}",
					"entityName": "${entityName}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"domain": "${domain}",
					"entityId": "${entityId}",
					"entityName": "${entityName}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a nested field for the account entitlement coming from the entitlement definition ${entitlementDefinitionName}"
	macro _createAccountEntitlementNestedField {
		var entitlementDefinitionKey = KoroneikiAccountAPI._getAccountEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

