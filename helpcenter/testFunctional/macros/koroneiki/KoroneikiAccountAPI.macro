	@prose = "I should not be able to view a product under the ${filterName} filter with the name ${productName} on the account ${accountName}"
	macro _viewNoProduct {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		if ("${filterName}" == "All") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}
		else {
			var filterName = StringUtil.lowerCase("${filterName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey}\&filter="state%20eq%20'${filterName}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			fail("The product with the name ${productName} is still present in on the koroneiki account based on the all products API");
		}
	}

	@prose = "I should not be able to view a product consumption made by ${accountName} for the product ${productName} via the account api"
	macro _viewNoProductConsumption {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var curl1 = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var curl2 = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product/${productKey}/product-purchase-view --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var specificProductPurchases1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].productConsumptions");

		if (contains("${specificProductPurchases1}", "${accountKey}")) {
			fail("The product with the name ${productName} has a consumption still present in on the koroneiki account based on the products API");
		}

		var specificProductPurchases2 = JSONCurlUtil.get("${curl2}");

		if (contains("${specificProductPurchases2}", "productConsumptions")) {
