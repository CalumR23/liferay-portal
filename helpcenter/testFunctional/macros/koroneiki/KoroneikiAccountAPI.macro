	macro _getAccountEntitlementDefinitionExternalLinkKey {
		if (contains("${entitlementDefinitionName}", " ")) {
			var keyword = StringUtil.replace("${entitlementDefinitionName}", " ", "+");
		}
		else {
			var keyword = "${entitlementDefinitionName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions?search=${keyword} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].externalLinks[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "\"", "");

		echo("External link key value for ${entityId} on account entitlement definition ${entitlementDefinitionName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getAccountEntitlementDefinitionKey {
		if (contains("${entitlementDefinitionName}", " ")) {
			var keyword = StringUtil.replace("${entitlementDefinitionName}", " ", "+");
		}
		else {
			var keyword = "${entitlementDefinitionName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions?search=${keyword} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var entitlementDefinitionKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].key");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "[", "");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "]", "");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "\"", "");

		echo("Entitlement Definition key value for ${entitlementDefinitionName}: ${entitlementDefinitionKey}");

		return "${entitlementDefinitionKey}";
	}

	macro _getAccountExternalLinkKey {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "\"", "");

		echo("External link key value for ${entityId} on account ${accountName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

