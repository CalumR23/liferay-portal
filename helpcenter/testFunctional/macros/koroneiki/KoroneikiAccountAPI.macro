	@prose = "I should be able to view an audit entry for the summary ${summary} related to the account ${accountName} field ${field} from the old value ${oldValue} to the new value ${newValue} regarding ${description} executed by ${agentName} via the audit entry key"
	macro _viewAccountAuditEntryRegardingAdditionalEntitiesViaAuditEntryKey {
		var auditEntryKey = KoroneikiAccountAPI._getAccountAuditEntryKeyRegardingAdditionalEntities(
			accountName = "${accountName}",
			description = "${description}",
			field = "${field}",
			newValue = "${newValue}",
			oldValue = "${oldValue}",
			summary = "${summary}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var summaryFromAPI = JSONCurlUtil.get("${curl}", "$.summary");

		echo("Expected Action Value: ${summary}");

