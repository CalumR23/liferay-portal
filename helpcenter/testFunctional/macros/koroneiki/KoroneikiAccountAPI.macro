		}
		if (!(isSet(contactEmailAddress))) {
			var value = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");

			var contactEmailAddress = "${value}";
		}
		if (!(isSet(description))) {
			var value = JSONCurlUtil.get("${curl}", "$.description");

			var description = "${value}";
		}
		if (!(isSet(faxNumber))) {
			var value = JSONCurlUtil.get("${curl}", "$.faxNumber");

			var faxNumber = "${value}";
		}
		if (!(isSet(industry))) {
			var value = JSONCurlUtil.get("${curl}", "$.industry");

			var industry = "${value}";
		}
		if (!(isSet(name))) {
			var value = JSONCurlUtil.get("${curl}", "$.name");

			var name = "${value}";
		}
		if (!(isSet(notes))) {
			var value = JSONCurlUtil.get("${curl}", "$.notes");

			var notes = "${value}";
		}
		if (!(isSet(phoneNumber))) {
			var value = JSONCurlUtil.get("${curl}", "$.phoneNumber");

			var phoneNumber = "${value}";
		}
		if (!(isSet(profileEmailAddress))) {
			var value = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");

			var profileEmailAddress = "${value}";
		}
		if (!(isSet(soldBy))) {
			var value = JSONCurlUtil.get("${curl}", "$.soldBy");

			var soldBy = "${value}";
		}
		if (!(isSet(status))) {
			var value = JSONCurlUtil.get("${curl}", "$.status");

			var status = "${value}";
		}
		if (!(isSet(tier))) {
			var value = JSONCurlUtil.get("${curl}", "$.tier");

			var tier = "${value}";
		}
		if (!(isSet(website))) {
			var value = JSONCurlUtil.get("${curl}", "$.website");

			var website = "${value}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"description": "${description}",
				"faxNumber": "${faxNumber}",
				"industry": "${industry}",
				"logoId": "0",
				"name": "${name}",
				"notes": "${notes}",
				"phoneNumber": "${phoneNumber}",
				"profileEmailAddress": "${profileEmailAddress}",
				"soldBy": "${soldBy}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should be able to view a koroneiki account with the name ${accountName} and the following values ${table}"
	macro _viewAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.code");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.faxNumber");
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.industry");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Notes") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.notes");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.phoneNumber");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");
			}
			else if ("${field}" == "Sold By") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.soldBy");
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.status");
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.tier");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.website");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view a child koroneiki account with the name ${childAccountName} on the parent account with the name ${parentAccountName} that has the following values ${table}"
	macro _viewChildAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${parentAccountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/child-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].code");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].contactEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].description");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].faxNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].industry");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Notes") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].notes");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].phoneNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].profileEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Sold By") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].soldBy");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].status");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].tier");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].website");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}
}