	@prose = "the entitlement from the entitlement definition ${entitlementDefinitionName} should not be visible via nested field on the account ${accountName}"
	macro _viewNoEntitlementViaNestedField {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=entitlements
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountFields = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountFields}", "entitlements")) {
			var allAccountEntitlements = JSONCurlUtil.get("${curl}", "$.entitlements");

			if (contains("${allAccountEntitlements}", "${entitlementDefinitionName}")) {
				fail("The account with the name ${accountName} contains the entitlement from entititlement definition name ${entitlementDefinitionName}");
			}
		}
		else {
			echo("No entitlements present on ${accountName} and therefore there is no entitlements nested field visible");
		}
	}

	@prose = "I should not be able to view a product under the ${filterName} filter with the name ${productName} on the account ${accountName}"
	macro _viewNoProduct {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		if ("${filterName}" == "All") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}
		else {
			var filterName = StringUtil.lowerCase("${filterName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchase-views?search=${accountKey}\&filter="state%20eq%20'${filterName}'"
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';
		}

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			fail("The product with the name ${productName} is still present in on the koroneiki account based on the all products API");
		}
	}

