	@prose = "the account entitlement definition with the name ${entitlementDefinitionName} should be present with the following values ${table}"
	macro _viewAccountEntitlementDefinition {
		if (contains("${entitlementDefinitionName}", " ")) {
			var keyword = StringUtil.replace("${entitlementDefinitionName}", " ", "+");
		}
		else {
			var keyword = "${entitlementDefinitionName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions?search=${keyword} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].description");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].status");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else {
				fail("No such entitlement definition field ${field}");
			}

			echo("Expected ${field} Value: ${value}");

			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

