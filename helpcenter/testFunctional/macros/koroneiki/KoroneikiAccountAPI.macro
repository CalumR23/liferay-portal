		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.field");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.oldValue");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.newValue");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}
	}

