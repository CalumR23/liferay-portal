			}
		}
	}

	@prose = "I should not be able to view a koroneiki account with the name ${accountName}"
	macro _viewNoAccount {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			fail("The account with the name ${accountName} is still present in Koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the account ${accountName}"
	macro _viewNoAccountExternalLink {
