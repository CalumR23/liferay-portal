			}
			else if ("${field}" == "Start Date") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].productPurchases[?(@.key=='${productPurchaseKey}')].startDate");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.productPurchases[?(@.key=='${productPurchaseKey}')].startDate");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "[", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "]", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "\"", "");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI1 = JSONCurlUtil.get("${curl1}", "$.items[?(@.product.key=='${productKey}')].productPurchases[?(@.key=='${productPurchaseKey}')].status");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "[", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "]", "");

				var valueFromAPI1 = StringUtil.replace("${valueFromAPI1}", "\"", "");
				var valueFromAPI2 = JSONCurlUtil.get("${curl2}", "$.productPurchases[?(@.key=='${productPurchaseKey}')].status");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "[", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "]", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "\"", "");
			}
			else {
				fail("No such product purchase field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value from all products API call: ${valueFromAPI1}");

				echo("Actual property field ${value1} value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${value2}", "${valueFromAPI1}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI1} from the all products API does not match expected property field ${value1} value ${value2}");
				}

				if (!(contains("${value2}", "${valueFromAPI2}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI2} from the specific product API does not match expected property field ${value1} value ${value2}");
				}
			}
			else if (contains("${field}", "Nested Field")) {
				echo("Expected Partial ${field} Value: ${value1}");

				echo("Actual ${field} Value from all products API call: ${valueFromAPI1}");

				echo("Actual ${field} Value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${valueFromAPI1}", "${value1}"))) {
					fail("Actual ${field} value ${valueFromAPI1} from the all products API does not contain the expected value ${value1}");
				}

				if (!(contains("${valueFromAPI2}", "${value1}"))) {
					fail("Actual ${field} value ${valueFromAPI2} from the specific product API does not contain the expected value ${value1}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");

				echo("Actual ${field} Value from all products API call: ${valueFromAPI1}");

				echo("Actual ${field} Value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${value1}", "${valueFromAPI1}"))) {
					fail("Actual ${field} value ${valueFromAPI1} does not match expected ${field} value ${value1}");
				}

				if (!(contains("${value1}", "${valueFromAPI2}"))) {
					fail("Actual ${field} value ${valueFromAPI2} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

	@prose = "the team with the name ${teamName} assigned the account ${accountName} should have the team role ${teamRoleName}"
	macro _viewTeamRole {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/assigned-teams/${teamKey}/roles --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamRoleNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamRoleName}')].name");

		var teamRoleNameFromAPI = StringUtil.replace("${teamRoleNameFromAPI}", "[", "");

		var teamRoleNameFromAPI = StringUtil.replace("${teamRoleNameFromAPI}", "]", "");

		var teamRoleNameFromAPI = StringUtil.replace("${teamRoleNameFromAPI}", "\"", "");

		echo("Expected team role name value: ${teamRoleName}");

		echo("Actual team role name value: ${teamRoleNameFromAPI}");

		if ("${teamRoleNameFromAPI}" != "${teamRoleName}") {
			fail("Actual team role name value ${teamRoleNameFromAPI} does not match expected team role name value ${teamRoleName}");
		}
	}

	@prose = "the worker contact with the email address ${contactEmailAddress} should be assigned the account ${accountName}"
	macro _viewWorkerContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/worker-contacts --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactEmailAddressFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.emailAddress=='${contactEmailAddress}')].emailAddress");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "[", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "]", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "\"", "");

		echo("Expected contact email address value: ${contactEmailAddress}");

		echo("Actual contact email address value: ${contactEmailAddressFromAPI}");

		if ("${contactEmailAddressFromAPI}" != "${contactEmailAddress}") {
			fail("Actual contact email address value ${contactEmailAddressFromAPI} does not match expected contact email address value ${contactEmailAddress}");
		}
	}

	@prose = "the worker contact with the email address ${contactEmailAddress} should be visible via nested field on the account ${accountName}"
	macro _viewWorkerContactViaNestedField {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=workerContacts --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactEmailAddressFromAPI = JSONCurlUtil.get("${curl}", "$.workerContacts[?(@.emailAddress=='${contactEmailAddress}')].emailAddress");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "[", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "]", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "\"", "");

		echo("Expected contact email address value: ${contactEmailAddress}");

		echo("Actual contact email address value: ${contactEmailAddressFromAPI}");

		if ("${contactEmailAddressFromAPI}" != "${contactEmailAddress}") {
			fail("Actual contact email address value ${contactEmailAddressFromAPI} does not match expected contact email address value ${contactEmailAddress}");
		}
	}

}