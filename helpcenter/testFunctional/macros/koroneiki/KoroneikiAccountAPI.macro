	@prose = "I should be able to view a koroneiki account with the name ${accountName} and the following values ${table}"
	macro _viewAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}?nestedFields=assignedTeams,contacts,customerContacts.contactRoles,entitlements,externalLinks,postalAddresses,productPurchases,workerContacts.contactRoles --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Account Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
