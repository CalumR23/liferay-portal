			var contactEmailAddress = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleNameAndType(
				contactRoleName = "Member",
				contactRoleType = "Account Customer");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${contactEmailAddress}/roles?contactRoleKeys=${contactRoleKey}
				--header "API_Token: ${apiToken}"
