	@prose = "I tear down the accounts on koroneiki with the following ${fieldName} values ${table}"
	macro _tearDownAccountsViaAccountFieldNameAndValue {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldValue = "${row[0]}";

			if (contains("${fieldValue}", " ")) {
				var keyword = StringUtil.extractFirst("${fieldValue}", " ");
			}
			else {
				var keyword = "${fieldValue}";
			}

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100 --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${fieldValue}")) {
				KoroneikiAccountAPI._deleteAccountViaAccountFieldNameAndValue(
					fieldName = "${fieldName}",
					fieldValue = "${fieldValue}");

				echo("${fieldName} value of account deleted: ${fieldValue}");
			}
		}
	}

	@prose = "I unset the following permissions for a koroneiki account with the name ${accountName} for a permissioned user ${table}"
	macro _unsetAccountPermissions {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Contact") {
				var value = StringUtil.lowerCase("${value}");

				var assignContact = "${value}";
			}
			else if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignContact))) {
			var assignContact = "false";
		}

		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignContact": "${assignContact}",
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I update a koroneiki account with the name ${accountName} to have the following values ${table}"
	macro _updateAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var properties = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Account Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "Code") {
				var code = "${value1}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value1}";
			}
			else if ("${field}" == "Data Region") {
				var dataRegion = "${value1}";
			}
			else if ("${field}" == "Description") {
				var description = "${value1}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value1}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value1}";
			}
			else if ("${field}" == "Language") {
				var language = "${value1}";
			}
			else if ("${field}" == "Name") {
				var name = "${value1}";
			}
			else if ("${field}" == "Parent Account Name") {
