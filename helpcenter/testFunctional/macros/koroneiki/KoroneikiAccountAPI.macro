				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "]", "");

				var valueFromAPI2 = StringUtil.replace("${valueFromAPI2}", "\"", "");
			}
			else {
				fail("No such product consumption field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value from all products API call: ${valueFromAPI1}");

				echo("Actual property field ${value1} value from specific product API call: ${valueFromAPI2}");

				if (!(contains("${value2}", "${valueFromAPI1}"))) {
