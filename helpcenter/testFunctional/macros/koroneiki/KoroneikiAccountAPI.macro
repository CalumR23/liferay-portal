		var allAccountExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the account with the name ${accountName}");
		}
	}

