definition {

	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "the account date modified value ${accountDateModifiedValue1} should be different from the ${accountDateModifiedValue2}"
	macro _assertDifferentAccountDateModifiedValuesFirst {
		echo("First Account Date Modified Value: ${accountDateModifiedValue1}");

		echo("Second Account Date Modified Value: ${accountDateModifiedValue2}");

		if ("${accountDateModifiedValue1}" == "${accountDateModifiedValue2}") {
			fail("The two account modified date values ${accountDateModifiedValue1} and ${accountDateModifiedValue2} are the same.");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the account ${accountName} to the following roles ${table}"
	macro _assignContactRolesToContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${contactEmailAddress}/roles?contactRoleKeys=${contactRoleKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the account ${accountName} to the following roles executed by ${agentName} ${table}"
	macro _assignContactRolesToContactExecutedByAgent {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var agentName = StringUtil.replace("${agentName}", " ", "%20");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${contactEmailAddress}/roles?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1\&contactRoleKeys=${contactRoleKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the account ${accountName} to the following roles via uuid ${table}"
	macro _assignContactRolesToContactViaUuid {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-uuid/${contactUuid}/roles?contactRoleKeys=${contactRoleKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign customer contacts with the following email addresses to the account ${accountName} ${table}"
	macro _assignCustomerContacts {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactEmailAddress = "${row[0]}";
			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleNameAndType(
				contactRoleName = "Member",
				contactRoleType = "Account Customer");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${contactEmailAddress}/roles?contactRoleKeys=${contactRoleKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

