	macro _getAccountProductPurchaseKeyViaAccountAndProductNameAndFieldValue {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if ("${fieldName}" == "perpetual") {
			var productPurchaseKey = JSONCurlUtil.get("${curl}", "$.items[?(@.productKey=='${productKey}' && @.${fieldName}==${fieldValue})].key");
		}
		else {
			var productPurchaseKey = JSONCurlUtil.get("${curl}", "$.items[?(@.productKey=='${productKey}' && @.${fieldName}=='${fieldValue}')].key");
		}

		var productPurchaseKey = StringUtil.replace("${productPurchaseKey}", "[", "");

		var productPurchaseKey = StringUtil.replace("${productPurchaseKey}", "]", "");

		var productPurchaseKey = StringUtil.replace("${productPurchaseKey}", "\"", "");

		echo("Product Purchase key value for ${productName} product made by ${accountName} with the ${fieldName} ${fieldValue}: ${productPurchaseKey}");

		return "${productPurchaseKey}";
	}

	@prose = "I remove the contact with the email address ${contactEmailAddress} on the account ${accountName} from the following roles ${table}"
	macro _removeContactRolesFromContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${contactEmailAddress}/roles?contactRoleKeys=${contactRoleKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

