						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"properties": {
							${properties}
						},
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

		if (("${productName}" == "Platinum Subscription") || ("${productName}" == "Gold Subscription") || ("${productName}" == "Limited Subscription") || ("${productName}" == "Premium Subscription")) {
			KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "${productName}");
		}
	}

	@prose = "I create a product purchase for an account with the name ${accountName} and a non existent product ${productName} on koroneiki with the following values ${table}"
	macro _createAccountProductPurchaseWithNonexistentProduct {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var properties = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value1}";
			}
			else if ("${field}" == "Original End Date") {
				var originalEndDate = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}

		if (!(isSet(externalLinksNestedField))) {
			var externalLinksNestedField = "";
		}

		if (!(isSet(originalEndDate))) {
			var originalEndDate = "";
		}

		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}

		if (!(isSet(quantity))) {
			var quantity = "1";
		}

		if (!(isSet(startDate))) {
			var startDate = "";
		}

		if (!(isSet(status))) {
			var status = "";
		}

		if ("${properties}" == "") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"externalLinks": [${externalLinksNestedField}],
					"originalEndDate": "${originalEndDate}",
					"perpetual": ${perpetual},
					"product": {
						"name": "${productName}"
					},
					"quantity": ${quantity},
					"startDate": "${startDate}",
					"status": "${status}"
				}
				''';
		}
		else {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"externalLinks": [${externalLinksNestedField}],
					"originalEndDate": "${originalEndDate}",
					"perpetual": ${perpetual},
					"product": {
						"name": "${productName}"
					},
					"properties": {
						${properties}
					},
					"quantity": ${quantity},
					"startDate": "${startDate}",
					"status": "${status}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

