			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].description");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].faxNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Industry") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].industry");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Internal") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].internal");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Notes") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].notes");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].phoneNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].profileEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Sold By") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].soldBy");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${childAccountName}')].status");

