	@prose = "I set the permissions for a koroneiki account with the name ${accountName} to have the following values for a non permissioned user ${table}"
	macro _setAccountPermissions {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Contact") {
				var value = StringUtil.lowerCase("${value}");

				var assignContact = "${value}";
			}
			else if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignContact))) {
			var assignContact = "false";
		}
		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignContact": "${assignContact}",
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I tear down the external links for the account ${accountName} on koroneiki with the following entity id values ${table}"
	macro _tearDownAccountExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allAccountExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allAccountExternalLinks}", "${entityId}")) {
					KoroneikiAccountAPI._deleteAccountExternalLink(
						accountName = "${accountName}",
						entityId = "${entityId}");

					echo("Entity ID of external link for ${accountName} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the permissions for a koroneiki account with the name ${accountName} set for a non permissioned user"
	macro _tearDownAccountPermissions {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"assignContact": "true",
					"assignTeam": "true",
					"delete": "true",
					"permissions": "true",
					"roleNames": [
						"${roleName}"
					],
					"update": "true",
					"view": "true"
				}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I tear down the accounts on koroneiki with the following names ${table}"
	macro _tearDownAccounts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var accountName = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				KoroneikiAccountAPI._deleteAccount(accountName = "${accountName}");

				echo("Name of account deleted: ${accountName}");
			}
		}
	}

	@prose = "I tear down the accounts on koroneiki with the following ${fieldName} values ${table}"
	macro _tearDownAccountsViaAccountFieldNameAndValue {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldValue = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${fieldValue}")) {
				KoroneikiAccountAPI._deleteAccountViaAccountFieldNameAndValue(
					fieldName = "${fieldName}",
					fieldValue = "${fieldValue}");

				echo("${fieldName} value of account deleted: ${fieldValue}");
			}
		}
	}

	@prose = "I update a koroneiki account with the name ${accountName} to have the following values ${table}"
	macro _updateAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var industry = "${value}";
			}
			else if ("${field}" == "Internal") {
				var internal = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Sold By") {
				var soldBy = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(code))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "code=")) {
				var value = JSONCurlUtil.get("${curl}", "$.code");

				var code = "${value}";
			}
			else {
				var code = "";
			}
		}
		if (!(isSet(contactEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "contactEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");

				var contactEmailAddress = "${value}";
			}
			else {
				var contactEmailAddress = "";
			}
		}
		if (!(isSet(description))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(faxNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "faxNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.faxNumber");

				var faxNumber = "${value}";
			}
			else {
				var faxNumber = "";
			}
		}
		if (!(isSet(industry))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "industry=")) {
				var value = JSONCurlUtil.get("${curl}", "$.industry");

				var industry = "${value}";
			}
			else {
				var industry = "";
			}
		}
		if (!(isSet(internal))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "internal=")) {
				var value = JSONCurlUtil.get("${curl}", "$.internal");

				var internal = "${value}";
			}
			else {
				var internal = "false";
			}
		}
		if (!(isSet(name))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(notes))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "notes=")) {
				var value = JSONCurlUtil.get("${curl}", "$.notes");

				var notes = "${value}";
