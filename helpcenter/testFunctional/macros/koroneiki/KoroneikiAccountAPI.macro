						"productKey": "${productKey}",
						"productPurchaseKey": "${productPurchaseKey}",
						"startDate": "${startDate}"
					}
					''';
			}
			else {
				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
					--header "API_Token: ${apiToken}"
