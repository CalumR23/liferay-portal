definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I create a team role on koroneiki with the following values ${table}"
	macro _createTeamRole {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Type") {
				var type = "${value}";
			}
			else {
				fail("No such team role field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(type))) {
			var type = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"description": "${description}",
					"name": "${name}",
					"type": "${type}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"description": "${description}",
					"name": "${name}",
					"type": "${type}"
				}
				''';
		}



		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a team role on koroneiki with the name ${teamRoleName}"
	macro _deleteTeamRole {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getTeamRoleAuditEntryKey {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!("${oldValue}" == "")) {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");
		}
		else {
			var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].key");
		}

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "&quot;", "");

		echo("Audit entry key value: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getTeamRoleKeyViaTeamRoleName {
		if (contains("${teamRoleName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamRoleName}", " ");
		}
		else {
			var keyword = "${teamRoleName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamRoleKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamRoleName}')].key");

		var teamRoleKey = StringUtil.replace("${teamRoleKey}", "[", "");

		var teamRoleKey = StringUtil.replace("${teamRoleKey}", "]", "");

		var teamRoleKey = StringUtil.replace("${teamRoleKey}", "&quot;", "");

		echo("Key value for ${teamRoleName}: ${teamRoleKey}");

		return "${teamRoleKey}";
	}

	@prose = "I set the permissions for the team role ${teamRoleName} to have the following values for a non permissioned user ${table}"
	macro _setTeamRolePermissions {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/team-role-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I tear down the permissions for a koroneiki team role with the name ${teamRoleName} set for a non permissioned user"
	macro _tearDownTeamRolePermissions {
		if (contains("${teamRoleName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamRoleName}", " ");
		}
		else {
			var keyword = "${teamRoleName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamRoles}", "${teamRoleName}")) {
			var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/team-role-permissions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"assignTeam": "true",
					"delete": "true",
					"permissions": "true",
					"roleNames": [
						"${roleName}"
					],
					"update": "true",
					"view": "true"
				}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I tear down the team roles on koroneiki with the following names ${table}"
	macro _tearDownTeamRoles {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var teamRoleName = "${row[0]}";

			if (contains("${teamRoleName}", " ")) {
				var keyword = StringUtil.extractFirst("${teamRoleName}", " ");
			}
			else {
				var keyword = "${teamRoleName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allTeamRoles = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allTeamRoles}", "${teamRoleName}")) {
				KoroneikiTeamRoleAPI._deleteTeamRole(teamRoleName = "${teamRoleName}");

				echo("Name of team role deleted: ${teamRoleName}");
			}
		}
	}

	@prose = "I unset the following permissions for the team role ${teamRoleName} for a permissioned user ${table}"
	macro _unsetTeamRolePermissions {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/team-role-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I update a koroneiki team role with the name ${teamRoleName} to have the following values ${table}"
	macro _updateTeamRole {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Type") {
				var type = "${value}";
			}
			else {
				fail("No such team role field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(description))) {
			var teamRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${teamRoleObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(name))) {
			var teamRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${teamRoleObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(type))) {
			var teamRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${teamRoleObject}", "type=")) {
				var value = JSONCurlUtil.get("${curl}", "$.type");

				var type = "${value}";
			}
			else {
				var type = "";
			}
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"description": "${description}",
					"name": "${name}",
					"type": "${type}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"description": "${description}",
					"name": "${name}",
					"type": "${type}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should be able to view a koroneiki team role with the name ${teamRoleName} and the following values ${table}"
	macro _viewTeamRole {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Type") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.type");
			}
			else {
				fail("No such team role field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the team role ${teamRoleName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName}"
	macro _viewTeamRoleAuditEntry {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].action");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "[", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "]", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "&quot;", "");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].field");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "[", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "]", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "&quot;", "");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].oldValue");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "[", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "]", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "&quot;", "");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].newValue");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "[", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "]", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "&quot;", "");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].agentName");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "[", "");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "]", "");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "&quot;", "");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')]");

		if (contains("${auditEntry}", "agentUID")) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].agentUID");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "[", "");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "]", "");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "&quot;", "");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the team role ${teamRoleName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName} via the audit entry key"
	macro _viewTeamRoleAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiTeamRoleAPI._getTeamRoleAuditEntryKey(
			action = "${action}",
			teamRoleName = "${teamRoleName}",
			field = "${field}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var actionFromAPI = JSONCurlUtil.get("${curl}", "$.action");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.field");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.oldValue");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.newValue");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.agentName");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}");

		if (contains("${auditEntry}", "agentUID")) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.agentUID");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "I should not be able to view a koroneiki team role with the name ${teamRoleName}"
	macro _viewNoTeamRole {
		if (contains("${teamRoleName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamRoleName}", " ");
		}
		else {
			var keyword = "${teamRoleName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamRoles}", "${teamRoleName}")) {
			fail("The team role with the name ${teamRoleName} is still present in Koroneiki");
		}
	}
}