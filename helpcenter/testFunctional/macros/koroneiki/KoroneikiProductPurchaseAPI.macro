	@prose = "I generate static infinite end dates"
	macro generateStaticInfiniteEndDates {
		var infiniteEndDay = DateUtil.getDate("36865");

		if ("${infiniteEndDay}" == "1") {
			var infiniteEndDay = "01";
		}
		else if ("${infiniteEndDay}" == "2") {
			var infiniteEndDay = "02";
		}
		else if ("${infiniteEndDay}" == "3") {
			var infiniteEndDay = "03";
		}
		else if ("${infiniteEndDay}" == "4") {
			var infiniteEndDay = "04";
		}
