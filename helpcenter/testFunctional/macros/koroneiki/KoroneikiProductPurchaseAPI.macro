	@prose = "I set the permissions for the product purchase made by the account ${accountName} for the product ${productName} to have the following values for a non permissioned user ${table}"
	macro _setProductPurchasePermissions {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/product-purchase-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I tear down the external links for the product purchase made by account ${accountName} for the product ${productName} with the following entity id values ${table}"
	macro _tearDownProductPurchaseExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.extractFirst("${accountName}", " ");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allAccountProductPurchases}", "${productName}")) {
					var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
						accountName = "${accountName}",
						productName = "${productName}");

					var curl = '''
						--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductPurchaseExternalLinks = JSONCurlUtil.get("${curl}", "$");
					
					if (contains("${allAccountProductPurchaseExternalLinks}", "${entityId}")) {
						KoroneikiProductPurchaseAPI._deleteProductPurchaseExternalLink(
							accountName = "${accountName}",
							entityId = "${entityId}",
							productName = "${productName}");

						echo("Entity ID of external link deleted for product purchase made by ${accountName} for ${productName}: ${entityId}");
					}
				}
			}
		}
	}

	@prose = "I tear down the permissions for the product purchase made by the account ${accountName} for the product ${productName} for a non permissioned user"
	macro _tearDownProductPurchasePermissions {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.extractFirst("${accountName}", " ");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccountProductPurchases}", "${productName}")) {
				var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
					accountName = "${accountName}",
					productName = "${productName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/product-purchase-permissions
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"delete": "true",
						"permissions": "true",
						"roleNames": [
							"${roleName}"
						],
						"update": "true",
						"view": "true"
					}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
			}
		}
	}

	@prose = "I tear down the product purchases on koroneiki made by the account ${accountName} for the following products ${table}"
	macro _tearDownProductPurchases {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.extractFirst("${accountName}", " ");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var productName = "${row[0]}";

				if (contains("${productName}", " ")) {
					var keyword = StringUtil.extractFirst("${productName}", " ");
				}
				else {
					var keyword = "${productName}";
				}

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProducts = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProducts}", "${productName}")) {
					var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

					var curl = '''
						--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

					if (contains("${allAccountProductPurchases}", "${productKey}")) {
						KoroneikiProductPurchaseAPI._deleteProductPurchase(
							accountName = "${accountName}",
							productName = "${productName}");

						echo("Product Purchase deleted: ${productName} made by ${accountName}");
					}
				}
			}
		}
	}

	@prose = "I tear down the product purchases on koroneiki made by the account ${accountName} for the following products with their respective field values ${table}"
	macro _tearDownProductPurchasesWithFieldValues {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.extractFirst("${accountName}", " ");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var productName = "${row[0]}";
				var fieldName = "${row[1]}";
				var fieldValue = "${row[2]}";

				if (contains("${productName}", " ")) {
					var keyword = StringUtil.extractFirst("${productName}", " ");
				}
				else {
					var keyword = "${productName}";
				}

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProducts = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProducts}", "${productName}")) {
					var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

					var curl = '''
						--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

					if ((contains("${allAccountProductPurchases}", "${productKey}")) && (contains("${allAccountProductPurchases}", "${fieldValue}"))) {
						KoroneikiProductPurchaseAPI._deleteProductPurchaseWithFieldValue(
							accountName = "${accountName}",
							fieldName = "${fieldName}",
							fieldValue = "${fieldValue}",							
							productName = "${productName}");

						echo("Product Purchase deleted: ${productName} made by ${accountName}");
					}
				}
			}
		}
	}

	@prose = "I unset the following permissions for the product purchase made by the account ${accountName} for the product ${productName} for a permissioned user ${table}"
	macro _unsetProductPurchasePermissions {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/product-purchase-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I update a product purchase on koroneiki made by the account ${accountName} for the product ${productName} to have the following values ${table}"
	macro _updateProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "Original End Date") {
				var originalEndDate = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Name") {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${value1}");
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(endDate))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "endDate=")) {
				var value = JSONCurlUtil.get("${curl}", "$.endDate");

				var endDate = "${value}";
			}
			else {
				var endDate = "";
			}
		}
		if (!(isSet(originalEndDate))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "originalEndDate=")) {
				var value = JSONCurlUtil.get("${curl}", "$.originalEndDate");

				var originalEndDate = "${value}";
			}
			else {
				var originalEndDate = "";
			}
		}
		if (!(isSet(perpetual))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "perpetual=")) {
				var value = JSONCurlUtil.get("${curl}", "$.perpetual");

				var perpetual = "${value}";
			}
			else {
				var perpetual = "true";
			}
		}
		if (!(isSet(productKey))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "productKey=")) {
				var value = JSONCurlUtil.get("${curl}", "$.productKey");

				var productKey = "${value}";
			}
			else {
				var productKey = "";
			}
		}
		if (!(isSet(properties))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "properties=")) {
				var value = JSONCurlUtil.get("${curl}", "$.properties");

				var properties = "${value}";
			}
			else {
				var properties = "";
			}
		}
		if (!(isSet(quantity))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "quantity=")) {
				var value = JSONCurlUtil.get("${curl}", "$.quantity");

				var quantity = "${value}";
			}
			else {
				var quantity = "1";
			}
		}
		if (!(isSet(startDate))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "startDate=")) {
				var value = JSONCurlUtil.get("${curl}", "$.startDate");

				var startDate = "${value}";
			}
			else {
				var startDate = "";
			}
		}
		if (!(isSet(status))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "status=")) {
				var value = JSONCurlUtil.get("${curl}", "$.status");

				var status = "${value}";
			}
			else {
				var status = "";
			}
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"endDate": "${endDate}",
						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"endDate": "${endDate}",
						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
					''';
			}
		}
		else {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"endDate": "${endDate}",
						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"properties": {
							${properties}
						},
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"endDate": "${endDate}",
						"originalEndDate": "${originalEndDate}",
						"perpetual": ${perpetual},
						"productKey": "${productKey}",
						"properties": {
							${properties}
						},
						"quantity": ${quantity},
						"startDate": "${startDate}",
						"status": "${status}"
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _viewNoProductPurchase {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountProductPurchases}", "${productKey}")) {
			fail("The product purchase made by ${accountName} for the product ${productName} is still present on koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the product purchase made by account ${accountName} for the product ${productName}"
