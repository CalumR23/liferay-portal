definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I create an external link for a product purchase made by account ${accountName} for the product ${productName} with the following values"
	macro _createProductPurchaseExternalLink {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _deleteProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on a product purchase made by account ${accountName} for the product ${productName}"
	macro _deleteProductPurchaseExternalLinkKey {
		var externalLinkKey = KoroneikiProductPurchaseAPI._getProductPurchaseExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I generate static start and end dates"
	macro generateStaticStartAndEndDate {
		var startDay = DateUtil.getDate("0");

		if ("${startDay}" == "1") {
			var startDay = "01";
		}
		else if ("${startDay}" == "2") {
			var startDay = "02";
		}
		else if ("${startDay}" == "3") {
			var startDay = "03";
		}
		else if ("${startDay}" == "4") {
			var startDay = "04";
		}
		else if ("${startDay}" == "5") {
			var startDay = "05";
		}
		else if ("${startDay}" == "6") {
			var startDay = "06";
		}
		else if ("${startDay}" == "7") {
			var startDay = "07";
		}
		else if ("${startDay}" == "8") {
			var startDay = "08";
		}
		else if ("${startDay}" == "9") {
			var startDay = "09";
		}
		else {
			var startDay = "${startDay}";
		}

		var startMonth = DateUtil.getMonth("0");

		if ("${startMonth}" == "1") {
			var startMonth = "01";
		}
		else if ("${startMonth}" == "2") {
			var startMonth = "02";
		}
		else if ("${startMonth}" == "3") {
			var startMonth = "03";
		}
		else if ("${startMonth}" == "4") {
			var startMonth = "04";
		}
		else if ("${startMonth}" == "5") {
			var startMonth = "05";
		}
		else if ("${startMonth}" == "6") {
			var startMonth = "06";
		}
		else if ("${startMonth}" == "7") {
			var startMonth = "07";
		}
		else if ("${startMonth}" == "8") {
			var startMonth = "08";
		}
		else if ("${startMonth}" == "9") {
			var startMonth = "09";
		}
		else {
			var startMonth = "${startMonth}";
		}

		var startYear = DateUtil.getYear("0");

		var endDay = DateUtil.getDate("335");

		if ("${endDay}" == "1") {
			var endDay = "01";
		}
		else if ("${endDay}" == "2") {
			var endDay = "02";
		}
		else if ("${endDay}" == "3") {
			var endDay = "03";
		}
		else if ("${endDay}" == "4") {
			var endDay = "04";
		}
		else if ("${endDay}" == "5") {
			var endDay = "05";
		}
		else if ("${endDay}" == "6") {
			var endDay = "06";
		}
		else if ("${endDay}" == "7") {
			var endDay = "07";
		}
		else if ("${endDay}" == "8") {
			var endDay = "08";
		}
		else if ("${endDay}" == "9") {
			var endDay = "09";
		}
		else {
			var endDay = "${endDay}";
		}

		var endMonth = DateUtil.getMonth("335");

		if ("${endMonth}" == "1") {
			var endMonth = "01";
		}
		else if ("${endMonth}" == "2") {
			var endMonth = "02";
		}
		else if ("${endMonth}" == "3") {
			var endMonth = "03";
		}
		else if ("${endMonth}" == "4") {
			var endMonth = "04";
		}
		else if ("${endMonth}" == "5") {
			var endMonth = "05";
		}
		else if ("${endMonth}" == "6") {
			var endMonth = "06";
		}
		else if ("${endMonth}" == "7") {
			var endMonth = "07";
		}
		else if ("${endMonth}" == "8") {
			var endMonth = "08";
		}
		else if ("${endMonth}" == "9") {
			var endMonth = "09";
		}
		else {
			var endMonth = "${endMonth}";
		}

		var endYear = DateUtil.getYear("335");

		static var staticStartDate = "${startYear}-${startMonth}-${startDay}T00:00:00.000Z";
		static var staticEndDate = "${endYear}-${endMonth}-${endDay}T00:00:00.000Z";

		return "${staticStartDate}";
		return "${staticEndDate}";

		echo("${staticStartDate}");
		echo("${staticEndDate}");
	}

	macro _getProductPurchaseExternalLinkKey {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} on product purchase on ${accountName} for ${productName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	@prose = "I tear down the product purchases on koroneiki made by the account ${accountName} for the following products ${table}"
	macro _tearDownProductPurchases {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var productName = "${row[0]}";

				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProductPurchases = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProductPurchases}", "${accountKey}")) {
					var curl = '''
						--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';
					
					var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

					if (contains("${allAccountProductPurchases}", "${productKey}")) {
						KoroneikiProductPurchaseAPI._deleteProductPurchase(
							accountName = "${accountName}",
							productName = "${productName}");

						echo("Product Purchase deleted: ${productName} made by ${accountName}");
					}
				}
			}
		}
	}

	@prose = "I update a product purchase on koroneiki made by the account ${accountName} for the product ${productName} to have the following values ${table}"
	macro _updateProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "End Date") {
				var endDate = "${value}";
			}
			else if ("${field}" == "Perpetual") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var perpetual = "${value}";
			}
			else if ("${field}" == "Product Name") {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${value}");
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(endDate))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "endDate=")) {
				var value = JSONCurlUtil.get("${curl}", "$.endDate");

				var endDate = "${value}";
			}
			else {
				var endDate = "";
			}
		}
		if (!(isSet(perpetual))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "perpetual=")) {
				var value = JSONCurlUtil.get("${curl}", "$.perpetual");

				var perpetual = "${value}";
			}
			else {
				var perpetual = "true";
			}
		}
		if (!(isSet(productKey))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "productKey=")) {
				var value = JSONCurlUtil.get("${curl}", "$.productKey");

				var productKey = "${value}";
			}
			else {
				var productKey = "";
			}
		}
		if (!(isSet(properties))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "properties=")) {
				var value = JSONCurlUtil.get("${curl}", "$.properties");

				var properties = "${value}";
			}
			else {
				var properties = "";
			}
		}
		if (!(isSet(quantity))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "quantity=")) {
				var value = JSONCurlUtil.get("${curl}", "$.quantity");

				var quantity = "${value}";
			}
			else {
				var quantity = "1";
			}
		}
		if (!(isSet(startDate))) {
			var productPurchaseObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productPurchaseObject}", "startDate=")) {
				var value = JSONCurlUtil.get("${curl}", "$.startDate");

				var startDate = "${value}";
			}
			else {
				var startDate = "";
			}
		}

		if ("${properties}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"quantity": ${quantity},
					"startDate": "${startDate}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"properties": {
						${properties}
					},
					"quantity": ${quantity},
					"startDate": "${startDate}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _viewNoProductPurchase {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountProductPurchases = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountProductPurchases}", "${productKey}")) {
			fail("The product purchase made by ${accountName} for the product ${productName} is still present on koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the product purchase made by account ${accountName} for the product ${productName}"
	macro _viewNoProductPurchaseExternalLink {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductPurchaseExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductPurchaseExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the product purchase made by the account ${accountName} for the product ${productName}");
		}
	}

	@prose = "I should be able to view a product purchase on koroneiki made by the account ${accountName} for the product ${productName} with the following values ${table}"
	macro _viewProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.endDate");
			}
			else if ("${field}" == "Perpetual") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.perpetual");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else if ("${field}" == "Quantity") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.quantity");
			}
			else if ("${field}" == "Start Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.startDate");
			}
			else {
				fail("No such product purchase field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");
				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");
				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product purchase made by account ${accountName} for the product ${productName} with the following values"
	macro _viewProductPurchaseExternalLink {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		echo("Expected ${field} Value: ${value}");
		echo("Actual ${field} Value: ${valueFromAPI}");

		if (!(contains("${value}", "${valueFromAPI}"))) {
			fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
		}
	}
}