			var endMonth = "09";
		}
		else {
			var endMonth = "${endMonth}";
		}

		var endYear = DateUtil.getYear("425");

		static var staticYyyyMmDdFutureStartDate = "${startYear}-${startMonth}-${startDay}";
		static var staticYyyyMmDdFutureOriginalEndDate = "${originalEndYear}-${originalEndMonth}-${originalEndDay}";
		static var staticYyyyMmDdFutureEndDate = "${endYear}-${endMonth}-${endDay}";

		return "${staticYyyyMmDdFutureStartDate}";
		return "${staticYyyyMmDdFutureOriginalEndDate}";
		return "${staticYyyyMmDdFutureEndDate}";

