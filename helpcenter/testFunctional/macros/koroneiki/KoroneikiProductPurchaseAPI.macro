definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I create an external link for a product purchase made by account ${accountName} for the product ${productName} with the following values ${table}"
	macro _createProductPurchaseExternalLink {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a nested field for the product purchase external link with the following values ${table}"
	macro _createProductPurchaseExternalLinkNestedField {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else if ("${field}" == "URL") {
				var url = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}
		if (!(isSet(url))) {
			var url = "";
		}

		static var staticProductPurchaseExternalLinksNestedField = "{&quot;domain&quot;:&quot;${domain}&quot;,&quot;entityId&quot;:&quot;${entityId}&quot;,&quot;entityName&quot;:&quot;${entityName}&quot;,&quot;url&quot;:&quot;${url}&quot;}";

		return "${staticProductPurchaseExternalLinksNestedField}";
	}

	@prose = "I create a nested field for the product purchase for the product ${productName} with the following values ${table}"
	macro _createProductPurchaseNestedField {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "Original End Date") {
				var originalEndDate = "${value1}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}
		if (!(isSet(externalLinksNestedField))) {
			var externalLinksNestedField = "";
		}
		if (!(isSet(originalEndDate))) {
			var originalEndDate = "";
		}
		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}
		if (!(isSet(quantity))) {
			var quantity = "1";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}

		if ("${properties}" == "") {
			static var staticProductPurchasesNestedField = "{&quot;endDate&quot;:&quot;${endDate}&quot;,&quot;externalLinks&quot;:[${externalLinksNestedField}],&quot;originalEndDate&quot;:&quot;${originalEndDate}&quot;,&quot;perpetual&quot;:${perpetual},&quot;productKey&quot;:&quot;${productKey}&quot;,&quot;quantity&quot;:${quantity},&quot;startDate&quot;:&quot;${startDate}&quot;,&quot;status&quot;:&quot;${status}&quot;}";
		}
		else {
			static var staticProductPurchasesNestedField = "{&quot;endDate&quot;:&quot;${endDate}&quot;,&quot;externalLinks&quot;:[${externalLinksNestedField}],&quot;originalEndDate&quot;:&quot;${originalEndDate}&quot;,&quot;perpetual&quot;:${perpetual},&quot;productKey&quot;:&quot;${productKey}&quot;,&quot;properties&quot;:{${properties}},&quot;quantity&quot;:${quantity},&quot;startDate&quot;:&quot;${startDate}&quot;,&quot;status&quot;:&quot;${status}&quot;}";
		}

		return "${staticProductPurchasesNestedField}";
	}

	@prose = "I create a nested field for the product purchase for a non existent product ${productName} and the following values ${table}"
	macro _createProductPurchaseNestedFieldWithNonexistentProduct {
		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "Original End Date") {
				var originalEndDate = "${value1}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksNestedField = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}
		if (!(isSet(externalLinksNestedField))) {
			var externalLinksNestedField = "";
		}
		if (!(isSet(originalEndDate))) {
			var originalEndDate = "";
		}
		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}
		if (!(isSet(quantity))) {
			var quantity = "1";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}

		if ("${properties}" == "") {
			static var staticProductPurchasesNestedField = "{&quot;endDate&quot;:&quot;${endDate}&quot;,&quot;externalLinks&quot;:[${externalLinksNestedField}],&quot;originalEndDate&quot;:&quot;${originalEndDate}&quot;,&quot;perpetual&quot;:${perpetual},&quot;product&quot;:{&quot;name&quot;:&quot;${productName}&quot;},&quot;quantity&quot;:${quantity},&quot;startDate&quot;:&quot;${startDate}&quot;,&quot;status&quot;:&quot;${status}&quot;}";
		}
		else {
			static var staticProductPurchasesNestedField = "{&quot;endDate&quot;:&quot;${endDate}&quot;,&quot;externalLinks&quot;:[${externalLinksNestedField}],&quot;originalEndDate&quot;:&quot;${originalEndDate}&quot;,&quot;perpetual&quot;:${perpetual},&quot;product&quot;:{&quot;name&quot;:&quot;${productName}&quot;},&quot;properties&quot;:{${properties}},&quot;quantity&quot;:${quantity},&quot;startDate&quot;:&quot;${startDate}&quot;,&quot;status&quot;:&quot;${status}&quot;}";
		}

		return "${staticProductPurchasesNestedField}";
	}

	@prose = "I delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _deleteProductPurchase {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName} executed by ${agentName}"
	macro _deleteProductPurchaseExecutedByAgent {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on a product purchase made by account ${accountName} for the product ${productName}"
	macro _deleteProductPurchaseExternalLink {
		var externalLinkKey = KoroneikiProductPurchaseAPI._getProductPurchaseExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a product purchase on koroneiki made by the account ${accountName} for the product ${productName} with the ${fieldName} ${fieldValue}"
	macro _deleteProductPurchaseWithFieldValue {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductNameAndFieldValue(
			accountName = "${accountName}",
			fieldName = "${fieldName}",
			fieldValue = "${fieldValue}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product-purchases/${productPurchaseKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I generate the product purchase ID value for the product purchase made by ${accountName} for ${productName}"
	macro _generateProductPurchaseId {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var productPurchaseId = StringUtil.replace("${productPurchaseKey}", "KOR-", "");

		static var staticProductPurchaseId = "${productPurchaseId}";

		return "${staticProductPurchaseId}";
	}

	@prose = "I generate the product purchase ID value for the product purchase made by ${accountName} for ${productName} with the ${fieldName} ${fieldValue}"
	macro _generateProductPurchaseIdWithFieldValue {
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductNameAndFieldValue(
			accountName = "${accountName}",
			fieldName = "${fieldName}",
			fieldValue = "${fieldValue}",
			productName = "${productName}");

		var productPurchaseId = StringUtil.replace("${productPurchaseKey}", "KOR-", "");

		static var staticProductPurchaseId = "${productPurchaseId}";

		return "${staticProductPurchaseId}";
	}

	@prose = "I generate static end dates"
	macro generateStaticEndDates {
		var endDay = DateUtil.getDate("365");

