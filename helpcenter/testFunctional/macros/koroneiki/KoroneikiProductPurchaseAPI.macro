		}
		else {
			var endDay = "${endDay}";
		}

		var endMonth = DateUtil.getMonth("366");

		if ("${endMonth}" == "1") {
			var endMonth = "01";
		}
		else if ("${endMonth}" == "2") {
			var endMonth = "02";
