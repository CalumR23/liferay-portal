	@prose = "I should not be able to view a koroneiki team role with the name ${teamRoleName} as a non permissioned user"
	macro _viewNoTeamRole {
		if (contains("${teamRoleName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamRoleName}", " ");
		}
		else {
			var keyword = "${teamRoleName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles?search=${keyword}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamRoles}", "${teamRoleName}")) {
			fail("The team role with the name ${teamRoleName} is visible for a non permissioned user");
		}

		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamRole = JSONCurlUtil.get("${curl}", "$");

		if (contains("${teamRole}", "${teamRoleName}")) {
			fail("The team role with the name ${teamRoleName} is visible for a non permissioned user");
		}
	}

	@prose = "I should not be able to view an audit entry for a change to the team role ${teamRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} as a non permissioned user"
	macro _viewNoTeamRoleAuditEntry {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamRoleAuditEntries = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${teamRoleAuditEntries}", "${fieldName}")) || (contains("${teamRoleAuditEntries}", "${oldValue}")) || (contains("${teamRoleAuditEntries}", "${newValue}"))) {
			fail("The team role audit entry for a change to the team role ${teamRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}

		var auditEntryKey = KoroneikiTeamRoleAPI._getTeamRoleAuditEntryKey(
			teamRoleName = "${teamRoleName}",
			fieldName = "${fieldName}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamRoleAuditEntry = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${teamRoleAuditEntry}", "${fieldName}")) || (contains("${teamRoleAuditEntry}", "${oldValue}")) || (contains("${teamRoleAuditEntry}", "${newValue}"))) {
			fail("The team role audit entry for a change to the team role ${teamRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}
	}

	@prose = "I should be able to view a koroneiki team role with the name ${teamRoleName} and the following values as a permissioned user ${table}"
	macro _viewTeamRole {
		var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/team-roles/${teamRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Type") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.type");
			}
			else {
				fail("No such team role field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}
}