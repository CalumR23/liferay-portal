	@prose = "I attempt to create a product purchase for an account with the name ${accountName} and the product ${productName} on koroneiki with the following values as a non permissioned user ${table}"
	macro _createAccountProductPurchaseAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var endDate = "${value1}";
			}
			else if ("${field}" == "Original End Date") {
				var originalEndDate = "${value1}";
			}
			else if ("${field}" == "Perpetual") {
				var value1 = StringUtil.lowerCase("${value1}");

				var value1 = StringUtil.replace("${value1}", " ", "-");

				var perpetual = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;: &quot;${value2}&quot;";
				}
			}
			else if ("${field}" == "Quantity") {
				var quantity = "${value1}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value1}";
			}
			else if ("${field}" == "Status") {
				var status = "${value1}";
			}
			else {
				fail("No such product purchase field ${field}");
			}
		}

		if (!(isSet(endDate))) {
			var endDate = "";
		}
		if (!(isSet(originalEndDate))) {
			var originalEndDate = "";
		}
		if (!(isSet(perpetual))) {
			var perpetual = "true";
		}
		if (!(isSet(quantity))) {
			var quantity = "1";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}

		if ("${properties}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"endDate": "${endDate}",
					"originalEndDate": "${originalEndDate}",
					"perpetual": ${perpetual},
					"productKey": "${productKey}",
					"quantity": ${quantity},
					"startDate": "${startDate}",
					"status": "${status}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-purchases
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
