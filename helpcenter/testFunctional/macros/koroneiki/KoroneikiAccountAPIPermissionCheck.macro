	@prose = "the contact with the email address ${contactEmailAddress} should not be visible on the account ${accountName} for a non permissioned user"
	macro _viewNoContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountContacts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountContacts}", "${contactEmailAddress}")) {
			fail("The account with the name ${accountName} contact ${contactEmailAddress} is visible to a non permissioned user");
		}
	}

