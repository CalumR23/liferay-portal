	@prose = "I attempt to set the permissions for a koroneiki account with the name ${accountName} to have the following values for a non permissioned user as a non permissioned user ${table}"
	macro _setAccountPermissionsAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Assign Contact") {
				var value = StringUtil.lowerCase("${value}");

				var assignContact = "${value}";
			}
			else if ("${field}" == "Assign Team") {
				var value = StringUtil.lowerCase("${value}");

				var assignTeam = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(assignContact))) {
			var assignContact = "false";
		}
		if (!(isSet(assignTeam))) {
			var assignTeam = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/account-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"assignContact": "${assignContact}",
				"assignTeam": "${assignTeam}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

