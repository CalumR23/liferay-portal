	@prose = "I should be able to view a koroneiki account with the name ${accountName} and the following values as a permissioned user ${table}"
	macro _viewAccount {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.code");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.description");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.faxNumber");
			}
			else if ("${field}" == "Internal") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.internal");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.phoneNumber");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");
			}
			else if ("${field}" == "Region") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.region");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.status");
			}
			else if ("${field}" == "Tier") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.tier");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.website");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the team with the name ${teamName} part of the account ${accountName} should be visible to a permissioned user"
	macro _viewAccountTeam {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/teams
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${teamName}')].name");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "[", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "]", "");

		var teamNameFromAPI = StringUtil.replace("${teamNameFromAPI}", "&quot;", "");

		echo("Expected team name value: ${teamName}");
		echo("Actual team name value: ${teamNameFromAPI}");

		if (!("${teamNameFromAPI}" == "${teamName}")) {
			fail("Actual team name ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}
	}

