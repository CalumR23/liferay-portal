	@prose = "I attempt to assign the team with the name ${teamName} on the account ${accountName} to the following roles as a non permissioned user ${table}"
	macro _assignTeamRolesToTeamAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var teamRoleName = "${row[0]}";

			var teamRoleKey = KoroneikiTeamRoleAPI._getTeamRoleKeyViaTeamRoleName(teamRoleName = "${teamRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/teams/${teamKey}/roles?teamRoleKeys=${teamRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I attempt to create an account on koroneiki with the following values as a non permissioned user ${table}"
	macro _createAccountAttempt {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var industry = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Sold By") {
				var soldBy = "${value}";
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		if (!(isSet(code))) {
			var code = "";
		}
		if (!(isSet(contactEmailAddress))) {
			var contactEmailAddress = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(faxNumber))) {
			var faxNumber = "";
		}
		if (!(isSet(industry))) {
			var industry = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(notes))) {
			var notes = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(profileEmailAddress))) {
			var profileEmailAddress = "";
		}
		if (!(isSet(soldBy))) {
			var soldBy = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}
		if (!(isSet(tier))) {
			var tier = "";
		}
		if (!(isSet(website))) {
			var website = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"description": "${description}",
				"faxNumber": "${faxNumber}",
				"industry": "${industry}",
				"name": "${name}",
				"notes": "${notes}",
				"phoneNumber": "${phoneNumber}",
				"profileEmailAddress": "${profileEmailAddress}",
				"soldBy": "${soldBy}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to create an external link for the account ${accountName} with the following values as a non permissioned user ${table}"
	macro _createAccountExternalLinkAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to create a team with the name ${teamName} for the account ${accountName} as a non permissioned user"
	macro _createAccountTeamAttempt {
