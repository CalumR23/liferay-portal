	@prose = "I attempt to update a koroneiki account with the name ${accountName} to have the following values as a non permissioned user ${table}"
	macro _updateAccountAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var code = "${value}";
			}
			else if ("${field}" == "Contact Email Address") {
				var contactEmailAddress = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Fax Number") {
				var faxNumber = "${value}";
			}
			else if ("${field}" == "Industry") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var industry = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Profile Email Address") {
				var profileEmailAddress = "${value}";
			}
			else if ("${field}" == "Sold By") {
				var soldBy = "${value}";
			}
			else if ("${field}" == "Status") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var status = "${value}";
			}
			else if ("${field}" == "Tier") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "-");

				var tier = "${value}";
			}
			else if ("${field}" == "Website") {
				var website = "${value}";
			}
			else {
				fail("No such account field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(code))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "code=")) {
				var value = JSONCurlUtil.get("${curl}", "$.code");

				var code = "${value}";
			}
			else {
				var code = "";
			}
		}
		if (!(isSet(contactEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "contactEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.contactEmailAddress");

				var contactEmailAddress = "${value}";
			}
			else {
				var contactEmailAddress = "";
			}
		}
		if (!(isSet(description))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(faxNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "faxNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.faxNumber");

				var faxNumber = "${value}";
			}
			else {
				var faxNumber = "";
			}
		}
		if (!(isSet(industry))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "industry=")) {
				var value = JSONCurlUtil.get("${curl}", "$.industry");

				var industry = "${value}";
			}
			else {
				var industry = "";
			}
		}
		if (!(isSet(name))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(notes))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "notes=")) {
				var value = JSONCurlUtil.get("${curl}", "$.notes");

				var notes = "${value}";
			}
			else {
				var notes = "";
			}
		}
		if (!(isSet(phoneNumber))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "phoneNumber=")) {
				var value = JSONCurlUtil.get("${curl}", "$.phoneNumber");

				var phoneNumber = "${value}";
			}
			else {
				var phoneNumber = "";
			}
		}
		if (!(isSet(profileEmailAddress))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "profileEmailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.profileEmailAddress");

				var profileEmailAddress = "${value}";
			}
			else {
				var profileEmailAddress = "";
			}
		}
		if (!(isSet(soldBy))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "soldBy=")) {
				var value = JSONCurlUtil.get("${curl}", "$.soldBy");

				var soldBy = "${value}";
			}
			else {
				var soldBy = "";
			}
		}
		if (!(isSet(status))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "status=")) {
				var value = JSONCurlUtil.get("${curl}", "$.status");

				var status = "${value}";
			}
			else {
				var status = "";
			}
		}
		if (!(isSet(tier))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "tier=")) {
				var value = JSONCurlUtil.get("${curl}", "$.tier");

				var tier = "${value}";
			}
			else {
				var tier = "";
			}
		}
		if (!(isSet(website))) {
			var accountObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${accountObject}", "website=")) {
				var value = JSONCurlUtil.get("${curl}", "$.website");

				var website = "${value}";
			}
			else {
				var website = "";
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"code": "${code}",
				"contactEmailAddress": "${contactEmailAddress}",
				"description": "${description}",
				"faxNumber": "${faxNumber}",
				"industry": "${industry}",
				"name": "${name}",
				"notes": "${notes}",
				"phoneNumber": "${phoneNumber}",
				"profileEmailAddress": "${profileEmailAddress}",
				"soldBy": "${soldBy}",
				"status": "${status}",
				"tier": "${tier}",
				"website": "${website}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a koroneiki account with the name ${accountName} as a non permissioned user"
	macro _viewNoAccount {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			fail("The account with the name ${accountName} is visible to a non permissioned user");
		}

		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var account = JSONCurlUtil.get("${curl}", "$");

		if (contains("${account}", "${accountName}")) {
			fail("The account with the name ${accountName} is visible to a non permissioned user");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be visible on the account ${accountName} for a non permissioned user"
