definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	macro _getAccountEntitlementDefinitionKey {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var entitlementDefinitionKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].key");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "[", "");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "]", "");

		var entitlementDefinitionKey = StringUtil.replace("${entitlementDefinitionKey}", "&quot;", "");

		echo("Key for account entitlement definition ${entitlementDefinitionName}: ${entitlementDefinitionKey}");

		return "${entitlementDefinitionKey}";
	}

	macro _getAccountEntitlementDefinitionExternalLinkKey {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/entitlement-definitions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${entitlementDefinitionName}')].externalLinks[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} on account entitlement definition ${entitlementDefinitionName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

