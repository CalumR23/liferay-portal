					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a koroneiki product with the name ${productName} as a non permissioned user"
	macro _viewNoProduct {
		if (contains("${productName}", " ")) {
			var keyword = StringUtil.extractFirst("${productName}", " ");
		}
		else {
			var keyword = "${productName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			fail("The product with the name ${productName} is visible to a non permissioned user");
		}

		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var product = JSONCurlUtil.get("${curl}", "$");

		if (contains("${product}", "${productName}")) {
			fail("The product with the name ${productName} is visible to a non permissioned user");
		}
	}

	@prose = "the external link with the entity id ${entityId} on the product ${productName} should not be visible to a non permissioned user"
	macro _viewNoProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the product ${productName} is visible to a non permissioned user");
		}

		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productExternalLink = JSONCurlUtil.get("${curl}", "$");

		if (contains("${productExternalLink}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the product ${productName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view a koroneiki product with the name ${productName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId} as a non permissioned user"
	macro _viewNoProductViaExternalLink {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var product = JSONCurlUtil.get("${curl}", "$");

		if (contains("${product}", "${productName}")) {
			fail("The product with the name ${productName} is visible to a non permissioned user");
		}
	}

	@prose = "I should be able to view a koroneiki product with the name ${productName} and the following values as a permissioned user ${table}"
	macro _viewProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "External Link Nested Field") {
				var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

				var externalLinkObjectNumber = "0";

				while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
					var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");

					var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
				}
				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

				var valueFromAPI = "${externalLinksObjectsEdit}";
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else {
				fail("No such product field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");
				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");
				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}
}