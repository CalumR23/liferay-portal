definition {
	var apiToken = PropsUtil.get("koroneiki.non.permission.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I attempt to create a product with the following values as a non permissioned user ${table}"
	macro _createProductAttempt {
		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "Name") {
				var name = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else {
				fail("No such product field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
		}
		else {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to create an external link on a product ${productName} with the following values as a non permissioned user ${table}"
	macro _createProductExternalLinkAttempt {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a koroneiki product with the name ${productName} as a permissioned user"
	macro _deleteProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to delete a koroneiki product with the name ${productName} as a non permissioned user"
	macro _deleteProductAttempt {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to delete an external link with the entity id ${entityId} on the product ${productName} as a non permissioned user"
	macro _deleteProductExternalLinkAttempt {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I set the permissions for a product with the name ${productName} to have the following values for a non permissioned user as a permissioned user ${table}"
	macro _setProductPermissions {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Consume") {
				var value = StringUtil.lowerCase("${value}");

				var consume = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(consume))) {
			var consume = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"consume": "${consume}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

