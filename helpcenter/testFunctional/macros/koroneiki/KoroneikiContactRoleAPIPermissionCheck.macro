definition {
	var apiToken = PropsUtil.get("koroneiki.non.permission.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I attempt to create a contact role on koroneiki with the following values as a non permissioned user ${table}"
	macro _createContactRoleAttempt {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Type") {
				var type = "${value}";
			}
			else {
				fail("No such contact role field ${field}");
			}
		}

		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(type))) {
			var type = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"description": "${description}",
				"name": "${name}",
				"type": "${type}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to delete a contact role on koroneiki with the name ${contactRoleName} as a non permissioned user"
	macro _deleteContactRoleAttempt {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to update a koroneiki contact role with the name ${contactRoleName} to have the following values as a non permissioned user ${table}"
	macro _updateContactRoleAttempt {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Type") {
				var type = "${value}";
			}
			else {
				fail("No such contact role field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(description))) {
			var contactRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactRoleObject}", "description=")) {
				var value = JSONCurlUtil.get("${curl}", "$.description");

				var description = "${value}";
			}
			else {
				var description = "";
			}
		}
		if (!(isSet(name))) {
			var contactRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactRoleObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${value}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(type))) {
			var contactRoleObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactRoleObject}", "type=")) {
				var value = JSONCurlUtil.get("${curl}", "$.type");

				var type = "${value}";
			}
			else {
				var type = "";
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"description": "${description}",
				"name": "${name}",
				"type": "${type}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a koroneiki contact role with the name ${contactRoleName} as a non permissioned user"
	macro _viewNoContactRole {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactRoles}", "${contactRoleName}")) {
			fail("The contact role with the name ${contactRoleName} is visible to a non permissioned user");
		}

		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactRole = JSONCurlUtil.get("${curl}", "$");

		if (contains("${contactRole}", "${contactRoleName}")) {
			fail("The contact role with the name ${contactRoleName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view an audit entry for a change to the contact role ${contactRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} as a non permissioned user"
	macro _viewNoContactRoleAuditEntry {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactRoleAuditEntries = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${contactRoleAuditEntries}", "${fieldName}")) || (contains("${contactRoleAuditEntries}", "${oldValue}")) || (contains("${contactRoleAuditEntries}", "${newValue}"))) {
			fail("The contact role audit entry for a change to the contact role ${contactRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}

		var auditEntryKey = KoroneikiContactRoleAPI._getContactRoleAuditEntryKey(
			contactRoleName = "${contactRoleName}",
			fieldName = "${fieldName}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactRoleAuditEntry = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${contactRoleAuditEntry}", "${fieldName}")) || (contains("${contactRoleAuditEntry}", "${oldValue}")) || (contains("${contactRoleAuditEntry}", "${newValue}"))) {
			fail("The contact role audit entry for a change to the contact role ${contactRoleName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}
	}
}