definition {
	var apiToken = PropsUtil.get("koroneiki.non.permission.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I attempt to create a contact on koroneiki with the following values as a non permissioned user ${table}"
	macro _createContactAttempt {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email Address") {
				var emailAddress = "${value}";
			}
			else if ("${field}" == "Email Address Verified") {
				var emailAddressVerified = "${value}";
			}
			else if ("${field}" == "First Name") {
				var firstName = "${value}";
			}
			else if ("${field}" == "Language") {
				var languageId = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var lastName = "${value}";
			}
			else if ("${field}" == "Middle Name") {
				var middleName = "${value}";
			}
			else if ("${field}" == "UUID") {
				var uuid = "${value}";
			}
			else {
				fail("No such contact field ${field}");
			}
		}

		if (!(isSet(emailAddress))) {
			var emailAddress = "";
		}
		if (!(isSet(emailAddressVerified))) {
			var emailAddressVerified = "false";
		}
		if (!(isSet(firstName))) {
			var firstName = "";
		}
		if (!(isSet(languageId))) {
			var languageId = "";
		}
		if (!(isSet(lastName))) {
			var lastName = "";
		}
		if (!(isSet(middleName))) {
			var middleName = "";
		}
		if (!(isSet(uuid))) {
			var uuid = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"emailAddress": "${emailAddress}",
				"emailAddressVerified": ${emailAddressVerified},
				"firstName": "${firstName}",
				"languageId": "${languageId}",
				"lastName": "${lastName}",
				"middleName": "${middleName}",
				"uuid": "${uuid}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to create an external link for the contact with the email address ${contactEmailAddress} with the following values as a non permissioned user ${table}"
	macro _createContactExternalLinkViaUuidAttempt {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I attempt to delete an external link with the entity id ${entityId} on the contact with the email address ${contactEmailAddress} as a non permissioned user"
	macro _deleteContactExternalLinkAttempt {
		var externalLinkKey = KoroneikiContactAPI._getContactExternalLinkKey(
			contactEmailAddress = "${contactEmailAddress}",
			entityId = "${entityId}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact on koroneiki with the email address ${contactEmailAddress} as a permissioned user"
	macro _deleteContactViaEmailAddress {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I attempt to delete a contact on koroneiki with the email address ${contactEmailAddress} as a non permissioned user"
	macro _deleteContactViaEmailAddressAttempt {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact on koroneiki with the email address ${contactEmailAddress} via uuid as a permissioned user"
	macro _deleteContactViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}
			--header "API_Token: ${apiToken}"
