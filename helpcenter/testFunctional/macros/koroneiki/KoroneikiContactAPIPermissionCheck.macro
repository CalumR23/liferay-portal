	@prose = "I attempt to delete a contact on koroneiki with the email address ${contactEmailAddress} via uuid as a non permissioned user"
	macro _deleteContactViaUuidAttempt {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
