	@prose = "I unset the following permissions for a contact with the email address ${contactEmailAddress} for a permissioned user as a permissioned user ${table}"
	macro _unsetContactPermissionsViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

