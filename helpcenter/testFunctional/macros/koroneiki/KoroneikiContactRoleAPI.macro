			}
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the contact role ${contactRoleName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName}"
	macro _viewContactRoleAuditEntry {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var field = StringUtil.lowerCaseFirstLetter("${field}");

		var field = StringUtil.replace("${field}", " ", "");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].action");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "[", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "]", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "&quot;", "");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		var fieldFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].field");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "[", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "]", "");

		var fieldFromAPI = StringUtil.replace("${fieldFromAPI}", "&quot;", "");

		echo("Expected Field Value: ${field}");
		echo("Actual Field Value: ${fieldFromAPI}");

		if (!("${field}" == "${fieldFromAPI}")) {
			fail("Actual field value ${fieldFromAPI} does not match expected field value ${field}");
		}

		if (!("${oldValue}" == "")) {
			var oldValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].oldValue");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "[", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "]", "");

			var oldValueFromAPI = StringUtil.replace("${oldValueFromAPI}", "&quot;", "");

			echo("Expected Old Value: ${oldValue}");
			echo("Actual Old Value: ${oldValueFromAPI}");

			if (!("${oldValue}" == "${oldValueFromAPI}")) {
				fail("Actual old value ${oldValueFromAPI} does not match expected old value ${oldValue}");
			}
		}

		var newValueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].newValue");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "[", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "]", "");

		var newValueFromAPI = StringUtil.replace("${newValueFromAPI}", "&quot;", "");

		echo("Expected New Value: ${newValue}");
		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].agentName");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "[", "");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "]", "");

		var agentNameFromAPI = StringUtil.replace("${agentNameFromAPI}", "&quot;", "");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')]");

		if ((!("${agentName}" == "Koroneiki QA Service Producer")) && (!("${agentName}" == "Auto"))) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.newValue=='${newValue}')].agentUID");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "[", "");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "]", "");

			var agentUIDFromAPI = StringUtil.replace("${agentUIDFromAPI}", "&quot;", "");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "I should be able to view an audit entry for an action ${action} to the contact role ${contactRoleName} field ${field} from the old value ${oldValue} to the new value ${newValue} executed by ${agentName} via the audit entry key"
	macro _viewContactRoleAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiContactRoleAPI._getContactRoleAuditEntryKey(
			action = "${action}",
			contactRoleName = "${contactRoleName}",
			field = "${field}",
