		echo("Actual New Value: ${newValueFromAPI}");

		if (!("${newValue}" == "${newValueFromAPI}")) {
			fail("Actual new value ${newValueFromAPI} does not match expected new value ${newValue}");
		}

		var agentNameFromAPI = JSONCurlUtil.get("${curl}", "$.agentName");

		echo("Expected Agent: ${agentName}");
		echo("Actual Agent: ${agentNameFromAPI}");

		if (!("${agentName}" == "${agentNameFromAPI}")) {
			fail("Actual agent ${agentNameFromAPI} does not match expected agent ${agentName}");
		}

		var auditEntry = JSONCurlUtil.get("${curl}");

		if ((!("${agentName}" == "Koroneiki QA Service Producer")) && (!("${agentName}" == "Auto"))) {
			var agentUIDFromAPI = JSONCurlUtil.get("${curl}", "$.agentUID");

			echo("Expected Agent UID: a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			echo("Actual Agent UID: ${agentUIDFromAPI}");

			if (!("a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1" == "${agentUIDFromAPI}")) {
				fail("Actual agent UID ${agentUIDFromAPI} does not match expected agent UID a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} and domain ${domain} should be present on the contact role ${contactRoleName} with the following values ${table}"
	macro _viewContactRoleOnExternalLinkViaIdAndDomain {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles/${contactRoleKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}' && @.domain=='${domain}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}' && @.domain=='${domain}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}' && @.domain=='${domain}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}' && @.domain=='${domain}')].url");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\/", "/");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should not be able to view a koroneiki contact role with the name ${contactRoleName}"
	macro _viewNoContactRole {
		if (contains("${contactRoleName}", " ")) {
			var keyword = StringUtil.replace("${contactRoleName}", " ", "+");
		}
		else {
			var keyword = "${contactRoleName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contact-roles?filter="name%20eq%20'${keyword}'"
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactRoles}", "${contactRoleName}")) {
			fail("The contact role with the name ${contactRoleName} is still present in Koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the contact role ${contactRoleName}"
	macro _viewNoContactRoleExternalLink {
		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${contactRoleKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactRoleExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactRoleExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the contact role with the name ${contactRoleName}");
		}
	}
}