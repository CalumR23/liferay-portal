definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I create a product with the name ${productName}"
	macro _createProduct {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"name": "${productName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an external link on a product ${productName} with the following values ${table}"
	macro _createProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete a koroneiki product with the name ${productName}"
	macro _deleteProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on the product ${productName}"
	macro _deleteProductExternalLink {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getProductExternalLinkKey {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} for product ${productName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getProductKeyViaProductName {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${productName}')].key");

		var productKey = StringUtil.replace("${productKey}", "[", "");

		var productKey = StringUtil.replace("${productKey}", "]", "");

		var productKey = StringUtil.replace("${productKey}", "&quot;", "");

		echo("Product key value for ${productName}: ${productKey}");

		return "${productKey}";
	}

	@prose = "I tear down the products on koroneiki with the following names ${table}"
	macro _tearDownProducts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var productName = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allProducts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allProducts}", "${productName}")) {
				KoroneikiProductAPI._deleteProduct(productName = "${productName}");

				echo("Name of product deleted: ${productName}");
			}
		}
	}

	@prose = "I update a product with the name ${productName} to have the new name ${productNameEdit}"
	macro updateProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"name": "${productNameEdit}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to view a koroneiki product with the name ${productName}"
	macro _viewNoProduct {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			fail("The product with the name ${productName} is still present in Koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the product ${productName}"
	macro _viewNoProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the product ${productName}");
		}
	}

	@prose = "I should be able to view a koroneiki product with the name ${productName}"
	macro _viewProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productNameFromAPI = JSONCurlUtil.get("${curl}", "$.name");

		echo("Expected Name Value: ${productName}");
		echo("Actual Name Value: ${productNameFromAPI}");

		if (!(contains("${productName}", "${productNameFromAPI}"))) {
			fail("Actual product name value ${productNameFromAPI} does not match expected product name value ${productName}");
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product ${productName} with the following values ${table}"
	macro _viewProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product ${productName} via the external link key with the following values ${table}"
	macro _viewProductExternalLinkViaExternalLinkKey {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityName");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view a koroneiki product with the name ${productName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId}"
	macro _viewProductViaExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${productName}')].name");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "[", "");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "]", "");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "&quot;", "");

		echo("Expected Name Value: ${productName}");
		echo("Actual Name Value: ${productNameFromAPI}");

		if (!(contains("${productName}", "${productNameFromAPI}"))) {
			fail("Actual product name value ${productNameFromAPI} does not match expected product name value ${productName}");
		}
	}
}