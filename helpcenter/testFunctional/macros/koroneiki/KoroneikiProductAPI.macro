definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I create a product with the following values ${table}"
	macro _createProduct {
		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "Name") {
				var name = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else {
				fail("No such product field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
		}
		else {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an external link on a product ${productName} with the following values ${table}"
	macro _createProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a nested field for the product external link with the following values ${table}"
	macro _createProductExternalLinkNestedField {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		static var staticProductExternalLinksNestedField = "{&quot;domain&quot;:&quot;${domain}&quot;,&quot;entityId&quot;:&quot;${entityId}&quot;,&quot;entityName&quot;:&quot;${entityName}&quot;}";

		return "${staticProductExternalLinksNestedField}";
	}

	@prose = "I create a product nested field for a non existent product with the name ${productName}"
	macro _createProductNestedFieldForNonexistentProduct {
		static var staticProductNestedField = "{&quot;name&quot;:&quot;${productName}&quot;}";

		return "${staticProductNestedField}";
	}

	@prose = "I delete a koroneiki product with the name ${productName}"
	macro _deleteProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on the product ${productName}"
	macro _deleteProductExternalLink {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getProductExternalLinkKey {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} for product ${productName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getProductKeyViaProductName {
		if (contains("${productName}", " ")) {
			var keyword = StringUtil.extractFirst("${productName}", " ");
		}
		else {
			var keyword = "${productName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productKey = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${productName}')].key");

		var productKey = StringUtil.replace("${productKey}", "[", "");

		var productKey = StringUtil.replace("${productKey}", "]", "");

		var productKey = StringUtil.replace("${productKey}", "&quot;", "");

		echo("Product key value for ${productName}: ${productKey}");

		return "${productKey}";
	}

	@prose = "I generate the product ID value for ${productName}"
	macro _generateProductId {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var productId = StringUtil.replace("${productKey}", "KOR-", "");

		static var staticProductId = "${productId}";

		return "${staticProductId}";
	}

	@prose = "I rename the first product id value"
	macro _renameFirstProductIdValue {
		static var staticProductId1 = "${staticProductId}";

		return "${staticProductId1}";
	}

	@prose = "I rename the second product id value"
	macro _renameSecondProductIdValue {
		static var staticProductId2 = "${staticProductId}";

		return "${staticProductId2}";
	}

	@prose = "I rename the third product id value"
	macro _renameThirdProductIdValue {
		static var staticProductId3 = "${staticProductId}";

		return "${staticProductId3}";
	}

	@prose = "I set the permissions for a product with the name ${productName} to have the following values for a non permissioned user ${table}"
	macro _setProductPermissions {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Consume") {
				var value = StringUtil.lowerCase("${value}");

				var consume = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(consume))) {
			var consume = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"consume": "${consume}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I tear down the external links for the product ${productName} on koroneiki with the following entity id values ${table}"
	macro _tearDownProductExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			if (contains("${productName}", " ")) {
				var keyword = StringUtil.extractFirst("${productName}", " ");
			}
			else {
				var keyword = "${productName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allProducts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allProducts}", "${productName}")) {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProductExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProductExternalLinks}", "${entityId}")) {
					KoroneikiProductAPI._deleteProductExternalLink(
						productName = "${productName}",
						entityId = "${entityId}");

					echo("Entity ID of external link for ${productName} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the permissions for a koroneiki product with the name ${productName} set for a non permissioned user"
	macro _tearDownProductPermissions {
		if (contains("${productName}", " ")) {
			var keyword = StringUtil.extractFirst("${productName}", " ");
		}
		else {
			var keyword = "${productName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"assignContact": "true",
					"delete": "true",
					"permissions": "true",
					"roleNames": [
						"${roleName}"
					],
					"update": "true",
					"view": "true"
				}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I tear down the products on koroneiki with the following names ${table}"
	macro _tearDownProducts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var productName = "${row[0]}";

			if (contains("${productName}", " ")) {
				var keyword = StringUtil.extractFirst("${productName}", " ");
			}
			else {
				var keyword = "${productName}";
			}

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allProducts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allProducts}", "${productName}")) {
				KoroneikiProductAPI._deleteProduct(productName = "${productName}");

				echo("Name of product deleted: ${productName}");
			}
		}
	}

	@prose = "I update a product with the name ${productName} to have the following values ${table}"
	macro updateProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var properties = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Agent Name") {
				var value1 = StringUtil.replace("${value1}", " ", "%20");

				var agentName = "${value1}";
			}
			else if ("${field}" == "Name") {
				var name = "${value1}";
			}
			else if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else {
				fail("No such product field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/product/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(name))) {
			var productObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productObject}", "name=")) {
				var value = JSONCurlUtil.get("${curl}", "$.name");

				var name = "${name}";
			}
			else {
				var name = "";
			}
		}
		if (!(isSet(properties))) {
			var productObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${productObject}", "properties=")) {
				var value = JSONCurlUtil.get("${curl}", "$.properties");

				var properties = "${value}";
			}
			else {
				var properties = "";
			}
		}

		if ("${properties}" == "") {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}"
					}
					''';
			}
		}
		else {
			if ("${agentName}" == "") {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
			else {
				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"name": "${name}",
						"properties": {
							${properties}
						}
					}
					''';
			}
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I unset the following permissions for a product with the name ${productName} for a permissioned user ${table}"
	macro _unsetProductPermissions {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Consume") {
				var value = StringUtil.lowerCase("${value}");

				var consume = "${value}";
			}
			else if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(consume))) {
			var consume = "false";
		}
		if (!(isSet(delete))) {
			var delete = "false";
		}
		if (!(isSet(permissions))) {
			var permissions = "false";
		}
		if (!(isSet(update))) {
			var update = "false";
		}
		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/product-permissions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"consume": "${consume}",
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I should not be able to view a koroneiki product with the name ${productName}"
	macro _viewNoProduct {
		if (contains("${productName}", " ")) {
			var keyword = StringUtil.extractFirst("${productName}", " ");
		}
		else {
			var keyword = "${productName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProducts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProducts}", "${productName}")) {
			fail("The product with the name ${productName} is still present in Koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the product ${productName}"
	macro _viewNoProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the product ${productName}");
		}
	}

	@prose = "I should be able to view a koroneiki product with the name ${productName} and the following values ${table}"
	macro _viewProduct {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "External Link Nested Field") {
				var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

				var externalLinkObjectNumber = "0";

				while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
					var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");

					var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
				}
				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

				var valueFromAPI = "${externalLinksObjectsEdit}";
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.name");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else {
				fail("No such product field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");
				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");
				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product ${productName} with the following values ${table}"
	macro _viewProductExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/${productKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].url");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\/", "/");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product ${productName} via the external link key with the following values ${table}"
	macro _viewProductExternalLinkViaExternalLinkKey {
		var externalLinkKey = KoroneikiProductAPI._getProductExternalLinkKey(
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.domain");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityId");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.entityName");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.url");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view a koroneiki product with the name ${productName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId}"
	macro _viewProductViaExternalLink {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/products/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var productNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${productName}')].name");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "[", "");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "]", "");

		var productNameFromAPI = StringUtil.replace("${productNameFromAPI}", "&quot;", "");

		echo("Expected Name Value: ${productName}");
		echo("Actual Name Value: ${productNameFromAPI}");

		if (!(contains("${productName}", "${productNameFromAPI}"))) {
			fail("Actual product name value ${productNameFromAPI} does not match expected product name value ${productName}");
		}
	}
}