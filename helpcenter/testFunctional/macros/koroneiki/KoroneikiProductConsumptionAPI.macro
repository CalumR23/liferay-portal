definition {

	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I create an external link for a product consumption made by account ${accountName} for the product ${productName} with the following values ${table}"
	macro _createProductConsumptionExternalLink {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a nested field for the product consumption external link with the following values ${table}"
	macro _createProductConsumptionExternalLinkNestedField {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else if ("${field}" == "URL") {
				var url = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}

		if (!(isSet(entityId))) {
			var entityId = "";
		}

		if (!(isSet(entityName))) {
			var entityName = "";
		}

		if (!(isSet(url))) {
			var url = "";
		}

		static var staticProductConsumptionExternalLinksNestedField = "{&quot;domain&quot;:&quot;${domain}&quot;,&quot;entityId&quot;:&quot;${entityId}&quot;,&quot;entityName&quot;:&quot;${entityName}&quot;,&quot;url&quot;:&quot;${url}&quot;}";

		return "${staticProductConsumptionExternalLinksNestedField}";
	}

	@prose = "I create a nested field for the product consumption for the product ${productName} with the following values ${table}"
	macro _createProductConsumptionNestedField {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var properties = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "Product Field and Value") {
				if ("${properties}" == "") {
					var properties = "&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
				else {
					var properties = "${properties},&quot;${value1}&quot;:&quot;${value2}&quot;";
				}
			}
			else {
				fail("No such product consumption field ${field}");
			}
		}

		static var staticProductConsumptionsNestedField = "{&quot;productKey&quot;:&quot;${productKey}&quot;,&quot;properties&quot;:{${properties}}}";

		return "${staticProductConsumptionsNestedField}";
	}

	@prose = "I delete a product consumption on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _deleteProductConsumption {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a product consumption on koroneiki made by the account ${accountName} for the product ${productName} executed by ${agentName}"
	macro _deleteProductConsumptionExecutedByAgent {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");
		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}?agentName=${agentName}\&agentUID=a1b2c3d4-e5f6-g7h8-i9j1-0k11l12m13n1 --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on a product consumption made by account ${accountName} for the product ${productName}"
	macro _deleteProductConsumptionExternalLink {
		var externalLinkKey = KoroneikiProductConsumptionAPI._getProductConsumptionExternalLinkKey(
			accountName = "${accountName}",
			entityId = "${entityId}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a product consumption list on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _deleteProductConsumptionList {
		var productConsumptionKeyList = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		for (var productConsumptionKey : list "${productConsumptionKeyList}") {
			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey} --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	macro _getProductConsumptionExternalLinkKey {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "\"", "");

		echo("External link key value for ${entityId} on product consumption on ${accountName} for ${productName}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	@prose = "I set the permissions for the product consumption made by the account ${accountName} for the product ${productName} to have the following values for a non permissioned user ${table}"
	macro _setProductConsumptionPermissions {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/product-consumption-permissions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I tear down the external links for the product consumption made by account ${accountName} for the product ${productName} with the following entity id values ${table}"
	macro _tearDownProductConsumptionExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			if (contains("${accountName}", " ")) {
				var keyword = StringUtil.replace("${accountName}", " ", "+");
			}
			else {
				var keyword = "${accountName}";
			}

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccounts}", "${accountName}")) {
				var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allAccountProductConsumptions = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allAccountProductConsumptions}", "${productName}")) {
					var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
						accountName = "${accountName}",
						productName = "${productName}");

					var curl = '''
						${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductConsumptionExternalLinks = JSONCurlUtil.get("${curl}", "$");

					if (contains("${allAccountProductConsumptionExternalLinks}", "${entityId}")) {
						KoroneikiProductConsumptionAPI._deleteProductConsumptionExternalLink(
							accountName = "${accountName}",
							entityId = "${entityId}",
							productName = "${productName}");

						echo("Entity ID of external link deleted for product consumption made by ${accountName} for ${productName}: ${entityId}");
					}
				}
			}
		}
	}

	@prose = "I tear down the product consumption list on koroneiki made by the account ${accountName} for the following products ${table}"
	macro _tearDownProductConsumptionList {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.replace("${accountName}", " ", "+");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var productName = "${row[0]}";

				if (contains("${productName}", " ")) {
					var keyword = StringUtil.replace("${productName}", " ", "+");
				}
				else {
					var keyword = "${productName}";
				}

				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProducts = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProducts}", "${productName}")) {
					var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
					var curl = '''
						${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductConsumptions = JSONCurlUtil.get("${curl}", "$");

					if (contains("${allAccountProductConsumptions}", "${productKey}")) {
						KoroneikiProductConsumptionAPI._deleteProductConsumptionList(
							accountName = "${accountName}",
							productName = "${productName}");

						echo("Product Consumptions deleted: ${productName} made by ${accountName}");
					}
				}
			}
		}
	}

	@prose = "I tear down the permissions for the product consumption made by the account ${accountName} for the product ${productName} for a non permissioned user"
	macro _tearDownProductConsumptionPermissions {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.replace("${accountName}", " ", "+");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

			var curl = '''
				${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccountProductConsumptions = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allAccountProductConsumptions}", "${productName}")) {
				var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
					accountName = "${accountName}",
					productName = "${productName}");

				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/product-consumption-permissions --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					-d
					{
						"delete": "true",
						"permissions": "true",
						"roleNames": [
							"${roleName}"
						],
						"update": "true",
						"view": "true"
					}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
			}
		}
	}

	@prose = "I tear down the product consumptions on koroneiki made by the account ${accountName} for the following products ${table}"
	macro _tearDownProductConsumptions {
		if (contains("${accountName}", " ")) {
			var keyword = StringUtil.replace("${accountName}", " ", "+");
		}
		else {
			var keyword = "${accountName}";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?filter="name%20eq%20'${keyword}'" --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccounts}", "${accountName}")) {
			var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var productName = "${row[0]}";

				if (contains("${productName}", " ")) {
					var keyword = StringUtil.replace("${productName}", " ", "+");
				}
				else {
					var keyword = "${productName}";
				}

				var curl = '''
					${koroneikiURL}/o/koroneiki-rest/v1.0/products?filter="name%20eq%20'${keyword}'" --tlsv1.2
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allProducts = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allProducts}", "${productName}")) {
					var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
					var curl = '''
						${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
						--header "API_Token: ${apiToken}"
						-H "accept: application/json"
						-H "Content-Type: application/json"
						''';

					var allAccountProductConsumptions = JSONCurlUtil.get("${curl}", "$");

					if (contains("${allAccountProductConsumptions}", "${productKey}")) {
						KoroneikiProductConsumptionAPI._deleteProductConsumption(
							accountName = "${accountName}",
							productName = "${productName}");

						echo("Product Consumption deleted: ${productName} made by ${accountName}");
					}
				}
			}
		}
	}

	@prose = "I unset the following permissions for the product consumption made by the account ${accountName} for the product ${productName} for a permissioned user ${table}"
	macro _unsetProductConsumptionPermissions {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Delete") {
				var value = StringUtil.lowerCase("${value}");

				var delete = "${value}";
			}
			else if ("${field}" == "Permissions") {
				var value = StringUtil.lowerCase("${value}");

				var permissions = "${value}";
			}
			else if ("${field}" == "Update") {
				var value = StringUtil.lowerCase("${value}");

				var update = "${value}";
			}
			else if ("${field}" == "View") {
				var value = StringUtil.lowerCase("${value}");

				var view = "${value}";
			}
			else {
				fail("No such permission field ${field}");
			}
		}

		if (!(isSet(delete))) {
			var delete = "false";
		}

		if (!(isSet(permissions))) {
			var permissions = "false";
		}

		if (!(isSet(update))) {
			var update = "false";
		}

		if (!(isSet(view))) {
			var view = "false";
		}

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/product-consumption-permissions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"delete": "${delete}",
				"permissions": "${permissions}",
				"roleNames": [
					"${roleName}"
				],
				"update": "${update}",
				"view": "${view}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I should not be able to view a product consumption on koroneiki made by the account ${accountName} for the product ${productName}"
	macro _viewNoProductConsumption {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/accounts/${accountKey}/product-consumptions --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountProductConsumptions = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountProductConsumptions}", "${productKey}")) {
			fail("The product consumption made by ${accountName} for the product ${productName} is still present on koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the product consumption made by account ${accountName} for the product ${productName}"
	macro _viewNoProductConsumptionExternalLink {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allProductConsumptionExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allProductConsumptionExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the product consumption made by the account ${accountName} for the product ${productName}");
		}
	}

	@prose = "I should be able to view a product consumption on koroneiki made by the account ${accountName} for the product ${productName} with the following values ${table}"
	macro _viewProductConsumption {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey} --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";

			if ("${field}" == "End Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.endDate");
			}
			else if ("${field}" == "External Link Nested Field") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.externalLinks");
			}
			else if ("${field}" == "Product Field and Value") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.properties.${value1}");
			}
			else if ("${field}" == "Product Purchase") {
				if ("${value1}" == "true") {
					var valueFromAPI = JSONCurlUtil.get("${curl}", "$.productPurchaseKey");
				}
			}
			else if ("${field}" == "Start Date") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.startDate");
			}
			else {
				fail("No such product consumption field ${field}");
			}

			if ("${field}" == "Product Field and Value") {
				echo("Expected property field ${value1} value: ${value2}");

				echo("Actual property field ${value1} value: ${valueFromAPI}");

				if (!(contains("${value2}", "${valueFromAPI}"))) {
					fail("Actual property field ${value1} value ${valueFromAPI} does not match expected property field ${value1} value ${value2}");
				}
			}
			else if ("${field}" == "Product Purchase") {
				if ("${value1}" == "true") {
					var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
						accountName = "${accountName}",
						productName = "${productName}");

					echo("Expected ${field} Value: ${productPurchaseKey}");

					echo("Actual ${field} Value: ${valueFromAPI}");

					if (!(contains("${productPurchaseKey}", "${valueFromAPI}"))) {
						fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${productPurchaseKey}");
					}
				}
			}
			else if (contains("${field}", "Nested Field")) {
				echo("Expected Partial ${field} Value: ${value1}");

				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${valueFromAPI}", "${value1}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not contain the expected ${field} value ${value1}");
				}
			}
			else {
				echo("Expected ${field} Value: ${value1}");

				echo("Actual ${field} Value: ${valueFromAPI}");

				if (!(contains("${value1}", "${valueFromAPI}"))) {
					fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value1}");
				}
			}
		}
	}

	@prose = "the external link with the entity id ${entityId} should be present on the product consumption made by account ${accountName} for the product ${productName} with the following values ${table}"
	macro _viewProductConsumptionExternalLink {
		var productConsumptionKey = KoroneikiAccountAPI._getAccountProductConsumptionKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");

		var curl = '''
			${koroneikiURL}/o/koroneiki-rest/v1.0/product-consumptions/${productConsumptionKey}/external-links --tlsv1.2
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].domain");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else if ("${field}" == "Entity Id") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityId");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else if ("${field}" == "Entity Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].entityName");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");
			}
			else if ("${field}" == "URL") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].url");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\/", "/");
			}
			else {
				fail("No such external link field ${field}");
			}

			echo("Expected ${field} Value: ${value}");

			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

