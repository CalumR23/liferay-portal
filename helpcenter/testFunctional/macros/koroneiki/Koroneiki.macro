definition {
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I click on the new entity button"
	macro clickNewEntityButton {
		Click(locator1 = "Koroneiki#NEW_ENTITY_BUTTON");

		var key_field = "";

		AssertVisible(locator1 = "KoroneikiEntityForm#INPUT_FIELD");
	}

	@prose = "I click on the actions link for the entity ${entityName}"
	macro clickEntityActionsLink {
		var key_entityName = "${entityName}";

		Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");
	}

	@prose = "I go to the koroneiki account index page"
	macro gotoAccounts {
		Open(locator1 = "${koroneikiURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_koroneiki_taproot_web_portlet_AccountsAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the koroneiki contact index page"
	macro gotoContacts {
		Open(locator1 = "${koroneikiURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_koroneiki_taproot_web_portlet_ContactsAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the koroneiki product index page"
	macro gotoProducts {
		Open(locator1 = "${koroneikiURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_koroneiki_trunk_web_portlet_ProductsAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the koroneiki product purchase index page"
	macro gotoProductPurchases {
		Open(locator1 = "${koroneikiURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_koroneiki_trunk_web_portlet_ProductsAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_osb_koroneiki_trunk_web_portlet_ProductsAdminPortlet_tabs1=purchases");
	}

	@prose = "I go to the koroneiki team index page"
	macro gotoTeams {
		Open(locator1 = "${koroneikiURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_koroneiki_taproot_web_portlet_TeamsAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I search koroneiki using the keyword ${keyword}"
	macro search {
		Type(
			locator1 = "Koroneiki#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "Koroneiki#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I tear down the following accounts via the koroneiki frontend ${table}"
	macro tearDownAccounts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = "${entityName}");

			var key_entityName = "${entityName}";

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
				Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");

				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this account?");

				Message.success();
			}
		}
	}

	@prose = "I tear down the following contacts via the koroneiki frontend ${table}"
	macro tearDownContacts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = "${entityName}");

			var key_entityName = "${entityName}";

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
				Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");

				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this contact?");

				Message.success();
			}
		}
	}

	@prose = "I tear down the following product purchases via the koroneiki frontend ${table}"
	macro tearDownProductPurchases {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = "${entityName}");

			var key_entityName = "${entityName}";

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
