				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this purchase?");

				Message.success();
			}
		}
	}

	@prose = "I tear down the following products via the koroneiki frontend ${table}"
	macro tearDownProducts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = "${entityName}");

			var key_entityName = "${entityName}";

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
				Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");

				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this product?");

				Message.success();
			}
		}
	}

	@prose = "I tear down the following teams via the koroneiki frontend ${table}"
	macro tearDownTeams {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityName = "${row[0]}";

			Koroneiki.search(keyword = "${entityName}");

			var key_entityName = "${entityName}";

			if (IsElementPresent(locator1 = "Koroneiki#ENTITY_ROW")) {
				Click(locator1 = "Koroneiki#ENTITY_ACTIONS_LINK");

				var key_action = "Delete";

				ClickNoError(locator1 = "Koroneiki#MENULIST_ACTION");

				Confirm(value1 = "Are you sure you want to delete this team?");

				Message.success();
			}
		}
	}
}