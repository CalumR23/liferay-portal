definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I create a contact on koroneiki with the following values ${table}"
	macro _createContact {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email Address") {
				var emailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var firstName = "${value}";
			}
			else if ("${field}" == "Language") {
				var languageId = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var lastName = "${value}";
			}
			else if ("${field}" == "Middle Name") {
				var middleName = "${value}";
			}
			else if ("${field}" == "Okta ID") {
				var oktaId = "${value}";
			}
			else if ("${field}" == "UUID") {
				var uuid = "${value}";
			}
			else {
				fail("No such contact field ${field}");
			}
		}

		if (!(isSet(emailAddress))) {
			var emailAddress = "";
		}
		if (!(isSet(firstName))) {
			var firstName = "";
		}
		if (!(isSet(languageId))) {
			var languageId = "";
		}
		if (!(isSet(lastName))) {
			var lastName = "";
		}
		if (!(isSet(middleName))) {
			var middleName = "";
		}
		if (!(isSet(oktaId))) {
			var oktaId = "";
		}
		if (!(isSet(uuid))) {
			var uuid = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"emailAddress": "${emailAddress}",
				"firstName": "${firstName}",
				"languageId": "${languageId}",
				"lastName": "${lastName}",
				"middleName": "${middleName}",
				"oktaId": "${oktaId}",
				"uuid": "${uuid}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an external link for the contact with the okta ID ${contactOktaId} with the following values ${table}"
	macro _createContactExternalLinkViaOktaId {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create an external link for the contact with the email address ${contactEmailAddress} with the following values ${table}"
	macro _createContactExternalLinkViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Domain") {
				var domain = "${value}";
			}
			else if ("${field}" == "Entity Id") {
				var entityId = "${value}";
			}
			else if ("${field}" == "Entity Name") {
				var entityName = "${value}";
			}
			else {
				fail("No such external link field ${field}");
			}
		}

		if (!(isSet(domain))) {
			var domain = "";
		}
		if (!(isSet(entityId))) {
			var entityId = "";
		}
		if (!(isSet(entityName))) {
			var entityName = "";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"domain": "${domain}",
				"entityId": "${entityId}",
				"entityName": "${entityName}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete an external link with the entity id ${entityId} on the contact with the email address ${contactEmailAddress}"
	macro _deleteContactExternalLink {
		var externalLinkKey = KoroneikiContactAPI._getContactExternalLinkKey(
			contactEmailAddress = "${contactEmailAddress}",
			entityId = "${entityId}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact on koroneiki with the email address ${contactEmailAddress}"
	macro _deleteContactViaEmailAddress {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact on koroneiki with the okta ID ${contactOktaId}"
	macro _deleteContactViaOktaId {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact on koroneiki with the email address ${contactEmailAddress} via uuid"
	macro _deleteContactViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	macro _getContactAuditEntryKey {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var auditEntryKey = JSONCurlUtil.get("${curl}", "$.items[?(@.field=='${fieldName}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].key");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "[", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "]", "");

		var auditEntryKey = StringUtil.replace("${auditEntryKey}", "&quot;", "");

		echo("Audit entry key value for change to ${fieldName} from ${oldValue} to ${newValue} on contact with the email address ${contactEmailAddress}: ${auditEntryKey}");

		return "${auditEntryKey}";
	}

	macro _getContactExternalLinkKey {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var externalLinkKey = JSONCurlUtil.get("${curl}", "$.items[?(@.entityId=='${entityId}')].key");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "[", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "]", "");

		var externalLinkKey = StringUtil.replace("${externalLinkKey}", "&quot;", "");

		echo("External link key value for ${entityId} on contact with email address ${contactEmailAddress}: ${externalLinkKey}");

		return "${externalLinkKey}";
	}

	macro _getContactOktaIdViaContactEmailAddress {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactOktaId = JSONCurlUtil.get("${curl}", "$.items[?(@.emailAddress=='${contactEmailAddress}')].oktaId");

		var contactOktaId = StringUtil.replace("${contactOktaId}", "[", "");

		var contactOktaId = StringUtil.replace("${contactOktaId}", "]", "");

		var contactOktaId = StringUtil.replace("${contactOktaId}", "&quot;", "");

		echo("Okta ID value for ${contactEmailAddress}: ${contactOktaId}");

		return "${contactOktaId}";
	}

	macro _getContactUuidViaContactEmailAddress {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactUuid = JSONCurlUtil.get("${curl}", "$.items[?(@.emailAddress=='${contactEmailAddress}')].uuid");

		var contactUuid = StringUtil.replace("${contactUuid}", "[", "");

		var contactUuid = StringUtil.replace("${contactUuid}", "]", "");

		var contactUuid = StringUtil.replace("${contactUuid}", "&quot;", "");

		echo("UUID value for ${contactEmailAddress}: ${contactUuid}");

		return "${contactUuid}";
	}

	@prose = "I tear down the external links for the contact with the email address ${contactEmailAddress} on koroneiki with the following entity id values ${table}"
	macro _tearDownContactExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allContacts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allContacts}", "${contactEmailAddress}")) {
				var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allContactExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allContactExternalLinks}", "${entityId}")) {
					KoroneikiContactAPI._deleteContactExternalLink(
						contactEmailAddress = "${contactEmailAddress}",
						entityId = "${entityId}");

					echo("Entity ID of external link contact with email address ${contactEmailAddress} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the contacts on koroneiki with the following email addresses ${table}"
	macro _tearDownContacts {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactEmailAddress = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allContacts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allContacts}", "${contactEmailAddress}")) {
				KoroneikiContactAPI._deleteContactViaEmailAddress(contactEmailAddress = "${contactEmailAddress}");

				echo("Email address of contact deleted: ${contactEmailAddress}");
			}
		}
	}

	@prose = "I update a koroneiki contact with the email address ${contactEmailAddress} to have the following values ${table}"
	macro _updateContactViaEmailAddress {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email Address") {
				var emailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var firstName = "${value}";
			}
			else if ("${field}" == "Language") {
				var languageId = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var lastName = "${value}";
			}
			else if ("${field}" == "Middle Name") {
				var middleName = "${value}";
			}
			else if ("${field}" == "Okta ID") {
				var oktaId = "${value}";
			}
			else if ("${field}" == "UUID") {
				var uuid = "${value}";
			}
			else {
				fail("No such contact field ${field}");
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if (!(isSet(emailAddress))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "emailAddress=")) {
				var value = JSONCurlUtil.get("${curl}", "$.emailAddress");

				var emailAddress = "${value}";
			}
			else {
				var emailAddress = "";
			}
		}
		if (!(isSet(firstName))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "firstName=")) {
				var value = JSONCurlUtil.get("${curl}", "$.firstName");

				var firstName = "${value}";
			}
			else {
				var firstName = "";
			}
		}
		if (!(isSet(languageId))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "languageId=")) {
				var value = JSONCurlUtil.get("${curl}", "$.languageId");

				var languageId = "${value}";
			}
			else {
				var languageId = "";
			}
		}
		if (!(isSet(lastName))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "lastName=")) {
				var value = JSONCurlUtil.get("${curl}", "$.lastName");

				var lastName = "${value}";
			}
			else {
				var lastName = "";
			}
		}
		if (!(isSet(middleName))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");

			if (contains("${contactObject}", "middleName=")) {
				var value = JSONCurlUtil.get("${curl}", "$.middleName");

				var middleName = "${value}";
			}
			else {
				var middleName = "";
			}
		}
		if (!(isSet(oktaId))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "oktaId=")) {
				var value = JSONCurlUtil.get("${curl}", "$.oktaId");

				var oktaId = "${value}";
			}
			else {
				var oktaId = "";
			}
		}
		if (!(isSet(uuid))) {
			var contactObject = JSONCurlUtil.get("${curl}", "$");
			
			if (contains("${contactObject}", "uuid=")) {
				var value = JSONCurlUtil.get("${curl}", "$.uuid");

				var uuid = "${value}";
			}
			else {
				var uuid = "";
			}
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-d
			{
				"emailAddress": "${emailAddress}",
				"firstName": "${firstName}",
				"languageId": "${languageId}",
				"lastName": "${lastName}",
				"middleName": "${middleName}",
				"oktaId": "${oktaId}",
				"uuid": "${uuid}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

