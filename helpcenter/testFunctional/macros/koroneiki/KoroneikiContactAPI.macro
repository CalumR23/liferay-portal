		if (contains("${allContactAccounts}", "${accountName}")) {
			fail("The contact with the okta ID ${contactOktaId} contains the account ${accountName}");
		}
	}

	@prose = "the account with the name ${accountName} should not be assigned the contact with the email address ${contactEmailAddress}"
	macro _viewNoAccountViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/accounts
