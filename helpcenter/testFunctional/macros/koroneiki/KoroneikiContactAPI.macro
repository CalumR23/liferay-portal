	@prose = "the account with the name ${accountName} should be assigned the contact with the okta ID ${contactOktaId} with the contact role ${contactRoleName}"
	macro _viewAccountContactRoleViaOktaId {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}/contact-account-views
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactRoleNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.account[?(@.name=='${accountName}')])].contactRoles[?(@.name=='${contactRoleName}')].name");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "[", "");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "]", "");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "&quot;", "");

		echo("Expected contact role name value: ${contactRoleName}");
		echo("Actual contact role name value: ${contactRoleNameFromAPI}");

		if (!("${contactRoleNameFromAPI}" == "${contactRoleName}")) {
			fail("Actual contact role name value ${contactRoleNameFromAPI} does not match expected contact role name value ${contactRoleName}");
		}
	}

