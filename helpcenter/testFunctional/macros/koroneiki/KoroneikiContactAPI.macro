	@prose = "I should not be able to view a koroneiki contact with the email address ${contactEmailAddress}"
	macro _viewNoContact {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContacts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContacts}", "${contactEmailAddress}")) {
			fail("The contact with the email address ${contactEmailAddress} is still present in Koroneiki");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the contact with the email address ${contactEmailAddress}"
	macro _viewNoContactExternalLink {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the contact with the email address ${contactEmailAddress}");
		}
	}
}