	@prose = "I should be able to view an audit entry for a change to the contact with the email address ${contactEmailAddress} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} via the audit entry key with the following values ${table}"
	macro _viewContactAuditEntryViaAuditEntryKey {
		var auditEntryKey = KoroneikiContactAPI._getContactAuditEntryKey(
			contactEmailAddress = "${contactEmailAddress}",
			fieldName = "${fieldName}",
			newValue = "${newValue}",
			oldValue = "${oldValue}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			var field = StringUtil.lowerCaseFirstLetter("${field}");

			var field = StringUtil.replace("${field}", " ", "");

			if ("${field}" == "action") {
				var value = StringUtil.lowerCase("${value}");
			}

			var valueFromAPI = JSONCurlUtil.get("${curl}", "$.${field}");

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

