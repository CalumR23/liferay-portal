	@prose = "the account with the name ${accountName} should be assigned the contact with the okta ID ${contactOktaId} without the contact role ${contactRoleName}"
	macro _viewNoAccountContactRoleViaOktaId {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}/contact-account-views
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactRoles = JSONCurlUtil.get("${curl}", "$.items[?(@.account[?(@.name=='${accountName}')])].contactRoles");

		if (contains("${allContactRoles}", "${contactRoleName}")) {
			fail("The contact with the okta ID ${contactOktaId} still has the contact role ${contactRoleName}");
		}
	}

