		if (contains("${allContactAccounts}", "${accountName}")) {
			fail("The contact with the email address ${contactEmailAddress} contains the account ${accountName}");
		}
	}

	@prose = "the account with the name ${accountName} should be assigned the contact with the okta ID ${contactOktaId} without the worker contact role ${contactRoleName}"
	macro _viewNoAccountWorkerContactRoleViaOktaId {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}/contact-account-views
			--header "API_Token: ${apiToken}"
