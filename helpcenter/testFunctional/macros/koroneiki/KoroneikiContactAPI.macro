		static var staticContactExternalLinksNestedField = "{&quot;domain&quot;:&quot;${domain}&quot;,&quot;entityId&quot;:&quot;${entityId}&quot;,&quot;entityName&quot;:&quot;${entityName}&quot;}";

		return "${staticContactExternalLinksNestedField}";
	}

