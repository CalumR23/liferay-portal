	@prose = "I create a contact entitlement definition related to the product purchase of the product ${productName} and contact role with the name ${contactRoleName} and type ${contactRoleType} with the following values ${table}"
	macro _createContactEntitlementDefinition {
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

		var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleNameAndType(
			contactRoleName = "${contactRoleName}",
			contactRoleType = "${contactRoleType}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else {
				fail("No such entitlment definition field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(name))) {
			var name = "";
		}
		if (!(isSet(status))) {
			var status = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/entitlement-definitions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"definition": "SELECT DISTINCT(Koroneiki_Contact.contactId) FROM Koroneiki_Contact INNER JOIN Koroneiki_ContactAccountRole ON Koroneiki_ContactAccountRole.contactId = Koroneiki_Contact.contactId INNER JOIN Koroneiki_ProductPurchase ON Koroneiki_ProductPurchase.accountId = Koroneiki_ContactAccountRole.accountId INNER JOIN Koroneiki_ContactRole ON Koroneiki_ContactRole.contactRoleId = Koroneiki_ContactAccountRole.contactRoleId INNER JOIN Koroneiki_ProductEntry ON Koroneiki_ProductEntry.productEntryId = Koroneiki_ProductPurchase.productEntryId WHERE (Koroneiki_ContactRole.contactRoleKey = '\'${contactRoleKey}\'') AND ((Koroneiki_ProductPurchase.startDate IS NULL) OR ((Koroneiki_ProductPurchase.startDate < '\'[\$NOW$]\'') AND (Koroneiki_ProductPurchase.endDate >= '\'[\$NOW$]\''))) AND (Koroneiki_ProductEntry.productEntryKey in ('\'${productKey}\''))",
					"description": "${description}",
					"name": "${name}",
					"status": "${status}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/entitlement-definitions?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"definition": "SELECT DISTINCT(Koroneiki_Contact.contactId) FROM Koroneiki_Contact INNER JOIN Koroneiki_ContactAccountRole ON Koroneiki_ContactAccountRole.contactId = Koroneiki_Contact.contactId INNER JOIN Koroneiki_ProductPurchase ON Koroneiki_ProductPurchase.accountId = Koroneiki_ContactAccountRole.accountId INNER JOIN Koroneiki_ContactRole ON Koroneiki_ContactRole.contactRoleId = Koroneiki_ContactAccountRole.contactRoleId INNER JOIN Koroneiki_ProductEntry ON Koroneiki_ProductEntry.productEntryId = Koroneiki_ProductPurchase.productEntryId WHERE (Koroneiki_ContactRole.contactRoleKey = '\'${contactRoleKey}\'') AND ((Koroneiki_ProductPurchase.startDate IS NULL) OR ((Koroneiki_ProductPurchase.startDate < '\'[\$NOW$]\'') AND (Koroneiki_ProductPurchase.endDate >= '\'[\$NOW$]\''))) AND (Koroneiki_ProductEntry.productEntryKey in ('\'${productKey}\''))",
					"description": "${description}",
					"name": "${name}",
					"status": "${status}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I create a nested field for the contact entitlement coming from the entitlement definition ${entitlementDefinitionName}"
	macro _createContactEntitlementNestedField {
		var entitlementDefinitionKey = KoroneikiContactAPI._getContactEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		static var staticContactEntitlementsNestedField = "{&quot;entitlementDefinitionKey&quot;:&quot;${entitlementDefinitionKey}&quot;,&quot;name&quot;:&quot;${entitlementDefinitionName}&quot;}";

		return "${staticContactEntitlementsNestedField}";
	}

	@prose = "I create a nested field for the contact external link with the following values ${table}"
