		if (contains("${allContactRoles}", "${contactRoleName}")) {
			fail("The contact with the okta ID ${contactOktaId} still has the contact role ${contactRoleName}");
		}
	}

	@prose = "the account with the name ${accountName} should be assigned the contact with the email address ${contactEmailAddress} without the customer contact role ${contactRoleName}"
	macro _viewNoAccountCustomerContactRoleViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/contact-account-views
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactRoles = JSONCurlUtil.get("${curl}", "$.items[?(@.account[?(@.name=='${accountName}')])].customerContactRoles");

		if (contains("${allContactRoles}", "${contactRoleName}")) {
			fail("The contact with the email address ${contactEmailAddress} still has the contact role ${contactRoleName}");
		}
	}

	@prose = "the account with the name ${accountName} should not be assigned the contact with the okta ID ${contactOktaId}"
	macro _viewNoAccountViaOktaId {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-okta-id/${contactOktaId}/accounts
