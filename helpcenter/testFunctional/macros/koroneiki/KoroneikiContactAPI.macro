	@prose = "I should not be able to view a koroneiki contact with the email address ${contactEmailAddress}"
	macro _viewNoContact {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts?search=${contactEmailAddress}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContacts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContacts}", "${contactEmailAddress}")) {
			fail("The contact with the email address ${contactEmailAddress} is still present in Koroneiki");
		}
	}

	@prose = "the contact entitlement definition with the name ${entitlementDefinitionName} should not be present"
	macro _viewNoContactEntitlementDefinition {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/entitlement-definitions
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactEntitlementDefinitions = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactEntitlementDefinitions}", "${entitlementDefinitionName}")) {
			fail("The entitlement definition with the name ${entitlementDefinitionName} is present");
		}
	}

	@prose = "the entitlement from the entitlement definition ${entitlementDefinitionName} should not be visible via nested field on the contact with the email address ${contactEmailAddress}"
	macro _viewNoContactEntitlementViaNestedField {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactFields = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactFields}", "entitlements")) {
			var allContactEntitlements = JSONCurlUtil.get("${curl}", "$.entitlements");

			if (contains("${allContactEntitlements}", "${entitlementDefinitionName}")) {
				fail("The contact with the email address ${contactEmailAddress} contains the entitlement from entititlement definition name ${entitlementDefinitionName}");
			}
		}
		else {
			echo("No entitlements present on ${contactEmailAddress} and therefore there is no entitlements nested field visible");
		}
	}

	@prose = "the external link with the entity id ${entityId} should not be present on the contact with the email address ${contactEmailAddress}"
	macro _viewNoContactExternalLink {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allContactExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allContactExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} is on the contact with the email address ${contactEmailAddress}");
		}
	}
}