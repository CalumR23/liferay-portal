	@prose = "I should be able to view a koroneiki contact with the email address ${contactEmailAddress} and the following values ${table}"
	macro _viewContactViaEmailAddress {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.emailAddress");
			}
			else if ("${field}" == "Email Address Verified") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.emailAddressVerified");
			}
			else if ("${field}" == "Entitlement Nested Field") {
				var entitlementsObjects = JSONCurlUtil.get("${curl}", "$.entitlements");

				var entitlementsObjects = StringUtil.replace("${entitlementsObjects}", "[", "");

				var entitlementsObjects = StringUtil.replace("${entitlementsObjects}", "]", "");

				var valueFromAPI = "${entitlementsObjects}";
			}
			else if ("${field}" == "External Link Nested Field") {
				var externalLinksObjects = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var externalLinksObjectsEdit = JSONCurlUtil.get("${curl}", "$.externalLinks");

				var numberOfExternalLinks = StringUtil.count("${externalLinksObjects}", "entityId");

				var externalLinkObjectNumber = "0";

				while (!("${externalLinkObjectNumber}" == "${numberOfExternalLinks}")) {
					var externalLinkObject = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}]");

					var dateCreated = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].dateCreated");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "&quot;dateCreated&quot;:&quot;${dateCreated}&quot;,", "");

					var key = JSONCurlUtil.get("${curl}", "$.externalLinks[${externalLinkObjectNumber}].key");

					var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", ",&quot;key&quot;:&quot;${key}&quot;", "");

					var externalLinkObjectNumber = MathUtil.sum("${externalLinkObjectNumber}", "1");
				}
				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "[", "");

				var externalLinksObjectsEdit = StringUtil.replace("${externalLinksObjectsEdit}", "]", "");

				var valueFromAPI = "${externalLinksObjectsEdit}";
			}
			else if ("${field}" == "First Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.firstName");
			}
			else if ("${field}" == "Language") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.languageId");
			}
			else if ("${field}" == "Last Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.lastName");
			}
			else if ("${field}" == "Middle Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.middleName");
			}
			else if ("${field}" == "Okta ID") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.oktaId");
			}
			else if ("${field}" == "UUID") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.uuid");
			}
			else {
				fail("No such contact field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

