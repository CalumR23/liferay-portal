	@prose = "I should be able to view an audit entry for an action ${action} to the contact with the email address ${contactEmailAddress} field ${field} from the old value ${oldValue} to the new value ${newValue} regarding ${description} executed by ${agentName}"
	macro _viewContactAuditEntryRegardingAdditionalEntities {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/audit-entries?pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		if ((!("${oldValue}" == "")) && (!("${newValue}" == ""))) {
			var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].action");
		}
		else if (!("${newValue}" == "")) {
			var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.newValue=='${newValue}')].action");
		}
		else {
			var actionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}')].action");
		}

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "[", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "]", "");

		var actionFromAPI = StringUtil.replace("${actionFromAPI}", "&quot;", "");

		echo("Expected Action Value: ${action}");
		echo("Actual Action Value: ${actionFromAPI}");

		if (!("${action}" == "${actionFromAPI}")) {
			fail("Actual action value ${actionFromAPI} does not match expected action value ${action}");
		}

		if ((!("${oldValue}" == "")) && (!("${newValue}" == ""))) {
			var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}' && @.newValue=='${newValue}')].description");
		}
		else if (!("${newValue}" == "")) {
			var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.newValue=='${newValue}')].description");
		}
		else {
			var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.action=='${action}' && @.field=='${field}' && @.description=='${description}' && @.oldValue=='${oldValue}')].description");
		}

		var descriptionFromAPI = StringUtil.replace("${descriptionFromAPI}", "[", "");

		var descriptionFromAPI = StringUtil.replace("${descriptionFromAPI}", "]", "");

