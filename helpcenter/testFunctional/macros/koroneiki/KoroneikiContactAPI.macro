	@prose = "I create a nested field for the contact with the email address ${contactEmailAddress}"
	macro _createContactNestedField {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contact = JSONCurlUtil.get("${curl}"); 

		var emailAddress = JSONCurlUtil.get("${curl}", "$.emailAddress");

		var emailAddressVerified = JSONCurlUtil.get("${curl}", "$.emailAddressVerified");

		var firstName = JSONCurlUtil.get("${curl}", "$.firstName");

		var languageId = JSONCurlUtil.get("${curl}", "$.languageId");

		var lastName = JSONCurlUtil.get("${curl}", "$.lastName");

		if (contains("${contact}", "middleName")) {
			var middleName = JSONCurlUtil.get("${curl}", "$.middleName");
		}
		else {
			var middleName = "";
		}

		if (contains("${contact}", "oktaId")) {
			var oktaId = JSONCurlUtil.get("${curl}", "$.oktaId");
		}
		else {
			var oktaId = "";
		}

		var uuid = JSONCurlUtil.get("${curl}", "$.uuid");

		static var staticContactsNestedField = "{&quot;emailAddress&quot;:&quot;${emailAddress}&quot;,&quot;emailAddressVerified&quot;:${emailAddressVerified},&quot;firstName&quot;:&quot;${firstName}&quot;,&quot;languageId&quot;:&quot;${languageId}&quot;,&quot;lastName&quot;:&quot;${lastName}&quot;,&quot;middleName&quot;:&quot;${middleName}&quot;,&quot;oktaId&quot;:&quot;${oktaId}&quot;,&quot;uuid&quot;:&quot;${uuid}&quot;}";

		return "${staticContactsNestedField}";
	}

	@prose = "I create a nested field for the customer contact with the email address ${contactEmailAddress}"
	macro _createCustomerContactNestedField {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-email-address/${contactEmailAddress}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contact = JSONCurlUtil.get("${curl}"); 

		var emailAddress = JSONCurlUtil.get("${curl}", "$.emailAddress");

		var emailAddressVerified = JSONCurlUtil.get("${curl}", "$.emailAddressVerified");

		var firstName = JSONCurlUtil.get("${curl}", "$.firstName");

		var languageId = JSONCurlUtil.get("${curl}", "$.languageId");

		var lastName = JSONCurlUtil.get("${curl}", "$.lastName");

		if (contains("${contact}", "middleName")) {
			var middleName = JSONCurlUtil.get("${curl}", "$.middleName");
		}
		else {
			var middleName = "";
		}

		if (contains("${contact}", "oktaId")) {
