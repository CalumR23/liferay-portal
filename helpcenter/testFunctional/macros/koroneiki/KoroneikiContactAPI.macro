	@prose = "I synchronize the contact entitlement definition with the name ${entitlementDefinitionName}"
	macro _synchronizeContactEntitlementDefinition {
		var entitlementDefinitionKey = KoroneikiContactAPI._getContactEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}/synchronize
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-H "Content-Length: 0"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I synchronize the contact entitlement definition with the name ${entitlementDefinitionName} executed by ${agentName}"
	macro _synchronizeContactEntitlementDefinitionExecutedByAgent {
		var entitlementDefinitionKey = KoroneikiContactAPI._getContactEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}/synchronize?agentName=${agentName}\&agentUID=koroneikiagent
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			-H "Content-Length: 0"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I tear down the contact entitlement definitions on koroneiki with the following name values ${table}"
	macro _tearDownContactEntitlementDefinitions {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entitlementDefinitionName = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/entitlement-definitions
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allContactEntitlementDefinitions = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allContactEntitlementDefinitions}", "${entitlementDefinitionName}")) {
				KoroneikiContactAPI._deleteContactEntitlementDefinition(entitlementDefinitionName = "${entitlementDefinitionName}");

				echo("Name of entitlement definition deleted: ${entitlementDefinitionName}");
			}
		}
	}

	@prose = "I tear down the external links for the contact with the email address ${contactEmailAddress} on koroneiki with the following entity id values ${table}"
	macro _tearDownContactExternalLinks {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entityId = "${row[0]}";

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts?search=${contactEmailAddress}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allContacts = JSONCurlUtil.get("${curl}", "$");

			if (contains("${allContacts}", "${contactEmailAddress}")) {
				var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

				var curl = '''
					--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts/by-uuid/${contactUuid}/external-links
					--header "API_Token: ${apiToken}"
					-H "accept: application/json"
					-H "Content-Type: application/json"
					''';

				var allContactExternalLinks = JSONCurlUtil.get("${curl}", "$");

				if (contains("${allContactExternalLinks}", "${entityId}")) {
					KoroneikiContactAPI._deleteContactExternalLink(
						contactEmailAddress = "${contactEmailAddress}",
						entityId = "${entityId}");

					echo("Entity ID of external link contact with email address ${contactEmailAddress} deleted: ${entityId}");
				}
			}
		}
	}

	@prose = "I tear down the permissions for a koroneiki contact with the email address ${contactEmailAddress} set for a non permissioned user"
