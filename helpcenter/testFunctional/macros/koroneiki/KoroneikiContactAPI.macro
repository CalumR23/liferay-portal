	@prose = "I delete a contact entitlement definition with the name ${entitlementDefinitionName}"
	macro _deleteContactEntitlementDefinition {
		var entitlementDefinitionKey = KoroneikiContactAPI._getContactEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I delete a contact entitlement definition with the name ${entitlementDefinitionName} executed by ${agentName}"
	macro _deleteContactEntitlementDefinitionExecutedByAgent {
		var entitlementDefinitionKey = KoroneikiContactAPI._getContactEntitlementDefinitionKey(entitlementDefinitionName = "${entitlementDefinitionName}");

		var agentName = StringUtil.replace("${agentName}", " ", "%20");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/entitlement-definitions/${entitlementDefinitionKey}?agentName=${agentName}\&agentUID=koroneikiagent
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

