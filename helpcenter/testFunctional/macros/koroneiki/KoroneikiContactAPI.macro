definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiAdminEmail = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I create a contact on koroneiki with the following values ${table}"
	macro _createContact {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Agent Name") {
				var value = StringUtil.replace("${value}", " ", "%20");

				var agentName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var emailAddress = "${value}";
			}
			else if ("${field}" == "Email Address Verified") {
				var emailAddressVerified = "${value}";
			}
			else if ("${field}" == "First Name") {
				var firstName = "${value}";
			}
			else if ("${field}" == "Language") {
				var languageId = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var lastName = "${value}";
			}
			else if ("${field}" == "Middle Name") {
				var middleName = "${value}";
			}
			else if ("${field}" == "Okta ID") {
				var oktaId = "${value}";
			}
			else if ("${field}" == "UUID") {
				var uuid = "${value}";
			}
			else {
				fail("No such contact field ${field}");
			}
		}

		if (!(isSet(agentName))) {
			var agentName = "";
		}
		if (!(isSet(emailAddress))) {
			var emailAddress = "";
		}
		if (!(isSet(emailAddressVerified))) {
			var emailAddressVerified = "false";
		}
		if (!(isSet(firstName))) {
			var firstName = "";
		}
		if (!(isSet(languageId))) {
			var languageId = "";
		}
		if (!(isSet(lastName))) {
			var lastName = "";
		}
		if (!(isSet(middleName))) {
			var middleName = "";
		}
		if (!(isSet(oktaId))) {
			var oktaId = "";
		}
		if (!(isSet(uuid))) {
			var uuid = "";
		}

		if ("${agentName}" == "") {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"emailAddress": "${emailAddress}",
					"emailAddressVerified": ${emailAddressVerified},
					"firstName": "${firstName}",
					"languageId": "${languageId}",
					"lastName": "${lastName}",
					"middleName": "${middleName}",
					"oktaId": "${oktaId}",
					"uuid": "${uuid}"
				}
				''';
		}
		else {
			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/contacts?agentName=${agentName}\&agentUID=koroneikiagent
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-d
				{
					"emailAddress": "${emailAddress}",
					"emailAddressVerified": ${emailAddressVerified},
					"firstName": "${firstName}",
					"languageId": "${languageId}",
					"lastName": "${lastName}",
					"middleName": "${middleName}",
					"oktaId": "${oktaId}",
					"uuid": "${uuid}"
				}
				''';
		}

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

