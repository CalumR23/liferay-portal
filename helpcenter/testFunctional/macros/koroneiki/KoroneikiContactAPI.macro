	@prose = "the account with the name ${accountName} should be assigned the contact with the email address ${contactEmailAddress} without the worker contact role ${contactRoleName}"
	macro _viewNoAccountWorkerContactRoleViaUuid {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

