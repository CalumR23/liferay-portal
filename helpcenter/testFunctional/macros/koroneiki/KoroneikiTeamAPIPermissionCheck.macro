	@prose = "the contact with the email address ${contactEmailAddress} assigned the team ${teamName} should be visible to a permissioned user"
	macro _viewContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactEmailAddressFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.emailAddress=='${contactEmailAddress}')].emailAddress");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "[", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "]", "");

		var contactEmailAddressFromAPI = StringUtil.replace("${contactEmailAddressFromAPI}", "&quot;", "");

		echo("Expected contact email address value: ${contactEmailAddress}");
		echo("Actual contact email address value: ${contactEmailAddressFromAPI}");

		if (!("${contactEmailAddressFromAPI}" == "${contactEmailAddress}")) {
			fail("Actual contact email address value ${contactEmailAddressFromAPI} does not match expected contact email address value ${contactEmailAddress}");
		}
	}

	@prose = "the contact with the email address ${contactEmailAddress} assigned the team ${teamName} with the contact role ${contactRoleName} should be visible to a permissioned user"
	macro _viewContactRole {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var contactRoleNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${contactRoleName}')].name");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "[", "");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "]", "");

		var contactRoleNameFromAPI = StringUtil.replace("${contactRoleNameFromAPI}", "&quot;", "");

		echo("Expected contact role name value: ${contactRoleName}");
		echo("Actual contact role name value: ${contactRoleNameFromAPI}");

		if (!("${contactRoleNameFromAPI}" == "${contactRoleName}")) {
			fail("Actual contact role name value ${contactRoleNameFromAPI} does not match expected contact role name value ${contactRoleName}");
		}
	}

	@prose = "the contact with the email address ${contactEmailAddress} should not be visible on the team ${teamName} for a non permissioned user"
	macro _viewNoContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountContacts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountContacts}", "${contactEmailAddress}")) {
			fail("The account with the name ${accountName} contact ${contactEmailAddress} is visible to a non permissioned user");
		}
	}

	@prose = "the contact with the email address ${contactEmailAddress} assigned the team ${teamName} should not have the contact role ${contactRoleName} visible to a non permissioned user"
	macro _viewNoContactRole {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccountContactContactRoles = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allAccountContactContactRoles}", "${contactRoleName}")) {
			fail("The contact with the email address ${contactEmailAddress} on the account with the name ${accountName} has their contact role ${contactRoleName} visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view a koroneiki team with the name ${teamName} as a non permissioned user"
	macro _viewNoTeam {
		if (contains("${teamName}", " ")) {
			var keyword = StringUtil.extractFirst("${teamName}", " ");
		}
		else {
			var keyword = "${teamName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeams = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeams}", "${teamName}")) {
			fail("The team with the name ${teamName} is visible to a non permissioned user");
		}

		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var team = JSONCurlUtil.get("${curl}", "$");

		if (contains("${team}", "${teamName}")) {
			fail("The team with the name ${teamName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view an assigned account with the name ${accountName} for the team ${teamName} as a non permissioned user"
	macro _viewNoTeamAssignedAccount {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/assigned-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamAccounts = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamAccounts}", "${accountName}")) {
			fail("The assigned account with the name ${accountName} for the team ${teamName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view an audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} as a non permissioned user"
	macro _viewNoTeamAuditEntry {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/audit-entries
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamAuditEntries = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${teamAuditEntries}", "${fieldName}")) || (contains("${teamAuditEntries}", "${oldValue}")) || (contains("${teamAuditEntries}", "${newValue}"))) {
			fail("The team audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}

		var auditEntryKey = KoroneikiTeamAPI._getTeamAuditEntryKey(
			fieldName = "${fieldName}",
			newValue = "${newValue}",
			oldValue = "${oldValue}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/audit-entries/${auditEntryKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamAuditEntry = JSONCurlUtil.get("${curl}", "$");

		if ((contains("${teamAuditEntry}", "${fieldName}")) || (contains("${teamAuditEntry}", "${oldValue}")) || (contains("${teamAuditEntry}", "${newValue}"))) {
			fail("The team audit entry for a change to the team ${teamName} field ${fieldName} from the old value ${oldValue} to the new value ${newValue} is visible to a non permissioned user");
		}
	}

	@prose = "the external link with the entity id ${entityId} on the team ${teamName} should not be visible to a non permissioned user"
	macro _viewNoTeamExternalLink {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/external-links
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allTeamExternalLinks = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allTeamExternalLinks}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the team ${teamName} is visible to a non permissioned user");
		}

		var externalLinkKey = KoroneikiTeamAPI._getTeamExternalLinkKey(
			entityId = "${entityId}",
			teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/external-links/${externalLinkKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamExternalLink = JSONCurlUtil.get("${curl}", "$");

		if (contains("${teamExternalLink}", "${entityId}")) {
			fail("The external link with the entity id ${entityId} on the team ${teamName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view a koroneiki team with the name ${teamName} using the external link domain ${domain} and entity name ${entityName} and entity id ${entityId} as a non permissioned user"
	macro _viewNoTeamViaExternalLink {
		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/by-external-link/${domain}/${entityName}/${entityId}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var team = JSONCurlUtil.get("${curl}", "$");

		if (contains("${team}", "${teamName}")) {
			fail("The team with the name ${teamName} is visible to a non permissioned user");
		}
	}

	@prose = "I should be able to view a koroneiki team with the name ${teamName} as a permissioned user"
	macro _viewTeam {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var teamNameFromAPI = JSONCurlUtil.get("${curl}", "$.name");

		echo("Expected Name Value: ${teamName}");
		echo("Actual Name Value: ${teamNameFromAPI}");

		if (!(contains("${teamName}", "${teamNameFromAPI}"))) {
			fail("Actual team name value ${teamNameFromAPI} does not match expected team name value ${teamName}");
		}
	}

	@prose = "I should be able to view an assigned account with the name ${accountName} for the team ${teamName} and the following values as a permissioned user ${table}"
	macro _viewTeamAssignedAccount {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/assigned-accounts
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Code") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].code");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Contact Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].contactEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Description") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].description");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Fax Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].faxNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Phone Number") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].phoneNumber");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Profile Email Address") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].profileEmailAddress");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Region") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].region");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Status") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].status");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Tier") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].tier");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "Website") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${accountName}')].website");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("No such account field ${field}");
			}

			echo("Expected ${field} Value: ${value}");
			echo("Actual ${field} Value: ${valueFromAPI}");

			if (!(contains("${value}", "${valueFromAPI}"))) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}
}