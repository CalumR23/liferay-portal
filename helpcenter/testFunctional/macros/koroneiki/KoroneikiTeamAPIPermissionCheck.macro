definition {
	var apiToken = PropsUtil.get("koroneiki.non.permission.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var roleName = PropsUtil.get("koroneiki.non.permission.role.name");

	@prose = "I attempt to assign the contact with the email address ${contactEmailAddress} on the team ${teamName} to the following roles as a non permissioned user ${table}"
	macro _assignContactRolesToContactAttempt {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles?contactRoleKeys=${contactRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the contact with the email address ${contactEmailAddress} on the team ${teamName} to the following roles as a permissioned user ${table}"
	macro _assignContactRolesToContact {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleKey = KoroneikiContactRoleAPI._getContactRoleKeyViaContactRoleName(contactRoleName = "${contactRoleName}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid/${contactUuid}/roles?contactRoleKeys=${contactRoleKey}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I attempt to assign contacts with the following email addresses to the team ${teamName} as a non permissioned user ${table}"
	macro _assignContactsAttempt {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactEmailAddress = "${row[0]}";

			var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid?contactUuids=${contactUuid}
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign contacts with the following email addresses to the team ${teamName} as a permissioned user ${table}"
	macro _assignContacts {
		var teamKey = KoroneikiTeamAPI._getTeamKeyViaTeamName(teamName = "${teamName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactEmailAddress = "${row[0]}";

			var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/teams/${teamKey}/contacts/by-uuid?contactUuids=${contactUuid}
				--header "API_Token: ${apiToken}"
