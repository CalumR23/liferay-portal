definition {

	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");

	@prose = "I populate and save the entity form with the following values ${table}"
	macro populateAddAddressFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";
			var key_field = "${field}";

			if ("${type}" == "Input") {
				Type(
					locator1 = "KoroneikiEntityForm#INPUT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "KoroneikiEntityForm#SELECT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Checkbox") {
				if ("${value}" == "true") {
					Check(locator1 = "KoroneikiEntityForm#CHECKBOX");
				}
				else {
					Uncheck(locator1 = "KoroneikiEntityForm#CHECKBOX");
				}
			}
			else {
				fail("No such entity field type ${type}. Please use Input, Select, or Checkbox.");
			}
		}

		Click(locator1 = "KoroneikiEntityForm#SAVE_BUTTON");

		Message.success();
	}

}