definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I download a Self Provisioning license with the following options ${table}"
	macro downloadSelfProvisioningLicense {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Project") {
				Select(
					locator1 = "SelfProvisioning#PROJECT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "SelfProvisioning#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				Select(
					locator1 = "SelfProvisioning#VERSION_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such self provisioning field ${field}");
			}
		}

		Click(locator1 = "SelfProvisioning#DOWNLOAD_BUTTON");
		
		DownloadTempFile();
	}

	@prose = "I go to the Self Provisioning page"
	macro gotoSelfProvisioningPage {
		Open(locator1 = "${supportURL}/activation-key");
	}

	@prose = "I should be able to view the following options in the Self Provisioning portlet ${table}"
	macro viewSelfProvisioningOptions {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Project") {
				Select(
					locator1 = "SelfProvisioning#PROJECT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "SelfProvisioning#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				Select(
					locator1 = "SelfProvisioning#VERSION_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such self provisioning field ${field}");
			}
		}

		AssertVisible(locator1 = "SelfProvisioning#DOWNLOAD_BUTTON");
	}
}