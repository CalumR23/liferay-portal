definition {
	@prose = "I accept the GitHub repository invitation for ${gitHubRepositoryName} using the username ${userGitHubUsername} and the password ${userPassword}"
	macro acceptAndViewGitHubInvitation {
		var gitHubInvitationUrl = selenium.getAttribute("//a[contains(.,'View Invitation')]@href");

		Open(locator1 = "${gitHubInvitationUrl}");

		if (IsElementPresent(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK")) {
			Click(locator1 = "GitHub#GITHUB_SIGN_IN_PAGE_LINK");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_USERNAME_FIELD",
				value1 = "${userGitHubUsername}");

			Type(
				locator1 = "GitHub#GITHUB_SIGN_IN_PASSWORD_FIELD",
				value1 = "${userPassword}");

			Click(locator1 = "GitHub#GITHUB_SIGN_IN_BUTTON");
		}

		Click(locator1 = "GitHub#GITHUB_ACCEPT_INVITATION_BUTTON");

		var key_gitHubRepositoryName = "${gitHubRepositoryName}";
	}
}