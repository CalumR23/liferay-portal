definition {

    @prose = "I get all site URLs"
	macro getLinks {
        static var oktaURL = PropsUtil.get("okta.liferay.login.dev.url");
        static var rabbitmqURL = PropsUtil.get("rabbitmq.url");
        static var customerURL = PropsUtil.get("customer.portal.url");
        static var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
        static var provisioningURL = PropsUtil.get("provisioning.liferay.url");
        static var zendeskURL = PropsUtil.get("zendesk.liferay.url");
        static var issuesZenURL = PropsUtil.get("issues.zendesk.liferay.url");

		return "${oktaURL}";

		return "${rabbitmqURL}";

		return "${customerURL}";

		return "${koroneikiURL}";

		return "${provisioningURL}";

		return "${zendeskURL}";

		return "${issuesZenURL}";

	}


    @prose = "I should be able to view the ${pageLink} page"
    macro viewSitePageLink {
        var curl = "${pageLink} -I";

        var httpResponseStatusCode = JSONCurlUtil.get("${curl}");

        if (contains("${httpResponseStatusCode}", "HTTP/2 200")) {
            echo("The ${pageLink} page is working properly.");
        }
        else {
            echo("The ${pageLink} page is not working properly.");
        }
    }

}