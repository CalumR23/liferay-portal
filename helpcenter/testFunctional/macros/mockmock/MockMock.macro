definition {
	macro backtoInbox {
		AssertClick.assertPartialTextClickAt(
			locator1 = "MockMock#MOCKMOCK_HOME_LINK",
			value1 = "Home"
		);
	}

	@prose = "I delete the support email message in MockMock where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}"
	macro deleteMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";
		var key_recipientEmailAddress = "${recipientEmailAddress}";

		Open(locator1 = "http://cloud-10-50-0-101:8282");

		if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
			AssertClick(
				locator1 = "MockMock#MOCKMOCK_DELETE_LINK",
				value1 = "Delete"
			);

			AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");
		}
		else {
			Open(locator1 = "http://cloud-10-50-0-241:8282");

			if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
				AssertClick(
					locator1 = "MockMock#MOCKMOCK_DELETE_LINK",
					value1 = "Delete"
				);

				AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");
			}
			else {
				fail("After checking all 2 customer support email Mock Mock servers, the message appears to not be available for deletion");
			}
		}
	}

	macro deleteAllMail {
		AssertClick(
			locator1 = "MockMock#MOCKMOCK_DELETE_ALL_LINK",
			value1 = "Delete all"
		);

		MockMock.viewNoMailCount();
	}

	macro gotoMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";
		var key_recipientEmailAddress = "${recipientEmailAddress}";

		AssertClick.assertPartialTextClickAt(
			locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK",
			value1 = "${mockMockAsset}"
		);
	}

	macro gotoMockMock {
		var mockUrl = PropsUtil.get("portal.mock.url");

		Pause(locator1 = "5000");

		Open(locator1 = "${mockUrl}");

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_HEADER_LINK",
			value1 = "MockMock"
		);
	}

	@prose = "I go the support email message in MockMock where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}"
	macro gotoSupportMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";
		var key_recipientEmailAddress = "${recipientEmailAddress}";

		Open(locator1 = "http://cloud-10-50-0-101:8282");

		if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
			AssertClick.assertPartialTextClickAt(
				locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK",
				value1 = "${mockMockAsset}"
			);
		}
		else {
			Open(locator1 = "http://cloud-10-50-0-241:8282");

			if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
				AssertClick.assertPartialTextClickAt(
					locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK",
					value1 = "${mockMockAsset}"
				);
			}
			else {
				fail("After checking all 2 customer support email Mock Mock servers, the message appears to have not been sent");
			}
		}
	}

	@prose = "I tear down the support email message in MockMock where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}"
	macro tearDownMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";
		var key_recipientEmailAddress = "${recipientEmailAddress}";

		Open(locator1 = "http://cloud-10-50-0-101:8282");

		if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
			AssertClick(
				locator1 = "MockMock#MOCKMOCK_DELETE_LINK",
				value1 = "Delete"
			);

			echo("Tearing down message where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}");

			AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");
		}
		else {
			Open(locator1 = "http://cloud-10-50-0-241:8282");

			if (IsElementPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK")) {
				AssertClick(
					locator1 = "MockMock#MOCKMOCK_DELETE_LINK",
					value1 = "Delete"
				);

				echo("Tearing down message where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}");

				AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");
			}
			else {
				echo("After checking all 2 customer support email Mock Mock servers, the message where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset} appears to not be available for deletion in this test case");
			}
		}
	}

	macro viewAndClickMail {
		MockMock.viewMailFromInbox(
			mockMockAsset = "${mockMockAsset}",
			mockMockRecipient = "${mockMockRecipient}",
			mockMockSender = "${mockMockSender}"
		);

		MockMock.gotoMailMessage(
			mockMockAsset = "${mockMockAsset}",
			mockMockRecipient = "${mockMockRecipient}",
			mockMockSender = "${mockMockSender}"
		);
	}

	macro viewDuplicateMailFromInbox {
		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE",
			value1 = "You have"
		);

		for (var mockMockRecipient : list "${mockMockRecipientList}") {
			var key_columnEntry1 = "${mockMockAsset}";
			var key_columnEntry2 = "${mockMockRecipient}";
			var key_columnEntry3 = "${mockMockSender}";

			AssertTextEquals.assertPartialText(
				locator1 = "MockMock#MOCKMOCK_FROM_FIELD",
				value1 = "${mockMockSender}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "MockMock#MOCKMOCK_TO_FIELD",
				value1 = "${mockMockRecipient}"
			);

			AssertTextEquals.assertPartialText(
				locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD",
				value1 = "${mockMockAsset}"
			);
		}
	}

	macro viewMailCount {
		var key_emailCount = "${emailCount}";

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_EMAIL_COUNT_MESSAGE",
			value1 = "You have ${emailCount}"
		);
	}

	macro viewMailFromInbox {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE",
			value1 = "You have"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_FROM_FIELD",
			value1 = "${mockMockSender}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_TO_FIELD",
			value1 = "${mockMockRecipient}"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD",
			value1 = "${mockMockAsset}"
		);
	}

	@prose = "I should be able to view the email message containing the following text ${table}"
	macro viewMailMessage {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var text = "${row[0]}";

			var key_asset = "${text}";

			AssertElementPresent(locator1 = "MockMock#MOCKMOCK_MESSAGE_BODY");
		}
	}

	macro viewNoMailCount {
		AssertTextEquals.assertPartialText(
			locator1 = "MockMock#MOCKMOCK_NO_EMAILS_MESSAGE",
			value1 = "No emails in queue"
		);
	}

	@prose = "I should not be able to view a support email message in MockMock where the sender is ${mockMockSender} the recipient is ${mockMockRecipient} with the email address ${recipientEmailAddress} and the message content contains the text ${mockMockAsset}"
	macro viewNoSupportMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";
		var key_recipientEmailAddress = "${recipientEmailAddress}";

		Open(locator1 = "http://cloud-10-50-0-101:8282");

		AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");

		Open(locator1 = "http://cloud-10-50-0-241:8282");

		AssertElementNotPresent(locator1 = "MockMock#MOCKMOCK_SUBJECT_FIELD_LINK");
	}
}