definition {

	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I approve the Workflow asset titled ${assetTitle}"
	macro approveWorkflowAsset {
		Click(locator1 = "MyWorkflowTasksAsset#DROPDOWN_TOGGLE");

		Click(locator1 = "MyWorkflowTasksAsset#APPROVE_LINK");

		Type(
			locator1 = "MyWorkflowTasksAssetCommentAdd#COMMENT_FIELD",
			value1 = "Approving ${assetTitle}");

		Click(locator1 = "MyWorkflowTasksAssetCommentAdd#DONE_BUTTON");

		Message.success();
	}

	@prose = "I assign the Workflow asset titled ${assetTitle} to myself"
	macro assignWorkflowAssetToMe {
		Click(locator1 = "MyWorkflowTasksAsset#DROPDOWN_TOGGLE");

		Click(locator1 = "MyWorkflowTasksAsset#ASSIGN_TO_ME_LINK");

		SelectFrame(locator1 = "MyWorkflowTasksAssetCommentAdd#WORKFLOW_COMMENT_IFRAME");

		Type(
			locator1 = "MyWorkflowTasksAssetCommentAdd#COMMENT_FIELD",
			value1 = "Assigning ${assetTitle} to myself");

		Click(locator1 = "MyWorkflowTasksAssetCommentAdd#DONE_BUTTON");

		SelectFrameTop();

		Message.success();
	}

	@prose = "I go to My Workflow Tasks"
	macro gotoMyWorkFlowTasks {
		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=com_liferay_portal_workflow_task_web_portlet_MyWorkflowTaskPortlet&p_p_lifecycle=0&p_p_state=maximized");
	}

	@prose = "I go to the Other Assignees tab"
	macro gotoOtherAssignees {
		Click(locator1 = "MyWorkflowTasks#OTHER_ASSIGNEES_TAB");
	}

	@prose = "I search for and go to the Workflow Asset titled ${assetTitle} using the following parameters ${table}"
	macro gotoWorkflowAsset {
		if (IsElementNotPresent(locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_TOGGLE_EXPANDED")) {
			Click(locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_TOGGLE");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Match") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_MATCH_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Code") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_PROJECT_CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Name") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_PROJECT_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Assignee Type") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_ASSIGNEE_TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Role Name") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_ROLE_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "User Email Address") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_USER_EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Completed") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_COMPLETED_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Opportunity Type") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_OPPORTUNITY_TYPE_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such workflow search field ${field}");
			}
		}

		Click(locator1 = "MyWorkflowTasks#SEARCH_BUTTON");

		var key_assetTitle = "${assetTitle}";

		Click(locator1 = "MyWorkflowTasks#ASSET_TITLE");
	}

	@prose = "I reject the Workflow asset titled ${assetTitle}"
	macro rejectWorkflowAsset {
		Click(locator1 = "MyWorkflowTasksAsset#DROPDOWN_TOGGLE");

		Click(locator1 = "MyWorkflowTasksAsset#REJECT_LINK");

		Type(
			locator1 = "MyWorkflowTasksAssetCommentAdd#COMMENT_FIELD",
			value1 = "Rejecting ${assetTitle}");

		Click(locator1 = "MyWorkflowTasksAssetCommentAdd#DONE_BUTTON");

		Message.success();
	}

	@prose = "I should not be able to search for and go to a Workflow Asset titled ${assetTitle} using the following parameters ${table}"
	macro viewNoWorkflowAsset {
		if (IsElementNotPresent(locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_TOGGLE_EXPANDED")) {
			Click(locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_TOGGLE");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Match") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_MATCH_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Code") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_PROJECT_CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Name") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_PROJECT_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Assignee Type") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_ASSIGNEE_TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Role Name") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_ROLE_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "User Email Address") {
				Type(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_USER_EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Completed") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_COMPLETED_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Opportunity Type") {
				Select(
					locator1 = "MyWorkflowTasks#ADVANCED_SEARCH_OPPORTUNITY_TYPE_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such workflow search field ${field}");
			}
		}

		Click(locator1 = "MyWorkflowTasks#SEARCH_BUTTON");

		var key_assetTitle = "${assetTitle}";

		AssertElementNotPresent(locator1 = "MyWorkflowTasks#ASSET_TITLE");
	}

	@prose = "I should not be able to view the offering details with the product ${product}"
	macro viewNoWorkflowAssetOffering {
		var key_product = "${product}";

		AssertElementNotPresent(
			locator1 = "MyWorkflowTasksAsset#OFFERING_PRODUCT",
			value1 = "${value}");
	}

	@prose = "I should be able to view the following project differences with the following values ${table}"
	macro viewWorkflowAssetDifference {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var oldValue = "${row[1]}";
			var newValue = "${row[2]}";
			var key_projectDifferenceField = "${field}";

			AssertTextEquals(
				locator1 = "MyWorkflowTasksAsset#PROJECT_DIFFERENCE_FIELD",
				value1 = "${field}");

			AssertTextEquals.assertPartialText(
				locator1 = "MyWorkflowTasksAsset#PROJECT_DIFFERENCE_OLD_VALUE",
				value1 = "${oldValue}");

			AssertTextEquals.assertPartialText(
				locator1 = "MyWorkflowTasksAsset#PROJECT_DIFFERENCE_NEW_VALUE",
				value1 = "${newValue}");
		}
	}

	@prose = "the workflow asset header should have the value ${opportunityType}"
	macro viewWorkflowAssetHeader {
		AssertTextEquals.assertPartialText(
			locator1 = "MyWorkflowTasksAsset#WORKFLOW_TASK_HEADER",
			value1 = "${opportunityType}");
	}

	@prose = "I should be able to view the offering details with the product ${product} with the following values ${table}"
	macro viewWorkflowAssetOffering {
		var key_product = "${product}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Licenses") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_LICENSES",
					value1 = "${value}");
			}
			else if ("${field}" == "License Lifetime") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_LICENSE_LIFETIME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Tickets") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_SUPPORT_TICKETS",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Lifetime") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_SUPPORT_LIFETIME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support End Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_SUPPORT_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Sizing") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_SIZING",
					value1 = "${value}");
			}
			else if ("${field}" == "Quantity") {
				AssertTextEquals.assertPartialText(
					locator1 = "MyWorkflowTasksAsset#OFFERING_QUANTITY",
					value1 = "${value}");
			}
			else {
				fail("No such workflow asset offering field ${field}");
			}
		}
	}

	@prose = "I should be able to view the project summary with the following values ${table}"
	macro viewWorkflowAssetProjectAndOrderSummary {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Opportunity Stage") {
				AssertTextPresent(value1 = "Opportunity Stage: ${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextPresent(value1 = "Code: ${value}");
			}
			else if ("${field}" == "Industry") {
				AssertTextPresent(value1 = "Industry: ${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextPresent(value1 = "Partner ${value}");
			}
			else if ("${field}" == "Partner First Line Support") {
				AssertTextPresent(value1 = "Partner First Line Support: ${value}");
			}
			else if ("${field}" == "Support Regions") {
				AssertTextPresent(value1 = "Support Regions: ${value}");
			}
			else if ("${field}" == "Support Languages") {
				AssertTextPresent(value1 = "Support Languages: ${value}");
			}
			else if ("${field}" == "Missing User") {
				AssertTextPresent(value1 = "Missing Users");

				AssertTextPresent(value1 = "${value}");
			}
			else if ("${field}" == "New User") {
				AssertTextPresent(value1 = "New Users");

				AssertTextPresent(value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				AssertTextPresent(value1 = "Start Date: ${value}");
			}
			else {
				fail("No such project summary field ${field}");
			}
		}
	}

	@prose = "the workflow asset title should have the value ${projectName}"
	macro viewWorkflowAssetTitle {
		AssertTextEquals.assertPartialText(
			locator1 = "MyWorkflowTasksAsset#WORKFLOW_TASK_TITLE",
			value1 = "${projectName}");
	}

	@prose = "the workflow asset should have the warning message ${warningMessage}"
	macro viewWorkflowAssetWarningMessage {
		var key_warningMessage = "${warningMessage}";

		AssertTextEquals.assertPartialText(
			locator1 = "MyWorkflowTasksAsset#WARNING_MESSAGE",
			value1 = "${warningMessage}");
	}

}