definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I click on the Generate New License button"
	macro clickGenerateNewLicenseButton {
		Click(locator1 = "LicenseManagement#GENERATE_NEW_LICENSE_BUTTON");
	}

	@prose = "I generate a new license with the following values ${table}"
	macro generateNewLicense {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";
			var positionValue = "${row[2]}";

			OSBAdmin.pause(timeInSeconds = "3");

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";
			}

			if ("${field}" == "Account") {
				Click(locator1 = "LicenseManagementGenerateNewLicenseForm#ACCOUNT_SELECT");

				SelectWindow(locator1 = "title=License - License");

				if (IsElementPresent(locator1 = "LicenseManagementGenerateNewLicenseFormAccountSearch#ADVANCED_SEARCH_COLLAPSE")) {
					Click(locator1 = "LicenseManagementGenerateNewLicenseFormAccountSearch#ADVANCED_SEARCH_COLLAPSE");
				}

				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "LicenseManagementGenerateNewLicenseFormAccountSearch#SEARCH_FIELD",
					value1 = "${keyword}");

				KeyPress(
					locator1 = "LicenseManagementGenerateNewLicenseFormAccountSearch#SEARCH_FIELD",
					value1 = "\RETURN");

				var key_name = "${value}";

				Click(locator1 = "LicenseManagementGenerateNewLicenseFormAccountSearch#SEARCH_RESULT_ACCOUNT");		

				SelectWindow(locator1 = "null");

				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagementGenerateNewLicenseForm#ACCOUNT_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "LicenseManagementGenerateNewLicenseForm#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Choose Liferay Version") {
				Select(
					locator1 = "LicenseManagementGenerateNewLicenseForm#CHOOSE_LIFERAY_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "LicenseManagementGenerateNewLicenseForm#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Choose Purchase") {
				var key_productPurchaseId = "${value}";

				Click(locator1 = "LicenseManagementGenerateNewLicenseForm#CHOOSE_PRODUCT_PURCHASE_BUTTON");
			}
			else if ("${field}" == "Host Name") {
				Type(
					locator1 = "LicenseManagementGenerateNewLicenseForm#HOST_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "IP Addresses") {
				Type(
					locator1 = "LicenseManagementGenerateNewLicenseForm#IP_ADDRESSES_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "MAC Addresses") {
				Type(
					locator1 = "LicenseManagementGenerateNewLicenseForm#MAC_ADDRESSES_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Add Row") {
				Click(
					locator1 = "LicenseManagementGenerateNewLicenseForm#ADD_ROW_BUTTON",
					value1 = "${value}");
			}
			else if ("${field}" == "Delete Row") {
				Click(
					locator1 = "LicenseManagementGenerateNewLicenseForm#DELETE_ROW_BUTTON",
					value1 = "${value}");
			}
			else if ("${field}" == "Complimentary") {
				if ("${value}" == "true") {
					Check(locator1 = "LicenseManagementGenerateNewLicenseForm#COMPLIMENTARY_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "LicenseManagementGenerateNewLicenseForm#COMPLIMENTARY_CHECKBOX");					
				}
			}
			else {
				fail("No such license management form field ${field}");
			}
		}

		Click(locator1 = "LicenseManagementGenerateNewLicenseForm#GENERATE_BUTTON");
	}

	@prose = "I go to the License Management page"
	macro gotoLicenseManagementPage {
		Open(locator1 = "${supportURL}/group/license");
	}

	@prose = "I search the License Management page with the keyword ${keyword}"
	macro search {
		if (IsElementPresent(locator1 = "LicenseManagement#SEARCH_FIELD_DISABLED")) {
			Click(locator1 = "LicenseManagement#ADVANCED_SEARCH_TOGGLE_BUTTON");
		}

		Type(
			locator1 = "LicenseManagement#SEARCH_FIELD",
			value1 = "${keyword}");

		Click(locator1 = "LicenseManagement#SEARCH_SUBMIT_BUTTON");
	}

	@prose = "I should be able to view the license with the name ${licenseName} following values ${table}"
	macro viewLicense {
		var key_licenseName = "${licenseName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Project") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_PROJECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_NAME_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_NAME_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_START_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "LicenseManagement#LICENSE_EXPIRATION_DATE",
					value1 = "${value}");
			}
			else {
				fail("No such license field ${field}");
			}
		}
	}
}