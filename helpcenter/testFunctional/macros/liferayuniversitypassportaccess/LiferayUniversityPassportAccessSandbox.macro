definition {
	var supportURL = PropsUtil.get("support.liferay.sandbox.url");

	@prose = "I go to the Liferay University Passport Access page on the sandbox"
	macro gotoLiferayUniversityPassportAccessSandboxPage {
		Open(locator1 = "${supportURL}/web/customer");
	}

	@prose = "I should be able to the view the Liferay University Passport Access text for users with full access to the form on the sandbox"
	macro viewAsUserWithAccess {
		AssertTextPresent(value1 = "All-Access Pass to Liferay University");
		AssertTextPresent(value1 = "Receive 1-year access to all courses, updates and new offerings. Learn about everything from managing content to app development and customization to UI design with in-depth videos.");
	}
}