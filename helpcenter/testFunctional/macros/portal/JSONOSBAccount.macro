definition {
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.url");
	var supportWebId = PropsUtil.get("support.liferay.web.id");
	var webWebId = PropsUtil.get("web.liferay.web.id");
	var webURL = PropsUtil.get("web.liferay.url");

	macro getOSBAccountEntryId {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d code=${accountCode}
			''';

		var accountEntryId = JSONCurlUtil.post("${curl}", "$.accountEntryId");

		echo("OSB Account Entry ID: ${accountEntryId}");

		return "${accountEntryId}";
	}

	macro getOSBAccountEntryName {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d code=${accountCode}
			''';

		var accountEntryName = JSONCurlUtil.post("${curl}", "$.name");

		echo("OSB Account Entry Name: ${accountEntryName}");

		return "${accountEntryName}";
	}

	macro getOSBAccountEntryObject {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d code=${accountCode}
			''';

		var accountEntryObject = JSONCurlUtil.post("${curl}");

		return "${accountEntryObject}";
	}

	@prose = "the support organization with the code ${accountCode} should be part of the support site"
	macro viewSupportOrganizationSync {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d code=${accountCode}
			''';

		var accountEntryObject = JSONOSBAccount.getOSBAccountEntryObject(accountCode = "${accountCode}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!(contains("${accountEntryObject}", "${accountCode}")))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var accountEntryObject = JSONOSBAccount.getOSBAccountEntryObject(accountCode = "${accountCode}");
		}

		if (!(contains("${accountEntryObject}", "${accountCode}"))) {
			fail("After ${currentIteration} checks, the user with the email address ${userEmailAddress} appears to have not been added to the support organization ${organizationName}");
		}
	}
}