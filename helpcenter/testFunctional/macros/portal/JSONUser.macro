	@prose = "I assign the support user with the email address ${userEmailAddress} to the support user group ${userGroupName}"
	macro assignUserToSupportUserGroup {
		var userGroupId = JSONUserGroup.getSupportUserGroupId(userGroupName = "${userGroupName}");

		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
