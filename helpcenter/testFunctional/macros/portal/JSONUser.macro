		var curl = '''
			${supportURL}/api/jsonws/user/add-user-group-users
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userGroupId=${userGroupId}
			-d userIds=${supportUserId}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I delete the user with the email address ${userEmailAddress} from customer.liferay.com"
	macro deleteSupportUser {
		var companyId = JSONCompany.getSupportCompanyId();

		var userScreenName = StringUtil.extractFirst("${userEmailAddress}", "@");

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-screen-name
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d screenName=${userScreenName}
			''';

		var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/update-status
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			-d status=5
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

		var curl = '''
			${supportURL}/api/jsonws/user/delete-user
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	macro getKoroneikiUserUuid {
		var companyId = JSONCompany.getKoroneikiCompanyId();

		var curl = '''
			${koroneikiURL}/api/jsonws/user/get-user-by-email-address
			-u ${koroneikiAdminEmailAddress}:${koroneikiAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var koroneikiUserUuId = JSONCurlUtil.post("${curl}", "$.uuid");

		echo("Koroneiki User UUID: ${koroneikiUserUuId}");

		return "${koroneikiUserUuId}";
	}

	macro getSupportUserUuid {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var supportUserUuId = JSONCurlUtil.post("${curl}", "$.uuid");

		echo("Support User UUID: ${supportUserUuId}");

		return "${supportUserUuId}";
	}

	@prose = "I create a koroneiki user with the following parameters ${table}"
	macro createViaKoroneiki {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Screen Name") {
				var userScreenName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var userEmailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var userFirstName = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var userLastName = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var companyId = JSONCompany.getKoroneikiCompanyId();

		var openId = StringUtil.randomString("5");

		var curl = '''
			${koroneikiURL}/api/jsonws/user/add-user
			-u ${koroneikiAdminEmailAddress}:${koroneikiAdminPassword}
			-d companyId=${companyId}
			-d autoPassword=false
			-d password1=osbadminqauser
			-d password2=osbadminqauser
			-d autoScreenName=false
			-d screenName=${userScreenName}
			-d emailAddress=${userEmailAddress}
			-d facebookId=0
			-d openId=${openId}
			-d locale=
			-d firstName=${userFirstName}
			-d middleName=
			-d lastName=${userLastName}
			-d prefixId=0
			-d suffixId=0
			-d male=true
			-d birthdayMonth=4
			-d birthdayDay=31
			-d birthdayYear=1986
			-d jobTitle=
			-d groupIds=
			-d organizationIds=
			-d roleIds=
			-d userGroupIds=
			-d sendEmail=true
			''';

		static var koroneikiUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Koroneiki User ID: ${koroneikiUserId}");

		if (contains("${staticKoroneikiUserIdList}", "{staticKoroneikiUserIdList}")) {
			static var staticKoroneikiUserIdList = "${koroneikiUserId}";
		}
		else {
			static var staticKoroneikiUserIdList = "${staticKoroneikiUserIdList},${koroneikiUserId}";
		}

		echo("Koroneiki User ID List: ${staticKoroneikiUserIdList}");

		return "${staticKoroneikiUserIdList}";
	}

