definition {

	@prose = "I update the privacy policy form"
	macro updatePrivacyPolicyForm {
		Type(
			locator1 = "UserPrivacyPolicy#COMPANY_FIELD",
			value1 = "Other");

		Select(
			locator1 = "UserPrivacyPolicy#DEPARTMENT_SELECT",
			value1 = "Other");

		Select(
			locator1 = "UserPrivacyPolicy#ROLE_SELECT",
			value1 = "Other");

		Select(
			locator1 = "UserPrivacyPolicy#INDUSTRY_SELECT",
			value1 = "Other");

		Select(
			locator1 = "UserPrivacyPolicy#COUNTRY_SELECT",
			value1 = "United States");

		Select(
			locator1 = "UserPrivacyPolicy#HOW_DID_YOU_HEAR_ABOUT_LIFERAY_SELECT",
			value1 = "Other");

		Check(locator1 = "UserPrivacyPolicy#AGREE_TO_TERMS_OF_USE_CHECKBOX");

		Click(locator1 = "UserPrivacyPolicy#UPDATE_ACCOUNT_BUTTON");
	}

}