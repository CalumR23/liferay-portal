definition {

    macro generateDay {
		var day = DateUtil.getDate("${dayDifference}");

		var length = StringUtil.length("${day}");

		if ("${length}" == "1") {
			var day = "0${day}";
		}

		return "${day}";
	}

	macro generateFullMonth {
		var month = DateUtil.getMonth("${dayDifference}");

		if ("${month}" == "1") {
			var month = "Jan";
		}
		else if ("${month}" == "2") {
			var month = "Feb";
		}
		else if ("${month}" == "3") {
			var month = "Mar";
		}
		else if ("${month}" == "4") {
			var month = "Apr";
		}
		else if ("${month}" == "5") {
			var month = "May";
		}
		else if ("${month}" == "6") {
			var month = "Jun";
		}
		else if ("${month}" == "7") {
			var month = "Jul";
		}
		else if ("${month}" == "8") {
			var month = "Aug";
		}
		else if ("${month}" == "9") {
			var month = "Sep";
		}
		else if ("${month}" == "10") {
			var month = "Oct";
		}
		else if ("${month}" == "11") {
			var month = "Nov";
		}
		else if ("${month}" == "12") {
			var month = "Dec";
		}

		return "${month}";
	}

	macro generateFullNonAbbreviatedMonth {
		var month = DateUtil.getMonth("${dayDifference}");

		if ("${month}" == "1") {
			var month = "January";
		}
		else if ("${month}" == "2") {
			var month = "February";
		}
		else if ("${month}" == "3") {
			var month = "March";
		}
		else if ("${month}" == "4") {
			var month = "April";
		}
		else if ("${month}" == "5") {
			var month = "May";
		}
		else if ("${month}" == "6") {
			var month = "June";
		}
		else if ("${month}" == "7") {
			var month = "July";
		}
		else if ("${month}" == "8") {
			var month = "August";
		}
		else if ("${month}" == "9") {
			var month = "September";
		}
		else if ("${month}" == "10") {
			var month = "October";
		}
		else if ("${month}" == "11") {
			var month = "November";
		}
		else if ("${month}" == "12") {
			var month = "December";
		}

		return "${month}";
	}

	macro generateMonth {
		var month = DateUtil.getMonth("${dayDifference}");

		var length = StringUtil.length("${month}");

		if ("${length}" == "1") {
			var month = "0${month}";
		}

		return "${month}";
	}

}