definition {
	var webURL = PropsUtil.get("web.liferay.url");

	@prose = "I update my details as ${userScreenName} to the following values ${table}"
	macro updateDetails {
		Open(locator1 = "${webURL}/web/${userScreenName}/account-settings");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			OSBAdmin.pause(timeInSeconds = "3");

			if ("${field}" == "Title") {
				Select(
					locator1 = "UserAccount#TITLE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Screen Name") {
				Type(
					locator1 = "UserAccount#SCREEN_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				Type(
					locator1 = "UserAccount#EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "First Name") {
				Type(
					locator1 = "UserAccount#FIRST_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Middle Name") {
				Type(
					locator1 = "UserAccount#MIDDLE_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Last Name") {
				Type(
					locator1 = "UserAccount#LAST_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Suffix") {
				Select(
					locator1 = "UserAccount#SUFFIX_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Gender") {
				Select(
					locator1 = "UserAccount#GENDER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Job Title") {
				Type(
					locator1 = "UserAccount#JOB_TITLE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Preferred Name") {
				Type(
					locator1 = "UserAccount#PREFERRED_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				Type(
					locator1 = "UserAccount#COUNTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Phone Number") {
				Type(
					locator1 = "UserAccount#PHONE_NUMBER_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such details field ${field}");
			}
		}

		OSBAdmin.pause(timeInSeconds = "3");

		Click(locator1 = "UserAccount#SAVE_BUTTON");

		Message.success();

		OSBAdmin.pause(timeInSeconds = "3");
	}

	@prose = "I update my password upon login to ${userPassword}"
	macro updatePasswordUponLogin {
		if (IsElementPresent(locator1 = "UserAccount#NEW_PASSWORD_FIELD")) {
			Type(
				locator1 = "UserAccount#NEW_PASSWORD_FIELD",
				value1 = "${userPassword}");

			Type(
				locator1 = "UserAccount#ENTER_AGAIN_FIELD",
				value1 = "${userPassword}");

			Button.save();
		}
	}

	@prose = "I update my phone number as ${userScreenName} to the following values ${table}"
	macro updatePhoneNumber {
		Open(locator1 = "${webURL}/web/${userScreenName}/account-settings#_LFR_FN__2_phoneNumbers");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			OSBAdmin.pause(timeInSeconds = "3");

			if ("${field}" == "Number") {
				Type(
					locator1 = "UserAccount#NUMBER_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Extension") {
				Type(
					locator1 = "UserAccount#EXTENSION_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "UserAccount#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Primary") {
				if ("${value}" == "true") {
					Click(locator1 = "UserAccount#PRIMARY_BUTTON");				
				}
			}
			else {
				fail("No such phone number field ${field}");
			}
		}

		OSBAdmin.pause(timeInSeconds = "3");

		Click(locator1 = "UserAccount#SAVE_BUTTON");

		Message.success();

		OSBAdmin.pause(timeInSeconds = "3");
	}
}