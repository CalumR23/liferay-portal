definition {
	@prose = "I update my password upon login to ${userPassword}"
	macro updatePasswordUponLogin {
		if (IsElementPresent(locator1 = "UserAccount#NEW_PASSWORD_FIELD")) {
			Type(
				locator1 = "UserAccount#NEW_PASSWORD_FIELD",
				value1 = "${userPassword}");

			Type(
				locator1 = "UserAccount#ENTER_AGAIN_FIELD",
				value1 = "${userPassword}");

			Button.save();
		}
	}

	@prose = "I update my phone number as ${userScreenName} to the following values ${table}"
	macro updatePhoneNumber {
		Open(locator1 = "${webURL}/web/${userScreenName}/account-settings#_LFR_FN__2_phoneNumbers");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			OSBAdmin.pause(timeInSeconds = "3");

			if ("${field}" == "Number") {
				Type(
					locator1 = "UserAccount#NUMBER_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Extension") {
				Type(
					locator1 = "UserAccount#EXTENSION_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "UserAccount#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Primary") {
				if ("${value}" == "true") {
					Click(locator1 = "UserAccount#PRIMARY_BUTTON");				
				}
			}
			else {
				fail("No such phone number field ${field}");
			}
		}

		OSBAdmin.pause(timeInSeconds = "3");

		Click(locator1 = "UserAccount#SAVE_BUTTON");

		Message.success();

		OSBAdmin.pause(timeInSeconds = "3");
	}
}