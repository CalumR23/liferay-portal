	@prose = "I delete the sandbox 2 user with the email address ${userEmailAddress} from customer.liferay.com"
	macro deleteSupportUser {
		var companyId = JSONCompany.getSupportCompanyId();

		var userScreenName = StringUtil.extractFirst("${userEmailAddress}", "@");

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-screen-name
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d screenName=${userScreenName}
			''';

		var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/update-status
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			-d status=5
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

		var curl = '''
			${supportURL}/api/jsonws/user/delete-user
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	macro getSupportUserUuid {
		var companyId = JSONCompanySandbox2.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var supportUserUuId = JSONCurlUtil.post("${curl}", "$.uuid");

		echo("Support User UUID: ${supportUserUuId}");

		return "${supportUserUuId}";
	}

	macro getWebUserUuid {
		var companyId = JSONCompanySandbox2.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserUuId = JSONCurlUtil.post("${curl}", "$.uuid");

		echo("Web User UUID: ${webUserUuId}");

		return "${webUserUuId}";
	}

	@prose = "I create a sandbox 2 user with the following parameters ${table}"
	macro create {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Screen Name") {
				var userScreenName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var userEmailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var userFirstName = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var userLastName = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var companyId = JSONCompanySandbox2.getWebCompanyId();

		var openId = StringUtil.randomString("5");

		var curl = '''
			${webURL}/api/secure/jsonws/user/add-user
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d autoPassword=false
			-d password1=osbadminqauser
			-d password2=osbadminqauser
			-d autoScreenName=false
			-d screenName=${userScreenName}
			-d emailAddress=${userEmailAddress}
			-d facebookId=0
			-d openId=${openId}
			-d locale=
			-d firstName=${userFirstName}
			-d middleName=
			-d lastName=${userLastName}
			-d prefixId=0
			-d suffixId=0
			-d male=true
			-d birthdayMonth=4
			-d birthdayDay=31
			-d birthdayYear=1986
			-d jobTitle=
			-d groupIds=
			-d organizationIds=
			-d roleIds=
			-d userGroupIds=
			-d sendEmail=true
			''';

		static var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Web User ID: ${webUserId}");

		if (contains("${staticWebUserIdList}", "{staticWebUserIdList}")) {
			static var staticWebUserIdList = "${webUserId}";
		}
		else {
			static var staticWebUserIdList = "${staticWebUserIdList},${webUserId}";
		}

		echo("Web User ID List: ${staticWebUserIdList}");

		return "${staticWebUserIdList}";
	}

	@prose = "I create a sandbox 2 support user with the following parameters ${table}"
	macro createViaSupport {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Screen Name") {
				var userScreenName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var userEmailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var userFirstName = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var userLastName = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var companyId = JSONCompanySandbox2.getSupportCompanyId();

		var openId = StringUtil.randomString("5");

		var curl = '''
			${supportURL}/api/jsonws/user/add-user
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d autoPassword=false
			-d password1=osbadminqauser
			-d password2=osbadminqauser
			-d autoScreenName=false
			-d screenName=${userScreenName}
			-d emailAddress=${userEmailAddress}
			-d facebookId=0
			-d openId=${openId}
			-d locale=
			-d firstName=${userFirstName}
			-d middleName=
			-d lastName=${userLastName}
			-d prefixId=0
			-d suffixId=0
			-d male=true
			-d birthdayMonth=4
			-d birthdayDay=31
			-d birthdayYear=1986
			-d jobTitle=
			-d groupIds=
			-d organizationIds=
			-d roleIds=
			-d userGroupIds=
			-d sendEmail=true
			''';

		static var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		if (contains("${staticSupportUserIdList}", "{staticSupportUserIdList}")) {
			static var staticSupportUserIdList = "${supportUserId}";
		}
		else {
			static var staticSupportUserIdList = "${staticSupportUserIdList},${supportUserId}";
		}

		echo("Support User ID List: ${staticSupportUserIdList}");

		return "${staticSupportUserIdList}";
	}

	@prose = "I tear down the sandbox 2 users with the following email addresses from web.liferay.com ${table}"
	macro tearDownUsers {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userEmailAddress = "${row[0]}";

			var companyId = JSONCompanySandbox2.getWebCompanyId();

			var userScreenName = StringUtil.extractFirst("${userEmailAddress}", "@");

			var curl = '''
				${webURL}/api/secure/jsonws/user/get-user-by-screen-name
				-u ${webAdminEmailAddress}:${webAdminPassword}
				-d companyId=${companyId}
				-d screenName=${userScreenName}
				''';

			var userObject = JSONCurlUtil.post("${curl}");

			if ((contains("${userObject}", "${userScreenName}")) && (!(contains("${userObject}", "NoSuchUserException")))) {
				var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

				echo("Web User ID: ${webUserId}");

				var curl = '''
					${webURL}/api/secure/jsonws/user/update-status
					-u ${webAdminEmailAddress}:${webAdminPassword}
					-d userId=${webUserId}
	  				-d status=5
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

				var curl = '''
					${webURL}/api/secure/jsonws/user/delete-user
					-u ${webAdminEmailAddress}:${webAdminPassword}
					-d userId=${webUserId}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
		}
	}

