definition {
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.sandbox.2.url");
	var webAdminEmailAddress = PropsUtil.get("web.admin.email.address");
	var webAdminPassword = PropsUtil.get("web.admin.password");
	var webURL = PropsUtil.get("web.liferay.sandbox.2.url");

	@prose = "I have the sandbox 2 web user on with the email address ${userEmailAddress} agree to the web terms of use"
	macro agreeToTermsOfUse {
		var companyId = JSONCompanySandbox2.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Web User ID: ${webUserId}");

		var curl = '''
			${webURL}/api/secure/jsonws/user/update-agreed-to-terms-of-use
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			-d agreedToTermsOfUse=true
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I assign the sandbox 2 support user with the email address ${userEmailAddress} to the support organization ${organizationName}"
	macro assignUserToSupportOrganization {
		var organizationId = JSONOrganizationSandbox2.getSupportOrganizationId(organizationName = "${organizationName}");

		var companyId = JSONCompanySandbox2.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/add-organization-users
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userIds=${supportUserId}
			-d organizationId=${organizationId}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

