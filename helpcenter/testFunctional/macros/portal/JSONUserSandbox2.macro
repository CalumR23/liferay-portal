	@prose = "I tear down the sandbox 2 users with the following email addresses from the support organization ${organizationName} ${table}"
	macro tearDownUsersViaSupportOrganization {
		var organizationSearchResults = JSONOrganizationSandbox2.searchOrganization(organizationName = "${organizationName}");

		if (contains("${organizationSearchResults}", "${organizationName}")) {
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var userEmailAddress = "${row[0]}";

				var organizationId = JSONOrganizationSandbox2.getSupportOrganizationId(organizationName = "${organizationName}");

				echo("Support Organization ID: ${organizationId}");

				var curl = '''
					${supportURL}/api/jsonws/user/get-organization-users
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d organizationId=${organizationId}
					''';

				var organizationMembers = JSONCurlUtil.post("${curl}");

				if (contains("${organizationMembers}", "${userEmailAddress}")) {
					var companyId = JSONCompanySandbox2.getSupportCompanyId();

					var userScreenName = StringUtil.extractFirst("${userEmailAddress}", "@");

					var curl = '''
						${supportURL}/api/jsonws/user/get-user-by-screen-name
						-u ${supportAdminEmailAddress}:${supportAdminPassword}
						-d companyId=${companyId}
						-d screenName=${userScreenName}
						''';

					var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

					echo("Support User ID: ${supportUserId}");

					var curl = '''
						${supportURL}/api/jsonws/user/update-status
						-u ${supportAdminEmailAddress}:${supportAdminPassword}
						-d userId=${supportUserId}
		  				-d status=5
						''';

					com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

					var curl = '''
						${supportURL}/api/jsonws/user/delete-user
						-u ${supportAdminEmailAddress}:${supportAdminPassword}
						-d userId=${supportUserId}
						''';

					com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
				}
			}
		}
	}

	@prose = "I update a sandbox 2 user with the email address ${userEmailAddress} using following parameters ${table}"
	macro update {
		var companyId = JSONCompanySandbox2.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Screen Name") {
				var userScreenName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var userEmailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var userFirstName = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var userLastName = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var openId = StringUtil.randomString("5");

		var curl = '''
			${webURL}/api/secure/jsonws/user/update-user
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			-d oldPassword=osbadminqauser
			-d newPassword1=resuaqnimdabso
			-d newPassword2=resuaqnimdabso
			-d passwordReset=false
			-d reminderQueryQuestion=Test
			-d reminderQueryAnswer=Test
			-d screenName=${userScreenName}
			-d emailAddress=${userEmailAddress}
			-d facebookId=0
			-d openId=1a23d
			-d languageId=0
			-d timeZoneId=0
			-d greeting=Hello
			-d comments=Comment
			-d firstName=${userFirstName}
			-d middleName=Test
			-d lastName=${userLastName}
			-d prefixId=0
			-d suffixId=0
			-d male=true
			-d birthdayMonth=4
			-d birthdayDay=30
			-d birthdayYear=1986
			-d smsSn=
			-d aimSn=
			-d facebookSn=
			-d icqSn=
			-d jabberSn=
			-d msnSn=
			-d mySpaceSn=
			-d skypeSn=
			-d twitterSn=
			-d ymSn=
			-d jobTitle=
			-d groupIds=
			-d organizationIds=
			-d roleIds=
			-d userGroupRoles=
			-d userGroupIds=
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I update the sandbox 2 support password for user with the email address ${userEmailAddress} to ${userPassword}"
	macro updateSupportPassword {
		var companyId = JSONCompanySandbox2.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/update-password
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			-d password1=${userPassword}
			-d password2=${userPassword}
			-d passwordReset=false
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I update the sandbox 2 web password for user with the email address ${userEmailAddress} to ${userPassword}"
	macro updateWebPassword {
		var companyId = JSONCompanySandbox2.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Web User ID: ${webUserId}");

		var curl = '''
			${webURL}/api/secure/jsonws/user/update-password
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			-d password1=${userPassword}
			-d password2=${userPassword}
			-d passwordReset=false
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}
}