definition {

	macro _checkJSONFields {
		var RawTable rawTable = new RawTable("${table}");
		var currentJson = StringUtil.replace("${currentJson}", " ", "");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var quantity = "${row[1]}";
			var currentJson = StringUtil.replace("${currentJson}", "${field}=", "(${field})");

			var currentJson = StringUtil.replace("${currentJson}", "\"${field}\":", "(${field})");

			var fieldQuantity = StringUtil.count("${currentJson}", "(${field})");

			if ("${fieldQuantity}" == "${quantity}") {
				echo("The current JSON object contains ${fieldQuantity} field(s) named ${field}.");
			}
			else {
				fail("The current JSON object was expected to have ${quantity} fields named ${field}, but ${fieldQuantity} were found.");
			}
		}
	}

}