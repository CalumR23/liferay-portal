definition {

	@prose = "I navigate to the Product Menu and go to the ${portlet} portlet under the ${category} category under the ${panel} panel"
	macro gotoPortlet {
		ProductMenuHelper.expandPanel(panel = "${panel}");

		ProductMenuHelper.expandCategory(category = "${category}");

		ProductMenuHelper.gotoPortlet(portlet = "${portlet}");
	}

}