definition {
	var koroneikiAdminEmailAddress = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var koroneikiWebId = PropsUtil.get("koroneiki.liferay.web.id");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var provisioningAdminEmailAddress = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var provisioningWebId = PropsUtil.get("provisioning.liferay.web.id");
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.url");
	var supportWebId = PropsUtil.get("support.liferay.web.id");
	
	macro getKoroneikiCompanyId {
		var curl = '''
			${koroneikiURL}/api/jsonws/company/get-company-by-web-id
			-u ${koroneikiAdminEmailAddress}:${koroneikiAdminPassword}
			-d webId=${koroneikiWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Koroneiki Company ID: ${companyId}");

		return "${companyId}";
	}

	macro getProvisioningCompanyId {
		var curl = '''
			${provisioningURL}/api/jsonws/company/get-company-by-web-id
			-u ${provisioningAdminEmailAddress}:${provisioningAdminPassword}
			-d webId=${provisioningWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Provisioning Company ID: ${companyId}");

		return "${companyId}";
	}

	macro getSupportCompanyId {
		var curl = '''
			${supportURL}/api/jsonws/company/get-company-by-web-id
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d webId=${supportWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Support Company ID: ${companyId}");

		return "${companyId}";
	}
}