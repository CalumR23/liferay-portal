definition {

	macro dismissSuccessMessage {
		OSBAdmin.pause(timeInSeconds = "2");

		if (IsElementPresent(locator1 = "Message#SUCCESS_MESSAGE_CLOSE_BUTTON")) {
			Click(locator1 = "Message#SUCCESS_MESSAGE_CLOSE_BUTTON");
		}
	}

	macro error {
		var key_errorMessage = "${errorMessage}";

		AssertTextEquals.assertPartialText(
			locator1 = "Message#ERROR_MESSAGE_1",
			value1 = "${errorMessage}");
	}

	macro success {
		if (isSet(message)) {
			AssertTextEquals(
				locator1 = "Message#SUCCESS_MESSAGE",
				value1 = "${message}");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully.");
		}
	}

}