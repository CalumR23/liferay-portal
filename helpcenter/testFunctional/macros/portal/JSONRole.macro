definition {
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.url");
	var webAdminEmailAddress = PropsUtil.get("web.admin.email.address");
	var webAdminPassword = PropsUtil.get("web.admin.password");
	var webURL = PropsUtil.get("web.liferay.url");

	macro getRoleIdByName {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/role/get-role
			-u ${webAdminEmailAddress}:${webAdminPassword},
			-d companyId=${companyId},
			-d name=${roleName}
			''';

		var roleId = JSONCurlUtil.post("${curl}", "$.roleId");

		return "${roleId}";
	}
}