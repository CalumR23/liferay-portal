definition {
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.sandbox.url");
	var supportWebId = PropsUtil.get("support.liferay.sandbox.web.id");
	var webAdminEmailAddress = PropsUtil.get("web.admin.email.address");
	var webAdminPassword = PropsUtil.get("web.admin.password");
	var webWebId = PropsUtil.get("web.liferay.sandbox.web.id");
	var webURL = PropsUtil.get("web.liferay.sandbox.url");

	macro getSupportCompanyId {
		var curl = '''
			${supportURL}/api/jsonws/company/get-company-by-web-id
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d webId=${supportWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Support Company ID: ${companyId}");

		return "${companyId}";
	}

	macro getWebCompanyId {
		var curl = '''
			${webURL}/api/secure/jsonws/company/get-company-by-web-id
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d webId=${webWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Web Company ID: ${companyId}");

		return "${companyId}";
	}
}