definition {

	var customerAdminEmailAddress = PropsUtil.get("customer.admin.email.address");
	var customerAdminPassword = PropsUtil.get("customer.admin.password");
	var customerQaUserPassword = PropsUtil.get("customer.qa.user.password");
	var supportAdminEmailAdress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var koroneikiAdminEmailAddress = PropsUtil.get("koroneiki.admin.email.address");
	var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
	var oktaUserPassword = PropsUtil.get("okta.user.password");
	var provisioningAdminEmailAddress = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningAdminEmailAddress = PropsUtil.get("provisioning.admin.email.address");
	var provisioningQaUserPassword = PropsUtil.get("provisioning.qa.user.password");
	var supportUserTestPassword = PropsUtil.get("support.user.test.password");
	var zendeskAdminPassword = PropsUtil.get("zendesk.admin.password");

	@prose = "I get all test passwords and admin emails"
	macro getPasswords {
		static var staticCustomerAdminEmailAddress = "${customerAdminEmailAddress}";
		static var staticCustomerAdminPassword = "${customerAdminPassword}";
		static var staticCustomerQaUserPassword = "${customerQaUserPassword}";
		static var staticSupportAdminEmailAdress = "${supportAdminEmailAdress}";
		static var staticSupportAdminPassword = "${supportAdminPassword}";
		static var staticKoroneikiAdminEmailAddress = "${koroneikiAdminEmailAddress}";
		static var staticKoroneikiAdminPassword = "${koroneikiAdminPassword}";
		static var staticOktaUserPassword = "${oktaUserPassword}";
		static var staticProvisioningAdminEmailAddress = "${provisioningAdminEmailAddress}";
		static var staticProvisioningAdminPassword = "${provisioningAdminPassword}";
		static var staticProvisioningQaUserPassword = "${provisioningQaUserPassword}";
		static var staticSupportUserTestPassword = "${supportUserTestPassword}";
		static var staticZendeskAdminPassword = "${zendeskAdminPassword}";

		return "${staticCustomerAdminEmailAddress}";

		return "${staticCustomerAdminPassword}";

		return "${staticCustomerQaUserPassword}";

		return "${staticSupportAdminEmailAdress}";

		return "${staticSupportAdminPassword}";

		return "${staticKoroneikiAdminEmailAddress}";

		return "${staticKoroneikiAdminPassword}";

		return "${staticOktaUserPassword}";

		return "${staticProvisioningAdminEmailAddress}";

		return "${staticProvisioningAdminPassword}";

		return "${staticProvisioningQaUserPassword}";

		return "${staticSupportUserTestPassword}";

		return "${staticZendeskAdminPassword}";
	}

}