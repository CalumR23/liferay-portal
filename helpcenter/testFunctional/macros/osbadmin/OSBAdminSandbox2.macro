definition {
	var supportURL = PropsUtil.get("support.liferay.sandbox.2.url");

	@prose = "I go to the OSB admin main page on the sandbox 2"
	macro gotoOSBAdmin {
		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=1_WAR_osbportlet&p_p_lifecycle=0&p_p_state=maximized");

		AssertVisible(locator1 = "OSBAdmin#PROJECTS_TAB");
	}

	macro gotoOSBAdminEntitlements {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#ENTITLEMENTS_TAB");
	}

	macro gotoOSBAdminSalesOfferingBundles {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#OFFERING_BUNDLES_TAB");
	}

	macro gotoOSBAdminSalesOfferings {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#OFFERINGS_TAB");
	}

	macro gotoOSBAdminSalesOrders {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#ORDERS_TAB");
	}

	macro gotoOSBAdminSalesProducts {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#PRODUCTS_TAB");
	}

	macro gotoOSBAdminSupport {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SUPPORT_TAB");
	}

	macro gotoOSBAdminSupportRegions {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdminSupport#SUPPORT_REGIONS_TAB");
	}

	@prose = "I log into the support homepage as ${userEmailAddress} with password ${userPassword} on the sandbox 2"
	macro loginToSupport {
		Open(locator1 = "${supportURL}/web/guest/login");

		while (IsElementPresent(locator1 = "Login#SIGN_IN_BUTTON")) {
			Type(
				locator1 = "Login#EMAIL_ADDRESS_FIELD",
				value1 = "${userEmailAddress}");

			Type(
				locator1 = "Login#PASSWORD_FIELD",
				value1 = "${userPassword}");

			Click.clickAt(locator1 = "Login#SIGN_IN_BUTTON");
		}
	}

	@prose = "I log out and log into the support homepage as ${userEmailAddress} with password ${userPassword} on the sandbox 2"
	macro logoutAndLoginToSupport {
		OSBAdminSandbox2.logoutOfSupport();

		OSBAdminSandbox2.loginToSupport(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out of the support homepage on the sandbox 2"
	macro logoutOfSupport {
		Open(locator1 = "${supportURL}/c/portal/logout");
	}
}