definition {

	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I add an order with the product ${product} and support level ${support} to the project code ${projectCode}"
	macro addOrder {
		OSBAdmin.gotoOSBAdminSalesOrders();

		Click(locator1 = "OSBAdminSalesOrders#ADD_ORDER_BUTTON");

		Click(locator1 = "OSBAdminSalesOrderAdd#PROJECT_SELECT_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");

		var key_code = "${projectCode}";

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");

		SelectWindow(locator1 = "null");

		Click(locator1 = "OSBAdminSalesOrderAdd#ADD_OFFERING_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		Select(
			locator1 = "OSBAdminSalesOfferings#PRODUCT_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "OSBAdminSalesOfferings#SUPPORT_SELECT",
			value1 = "${support}");

		Button.search();

		ClickNoError(locator1 = "OSBAdminSalesOfferings#SEARCH_RESULT_FIRST_ROW_PRODUCT");

		SelectWindow(locator1 = "null");

		Button.save();

		Message.success();
	}

	@prose = "I add a product with the following values ${table}"
	macro addProduct {
		OSBAdmin.gotoOSBAdminSalesProducts();

		Click(locator1 = "OSBAdminSalesProducts#ADD_PRODUCT_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${value}");

				Type(
					locator1 = "OSBAdminSalesProductsAdd#KORONEIKI_PRODUCT_KEY_FIELD",
					value1 = "${productKey}");
			}
			else if ("${field}" == "Koroneiki Product Key") {
				Type(
					locator1 = "OSBAdminSalesProductsAdd#KORONEIKI_PRODUCT_KEY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Environment") {
				Select(
					locator1 = "OSBAdminSalesProductsAdd#ENVIRONMENT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version List Type") {
				Type(
					locator1 = "OSBAdminSalesProductsAdd#VERSION_LIST_TYPE_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such product field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

	@prose = "I delete a product with the name ${productName}"
	macro deleteProduct {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		Click(locator1 = "OSBAdminSalesProducts#PRODUCT_ACTIONS_MENU");

		ClickNoError(locator1 = "OSBAdminSalesProducts#DELETE_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		Message.success();
	}

	@prose = "I attempt to delete a product linked to Koroneiki with the name ${productName}"
	macro deleteProductLinkedToKoroneikiAttempt {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		Click(locator1 = "OSBAdminSalesProducts#PRODUCT_ACTIONS_MENU");

		ClickNoError(locator1 = "OSBAdminSalesProducts#DELETE_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		Message.error(errorMessage = "You cannot remove products that are linked to Koroneiki products.");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have a support lifetime of ${supportLifetime} starting ${numDays} days from now for the product ${product}"
	macro editSupportLifetimeToFutureStartDate {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var day = DateUtil.getDate("${numDays}");
		var month = DateUtil.getMonth("${numDays}");
		var year = DateUtil.getYear("${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have a support lifetime of ${supportLifetime} starting ${numDays} days ago for the product ${product}"
	macro editSupportLifetimeToPastStartDate {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var day = DateUtil.getDate("-${numDays}");
		var month = DateUtil.getMonth("-${numDays}");
		var year = DateUtil.getYear("-${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} to have a support lifetime of ${supportLifetime} starting ${numDays} days ago for the product ${product}"
	macro editSupportLifetimeToPastStartDateViaProjectNameOnly {
		OSBAdminSales.gotoOrderDetailsViaProjectName(
			project = "${project}",
			projectName = "${project}");

		var day = DateUtil.getDate("-${numDays}");
		var month = DateUtil.getMonth("-${numDays}");
		var year = DateUtil.getYear("-${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have support tickets for the product ${product}"
	macro editSupportTicketsFlagged {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var key_product = "${product}";

		Check(locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_TICKETS_CHECKBOX");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to not have support tickets for the product ${product}"
	macro editSupportTicketsUnflagged {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var key_product = "${product}";

		Uncheck(locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_TICKETS_CHECKBOX");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	macro gotoOrderDetails {
		OSBAdminSearch.searchAdvancedOrders(projectCode = "${projectCode}");

		var key_project = "${project}";

		Click(locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT");
	}

	macro gotoOrderDetailsViaProjectName {
		OSBAdminSearch.searchAdvancedOrdersViaProjectName(projectName = "${projectName}");

		var key_project = "${project}";

		Click(locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT");
	}

	@prose = "I tear down the following products ${table}"
	macro tearDownProducts {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var productName = "${row[0]}";

			var key_productName = "${productName}";

			if (IsElementPresent(locator1 = "OSBAdminSalesProducts#PRODUCT_NAME")) {
				Click(locator1 = "OSBAdminSalesProducts#PRODUCT_ACTIONS_MENU");

				ClickNoError(locator1 = "OSBAdminSalesProducts#DELETE_MENU_ITEM");

				Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

				Message.success();
			}
		}
	}

	@prose = "I update a product with the name ${productName} with the following values ${table}"
	macro updateProduct {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		Click(locator1 = "OSBAdminSalesProducts#PRODUCT_NAME");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${value}");

				Type(
					locator1 = "OSBAdminSalesProductsUpdate#KORONEIKI_PRODUCT_KEY_FIELD",
					value1 = "${productKey}");
			}
			else if ("${field}" == "Koroneiki Product Key") {
				Type(
					locator1 = "OSBAdminSalesProductsUpdate#KORONEIKI_PRODUCT_KEY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Environment") {
				Select(
					locator1 = "OSBAdminSalesProductsUpdate#ENVIRONMENT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version List Type") {
				Type(
					locator1 = "OSBAdminSalesProductsUpdate#VERSION_LIST_TYPE_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such product field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

	@prose = "I should not be able to view a product with the name ${productName}"
	macro viewNoProduct {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "OSBAdminSalesProducts#PRODUCT_NAME");
	}

	@prose = "I should not be able to view a product ${productName} external link with the domain ${domain} and entity name ${entityName} and entity id ${entityId}"
	macro viewNoProductExternalLink {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		Click(locator1 = "OSBAdminSalesProducts#PRODUCT_NAME");

		var key_productExternalLinkDomain = "${domain}";

		AssertElementNotPresent(locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_DOMAIN");

		var key_productExternalLinkEntityName = "${entityName}";

		AssertElementNotPresent(locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_ENTITY_NAME");

		var key_productExternalLinkEntityId = "${entityId}";

		AssertElementNotPresent(locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_ENTITY_ID");
	}

	@prose = "I should be able to view a product with the name ${productName} and the following values ${table}"
	macro viewProduct {
		OSBAdmin.gotoOSBAdminSalesProducts();

		var key_productName = "${productName}";

		Click(locator1 = "OSBAdminSalesProducts#PRODUCT_NAME");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "OSBAdminSalesProductsUpdate#NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Koroneiki Product Key") {
				if ("${value}" == "Verify from name") {
					var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");

					AssertValue(
						locator1 = "OSBAdminSalesProductsUpdate#KORONEIKI_PRODUCT_KEY_FIELD",
						value1 = "${productKey}");
				}
				else {
					AssertValue(
						locator1 = "OSBAdminSalesProductsUpdate#KORONEIKI_PRODUCT_KEY_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Environment") {
				AssertSelectedLabel(
					locator1 = "OSBAdminSalesProductsUpdate#ENVIRONMENT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version List Type") {
				AssertValue(
					locator1 = "OSBAdminSalesProductsUpdate#VERSION_LIST_TYPE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "External Link Domain") {
				var key_productExternalLinkDomain = "${value}";

				AssertTextEquals(
					locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_DOMAIN",
					value1 = "${value}");
			}
			else if ("${field}" == "External Link Entity Name") {
				var key_productExternalLinkEntityName = "${value}";

				AssertTextEquals(
					locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_ENTITY_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "External Link Entity Id") {
				var key_productExternalLinkEntityId = "${value}";

				AssertTextEquals(
					locator1 = "OSBAdminSalesProductsUpdate#EXTERNAL_LINK_ENTITY_ID",
					value1 = "${value}");
			}
			else {
				fail("No such product field ${field}");
			}
		}
	}

}