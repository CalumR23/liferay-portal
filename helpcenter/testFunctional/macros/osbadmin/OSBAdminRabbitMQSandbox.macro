definition {
	var rabbitMQAdminPassword = PropsUtil.get("rabbitmq.admin.password");
	var rabbitMQAdminUserName = PropsUtil.get("rabbitmq.admin.user.name");
	var rabbitMQURL = PropsUtil.get("rabbitmq.url");
	var supportURL = PropsUtil.get("support.liferay.sandbox.url");

	macro createProjectMessage {
		var message = '''
		{
			"_account": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_industry": "${industry}",
				"_name": "${accountName}"
			},
			"_billingAddress": {
				"_city": "${addressCity}",
				"_country": "${addressCountry}",
				"_dossieraAddressKey": "${dossieraAddressKey1}",
				"_postalCode": "${addressPostalCode}",
				"_region": "${addressRegion}",
				"_street": "${addressStreet}",
				"_type": "Shipping"
			},
			"_bundledProducts": [
				{
					"_currencyIsoCode": "USD",
					"_endDay": ${endDay},
					"_endMonth": ${endMonth},
					"_endYear": ${endYear},
					"_name": "Liferay Subscription - ${subscriptionLevel}",
					"_purchasedProducts": [
						{
							"_dossieraPurchasedProductKey": "12345678",
							"_endDay": ${endDay},
							"_endMonth": ${endMonth},
							"_endYear": ${endYear},
							"_environment": "Production",
							"_name": "${productName}",
							"_productType": "${productType}",
							"_quantity": 1,
							"_sizing": "Sizing 1",
							"_startDay": ${startDay},
							"_startMonth": ${startMonth},
							"_startYear": ${startYear}
						},
						{
							"_dossieraPurchasedProductKey": "87654321",
							"_endDay": ${endDay},
							"_endMonth": ${endMonth},
							"_endYear": ${endYear},
							"_name": "${subscriptionLevel} Subscription",
							"_productType": "${productType}",
							"_startDay": ${startDay},
							"_startMonth": ${startMonth},
							"_startYear": ${startYear}
						}
					],
					"_quantity": 1,
					"_salesforceOpportunityLineItemKey": "${salesforceOpportunityLineItemKey1}",
					"_startDay": ${startDay},
					"_startMonth": ${startMonth},
					"_startYear": ${startYear},
					"_totalPrice": 33000.0
				}
			],
			"_contacts": [
				{
					"_dossieraContactKey": "${dossieraContactKey}",
					"_emailAddress": "${contactEmailAddress}",
					"_firstName": "${contactFirstName}",
					"_lastName": "${contactLastName}",
					"_role": "${contactRole}"
				}
			],
			"_owner": {
				"_emailAddress": "${ownerEmailAddress}",
				"_firstName": "${ownerFirstName}",
				"_lastName": "${ownerLastName}"
			},
			"_partnerAccount": {
				"_industry": "Professional Services (Technical/Web/IT)",
				"_name": "${partnerName}",
				"_partnerships":[
					{
						"_level": "${partnerSupportLevel}",
						"_type": "Service Partner",
						"_territory": "United States"
					}
				],
				"_dossieraAccountKey": "${partnerDossieraKey}",
				"_description": "First Line Support"
			},
			"_partnerFirstLineSupport": ${partnerFirstLineSupport},
			"_project": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_dossieraProjectKey": "${dossieraProjectKey}",
				"_liferayVersion": "DXP ${versionNumber}",
				"_name": "${projectName}"
			},
			"_renewal": ${renewal},
			"_salesforceAccountKey": "${dossieraAccountKey}",
			"_salesforceOpportunityKey": "${salesforceOpportunityKey}",
			"_salesforceOpportunityProductFamily": "S",
			"_salesforceOpportunitySoldBy": "${salesforceOpportunitySoldBy}",
			"_salesforceOpportunityStageName": "${salesforceOpportunityStageName}",
			"_salesforceOpportunityTerritory": "${salesforceOpportunityTerritory}",
			"_salesforceOpportunityType": "${salesforceOpportunityType}",
			"_salesforceOwnerUserKey": "${salesforceOwnerUserKey}",
			"_salesforceProjectKey": "${salesforceProjectKey}",
			"_shippingAddress": {
				"_city": "${addressCity}",
				"_country": "${addressCountry}",
				"_dossieraAddressKey": "${dossieraAddressKey2}",
				"_postalCode": "${addressPostalCode}",
				"_region": "${addressRegion}",
				"_street": "${addressStreet}",
				"_type": "Billing"
			}
		}
		''';

		echo("${message}");

		return "${message}";
	}

