		}
		if (!(isSet(productType))) {
			var productType = "";
		}
		if (!(isSet(projectName))) {
			var projectName = "";
		}
		if (!(isSet(renewal))) {
			var renewal = "false";
		}
		if (!(isSet(salesforceOpportunityKey))) {
			var salesforceOpportunityKey = "";
		}
		if (!(isSet(salesforceOpportunityLineItemKey1))) {
			var salesforceOpportunityLineItemKey1 = "";
		}
		if (!(isSet(salesforceOpportunityLineItemKey2))) {
			var salesforceOpportunityLineItemKey2 = "";
		}
		if (!(isSet(salesforceOpportunitySoldBy))) {
			var salesforceOpportunitySoldBy = "";
		}
		if (!(isSet(salesforceOpportunityStageName))) {
			var salesforceOpportunityStageName = "";
		}
		if (!(isSet(salesforceOpportunityTerritory))) {
			var salesforceOpportunityTerritory = "";
		}
		if (!(isSet(salesforceOpportunityType))) {
			var salesforceOpportunityType = "";
		}
		if (!(isSet(salesforceOwnerUserKey))) {
			var salesforceOwnerUserKey = "";
		}
		if (!(isSet(salesforceProjectKey))) {
			var salesforceProjectKey = "";
		}
		if (!(isSet(startDay))) {
			var startDay = "";
		}
		if (!(isSet(startMonth))) {
			var startMonth = "";
		}
		if (!(isSet(startYear))) {
			var startYear = "";
		}
		if (!(isSet(subscriptionLevel))) {
			var subscriptionLevel = "";
		}
		if (!(isSet(versionNumber))) {
			var versionNumber = "";
		}

		var message = OSBAdminRabbitMQSandbox.createProjectMessage(
			accountName = "${accountName}",
			addressCity = "${addressCity}",
			addressCountry = "${addressCountry}",
			addressPostalCode = "${addressPostalCode}",
			addressRegion = "${addressRegion}",
			addressStreet = "${addressStreet}",
			contactEmailAddress = "${contactEmailAddress}",
			contactFirstName = "${contactFirstName}",
			contactLastName = "${contactLastName}",
			contactRole = "${contactRole}",
			dossieraAccountKey = "${dossieraAccountKey}",
			dossieraAddressKey1 = "${dossieraAddressKey1}",
			dossieraAddressKey2 = "${dossieraAddressKey2}",
			dossieraContactKey = "${dossieraContactKey}",
			dossieraProjectKey = "${dossieraProjectKey}",
			endDay = "${endDay}",
			endMonth = "${endMonth}",
			endYear = "${endYear}",
			industry = "${industry}",
			ownerEmailAddress = "${ownerEmailAddress}",
			ownerFirstName = "${ownerFirstName}",
			ownerLastName = "${ownerLastName}",
			partnerFirstLineSupport = "${partnerFirstLineSupport}",
			partnerDossieraKey = "${partnerDossieraKey}",
			partnerName = "${partnerName}",
			partnerSupportLevel = "${partnerSupportLevel}",
			productName = "${productName}",
			productType = "${productType}",
			projectName = "${projectName}",
			renewal = "${renewal}",
			salesforceOpportunityKey = "${salesforceOpportunityKey}",
			salesforceOpportunityLineItemKey1 = "${salesforceOpportunityLineItemKey1}",
			salesforceOpportunityLineItemKey2 = "${salesforceOpportunityLineItemKey2}",
			salesforceOpportunitySoldBy = "${salesforceOpportunitySoldBy}",
			salesforceOpportunityStageName = "${salesforceOpportunityStageName}",
			salesforceOpportunityTerritory = "${salesforceOpportunityTerritory}",
			salesforceOpportunityType = "${salesforceOpportunityType}",
			salesforceOwnerUserKey = "${salesforceOwnerUserKey}",
			salesforceProjectKey = "${salesforceProjectKey}",
			startDay = "${startDay}",
			startMonth = "${startMonth}",
			startYear = "${startYear}",
			subscriptionLevel = "${subscriptionLevel}",
			versionNumber = "${versionNumber}");

		var httpAuth = HttpRequestUtil.getHttpAuthorization(
			"basic",
			"${rabbitMQAdminPassword}:${rabbitMQAdminUserName}");

		var requestHeader = HttpRequestUtil.addRequestHeaders(
			"Poshi.NULL",
			"Content-Type=application/json; charset=utf-8");

		var formattedPayload = JSONUtil.formatJSONString("${message}");
		var formattedPayload = StringUtil.replace("${formattedPayload}", "&quot;", "\&quot;");

		echo("Formatted payload:  ${formattedPayload}");

		var postData = '''
		{
			"properties": {},
			"routing_key": "${routingKey}",
			"payload": "${formattedPayload}",
			"payload_encoding": "string"
		}
		''';

		echo("Auth: ${httpAuth}");
		echo("Header: ${requestHeader}");
		echo("Post data:  ${postData}");

		var response= HttpRequestUtil.request(
			"${httpAuth}",
			"${postData}",
			"${requestHeader}",
			"POST",
			"${rabbitMQURL}/api/exchanges/%2f/is_dossiera_exchange/publish");
	}

