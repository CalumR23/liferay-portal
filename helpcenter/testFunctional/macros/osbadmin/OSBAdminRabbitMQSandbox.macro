		var httpAuth = HttpRequestUtil.getHttpAuthorization(
			"basic",
			"${rabbitMQAdminPassword}:${rabbitMQAdminUserName}");

		var requestHeader = HttpRequestUtil.addRequestHeaders(
			"Poshi.NULL",
			"Content-Type=application/json; charset=utf-8");

		var formattedPayload = JSONUtil.formatJSONString("${message}");
		var formattedPayload = StringUtil.replace("${formattedPayload}", "&quot;", "\&quot;");

		echo("Formatted payload:  ${formattedPayload}");

		var postData = '''
		{
			"properties": {},
			"routing_key": "${routingKey}",
			"payload": "${formattedPayload}",
			"payload_encoding": "string"
		}
		''';

		echo("Auth: ${httpAuth}");
		echo("Header: ${requestHeader}");
		echo("Post data:  ${postData}");

		var response= HttpRequestUtil.request(
			"${httpAuth}",
			"${postData}",
			"${requestHeader}",
			"POST",
			"${rabbitMQURL}/api/exchanges/%2f/is_dossiera_exchange/publish");
	}
}