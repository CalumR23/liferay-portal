			"_project": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_dossieraProjectKey": "${dossieraProjectKey}",
				"_liferayVersion": "DXP ${versionNumber}",
				"_name": "${projectName}",
				"_projectSolution": "${projectSolution}",
				"_salesforceProjectKey": "${salesforceProjectKey}"
			},
			"_renewal": ${renewal},
			"_salesforceAccountKey": "${dossieraAccountKey}",
			"_salesforceOpportunityKey": "${salesforceOpportunityKey}",
			"_salesforceOpportunityProductFamily": "S",
			"_salesforceOpportunitySoldBy": "${salesforceOpportunitySoldBy}",
			"_salesforceOpportunityStageName": "${salesforceOpportunityStageName}",
			"_salesforceOpportunityTerritory": "${salesforceOpportunityTerritory}",
			"_salesforceOpportunityType": "${salesforceOpportunityType}",
			"_salesforceOwnerUserKey": "${salesforceOwnerUserKey}",
			"_shippingAddress": {
				"_city": "${addressCity}",
				"_country": "${addressCountry}",
				"_dossieraAddressKey": "${dossieraAddressKey2}",
				"_postalCode": "${addressPostalCode}",
				"_region": "${addressRegion}",
				"_street": "${addressStreet}",
				"_type": "Billing"
			}
		}
		''';

		echo("${message}");

		return "${message}";
	}

