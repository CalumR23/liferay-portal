			ownerFirstName = "${ownerFirstName}",
			ownerLastName = "${ownerLastName}",
			partnerFirstLineSupport = "${partnerFirstLineSupport}",
			partnerDossieraKey = "${partnerDossieraKey}",
			partnerName = "${partnerName}",
			partnerSupportLevel = "${partnerSupportLevel}",
