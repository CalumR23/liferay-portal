definition {
	var apiToken = PropsUtil.get("koroneiki.api.token");
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var rabbitMQAdminPassword = PropsUtil.get("rabbitmq.admin.password");
	var rabbitMQAdminUserName = PropsUtil.get("rabbitmq.admin.user.name");
	var rabbitMQURL = PropsUtil.get("rabbitmq.url");
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I adjust the initial start date and end date to ${numberOfDays} into the future"
	macro adjustStartAndEndDatesToFutureDates {
		var startDateAdjustmentValue = MathUtil.sum("0", "${numberOfDays}");
		var endDateAdjustmentValue = MathUtil.sum("335", "${numberOfDays}");

		static var staticAdjustedStartDay = DateUtil.getDate("${startDateAdjustmentValue}");
		static var staticAdjustedStartMonth = DateUtil.getMonth("${startDateAdjustmentValue}");
		static var staticAdjustedStartMonthName = DateUtil.getMonthName("${startDateAdjustmentValue}");
		static var staticAdjustedStartYear = DateUtil.getYear("${startDateAdjustmentValue}");

		static var staticAdjustedEndDay = DateUtil.getDate("${endDateAdjustmentValue}");
		static var staticAdjustedEndMonth = DateUtil.getMonth("${endDateAdjustmentValue}");
		static var staticAdjustedEndMonthName = DateUtil.getMonthName("${endDateAdjustmentValue}");
		static var staticAdjustedEndYear = DateUtil.getYear("${endDateAdjustmentValue}");

		return "${staticAdjustedStartDay}";
		return "${staticAdjustedStartMonth}";
		return "${staticAdjustedStartMonthName}";
		return "${staticAdjustedStartYear}";

		return "${staticAdjustedEndDay}";
		return "${staticAdjustedEndMonth}";
		return "${staticAdjustedEndMonthName}";
		return "${staticAdjustedEndYear}";
	}

	@prose = "I adjust the initial start date and end date to ${numberOfDays} into the past"
	macro adjustStartAndEndDatesToPastDates {
		var startDateAdjustmentValue = MathUtil.difference("0", "${numberOfDays}");
		var endDateAdjustmentValue = MathUtil.difference("335", "${numberOfDays}");

		static var staticAdjustedStartDay = DateUtil.getDate("${startDateAdjustmentValue}");
		static var staticAdjustedStartMonth = DateUtil.getMonth("${startDateAdjustmentValue}");
		static var staticAdjustedStartMonthName = DateUtil.getMonthName("${startDateAdjustmentValue}");
		static var staticAdjustedStartYear = DateUtil.getYear("${startDateAdjustmentValue}");

		static var staticAdjustedEndDay = DateUtil.getDate("${endDateAdjustmentValue}");
		static var staticAdjustedEndMonth = DateUtil.getMonth("${endDateAdjustmentValue}");
		static var staticAdjustedEndMonthName = DateUtil.getMonthName("${endDateAdjustmentValue}");
		static var staticAdjustedEndYear = DateUtil.getYear("${endDateAdjustmentValue}");

		return "${staticAdjustedStartDay}";
		return "${staticAdjustedStartMonth}";
		return "${staticAdjustedStartMonthName}";
		return "${staticAdjustedStartYear}";

		return "${staticAdjustedEndDay}";
		return "${staticAdjustedEndMonth}";
		return "${staticAdjustedEndMonthName}";
		return "${staticAdjustedEndYear}";
	}

	@prose = "I adjust the initial start year ${startYear} and initial end year ${endYear} to ${numberOfYears} years into the future"
	macro adjustStartAndEndYearsToFutureYears {
		static var staticAdjustedEndYear = MathUtil.sum("${endYear}", "${numberOfYears}");
		static var staticAdjustedStartYear = MathUtil.sum("${startYear}", "${numberOfYears}");

		return "${staticAdjustedEndYear}";
		return "${staticAdjustedStartYear}";
	}

	@prose = "I adjust the initial start year ${startYear} and initial end year ${endYear} to ${numberOfYears} years into the past"
	macro adjustStartAndEndYearsToPastYears {
		static var staticAdjustedEndYear = MathUtil.difference("${endYear}", "${numberOfYears}");
		static var staticAdjustedStartYear = MathUtil.difference("${startYear}", "${numberOfYears}");

		return "${staticAdjustedEndYear}";
		return "${staticAdjustedStartYear}";
	}

	macro createPartnerAccountMessage {
		var message = '''
		{
			"_account": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_industry": "${industry}",
				"_name": "${accountName}"
			},
			"_billingAddress": {
				"_city": "${addressCity}",
				"_country": "${addressCountry}",
				"_dossieraAddressKey": "${dossieraAddressKey1}",
				"_postalCode": "${addressPostalCode}",
				"_region": "${addressRegion}",
				"_street": "${addressStreet}",
				"_type": "Billing"
			},
			"_bundledProducts": [
				{
					"_currencyIsoCode": "USD",
					"_endDay": ${endDay},
					"_endMonth": ${endMonth},
					"_endYear": ${endYear},
					"_name": "${productName}",
					"_purchasedProducts": [
						{
							"_dossieraPurchasedProductKey": "1701657661",
							"_endDay": ${endDay},
							"_endMonth": ${endMonth},
							"_endYear": ${endYear},
							"_name": "${productName}",
							"_productType": "${productType}",
							"_quantity": 1,
							"_startDay": ${startDay},
							"_startMonth": ${startMonth},
							"_startYear": ${startYear}
						}
					],
					"_quantity": 1,
					"_salesforceOpportunityLineItemKey": "${salesforceOpportunityLineItemKey1}",
					"_startDay": ${startDay},
					"_startMonth": ${startMonth},
					"_startYear": ${startYear},
					"_totalPrice": 1300.0
				}
			],
			"_owner": {
				"_emailAddress": "${ownerEmailAddress}",
				"_firstName": "${ownerFirstName}",
				"_lastName": "${ownerLastName}"
			},
			"_partnerFirstLineSupport": ${partnerFirstLineSupport},
			"_partnerships":[
				{
					"_level": "${partnerSupportLevel}",
					"_type": "Service Partner",
					"_territory": "United States"
				}
			],
			"_renewal": ${renewal},
			"_salesforceAccountKey": "${dossieraAccountKey}",
			"_salesforceOpportunityKey": "${salesforceOpportunityKey}",
			"_salesforceOpportunityProductFamily": "P",
			"_salesforceOpportunitySoldBy": "${salesforceOpportunitySoldBy}",
			"_salesforceOpportunityStageName": "${salesforceOpportunityStageName}",
			"_salesforceOpportunityTerritory": "${salesforceOpportunityTerritory}",
			"_salesforceOpportunityType": "${salesforceOpportunityType}",
			"_salesforceOwnerUserKey": "${salesforceOwnerUserKey}"
		}
		''';

		echo("${message}");

		return "${message}";
	}

