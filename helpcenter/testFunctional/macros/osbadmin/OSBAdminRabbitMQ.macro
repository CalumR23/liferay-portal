			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		var currentIteration = "0";

		while ((!(contains("${allAccounts}", "${projectName}"))) && (!("${currentIteration}" == "10"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			OSBAdmin.pause(timeInSeconds = "1");

