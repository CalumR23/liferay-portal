		if (("${subscriptionLevel1}" == "Platinum") || ("${subscriptionLevel1}" == "Gold") || ("${subscriptionLevel1}" == "Limited")) {
			KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "${subscriptionLevel1} Subscription");
