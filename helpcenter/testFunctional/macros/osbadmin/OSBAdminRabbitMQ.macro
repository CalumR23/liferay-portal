			productType = "${productType}",
			projectName = "${projectName}",
			projectSolution = "${projectSolution}",
			renewal = "${renewal}",
			salesforceOpportunityKey = "${salesforceOpportunityKey}",
			salesforceOpportunityLineItemKey1 = "${salesforceOpportunityLineItemKey1}",
			salesforceOpportunityLineItemKey2 = "${salesforceOpportunityLineItemKey2}",
			salesforceOpportunitySoldBy = "${salesforceOpportunitySoldBy}",
			salesforceOpportunityStageName = "${salesforceOpportunityStageName}",
			salesforceOpportunityTerritory = "${salesforceOpportunityTerritory}",
			salesforceOpportunityType = "${salesforceOpportunityType}",
			salesforceOwnerUserKey = "${salesforceOwnerUserKey}",
			salesforceProjectKey = "${salesforceProjectKey}",
			startDay = "${startDay}",
			startMonth = "${startMonth}",
			startYear = "${startYear}",
			subscriptionLevel = "${subscriptionLevel}",
			versionNumber = "${versionNumber}");

		var httpAuth = HttpRequestUtil.getHttpAuthorization(
			"basic",
			"${rabbitMQAdminPassword}:${rabbitMQAdminUserName}");

		var requestHeader = HttpRequestUtil.addRequestHeaders(
			"Poshi.NULL",
			"Content-Type=application/json; charset=utf-8");

		var formattedPayload = JSONUtil.formatJSONString("${message}");
		var formattedPayload = StringUtil.replace("${formattedPayload}", "&quot;", "\&quot;");

		echo("Formatted payload:  ${formattedPayload}");

		var postData = '''
		{
			"properties": {},
			"routing_key": "${routingKey}",
			"payload": "${formattedPayload}",
			"payload_encoding": "string"
		}
		''';

		echo("Auth: ${httpAuth}");
		echo("Header: ${requestHeader}");
		echo("Post data:  ${postData}");

		var response= HttpRequestUtil.request(
			"${httpAuth}",
			"${postData}",
			"${requestHeader}",
			"POST",
			"${rabbitMQURL}/api/exchanges/%2f/is_dossiera_v1/publish");

		if (contains("${projectName}", " ")) {
			var keyword = StringUtil.extractFirst("${projectName}", " ");
		}
		else {
			var keyword = "${projectName}";
		}

		var curl = '''
			--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
			--header "API_Token: ${apiToken}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var allAccounts = JSONCurlUtil.get("${curl}", "$");

		var currentIteration = "0";

		while ((!(contains("${allAccounts}", "${projectName}"))) && (!("${currentIteration}" == "10"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			OSBAdmin.pause(timeInSeconds = "1");

			var curl = '''
				--tlsv1.2 ${koroneikiURL}/o/koroneiki-rest/v1.0/accounts?search=${keyword}\&pageSize=100
				--header "API_Token: ${apiToken}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var allAccounts = JSONCurlUtil.get("${curl}", "$");
		}

		if (("${subscriptionLevel}" == "Platinum") || ("${subscriptionLevel}" == "Gold") || ("${subscriptionLevel}" == "Limited")) {
			KoroneikiAccountAPI._synchronizeAccountEntitlementDefinition(entitlementDefinitionName = "${subscriptionLevel} Subscription");
		}
	}

