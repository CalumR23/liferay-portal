definition {
	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.sandbox.2.url");

	macro searchAdvancedAccountViaKoroneikiAccountKey {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#PROJECTS_TAB");

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		Type(
			locator1 = "OSBAdmin#ADVANCED_SEARCH_KORONEIKI_ACCOUNT_KEY_FIELD",
			value1 = "${accountKey}");

		KeyPress(
			locator1 = "OSBAdmin#ADVANCED_SEARCH_KORONEIKI_ACCOUNT_KEY_FIELD",
			value1 = "\RETURN");
	}

	macro searchAdvancedOrders {
		OSBAdminSandbox2.gotoOSBAdminSalesOrders();

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		if (isSet(projectCode)) {
			Click(locator1 = "OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_PROJECT_BUTTON");

			SelectWindow(locator1 = "title=${popupTitle}");

			OSBAdminSearch.toggleSearch(searchType = "Basic");

			Type(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "${projectCode}");

			KeyPress(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "\RETURN");

			var key_code = "${projectCode}";

			Click(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");
		}

		SelectWindow(locator1 = "null");

		Button.search();
	}

	macro searchAdvancedOrdersViaProjectName {
		OSBAdminSandbox2.gotoOSBAdminSalesOrders();

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		if (isSet(projectName)) {
			Click(locator1 = "OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_PROJECT_BUTTON");

			SelectWindow(locator1 = "title=${popupTitle}");

			OSBAdminSearch.toggleSearch(searchType = "Basic");

			Type(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "&quot;${projectName}&quot;");

			KeyPress(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "\RETURN");

			var key_name = "${projectName}";

			Click(locator1 = "OSBAdmin#SEARCH_RESULT_PROJECT");
		}

		SelectWindow(locator1 = "null");

		Button.search();
	}

	macro searchBasicPartner {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#PARTNERS_TAB");

		OSBAdminSearch.searchBasic(keyword = "${partnerCode}");
	}

	macro searchBasicProject {
		OSBAdminSandbox2.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#PROJECTS_TAB");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");
	}

	macro searchBasicProjectViaName {
		OSBAdminSandbox2.gotoOSBAdmin();

		AssertClick(locator1 = "OSBAdmin#PROJECTS_TAB", value1 = "Accounts");

		var keyword = "&quot;${projectName}&quot;";

		OSBAdminSearch.searchBasic(keyword = "${keyword}");
	}
}