definition {
	var koroneikiURL = PropsUtil.get("koroneiki.liferay.url");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var supportURL = PropsUtil.get("support.liferay.url");
	var webURL = PropsUtil.get("web.liferay.url");

	@prose = "I go to the OSB admin main page"
	macro gotoOSBAdmin {
		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=1_WAR_osbportlet&p_p_lifecycle=0&p_p_state=maximized");

		AssertVisible(locator1 = "OSBAdmin#ACCOUNTS_TAB");
	}

	macro gotoOSBAdminEntitlements {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#ENTITLEMENTS_TAB");
	}

	macro gotoOSBAdminSalesOfferingBundles {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#OFFERING_BUNDLES_TAB");
	}

	macro gotoOSBAdminSalesOfferings {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#OFFERINGS_TAB");
	}

	macro gotoOSBAdminSalesOrders {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#ORDERS_TAB");
	}

	macro gotoOSBAdminSalesProducts {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SALES_TAB");
		Click(locator1 = "OSBAdminSales#PRODUCTS_TAB");
	}

	macro gotoOSBAdminSupport {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#SUPPORT_TAB");
	}

	macro gotoOSBAdminSupportRegions {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdminSupport#SUPPORT_REGIONS_TAB");
	}

	@prose = "I log into the koroneiki homepage as ${userEmailAddress} with password ${userPassword}"
	macro loginToKoroneiki {
		Open(locator1 = "${koroneikiURL}/web/guest/home?p_p_id=com_liferay_login_web_portlet_LoginPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&saveLastPath=false&_com_liferay_login_web_portlet_LoginPortlet_mvcRenderCommandName=%2Flogin%2Flogin");

		Type(
			locator1 = "Login#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Login#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "Login#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "Login#SIGN_IN_BUTTON");
	}

	@prose = "I log into the provisioning homepage as ${userEmailAddress} with password ${userPassword}"
	macro loginToProvisioning {
		Open(locator1 = "${provisioningURL}/web/guest/home?p_p_id=com_liferay_login_web_portlet_LoginPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&saveLastPath=false&_com_liferay_login_web_portlet_LoginPortlet_mvcRenderCommandName=%2Flogin%2Flogin");

		Type(
			locator1 = "Login#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Login#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "Login#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "Login#SIGN_IN_BUTTON");
	}

	@prose = "I log into the support homepage as ${userEmailAddress} with password ${userPassword}"
	macro loginToSupport {
		Open(locator1 = "${supportURL}/web/guest/login");

		Type(
			locator1 = "Login#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Login#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "Login#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "Login#SIGN_IN_BUTTON");
	}

	@prose = "I log into the web homepage as ${userEmailAddress} with password ${userPassword}"
	macro loginToWeb {
		// At some point we will need to remove this macro entirely since there are no plans to log in to okta frontend. Once all web frontend tests are updated to okta backend, we should remove this macro

		Open(locator1 = "${webURL}/sign-in");

		Type(
			locator1 = "Login#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Login#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "Login#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "Login#SIGN_IN_BUTTON");

		var key_errorMessage = "Authentication failed. Please try again.";

		if (IsElementPresent(locator1 = "Message#ERROR_MESSAGE_2")) {
			JSONOkta.updateOktaPassword(
				userEmailAddress = "${userEmailAddress}",
				userPassword = "${userPassword}");
		}

		if (IsElementPresent(locator1 = "UserPrivacyPolicy#UPDATE_ACCOUNT_BUTTON")) {
			UserPrivacyPolicy.updatePrivacyPolicyForm();
		}
	}

	@prose = "I log out and log into the koroneiki homepage as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLoginToKoroneiki {
		OSBAdmin.logoutOfKoroneiki();

		OSBAdmin.loginToKoroneiki(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out and log into the provisioning homepage as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLoginToProvisioning {
		OSBAdmin.logoutOfProvisioning();

		OSBAdmin.loginToProvisioning(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out and log into the support homepage as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLoginToSupport {
		OSBAdmin.logoutOfSupport();

		OSBAdmin.loginToSupport(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out and log into the web homepage as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLoginToWeb {
		OSBAdmin.logoutOfWeb();

		OSBAdmin.loginToWeb(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out of the koroneiki homepage"
	macro logoutOfKoroneiki {
		Open(locator1 = "${koroneikiURL}/c/portal/logout");
	}

	@prose = "I log out of the provisioning homepage"
	macro logoutOfProvisioning {
		Open(locator1 = "${provisioningURL}/c/portal/logout");
	}

	@prose = "I log out of the support homepage"
	macro logoutOfSupport {
		Open(locator1 = "${supportURL}/c/portal/logout");
	}

	@prose = "I log out of the web homepage"
	macro logoutOfWeb {
		Open(locator1 = "${webURL}/c/portal/logout");
	}

	macro pause {
		var timeInMilliseconds = MathUtil.product("${timeInSeconds}", "1000");

		Pause(locator1 = "${timeInMilliseconds}");
	}
}