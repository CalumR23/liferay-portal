	@prose = "the ticket with keywords ${keywords} should have the text ${descriptionText} in its description"
	macro _viewTicketDescription {
		var ticketId = ZendeskTicketAPI._viewTicketIdByKeywords(keywords = "${keywords}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.description");

		echo("Expected Description Text: ${descriptionText}");
		echo("Actual Description: ${descriptionFromAPI}");

		if (!(contains("${descriptionFromAPI}", "${descriptionText}"))) {
			fail("Actual description ${descriptionFromAPI} does not contain the text ${descriptionText}");
		}
	}

	@prose = "the ticket with keywords ${keywords} should not have the text ${descriptionText} in its description"
	macro _viewTicketDescriptionNonText {
		var ticketId = ZendeskTicketAPI._viewTicketIdByKeywords(keywords = "${keywords}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var descriptionFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.description");

		echo("Expected Description Text: ${descriptionText}");
		echo("Actual Description: ${descriptionFromAPI}");

		if (contains("${descriptionFromAPI}", "${descriptionText}")) {
			fail("Actual description ${descriptionFromAPI} contains the unexpected the text ${descriptionText}");
		}
	}

	@prose = "the ticket with keywords ${keywords} should have the email cc ${userEmailAddress}"
	macro _viewTicketEmailCc {
		var ticketId = ZendeskTicketAPI._viewTicketIdByKeywords(keywords = "${keywords}");

		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var emailCcIdsFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.email_cc_ids");

		var emailCcIdsFromAPI = StringUtil.replace("${emailCcIdsFromAPI}", "[", "");

		var emailCcIdsFromAPI = StringUtil.replace("${emailCcIdsFromAPI}", "]", "");

		echo("Expected Email CC ID: ${userId}");
		echo("Actual Email CC IDs: ${emailCcIdsFromAPI}");

		if (!(contains("${emailCcIdsFromAPI}", "${userId}"))) {
			fail("User with the email address ${userEmailAddress} appears to not be ccd on the ticket");
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the environment ${environment}"
	macro _viewTicketEnvironment {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Environment");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var environmentFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "[", "");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "]", "");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "&quot;", "");

		echo("Expected Environment Name: ${environment}");
		echo("Actual Environment Name: ${environmentFromAPI}");

		if (!("${environmentFromAPI}" == "${environment}")) {
			fail("Actual value ${environmentFromAPI} does not match expected value ${environment}");
		}
	}

	macro _viewTicketExistingTagsById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.ticket.tags");

		var existingTags = StringUtil.replace("${existingTags}", "[", "");

		var existingTags = StringUtil.replace("${existingTags}", "]", "");

		var existingTags = StringUtil.replace("${existingTags}", "&quot;", "");

		return "${existingTags}";
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should be assigned to the group ${assignee}"
	macro _viewTicketGroupAssignee {
