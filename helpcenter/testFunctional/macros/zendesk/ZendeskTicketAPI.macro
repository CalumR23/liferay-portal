	@prose = "the ticket with keywords ${keywords} should be assigned to the group ${groupName}"
	macro _viewTicketGroupAssigneeByKeywords {
		var ticketId = ZendeskTicketAPI._viewTicketIdByKeywords(keywords = "${keywords}");

		var groupId = ZendeskGroupAPI._getGroupIdByName(groupName = "${groupName}");

		var groupIdFromAPI = ZendeskTicketAPI._getTicketGroupAssigneeIdById(ticketId = "${ticketId}");

		echo("Expected Group ID: ${groupId}");
		echo("Actual Group ID: ${groupIdFromAPI}");

		if (!("${groupIdFromAPI}" == "${groupId}")) {
			fail("Actual group ID ${groupIdFromAPI} assigned to the ticket does not match expected value ${groupId}");
		}
	}

	macro _viewTicketIdByKeywords {
		var keywords = StringUtil.replace("${keywords}", " ", "+");

		var keywords = StringUtil.replace("${keywords}", ")", "");

		var keywords = StringUtil.replace("${keywords}", "(", "");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/search.json?query=${keywords}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var ticketId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${ticketId}";
	}

	macro _viewTicketIdByTicketSubject {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/search.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-G --data-urlencode "query=type:ticket subject:${ticketSubject}"
			''';

		var ticketId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${ticketId}";
	}

	@prose = "the ticket with keywords ${keywords} should have the opportunity owner ${opportunityOwner}"
	macro _viewTicketOpportunityOwner {
		var ticketId = ZendeskTicketAPI._viewTicketIdByKeywords(keywords = "${keywords}");

		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Opportunity Owner");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var opportunityOwnerFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

		var opportunityOwnerFromAPI = StringUtil.replace("${opportunityOwnerFromAPI}", "[", "");

		var opportunityOwnerFromAPI = StringUtil.replace("${opportunityOwnerFromAPI}", "]", "");

		var opportunityOwnerFromAPI = StringUtil.replace("${opportunityOwnerFromAPI}", "&quot;", "");

