definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getCustomRoleIdByName {
		var curl = '''
			${zendeskURL}/api/v2/custom_roles.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var customRoleId = JSONCurlUtil.get("${curl}", "$.custom_roles[?(@.name=='${customRoleName}')].id");

		var customRoleId = StringUtil.replace("${customRoleId}", "[", "");

		var customRoleId = StringUtil.replace("${customRoleId}", "]", "");

		var customRoleId = StringUtil.replace("${customRoleId}", "&quot;", "");

		return "${customRoleId}";
	}
}