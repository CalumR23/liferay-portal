definition {
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");

	@prose = "I should be able to see the downloaded file ${file}"
	macro assertDownloadedFile {
		var tempFileDirectory = selenium.getOutputDirName();

		var downloadedFilePath = "/home/me/Downloads/${file}";

		var fileExists = FileUtil.exists("${downloadedFilePath}");

		if ("${fileExists}" == "true") {
			echo("File named ${file} was downloaded.");
		}
		else {
			fail("File named ${file} NOT FOUND in folder ${downloadedFilePath}!");
		}
	}

	@prose = "I click the option ${option}"
	macro clickOption {
		Click(
			locator1 = "ZendeskRequestAdd#OPTION",
			key_option = "${option}");
	}

	@prose = "I click on the ${dropdownLabel} dropdown"
	macro clickRequestDropdown {
		Click(
			locator1 = "ZendeskRequestAdd#DROPDOWN_LINK",
			key_dropdownLabel = "${dropdownLabel}");
	}

	@prose = "I create a request with the following values ${table}"
	macro create {
		ZendeskHomepage.gotoSubmitATicket();

		ZendeskHomepage.acceptAllCookies();

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";
			var subValue = "${row[2]}";

			if ("${field}" == "Organization") {
				Click(locator1 = "ZendeskRequestAdd#ORGANIZATION_DROPDOWN_LINK");
				Click(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
			}
			else if ("${field}" == "Product") {
				Click(locator1 = "ZendeskRequestAdd#PRODUCT_DROPDOWN_LINK");
				Click(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
				if (!("${subValue}" == "")) {
					Click(
						locator1 = "ZendeskRequestAdd#OPTION",
						key_option = "${subValue}");
				}
			}
			else if ("${field}" == "Component") {
				Click(locator1 = "ZendeskRequestAdd#COMPONENT_DROPDOWN_LINK");
				Click(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
			}
			else if ("${field}" == "System Status") {
				Click(locator1 = "ZendeskRequestAdd#SYSTEM_STATUS_DROPDOWN_LINK");
				Click(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
				if (!("${subValue}" == "")) {
					Click(
						locator1 = "ZendeskRequestAdd#OPTION",
						key_option = "${subValue}");
				}
			}
			else if ("${field}" == "Subject") {
				Type(
					locator1 = "ZendeskRequestAdd#SUBJECT_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Description") {
				SelectFrame(locator1 = "ZendeskRequestAdd#DESCRIPTION_FIELD_IFRAME");

				Type(
					locator1 = "ZendeskRequestAdd#DESCRIPTION_FIELD",
					value1 = "${value}");

				SelectFrameTop();
			}
			else if ("${field}" == "Urgent for Pandemic Response") {
				Click(locator1 = "ZendeskRequestAdd#URGENT_FOR_PANDEMIC_RESPONSE_DROPDOWN_LINK");
				Click(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
			}
			else if ("${field}" == "Attachments") {
				MakeVisible(locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD");

				UploadCommonFile(
					locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD",
					value1 = "${value}");

				ZendeskHomepage.pause(timeInSeconds = "5");
			}
			else {
				fail("No such request field ${field}");
			}
		}

		Click(locator1 = "ZendeskRequestAdd#SUBMIT_BUTTON");

		while(IsElementPresent(locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD_ERROR_MESSAGE")) {
			MakeVisible(locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD");

			UploadCommonFile(
				locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD",
				value1 = "${value}");

			ZendeskHomepage.pause(timeInSeconds = "5");

			Click(locator1 = "ZendeskRequestAdd#SUBMIT_BUTTON");
		}

		AssertTextEquals(
			locator1 = "ZendeskHomepage#MESSAGE",
			value1 = "Your request was successfully submitted.");

		Click(locator1 = "ZendeskHomepage#MESSAGE_DISMISS_LINK");

		var requestId = selenium.getText("ZendeskRequestView#REQUEST_DETAILS_ID");

		var requestId = StringUtil.replace("${requestId}", "#", "");

		echo("Request ID: ${requestId}");

		static var staticRequestId = "${requestId}";

		return "${staticRequestId}";
	}

	@prose = "I create a follow-up request"
	macro createFollowUpRequest {
		Click(locator1 = "ZendeskRequestView#CREATE_FOLLOW_UP_LINK");

		ZendeskHomepage.acceptAllCookies();

		Click(locator1 = "ZendeskRequestAdd#SUBMIT_BUTTON");

		AssertTextEquals(
			locator1 = "ZendeskHomepage#MESSAGE",
			value1 = "Your request was successfully submitted.");

		Click(locator1 = "ZendeskHomepage#MESSAGE_DISMISS_LINK");

		var requestId = selenium.getText("ZendeskRequestView#REQUEST_DETAILS_ID");

		var requestId = StringUtil.replace("${requestId}", "#", "");

		echo("Request ID: ${requestId}");

		static var staticRequestId = "${requestId}";

		return "${staticRequestId}";
	}

	@prose = "I download the attached large file ${fileName} with the comment ${commentContent}"
	macro downloadLargeFIle {
		var key_commentContent = "${commentContent}";

		var key_fileName = "${fileName}";

		Click(locator1 = "ZendeskRequestView#REQUEST_LARGE_FILE_COMMENT_ATTACHMENT");

		DownloadTempFile();
	}

	@prose = "I go to the request with the ID ${requestId}"
	macro gotoViaId {
		Open(locator1 = "${zendeskURL}/hc/en-us/requests/${requestId}");
	}

	@prose = "I click on the request with the subject ${requestSubject} in the index"
	macro gotoViaIndex {
		Click(
			locator1 = "ZendeskRequestIndex#REQUEST_SUBJECT",
			value1 = "${value}",
			key_requestSubject = "${requestSubject}");
	}

	@prose = "I mark the request as solved"
	macro markAsSolved {
		Click(locator1 = "ZendeskRequestView#MARK_AS_SOLVED_BUTTON");

		AssertTextEquals(
			locator1 = "ZendeskHomepage#MESSAGE",
			value1 = "Your reply was successfully added.");

		Click(locator1 = "ZendeskHomepage#MESSAGE_DISMISS_LINK");
	}

	@prose = "I mark the request as solved with a comment containing the following details ${table}"
	macro markAsSolvedWithComment {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Comment") {
				Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");

				SelectFrame(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_IFRAME");

				Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_BODY");

				Type.sendKeys(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_BODY",
					value1 = "${value}");

				SelectFrameTop();
			}
			else if ("${field}" == "Attachments") {
				MakeVisible(locator1 = "ZendeskRequestView#ATTACHMENTS_FIELD");

				UploadCommonFile(
					locator1 = "ZendeskRequestView#ATTACHMENTS_FIELD",
					value1 = "${value}");

				ZendeskHomepage.pause(timeInSeconds = "5");
			}
			else {
				fail("No such request field ${field}");
			}
		}

		Click(locator1 = "ZendeskRequestView#MARK_AS_SOLVED_BUTTON");

		AssertTextEquals(
			locator1 = "ZendeskHomepage#MESSAGE",
			value1 = "Your reply was successfully added.");

		Click(locator1 = "ZendeskHomepage#MESSAGE_DISMISS_LINK");
	}

	@prose = "I rename the first request id variable"
	macro renameFirstRequestIdVariable {
		static var staticRequestId1 = "${staticRequestId}";

		return "${staticRequestId1}";
	}

	@prose = "I rename the second request id variable"
	macro renameSecondRequestIdVariable {
		static var staticRequestId2 = "${staticRequestId}";

		return "${staticRequestId2}";
	}

	@prose = "I select the organization ${organization} from the search dropdown"
	macro selectOrganizationFromSearchDropdown {
		Select(
			locator1 = "ZendeskRequestIndex#ORGANIZATION_SELECT",
			value1 = "${organization}");
	}

	@prose = "I submit a comment containing the following details ${table}"
	macro submitComment {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Comment") {
				Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");

				SelectFrame(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_IFRAME");

				Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_BODY");

				Type.sendKeys(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_BODY",
					value1 = "${value}");

				SelectFrameTop();
			}
			else if ("${field}" == "Attachments") {
				MakeVisible(locator1 = "ZendeskRequestView#ATTACHMENTS_FIELD");

				UploadCommonFile(
					locator1 = "ZendeskRequestView#ATTACHMENTS_FIELD",
					value1 = "${value}");

				ZendeskHomepage.pause(timeInSeconds = "5");
			}
			else {
				fail("No such request field ${field}");
			}
		}
		Click(locator1 = "ZendeskRequestView#SUBMIT_BUTTON");

		AssertTextEquals(
			locator1 = "ZendeskHomepage#MESSAGE",
			value1 = "Your reply was successfully added.");

		Click(locator1 = "ZendeskHomepage#MESSAGE_DISMISS_LINK");
	}

	@prose = "I search for a request using the keyword ${keyword}"
	macro typeSearchKeywordAndEnter {
		Type(
			locator1 = "ZendeskRequestIndex#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ZendeskRequestIndex#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I upload a file using the large file uploader on ticket ${requestId} with the following parameters ${table}"
	macro uploadFileViaLargeFileUploader {
		var uploadComplete = "false";

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${uploadComplete}" == "true"))) {
			ScrollWebElementIntoView(locator1 = "ZendeskRequestView#LARGE_ATTACHMENT_LINK");

			Click(locator1 = "ZendeskRequestView#LARGE_ATTACHMENT_LINK");

			ZendeskHomepage.pause(timeInSeconds = "10");

			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var field = "${row[0]}";
				var value = "${row[1]}";

				if ("${field}" == "Attachment") {
					MakeVisible(locator1 = "LargeFileUploader#ATTACHMENT_FIELD");

					UploadCommonFile(
						locator1 = "LargeFileUploader#ATTACHMENT_FIELD",
						value1 = "${value}");

					ZendeskHomepage.pause(timeInSeconds = "10");
				}
				else if ("${field}" == "Comment") {
					Type(
						locator1 = "LargeFileUploader#COMMENT_FIELD",
						value1 = "${value}");
				}
				else if ("${field}" == "Data Region") {
					AssertTextEquals.assertPartialText(
						locator1 = "LargeFileUploader#DATA_REGION_INFO_MESSAGE_FILE_UPLOAD_LOCATION",
						value1 = "Your file will be uploaded to a file server in the ${value}.");
				}
				else if ("${field}" == "No Personal Data") {
					if ("${value}" == "true") {
						Check(locator1 = "LargeFileUploader#NO_PERSONAL_DATA_CHECKBOX");
					}
					else {
						Uncheck(locator1 = "LargeFileUploader#NO_PERSONAL_DATA_CHECKBOX");
					}
				}
				else {
					fail("No such large file uploader field ${field}");
				}
			}
			AssertTextEquals.assertPartialText(
				locator1 = "LargeFileUploader#DATA_REGION_INFO_MESSAGE",
				value1 = "Please note that the location of the server to which the file will be uploaded is based on the location of the Liferay center providing support to your company. For more detail regarding the applicable server locations and location of Liferay support staff who might access the data please consult this article.");

			Click(locator1 = "LargeFileUploader#SUBMIT_BUTTON");

			if (IsElementNotPresent(locator1 = "LargeFileUploader#ATTACHMENT_FIELD_ERROR_MESSAGE")) {
				var uploadComplete = "true";
			}
			else {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

				ZendeskRequest.gotoViaId(requestId = "${requestId}");
			}
		}

		if ("${currentIteration}" == "${pollMaximumIterations}") {
			fail("After ${currentIteration} checks, the file couldn't be uploaded.");
		}
	}

	@prose = "I should be able to view a request with the following details ${table}"
	macro view {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Subject") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_SUBJECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Id") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Requester") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_REQUESTER",
					value1 = "${value}");
			}
			else if ("${field}" == "Created") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_CREATED",
					value1 = "${value}");
			}
			else if ("${field}" == "Last activity") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_LAST_ACTIVITY",
					value1 = "${value}");
			}
			else if ("${field}" == "Assigned to") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_ASSIGNED_TO",
					value1 = "${value}");
			}
			else if ("${field}" == "Organization") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_ORGANIZATION",
					value1 = "${value}");
			}
			else if ("${field}" == "Priority") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_PRIORITY",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Sub-Status") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_SUB_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Component") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_COMPONENT",
					value1 = "${value}");
			}
			else if ("${field}" == "System Status") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_SYSTEM_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Urgent for Pandemic Response") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_URGENT_FOR_PANDEMIC_RESPONSE",
					value1 = "${value}");
			}
			else if ("${field}" == "Attachments") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_DETAILS_ATTACHMENT",
					value1 = "${value}",
					key_attachmentName = "${value}");
			}
			else {
				fail("No such request field ${field}");
			}
		}
	}

	@prose = "I download the attached file ${attachmentName} on request details"
	macro downloadAttachedFileOnRequestDetails {
		Click(
			locator1 = "ZendeskRequestView#REQUEST_DETAILS_ATTACHMENT",
			key_attachmentName = "${attachmentName}");

		DownloadTempFile();
	}

	@prose = "I should see the closed comment message"
	macro viewClosedCommentMessage {
		AssertTextEquals(
			locator1 = "ZendeskRequestView#REQUEST_CLOSED_COMMENT_MESSAGE",
			value1 = "This request is closed for comments. You can create a follow-up.");

		AssertTextEquals(
			locator1 = "ZendeskRequestView#CREATE_FOLLOW_UP_LINK",
			value1 = "create a follow-up");
	}

	@prose = "I should be able to view a request comment containing the text ${commentContent} with the following details ${table}"
	macro viewComment {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_AUTHOR",
					value1 = "${value}",
					key_commentContent = "${commentContent}");
			}
			else if ("${field}" == "Comment") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_CONTENT",
					value1 = "${value}",
					key_commentContent = "${commentContent}");
			}
			else if ("${field}" == "Partial Comment") {
				AssertTextEquals.assertPartialText(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_CONTENT",
					value1 = "${value}",
					key_commentContent = "${commentContent}");
			}
			else if ("${field}" == "Attachments") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_ATTACHMENT",
					value1 = "${value}",
					key_commentContent = "${commentContent}",
					key_attachmentName = "${value}");
			}
			else {
				fail("No such request comment field ${field}");
			}
		}
	}

	@prose = "I should see the request comment field"
	macro viewCommentField {
		AssertVisible(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");
		Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");
		AssertVisible(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_IFRAME");
		AssertVisible(locator1 = "ZendeskRequestView#SUBMIT_BUTTON");
	}

	@prose = "I should be able to view a request comment in position number ${positionValue} with the following details ${table}"
	macro viewCommentPosition {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_AUTHOR_POSITIONED",
					value1 = "${value}",
					key_positionValue = "${positionValue}");
			}
			else if ("${field}" == "Comment") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_CONTENT_POSITIONED",
					value1 = "${value}",
					key_positionValue = "${positionValue}");
			}
			else if ("${field}" == "Partial Comment") {
				AssertTextEquals.assertPartialText(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_CONTENT_POSITIONED",
					value1 = "${value}",
					key_positionValue = "${positionValue}");
			}
			else if ("${field}" == "Attachments") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_ATTACHMENT_POSITIONED",
					value1 = "${value}",
					key_positionValue = "${positionValue}",
					key_attachmentName = "${value}");
			}
			else {
				fail("No such request comment field ${field}");
			}
		}
	}

	@prose = "I download the attached file ${fileName} on position ${positionValue}"
	macro downloadAttachedFile {
		Click(
			locator1 = "ZendeskRequestView#REQUEST_COMMENT_ATTACHMENT_POSITIONED",
			key_positionValue = "${positionValue}",
			key_attachmentName = "${fileName}");

		DownloadTempFile();
	}

	@prose = "I should see the Description text field"
	macro viewDescriptionTextField {
		SelectFrame(locator1 = "ZendeskRequestAdd#DESCRIPTION_FIELD_IFRAME");

		AssertVisible(locator1 = "ZendeskRequestAdd#DESCRIPTION_FIELD");

		SelectFrameTop();
	}

	@prose = "I should see the ${dropdownLabel} dropdown"
	macro viewDropdownMenu {
		AssertVisible(
			locator1 = "ZendeskRequestAdd#DROPDOWN_LINK",
			key_dropdownLabel = "${dropdownLabel}");
	}

	@prose = "the ${dropdownLabel} dropdown should not be present"
	macro viewDropdownMenuNotPresent {
		AssertElementNotPresent(
			locator1 = "ZendeskRequestAdd#DROPDOWN_LINK",
			key_dropdownLabel = "${dropdownLabel}");
	}

	@prose = "the ${dropdownLabel} dropdown should not be visible"
	macro viewDropdownMenuNotVisible {
		AssertNotVisible(
			locator1 = "ZendeskRequestAdd#DROPDOWN_LINK",
			key_dropdownLabel = "${dropdownLabel}");
	}

	@prose = "I should be able to view a large file comment containing the text ${commentContent} with the following details ${table}"
	macro viewLargeFileComment {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ZendeskRequestView#REQUEST_COMMENT_AUTHOR",
					value1 = "${value}",
					key_commentContent = "${commentContent}");
			}
			else if ("${field}" == "Comment") {
				AssertTextEquals.assertPartialText(
					locator1 = "ZendeskRequestView#REQUEST_LARGE_FILE_COMMENT_CONTENT",
					value1 = "${value}",
					key_commentContent = "${commentContent}");
			}
			else if ("${field}" == "Attachment") {
				AssertTextEquals.assertPartialText(
					locator1 = "ZendeskRequestView#REQUEST_LARGE_FILE_COMMENT_ATTACHMENT",
					value1 = "${value}",
					key_commentContent = "${commentContent}",
					key_fileName = "${value}");
			}
			else {
				fail("No such large file request comment field ${field}");
			}
		}
	}

	@prose = "I should be able to view the large file attachment warning on the request add page"
	macro viewLargeFileWarningViaAddPage {
		AssertTextEquals(
			locator1 = "ZendeskRequestAdd#LARGE_FILE_ATTACHMENT_WARNING",
			value1 = "Please enter the details of your request. For files over 50 MB, please use the large file uploader displayed after you submit your request. A member of our support staff will respond as soon as possible.");
	}

	@prose = "I should be able to view the large file attachment warning on the request comment form"
	macro viewLargeFileWarningViaCommentForm {
		Click(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");

		AssertTextEquals.assertPartialText(
			locator1 = "ZendeskRequestView#REQUEST_COMMENT_LARGE_FILE_ATTACHMENT_WARNING",
			value1 = "For files over 50 MB, please use the large file uploader on the right hand side.");
	}

	@prose = "I should not see the closed comment message"
	macro viewNoClosedCommentMessage {
		AssertElementNotPresent(locator1 = "ZendeskRequestView#REQUEST_CLOSED_COMMENT_MESSAGE");
		AssertElementNotPresent(locator1 = "ZendeskRequestView#CREATE_FOLLOW_UP_LINK");
	}

	@prose = "I should not see the request comment field"
	macro viewNoCommentField {
		AssertElementNotPresent(locator1 = "ZendeskRequestView#REQUEST_COMMENT_FIELD");
		AssertElementNotPresent(locator1 = "ZendeskRequestView#REQUEST_COMMENT_TEXT_IFRAME");
		AssertElementNotPresent(locator1 = "ZendeskRequestView#SUBMIT_BUTTON");
	}

	@prose = "I should not see the ${dropdownLabel} dropdown"
	macro viewNoDropdownMenu {
		AssertElementNotPresent(
			locator1 = "ZendeskRequestAdd#DROPDOWN_LINK",
			key_dropdownLabel = "${dropdownLabel}");
	}

	@prose = "I should not see the follow up link"
	macro viewNoFollowUpLink {
		AssertElementNotPresent(locator1 = "ZendeskRequestView#CREATE_FOLLOW_UP_LINK");
	}

	@prose = "I should not see the large attachment link"
	macro viewNoLargeAttachmentLink {
		AssertNotVisible(locator1 = "ZendeskRequestView#LARGE_ATTACHMENT_LINK");
	}

	@prose = "I should not see the ${value} option"
	macro viewNoOption {
		AssertElementNotPresent(
			locator1 = "ZendeskRequestAdd#OPTION",
			key_option = "${value}");
	}

	@prose = "the following options should not be present ${table}"
	macro viewNoOptionList {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var value = "${row[0]}";

			AssertElementNotPresent(
				locator1 = "ZendeskRequestAdd#OPTION",
				key_option = "${value}");
		}
	}

	@prose = "the request form should not be available"
	macro viewNoRequestForm {
		AssertTextEquals(
			locator1 = "ZendeskRequestAdd#NO_ACCESS_MESSAGE_MAIN_TEXT",
			value1 = "We are sorry, but you do not have access to submit a support ticket.");

		AssertTextEquals(
			locator1 = "ZendeskRequestAdd#NO_ACCESS_MESSAGE_ADDITIONAL_TEXT",
			value1 = "Please contact your account administrator or email support.");

		AssertTextEquals(
			locator1 = "ZendeskRequestAdd#NO_ACCESS_MESSAGE_EMAIL_LINK",
			value1 = "email support.");

		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#ORGANIZATION_DROPDOWN_LINK");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#PRODUCT_DROPDOWN_LINK");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#COMPONENT_DROPDOWN_LINK");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#SYSTEM_STATUS_DROPDOWN_LINK");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#SUBJECT_FIELD");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#DESCRIPTION_FIELD_IFRAME");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD_LINK");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#ATTACHMENTS_FIELD");
		AssertElementNotPresent(locator1 = "ZendeskRequestAdd#SUBMIT_BUTTON");
	}

	@prose = "I should not see a request with the subject ${requestSubject} in the index"
	macro viewNoRequestViaIndex {
		AssertElementNotPresent(
			locator1 = "ZendeskRequestIndex#REQUEST_SUBJECT",
			value1 = "${requestSubject}",
			key_requestSubject = "${requestSubject}");
	}

	@prose = "the following options should not be visible ${table}"
	macro viewNoVisibleOptionList {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var value = "${row[0]}";

			AssertNotVisible(
				locator1 = "ZendeskRequestAdd#OPTION",
				key_option = "${value}");
		}
	}

	@prose = "I should see the following options ${table}"
	macro viewOptionList {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var value = "${row[0]}";

			if (IsVisible(locator1 = "ZendeskRequestAdd#OPTION", key_option = "${value}")) {
				AssertVisible(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
			}
			else {
				AssertElementPresent(
					locator1 = "ZendeskRequestAdd#OPTION",
					key_option = "${value}");
			}
		}
	}

	@prose = "I should see the Subject text field"
	macro viewSubjectTextField {
		AssertVisible(locator1 = "ZendeskRequestAdd#SUBJECT_FIELD");
	}

	@prose = "I should see a request with the subject ${requestSubject} in the index with the following details ${table}"
	macro viewViaIndex {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Subject") {
				AssertTextEquals(
					locator1 = "ZendeskRequestIndex#REQUEST_SUBJECT",
					value1 = "${value}",
					key_requestSubject = "${requestSubject}");
			}
			else if ("${field}" == "Id") {
				AssertTextEquals(
					locator1 = "ZendeskRequestIndex#REQUEST_ID",
					value1 = "${value}",
					key_requestSubject = "${requestSubject}");
			}
			else if ("${field}" == "Created") {
				AssertTextEquals(
					locator1 = "ZendeskRequestIndex#REQUEST_CREATED",
					value1 = "${value}",
					key_requestSubject = "${requestSubject}");
			}
			else if ("${field}" == "Last activity") {
				AssertTextEquals(
					locator1 = "ZendeskRequestIndex#REQUEST_LAST_ACTIVITY",
					value1 = "${value}",
					key_requestSubject = "${requestSubject}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ZendeskRequestIndex#REQUEST_STATUS",
					value1 = "${value}",
					key_requestSubject = "${requestSubject}");
			}
			else {
				fail("No such request index field ${field}");
			}
		}
	}
}