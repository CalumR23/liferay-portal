definition {

	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getSLANameById {
		var curl = '''
			${zendeskURL}/api/v2/organization_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var slaName = JSONCurlUtil.get("${curl}", "$.organization_fields[?(@.title=='SLA')].custom_field_options[?(@.id==${slaId})].name");

		var slaName = StringUtil.replace("${slaName}", "[", "");

		var slaName = StringUtil.replace("${slaName}", "]", "");

		var slaName = StringUtil.replace("${slaName}", "\"", "");

		return "${slaName}";
	}

	macro _getSubOrganizationIdByName {
		var curl = '''
			${zendeskURL}/api/v2/organization_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var subOrganizationId = JSONCurlUtil.get("${curl}", "$.organization_fields[?(@.title=='Sub Organization')].custom_field_options[?(@.name=='${subOrganizationName}')].id");

		var subOrganizationId = StringUtil.replace("${subOrganizationId}", "[", "");

		var subOrganizationId = StringUtil.replace("${subOrganizationId}", "]", "");

		var subOrganizationId = StringUtil.replace("${subOrganizationId}", "\"", "");

		return "${subOrganizationId}";
	}

