		var curl = '''
			${zendeskURL}/api/v2/organization_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var subOrganizationName = JSONCurlUtil.get("${curl}", "$.organization_fields[?(@.title=='Sub Organization')].custom_field_options[?(@.id==${subOrganizationId})].name");

		var subOrganizationName = StringUtil.replace("${subOrganizationName}", "[", "");

		var subOrganizationName = StringUtil.replace("${subOrganizationName}", "]", "");

		var subOrganizationName = StringUtil.replace("${subOrganizationName}", "\"", "");

		return "${subOrganizationName}";
	}

	macro _getSupportRegionIdByName {
		var curl = '''
			${zendeskURL}/api/v2/organization_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var supportRegionId = JSONCurlUtil.get("${curl}", "$.organization_fields[?(@.title=='Support Region')].custom_field_options[?(@.name=='${supportRegionName}')].id");

		var supportRegionId = StringUtil.replace("${supportRegionId}", "[", "");

		var supportRegionId = StringUtil.replace("${supportRegionId}", "]", "");

		var supportRegionId = StringUtil.replace("${supportRegionId}", "\"", "");

		return "${supportRegionId}";
	}

	macro _getSupportRegionNameById {
		var curl = '''
			${zendeskURL}/api/v2/organization_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var supportRegionName = JSONCurlUtil.get("${curl}", "$.organization_fields[?(@.title=='Support Region')].custom_field_options[?(@.id==${supportRegionId})].name");

		var supportRegionName = StringUtil.replace("${supportRegionName}", "[", "");

		var supportRegionName = StringUtil.replace("${supportRegionName}", "]", "");

		var supportRegionName = StringUtil.replace("${supportRegionName}", "\"", "");

		return "${supportRegionName}";
	}

	macro _viewOrganizationSearchResultsByExternalID {
		var curl = '''
			${zendeskURL}/api/v2/organizations/search.json?external_id=${organizationExternalId} --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizations = JSONCurlUtil.get("${curl}", "$.organizations");

		return "${organizations}";
	}

}