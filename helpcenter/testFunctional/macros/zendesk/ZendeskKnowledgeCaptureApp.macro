definition {
	var articleListUrl = "https://liferaysupport1528999723.zendesk.com/knowledge/lists/";

    @prose = "I click on the apps button"
	macro clickAppsbutton {
		ZendeskHomepage.pause(timeInSeconds = "5");

		if (IsElementNotPresent(locator1 = "ZendeskTicketView#HIDE_APPS_BUTTON")) {
			Click(locator1 = "ZendeskTicketView#APPS_BUTTON");
		}
    }

    @prose = "I create an Article with the following values ${table}"
	macro createFastTrackArticle {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Ticket ID") {
				var ticketId = "${value}";
			}
            else if ("${field}" == "Template") {
				var articleTemplate = "${value}";

				if (("${articleTemplate}" == "DXPC Fast Track Article") || ("${articleTemplate}" == "Fast Track Article")) {
					echo("${articleTemplate} is a valid template");
				}
				else {
					fail("No such template ${field}");
				}
			}
			else if ("${field}" == "Name") {
				var articleName = "${value}";
			}
			else if ("${field}" == "Description") {
				var articleDescription = "${value}";				
			}
			else if ("${field}" == "Review Status") {
				var reviewStatus = "${value}";				
			}
			else {
				fail("No such field ${field}");
			}
		}

		ZendeskTicket.gotoViaId(ticketId = "${ticketId}");

		ZendeskKnowledgeCaptureApp.clickAppsbutton();

		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_KNOWLEDGE");

		Click(locator1 = "ZendeskKnowledgeCaptureApp#CREATE_KNOWLEDGE");

		ScrollWebElementIntoView(locator1 = "ZendeskKnowledgeCaptureApp#TEMPLATE_DXPCFASTTRACKARTICLE");

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_KNOWLEDGE");

        if ("${articleTemplate}" == "DXPC Fast Track Article") {
            Click(locator1 = "ZendeskKnowledgeCaptureApp#TEMPLATE_DXPCFASTTRACKARTICLE");
        }
        else if ("${articleTemplate}" == "Fast Track Article") {
		    Click(locator1 = "ZendeskKnowledgeCaptureApp#TEMPLATE_FASTTRACKARTICLE");
        }
		
		WaitForSPARefresh();

		SelectFrameTop();

        if ("${articleTemplate}" == "DXPC Fast Track Article") {
		    SelectWindow(locator1 = "New DXP Cloud Article");
        }
        else if ("${articleTemplate}" == "Fast Track Article") {
		    SelectWindow(locator1 = "Fast Track Article");
        }
		
		AssertElementPresent(locator1 = "ZendeskKnowledgeCaptureApp#EDIT_ARTICLE_NAME");

		Click(locator1 = "ZendeskKnowledgeCaptureApp#EDIT_ARTICLE_NAME");

		KeyPress.keyDown(
			locator1 = "ZendeskKnowledgeCaptureApp#INPUT_ARTICLE_NAME",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKnowledgeCaptureApp#INPUT_ARTICLE_NAME",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKnowledgeCaptureApp#INPUT_ARTICLE_NAME",
			value1 = "${articleName}");

		KeyPress.keyUp(
			locator1 = "ZendeskKnowledgeCaptureApp#INPUT_ARTICLE_NAME",
			value1 = "\CONTROL");

		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_ARTICLE_DESCRIPTION");

		Click(locator1 = "ZendeskKnowledgeCaptureApp#DESCRIPTION_TEMPLATE_ARTICLE");

		KeyPress.keyDown(
			locator1 = "ZendeskKnowledgeCaptureApp#DESCRIPTION_TEMPLATE_ARTICLE",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "ZendeskKnowledgeCaptureApp#DESCRIPTION_TEMPLATE_ARTICLE",
			value1 = "a");

		Type.sendKeys(
			locator1 = "ZendeskKnowledgeCaptureApp#DESCRIPTION_TEMPLATE_ARTICLE",
			value1 = "${articleDescription}");

		KeyPress.keyUp(
			locator1 = "ZendeskKnowledgeCaptureApp#DESCRIPTION_TEMPLATE_ARTICLE",
			value1 = "\CONTROL");

		SelectFrameTop();

		SelectWindow(locator1 = "${articleName}");

		Click(locator1 = "ZendeskKnowledgeCaptureApp#SAVE_ARTICLE");

		if ("${reviewStatus}" == "Published") {
		    Click(locator1 = "ZendeskKnowledgeCaptureApp#OPTION_TEMPLATE");

			Click(locator1 = "ZendeskKnowledgeCaptureApp#PUBLISH_ARTICLE");
        }
	}

	@prose = "I go to the Articles List and I check if article ${articleName} has the Review Status ${reviewStatus}"
	macro checkArticleReviewStatus {
		Open(locator1 = "${articleListUrl}");

		ZendeskHomepage.pause(timeInSeconds = "5");

		if (IsElementPresent(locator1 = "ZendeskKnowledgeCaptureApp#BUTTON_GOT_IT")) {
			Click(locator1 = "ZendeskKnowledgeCaptureApp#BUTTON_GOT_IT");
		}
		
		Type(
			locator1 = "ZendeskKnowledgeCaptureApp#SEARCH_ARTICLE",
			value1 = "${articleName}");

		KeyPress(
			locator1 = "ZendeskKnowledgeCaptureApp#SEARCH_ARTICLE",
			value1 = "\ENTER");

		AssertElementPresent(
			locator1 = "ZendeskKnowledgeCaptureApp#STATUS_ARTICLE",
			articleName = "${articleName}",
			reviewStatus = "${reviewStatus}");
	}

	@prose = "I view an article with name ${articleName} and description ${articleDescription}"
	macro viewArticle {
		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_KNOWLEDGE");

		if (IsElementPresent(locator1 = "ZendeskKnowledgeCaptureApp#CLOSE_CREATE_KNOWLEDGE")) {
			Click(locator1 = "ZendeskKnowledgeCaptureApp#CLOSE_CREATE_KNOWLEDGE");
		}

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_KNOWLEDGE");

		Type(
			locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_SEARCH_ARTICLE",
			value1 = "${articleName}");

		KeyPress(
			locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_SEARCH_ARTICLE",
			value1 = "\ENTER");

		Click(
			locator1 = "ZendeskKnowledgeCaptureApp#KNOWLEDGE_ARTICLE_NAME",
			articleName = "${articleName}");

		SelectFrameTop();

		SelectFrame(locator1 = "ZendeskKnowledgeCaptureApp#IFRAME_KNOWLEDGE_POPUP");

		AssertElementPresent(
			locator1 = "ZendeskKnowledgeCaptureApp#KNOWLEDGE_POPUP_NAME",
			articleName = "${articleName}");

		AssertElementPresent(
			locator1 = "ZendeskKnowledgeCaptureApp#KNOWLEDGE_POPUP_DESCRIPTION",
			articleDescription = "${articleDescription}");

		SelectFrameTop();

		Click(locator1 = "ZendeskKnowledgeCaptureApp#CLOSE_ARTICLE");
	}

	@prose = "I teardown articles with the following names from zendesk.liferay.com ${table}"
	macro _tearDownArticlesByName {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var articleName = "${row[0]}";

			Open(locator1 = "${articleListUrl}");

			ZendeskHomepage.pause(timeInSeconds = "5");

			if (IsElementPresent(locator1 = "ZendeskKnowledgeCaptureApp#BUTTON_GOT_IT")) {
				Click(locator1 = "ZendeskKnowledgeCaptureApp#BUTTON_GOT_IT");
			}
		
			Type(
				locator1 = "ZendeskKnowledgeCaptureApp#SEARCH_ARTICLE",
				value1 = "${articleName}");

			KeyPress(
				locator1 = "ZendeskKnowledgeCaptureApp#SEARCH_ARTICLE",
				value1 = "\ENTER");

			if (IsElementPresent(locator1 = "ZendeskKnowledgeCaptureApp#ASSERT_ARTICLE", articleName = "${articleName}")) {
				Click(locator1 = "ZendeskKnowledgeCaptureApp#SELECT_ARTICLE",
					value1 = "${articleName}");

				Click(locator1 = "ZendeskKnowledgeCaptureApp#ARTICLE_SETTINGS",
					value1 = "${articleName}");

				Click(locator1 = "ZendeskKnowledgeCaptureApp#ARTICLE_SETTINGS_DELETE",
					value1 = "${articleName}");

				Click(locator1 = "ZendeskKnowledgeCaptureApp#ARTICLE_SETTINGS_CONFIRMDELETE");
			}

		}
	}
	
}