definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var supportURL = PropsUtil.get("support.liferay.url");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	@prose = "I assign an organization ${organizationName} with the following tags while replacing existing tags ${table}"
	macro _assignAndReplaceTagsToOrganization {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var tag = "${row[0]}";

			if (contains("${tagList}", "{tagList}")) {
				var tagList = "${tag}";
			}
			else {
				var tagList = "${tagList},${tag}";
			}
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/${organizationId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization":
				{
					"tags": "${tagList}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I assign an organization ${organizationName} with the following tags ${table}"
	macro _assignTagsToOrganization {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByExternalId(organizationExternalId = "${organizationExternalId}");
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var tag = "${row[0]}";

			if (contains("${tagList}", "{tagList}")) {
				var tagList = "${tag}";
			}
			else {
				var tagList = "${tagList},${tag}";
			}
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/${organizationId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization":
				{
					"tags": "${tagList},${existingTags}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I assign an organization with organizationExternalId ${organizationExternalId} with the following tags ${table}"
	macro _assignTagsToOrganizationViaOrganizationExternalID {
		var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByExternalId(organizationExternalId = "${organizationExternalId}");
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var tag = "${row[0]}";

			if (contains("${tagList}", "{tagList}")) {
				var tagList = "${tag}";
			}
			else {
				var tagList = "${tagList},${tag}";
			}
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/${organizationId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization":
				{
					"tags": "${tagList},${existingTags}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I create an organization with the following values ${table}"
	macro _createOrganization {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var organizationName = "${value}";
			}
			else if ("${field}" == "Tags") {
				var tags = "${value}";
			}
			else if ("${field}" == "Shared Tickets") {
				var sharedTicketsEnabled = "${value}";
			}
			else if ("${field}" == "Shared Comments") {
				var sharedCommentsEnabled = "${value}";
			}
			else if ("${field}" == "Status") {
				var status = "${value}";
			}
			else if ("${field}" == "SLA") {
				var sla = "${value}";
			}
			else if ("${field}" == "Tier") {
				var tier = "${value}";
			}
			else if ("${field}" == "Support Region") {
				var supportRegion = "${value}";
			}
			else if ("${field}" == "Support Language") {
				var supportLanguage = "${value}";
			}
			else if ("${field}" == "Partner First Line Support") {
				var partnerFirstLineSupportEnabled = "${value}";
			}
			else if ("${field}" == "Partner Organization Name") {
				var partnerOrganization = "${value}";
			}
			else if ("${field}" == "Partner Jira Project") {
				var partnerJiraProject = "${value}";
			}
			else if ("${field}" == "Partner") {
				var partnerEnabled = "${value}";
			}
			else if ("${field}" == "External ID") {
				var externalId = "${value}";
			}
			else if ("${field}" == "Sub Organization") {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "_");

				var subOrganization = "${value}";
			}
			else {
				fail("No such organization field ${field}");
			}
		}

		if (!(isSet(organizationName))) {
			var organizationName = "";
		}
		if (!(isSet(tags))) {
			var tags = "";
		}
		if (!(isSet(sharedTicketsEnabled))) {
			var sharedTicketsEnabled = "false";
		}
		if (!(isSet(sharedCommentsEnabled))) {
			var sharedCommentsEnabled = "false";
		}
		if (!(isSet(status))) {
			var status = "";
		}
		if (!(isSet(sla))) {
			var sla = "";
		}
		if (!(isSet(tier))) {
			var tier = "";
		}
		if (!(isSet(supportRegion))) {
			var supportRegion = "";
		}
		if (!(isSet(supportLanguage))) {
			var supportLanguage = "";
		}
		if (!(isSet(partnerFirstLineSupportEnabled))) {
			var partnerFirstLineSupportEnabled = "";
		}
		if (!(isSet(partnerOrganization))) {
			var partnerOrganization = "";
		}
		if (!(isSet(partnerJiraProject))) {
			var partnerJiraProject = "";
		}
		if (!(isSet(partnerEnabled))) {
			var partnerEnabled = "";
		}
		if (!(isSet(externalId))) {
			var externalId = "";
		}
		if (!(isSet(subOrganization))) {
			var subOrganization = "";
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization":
				{
					"name": "${organizationName}",
					"tags": "${tags}",
					"shared_tickets": "${sharedTicketsEnabled}",
					"shared_comments": "${sharedCommentsEnabled}",
					"external_id": "${externalId}",
					"organization_fields":
					{
						"status": "${status}",
						"sla": "${sla}",
						"tier": "${tier}",
						"support_region": "${supportRegion}",
						"support_language": "${supportLanguage}",
						"partner_first_line_support": "${partnerFirstLineSupportEnabled}",
						"partner_organization": "${partnerOrganization}",
						"partner_jira_project": "${partnerJiraProject}",
						"partner": "${partnerEnabled}",
						"sub_organization": "${subOrganization}"
					}
				}
			}
			''';

		static var staticOrganizationID = JSONCurlUtil.post("${curl}", "$.organization.id");

		echo("Organization ID: ${staticOrganizationID}");

		return "${staticOrganizationID}";
	}

	@prose = "I obtain the external IDs of the following organizations from zendesk.liferay.com if still present ${table}"
	macro _getMultipleOrganizationExternalIdsByOrganizationNameIfStillPresent {
		var organizationCount = "0";
		var organizationExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var organizationName = "${row[0]}";

			var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");

			var currentIteration = "0";

			while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${organizations}" == "[]"))) {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");
			}

			if (!("${organizations}" == "[]")) {
				var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

				if("${organizationCount}" == "0") {
					var organizationExternalIds = "${organizationExternalIds}${organizationExternalId}";
				}
				else {
					var organizationExternalIds = "${organizationExternalIds},${organizationExternalId}";
				}
				var organizationCount = MathUtil.sum("${organizationCount}", "1");
			}
		}

		static var staticOrganizationExternalIdList = "${organizationExternalIds}";

		echo("Organization External IDs: ${staticOrganizationExternalIdList}");

		return "${staticOrganizationExternalIdList}";
	}

	@prose = "I obtain the account code of the organization ${organizationName} from zendesk.liferay.com"
	macro _getOrganizationAccountCodeByOrganizationName {
		var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationAccountCode = JSONCurlUtil.get("${curl}", "$.organizations[0].organization_fields.account_code");

		return "${organizationAccountCode}";
	}

	@prose = "I obtain the external ID of the organization ${organizationName} from zendesk.liferay.com"
	macro _getOrganizationExternalIdByOrganizationName {
		var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationExternalId = JSONCurlUtil.get("${curl}", "$.organizations[0].external_id");

		return "${organizationExternalId}";
	}

	@prose = "I get the organization ID of the organization ${organizationName} from zendesk.liferay.com"
	macro _getOrganizationIdByOrganizationName {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationID = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		static var staticOrganizationID = "${organizationID}";
		
		echo("Organization ID: ${staticOrganizationID}");

		return "${staticOrganizationID}";
	}

	@prose = "I teardown the organization with organizationId ${staticOrganizationId} from zendesk.liferay.com"
	macro _tearDownOrganizationById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/${staticOrganizationID}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I teardown organizations with the following organizationExternalIds ${organizationExternalIds} from zendesk.liferay.com"
	macro _tearDownOrganizationsByExternalIdList {
		if ((!(contains("${organizationExternalIds}", "{organizationExternalIds}"))) && (!("${organizationExternalIds}" == ""))) {
			for (var organizationExternalId : list "${organizationExternalIds}") {
				var curl = '''
					${supportURL}/api/jsonws/osb.accountentry/delete-account-entry
					-u ${supportAdminEmailAddress}:${supportAdminPassword}
					-d accountEntryId=${organizationExternalId}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/organizations/destroy_many.json?external_ids=${organizationExternalIds}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var statusUrl = JSONCurlUtil.delete("${curl}", "$.job_status.url");

			var curl = '''
				--tlsv1.2 ${statusUrl}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var status = JSONCurlUtil.get("${curl}", "$.job_status.status");

			if (!("${status}" == "completed")) {
				if (("${status}" == "queued") || ("${status}" == "working")) {
					while (("${status}" == "queued") || ("${status}" == "working")) {
						ZendeskHomepage.pause(timeInSeconds = "2");

						var curl = '''
							--tlsv1.2 ${statusUrl}
							-u ${zendeskAdminEmail}/token:${apiToken}
							''';

						var status = JSONCurlUtil.get("${curl}", "$.job_status.status");
					}
					if (!("${status}" == "completed")) {
						echo("Warning: The organization tear down may have failed");
						echo("Tear Down Job Status: ${status}");
					}
				}
				else {
					echo("Warning: The organization tear down may have failed");
					echo("Tear Down Job Status: ${status}");
				}
			}
		}
	}

	@prose = "I teardown organizations with the following organizationExternalIds from zendesk.liferay.com ${table}"
	macro _tearDownOrganizationsByExternalIdTable {
		var organizationCount = "0";
		var organizationExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var organizationExternalId = "${row[0]}";

			if("${organizationCount}" == "0") {
				var organizationExternalIds = "${organizationExternalIds}${organizationExternalId}";
			}
			else {
				var organizationExternalIds = "${organizationExternalIds},${organizationExternalId}";
			}

			var organizationCount = MathUtil.sum("${organizationCount}", "1");
		}

		ZendeskOrganizationAPI._tearDownOrganizationsByExternalIdList(organizationExternalIds = "${organizationExternalIds}");
	}

	macro _viewOrganizationExistingFieldValueByName {
		var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

		var field = StringUtil.lowerCase("${field}");

		var field = StringUtil.replace("${field}", " ", "_");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		if ((!("${field}" == "name")) && (!("${field}" == "details"))) {
			var value = JSONCurlUtil.get("${curl}", "$.organizations[0].organization_fields.${field}");
		}
		else {
			var value = JSONCurlUtil.get("${curl}", "$.organizations[0].${field}");
		}

		var value = StringUtil.replace("${value}", "[", "");

		var value = StringUtil.replace("${value}", "]", "");

		var value = StringUtil.replace("${value}", "&quot;", "");

		return "${value}";
	} 

	macro _viewOrganizationExistingTagsByExternalId {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/search.json?external_id=${organizationExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.organizations[0].tags");

		var existingTags = StringUtil.replace("${existingTags}", "[", "");

		var existingTags = StringUtil.replace("${existingTags}", "]", "");

		var existingTags = StringUtil.replace("${existingTags}", "&quot;", "");

		return "${existingTags}";
	}

	macro _viewOrganizationExistingTagsByName {
		var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.organizations[0].tags");

		var existingTags = StringUtil.replace("${existingTags}", "[", "");

		var existingTags = StringUtil.replace("${existingTags}", "]", "");

		var existingTags = StringUtil.replace("${existingTags}", "&quot;", "");

		return "${existingTags}";
	}

	@prose = "the organization with organizationExternalId ${organizationExternalId} on zendesk.liferay.com should have the name ${organizationName}"
	macro _viewOrganizationNameByExternalId {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/search.json?external_id=${organizationExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationNameFromAPI = JSONCurlUtil.get("${curl}", "$.organizations[0].name");

		echo("Expected Organization Name: ${organizationName}");
		echo("Actual Organization Name: ${organizationNameFromAPI}");

		if (!("${organizationNameFromAPI}" == "${organizationName}")) {
			fail("Actual value ${organizationNameFromAPI} does not match expected value ${organizationName}");
		}
	}

	macro _viewOrganizationIdByExternalId {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/search.json?external_id=${organizationExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationID = JSONCurlUtil.get("${curl}", "$.organizations[0].id");

		return "${organizationID}";
	}

	@prose = "the organization ${organizationName} should not be present on zendesk.liferay.com"
	macro _viewOrganizationNoSyncFromOsb {
		var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${organizations}" == "[]"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");
		}

		echo("Non-expected Organization Name: ${organizationName}");
		echo("Actual Organization Search Results: ${organizations}");

		if (!("${organizations}" == "[]")) {
			var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var organizationNameFromAPI = JSONCurlUtil.get("${curl}", "$.organizations[0].name");

			if ("${organizationNameFromAPI}" == "${organizationName}") {
				fail("The organization ${organizationName} appears to have been added to zendesk in spite of there not being an expectation to do so.");
			}
		}
	}

	@prose = "the organization ${organizationName} should not have the tag ${tag}"
	macro _viewOrganizationNoTagSync {
		var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByName(organizationName = "${organizationName}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (contains("${existingTags}", "${tag}"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByName(organizationName = "${organizationName}");
		}

		echo("Non-expected Organization Tag: ${tag}");
		echo("Actual Organization Tags: ${existingTags}");

		if (contains("${existingTags}", "${tag}")) {
			fail("After ${currentIteration} checks, actual organization tags ${existingTags} shows that the organization ${organizationName} does has the unexpected tag ${tag}");
		}
	}

	macro _viewOrganizationSearchResultsByName {
		var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizations = JSONCurlUtil.get("${curl}", "$.organizations");

		return "${organizations}";
	} 

	@prose = "the organization ${organizationName} should be present on zendesk.liferay.com"
	macro _viewOrganizationSyncFromOsb {
		var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && ("${organizations}" == "[]")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");
		}

		if (!("${organizations}" == "[]")) {
			var organizationNameNoSpaces = StringUtil.replace("${organizationName}", " ", "+");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/organizations/autocomplete.json?name=${organizationNameNoSpaces}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var organizationNameFromAPI = JSONCurlUtil.get("${curl}", "$.organizations[0].name");
		}
		else {
			fail("After ${currentIteration} attempts while waiting at ${pollIntervalInSeconds} in between each attempt, the OSB to Zendesk sync for ${organizationName} appears to have been unsuccessful");
		}

		echo("Expected Organization Name: ${organizationName}");
		echo("Actual Organization Name: ${organizationNameFromAPI}");

		if (!("${organizationNameFromAPI}" == "${organizationName}")) {
			fail("Actual value ${organizationNameFromAPI} does not match expected value ${organizationName}. There may be something wrong with Zendesk search or there may be similar data or the sync may have unsuccessful");
		}
	}

	@prose = "the organization ${organizationName} should have the tag ${tag}"
	macro _viewOrganizationTagSync {
		var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByName(organizationName = "${organizationName}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!(contains("${existingTags}", "${tag}")))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var existingTags = ZendeskOrganizationAPI._viewOrganizationExistingTagsByName(organizationName = "${organizationName}");
		}

		echo("Expected Organization Tag: ${tag}");
		echo("Actual Organization Tags: ${existingTags}");

		if (!(contains("${existingTags}", "${tag}"))) {
			fail("After ${currentIteration} checks, actual organization tags ${existingTags} shows that the organization ${organizationName} does not have the expected tag ${tag}");
		}
	}

	@prose = "the organization ${organizationName} should have the following parameters ${table}"
	macro _viewOrganizationParameterSync {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ((!("${field}" == "Name")) && (!("${field}" == "Details")) && (!("${field}" == "Account Code")) && (!("${field}" == "Partner Organization"))) {
				var value = StringUtil.lowerCase("${value}");

				var value = StringUtil.replace("${value}", " ", "_");
			}

			var valueFromAPI = ZendeskOrganizationAPI._viewOrganizationExistingFieldValueByName(organizationName = "${organizationName}", field = "${field}");

			var currentIteration = "0";

			while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!(contains("${valueFromAPI}", "${value}")))) {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

				var valueFromAPI = ZendeskOrganizationAPI._viewOrganizationExistingFieldValueByName(organizationName = "${organizationName}", field = "${field}");
			}

			echo("Expected Organization Value for ${field}: ${value}");
			echo("Actual Organization Value for ${field}: ${valueFromAPI}");

			if (!(contains("${valueFromAPI}", "${value}"))) {
				fail("After ${currentIteration} checks, actual organization value for ${field} ${valueFromAPI} shows that the organization ${organizationName} does not have the expected value for ${field} ${value}");
			}
		}
	}
}