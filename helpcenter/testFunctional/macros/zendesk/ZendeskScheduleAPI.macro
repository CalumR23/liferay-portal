definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getScheduleIdByName {
		var curl = '''
			${zendeskURL}/api/v2/business_hours/schedules.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var scheduleId = JSONCurlUtil.get("${curl}", "$.schedules[?(@.name=='${scheduleName}')].id");

		var scheduleId = StringUtil.replace("${scheduleId}", "[", "");

		var scheduleId = StringUtil.replace("${scheduleId}", "]", "");

		var scheduleId = StringUtil.replace("${scheduleId}", "&quot;", "");

		return "${scheduleId}";
	}

	macro _getScheduleNameById {
		var curl = '''
			${zendeskURL}/api/v2/business_hours/schedules/${scheduleId}.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var scheduleName = JSONCurlUtil.get("${curl}", "$.schedule.name");

		var scheduleName = StringUtil.replace("${scheduleName}", "[", "");

		var scheduleName = StringUtil.replace("${scheduleName}", "]", "");

		var scheduleName = StringUtil.replace("${scheduleName}", "&quot;", "");

		return "${scheduleName}";
	}
}