definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getTicketFieldIdByName {
		var curl = '''
			${zendeskURL}/api/v2/ticket_fields.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var fieldId = JSONCurlUtil.get("${curl}", "$.ticket_fields[?(@.title=='${fieldName}')].id");

		var fieldId = StringUtil.replace("${fieldId}", "[", "");

		var fieldId = StringUtil.replace("${fieldId}", "]", "");

		var fieldId = StringUtil.replace("${fieldId}", "&quot;", "");

		return "${fieldId}";
	}
}