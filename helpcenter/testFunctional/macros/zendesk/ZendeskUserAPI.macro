			''';

		var count = JSONCurlUtil.get("${curl}", "$.count");

		var userNumber = "0";

		var userIds = "";

		while (!("${count}" == "${userNumber}")) {
			echo("Count: ${count}");
			echo("Current User Number: ${userNumber}");

			var userId = JSONCurlUtil.get("${curl}", "$.users[${userNumber}].id");

			if("${userIds}" == "") {
				var userIds = "${userId}";
			}
			else {
				var userIds = "${userIds},${userId}";
			}
			var userNumber = MathUtil.sum("${userNumber}", "1");
		}

		return "${userIds}";
	}

