definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	@prose = "I assign the user with the email address ${userEmailAddress} to the group ${groupName}"
	macro _assignUserToGroup {
		var groupId = ZendeskGroupAPI._getGroupIdByName(groupName = "${groupName}");
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/group_memberships.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"group_membership":
				{
					"default": true,
					"user_id": "${userId}",
					"group_id": "${groupId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I assign a user with the email address ${userEmailAddress} to an organization with organizationExternalId ${organizationExternalId}"
	macro _assignUserToOrganization {
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/organization_memberships.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization_membership":
				{
					"user_id": "${userId}",
					"organization_id": "${organizationId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I assign a user with the email address ${userEmailAddress} as a watcher on an organization with organizationExternalId ${organizationExternalId}"
	macro _assignWatcherRole {
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var tag = "osb_${organizationId}_watcher";

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");
		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"user":
				{
					"tags": "${tag},${existingTags}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I create a user with the following values ${table}"
	macro _createUser {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var userName = "${value}";
			}
			else if ("${field}" == "Role") {
				var role = "${value}";
			}
			else if ("${field}" == "Access") {
				var access = "${value}";
			}
			else if ("${field}" == "Email") {
				var email = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Tags") {
				var tags = "${value}";
			}
			else if ("${field}" == "Organization") {
				var organization = "${value}";
			}
			else if ("${field}" == "Language") {
				if("${value}" == "English") {
					var localeId = "1";
				}
				else if("${value}" == "Japanese") {
					var localeId = "67";
				}
				else if("${value}" == "Portuguese") {
					var localeId = "1011";
				}
				else if("${value}" == "Simplified Chinese") {
					var localeId = "10";
				}
				else if("${value}" == "Spanish") {
					var localeId = "2";
				}
				else {
					var localeId = "1";
				}
			}
			else if ("${field}" == "Time Zone") {
				var timeZone = "${value}";
			}
			else if ("${field}" == "Details") {
				var details = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "External ID") {
				var externalId = "${value}";
			}
			else if ("${field}" == "Password") {
				var password = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		if (!(isSet(userName))) {
			var userName = "";
		}
		if (!(isSet(role))) {
			var role = "";
		}
		if (!(isSet(access))) {
			var access = "";
		}
		if (!(isSet(email))) {
			var email = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(tags))) {
			var tags = "";
		}
		if (!(isSet(organization))) {
			var organization = "";
		}
		if (!(isSet(localeId))) {
			var localeId = "";
		}
		if (!(isSet(timeZone))) {
			var timeZone = "";
		}
		if (!(isSet(details))) {
			var details = "";
		}
		if (!(isSet(notes))) {
			var notes = "";
		}
		if (!(isSet(externalId))) {
			var externalId = "";
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/create_or_update.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"user":
				{
					"verified": true,
					"name": "${userName}",
					"role": "${role}",
					"ticket_restriction": "${access}",
					"email": "${email}",
					"phone": "${phoneNumber}",
					"tags": "${tags}",
					"locale_id": "${localeId}",
					"time_zone": "${timeZone}",
					"details": "${details}",
					"notes": "${notes}",
					"external_id": "${externalId}",
					"organization":
					{
						"name": "${organization}"
					}
				}
			}
			''';

		static var staticUserID = JSONCurlUtil.post("${curl}", "$.user.id");

		echo("User ID: ${staticUserID}");

		return "${staticUserID}";

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${staticUserID}/password.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"password":"${password}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I get the email address of the default user belonging to the organization ${organizationName} from zendesk.liferay.com"
	macro _getDefaultUserEmailAddress {
		var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");

		if (!("${organizations}" == "[]")) {
			var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

			static var staticUserEmailAddress = "no-reply@${organizationExternalId}.com.broken";

			echo("Default User Email Address of ${organizationName}: ${staticUserEmailAddress}");

			return "${staticUserEmailAddress}";

		}
		else {
			static var staticUserEmailAddress = "";

			echo("Default User Email Address of ${organizationName}: ${staticUserEmailAddress}");

			return "${staticUserEmailAddress}";
		}
	}

	@prose = "I get the ID of the default user belonging to the organization ${organizationName} from zendesk.liferay.com"
	macro _getDefaultUserId {
		var organizations = ZendeskOrganizationAPI._viewOrganizationSearchResultsByName(organizationName = "${organizationName}");

		if (!("${organizations}" == "[]")) {
			var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

			var userEmailAddress = "no-reply@${organizationExternalId}.com.broken";

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

			if (!("${users}" == "[]")) {
				var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

				static var staticDefaultUserId = "${userId}";

				echo("Default User ID of ${organizationName}: ${staticDefaultUserId}");

				return "${staticDefaultUserId}";
			}
			else {
				static var staticDefaultUserId = "";

				echo("Default User ID of ${organizationName}: ${staticDefaultUserId}");

				return "${staticDefaultUserId}";
			}
		}
		else {
			static var staticDefaultUserId = "";

			echo("Default User ID of ${organizationName}: ${staticDefaultUserId}");

			return "${staticDefaultUserId}";
		}
	}

	@prose = "I obtain the external IDs of the following user email addresses from zendesk.liferay.com ${table}"
	macro _getMultipleUserExternalIdsByEmailAddress {
		var userCount = "0";
		var userExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userEmailAddress = "${row[0]}";

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

			if (!("${users}" == "[]")) {
				var userExternalId = ZendeskUserAPI._viewUserExternalIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

				if("${userCount}" == "0") {
					var userExternalIds = "${userExternalIds}${userExternalId}";
				}
				else {
					var userExternalIds = "${userExternalIds},${userExternalId}";
				}

				var userCount = MathUtil.sum("${userCount}", "1");
			}
		}

		static var staticUserExternalIdList = "${userExternalIds}";

		echo("User External IDs: ${staticUserExternalIdList}");

		return "${staticUserExternalIdList}";
	}

	@prose = "I obtain the IDs of the following user email addresses from zendesk.liferay.com ${table}"
	macro _getMultipleUserIdsByEmailAddress {
		var userCount = "0";
		var userIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userEmailAddress = "${row[0]}";

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

			if (!("${users}" == "[]")) {
				var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

				if("${userCount}" == "0") {
					var userIds = "${userIds}${userId}";
				}
				else {
					var userIds = "${userIds},${userId}";
				}

				var userCount = MathUtil.sum("${userCount}", "1");
			}
		}

		static var staticUserIdList = "${userIds}";

		echo("User IDs: ${staticUserIdList}");

		return "${staticUserIdList}";
	}

	@prose = "I obtain the IDs of the following user names from zendesk.liferay.com ${table}"
	macro _getMultipleUserIdsByName {
		var userName = StringUtil.replace("${userName}", " ", "+");

		var userCount = "0";
		var userIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userName = "${row[0]}";

			var users = ZendeskUserAPI._viewUserSearchResultsByName(userName = "${userName}");

			if (!("${users}" == "[]")) {
				var userIds = ZendeskUserAPI._viewUserIdsByName(userName = "${userName}");
			}
		}

		static var staticUserIdList = "${userIds}";

		echo("User IDs: ${staticUserIdList}");

		return "${staticUserIdList}";
	}

	macro _getUserNameById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userName = JSONCurlUtil.get("${curl}", "$.user.name");

		return "${userName}";
	}

	@prose = "the uuid of the web user with the email address ${userEmailAddress} should match the user external ID on zendesk.liferay.com"
	macro _matchOsbUserUuIdWithZendeskUserId {
		// We will need to verify this change later

		var webUserUuId = JSONOkta.getOktaUserId(userEmailAddress = "${userEmailAddress}");

		var userExternalId = ZendeskUserAPI._viewUserExternalIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		echo("User uuid from Web: ${webUserUuId}");
		echo("User External ID from Zendesk: ${userExternalId}");

		if (!("${webUserUuId}" == "${userExternalId}")) {
			fail("Actual value ${webUserUuId} obtained from the web site and ${userExternalId} obtained from zendesk.liferay.com do not match");
		}
	}

	@prose = "I remove a user with the email address ${userEmailAddress} from an organization with the name ${organizationName}"
	macro _removeUserFromOrganization {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}/organization_memberships.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationMembershipId = JSONCurlUtil.get("${curl}", "$.organization_memberships[?(@.organization_id==${organizationId})].id");

		var organizationMembershipId = StringUtil.replace("${organizationMembershipId}", "[", "");

		var organizationMembershipId = StringUtil.replace("${organizationMembershipId}", "]", "");

		var organizationMembershipId = StringUtil.replace("${organizationMembershipId}", "&quot;", "");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}/organization_memberships/${organizationMembershipId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I remove all tags from the user with the email address ${userEmailAddress}"
	macro _removeUserTags {
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"user":
				{
					"tags": ""
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I rename the first default user ID variable"
	macro _renameFirstDefaultUserIdVariable {
		static var staticDefaultUserId1 = "${staticDefaultUserId}";

		return "${staticDefaultUserId1}";
	}

	@prose = "I rename the second default user ID variable"
	macro _renameSecondDefaultUserIdVariable {
		static var staticDefaultUserId2 = "${staticDefaultUserId}";

		return "${staticDefaultUserId2}";
	}

	@prose = "I rename the third default user ID variable"
	macro _renameThirdDefaultUserIdVariable {
		static var staticDefaultUserId3 = "${staticDefaultUserId}";

		return "${staticDefaultUserId3}";
	}

	@prose = "I rename the fourth default user ID variable"
	macro _renameFourthDefaultUserIdVariable {
		static var staticDefaultUserId4 = "${staticDefaultUserId}";

		return "${staticDefaultUserId4}";
	}

	@prose = "I rename the fifth default user ID variable"
	macro _renameFifthDefaultUserIdVariable {
		static var staticDefaultUserId5 = "${staticDefaultUserId}";

		return "${staticDefaultUserId5}";
	}

	@prose = "I rename the sixth default user ID variable"
	macro _renameSixthDefaultUserIdVariable {
		static var staticDefaultUserId6 = "${staticDefaultUserId}";

		return "${staticDefaultUserId6}";
	}

	@prose = "I teardown the user with userId ${userId} from zendesk.liferay.com"
	macro _tearDownUserById {
		if ((!(contains("${userId}", "{userId}"))) && (!("${userId}" == ""))) {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/destroy_many.json?ids=${userId}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var statusUrl = JSONCurlUtil.delete("${curl}", "$.job_status.url");

			var curl = '''
				--tlsv1.2 ${statusUrl}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var status = JSONCurlUtil.get("${curl}", "$.job_status.status");

			if (!("${status}" == "completed")) {
				if (("${status}" == "queued") || ("${status}" == "working")) {
					while (("${status}" == "queued") || ("${status}" == "working")) {
						ZendeskHomepage.pause(timeInSeconds = "2");

						var curl = '''
							--tlsv1.2 ${statusUrl}
							-u ${zendeskAdminEmail}/token:${apiToken}
							''';

						var status = JSONCurlUtil.get("${curl}", "$.job_status.status");				
					}
					if (!("${status}" == "completed")) {
						echo("Warning: The user tear down may have failed");
						echo("Tear Down Job Status: ${status}");
					}
				}
				else {
					echo("Warning: The user tear down may have failed");
					echo("Tear Down Job Status: ${status}");
				}
			}

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/deleted_users/${userId}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I teardown tickets requested by the user with the following email address ${userEmailAddress} from zendesk.liferay.com"
	macro _tearDownUserRequestedTicketsByUserEmailAddress {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var searchResults = JSONCurlUtil.get("${curl}");

		if (contains("${searchResults}", "${userEmailAddress}")) {
			var userID = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/${userID}/tickets/requested.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var allRequestedTickets = JSONCurlUtil.get("${curl}");

			var numberOfRequestedTickets = StringUtil.count("${allRequestedTickets}", "id");

			var ticketObjectNumber = "0";

			while (!("${numberOfRequestedTickets}" == "${ticketObjectNumber}")) {
				var ticketId = JSONCurlUtil.get("${curl}", "$.tickets[${ticketObjectNumber}].id");

				if ("${ticketObjectNumber}" == "0") {
					var ticketIdList = "${ticketId}";
				}
				else {
					var ticketIdList = "${ticketIdList},${ticketId}";
				}
			}

			if ((!(contains("${ticketIdList}", "{ticketIdList}"))) && (!("${ticketIdList}" == ""))) {
				ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = "${ticketIdList}");
			}
		}
	}

	@prose = "I teardown tickets requested by the user with the following userExternalId ${userExternalId} from zendesk.liferay.com"
	macro _tearDownUserRequestedTicketsByUserExternalId {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var searchResults = JSONCurlUtil.get("${curl}");

		if (contains("${searchResults}", "${userExternalId}")) {
			var userID = ZendeskUserAPI._viewUserIdByExternalId(userExternalId = "${userExternalId}");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/${userID}/tickets/requested.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var allRequestedTickets = JSONCurlUtil.get("${curl}");

			var numberOfRequestedTickets = StringUtil.count("${allRequestedTickets}", "id");

			var ticketObjectNumber = "0";

			while (!("${numberOfRequestedTickets}" == "${ticketObjectNumber}")) {
				var ticketId = JSONCurlUtil.get("${curl}", "$.tickets[${ticketObjectNumber}].id");

				if ("${ticketObjectNumber}" == "0") {
					var ticketIdList = "${ticketId}";
				}
				else {
					var ticketIdList = "${ticketIdList},${ticketId}";
				}
			}

			if ((!(contains("${ticketIdList}", "{ticketIdList}"))) && (!("${ticketIdList}" == ""))) {
				ZendeskTicketAPI._tearDownTicketByIds(ticketIdList = "${ticketIdList}");
			}
		}
	}
	
	@prose = "I teardown users with the following userExternalIds ${userExternalIds} from zendesk.liferay.com"
	macro _tearDownUsersByExternalIdList {
		if ((!(contains("${userExternalIds}", "{userExternalIds}"))) && (!("${userExternalIds}" == ""))) {
			var userIDs = "";

			for (var userExternalId : list "${userExternalIds}") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var searchResults = JSONCurlUtil.get("${curl}");

				if (contains("${searchResults}", "${userExternalId}")) {
					var userID = ZendeskUserAPI._viewUserIdByExternalId(userExternalId = "${userExternalId}");

					if ("${userIDs}" == "") {
						var userIDs = "${userID}";
					}
					else {
						var userIDs = "${userIDs},${userID}";
					}
				}
			}

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/destroy_many.json?external_ids=${userExternalIds}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var statusUrl = JSONCurlUtil.delete("${curl}", "$.job_status.url");

			var curl = '''
				--tlsv1.2 ${statusUrl}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var status = JSONCurlUtil.get("${curl}", "$.job_status.status");

			if (!("${status}" == "completed")) {
				if (("${status}" == "queued") || ("${status}" == "working")) {
					while (("${status}" == "queued") || ("${status}" == "working")) {
						ZendeskHomepage.pause(timeInSeconds = "2");

						var curl = '''
							--tlsv1.2 ${statusUrl}
							-u ${zendeskAdminEmail}/token:${apiToken}
							''';

						var status = JSONCurlUtil.get("${curl}", "$.job_status.status");
					}
					if (!("${status}" == "completed")) {
						echo("Warning: The user tear down may have failed");
						echo("Tear Down Job Status: ${status}");
					}
				}
				else {
					echo("Warning: The user tear down may have failed");
					echo("Tear Down Job Status: ${status}");
				}
			}

			for (var userID : list "${userIDs}") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/deleted_users/${userID}
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
			}
		}
	}

	@prose = "I teardown users with the following userExternalIds from zendesk.liferay.com ${table}"
	macro _tearDownUsersByExternalIdTable {
		var userCount = "0";
		var userExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userExternalId = "${row[0]}";

			if("${userCount}" == "0") {
				var userExternalIds = "${userExternalIds}${userExternalId}";
			}
			else {
				var userExternalIds = "${userExternalIds},${userExternalId}";
			}

			var userCount = MathUtil.sum("${userCount}", "1");
		}

		ZendeskUserAPI._tearDownUsersByExternalIdList(userExternalIds = "${userExternalIds}");
	}

	@prose = "I teardown users with the following userIds ${userIds} from zendesk.liferay.com"
	macro _tearDownUsersByIdList {
		if ((!(contains("${userIds}", "{userIds}"))) && (!("${userIds}" == ""))) {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/destroy_many.json?ids=${userIds}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var statusUrl = JSONCurlUtil.delete("${curl}", "$.job_status.url");

			var curl = '''
				--tlsv1.2 ${statusUrl}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var status = JSONCurlUtil.get("${curl}", "$.job_status.status");

			if (!("${status}" == "completed")) {
				if (("${status}" == "queued") || ("${status}" == "working")) {
					while (("${status}" == "queued") || ("${status}" == "working")) {
						ZendeskHomepage.pause(timeInSeconds = "2");

						var curl = '''
							--tlsv1.2 ${statusUrl}
							-u ${zendeskAdminEmail}/token:${apiToken}
							''';

						var status = JSONCurlUtil.get("${curl}", "$.job_status.status");
					}
					if (!("${status}" == "completed")) {
						echo("Warning: The user tear down may have failed");
						echo("Tear Down Job Status: ${status}");
					}
				}
				else {
					echo("Warning: The user tear down may have failed");
					echo("Tear Down Job Status: ${status}");
				}
			}

			for (var userId : list "${userIds}") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/deleted_users/${userId}
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
			}
		}
	}

	@prose = "I teardown tickets requested by the users with the following email addresses from zendesk.liferay.com ${table}"
	macro _tearDownUsersRequestedTicketsByEmailAddressTable {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userEmailAddress = "${row[0]}";

			ZendeskUserAPI._tearDownUserRequestedTicketsByUserEmailAddress(userEmailAddress = "${userEmailAddress}");
		}
	}

