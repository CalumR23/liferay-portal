	@prose = "the user with the email address ${userEmailAddress} on zendesk.liferay.com should have the phone number ${userPhoneNumber}"
	macro _viewUserPhoneNumberByEmailAddress {
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userPhoneNumberFromAPI = JSONCurlUtil.get("${curl}", "$.user.phone");

		echo("Expected User Phone Number: ${userPhoneNumber}");
		echo("Actual User Phone Number: ${userPhoneNumberFromAPI}");

		if (!("${userPhoneNumberFromAPI}" == "${userPhoneNumber}")) {
			fail("Actual value ${userPhoneNumberFromAPI} does not match expected value ${userPhoneNumber}");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} on zendesk.liferay.com should have the role ${roleName}"
	macro _viewUserRoleByEmailAddress {
		var roleName = StringUtil.replace("${roleName}", " ", "-");

		var roleName = StringUtil.lowerCase("${roleName}");

		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var roleNameFromAPI = JSONCurlUtil.get("${curl}", "$.user.role");

		echo("Expected User Role: ${roleName}");
		echo("Actual User Role: ${roleNameFromAPI}");

		if (!("${roleNameFromAPI}" == "${roleName}")) {
			fail("Actual value ${roleNameFromAPI} does not match expected value ${roleName}");
		}
	}

	macro _viewUserSearchResultsByEmailAddress {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var users = JSONCurlUtil.get("${curl}", "$.users");

		return "${users}";
	} 

	macro _viewUserSearchResultsByExternalId {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var users = JSONCurlUtil.get("${curl}", "$.users");

		return "${users}";
	} 

	macro _viewUserSearchResultsByName {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?query=${userName}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var users = JSONCurlUtil.get("${curl}", "$.users");

		return "${users}";
	} 

	@prose = "the user with the email address ${userEmailAddress} should be present on zendesk.liferay.com"
	macro _viewUserSyncFromOsb {
		var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && ("${users}" == "[]")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");
		}

		if (!("${users}" == "[]")) {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var userEmailAddressFromAPI = JSONCurlUtil.get("${curl}", "$.users[0].email");
		}
		else {
			fail("After ${currentIteration} attempts while waiting at ${pollIntervalInSeconds} in between each attempt, the OSB to Zendesk sync for the user with the email ${userEmailAddress} appears to have been unsuccessful");
		}

		echo("Expected User Email Address: ${userEmailAddress}");
		echo("Actual User Email Address: ${userEmailAddressFromAPI}");

		if (!("${userEmailAddressFromAPI}" == "${userEmailAddress}")) {
			fail("Actual value ${userEmailAddressFromAPI} does not match expected value ${userEmailAddress}.  There may be something wrong with Zendesk search or there may be similar data or the sync may have unsuccessful");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should be present via the external id search api on zendesk.liferay.com"
	macro _viewUserSyncFromOsbViaSearchByExternalIdApi {
		var userExternalId = ZendeskUserAPI._viewUserExternalIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var users = ZendeskUserAPI._viewUserSearchResultsByExternalId(userExternalId = "${userExternalId}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && ("${users}" == "[]")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var users = ZendeskUserAPI._viewUserSearchResultsByExternalId(userExternalId = "${userExternalId}");
		}

		if (!("${users}" == "[]")) {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var userExternalIdFromAPI = JSONCurlUtil.get("${curl}", "$.users[0].external_id");
		}
		else {
			fail("After ${currentIteration} attempts while waiting at ${pollIntervalInSeconds} in between each attempt, the OSB to Zendesk sync for the user with the external ID ${userExternalId} appears to have been unsuccessful");
		}

		echo("Expected User External ID: ${userExternalId}");
		echo("Actual User External ID: ${userExternalIdFromAPI}");

		if (!("${userExternalIdFromAPI}" == "${userExternalId}")) {
			fail("Actual value ${userExternalIdFromAPI} does not match expected value ${userExternalId}.  There may be something wrong with Zendesk search or there may be similar data or the sync may have unsuccessful");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should have the ${tag} tag"
	macro _viewUserTagSync {
		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!(contains("${existingTags}", "${tag}")))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");
		}

		echo("Expected User Tag: ${tag}");
		echo("Actual User Tags: ${existingTags}");

		if (!(contains("${existingTags}", "${tag}"))) {
			fail("After ${currentIteration} checks, actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} does not have the expected tag ${tag}");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should be a watcher on an organization with the name ${organizationName}"
	macro _viewUserWatcherTagSync {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var watcherTag = "osb_${organizationId}_watcher";

		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!(contains("${existingTags}", "${watcherTag}")))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");
		}

		echo("Expected User Watcher Tag: ${watcherTag}");
		echo("Actual User Tags: ${existingTags}");

		if (!(contains("${existingTags}", "${watcherTag}"))) {
			fail("After ${currentIteration} checks, actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} does not have the expected watcher tag ${watcherTag}");
		}
	}
}