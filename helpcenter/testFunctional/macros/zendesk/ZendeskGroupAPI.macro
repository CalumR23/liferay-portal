definition {

	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getGroupIdByName {
		var groupName = StringUtil.replace("${groupName}", " ", "+");

		var curl = '''
			${zendeskURL}/api/v2/search.json?query=type:group+${groupName} --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var groupId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${groupId}";
	}

	macro _getGroupNameById {
		var curl = '''
			${zendeskURL}/api/v2/groups/${groupId}.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var groupName = JSONCurlUtil.get("${curl}", "$.group.name");

		return "${groupName}";
	}

}