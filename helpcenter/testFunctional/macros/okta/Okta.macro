definition {
	@prose = "I log into the dev domain as ${userEmailAddress} with password ${userPassword}"
	macro _loginToDevDomain {
		Open(locator1 = "https://login-dev.liferay.com/signin/refresh-auth-state/00y4KuEUb2CNOzjwqN8K2asnRECKaHIfTCfmfzFxFR");

		Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "OktaLogin#SIGN_IN_BUTTON");
	}

	@prose = "I obtain the okta session ID value from the dev domain page"
	macro _getOktaSessionIdDevPage {
		Open(locator1 = "https://login-dev.liferay.com/api/v1/sessions/me");

		var oktaSessionId = selenium.getText("//body/pre");

		var oktaSessionId = StringUtil.extractFirst("${oktaSessionId}", ",");

		var oktaSessionId = StringUtil.replace("${oktaSessionId}", "{", "");

		var oktaSessionId = StringUtil.replace("${oktaSessionId}", "&quot;", "");

		var oktaSessionId = StringUtil.replace("${oktaSessionId}", "id", "");

		var oktaSessionId = StringUtil.replace("${oktaSessionId}", ":", "");

		static var staticOktaSessionId = "${oktaSessionId}";

		echo("Session ID Value: ${staticOktaSessionId}");

		return "${staticOktaSessionId}";
	}
}