definition {

	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I populate and save the product form with the following values ${table}"
	macro populateProductFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";
			var key_field = "${field}";

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningProductForm#INPUT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningProductForm#SELECT_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such product field type ${type}. Please use Input or Select.");
			}
		}

		Click(locator1 = "ProvisioningProductForm#SAVE_BUTTON");
	}

	@prose = "I should be able to view the duplicate name error message on the product form containing the name ${productName}"
	macro viewProductFormDuplicateNameErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningProductForm#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningProductForm#ERROR_MESSAGE",
			value1 = "A product with name ${productName} is already in use");
	}

}