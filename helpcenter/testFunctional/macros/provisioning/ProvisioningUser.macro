definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on the contact account name link for the account ${accountName}"
	macro _clickContactAccountLink {
		var key_accountName = "${accountName}";

		Click(locator1 = "ProvisioningUser#CONTACT_ACCOUNT_NAME_LINK");
	}

	@prose = "I click on the contact team name link for the team ${teamName} on the account ${accountName}"
	macro _clickContactAccountTeamLink {
		var key_accountName = "${accountName}";
		var key_teamName = "${teamName}";

		Click(locator1 = "ProvisioningUser#CONTACT_ACCOUNT_TEAM_LINK");
	}

	@prose = "I click on the Liferay Worker account name link for the account ${accountName}"
	macro _clickLiferayWorkerAccountLink {
		var key_accountName = "${accountName}";

		Click(locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_NAME_LINK");
	}

	@prose = "I populate and save the user form with the following values ${table}"
	macro populateUserFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";

			var key_field = "${field}";

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningUser#INPUT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningUser#SELECT_FIELD",
					value1 = "${value}");	
			}
			else if ("${type}" == "Checkbox") {
				if ("${value}" == "true") {
					Check(locator1 = "ProvisioningUser#CHECKBOX");
				}
				else {
					Uncheck(locator1 = "ProvisioningUser#CHECKBOX");
				}
			}
			else {
				fail("No such writeable user field type ${type}. Please use Input, Select, or Checkbox.");
			}
		}

		Click(locator1 = "ProvisioningAccountAddAddress#SAVE_BUTTON");
	}

	@prose = "I should be able to view the contact account with the name ${accountName} and the following values ${table}"
	macro _viewContactAccount {
		var key_accountName = "${accountName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_CODE",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Roles") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_ROLES",
					value1 = "${value}");
			}
			else if ("${field}" == "Teams") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_TEAMS",
					value1 = "${value}");
			}
			else if ("${field}" == "Account State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#CONTACT_ACCOUNT_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such contact account field ${field}");
			}
		}
	}

	@prose = "the sync with okta button in the user details page should be disabled"
	macro viewDisabledSyncWithOktaButton {
		AssertElementPresent(locator1 = "ProvisioningUser#SYNC_WITH_OKTA_BUTTON_DISABLED");
	}

	@prose = "the sync with okta button in the user details page should be enabled"
	macro viewEnabledSyncWithOktaButton {
		AssertElementPresent(locator1 = "ProvisioningUser#SYNC_WITH_OKTA_BUTTON_ENABLED");
	}

	@prose = "I should be able to view the entitlement with the name ${entitlementName} and the following values ${table}"
	macro _viewEntitlement {
		var key_entitlementName = "${entitlementName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#ENTITLEMENT_NAME",
					value1 = "${value}");
			}
			else {
				fail("No such entitlement field ${field}");
			}
		}
	}

	@prose = "I should be able to view the Liferay Worker account with the name ${accountName} and the following values ${table}"
	macro _viewLiferayWorkerAccount {
		var key_accountName = "${accountName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_CODE",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Roles") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_ROLES",
					value1 = "${value}");
			}
			else if ("${field}" == "Account State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such Liferay Worker account field ${field}");
			}
		}
	}

	@prose = "I should not be able to view the contact account with the name ${accountName}"
	macro _viewNoContactAccount {
		var key_accountName = "${accountName}";

		AssertElementNotPresent(locator1 = "ProvisioningUser#CONTACT_ACCOUNT_ROW");
	}

	@prose = "I should not be able to view the entitlement with the name ${entitlementName}"
	macro _viewNoEntitlement {
		var key_entitlementName = "${entitlementName}";

		AssertElementNotPresent(locator1 = "ProvisioningUser#ENTITLEMENT_ROW");
	}

	@prose = "I should not be able to view the Liferay Worker account with the name ${accountName}"
	macro _viewNoLiferayWorkerAccount {
		var key_accountName = "${accountName}";

		AssertElementNotPresent(locator1 = "ProvisioningUser#LIFERAY_WORKER_ACCOUNT_ROW");
	}

	@prose = "I should be able to view the sync with okta button in the user details page"
	macro viewSyncWithOktaButton {
		AssertElementPresent(locator1 = "ProvisioningUser#SYNC_WITH_OKTA_BUTTON");
	}

	@prose = "I should be able to view the following user values in the user details page ${table}"
	macro _viewUserDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#USER_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#USER_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningUser#USER_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Number of Accounts") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningUser#USER_NUMBER_OF_ACCOUNTS",
					value1 = "${value}");
			}
			else {
				fail("No such user detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the user form with the following values ${table}"
	macro _viewUserForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";

			if (contains("${field}", " from email address")) {
				var key_field = StringUtil.replace("${field}", " from email address", "");
			}
			else {
				var key_field = "${field}";
			}

			if ("${type}" == "Read Only Input") {
				if ("${field}" == "Key from email address") {
					var contactKey = KoroneikiContactAPI._getContactKeyViaContactEmailAddress(contactEmailAddress = "${value}");

					AssertValue(
						locator1 = "ProvisioningUser#READ_ONLY_INPUT_FIELD",
						value1 = "${contactKey}");
				}
				else {
					AssertValue(
						locator1 = "ProvisioningUser#READ_ONLY_INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Input") {
				if ("${field}" == "UUID from email address") {
					var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${value}");

					AssertValue(
						locator1 = "ProvisioningUser#INPUT_FIELD",
						value1 = "${contactUuid}");
				}
				else {
					AssertValue(
						locator1 = "ProvisioningUser#INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Select") {
				AssertSelectedLabel(
					locator1 = "ProvisioningUser#SELECT_FIELD",
					value1 = "${value}");	
			}
			else {
				fail("No such readable user field type ${type}. Please use Read Only Input, Input, or Select.");
			}
		}
	}
}