definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on the cancel button"
	macro clickCancelButton {
		Click(locator1 = "ProvisioningSubscriptionForm#CANCEL_BUTTON");
	}

	@prose = "I click on generate license button"
	macro clickGenerateLicenseButton {
		Click(locator1 = "ProvisioningSubscription#GENERATE_LICENSE_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the subscription term with the start date to end date ${startDateEndDate}"
	macro clickSubscriptionTermActionDropdownButton {
		var key_startDateEndDate = "${startDateEndDate}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscription#TERM_ACTION_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningSubscription#TERM_DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I populate and save the subscription form with the following values ${table}"
	macro populateSubscriptionFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				Click(locator1 = "ProvisioningSubscriptionForm#SELECT_BUTTON");

				SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

				Type(
					locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
					value1 = "&quot;${value}&quot;");

				Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningSubscriptionSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#ADD_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#ADD_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningSubscriptionSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningSubscriptionSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#ADD_BUTTON");
				}
			}
			else if ("${field}" == "Salesforce Opportunity Key") {
				Type(
					locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				Type(
					locator1 = "ProvisioningSubscriptionForm#PURCHASED_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Perpetual") {
				if ("${value}" == "true") {				
					Check(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
				}
				else {
					Uncheck(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
				}
			}
			else if ("${field}" == "Start Date") {
				Click.pauseMakeVisibleClickAt(
					locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
					value1 = "${value}");

				Type(
					locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
					value1 = "${value}");

				KeyPress(
					locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
					value1 = "\RETURN");
			}
			else if ("${field}" == "End Date") {
				Click.pauseMakeVisibleClickAt(
					locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
					value1 = "${value}");

				Type(
					locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
					value1 = "${value}");

				KeyPress(
					locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
					value1 = "\RETURN");
			}
			else if ("${field}" == "Instance Size") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#INSTANCE_SIZE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period End Date") {
				Click.pauseMakeVisibleClickAt(
					locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
					value1 = "${value}");

				Type(
					locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
					value1 = "${value}");

				KeyPress(
					locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
					value1 = "\RETURN");
			}
			else if ("${field}" == "Status") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#STATUS_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such editable subscription field ${field}.");
			}
		}

		Click(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON");
	}

	@prose = "I should be able to view the error message with the text ${errorMessage}"
	macro viewErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningSubscriptionForm#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningSubscriptionForm#ERROR_MESSAGE",
			value1 = "${errorMessage}");
	}

	@prose = "I should be able to view the following subscription values in the subscription details page ${table}"
	macro _viewSubscriptionDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_GRACE_PERIOD",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the term with the start date to end date ${startDateEndDate} and the following values ${table}"
	macro _viewSubscriptionTerm {
		var key_startDateEndDate = "${startDateEndDate}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Start - End Date") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_START_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_GRACE_PERIOD",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Salesforce Opportunity Key") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_SALESFORCE_OPPORTUNITY_KEY",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such subscription term field ${field}");
			}
		}
	}
}