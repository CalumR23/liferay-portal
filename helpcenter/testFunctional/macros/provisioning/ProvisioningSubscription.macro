	@prose = "I should not be able to view the license with the keyword ${licenseKeyword} on the subscription details page"
	macro _viewNoSubscriptionLicense {
		var key_licenseKeyword = "${licenseKeyword}";

		AssertElementNotPresent(locator1 = "ProvisioningSubscription#LICENSE_ROW");
	}

	@prose = "the action dropdown button for the subscription term with the start date to end date ${startDateEndDate} should not be present"
	macro viewNoSubscriptionTermActionDropdownButton {
		var key_startDateEndDate = "${startDateEndDate}";

		AssertElementNotPresent(locator1 = "ProvisioningSubscription#TERM_ACTION_BUTTON");
	}

	@prose = "I should be able to view the following subscription values in the subscription details page ${table}"
	macro _viewSubscriptionDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_STATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_GRACE_PERIOD",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the license with the keyword ${licenseKeyword} and the following values on the subscription details page ${table}"
	macro _viewSubscriptionLicense {
		var key_licenseKeyword = "${licenseKeyword}";

		AssertElementPresent(locator1 = "ProvisioningSubscription#LICENSE_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_EXPIRATION_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Details") {
				var key_label = StringUtil.extractFirst("${value}", ":");
				var key_label = StringUtil.trim("${key_label}");

				var value = StringUtil.extractLast("${value}", ":");
				var value = StringUtil.trim("${value}");

				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningSubscription#LICENSE_DETAILS",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#LICENSE_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Complimentary") {
				if ("${value}" == "true") {
					AssertElementPresent(
						locator1 = "ProvisioningSubscription#LICENSE_COMPLIMENTARY_CHECKED",
						value1 = "${value}");
				}
				else {
					AssertElementPresent(
						locator1 = "ProvisioningSubscription#LICENSE_COMPLIMENTARY_NOT_CHECKED",
						value1 = "${value}");
				}
			}
			else {
				fail("No such subscription license field ${field}");
			}
		}
	}

	@prose = "I should be able to view the term with the start date to end date ${startDateEndDate} and the following values ${table}"
	macro _viewSubscriptionTerm {
		var key_startDateEndDate = "${startDateEndDate}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Start - End Date") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_START_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_GRACE_PERIOD",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Salesforce Opportunity Key") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_SALESFORCE_OPPORTUNITY_KEY",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningSubscription#TERM_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such subscription term field ${field}");
			}
		}
	}
}