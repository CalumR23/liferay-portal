definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on generate license button on the subscription details page"
	macro clickGenerateLicenseButton {
		Click(locator1 = "ProvisioningSubscription#GENERATE_LICENSE_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for all licenses under the license tab on the subscription details page"
	macro clickLicensesActionDropdownButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_ACTION_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the download button for all licenses under the license tab on the subscription details page"
	macro clickLicensesDownloadButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_DOWNLOAD_BUTTON");
	}

	@prose = "I click on the renew button for all licenses under the license tab on the subscription details page"
	macro clickLicensesRenewButton {
		Click(locator1 = "ProvisioningSubscription#LICENSE_ALL_RENEW_BUTTON");
	}

	@prose = "I click on subscription provisioned link"
	macro clickSubscriptionProvisionedLink {
		Click(locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED");
	}

	@prose = "I click on the cancel button on the subscription form"
	macro clickSubscriptionFormCancelButton {
		Click(locator1 = "ProvisioningSubscriptionForm#CANCEL_BUTTON");
	}

	@prose = "I click on the next button on the subscription form"
	macro clickSubscriptionFormNextButton {
		Click(locator1 = "ProvisioningSubscriptionForm#NEXT_BUTTON");
	}

	@prose = "I click on the save button on the subscription form"
	macro clickSubscriptionFormSaveButton {
		Click(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON");
	}

	@prose = "I click on the select button on the subscription form"
	macro clickSubscriptionFormSelectButton {
		Click(locator1 = "ProvisioningSubscriptionForm#SELECT_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the subscription term with the start date to end date ${startDateEndDate}"
	macro clickSubscriptionTermActionDropdownButton {
		var key_startDateEndDate = "${startDateEndDate}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscription#TERM_ACTION_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningSubscription#TERM_DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on provisioned link for the subscription term with the start date to end date ${startDateEndDate}"
	macro clickSubscriptionTermProvisionedLink {
		var key_startDateEndDate = "${startDateEndDate}";

		Click(locator1 = "ProvisioningSubscription#SUBSCRIPTION_PROVISIONED");
	}

	@prose = "I populate the subscription form with the following values ${table}"
	macro populateSubscriptionForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var product = "${row[0]}";
			var field = "${row[1]}";
			var value = "${row[2]}";

			var key_entityName = "${product}";

			if ("${field}" == "Subscription Term") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#SUBSCRIPTION_TERM_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Salesforce Opportunity Key") {
				if ("${value}" == "") {
					Type(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "\SPACE");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "\BACK_SPACE");	
				}
				else {
					Type(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Purchased") {
				Type(
					locator1 = "ProvisioningSubscriptionForm#PURCHASED_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Perpetual") {
				AssertElementPresent(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");

				if ("${value}" == "true") {
					if (IsNotChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD_DISABLED");
					}
				}
				else {
					if (IsChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD_DISABLED");
					}
				}
			}
			else if ("${field}" == "Start Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "End Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "Instance Size") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#INSTANCE_SIZE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period End Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "Status") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#STATUS_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such editable subscription field ${field}.");
			}
		}
	}

	@prose = "I populate and save the subscription form with the following values ${table}"
	macro populateSubscriptionFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var product = "${row[0]}";
			var field = "${row[1]}";
			var value = "${row[2]}";

			var key_entityName = "${product}";

			if ("${field}" == "Salesforce Opportunity Key") {
				if ("${value}" == "") {
					Type(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "\SPACE");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "\BACK_SPACE");	
				}
				else {
					Type(
						locator1 = "ProvisioningSubscriptionForm#SALESFORCE_OPPORTUNITY_KEY_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Purchased") {
				Type(
					locator1 = "ProvisioningSubscriptionForm#PURCHASED_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Perpetual") {
				AssertElementPresent(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");

				if ("${value}" == "true") {
					if (IsNotChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD")) {
						AssertVisible(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD_DISABLED");
					}
				}
				else {
					if (IsChecked(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#PERPETUAL_CHECBOX");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD_DISABLED");
					}

					if (IsElementPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD")) {
						AssertElementNotPresent(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD_DISABLED");
					}
				}
			}
			else if ("${field}" == "Start Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#START_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#START_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "End Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#END_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "Instance Size") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#INSTANCE_SIZE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Grace Period End Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

					var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

					var year = StringUtil.extractLast("${value}", " ");

					var day = StringUtil.replace("${value}", "${month} ", "");

					var day = StringUtil.replace("${day}", ", ${year}", "");

					var singleDigitDay = StringUtil.startsWith("${day}", "0");

					if ("${singleDigitDay}" == "true") {
						var day = StringUtil.replace("${day}", "0", "");
					}

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
						value1 = "${fullMonth}");

					Select(
						locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
						value1 = "${year}");

					var key_day = "${day}";

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_PICKER_DROPDOWN_BUTTON");

				}
				else {
					Click.pauseMakeVisibleClickAt(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "${value}");

					Type(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "${value}");

					KeyPress(
						locator1 = "ProvisioningSubscriptionForm#GRACE_PERIOD_END_DATE_FIELD",
						value1 = "\RETURN");
				}
			}
			else if ("${field}" == "Status") {
				Select(
					locator1 = "ProvisioningSubscriptionForm#STATUS_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such editable subscription field ${field}.");
			}
		}

		Click(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON");
	}

	@prose = "I populate the subscription term form using the following product and term values and proceed ${table}"
	macro populateSubscriptionTermFormAndProceed {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var product = "${row[0]}";
			var term = "${row[1]}";

			var key_entityName = "${product}";

			Select(
				locator1 = "ProvisioningSubscriptionForm#SUBSCRIPTION_TERM_SELECT",
				value1 = "${term}");
		}

		Click(locator1 = "ProvisioningSubscriptionForm#NEXT_BUTTON");
	}

	@prose = "I remove the subscription row with the product ${productName}"
	macro removeSubscriptionRow {
		var key_entityName = "${productName}";

		Click(locator1 = "ProvisioningSubscriptionForm#DELETE_BUTTON");
	}

	@prose = "I search the subscriptions details page using the keyword ${keyword}"
	macro search {
		Type(
			locator1 = "ProvisioningSubscription#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ProvisioningSubscription#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I select all licenses under the subscriptions tab on the subscription details page"
	macro selectAllLicensesViaLicensesTab {
		Check(locator1 = "ProvisioningSubscription#LICENSE_ALL_CHECKBOX");
	}

	@prose = "I select the following licenses under the licenses tab on the subscription details page ${table}"
	macro selectLicensesViaLicensesTab {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var licenseKeyword = "${row[0]}";

			var key_licenseKeyword = "${licenseKeyword}";

			Check(locator1 = "ProvisioningSubscription#LICENSE_CHECKBOX");
		}
	}

	@prose = "I select all products using the search term ${keyword} on the subscription select window"
	macro selectAllProductsViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		if (!("${keyword}" == "")) {
			Type(
				locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
				value1 = "&quot;${keyword}&quot;");

			Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");
		}

		var RawTable rawTable = new RawTable("${table}");

		Check(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#SELECT_ALL_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	@prose = "I select the product with the name ${productName} on the subscription select window"
	macro selectProductViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		Type(
			locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
			value1 = "&quot;${productName}&quot;");

		Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");

		var key_entityName = "${productName}";

		Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	@prose = "I select the following products using the search term ${keyword} on the subscription select window ${table}"
	macro selectProductsViaSubscriptionSelectWindow {
		SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

		if (!("${keyword}" == "")) {
			Type(
				locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_FIELD",
				value1 = "&quot;${keyword}&quot;");

			Click(locator1 = "ProvisioningSubscriptionSelect#SELECT_SEARCH_BUTTON");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var product = "${row[0]}";

			var key_entityName = "${product}";

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");

		while (IsElementPresent(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON")) {
			SelectFrame(locator1 = "ProvisioningSubscriptionSelect#SELECT_IFRAME");

			Uncheck(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			Check(locator1 = "ProvisioningSubscriptionSelect#ENTITY_CHECKBOX");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningSubscriptionSelect#DONE_BUTTON");
		}
	}

	@prose = "the subscription row with the product ${productName} should have the delete button disabled"
	macro viewDisabledSubscriptionDeleteButton {
		var key_entityName = "${productName}";

		AssertVisible(locator1 = "ProvisioningSubscriptionForm#DELETE_BUTTON_DISABLED");
	}

	@prose = "the save button on the subscription form should be disabled"
	macro viewDisabledSubscriptionFormSaveButton {
		AssertElementPresent(locator1 = "ProvisioningSubscriptionForm#SAVE_BUTTON_DISABLED");
	}

	@prose = "I should be able to view the subscription form error message with the text ${errorMessage}"
	macro viewErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningSubscriptionForm#ERROR_MESSAGE",
			value1 = "${errorMessage}");
	}

	@prose = "the generate license button on the subscription details page should not be present"
