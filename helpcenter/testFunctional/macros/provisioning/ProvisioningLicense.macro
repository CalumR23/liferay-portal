	@prose = "I should not be able to view the download button for the following license key id values on the download license page ${table}"
	macro viewNoDownloadLicenseButtonViaDownloadLicensePage {
		var licenseKeyIdList = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIdList}" == "") {
				var licenseKeyIdList = "${licenseKeyId}";
			}
			else {
				var licenseKeyIdList = "${licenseKeyIdList},${licenseKeyId}";
			}
		}

		var key_licenseKeyIdList = "${licenseKeyIdList}";

		AssertElementNotPresent(locator1 = "ProvisioningLicenseDownloadLicense#DOWNLOAD_BUTTON");
	}

	@prose = "I should not be able to view the make complimentary button for the license in position ${positionValue} on the license page"
	macro viewNoMakeComplimentaryLicenseButton {
		var key_positionValue = "${positionValue}";

		AssertElementNotPresent(locator1 = "ProvisioningLicense#MAKE_COMPLIMENTARY_BUTTON");
	}

	@prose = "I should not be able to view the move button for the license in position ${positionValue} on the license page"
	macro viewNoMoveLicenseButton {
		var key_positionValue = "${positionValue}";

		AssertElementNotPresent(locator1 = "ProvisioningLicense#MOVE_BUTTON");
	}

	@prose = "I should not be able to view the remove complimentary button for the license in position ${positionValue} on the license page"
	macro viewNoRemoveComplimentaryLicenseButton {
		var key_positionValue = "${positionValue}";

		AssertElementNotPresent(locator1 = "ProvisioningLicense#REMOVE_COMPLIMENTARY_BUTTON");
	}

	@prose = "I should not be able to view the renew button for the license in position ${positionValue} on the license page"
	macro viewNoRenewLicenseButton {
		var key_positionValue = "${positionValue}";

		AssertElementNotPresent(locator1 = "ProvisioningLicense#RENEW_BUTTON");
	}

	@prose = "I should not be able to view the license with the keyword ${licenseKeyword} on the download license page"
	macro _viewNoLicenseViaDownloadLicensePage {
		var key_licenseKeyword = "${licenseKeyword}";

		AssertElementNotPresent(locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_ROW");
	}
}