definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on the activate button for the license in position ${positionValue} on the license page"
	macro clickActivateLicenseButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#ACTIVATE_BUTTON");
	}

	@prose = "I click on the add fields button in position ${positionValue} on the license form"
	macro clickAddFieldsButton {
