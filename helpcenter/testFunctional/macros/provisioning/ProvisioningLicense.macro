	@prose = "I click download the licence by click the button in the position ${positionValue}"
	macro downloadLicense {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#DOWNLOAD_BUTTON");

		DownloadTempFile();
	}

	@prose = "I should be able to see the downloaded file of type ${fileType} the with the params ${table}"
	macro assertDownloadFileName {

		var RawTable rawTable = new RawTable("${table}");

		var licenseType = "";
		var product = "";
		var version = "";
		var licenseName = "";
		var copy = "";

		for (var role : table "${rawTable}") {
			var field = "${role[0]}";	
			var type = "${role[1]}";

			if ("${field}" == "License Type") {
				var licenseType = "${type}-";
			}
			else if ("${field}" == "Product"){
				var product = "${type}-";
			}
			else if ("${field}" == "Version") {
				var version = "${type}-";
			}
			else if ("${field}" == "License Name") {
				if ("${licenseName}" == "") {
					var licenseName = "${type}";
				}
				else {
					var licenseName = "${licenseName}-${type}";
				}
			}
			else if ("${field}" == "Copy") {
				var copy = " (${type})";
			}
			else {
				fail("No such field ${field} required!");
			}
		}


		var downloadedFileName = "${licenseType}${product}${version}${licenseName}";

		var downloadedFileName = StringUtil.toLowerCase("${downloadedFileName}");
		var downloadedFileName = StringUtil.replace("${downloadedFileName}", " ", "");

		var downloadedFileName = "${downloadedFileName}${copy}.${fileType}";

		var tempFileDirectory = selenium.getOutputDirName();

		var downloadedFilePath = "${tempFileDirectory}/${downloadedFileName}";

		var fileExists = FileUtil.exists("${downloadedFilePath}");

		if ("${fileExists}" == "true") {
			echo("File named ${downloadedFileName} was downloaded.");
		}
		else {
			fail("File named ${downloadedFileName} NOT FOUND in folder ${tempFileDirectory}!");
		}
	}

