		AssertVisible(locator1 = "ProvisioningLicense#DOWNLOAD_BUTTON");
	}

	@prose = "I should be able to view the download button for the following license key id values on the download license page ${table}"
	macro viewDownloadLicenseButtonViaDownloadLicensePage {
		var licenseKeyIdList = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIdList}" == "") {
				var licenseKeyIdList = "${licenseKeyId}";
			}
			else {
				var licenseKeyIdList = "${licenseKeyIdList},${licenseKeyId}";
			}
		}

		var key_licenseKeyIdList = "${licenseKeyIdList}";

		AssertVisible(locator1 = "ProvisioningLicenseDownloadLicense#DOWNLOAD_BUTTON");
	}

	@prose = "I should be able to view the following license values on the license page ${table}"
	macro viewLicense {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";
			var positionValue = "${row[2]}";

			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";
			}

			if ("${field}" == "Header") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicense#LICENSE_HEADER",
					value1 = "${value}");
			}
			else {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicense#LICENSE_FIELD_VALUE",
					value1 = "${value}");
			}			
		}
	}

	@prose = "I should be able to view the license with the keyword ${licenseKeyword} and the following values on the download license page ${table}"
	macro _viewLicenseViaDownloadLicensePage {
		var key_licenseKeyword = "${licenseKeyword}";

		AssertElementPresent(locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_START_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_EXPIRATION_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Host Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_HOST_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "IP Addresses") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_IP_ADDRESSES",
					value1 = "${value}");
			}
			else if ("${field}" == "MAC Addresses") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_MAC_ADDRESSES",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such download license field ${field}");
			}
		}
	}

