definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on the activate button for the license in position ${positionValue} on the license page"
	macro clickActivateLicenseButton {
		var key_positionValue = "${positionValue}";

		ClickNoError(locator1 = "ProvisioningLicense#ACTIVATE_BUTTON");

		Confirm(value1 = "Are you sure you want to activate the license key(s)?");
	}

	@prose = "I click on the add fields button in position ${positionValue} on the license form"
	macro clickAddFieldsButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#ADD_FIELDS_BUTTON");
	}

	@prose = "I click on the back button on the extend license form"
	macro clickBackButtonViaExtendLicenseForm {
		Click(locator1 = "ProvisioningLicenseExtend#BACK_BUTTON");
	}

	@prose = "I click on the cancel button on the replace license form"
	macro clickCancelButtonViaReplaceLicenseForm {
		Click(locator1 = "ProvisioningLicenseReplace#CANCEL_BUTTON");
	}

	@prose = "I click on the choose button for the product purchase in position ${positionValue} on the license form"
	macro clickChooseProductPurchaseButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#CHOOSE_PRODUCT_PURCHASE_BUTTON");
	}

	@prose = "I click on the choose button for the product purchase in position ${positionValue} on the move license form"
	macro clickChooseProductPurchaseButtonViaMoveLicenseForm {
		SelectFrame(locator1 = "ProvisioningLicenseMoveLicense#MOVE_LICENSE_IFRAME");

		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicenseMoveLicense#CHOOSE_PRODUCT_PURCHASE_BUTTON");

		SelectFrameTop();
	}

	@prose = "I click on the choose button for the product purchase with the key value ${productPurchaseId} on the license form"
	macro clickChooseProductPurchaseViaKeyButton {
		var key_productPurchaseId = "${productPurchaseId}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON");
	}

	@prose = "I click on the choose button for the product purchase with the key value ${productPurchaseId} on the move license form"
	macro clickChooseProductPurchaseViaKeyButtonViaMoveLicenseForm {
		SelectFrame(locator1 = "ProvisioningLicenseMoveLicense#MOVE_LICENSE_IFRAME");

		var key_productPurchaseId = "${productPurchaseId}";

		Click(locator1 = "ProvisioningLicenseMoveLicense#CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON");

		SelectFrameTop();
	}

	@prose = "I click on the choose button for the product purchase in position ${positionValue} under the ${section} section on the license form"
	macro clickChooseSectionedProductPurchaseButton {
		var key_positionValue = "${positionValue}";
		var key_section = "${section}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#SECTIONED_CHOOSE_PRODUCT_PURCHASE_BUTTON");
	}

	@prose = "I click on the choose button for the product purchase with the key value ${productPurchaseId} under the ${section} section on the license form"
	macro clickChooseSectionedProductPurchaseViaKeyButton {
		var key_productPurchaseId = "${productPurchaseId}";
		var key_section = "${section}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#SECTIONED_CHOOSE_PRODUCT_PURCHASE_VIA_KEY_BUTTON");
	}

	@prose = "I click on the deactivate button for the license in position ${positionValue} on the license page"
	macro clickDeactivateLicenseButton {
		var key_positionValue = "${positionValue}";

		ClickNoError(locator1 = "ProvisioningLicense#DEACTIVATE_BUTTON");

		Confirm(value1 = "Are you sure you want to deactivate the license key(s)?");
	}

	@prose = "I click on the delete fields button in position ${positionValue} on the license form"
	macro clickDeleteFieldsButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#DELETE_FIELDS_BUTTON");
	}

	@prose = "I click on the delete license button for the license with the keyword ${licenseKeyword} on the download license page"
	macro clickDeleteLicenseButtonViaDownloadLicensePage {
		var key_licenseKeyword = "${licenseKeyword}";

		Click(locator1 = "ProvisioningLicenseDownloadLicense#LICENSE_DELETE_BUTTON");
	}

	@prose = "I click on the generate button on the license form"
	macro clickGenerateLicenseButton {
		Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#GENERATE_BUTTON");
	}

	@prose = "I click on the ${field} value link for the license in position ${positionValue} on the license page"
	macro clickLicenseLink {
		var key_field = "${field}";
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#LICENSE_FIELD_VALUE_LINK");
	}

	@prose = "I click on the make complimentary button for the license in position ${positionValue} on the license page"
	macro clickMakeComplimentaryLicenseButton {
		var key_positionValue = "${positionValue}";

		ClickNoError(locator1 = "ProvisioningLicense#MAKE_COMPLIMENTARY_BUTTON");

		Confirm(value1 = "Are you sure you want to make the license key(s) complimentary?");
	}

	@prose = "I click on the move button for the license in position ${positionValue} on the license page"
	macro clickMoveLicenseButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#MOVE_BUTTON");
	}

	@prose = "I click on the remove complimentary button for the license in position ${positionValue} on the license page"
	macro clickRemoveComplimentaryLicenseButton {
		var key_positionValue = "${positionValue}";

		ClickNoError(locator1 = "ProvisioningLicense#REMOVE_COMPLIMENTARY_BUTTON");

		Confirm(value1 = "Are you sure you want to proceed? The license key(s) will no longer be complimentary.");
	}

	@prose = "I click on the replace button on the replace license form"
	macro clickReplaceButton {
		Click(locator1 = "ProvisioningLicenseReplace#REPLACE_BUTTON");
	}
	@prose = "I click on the extend button on the extend license form"
	macro clickExtendButton {
		Click(locator1 = "ProvisioningLicenseExtend#EXTEND_BUTTON");
	}

	@prose = "I click on the replace button for the license in position ${positionValue} on the license page"
	macro clickReplaceLicenseButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#REPLACE_BUTTON");
	}
	@prose = "I click on the extend button for the license in position ${positionValue} on the license page"
	macro clickExtendLicenseButton {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningLicense#EXTEND_BUTTON");
	}

	@prose = "I obtain the license key ID value from the license details page"
	macro getLicenseKeyIdViaLicenseDetails {
		WaitForSPARefresh();

		static var staticLicenseKeyId = selenium.getAttribute("//input[contains(@id,'licenseKeyId')]@value");

		echo("License Key ID Value: ${staticLicenseKeyId}");

		return "${staticLicenseKeyId}";
	}

	@prose = "I populate the generate license form with the following values ${table}"
	macro populateGenerateLicenseForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";
			var positionValue = "${row[3]}";

			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";
			}

			if ("${type}" == "Input") {
				if ("${field}" == "Start Date") {
					if (contains("${value}", ",")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#START_DATE_PICKER_DROPDOWN_BUTTON");

						var month = StringUtil.extractFirst("${value}", " ");

						var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

						var year = StringUtil.extractLast("${value}", " ");

						var day = StringUtil.replace("${value}", "${month} ", "");

						var day = StringUtil.replace("${day}", ", ${year}", "");

						var singleDigitDay = StringUtil.startsWith("${day}", "0");

						if ("${singleDigitDay}" == "true") {
							var day = StringUtil.replace("${day}", "0", "");
						}

						Select(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
							value1 = "${fullMonth}");

						Select(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
							value1 = "${year}");

						var key_day = "${day}";

						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#START_DATE_PICKER_DROPDOWN_BUTTON");

					}
					else {
						Click.pauseMakeVisibleClickAt(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#START_DATE_FIELD",
							value1 = "${value}");

						Type(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#START_DATE_FIELD",
							value1 = "${value}");

						KeyPress(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#START_DATE_FIELD",
							value1 = "\RETURN");
					}
				}
				else if ("${field}" == "Expiration Date") {
					if (contains("${value}", ",")) {
						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON");

						var month = StringUtil.extractFirst("${value}", " ");

						var fullMonth = KoroneikiProductPurchaseAPI._getFullMonthName(month = "${month}");

						var year = StringUtil.extractLast("${value}", " ");

						var day = StringUtil.replace("${value}", "${month} ", "");

						var day = StringUtil.replace("${day}", ", ${year}", "");

						var singleDigitDay = StringUtil.startsWith("${day}", "0");

						if ("${singleDigitDay}" == "true") {
							var day = StringUtil.replace("${day}", "0", "");
						}

						Select(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_MONTH_SELECT",
							value1 = "${fullMonth}");

						Select(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_YEAR_SELECT",
							value1 = "${year}");

						var key_day = "${day}";

						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#CALENDAR_DATE_PICKER_DAY_BUTTON");

						Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseGenerateLicenseForm#EXPIRATION_DATE_PICKER_DROPDOWN_BUTTON");

					}
					else {
						Click.pauseMakeVisibleClickAt(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#EXPIRATION_DATE_FIELD",
							value1 = "${value}");

						Type(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#EXPIRATION_DATE_FIELD",
							value1 = "${value}");

						KeyPress(
							locator1 = "ProvisioningLicenseGenerateLicenseForm#EXPIRATION_DATE_FIELD",
							value1 = "\RETURN");
					}
				}
				else {
					Type(
						locator1 = "ProvisioningLicenseGenerateLicenseForm#INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Textarea") {
				Type(
					locator1 = "ProvisioningLicenseGenerateLicenseForm#TEXTAREA_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				if ("${field}" == "Instance Size") {
					Select(
						locator1 = "ProvisioningLicenseGenerateLicenseForm#INSTANCE_SIZE_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "ProvisioningLicenseGenerateLicenseForm#SELECT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Select Entity") {
				Click(locator1 = "ProvisioningLicenseGenerateLicenseForm#SELECT_ENTITY_BUTTON");

				SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

 				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_FIELD",
					value1 = "${keyword}");

				Click(locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningAccountSelect#DONE_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");
				}
			}
			else if ("${type}" == "Checkbox") {
				if ("${value}" == "true") {
					Check(locator1 = "ProvisioningLicenseGenerateLicenseForm#CHECKBOX");
				}
				else {
					Uncheck(locator1 = "ProvisioningLicenseGenerateLicenseForm#CHECKBOX");
				}
			}
			else {
				fail("No such generate license field type ${type}. Please use Input, Textarea, Select, Select Entity, or Checkbox");
			}
		}
	}

	@prose = "I populate the replace license form with the following values ${table}"
	macro populateReplaceLicenseForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Start Date") {
				if (contains("${value}", ",")) {
					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningLicenseReplace#START_DATE_PICKER_DROPDOWN_BUTTON");

					var month = StringUtil.extractFirst("${value}", " ");

