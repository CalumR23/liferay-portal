	@prose = "I should be able to download a license zip file on provisioning for the following license keys ${table}"
	macro _downloadLicenseZip {
		var RawTable rawTable = new RawTable("${table}");
		var licenseKeyIds = "";

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIds}" == "") {
				var licenseKeyIds = "licenseKeyIds=${licenseKeyId}";
			}
			else {
				var licenseKeyIds = "${licenseKeyIds}&licenseKeyIds=${licenseKeyId}";
			}
		}

		var testDirs = PropsUtil.get("test.dirs");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download-zip?"${licenseKeyIds}" --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			--output ${testDirs}/licenseZipFile.zip
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.get("${curl}");

		ZendeskHomepage.pause(timeInSeconds = "5");

		var fileExists = FileUtil.exists("${testDirs}/licenseZipFile.zip");

		if ("${fileExists}" == "true") {
			echo("File named licenseZipFile.zip was downloaded.");

			FileUtil.delete("${testDirs}/licenseZipFile.zip");

			echo("File named licenseZipFile.zip was deleted.");
		}
		else {
			fail("File named licenseZipFile.zip NOT FOUND in folder ${testDirs}!");
		}
	}

