	@prose = "I should be able to view the license on the account ${accountName} with the name ${licenseName} and the following filters ${table}"
	macro _viewFilteredLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var filters = "";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var field = "name";

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}+eq+%27${value}%27";
				}
				else {
					var filters = "${filters}+and+${field}+eq+%27${value}%27";
				}
			}
			else if ("${field}" == "Description") {
				var field = "description";

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}+eq+%27${value}%27";
				}
				else {
					var filters = "${filters}+and+${field}+eq+%27${value}%27";
				}
			}
			else if ("${field}" == "Active") {
				var field = "active";

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}+eq+${value}";
				}
				else {
					var filters = "${filters}+and+${field}+eq+${value}";
				}
			}
			else if ("${field}" == "Host Name") {
				var field = "hostName";

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}+eq+%27${value}%27";
				}
				else {
					var filters = "${filters}+and+${field}+eq+%27${value}%27";
				}
			}
			else if ("${field}" == "IP Addresses") {
				var field = "ipAddresses";

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}/any%28s:s+eq+%27${value}%27%29";
				}
				else {
					var filters = "${filters}+and+${field}/any%28s:s+eq+%27${value}%27%29";
				}
			}
