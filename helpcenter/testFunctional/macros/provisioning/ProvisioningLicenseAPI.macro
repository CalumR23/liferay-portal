definition {
	var provisioningAdminEmail = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var roleName = PropsUtil.get("provisioning.non.permission.role.name");

	@prose = "I activate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _activateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId}
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I deactivate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _deactivateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/deactivate?licenseKeyIds=${licenseKeyId}
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I download the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _downloadLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download?licenseKeyIds=${licenseKeyId}
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.get("${curl}");
	}

	@prose = "I extend the license on provisioning with the name ${licenseName} on the account ${accountName} and the product purchase key ${productPurchaseKey} with the following values ${table}"
	macro _extendLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Expiration Date") {
				var expirationDate = "${value}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value}";
			}
			else {
				fail("No such license extension field ${field}");
			}
		}

		if (!(isSet(expirationDate))) {
			var expirationDate = "";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/extend
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H 'Content-Type: application/json'
			-d
			[{
				"id": ${licenseKeyId},
				"expirationDate": "${expirationDate}",
				"productPurchaseKey": "${productPurchaseKey}",
				"startDate": "${startDate}"
			}]
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}
	macro _getLicenseKeyIdViaLicenseName {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var licenseKeyId = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].id");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "[", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "]", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "&quot;", "");

		echo("License Key ID value for ${licenseName}: ${licenseKeyId}");

		return "${licenseKeyId}";
	}

	@prose = "I search for the licenses keys on the account ${accountName} with the name ${licenseName} using okta authentication"
	macro _getLicenseKeyIdViaLicenseNameUsingOktaAuth {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100
			-H "Okta-Session-ID: ${staticSessionIdOkta}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var licenseKeyId = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].id");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "[", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "]", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "&quot;", "");

		echo("License Key ID value for ${licenseName}: ${licenseKeyId}");

		return "${licenseKeyId}";
	}

	@prose = "I attempt to search for the licenses keys on the account ${accountName} with the name ${licenseName} using a non permissioned user with okta authentication"
	macro _getLicenseKeyIdViaLicenseNameAttemptUsingOktaAuth {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100
			-H "Okta-Session-ID: ${staticSessionIdOkta}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var errorMsgApi = JSONCurlUtil.get("${curl}", "$.status");

		if ("${errorMsgApi}" == "NOT_FOUND") {

			echo("The Status of the API Call is ${errorMsgApi}");

			echo("The user with a non permissioned okta authentication was not able to access the licenses");
		}
		else {
			fail("User was able to search for the license without the right okta authentication.");
		}
	}

	@prose = "I log into the dev domain as ${userEmailAddress} with password ${userPassword}"
	macro _loginToDevDomain {
		Open(locator1 = "https://login-dev.liferay.com/signin/refresh-auth-state/00y4KuEUb2CNOzjwqN8K2asnRECKaHIfTCfmfzFxFR");

		Type(
			locator1 = "OSBLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "OSBLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "OSBLogin#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "OSBLogin#SIGN_IN_BUTTON");
	}

	@prose = "I obtain the okta session ID value from the dev domain page"
	macro _getOktaSessionIdDevPage {
		Open(locator1 = "https://login-dev.liferay.com/api/v1/sessions/me");

		var sessionIdOkta = selenium.getText("//body/pre");

		var sessionIdOkta = StringUtil.extractFirst("${sessionIdOkta}", ",");

		var sessionIdOkta = StringUtil.replace("${sessionIdOkta}", "{", "");

		var sessionIdOkta = StringUtil.replace("${sessionIdOkta}", "&quot;", "");

		var sessionIdOkta = StringUtil.replace("${sessionIdOkta}", "id", "");

		var sessionIdOkta = StringUtil.replace("${sessionIdOkta}", ":", "");

		static var staticSessionIdOkta = "${sessionIdOkta}";

		echo("Session ID Value: ${staticSessionIdOkta}");

		return "${staticSessionIdOkta}";
	}

	@prose = "I should be able to view the following generate license form options for the account ${accountName} with the product group ${productGroupName} ${table}"
	macro _viewGenerateLicenseFormOptions { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/product-groups/${productGroupName}/generate-form
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Label") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[0].versions[?(@.label=='${value}')].label");
			}
			else if ("${field}" == "License Entry Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[0].versions[?(@.label=='${value}')].types[?(@.licenseEntryName=='${licenseEntryName}')].licenseEntryName");
			}
			else {
				fail("License field ${field} not testable via automation at the current time.");
			}

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

			echo("Expected ${field} value: ${value}");
			echo("Actual ${field} value: ${valueFromAPI}");

			if (!("${value}" == "${valueFromAPI}")) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

}