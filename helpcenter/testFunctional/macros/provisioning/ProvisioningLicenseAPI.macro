	@prose = "I create ${licenseNumber} licenses with the following parameters on the account ${accountName} and product purchase ${productName} using okta session id with the following values ${table}"
	macro createMultipleLicenses {
		var count = "0";

		while ("${count}" != "${licenseNumber}") {
			ProvisioningLicenseAPI.createLicenseViaSessionId(
				accountName = "${accountName}",
				productName = "${productName}",
				table = "${table}");

			var count = ${count} + 1;
		}
	}

	@prose = "I should not be able to create a license with the following parameters on the account ${accountName} and product purchase ${productName} with the following values ${table}"
	macro createNoLicense {
		var jsonObject = ProvisioningLicenseAPI.createLicense(
			accountName = "${accountName}",
			productName = "${productName}",
			table = "${table}");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else if (contains("${jsonObject}", "Invalid IP addresses")) {
			echo("The user has entered an invalid IP Address on this API");
		}
		else if (contains("${jsonObject}", "FORBIDDEN")) {
			echo("The user is not authorized to use this API or another invalid data input");
		}
		else if (contains("${jsonObject}", "Invalid MAC addresses")) {
			echo("The user has entered an invalid MAC Address on this API");
		}
		else {
			fail("The user was able to create a license or a different error occur when attempting to create a license.");
		}
	}

	@prose = "I should not be able to create a license with the following parameters on the account ${accountName} and product purchase ${productName} using okta session id with the following values ${table}"
	macro createNoLicenseViaSessionId {
		var jsonObject = ProvisioningLicenseAPI.createLicenseViaSessionId(
			accountName = "${accountName}",
			productName = "${productName}",
			table = "${table}");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else if (contains("${jsonObject}", "Invalid IP addresses")) {
			echo("The user has entered an invalid IP Address on this API");
		}
		else if (contains("${jsonObject}", "FORBIDDEN")) {
			echo("he user is not authorized to use this API or another invalid data input");
		}
		else if (contains("${jsonObject}", "Invalid MAC addresses")) {
			echo("The user has entered an invalid MAC Address on this API");
		}
		else {
			fail("The user was able to create a license or a different error occur when attempting to create a license.");
		}
	}

	@prose = "I deactivate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _deactivateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/deactivate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I deactivate the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _deactivateLicenseSessionId {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/deactivate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to deactivate the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _deactivateNoLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/deactivate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.put("${curl}", "$");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else {
			fail("The user was able to deactive a license with an invalid Session ID.");
		}
	}

	@prose = "I should be able to download a single license on provisioning with the name ${licenseName} on the account ${accountName} via api containing the following values ${table}"
	macro _downloadAndCheckLicenseValues {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
            ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/${licenseKeyId}/download --tlsv1.2
            -u ${provisioningAdminEmail}:${provisioningAdminPassword}
            -H "accept: application/*"
            -H 'Content-Type: application/*'
            ''';

