	@prose = "I should be able to view an error message when attempting to download an aggregate license on the account ${accountName} for the following license keys ${table}"
	macro _viewLicenseAggregateErrorMessage {
		var RawTable rawTable = new RawTable("${table}");
		var licenseKeyIds = "";

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIds}" == "") {
				var licenseKeyIds = "licenseKeyIds=${licenseKeyId}";
			}
			else {
				var licenseKeyIds = "${licenseKeyIds}&licenseKeyIds=${licenseKeyId}";
			}
		}

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download?"${licenseKeyIds}" --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var errorMessage = JSONCurlUtil.get("${curl}");

		if (!(contains("${errorMessage}", "The specified activation keys cannot be aggregated together"))) {
			fail("There was no error message when downloading the aggregated licenses");
		}
	}

	@prose = "I should be able to view the license on the account ${accountName} with the name ${licenseName}"
	macro _viewLicenseKeyIdViaLicenseName {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
