	@prose = "I should be able to view a license search error when searching for a license with the name ${licenseName} on the account ${accountName}"
	macro _viewLicenseKeySearchResultError {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22 --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.get("${curl}", "$");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else {
			fail("The error message text may have changed or the user may not have been denied access. Please verify the API message.");
		}
	}

