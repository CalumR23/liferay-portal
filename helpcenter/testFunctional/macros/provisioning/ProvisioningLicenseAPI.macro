	@prose = "I should not be able to download a license aggregate file on provisioning for the following license keys ${table}"
	macro _viewNoDownloadLicenseAggregate {
		var RawTable rawTable = new RawTable("${table}");
		var licenseKeyIds = "";

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIds}" == "") {
				var licenseKeyIds = "licenseKeyIds=${licenseKeyId}";
			}
			else {
				var licenseKeyIds = "${licenseKeyIds}&licenseKeyIds=${licenseKeyId}";
			}
		}

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download?"${licenseKeyIds}" --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var error = JSONCurlUtil.get("${curl}", "$");

		if (!(contains("${error}", "The specified activation keys cannot be aggregated together"))) {
			fail("The error message may have changed or a non expected license aggregate may have been downloaded. Please investigate");
		}
	}

	@prose = "I should not be able to download a license aggregate file on provisioning using okta session id for the following license keys ${table}"
	macro _viewNoDownloadLicenseAggregateSessionId {
		var RawTable rawTable = new RawTable("${table}");
		var licenseKeyIds = "";

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIds}" == "") {
				var licenseKeyIds = "licenseKeyIds=${licenseKeyId}";
			}
			else {
				var licenseKeyIds = "${licenseKeyIds}&licenseKeyIds=${licenseKeyId}";
			}
		}

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download?"${licenseKeyIds}" --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

