definition {

	var oktaURL = PropsUtil.get("okta.liferay.login.dev.url");
	var oktaApiToken = PropsUtil.get("okta.api.token");
	var oktaUserPassword = PropsUtil.get("okta.user.password");
	var provisioningAdminEmail = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var roleName = PropsUtil.get("provisioning.non.permission.role.name");

	@prose = "I activate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _activateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I activate the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _activateLicenseSessionId {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should not be able to activate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _activateNoLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.put("${curl}", "$");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else {
			fail("The user was able to active a license with an invalid Session ID.");
		}
	}

	@prose = "I should not be able to activate the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _activateNoLicenseSessionId {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.put("${curl}", "$");

		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
		else {
			fail("The user was able to active a license with an invalid Session ID.");
		}
	}

	@prose = "the API response should have the exception message ${apiResponseMessage}"
	macro assertApiResponse {
		if (contains("${staticApiResponse}", "${apiResponseMessage}")) {
			echo("The Exception has the message ${apiResponseMessage}");
		}
		else {
			fail("The API response ${staticApiResponse} did not have the text ${apiResponseMessage}");
		}
	}

	@prose = "I create a license with the following parameters on the account ${accountName} and product purchase ${productName} with the following values ${table}"
	macro createLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${productName}");
		var productPurchaseKey = KoroneikiAccountAPI._getAccountProductPurchaseKeyViaAccountAndProductName(
			accountName = "${accountName}",
			productName = "${productName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Account Key") {
				var accountKey = "${value}";
			}
			else if ("${field}" == "Active") {
				var active = "${value}";
			}
			else if ("${field}" == "Adittional Info") {
				var additionalInfo = "${value}";
			}
			else if ("${field}" == "Cluster Id") {
				var clusterId = "${value}";
			}
			else if ("${field}" == "Complimentary") {
				var complimentary = "${value}";
			}
			else if ("${field}" == "Expiration Date") {
				var expirationDate = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Host Name") {
				var hostName = "${value}";
			}
			else if ("${field}" == "Ip Address") {
				var ipAddresses = "${value}";
			}
			else if ("${field}" == "Mac Address") {
				var macAddresses = "${value}";
			}
			else if ("${field}" == "License Entry Name") {
				var licenseEntryName = "${value}";
			}
			else if ("${field}" == "License Entry Type") {
				var licenseEntryType = "${value}";
			}
			else if ("${field}" == "Max Cluster Nodes") {
				var maxClusterNodes = "${value}";
			}
			else if ("${field}" == "License Version") {
				var licenseVersion = "${value}";
			}
			else if ("${field}" == "Max Http Sessions") {
				var maxHttpSessions = "${value}";
			}
			else if ("${field}" == "Max Servers") {
				var maxServers = "${value}";
			}
			else if ("${field}" == "Modified User Name") {
				var modifiedUserName = "${value}";
			}
			else if ("${field}" == "Modified User Uuid") {
				var modifiedUserUuid = "${value}";
			}
			else if ("${field}" == "Name") {
				var name = "${value}";
			}
			else if ("${field}" == "Owner") {
				var owner = "${value}";
			}
			else if ("${field}" == "Product Id") {
				var productId = "${value}";
			}
			else if ("${field}" == "Product Key") {
				var productKey = "${value}";
			}
			else if ("${field}" == "Product Purchase Key") {
				var productPurchaseKey = "${value}";
			}
			else if ("${field}" == "Product Version") {
				var productVersion = "${value}";
			}
			else if ("${field}" == "Server Id") {
				var serverId = "${value}";
			}
			else if ("${field}" == "Sizing") {
				var sizing = "${value}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value}";
			}
			else if ("${field}" == "User Name") {
				var userName = "${value}";
			}
			else if ("${field}" == "User Uuid") {
				var userUuid = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		if (!(isSet(active))) {
			var active = "true";
		}

		if (!(isSet(additionalInfo))) {
			var additionalInfo = "AdittionalInformation";
		}

		if (!(isSet(assetReceiptLicenseUuid))) {
			var assetReceiptLicenseUuid = "";
		}

		if (!(isSet(clusterId))) {
			var clusterId = "0";
		}

		if (!(isSet(description))) {
			var description = "";
		}

		if (!(isSet(complimentary))) {
			var complimentary = "false";
		}

		if (!(isSet(createDate))) {
			var createDate = "${staticStartDate}";
		}

		if (!(isSet(expirationDate))) {
			var expirationDate = "${staticEndDate}";
		}

		if (!(isSet(hostName))) {
			var hostName = "localhost";
		}

		if (!(isSet(productPurchaseKey))) {
			var productPurchaseKey = "${staticProductPurchaseKey}";
		}

		if (!(isSet(ipAddresses))) {
			var ipAddresses = "123.45.67.89";
		}

		if (!(isSet(macAddresses))) {
			var macAddresses = "0A-1B-2C-3D-4E-5F";
		}

		if (!(isSet(licenseEntryName))) {
			var licenseEntryName = "";
		}

		if (!(isSet(maxClusterNodes))) {
			var maxClusterNodes = "0";
		}

		if (!(isSet(licenseVersion))) {
			var licenseVersion = "";
		}

		if (!(isSet(maxHttpSessions))) {
			var maxHttpSessions = "";
		}

		if (!(isSet(maxServers))) {
			var maxServers = "";
		}

		if (!(isSet(modifiedUserName))) {
			var modifiedUserName = "";
		}

		if (!(isSet(modifiedUserUuid))) {
			var modifiedUserUuid = "";
		}

		if (!(isSet(productId))) {
			var productId = "";
		}

		if (!(isSet(productKey))) {
			var productKey = "${productKey}";
		}

		if (!(isSet(productVersion))) {
			var productVersion = "";
		}

		if (!(isSet(sizing))) {
			var sizing = "Sizing 1";
		}

		if (!(isSet(startDate))) {
			var startDate = "${staticStartDate}";
		}

		if (!(isSet(userName))) {
			var userName = "";
		}

		if (!(isSet(userUuid))) {
			var userUuid = "";
		}
		else {
			fail("No such user field ${field}");
		}

		var partialUuid1 = StringUtil.randomString("8");
		var partialUuid2 = StringUtil.randomString("4");
		var partialUuid3 = StringUtil.randomString("4");
		var partialUuid4 = StringUtil.randomString("4");
		var partialUuid5 = StringUtil.randomString("12");

		var userUuid = "${partialUuid1}-${partialUuid2}-${partialUuid3}-${partialUuid4}-${partialUuid5}";
		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			-d
			[{
				"accountKey": "${accountKey}",
				"active": "${active}",
				"complimentary": "${complimentary}",
				"description": "${description}",
				"hostName": "${hostName}",
				"ipAddresses": "${ipAddresses}",
				"maxClusterNodes": "${maxClusterNodes}",
				"macAddresses": "${macAddresses}",
				"expirationDate": "${expirationDate}",
				"licenseEntryType": "${licenseEntryType}",
				"name": "${name}",
				"productKey": "${productKey}",
				"productName": "${productName}",
				"productPurchaseKey": "${productPurchaseKey}",
				"productVersion": "${productVersion}",
				"sizing": "${sizing}",
				"startDate": "${startDate}"
			}]
			''';

		var apiResponse = JSONCurlUtil.post("${curl}");

		static var staticApiResponse = "${apiResponse}";

		return "${staticApiResponse}";
	}

