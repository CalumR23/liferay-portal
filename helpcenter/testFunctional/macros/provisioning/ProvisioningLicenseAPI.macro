				}
				else {
					var filters = "${filters}+and+${field}+eq+${value}";
				}
			}
			else if ("${field}" == "Product Name") {
				var field = "productName";

				if (contains("${value}", " ")) {
					var value = StringUtil.replace("${value}", " ", "+");
				}

				if ("${filters}" == "") {
					var filters = "license-keys?filter=${field}+eq+%27${value}%27";
				}
				else {
					var filters = "${filters}+and+${field}+eq+%27${value}%27";
				}
			}
			else if ("${field}" == "License Entry Type") {
				var field = "licenseEntryType";

				var value = StringUtil.toLowerCase("${value}");

				if (contains("${value}", " ")) {
					var value = StringUtil.replace("${value}", " ", "+");
				}

				if ("${filters}" == "") {
