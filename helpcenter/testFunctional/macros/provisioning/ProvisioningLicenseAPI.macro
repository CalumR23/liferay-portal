definition {
	var provisioningAdminEmail = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var roleName = PropsUtil.get("provisioning.non.permission.role.name");

	@prose = "I activate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _activateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/activate?licenseKeyIds=${licenseKeyId}
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I deactivate the license on provisioning with the name ${licenseName} on the account ${accountName}"
	macro _deactivateLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/deactivate?licenseKeyIds=${licenseKeyId}
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I should be able to download a ${productGroup} developer license with version ${productVersion} on the account ${accountName} via api"
	macro _downloadDeveloperLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/product-groups/${productGroup}/product-version/${productVersion}/development-license-key
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var licenseFile = JSONCurlUtil.get("${curl}");

		if (!(contains("${licenseFile}","${productGroup}"))) {
			fail("The development license of the group ${productGroup} and version ${productVersion} was not downloaded");
		}

		if (!(contains("${licenseFile}","${productVersion}"))) {
			fail("The development license of the group ${productGroup} and version ${productVersion} was not downloaded");
		}
	}

	@prose = "I should be able to download a single license on provisioning with the name ${licenseName} on the account ${accountName} via api"
	macro _downloadLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/${licenseKeyId}/download
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var licenseFile = JSONCurlUtil.get("${curl}", "$");

		if (!(contains("${licenseFile}","${accountName}"))) {
			fail("The value ${accountName} is not present in the license file");
		}
	}

	@prose = "I should not be able to download a ${productGroup} developer license with version ${productVersion} on the account ${accountName} via api"
	macro _downloadNoDeveloperLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/product-groups/${productGroup}/product-version/${productVersion}/development-license-key
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var licenseFile = JSONCurlUtil.get("${curl}");

		if (contains("${licenseFile}","${productGroup}")) {
			fail("The development license of the group ${productGroup} and version ${productVersion} was downloaded ");
		}

		if (contains("${licenseFile}","${productVersion}")) {
			fail("The development license of the group ${productGroup} and version ${productVersion} was downloaded ");
		}
	}

	@prose = "I extend the license on provisioning with the name ${licenseName} on the account ${accountName} and the product purchase key ${productPurchaseKey} with the following values ${table}"
	macro _extendLicense {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Expiration Date") {
				var expirationDate = "${value}";
			}
			else if ("${field}" == "Start Date") {
				var startDate = "${value}";
			}
			else {
				fail("No such license extension field ${field}");
			}
		}

		if (!(isSet(expirationDate))) {
			var expirationDate = "";
		}
		if (!(isSet(startDate))) {
			var startDate = "";
		}

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/license-keys/extend
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H 'Content-Type: application/json'
			-d
			[{
				"id": ${licenseKeyId},
				"expirationDate": "${expirationDate}",
				"productPurchaseKey": "${productPurchaseKey}",
				"startDate": "${startDate}"
			}]
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	macro _getLicenseKeyIdViaLicenseName {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var licenseKeyId = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].id");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "[", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "]", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "&quot;", "");

		echo("License Key ID value for ${licenseName}: ${licenseKeyId}");

		return "${licenseKeyId}";
	}

	@prose = "I should be able to view the active license on the account ${accountName} with the name ${licenseName} and the following values ${table}"
	macro _viewActiveLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=active+eq+true
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "License Entry Type") {
				var value = StringUtil.lowerCaseFirstLetter("${value}");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].licenseEntryType");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("This license field ${field} either does not exist or has not been added to the macro yet for testing. Please update test or macro accordingly.");
			}
		}

		echo("Expected ${field} Value: ${value}");
		echo("Actual ${field} Value: ${valueFromAPI}");

		if (!("${value}" == "${valueFromAPI}")) {
			fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
		}
	}

	@prose = "I should be able to view the deactivated license on the account ${accountName} with the name ${licenseName} and the following values ${table}"
	macro _viewDeactivatedLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=active+eq+false
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else if ("${field}" == "License Entry Type") {
				var value = StringUtil.lowerCaseFirstLetter("${value}");

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].licenseEntryType");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");
			}
			else {
				fail("This license field ${field} either does not exist or has not been added to the macro yet for testing. Please update test or macro accordingly.");
			}
		}

		echo("Expected ${field} Value: ${value}");
		echo("Actual ${field} Value: ${valueFromAPI}");

		if (!("${value}" == "${valueFromAPI}")) {
			fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
		}
	}

	@prose = "I should be able to view the following generate license form options for the account ${accountName} with the product group ${productGroupName} ${table}"
	macro _viewGenerateLicenseFormOptions { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/product-groups/${productGroupName}/generate-form
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value1 = "${row[1]}";
			var value2 = "${row[2]}";
			var value3 = "${row[3]}";

			if ("${field}" == "Allow Permanent Licenses") {
				var expectedValue = "${value1}";

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.allowPermanentLicenses");
			}
			else if ("${field}" == "Label") {
				var expectedValue = "${value1}";

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value1}')].label");
			}
			else if ("${field}" == "License Entry Name") {
				var expectedValue = "${value2}";

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value1}')].types[?(@.licenseEntryName=='${value2}')].licenseEntryName");
			}
			else if ("${field}" == "License Entry Type") {
				var expectedValue = "${value3}";

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value1}')].types[?(@.licenseEntryType=='${value3}' && @.licenseEntryName=='${value2}')].licenseEntryType");
			}
			else if ("${field}" == "Product Key") {
				var productKey = KoroneikiProductAPI._getProductKeyViaProductName(productName = "${value2}");
				var expectedValue = "${productKey}";

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value1}')].types[?(@.productKey=='${productKey}' && @.licenseEntryName=='${value2}')].productKey");
			}
			else {
				fail("License field ${field} not testable via automation at the current time.");
			}

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

			echo("Expected ${field} value: ${expectedValue}");
			echo("Actual ${field} value: ${valueFromAPI}");

			if (!("${expectedValue}" == "${valueFromAPI}")) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${expectedValue}");
			}
		}
	}

	@prose = "I should be able to view the following generate license form options for the account ${accountName} with the product group ${productGroupName} using the okta session id value ${oktaSessionId} ${table}"
	macro _viewGenerateLicenseFormOptionsUsingOktaAuth { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/product-groups/${productGroupName}/generate-form
			-H "Okta-Session-ID: ${oktaSessionId}"
			-H "accept: application/json"
			-H 'Content-Type: application/json'
			''';

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Label") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value}')].label");
			}
			else if ("${field}" == "License Entry Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.versions[?(@.label=='${value}')].types[?(@.licenseEntryName=='${licenseEntryName}')].licenseEntryName");
			}
			else {
				fail("License field ${field} not testable via automation at the current time.");
			}

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

			var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

			echo("Expected ${field} value: ${value}");
			echo("Actual ${field} value: ${valueFromAPI}");

			if (!("${value}" == "${valueFromAPI}")) {
				fail("Actual ${field} value ${valueFromAPI} does not match expected ${field} value ${value}");
			}
		}
	}

	@prose = "I should be able to view the license on the account ${accountName} with the name ${licenseName} using the okta session id value ${oktaSessionId}"
	macro _viewLicenseKeyIdViaLicenseNameUsingOktaAuth {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100
			-H "Okta-Session-ID: ${oktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var licenseNameFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].name");

		var licenseNameFromAPI = StringUtil.replace("${licenseNameFromAPI}", "[", "");

		var licenseNameFromAPI = StringUtil.replace("${licenseNameFromAPI}", "]", "");

		var licenseNameFromAPI = StringUtil.replace("${licenseNameFromAPI}", "&quot;", "");

		var licenseNameFromAPI = StringUtil.replace("${licenseNameFromAPI}", "+", " ");

		echo("Expected license key name value: ${licenseName}");
		echo("Actual license key name value: ${licenseNameFromAPI}");

		if (!("${licenseNameFromAPI}" == "${licenseName}")) {
			fail("Actual license name ${licenseNameFromAPI} does not match expected license name value ${licenseName}");
		}
	}

	@prose = "I should not be able to view the active license on the account ${accountName} with the name ${licenseName}"
	macro _viewNoActiveLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=active+eq+true
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var allActiveLicenses = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allActiveLicenses}", "${licenseName}")) {
			fail("The license with the name ${licenseName} is returning as active unexpectedly on ${accountName}");
		}
	}

	@prose = "I should not be able to view the deactivated license on the account ${accountName} with the name ${licenseName}"
	macro _viewNoDeactivatedLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=active+eq+false
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var allDeactivatedLicenses = JSONCurlUtil.get("${curl}", "$");

		if (contains("${allDeactivatedLicenses}", "${licenseName}")) {
			fail("The license with the name ${licenseName} is returning as deactivated unexpectedly on ${accountName}");
		}
	}

	@prose = "I should not be able to view the license on the account ${accountName} with the name ${licenseName} using the okta session id value ${oktaSessionId}"
	macro _viewNoLicenseKeyIdViaLicenseNameAttemptUsingOktaAuth {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%27${keyword}%27
			-H "Okta-Session-ID: ${oktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.get("${curl}", "$");

		if (contains("${jsonObject}", "${keyword}")) {
			fail("The license with the name ${licenseName} is visible to a non permissioned user");
		}
		if (contains("${jsonObject}", "Access denied to")) {
			echo("The user is not authorized to use this API");
		}
	}
}