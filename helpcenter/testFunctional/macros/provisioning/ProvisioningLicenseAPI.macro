	@prose = "I should be able to download a license aggregate file on provisioning on the account ${accountName} for the following license keys with the ${aggregatedFilePattern} XML file pattern ${table}"
	macro _downloadLicenseAggregate {
		var RawTable rawTable = new RawTable("${table}");
		var licenseKeyIds = "";

		for (var row : table "${rawTable}") {
			var licenseKeyId = "${row[0]}";

			if ("${licenseKeyIds}" == "") {
				var licenseKeyIds = "licenseKeyIds=${licenseKeyId}";
			}
			else {
				var licenseKeyIds = "${licenseKeyIds}&licenseKeyIds=${licenseKeyId}";
			}
		}

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/download?"${licenseKeyIds}" --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';

		var licenseFile = JSONCurlUtil.get("${curl}", "$");

		if (!(contains("${licenseFile}", "${accountName}"))) {
			fail("The value ${accountName} is not present in the license file");
		}

		if ("${aggregatedFilePattern}" == "old") {
			if (contains("${licenseFile}", "<server>")) {
				echo("XML file downloaded is at the old Aggregated XML format");
			}
			else {
				fail("XML file downloaded is at the new Aggregated XML format, test should fail due to that");
			}
		}
		else if ("${aggregatedFilePattern}" == "new") {
			if (!(contains("${licenseFile}", "<server>"))) {
				echo("XML file downloaded is at the new Aggregated XML format");
			}
			else {
				fail("XML file downloaded is at the old Aggregated XML format, test should fail due to that");
			}
		}
		else {
			echo("Invalid aggregate file pattern type ${aggregatedFilePattern}. Please set the aggregatedFilePattern variable to old or new.");
		}
	}

