		}
	}

	@prose = "I should not be able to view the contact with the email address ${contactEmailAddress} on the account ${accountName} as a subscriber to the following licenses using okta session id ${table}"
	macro _viewNoSubscribedContactViaSessionId {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var value = "${row[0]}";

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=subscriptionContactUuids/any%28s:contains%28s,%27${contactUuid}%27%29%29 --tlsv1.2
				-H "Okta-Session-ID: ${staticOktaSessionId}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var licensesSubscribed = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${value}')].name");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "[", "");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "]", "");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "\"", "");


			echo("The License that the user ${contactEmailAddress} is subscribed to is ${licensesSubscribed} , if it's empty is not subscribed to it!");

			if (contains("${licensesSubscribed}", "${value}")) {
				fail("The license ${value} isn't subscribed to the user ${contactEmailAddress} when it shouldn't be");
			}
		}
	}

	@prose = "I should be able to view the contact with the email address ${contactEmailAddress} on the account ${accountName} as a subscriber to the following licenses using okta session id ${table}"
	macro _viewSubscribedContactViaSessionId {
		var contactUuid = KoroneikiContactAPI._getContactUuidViaContactEmailAddress(contactEmailAddress = "${contactEmailAddress}");
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var value = "${row[0]}";

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=subscriptionContactUuids/any%28s:contains%28s,%27${contactUuid}%27%29%29 --tlsv1.2
				-H "Okta-Session-ID: ${staticOktaSessionId}"
				-H "accept: application/json"
				-H "Content-Type: application/json"
				''';

			var licensesSubscribed = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${value}')].name");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "[", "");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "]", "");

			var licensesSubscribed = StringUtil.replace("${licensesSubscribed}", "\"", "");


			echo("The License that the user ${contactEmailAddress} is subscribed to is ${licensesSubscribed}");

			if("${licensesSubscribed}" != "${value}"){
				fail("The license ${value} isn't subscribed to the user ${contactEmailAddress}");
			}
		}
	}

}