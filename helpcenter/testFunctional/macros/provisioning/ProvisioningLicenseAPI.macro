	@prose = "I should not be able to view the license on the account ${accountName} with the name ${licenseName}"
	macro _viewNoLicenseKeyIdViaLicenseName {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%27${keyword}%27 --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var jsonObject = JSONCurlUtil.get("${curl}", "$");

		if (contains("${jsonObject}", "${keyword}")) {
			fail("The license with the name ${licenseName} is visible to a non permissioned user");
		}
	}

	@prose = "I should not be able to view the license on the account ${accountName} with the name ${licenseName} using okta session id"
	macro _viewNoLicenseKeyIdViaLicenseNameSessionId {
