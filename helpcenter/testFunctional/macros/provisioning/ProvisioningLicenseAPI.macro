	macro _getLicenseKeyIdViaLicenseName {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var keyword = StringUtil.replace("${licenseName}", " ", "+");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?search=%22${keyword}%22\&pageSize=100 --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var licenseKeyId = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${licenseName}')].id");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "[", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "]", "");

		var licenseKeyId = StringUtil.replace("${licenseKeyId}", "\"", "");

		echo("License Key ID value for ${licenseName}: ${licenseKeyId}");

		return "${licenseKeyId}";
	}

	@prose = "I subscribe the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _subscribeToLicenseViaSessionId {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/subscriptions?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var apiReturn = JSONCurlUtil.put("${curl}");

		if (contains("${apiReturn}", "FORBIDDEN")) {
			fail("There is an error message when subscribing the user to the license");
		}
		else if (contains("${apiReturn}", "INTERNAL_SERVER_ERROR")) {
			fail("There is an error message when subscribing the user to the license");
		}
	}

	@prose = "I attempt to subscribe the license on provisioning with the name ${licenseName} on the account ${accountName} using okta session id"
	macro _subscribeToLicenseViaSessionIdAttempt {
		var licenseKeyId = ProvisioningLicenseAPI._getLicenseKeyIdViaLicenseName(
			accountName = "${accountName}",
			licenseName = "${licenseName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/license-keys/subscriptions?licenseKeyIds=${licenseKeyId} --tlsv1.2
			-H "Okta-Session-ID: ${staticOktaSessionId}"
			-H "accept: application/json"
			-H "Content-Type: application/json"
			''';

		var errorMessage = JSONCurlUtil.put("${curl}");

		if (!((contains("${errorMessage}", "FORBIDDEN")) || (contains("${errorMessage}", "INTERNAL_SERVER_ERROR")) )) {
			fail("There was no error message when subscribing the user to the license");
		}
	}

