	@prose = "I should be able to view the active license on the account ${accountName} with the name ${licenseName} and the following values ${table}"
	macro _viewActiveLicense {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

		var curl = '''
			${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/license-keys?filter=active+eq+true --tlsv1.2
			-u ${provisioningAdminEmail}:${provisioningAdminPassword}
			-H "accept: application/*"
			-H 'Content-Type: application/*'
			''';
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.name=='${value}')].name");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "\"", "");

				if (!(contains("${valueFromAPI}", "${value}"))) {
					fail("The expected value ${value} does not match the actual value ${valueFromAPI} at the api assert check");
				}
			}
			else if ("${field}" == "License Entry Type") {
				var value = StringUtil.lowerCaseFirstLetter("${value}");
				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.items[?(@.licenseEntryType=='${value}' && @.name=='${licenseName}')].licenseEntryType");

