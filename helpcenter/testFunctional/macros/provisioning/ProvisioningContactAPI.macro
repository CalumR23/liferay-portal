definition {
	var provisioningAdminEmail = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var roleName = PropsUtil.get("provisioning.non.permission.role.name");

    @prose = "I assign the following roles to the user with the email adress ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignContactRolesToContact { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");

        var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

            var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName}
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H 'Content-Type: application/json'
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I should not be able to assign the following roles to the user with the email adress ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignNoContactRolesToContact { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");

        var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

            var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName}
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H 'Content-Type: application/json'
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "Account has reached the maximum allowed ticket requestors"))) {
				fail("The contact was added to the account instead of failing due to the maximum contact number ");
			}
		}
	}

	@prose = "I should not be able to assign the following roles to the user with a invalid email adress domain ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignNoContactRolesToInvalidContact { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");

        var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

            var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName}
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H 'Content-Type: application/json'
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "Domain ${userEmailAddress} is not allowed"))) {
				fail("The email adress is invalid or blocked");
			}
		}
	}

    @prose = "I unassign the following roles from the user with the email adress ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _unassignContactRolesToContact { 
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

        var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");

        var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

            var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				--tlsv1.2 ${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName}
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H 'Content-Type: application/json'
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}
}