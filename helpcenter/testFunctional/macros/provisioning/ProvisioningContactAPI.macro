definition {

	var provisioningAdminEmail = PropsUtil.get("provisioning.admin.email.address");
	var provisioningAdminPassword = PropsUtil.get("provisioning.admin.password");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");
	var roleName = PropsUtil.get("provisioning.non.permission.role.name");

	@prose = "I attempt to assign the following roles already assigned to the user with the email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignAlreadyAssignedContactRolesToContactAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "The contact is already assigned to the role on the account"))) {
				fail("The role contact may have been added to the contact instead of failing due to the already assigned role on the contact");
			}
		}
	}

	@prose = "I assign the following roles to the user with the email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignContactRolesToContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I attempt to assign the following roles to the user with the email address ${userEmailAddress} on the account with the name ${accountName} that has exceeded its max developer contacts ${table}"
	macro _assignContactRolesToContactOnAccountWithMaxDeveloperContactsAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "Account has reached the maximum allowed ticket requesters"))) {
				fail("The contact may have been added to the account instead of failing due to the maximum contact number");
			}
		}
	}

	@prose = "I attempt to assign the following roles to the user with a invalid email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignContactRolesToContactWithInvalidEmailAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailDomain = StringUtil.extractLast("${userEmailAddress}", "@");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "Domain ${userEmailDomain} is not allowed"))) {
				fail("The contact may have been added to the account instead of failing due to an invalid email or the error message may have changed. Please investigate.");
			}
		}
	}

	@prose = "I attempt to assign the following roles to the user with a non okta email address ${userEmailAddress} on an inactive account with the name ${accountName} ${table}"
	macro _assignContactRolesToContactWithNonOktaEmailOnInactiveAccountAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailDomain = StringUtil.extractLast("${userEmailAddress}", "@");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "NOT_FOUND"))) {
				fail("The contact may have been added to the inactive account instead of failing due to a non okta email or the error message may have changed. Please investigate.");
			}
		}
	}

	@prose = "I attempt to assign the following nonexisting contact roles to the user with the email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _assignNonexistingContactRolesToContactAttempt {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.put("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "No contact role exists"))) {
				fail("The role contact may have been added to the account instead of failing due to the adding nonexisting contact role");
			}
		}
	}

	@prose = "I attempt to unassign the following roles from the last remaining user containing them with email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _unassignContactRolesFromLastRemainingContactContainingThem {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			var responseOfContactApi = JSONCurlUtil.delete("${curl}", "$");

			if (!(contains("${responseOfContactApi}", "INTERNAL_SERVER_ERROR"))) {
				fail("The contact may have been removed of the account instead of failing due to being the last role of this kind. Please investigate.");
			}
		}
	}

	@prose = "I unassign the following roles from the user with the email address ${userEmailAddress} on the account with the name ${accountName} ${table}"
	macro _unassignContactRolesToContact {
		var accountKey = KoroneikiAccountAPI._getAccountKeyViaAccountName(accountName = "${accountName}");
		var userEmailAddress = StringUtil.replace("${userEmailAddress}", " ", "%20");

		var userEmailAddress = StringUtil.replace("${userEmailAddress}", "@", "%40");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var contactRoleName = "${row[0]}";

			var contactRoleName = StringUtil.replace("${contactRoleName}", " ", "%20");

			var curl = '''
				${provisioningURL}/o/provisioning-rest/v1.0/accounts/${accountKey}/contacts/by-email-address/${userEmailAddress}/roles?contactRoleNames=${contactRoleName} --tlsv1.2
				-u ${provisioningAdminEmail}:${provisioningAdminPassword}
				-H "accept: application/json"
				-H "Content-Type: application/json"
				-H "Content-Length: 0"
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

}