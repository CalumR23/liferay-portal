	@prose = "the following account address fields and types in position ${positionValue} under the account details tab should be disabled ${table}"
	macro viewNonEditableAccountAddressDetailsFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var key_field = "${field}";
			var key_positionValue = "${positionValue}";

			OSBAdmin.pause(timeInSeconds = "3");

			AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE");

			if ("${type}" == "Toggle Switch") {
				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_ALT");
			}
			else {
				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE");
			}

			var key_positionValue = "1";

			if ("${type}" == "Input") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_INPUT");
			}
			else if ("${type}" == "Select") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT");
			}
			else if ("${type}" == "Toggle Switch") {
				AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_DISABLED");
			}
			else {
				fail("No such account address detail field type ${type}. Please use Input, Select, or Toggle Switch.");
			}
		}

		AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_SAVE_ADDRESS_CHANGES_BUTTON");
	}

	@prose = "the following account fields and types under the account details tab should be disabled ${table}"
	macro viewNonEditableAccountDetailsFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var positionValue = "${row[2]}";
			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";
			}

			OSBAdmin.pause(timeInSeconds = "3");

			AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE");

			if ("${type}" != "File Upload") {
				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE");
			}

			if ("${type}" == "Input") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_INPUT");
			}
			else if ("${type}" == "Select") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT");
			}
			else if ("${type}" == "Textarea") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TEXTAREA");
			}
			else if ("${type}" == "File Upload") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_FILE_UPLOAD");
			}
			else if ("${type}" == "Toggle Switch") {
				AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_DISABLED");
			}
			else if ("${type}" == "Select Entity") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT_BUTTON");
			}
			else if ("${type}" == "Delete Entity") {
				AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_DELETE_BUTTON");
			}
			else {
				fail("No such account detail field type ${type}. Please use Input, Select, Textarea, Toggle Switch, File Upload, Select Entity, or Delete Entity.");
			}

			AssertElementNotPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SAVE_BUTTON");
		}
	}

