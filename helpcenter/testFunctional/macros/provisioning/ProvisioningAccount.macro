		ClickNoError(locator1 = "ProvisioningAccount#TEAM_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this team?");
	}

	@prose = "I click on the view archived notes link"
	macro clickViewArchivedNotesLink {
		Click(locator1 = "ProvisioningAccount#VIEW_ARCHIVED_NOTES_LINK");
	}

	@prose = "I click on the view archived sales info link"
	macro clickViewArchivedSalesInfoLink {
		Click(locator1 = "ProvisioningAccount#VIEW_ARCHIVED_SALES_INFO_LINK");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the worker with the email address ${emailAddress}"
	macro clickWorkerActionDropdownButton {
		var key_workerEmailAddress = "${emailAddress}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#WORKER_ACTION_BUTTON");

		var key_action = "${action}";

		if ("${action}" == "Unassign") {
			ClickNoError(locator1 = "ProvisioningAccount#WORKER_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to unassign this Liferay worker?");
		}
		else {
			Click(locator1 = "ProvisioningAccount#WORKER_DROPDOWN_ACTION_BUTTON");
		}
	}

	@prose = "I click on the cancel button in the worker form"
	macro clickWorkerFormCancelButton {
		Click(locator1 = "ProvisioningAccountAssignWorker#CANCEL_BUTTON");
	}

	@prose = "I collapse the side panel on the account details page"
	macro collapseSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON");
		}
	}

	@prose = "I create a note with the content ${content} on the account details page"
	macro createNote {
		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_NOTE_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_SUCCESS_MESSAGE");
	}

	@prose = "I create a sales info note with the content ${content} on the account details page"
	macro createSalesInfo {
		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SUCCESS_MESSAGE");
	}

	@prose = "I close the account with the name ${accountName} and code ${accountCode}"
	macro closeAccount {
		var key_accountCode = "${accountCode}";
		var key_accountName = "${accountName}";

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountCloseAccount#ACCOUNT_CLOSE_MESSAGE",
			value1 = "Are you sure you want to close the account listed below?");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountCloseAccount#ACCOUNT_NAME",
			value1 = "${accountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountCloseAccount#ACCOUNT_CODE",
			value1 = "${accountCode}");

		Click(locator1 = "ProvisioningAccountCloseAccount#CLOSE_ACCOUNT_BUTTON");
	}

	@prose = "I delete the account address in position ${positionValue}"
	macro deleteAccountAddress {
		var key_positionValue = "${positionValue}";

		ClickNoError(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_DELETE_ADDRESS_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this address?");
	}

	@prose = "I edit the following account address fields and types in position ${positionValue} to the following values under the account details tab ${table}"
	macro editAccountAddressDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";

			var key_field = "${field}";

			var key_positionValue = "${positionValue}";

			OSBAdmin.pause(timeInSeconds = "3");

			AssertVisible(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_LABEL");

			if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE")) {
				Click.clickNoMouseOver(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE");
			}

			var key_positionValue = "1";

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_INPUT",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT",
					value1 = "${value}");	
			}
			else if ("${type}" == "Toggle Switch") {
				if ("${value}" == "true") {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_OFF")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
				else {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_ON")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
			}
			else {
				fail("No such account address detail field type ${type}. Please use Input, Select, or Toggle Switch.");
			}
		}

		Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_SAVE_ADDRESS_CHANGES_BUTTON");
	}

	@prose = "I edit the following account fields and types to the following values under the account details tab ${table}"
	macro editAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";
			var positionValue = "${row[3]}";

			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";				
			}

			OSBAdmin.pause(timeInSeconds = "3");

			AssertVisible(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_LABEL");

			if (!("${type}" == "File Upload")) {
				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE");
			}

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_INPUT",
					value1 = "${value}");					
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT",
					value1 = "${value}");	
			}
			else if ("${type}" == "Textarea") {
				Type(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TEXTAREA",
					value1 = "${value}");	
			}
			else if ("${type}" == "File Upload") {
				UploadCommonFile(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_FILE_UPLOAD",
					value1 = "${value}");	
			}
			else if ("${type}" == "Toggle Switch") {
				if ("${value}" == "true") {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_OFF")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
				else {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_ON")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
			}
			else if ("${type}" == "Select Entity") {
				Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT_BUTTON");

				SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

 				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_FIELD",
					value1 = "${keyword}");

				Click(locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#ADD_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningAccountSelect#ADD_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#ADD_BUTTON");
				}
			}
			else if ("${type}" == "Delete Entity") {
				Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_DELETE_BUTTON");
			}
 			else {
				fail("No such account detail field type ${type}. Please use Input, Select, Textarea, Toggle Switch, File Upload, Select Entity, or Delete Entity.");
			}

			if ((!("${type}" == "File Upload")) && (!("${type}" == "Select Entity")) && (!("${type}" == "Delete Entity"))) {
				Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SAVE_BUTTON");
			}
		}
	}

	@prose = "I edit and cancel the following account address fields and types in position ${positionValue} to the following values under the account details tab ${table}"
	macro editAndCancelAccountAddressDetails {
		var RawTable rawTable = new RawTable("${table}");

