	@prose = "I should be able to view the product with the name ${productName} and the following values on the account details page ${table}"
	macro _viewAccountProduct {
		var key_productName = "${productName}";

		AssertElementPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Next Term Starts") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE_SECONDARY_INFORMATION",
					value1 = "Next Term Starts: ${value}");
			}
			else if ("${field}" == "Grace Period End Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE_SECONDARY_INFORMATION",
					value1 = "Grace Period End Date: ${value}");
			}
			else if ("${field}" == "Current Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_CURRENT_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Current Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_CURRENT_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Latest Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_LATEST_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Approved Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_APPROVED_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such account product field ${field}");
			}
		}
	}

