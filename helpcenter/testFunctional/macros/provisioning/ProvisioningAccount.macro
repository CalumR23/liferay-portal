definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I clear the subscription search in the ${tabName} tab"
	macro clearSubscriptionSearch {
		if ("${tabName}" == "Active") {
			var key_pageValue = "1";
		}
		else if ("${tabName}" == "Inactive") {
			var key_pageValue = "2";
		}		
		else if ("${tabName}" == "All") {
			var key_pageValue = "3";
		}
		else {
			fail("No such tab ${tabName}. Please choose Active, Inactive, or All as the tab name.");
		}

		Type(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "");

		KeyPress(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I click on the back button in the archived notes section"
	macro clickBackButtonViaArchivedNotes {
		Click(locator1 = "ProvisioningAccount#ARCHIVED_NOTES_BACK_BUTTON");
	}

	@prose = "I click on the ${tabName} side panel tab"
	macro clickSidePanelTab {
		var key_tabName = "${tabName}";

		Click(locator1 = "ProvisioningAccount#SIDE_PANEL_TAB");
	}

	@prose = "I click on the ${tabName} tab"
	macro clickTab {
		var key_tabName = StringUtil.lowerCase("${tabName}");

		Click(locator1 = "ProvisioningAccount#TAB");
	}

	@prose = "I click on the view archived notes link"
	macro clickViewArchivedNotesLink {
		Click(locator1 = "ProvisioningAccount#VIEW_ARCHIVED_NOTES_LINK");
	}

	@prose = "I collapse the side panel on the account details page"
	macro collapseSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON");
		}
	}

	@prose = "I expand the side panel on the account details page"
	macro expandSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON");
		}
	}

	@prose = "I search the ${tabName} subscriptions tab using the keyword ${keyword}"
	macro searchSubscriptions {
		if ("${tabName}" == "Active") {
			var key_pageValue = "1";
		}
		else if ("${tabName}" == "Inactive") {
			var key_pageValue = "2";
		}		
		else if ("${tabName}" == "All") {
			var key_pageValue = "3";
		}
		else {
			fail("No such tab ${tabName}. Please choose Active, Inactive, or All as the tab name.");
		}

		Type(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I should be able to view the following account values in the account details page ${table}"
	macro _viewAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_COUNTRY",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "EWSA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_EWSA",
					value1 = "${value}");
			}
			else if ("${field}" == "Developers") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DEVELOPERS",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_PARTNER",
					value1 = "${value}");
			}
			else {
				fail("No such account detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the ${noteType} type note with the content ${noteContent} and the following values ${table}"
	macro _viewAccountNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_noteContent = "${noteContent}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#NOTE_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such account note field ${field}");
			}
		}
	}

	@prose = "I should be able to view the account notes empty state"
	macro _viewAccountNotesEmptyState {
		AssertTextEquals(
			locator1 = "ProvisioningAccount#NOTE_EMPTY_TEXT",
			value1 = "No notes were found.");
	}

	@prose = "I should be able to view the product under the ${tabName} tab with the name ${productName} and the following values on the account details page ${table}"
	macro _viewAccountProduct {
		if ("${tabName}" == "Active") {
			var key_pageValue = "1";
		}
		else if ("${tabName}" == "Inactive") {
			var key_pageValue = "2";
		}		
		else if ("${tabName}" == "All") {
			var key_pageValue = "3";
		}
		else {
			fail("No such tab ${tabName}. Please choose Active, Inactive, or All as the tab name.");
		}

		var key_productName = "${productName}";

		AssertElementPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Next Term Starts") {
				if ("${value}" == "false") {
					AssertElementNotPresent(locator1 = "ProvisioningAccount#PRODUCT_NEXT_TERM_DATE");
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#PRODUCT_NEXT_TERM_DATE",
						value1 = "Next Term Starts: ${value}");
				}
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such account product field ${field}");
			}
		}
	}

	@prose = "I should be able to view the archived note with the content ${noteContent} and the following values ${table}"
	macro _viewAccountNoteViaArchive {
		var key_noteContent = "${noteContent}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such archived account note field ${field}");
			}
		}
	}

	@prose = "I should not be able to view the ${noteType} type note with the content ${noteContent}"
	macro _viewNoAccountNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_noteContent = "${noteContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#NOTE_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#NOTE_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#NOTE_ROW");
		}
	}

	@prose = "I should not be able to view the archived note with the content ${noteContent}"
	macro _viewNoAccountNoteViaArchive {
		var key_noteContent = "${noteContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW");
		}
	}

	@prose = "I should not be able to view the product under the ${tabName} tab with the name ${productName} on the account details page"
	macro _viewNoAccountProduct {
		if ("${tabName}" == "Active") {
			var key_pageValue = "1";
		}
		else if ("${tabName}" == "Inactive") {
			var key_pageValue = "2";
		}		
		else if ("${tabName}" == "All") {
			var key_pageValue = "3";
		}
		else {
			fail("No such tab ${tabName}. Please choose Active, Inactive, or All as the tab name.");
		}

		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");
	}
}