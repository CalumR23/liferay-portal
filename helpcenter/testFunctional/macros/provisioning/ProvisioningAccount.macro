definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I cancel a note with the content ${content} on the account details page"
	macro cancelNote {
		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CANCEL_BUTTON");
	}

	@prose = "I cancel an edit for a ${noteType} note with the content ${noteContent} on the account details page to have the new content ${contentEdit}"
	macro cancelNoteEdit {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		Click(locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD");

		var key_noteContent = "";

		Type(
			locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#NOTE_CANCEL_BUTTON");
	}

	@prose = "I cancel a sales info note with the content ${content} on the account details page"
	macro cancelSalesInfoNote {
		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CANCEL_BUTTON");
	}

	@prose = "I cancel an edit for a sales info note with the content ${salesInfoContent} on the account details page to have the new content ${contentEdit}"
	macro cancelSalesInfoNoteEdit {
		var key_salesInfoContent = "${salesInfoContent}";

		Click(locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD");

		var key_salesInfoContent = "";

		Type(
			locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#SALES_INFO_CANCEL_BUTTON");
	}

	@prose = "I clear the subscription search"
	macro clearSubscriptionSearch {
		Type(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "");

		KeyPress(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the archived note with the content ${noteContent}"
	macro clickArchivedNoteActionDropdownButton {
		var key_noteContent = "${noteContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_DROPDOWN_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the archived sales info note with the content ${salesInfoContent}"
	macro clickArchivedSalesInfoActionDropdownButton {
		var key_salesInfoContent = "${salesInfoContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_DROPDOWN_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the back button in the archived notes section"
	macro clickBackButtonViaArchivedNotes {
		Click(locator1 = "ProvisioningAccount#ARCHIVED_NOTES_BACK_BUTTON");
	}

	@prose = "I click on the back button in the archived sales info section"
	macro clickBackButtonViaArchivedSalesInfo {
		Click(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_BACK_BUTTON");
	}

	@prose = "I click on the ${action} button for the ${noteType} note with the content ${noteContent}"
	macro clickNoteActionButton {
		var key_action = "${action}";
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		MouseOver(locator1 = "ProvisioningAccount#NOTE_ROW");

		Click.clickNoMouseOver(locator1 = "ProvisioningAccount#NOTE_ACTION_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the ${noteType} note with the content ${noteContent}"
	macro clickNoteActionDropdownButton {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#NOTE_DROPDOWN_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the ${tabName} product tab"
	macro clickProductTab {
		var key_tabName = "${tabName}";

		Click(locator1 = "ProvisioningAccount#PRODUCT_TAB");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the sales info note with the content ${salesInfoContent}"
	macro clickSalesInfoActionDropdownButton {
		var key_salesInfoContent = "${salesInfoContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#SALES_INFO_DROPDOWN_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the ${action} button for the sales info note with the content ${salesInfoContent}"
	macro clickSalesInfoActionButton {
		var key_action = "${action}";
		var key_salesInfoContent = "${salesInfoContent}";

		MouseOver(locator1 = "ProvisioningAccount#SALES_INFO_ROW");

		Click.clickNoMouseOver(locator1 = "ProvisioningAccount#SALES_INFO_ACTION_BUTTON");
	}

	@prose = "I click on the ${tabName} side panel tab"
	macro clickSidePanelTab {
		var key_tabName = "${tabName}";

		Click(locator1 = "ProvisioningAccount#SIDE_PANEL_TAB");
	}

	@prose = "I click on the ${tabName} tab"
	macro clickTab {
		var key_tabName = StringUtil.lowerCase("${tabName}");

		Click(locator1 = "ProvisioningAccount#TAB");
	}

	@prose = "I click on the ${teamName} team link"
	macro clickTeamLink {
		var key_teamName = "${teamName}";

		Click(locator1 = "ProvisioningAccount#TEAM_NAME");
	}

	@prose = "I click on the view archived notes link"
	macro clickViewArchivedNotesLink {
		Click(locator1 = "ProvisioningAccount#VIEW_ARCHIVED_NOTES_LINK");
	}

	@prose = "I click on the view archived sales info link"
	macro clickViewArchivedSalesInfoLink {
		Click(locator1 = "ProvisioningAccount#VIEW_ARCHIVED_SALES_INFO_LINK");
	}

	@prose = "I collapse the side panel on the account details page"
	macro collapseSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON");
		}
	}

	@prose = "I create a note with the content ${content} on the account details page"
	macro createNote {
		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_NOTE_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_NOTE_SUCCESS_MESSAGE");
	}

	@prose = "I create a sales info note with the content ${content} on the account details page"
	macro createSalesInfo {
		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NEW_SALES_INFO_SUCCESS_MESSAGE");
	}

	@prose = "I edit a ${noteType} note with the content ${noteContent} on the account details page to have the new content ${contentEdit}"
	macro editNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		Click(locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD");

		var key_noteContent = "";

		Type(
			locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#NOTE_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#NOTE_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NOTE_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#NOTE_SUCCESS_MESSAGE");
	}

	@prose = "I edit a sales info note with the content ${salesInfoContent} on the account details page to have the new content ${contentEdit}"
	macro editSalesInfo {
		var key_salesInfoContent = "${salesInfoContent}";

		Click(locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD");

		var key_salesInfoContent = "";

		Type(
			locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#SALES_INFO_SAVE_BUTTON");

		AssertElementNotPresent(locator1 = "ProvisioningAccount#SALES_INFO_SAVE_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#SALES_INFO_CANCEL_BUTTON");
		AssertElementNotPresent(locator1 = "ProvisioningAccount#SALES_INFO_SUCCESS_MESSAGE");
	}

	@prose = "I expand the side panel on the account details page"
	macro expandSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON");
		}
	}

	@prose = "I search the accounts details page using the keyword ${keyword}"
	macro search {
		Type(
			locator1 = "ProvisioningAccount#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ProvisioningAccount#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I search subscriptions using the keyword ${keyword}"
	macro searchSubscriptions {
		Type(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I should be able to view the following account values in the account details page ${table}"
	macro _viewAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_COUNTRY",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "EWSA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_EWSA",
					value1 = "${value}");
			}
			else if ("${field}" == "Developers") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DEVELOPERS",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_PARTNER",
					value1 = "${value}");
			}
			else {
				fail("No such account detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the account external link ${externalLink}"
	macro _viewAccountExternalLink {
		var key_externalLink = "${externalLink}";

		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_LINK",
			value1 = "${externalLink}");
	}

	@prose = "I should be able to view the account external link ${externalLink} with the href ${href}"
	macro _viewAccountExternalLinkClickable {
		var key_externalLink = "${externalLink}";

		var key_href = "${href}";

		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_CLICKABLE_LINK",
			value1 = "${externalLink}");
	}

	@prose = "I should be able to view the account external links empty state"
	macro _viewAccountExternalLinksEmptyState {
		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_EMPTY_TEXT",
			value1 = "No external links were found.");
	}

	@prose = "I should be able to view the ${noteType} type note with the content ${noteContent} and the following values ${table}"
	macro _viewAccountNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_noteContent = "${noteContent}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#NOTE_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#NOTE_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such account note field ${field}");
			}
		}
	}

	@prose = "I should be able to view the ${noteType} type note with the content ${noteContent} in the position number ${notePosition}"
	macro _viewAccountNoteByPosition {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_notePosition = "${notePosition}";

		AssertTextEquals(
			locator1 = "ProvisioningAccount#NOTE_CONTENT_POSITION",
			value1 = "${noteContent}");
	}

	@prose = "I should be able to view the account notes empty state"
	macro _viewAccountNotesEmptyState {
		AssertTextEquals(
			locator1 = "ProvisioningAccount#NOTE_EMPTY_TEXT",
			value1 = "No notes were found.");
	}

	@prose = "I should be able to view the product with the name ${productName} and the following values on the account details page ${table}"
	macro _viewAccountProduct {
		var key_productName = "${productName}";

		AssertElementPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Next Term Starts") {
				if ("${value}" == "false") {
					AssertElementNotPresent(locator1 = "ProvisioningAccount#PRODUCT_NEXT_TERM_DATE");
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#PRODUCT_NEXT_TERM_DATE",
						value1 = "Next Term Starts: ${value}");
				}
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such account product field ${field}");
			}
		}
	}

	@prose = "I should be able to view the archived note with the content ${noteContent} and the following values ${table}"
	macro _viewAccountNoteViaArchive {
		var key_noteContent = "${noteContent}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_NOTE_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such archived account note field ${field}");
			}
		}
	}

	@prose = "I should be able to view the sales info note with the content ${salesInfoContent} and the following values ${table}"
	macro _viewAccountSalesInfo {
		var key_salesInfoContent = "${salesInfoContent}";

