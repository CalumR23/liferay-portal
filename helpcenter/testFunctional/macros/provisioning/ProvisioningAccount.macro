				AssertVisible(locator1 = "ProvisioningAccount#SALES_INFO_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#SALES_INFO_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#SALES_INFO_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such account sales info field ${field}");
			}
		}
	}

	@prose = "I should be able to view the account sales info empty state"
	macro _viewAccountSalesInfoEmptyState {
		AssertTextEquals(
			locator1 = "ProvisioningAccount#SALES_INFO_EMPTY_TEXT",
			value1 = "No sales info were found.");
	}

	@prose = "I should be able to view the archived sales info note with the content ${salesInfoContent} and the following values ${table}"
	macro _viewAccountSalesInfoViaArchive {
		var key_salesInfoContent = "${salesInfoContent}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_AUTHOR_PORTRAIT");
			}
