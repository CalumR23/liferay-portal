definition {

	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I should be able to view the contact with the email address ${emailAddress} and the following values ${table}"
	macro _viewAccountContact {
		var key_contactEmailAddress = "${emailAddress}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_EMAIL_ADDRESS",
					value1 = "${value}");
			}
			else if ("${field}" == "Role") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#CONTACT_ROLE",
					value1 = "${value}");
			}
			else if ("${field}" == "User Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#CONTACT_USER_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such contact field ${field}");
			}
		}
	}

	@prose = "I should be able to view the following account values in the account details page ${table}"
	macro _viewAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_STATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Region") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_COUNTRY",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "EWSA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_EWSA",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Seats") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_SEATS",
					value1 = "${value}");
			}
			else if ("${field}" == "FLS Partner") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_FLS_PARTNER",
					value1 = "${value}");
			}
			else if ("${field}" == "Primary Contact") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_PRIMARY_CONTACT",
					value1 = "${value}");
			}
			else {
				fail("No such account detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the following account values under the account details tab ${table}"
	macro _viewAccountDetailsViaDetailsTab {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";
			var positionValue = "${row[2]}";
			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";
			}

			AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_LABEL");

			if (("${field}" == "Permanent Licenses") || ("${field}" == "Self Provisioning") || ("${field}" == "Primary")) {
				if ("${value}" == "true") {
					AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_ON");
				}
				else {
					AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_OFF");
				}
			}
			else if ((IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE")) && ("${field}" != "State")) {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE",
					value1 = "${value}");
			}
			else if ("${field}" == "OEM Instructions") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_LINK",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_LABEL",
					value1 = "${value}");
			}
			else {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE",
					value1 = "${value}");
			}
		}
	}

	@prose = "I should be able to view the account external link ${externalLink}"
	macro _viewAccountExternalLink {
		var key_externalLink = "${externalLink}";

		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_LINK",
			value1 = "${externalLink}");
	}

	@prose = "I should be able to view the account external link ${externalLink} with the href ${href}"
	macro _viewAccountExternalLinkClickable {
		var key_externalLink = "${externalLink}";
		var key_href = "${href}";

		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_CLICKABLE_LINK",
			value1 = "${externalLink}");
	}

	@prose = "I should be able to view the account external links empty state"
	macro _viewAccountExternalLinksEmptyState {
		AssertTextEquals(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_EMPTY_TEXT",
			value1 = "No external links were found.");
	}

	@prose = "I should be able to view the license with the keyword ${licenseKeyword} and the following values on the account details page ${table}"
	macro _viewAccountLicense {
		var key_licenseKeyword = "${licenseKeyword}";

		AssertElementPresent(locator1 = "ProvisioningAccount#LICENSE_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Description") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Expiration Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_EXPIRATION_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Details") {
				var key_label = StringUtil.extractFirst("${value}", ":");

				var key_label = StringUtil.trim("${key_label}");
				var value = StringUtil.extractLast("${value}", ":");

				var value = StringUtil.trim("${value}");

				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#LICENSE_DETAILS",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#LICENSE_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Complimentary") {
				if ("${value}" == "true") {
					AssertElementPresent(
						locator1 = "ProvisioningAccount#LICENSE_COMPLIMENTARY_CHECKED",
						value1 = "${value}");
				}
				else {
					AssertElementPresent(
						locator1 = "ProvisioningAccount#LICENSE_COMPLIMENTARY_NOT_CHECKED",
						value1 = "${value}");
				}
			}
			else {
				fail("No such account license field ${field}");
			}
		}
	}

	@prose = "I should be able to view the ${noteType} type note with the content ${noteContent} and the following values ${table}"
	macro _viewAccountNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Author") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_AUTHOR",
					value1 = "${value}");

				AssertVisible(locator1 = "ProvisioningAccount#NOTE_AUTHOR_PORTRAIT");
			}
			else if ("${field}" == "Create Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#NOTE_CREATE_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#NOTE_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such account note field ${field}");
			}
		}
	}

