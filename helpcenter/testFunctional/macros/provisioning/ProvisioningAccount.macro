	@prose = "I click on the ${action} button for the sales info note with the content ${salesInfoContent}"
	macro clickSalesInfoActionButton {
		var key_action = "${action}";
		var key_salesInfoContent = "${salesInfoContent}";

		MouseOver(locator1 = "ProvisioningAccount#SALES_INFO_ROW");

