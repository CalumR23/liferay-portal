	}

	@prose = "I click on the back button in the archived sales info section"
	macro clickBackButtonViaArchivedSalesInfo {
		Click(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_BACK_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the contact with the email address ${emailAddress}"
	macro clickContactActionDropdownButton {
		var key_contactEmailAddress = "${emailAddress}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#CONTACT_ACTION_BUTTON");

		var key_action = "${action}";

		if ("${action}" == "Unassign") {
			ClickNoError(locator1 = "ProvisioningAccount#CONTACT_DROPDOWN_ACTION_BUTTON");

			Confirm(value1 = "Are you sure you want to unassign this contact?");
		}
		else {
			Click(locator1 = "ProvisioningAccount#CONTACT_DROPDOWN_ACTION_BUTTON");
		}
	}

	@prose = "I click on the cancel button in the contact form"
	macro clickContactFormCancelButton {
		Click(locator1 = "ProvisioningAccountAssignContact#CANCEL_BUTTON");
	}

	@prose = "I click on the new team button"
	macro clickNewTeamButton {
		Click(locator1 = "ProvisioningAccount#NEW_TEAM_BUTTON");

		AssertVisible(locator1 = "ProvisioningTeamForm#NAME_FIELD");
	}

	@prose = "I click on the ${action} button for the ${noteType} note with the content ${noteContent}"
	macro clickNoteActionButton {
		var key_action = "${action}";
