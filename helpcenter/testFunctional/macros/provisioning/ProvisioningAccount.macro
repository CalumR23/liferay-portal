	@prose = "I search and filter the accounts details page using the following parameters ${table}"
	macro searchAndFilter {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Keyword") {
				ProvisioningAccount.search(keyword = "${value}");
			}
			else if ("${field}" == "Filter") {
				ProvisioningAccount.filter(filter = "${value}");
			}
			else {
				fail("No such search field ${field}. Please set the field value to Keyword or Filter.");
			}
		}
	}

	@prose = "I search related accounts using the keyword ${keyword}"
	macro searchRelatedAccounts {
		Type(
			locator1 = "ProvisioningAccount#RELATED_ACCOUNT_SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "ProvisioningAccount#RELATED_ACCOUNT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

