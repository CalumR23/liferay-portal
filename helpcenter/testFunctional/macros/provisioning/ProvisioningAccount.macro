		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";

			var key_field = "${field}";

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningAccountAddAddress#INPUT_FIELD",
					value1 = "${value}");				
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningAccountAddAddress#SELECT_FIELD",
					value1 = "${value}");	
			}
			else if ("${type}" == "Checkbox") {
				if ("${value}" == "true") {
					Check(locator1 = "ProvisioningAccountAddAddress#CHECKBOX");
				}
				else {
					Uncheck(locator1 = "ProvisioningAccountAddAddress#CHECKBOX");
				}
			}
			else {
				fail("No such add address field type ${type}. Please use Input, Select, or Checkbox.");
			}
		}

		Click(locator1 = "ProvisioningAccountAddAddress#SAVE_BUTTON");
	}

	@prose = "I populate and save the assign contact form with the following values ${table}"
	macro populateAssignContactFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email Address") {
				Type(
					locator1 = "ProvisioningAccountAssignContact#EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Assign Role") {
				var key_role = "${value}";

				if (IsElementNotPresent(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_DROPDOWN_VISIBLE")) {
					Click(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_LINK");
				}

				Click(locator1 = "ProvisioningAccountAssignContact#ROLE_LINK");

				if (IsElementPresent(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_DROPDOWN_VISIBLE")) {
					Click(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_LINK");
				}
			}
			else if ("${field}" == "Unassign Role") {
				var key_role = "${value}";

				Click(locator1 = "ProvisioningAccountAssignContact#REMOVE_ROLE_LINK");

				if (IsElementPresent(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_DROPDOWN_VISIBLE")) {
					Click(locator1 = "ProvisioningAccountAssignContact#ROLE_SELECT_LINK");
				}
			}
			else {
				fail("No such contact field ${field}. Please set the field value to Email Address, Assign Role, or Unassign Role.");
			}
		}

		Click(locator1 = "ProvisioningAccountAssignContact#SAVE_BUTTON");
	}

