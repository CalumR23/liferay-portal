			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_CONTENT",
					value1 = "${value}");
			}
			else {
				fail("No such archived account sales info field ${field}");
			}
		}
	}

	@prose = "I should be able to view the team with the name ${teamName} and the following values ${table}"
	macro _viewAccountTeam {
		var key_teamName = "${teamName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#TEAM_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Member") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#TEAM_MEMBERS",
					value1 = "${value}");
			}
			else if ("${field}" == "Last Modified") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#TEAM_LAST_MODIFIED",
					value1 = "${value}");
			}
			else {
				fail("No such team field ${field}");
			}
		}
	}

	@prose = "I should not be able to view the account external link ${externalLink}"
	macro _viewNoAccountExternalLink {
		var key_externalLink = "${externalLink}";

		AssertElementNotPresent(locator1 = "ProvisioningAccount#EXTERNAL_LINKS_LINK");
	}

	@prose = "I should not be able to view the ${noteType} type note with the content ${noteContent}"
	macro _viewNoAccountNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_noteContent = "${noteContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#NOTE_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#NOTE_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#NOTE_ROW");
		}
	}

	@prose = "I should not be able to view an edit mark for the ${noteType} type note with the content ${noteContent}"
	macro _viewNoAccountNoteEditMark {
		var key_noteType = StringUtil.lowerCase("${noteType}");

		var key_noteContent = "${noteContent}";

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#NOTE_CREATE_DATE",
			value1 = "Edited");
	}

	@prose = "I should not be able to view an edit mark for the archived note with the content ${noteContent}"
	macro _viewNoAccountNoteEditMarkViaArchive {
		var key_noteContent = "${noteContent}";

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#ARCHIVED_NOTE_CREATE_DATE",
			value1 = "Edited");
	}

	@prose = "I should not be able to view the archived note with the content ${noteContent}"
	macro _viewNoAccountNoteViaArchive {
		var key_noteContent = "${noteContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_ROW");
		}
	}

	@prose = "I should not be able to view the product with the name ${productName} on the account details page"
	macro _viewNoAccountProduct {
		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");
	}

	@prose = "I should not be able to view the sales info note with the content ${salesInfoContent}"
	macro _viewNoAccountSalesInfo {
		var key_salesInfoContent = "${salesInfoContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#SALES_INFO_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#SALES_INFO_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#SALES_INFO_ROW");
		}
	}

	@prose = "I should not be able to view an edit mark for the sales info note with the content ${salesInfoContent}"
	macro _viewNoAccountSalesInfoEditMark {
		var key_salesInfoContent = "${salesInfoContent}";

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#SALES_INFO_CREATE_DATE",
			value1 = "Edited");
	}

	@prose = "I should not be able to view an edit mark for the archived sales info note with the content ${salesInfoContent}"
	macro _viewNoAccountSalesInfoEditMarkViaArchive {
		var key_salesInfoContent = "${salesInfoContent}";

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_CREATE_DATE",
			value1 = "Edited");
	}

	@prose = "I should not be able to view the archived sales info note with the content ${salesInfoContent}"
	macro _viewNoAccountSalesInfoViaArchive {
		var key_salesInfoContent = "${salesInfoContent}";

		if (IsElementPresent(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_ROW")) {
			AssertNotVisible(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_ROW");
		}
		else {
			AssertElementNotPresent(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_ROW");
		}
	}

	@prose = "I should not be able to view the team with the name ${teamName}"
	macro _viewNoAccountTeam {
		var key_teamName = "${teamName}";

		AssertElementNotPresent(locator1 = "ProvisioningAccount#TEAM_ROW");		
	}

