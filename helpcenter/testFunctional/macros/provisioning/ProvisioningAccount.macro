definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I collapse the side panel on the account details page"
	macro collapseSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_COLLAPSE_BUTTON");
		}
	}

	@prose = "I expand the side panel on the account details page"
	macro expandSidePanel {
		if (IsElementPresent(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON")) {
			Click(locator1 = "ProvisioningAccount#SIDE_PANEL_EXPAND_BUTTON");
		}
	}

	@prose = "I should be able to view the following account values in the account details page ${table}"
	macro _viewAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#ACCOUNT_HEADER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Region") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_SUPPORT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_COUNTRY",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "EWSA") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_EWSA",
					value1 = "${value}");
			}
			else if ("${field}" == "Developers") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_DEVELOPERS",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#ACCOUNT_PARTNER",
					value1 = "${value}");
			}
			else {
				fail("No such account detail field ${field}");
			}
		}
	}

	@prose = "I should be able to view the account external links with the text ${externalLinksText}"
	macro viewAccountExternalLinks {
		Click(locator1 = "ProvisioningAccount#EXTERNAL_LINKS_TAB");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_TEXT",
			value1 = "${value}");
	}

	@prose = "I should be able to view the account notes with the text ${notesText}"
	macro viewAccountNotes {
		Click(locator1 = "ProvisioningAccount#NOTES_TAB");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccount#NOTES_TEXT",
			value1 = "${value}");
	}

	@prose = "I should be able to view the product with the name ${productName} and the following values on the account details page ${table}"
	macro _viewAccountProduct {
		var key_productName = "${productName}";

		AssertElementPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Life") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_SUPPORT_LIFE",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "Purchased") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_PURCHASED",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#PRODUCT_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such account product field ${field}");
			}
		}
	}

	@prose = "I should be able to view the account sales info with the text ${salesInfoText}"
	macro viewAccountSalesInfo {
		Click(locator1 = "ProvisioningAccount#SALES_INFO_TAB");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccount#SALES_INFO_TEXT",
			value1 = "${value}");
	}

	@prose = "I should not be able to view the product with the name ${productName} on the account details page ${table}"
	macro _viewNoAccountProduct {
		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "ProvisioningAccount#PRODUCT_ROW");
	}

	@prose = "I should not be able to view the account external links with the text ${externalLinksText}"
	macro viewNoAccountExternalLinks {
		Click(locator1 = "ProvisioningAccount#EXTERNAL_LINKS_TAB");

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#EXTERNAL_LINKS_TEXT",
			value1 = "${value}");
	}

	@prose = "I should not be able to view the account notes with the text ${notesText}"
	macro viewNoAccountNotes {
		Click(locator1 = "ProvisioningAccount#NOTES_TAB");

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#NOTES_TEXT",
			value1 = "${value}");
	}

	@prose = "I should not be able to view the account sales info with the text ${salesInfoText}"
	macro viewNoAccountSalesInfo {
		Click(locator1 = "ProvisioningAccount#SALES_INFO_TAB");

		AssertTextNotEquals.assertNotPartialText(
			locator1 = "ProvisioningAccount#SALES_INFO_TEXT",
			value1 = "${value}");
	}
}