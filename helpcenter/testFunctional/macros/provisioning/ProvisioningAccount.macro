	@prose = "I should be able to view the related account with the name ${accountName} and the following values on the account details page ${table}"
	macro _viewAccountRelatedAccount {
		var key_accountName = "${accountName}";

		AssertElementPresent(locator1 = "ProvisioningAccount#RELATED_ACCOUNT_ROW");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_CODE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support End Date") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_SUPPORT_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_PARTNER",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#RELATED_ACCOUNT_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such account related account field ${field}");
			}
		}
	}

