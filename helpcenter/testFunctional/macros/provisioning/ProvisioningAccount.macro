	@prose = "I populate and save the account form with the following values ${table}"
	macro populateAccountFormAndSave {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";

			var key_field = "${field}";

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningAccountForm#INPUT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningAccountForm#SELECT_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such account field type ${type}. Please use Input or Select.");
			}
		}

		Click(locator1 = "ProvisioningAccountForm#SAVE_BUTTON");
	}

	@prose = "I populate and save the add address form with the following values ${table}"
	macro populateAddAddressFormAndSave {
