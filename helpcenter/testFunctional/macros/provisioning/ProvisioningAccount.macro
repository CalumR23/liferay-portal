	@prose = "I should be able to view the worker with the email address ${emailAddress} and the following values ${table}"
	macro _viewAccountWorker {
		var key_workerEmailAddress = "${emailAddress}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#WORKER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#WORKER_EMAIL_ADDRESS",
					value1 = "${value}");
			}
			else if ("${field}" == "Role") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProvisioningAccount#WORKER_ROLE",
					value1 = "${value}");
			}
			else if ("${field}" == "User Status") {
				AssertTextEquals(
					locator1 = "ProvisioningAccount#WORKER_USER_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such worker field ${field}");
			}
		}
	}

