						locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE_BY_THREE_KEYWORDS",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field New Value") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NEW_VALUE_BY_THREE_KEYWORDS",
						value1 = "${value}");
				}
				else {
					fail("No such history entry field ${field}");
				}				
			}
		}
	}

