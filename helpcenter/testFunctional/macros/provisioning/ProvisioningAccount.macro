	@prose = "the history entry in position number ${positionValue} with the field value ${fieldName} should be visible on the account details page with the following values ${table}"
	macro viewAccountHistoryEntry {
		var key_positionValue = "${positionValue}";
		var key_fieldName = "${fieldName}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${fieldName}" == "status") {
				if ("${field}" == "Update Description") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field Name") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NAME",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field Original Value") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_ORIGINAL_VALUE",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field New Value") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_STATUS_FIELD_NEW_VALUE",
						value1 = "${value}");
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
			else {
				if ("${field}" == "Update Description") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_DESCRIPTION",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field Name") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NAME",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field Original Value") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE",
						value1 = "${value}");
				}
				else if ("${field}" == "Update Field New Value") {
					AssertTextEquals.assertPartialText(
						locator1 = "ProvisioningAccount#HISTORY_UPDATE_FIELD_NEW_VALUE",
						value1 = "${value}");
				}
				else {
					fail("No such history entry field ${field}");
				}
			}
		}
	}

