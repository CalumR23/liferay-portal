definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I activate the account with the name ${accountName} and code ${accountCode}"
	macro activateAccount {
		var key_accountCode = "${accountCode}";
		var key_accountName = "${accountName}";

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountActivateAccount#ACCOUNT_ACTIVATE_MESSAGE",
			value1 = "Are you sure you want to activate the account listed below?");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountActivateAccount#ACCOUNT_NAME",
			value1 = "${accountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "ProvisioningAccountActivateAccount#ACCOUNT_CODE",
			value1 = "${accountCode}");

		Click(locator1 = "ProvisioningAccountActivateAccount#ACTIVATE_ACCOUNT_BUTTON");
	}

	@prose = "I cancel a note with the content ${content} on the account details page"
	macro cancelNote {
		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_NOTE_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_NOTE_CANCEL_BUTTON");
	}

	@prose = "I cancel an edit for a ${noteType} note with the content ${noteContent} on the account details page to have the new content ${contentEdit}"
	macro cancelNoteEdit {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		Click(locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD");

		var key_noteContent = "";

		Type(
			locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#NOTE_CANCEL_BUTTON");
	}

	@prose = "I cancel a sales info note with the content ${content} on the account details page"
	macro cancelSalesInfoNote {
		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD");

		Type(
			locator1 = "ProvisioningAccount#NEW_SALES_INFO_CONTENT_FIELD",
			value1 = "${content}");

		Click(locator1 = "ProvisioningAccount#NEW_SALES_INFO_CANCEL_BUTTON");
	}

	@prose = "I cancel an edit for a sales info note with the content ${salesInfoContent} on the account details page to have the new content ${contentEdit}"
	macro cancelSalesInfoNoteEdit {
		var key_salesInfoContent = "${salesInfoContent}";

		Click(locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD");

		var key_salesInfoContent = "";

		Type(
			locator1 = "ProvisioningAccount#SALES_INFO_CONTENT_FIELD",
			value1 = "${contentEdit}");

		Click(locator1 = "ProvisioningAccount#SALES_INFO_CANCEL_BUTTON");
	}

	@prose = "I clear the account details search"
	macro clearSearch {
		Click(locator1 = "ProvisioningAccount#CLEAR_SEARCH_LINK");
	}

	@prose = "I clear the subscription search"
	macro clearSubscriptionSearch {
		Type(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "");

		KeyPress(
			locator1 = "ProvisioningAccount#PRODUCT_SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I click the add account address button in position ${positionValue}"
	macro clickAddAddress {
		var key_positionValue = "${positionValue}";

		Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_ADD_ADDRESS_BUTTON");
	}

	@prose = "I click on the add subscription button"
	macro clickAddSubscriptionButton {
		Click(locator1 = "ProvisioningAccount#ADD_SUBSCRIPTION_BUTTON");
	}

	@prose = "I click on the ${action} button in the plus dropdown menu for the account"
	macro clickAccountActionViaPlusMenu {
		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_PLUS_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#ACCOUNT_DROPDOWN_ITEM");
	}

	@prose = "I click on the ${action} button in the three dot dropdown menu for the account"
	macro clickAccountActionViaThreeDotMenu {
		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ACCOUNT_THREE_DOT_MENU_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#ACCOUNT_DROPDOWN_ITEM");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the archived note with the content ${noteContent}"
	macro clickArchivedNoteActionDropdownButton {
		var key_noteContent = "${noteContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ARCHIVED_NOTE_DROPDOWN_BUTTON");

		var key_action = "${action}";

		Click(locator1 = "ProvisioningAccount#NOTE_DROPDOWN_ACTION_BUTTON");
	}

	@prose = "I click on the ${action} button in the dropdown menu for the archived sales info note with the content ${salesInfoContent}"
	macro clickArchivedSalesInfoActionDropdownButton {
		var key_salesInfoContent = "${salesInfoContent}";

		Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccount#ARCHIVED_SALES_INFO_DROPDOWN_BUTTON");

