		Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_CANCEL_ADDRESS_CHANGES_BUTTON");
	}

	@prose = "I edit and cancel the following account fields and types to the following values under the account details tab ${table}"
	macro editAndCancelAccountDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var type = "${row[1]}";
			var value = "${row[2]}";
			var positionValue = "${row[3]}";

			var key_field = "${field}";

			if ("${positionValue}" == "") {
				var key_positionValue = "1";
			}
			else {
				var key_positionValue = "${positionValue}";				
			}

			AssertElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_LABEL");

			Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_EDITABLE");

			if ("${type}" == "Input") {
				Type(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_INPUT",
					value1 = "${value}");					
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_SELECT",
					value1 = "${value}");	
			}
			else if ("${type}" == "Textarea") {
				Type(
					locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TEXTAREA",
					value1 = "${value}");	
			}
			else if ("${type}" == "Toggle Switch") {
				if ("${value}" == "true") {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_OFF")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
				else {
					if (IsElementPresent(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH_ON")) {
						Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_TOGGLE_SWITCH");
					}
				}
			}
			else {
				fail("No such account detail field type ${type}. Please use Input, Select, Textarea, or Toggle Switch.");
			}

			Click(locator1 = "ProvisioningAccount#ACCOUNT_DETAILS_FIELD_VALUE_CANCEL_BUTTON");
		}
	}

	@prose = "I edit a ${noteType} note with the content ${noteContent} on the account details page to have the new content ${contentEdit}"
	macro editNote {
		var key_noteType = StringUtil.lowerCase("${noteType}");
		var key_noteContent = "${noteContent}";

		Click(locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD");

		var key_noteContent = "";

		Type(
			locator1 = "ProvisioningAccount#NOTE_CONTENT_FIELD",
			value1 = "${contentEdit}");

