	@prose = "I click on the assign contact button"
	macro clickAssignContactButton {
		Click(locator1 = "ProvisioningAccount#ASSIGN_CONTACT_BUTTON");

		AssertVisible(locator1 = "ProvisioningAccountAssignContact#EMAIL_ADDRESS_FIELD");
	}

	@prose = "I click on the assign worker button"
	macro clickAssignLiferayWorkerButton {
		Click(locator1 = "ProvisioningAccount#ASSIGN_LIFERAY_WORKER_BUTTON");

		AssertVisible(locator1 = "ProvisioningAccountAssignWorker#EMAIL_ADDRESS_FIELD");
	}

	@prose = "I click on the back button in the archived notes section"
	macro clickBackButtonViaArchivedNotes {
