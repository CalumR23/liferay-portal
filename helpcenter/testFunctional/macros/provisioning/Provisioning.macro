definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I should not see an alert"
	macro assertNoAlert {
		AssertAlertNotPresent();		
	}

	@prose = "I click on the account with the name ${accountName} on the provisioning index"
	macro clickAccount {
		var key_accountName = "${accountName}";

		Click(locator1 = "Provisioning#ACCOUNT_NAME");		
	}

	@prose = "I click on the generate license button on the license index"
	macro clickGenerateLicenseButton {
		Click(locator1 = "Provisioning#GENERATE_LICENSE_BUTTON");
	}

	@prose = "I click on the license with the keyword ${licenseKeyword} on the provisioning index"
	macro clickLicense {
		var key_licenseKeyword = "${licenseKeyword}";

		Click(locator1 = "Provisioning#LICENSE_NAME");
	}

	@prose = "I click on the new account button"
	macro clickNewAccountButton {
		Click(locator1 = "Provisioning#NEW_ACCOUNT_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningAccountForm#INPUT_FIELD");
	}

	@prose = "I click on the new product bundle button"
	macro clickNewProductBundleButton {
		Click(locator1 = "Provisioning#NEW_PRODUCT_BUNDLE_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningProductBundleForm#INPUT_FIELD");
	}

	@prose = "I click on the new product button"
	macro clickNewProductButton {
		Click(locator1 = "Provisioning#NEW_PRODUCT_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningProductForm#INPUT_FIELD");
	}

	@prose = "I click on the product with the name ${productName} on the provisioning index"
	macro clickProduct {
		var key_productName = "${productName}";

		Click(locator1 = "Provisioning#PRODUCT_NAME");	
	}

	@prose = "I click on the product bundle with the name ${productBundleName} on the provisioning index"
	macro clickProductBundle {
		var key_productBundleName = "${productBundleName}";

		Click(locator1 = "Provisioning#PRODUCT_BUNDLE_NAME");	
	}

	@prose = "I click on the delete button for the product bundle ${productBundleName}"
	macro clickProductBundleDeleteButton {
		var key_productBundleName = "${productBundleName}";

		ClickNoError(locator1 = "Provisioning#PRODUCT_BUNDLE_DELETE");

		Confirm(value1 = "Are you sure you want to delete this product bundle?");
	}

	@prose = "I click on the delete button for the product ${productName}"
	macro clickProductDeleteButton {
		var key_productName = "${productName}";

		ClickNoError(locator1 = "Provisioning#PRODUCT_DELETE");

		Confirm(value1 = "Are you sure you want to delete this product?");
	}

	@prose = "I click on search accounts button"
	macro clickSearchAccountsButton {
		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_BUTTON");		
	}

	@prose = "I click on search licenses button"
	macro clickSearchLicensesButton {
		Click(locator1 = "Provisioning#SEARCH_LICENSES_BUTTON");		
	}

	@prose = "I click on search dropdown result ${result}"
	macro clickSearchDropdownResult {
		var key_result = "${result}";

		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT");		
	}

	@prose = "I click on the see all results link"
	macro clickSeeAllResults {
		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_SEE_ALL_RESULTS");		
	}

	@prose = "I click on the ${tabName} tab"
	macro clickTab {
		var key_tabName = StringUtil.lowerCase("${tabName}");

		var key_tabName = StringUtil.replace("${key_tabName}", " ", "-");

		var key_tabName = StringUtil.replace("${key_tabName}", "/", "-");

		Click(locator1 = "Provisioning#TAB");
	}

	@prose = "I click on the user with the name ${userName} on the provisioning index"
	macro clickUser {
		var key_userName = "${userName}";

		Click(locator1 = "Provisioning#USER_NAME");	
	}

	@prose = "I collapse the account advanced search form"
	macro collapseAccountAdvancedSearchForm {
		while (IsElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD")) {
			Refresh();
		}

		AssertVisible(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_EXPANDED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_BUTTON");	
		}
	}

	@prose = "I collapse the advanced search panel labeled ${panelLabel}"
	macro collapseAdvancedSearchPanel {
		var key_panelLabel = "${panelLabel}";

		if (IsElementPresent(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_EXPANDED")) {
			Click(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL");	
		}
	}

	@prose = "I collapse the license advanced search form"
	macro collapseLicenseAdvancedSearchForm {
		AssertVisible(locator1 = "Provisioning#SEARCH_LICENSES_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_EXPANDED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_BUTTON");	
		}
	}

	@prose = "I expand the account advanced search form"
	macro expandAccountAdvancedSearchForm {
		while (IsElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD")) {
			Refresh();
		}

		AssertVisible(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_COLLAPSED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_ACCOUNTS_ADVANCED_SEARCH_BUTTON");	
		}
	}

	@prose = "I expand the advanced search panel labeled ${panelLabel}"
	macro expandAdvancedSearchPanel {
		var key_panelLabel = "${panelLabel}";

		if (IsElementPresent(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_COLLAPSED")) {
			Click(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL");	
		}
	}

	@prose = "I expand the license advanced search form"
	macro expandLicenseAdvancedSearchForm {
		AssertVisible(locator1 = "Provisioning#SEARCH_LICENSES_FIELD");

		if (IsElementPresent(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_COLLAPSED")) {
			Click.pauseClickAt(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_BUTTON");	
		}
	}

	@prose = "I go to the account index page"
	macro gotoAccounts {
		Open(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_AccountsPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");

		OSBAdmin.pause(timeInSeconds = "1");
	}

	@prose = "I go to the license index page"
	macro gotoLicenses {
		Open.openNoSPARefresh(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_LicensesPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");

		OSBAdmin.pause(timeInSeconds = "1");
	}

	@prose = "I go to the product bundles index page"
	macro gotoProductBundles {
		Open.openNoSPARefresh(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_ProductBundlesPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");

		OSBAdmin.pause(timeInSeconds = "1");
	}

	@prose = "I go to the product index page"
	macro gotoProducts {
		Open.openNoSPARefresh(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_ProductsPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");

		OSBAdmin.pause(timeInSeconds = "1");
	}

	@prose = "I go to the user index page"
	macro gotoUsers {
		Open.openNoSPARefresh(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_UsersPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");

		OSBAdmin.pause(timeInSeconds = "1");
	}

	@prose = "I populate the advanced search form with the following values ${table}"
	macro populateAdvancedSearchForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var option = "${row[1]}";
			var type = "${row[2]}";
			var value = "${row[3]}";

			var key_field = "${field}";
			var key_option = "${option}";

			if ("${type}" == "Input") {
				if (("${field}" == "Created After") || ("${field}" == "Created Before") || ("${field}" == "Modified After") || ("${field}" == "Modified Before")) {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between After") || ("${field}" == "Modified Between After") || ("${field}" == "Started Between After") || ("${field}" == "Expires Between After")) {
					var key_fieldGroup = StringUtil.replace("${field}", " After", "");

					var key_field = "After";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between Before") || ("${field}" == "Modified Between Before") || ("${field}" == "Started Between Before") || ("${field}" == "Expires Between Before")) {
					var key_fieldGroup = StringUtil.replace("${field}", " Before", "");

					var key_field = "Before";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if ("${field}" == "Account") {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD_EXACT",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Checkbox") {
				if (("${field}" == "License Type") || ("${field}" == "Product Version") || ("${field}" == "Product")) {
					if (contains("${option}", "Portal")) {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
					}
					else {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
					}
				}
				else {
					if ("${value}" == "true") {
						if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
					else {
						if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
				}
			}
			else if ("${type}" == "Radio Button") {
				var key_value = "${value}";

				Click(locator1 = "Provisioning#ADVANCED_SEARCH_RADIO_BUTTON");
			}
			else if ("${type}" == "Select Entity") {
				Click(locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_ENTITY_BUTTON");

				SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

 				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_FIELD",
					value1 = "${keyword}");

				Click(locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningAccountSelect#DONE_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");
				}
			}
			else if ("${type}" == "Panel") {
				if ("${value}" == "Expand") {
					Provisioning.expandAdvancedSearchPanel(panelLabel = "${field}");
				}
				else if ("${value}" == "Collapse") {
					Provisioning.collapseAdvancedSearchPanel(panelLabel = "${field}");
				}
				else {
					echo("Please set a value of Expand or Collapse. No action will be taken on the panel.");					
				}
			}
			else {
				fail("No such advanced search field type ${type}. Please use Input, Select, Panel, Checkbox, or Radio Button");
			}
		}
	}

	@prose = "I populate the advanced search form with the following values and search ${table}"
	macro populateAdvancedSearchFormAndSearch {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var option = "${row[1]}";
			var type = "${row[2]}";
			var value = "${row[3]}";

			var key_field = "${field}";
			var key_option = "${option}";

			if ("${type}" == "Input") {
				if (("${field}" == "Created After") || ("${field}" == "Created Before") || ("${field}" == "Modified After") || ("${field}" == "Modified Before")) {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between After") || ("${field}" == "Modified Between After") || ("${field}" == "Started Between After") || ("${field}" == "Expires Between After")) {
					var key_fieldGroup = StringUtil.replace("${field}", " After", "");

					var key_field = "After";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between Before") || ("${field}" == "Modified Between Before") || ("${field}" == "Started Between Before") || ("${field}" == "Expires Between Before")) {
					var key_fieldGroup = StringUtil.replace("${field}", " Before", "");

					var key_field = "Before";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if ("${field}" == "Account") {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD_EXACT",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Checkbox") {
				if (("${field}" == "License Type") || ("${field}" == "Product Version") || ("${field}" == "Product")) {
					if (contains("${option}", "Portal")) {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
					}
					else {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
					}
				}
				else {
					if ("${value}" == "true") {
						if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
					else {
						if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
				}
			}
			else if ("${type}" == "Radio Button") {
				var key_value = "${value}";

				Click(locator1 = "Provisioning#ADVANCED_SEARCH_RADIO_BUTTON");
			}
			else if ("${type}" == "Select Entity") {
				Click(locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_ENTITY_BUTTON");

				SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

 				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_FIELD",
					value1 = "${keyword}");

				Click(locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningAccountSelect#DONE_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");
				}
			}
			else if ("${type}" == "Panel") {
				if ("${value}" == "Expand") {
					Provisioning.expandAdvancedSearchPanel(panelLabel = "${field}");
				}
				else if ("${value}" == "Collapse") {
					Provisioning.collapseAdvancedSearchPanel(panelLabel = "${field}");
				}
				else {
					echo("Please set a value of Expand or Collapse. No action will be taken on the panel.");					
				}
			}
			else {
				fail("No such advanced search field type ${type}. Please use Input, Select, Panel, Checkbox, or Radio Button");
			}
		}

		Click(locator1 = "Provisioning#ADVANCED_SEARCH_SEARCH_BUTTON");
	}

	@prose = "I populate the advanced search form with the following values and search via the enter key ${table}"
	macro populateAdvancedSearchFormAndSearchViaEnterKey {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var option = "${row[1]}";
			var type = "${row[2]}";
			var value = "${row[3]}";

			var key_field = "${field}";
			var key_option = "${option}";

			if ("${type}" == "Input") {
				if (("${field}" == "Created After") || ("${field}" == "Created Before") || ("${field}" == "Modified After") || ("${field}" == "Modified Before")) {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between After") || ("${field}" == "Modified Between After") || ("${field}" == "Started Between After") || ("${field}" == "Expires Between After")) {
					var key_fieldGroup = StringUtil.replace("${field}", " After", "");

					var key_field = "After";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if (("${field}" == "Created Between Before") || ("${field}" == "Modified Between Before") || ("${field}" == "Started Between Before") || ("${field}" == "Expires Between Before")) {
					var key_fieldGroup = StringUtil.replace("${field}", " Before", "");

					var key_field = "Before";

					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_GROUPED_DATE_INPUT_FIELD",
						value1 = "${value}");
				}
				else if ("${field}" == "Account") {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD_EXACT",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${type}" == "Select") {
				Select(
					locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_FIELD",
					value1 = "${value}");
			}
			else if ("${type}" == "Checkbox") {
				if (("${field}" == "License Type") || ("${field}" == "Product Version") || ("${field}" == "Product")) {
					if (contains("${option}", "Portal")) {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX_EXACT");
							}
						}
					}
					else {
						if ("${value}" == "true") {
							if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
						else {
							if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX")) {
								Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_PANEL_CHECKBOX");
							}
						}
					}
				}
				else {
					if ("${value}" == "true") {
						if (IsNotChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
					else {
						if (IsChecked(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX")) {
							Click.pauseMakeVisibleClickAt(locator1 = "Provisioning#ADVANCED_SEARCH_CHECKBOX");
						}
					}
				}
			}
			else if ("${type}" == "Radio Button") {
				var key_value = "${value}";

				Click(locator1 = "Provisioning#ADVANCED_SEARCH_RADIO_BUTTON");
			}
			else if ("${type}" == "Select Entity") {
				Click(locator1 = "Provisioning#ADVANCED_SEARCH_SELECT_ENTITY_BUTTON");

				SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

 				var keyword = StringUtil.extractFirst("${value}", " ");

				Type(
					locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_FIELD",
					value1 = "${keyword}");

				Click(locator1 = "ProvisioningAccountSelect#SELECT_SEARCH_BUTTON");

				var key_entityName = "${value}";

				Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

				SelectFrameTop();

				Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");

				while (IsElementPresent(locator1 = "ProvisioningAccountSelect#DONE_BUTTON")) {
					SelectFrame(locator1 = "ProvisioningAccountSelect#SELECT_IFRAME");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					Click(locator1 = "ProvisioningAccountSelect#ENTITY_ROW");

					SelectFrameTop();

					Click.pauseMakeVisibleClickAt(locator1 = "ProvisioningAccountSelect#DONE_BUTTON");
				}
			}
			else if ("${type}" == "Panel") {
				if ("${value}" == "Expand") {
					Provisioning.expandAdvancedSearchPanel(panelLabel = "${field}");
				}
				else if ("${value}" == "Collapse") {
					Provisioning.collapseAdvancedSearchPanel(panelLabel = "${field}");
				}
				else {
					echo("Please set a value of Expand or Collapse. No action will be taken on the panel.");					
				}
			}
			else {
				fail("No such advanced search field type ${type}. Please use Input, Select, Panel, Checkbox, or Radio Button");
			}
		}
		
		if (IsElementPresent(locator1 = "Provisioning#SEARCH_LICENSES_ADVANCED_SEARCH_EXPANDED")) {
			Provisioning.expandAdvancedSearchPanel(panelLabel = "General Details");

			var key_field = "Account Key";

			KeyPress(
				locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD",
				value1 = "\RETURN");
		}
		else {
			Provisioning.expandAdvancedSearchPanel(panelLabel = "Account");

			var key_field = "Account Name";

			KeyPress(
				locator1 = "Provisioning#ADVANCED_SEARCH_INPUT_FIELD",
				value1 = "\RETURN");
		}
	}

