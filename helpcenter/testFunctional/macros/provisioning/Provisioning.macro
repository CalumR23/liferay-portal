definition {
	var provisioningURL = PropsUtil.get("provisioning.liferay.url");

	@prose = "I click on the account with the name ${accountName} on the provisioning index"
	macro clickAccount {
		var key_accountName = "${accountName}";

		Click(locator1 = "Provisioning#ACCOUNT_NAME");		
	}

	@prose = "I click on the new account button"
	macro clickNewAccountButton {
		Click(locator1 = "Provisioning#NEW_ACCOUNT_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningAccountForm#INPUT_FIELD");
	}

	@prose = "I click on the new product bundle button"
	macro clickNewProductBundleButton {
		Click(locator1 = "Provisioning#NEW_PRODUCT_BUNDLE_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningProductBundleForm#INPUT_FIELD");
	}

	@prose = "I click on the new product button"
	macro clickNewProductButton {
		Click(locator1 = "Provisioning#NEW_PRODUCT_BUTTON");

		var key_field = "Name";

		AssertVisible(locator1 = "ProvisioningProductForm#INPUT_FIELD");
	}

	@prose = "I click on the product with the name ${productName} on the provisioning index"
	macro clickProduct {
		var key_productName = "${productName}";

		Click(locator1 = "Provisioning#PRODUCT_NAME");	
	}

	@prose = "I click on the product bundle with the name ${productBundleName} on the provisioning index"
	macro clickProductBundle {
		var key_productBundleName = "${productBundleName}";

		Click(locator1 = "Provisioning#PRODUCT_BUNDLE_NAME");	
	}

	@prose = "I click on the delete button for the product bundle ${productBundleName}"
	macro clickProductBundleDeleteButton {
		var key_productBundleName = "${productBundleName}";

		ClickNoError(locator1 = "Provisioning#PRODUCT_BUNDLE_DELETE");

		Confirm(value1 = "Are you sure you want to delete this product bundle?");
	}

	@prose = "I click on the delete button for the product ${productName}"
	macro clickProductDeleteButton {
		var key_productName = "${productName}";

		ClickNoError(locator1 = "Provisioning#PRODUCT_DELETE");

		Confirm(value1 = "Are you sure you want to delete this product?");
	}

	@prose = "I click on search accounts button"
	macro clickSearchAccountsButton {
		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_BUTTON");		
	}

	@prose = "I click on search dropdown result ${result}"
	macro clickSearchDropdownResult {
		var key_result = "${result}";

		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT");		
	}

	@prose = "I click on the see all results link"
	macro clickSeeAllResults {
		Click(locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_SEE_ALL_RESULTS");		
	}

	@prose = "I click on the ${tabName} tab"
	macro clickTab {
		var key_tabName = StringUtil.lowerCase("${tabName}");

		var key_tabName = StringUtil.replace("${key_tabName}", " ", "-");

		Click(locator1 = "Provisioning#TAB");
	}

	@prose = "I click on the user with the name ${userName} on the provisioning index"
	macro clickUser {
		var key_userName = "${userName}";

		Click(locator1 = "Provisioning#USER_NAME");	
	}

	@prose = "I go to the account index page"
	macro gotoAccounts {
		Open(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_AccountsPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the product bundles index page"
	macro gotoProductBundles {
		Open(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_ProductBundlesPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the product index page"
	macro gotoProducts {
		Open(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_ProductsPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I go to the user index page"
	macro gotoUsers {
		Open(locator1 = "${provisioningURL}/group/guest/~/control_panel/manage?p_p_id=com_liferay_osb_provisioning_web_portlet_UsersPortlet&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=20124");
	}

	@prose = "I search the accounts page using the keyword ${keyword}"
	macro searchAccounts {
		Provisioning.typeKeywordViaSearchAccountsField(keyword = "${keyword}");

		Provisioning.clickSearchAccountsButton();
	}

	@prose = "I search the product bundles page using the keyword ${keyword}"
	macro searchProductBundles {
		Type(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I search the products page using the keyword ${keyword}"
	macro searchProducts {
		Type(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I search the users page using the keyword ${keyword}"
	macro searchUsers {
		Type(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "Provisioning#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "I type in the keyword ${keyword} via send keys into the Search Accounts field"
	macro sendKeysKeywordViaSearchAccountsField {
		DoubleClick(locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD");

		Type.clickAtSendKeys(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "\SPACE");

		KeyPress(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "\BACK_SPACE");
	}

	@prose = "I tear down the following product bundles ${table}"
	macro tearDownProductBundles {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var productBundleName = "${row[0]}";

			var key_productBundleName = "${productBundleName}";

			if (IsElementPresent(locator1 = "Provisioning#PRODUCT_BUNDLE_ROW")) {
				Provisioning.clickProductBundleDeleteButton(productBundleName = "${productBundleName}");
			}
		}
	}

	@prose = "I type in the keyword ${keyword} into the Search Accounts field"
	macro typeKeywordViaSearchAccountsField {
		Type(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_FIELD",
			value1 = "${keyword}");
	}

	@prose = "I should be able to view an error message"
	macro viewErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Your request failed to complete.");
	}

	@prose = "I should not be able to view an account on the provisioning index with the name ${accountName}"
	macro _viewNoAccountViaIndex {
		var key_accountName = "${accountName}";

		AssertElementNotPresent(locator1 = "Provisioning#ACCOUNT_ROW");
	}

	@prose = "I should not be able to view a product bundle on the provisioning index with the name ${productBundleName}"
	macro _viewNoProductBundleViaIndex {
		var key_productBundleName = "${productBundleName}";

		AssertElementNotPresent(locator1 = "Provisioning#PRODUCT_BUNDLE_ROW");
	}

	@prose = "I should not be able to view a product on the provisioning index with the name ${productName}"
	macro _viewNoProductViaIndex {
		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "Provisioning#PRODUCT_ROW");
	}

	@prose = "I should not be able to view the search result ${result}"
	macro viewNoSearchDropdownResult {
		var key_result = "${result}";

		AssertElementNotPresent(locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT");		
	}

	@prose = "I should not be able to view any search dropdown results"
	macro viewNoSearchDropdownResults {
		AssertTextEquals(
			locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_NO_RESULTS",
			value1 = "No results were found.");		
	}

	@prose = "I should not be able to view a user on the provisioning index with the name ${userName}"
	macro _viewNoUserViaIndex {
		var key_userName = "${userName}";

		AssertElementNotPresent(locator1 = "Provisioning#USER_ROW");
	}

	@prose = "I should be able to view an account on the provisioning index with the name ${accountName} and the following values ${table}"
	macro _viewAccountViaIndex {
		var key_accountName = "${accountName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#ACCOUNT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_CODE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support End Date") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_SUPPORT_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_PARTNER",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#ACCOUNT_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "Provisioning#ACCOUNT_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such account field ${field}");
			}
		}
	}

	@prose = "I should be able to view a product bundle on the provisioning index with the name ${productBundleName} and the following values ${table}"
	macro _viewProductBundleViaIndex {
		var key_productBundleName = "${productBundleName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "Provisioning#PRODUCT_BUNDLE_NAME",
					value1 = "${value}");
			}
			else {
				fail("No such product bundle field ${field}");
			}
		}
	}

	@prose = "I should be able to view the product bundle error message on the product index resulting from an attempted deletion of the product"
	macro viewProductIndexProductBundleErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Please remove the product from all product bundles before deleting.");
	}

	@prose = "I should be able to view the product consumption error message on the product index resulting from an attempted deletion of the product with the id value ${productId}"
	macro viewProductIndexProductConsumptionErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Product ${productId} cannot be deleted because it is referenced by one or more product consumption");
	}

	@prose = "I should be able to view the product purchase error message on the product index resulting from an attempted deletion of the product with the id value ${productId}"
	macro viewProductIndexProductPurchaseErrorMessage {
		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Error:");

		AssertTextEquals.assertPartialText(
			locator1 = "Provisioning#ERROR_MESSAGE",
			value1 = "Product ${productId} cannot be deleted because it is referenced by one or more product purchases");
	}

	@prose = "I should be able to view a product on the provisioning index with the name ${productName} and the following values ${table}"
	macro _viewProductViaIndex {
		var key_productName = "${productName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "Provisioning#PRODUCT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "Provisioning#PRODUCT_TYPE",
					value1 = "${value}");
			}
			else {
				fail("No such product field ${field}");
			}
		}
	}

	@prose = "I should be able to view the search result ${result} with the following values ${table}"
	macro viewSearchDropdownResult {
		var key_result = "${result}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				AssertTextEquals(
					locator1 = "Provisioning#SEARCH_ACCOUNTS_DROPDOWN_RESULT_CODE",
					value1 = "${value}");
			}
			else {
				fail("No such search result dropdown field ${field}");
			}
		}	
	}

	@prose = "I should be able to view a user on the provisioning index with the name ${userName} and the following values ${table}"
	macro _viewUserViaIndex {
		var key_userName = "${userName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "Provisioning#USER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_EMAIL_ADDRESS",
					value1 = "${value}");
			}
			else if ("${field}" == "Entitlements") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_ENTITLEMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Number of Accounts") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_NUMBER_OF_ACCOUNTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "Provisioning#USER_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such user field ${field}");
			}
		}
	}
}