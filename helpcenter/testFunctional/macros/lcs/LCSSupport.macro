definition {
	var lcsURL = PropsUtil.get("lcs.liferay.url");

	@prose = "I search the lcs support index using the corp project id ${corpProjectId}"
	macro search {
		Type(
			locator1 = "LCSSupport#CORP_PROJECT_ID_FIELD",
			value1 = "${corpProjectId}");

		Click(locator1 = "LCSSupport#SEARCH_BUTTON");
	}

	@prose = "I should not be able to view a project on the lcs support index with the name ${projectName}"
	macro _viewNoProject {
		var key_projectName = "${projectName}";

		AssertElementNotPresent(locator1 = "LCSSupport#PROJECT_ROW");
	}

	@prose = "I should be able to view a project on the lcs support index with the name ${projectName} and the following values ${table}"
	macro _viewProject {
		var key_projectName = "${projectName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Corp Project ID") {
				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_CORP_PROJECT_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Subscription Type") {
				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_SUBSCRIPTION_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Servers Used") {
				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_SERVERS_USED",
					value1 = "${value}");
			}
			else if ("${field}" == "Servers Allowed") {
				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_SERVERS_ALLOWED",
					value1 = "${value}");
			}
			else if ("${field}" == "Subscription End Date") {
				var value = StringUtil.replace("${value}", " 0", " ");

				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_SUBSCRIPTION_END_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support End Date") {
				var value = StringUtil.replace("${value}", " 0", " ");

				AssertTextEquals.assertPartialText(
					locator1 = "LCSSupport#PROJECT_SUPPORT_END_DATE",
					value1 = "${value}");
			}
			else {
				fail("No such project field ${field}");
			}
		}
	}
}