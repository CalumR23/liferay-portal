definition {

	var supportLiferayUrl = PropsUtil.get("support.liferay.url");
	var supportAdminEmailAddress = PropsUtil.get("support.admin.email.address");
	var supportAdminPassword = PropsUtil.get("support.admin.password");
	var testAccountCode = PropsUtil.get("test.account.code");

	@prose = "I check that the fields below are presente at the customer account entry ${table}"
	macro getCustomerAccountEntry {
		var curl = '''
			${supportLiferayUrl}/api/jsonws/osb.accountentry/get-account-entry-by-code --tlsv1.2
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d code='${testAccountCode}'
		''';

		var currentCustomerAccountEntry = JSONCurlUtil.post("${curl}");

		JSONOkta._checkJSOMFieldIsPresent(
			currentJson = "${currentCustomerAccountEntry}",
			table = "${table}");
	}

	@prose = "I check that the fields below are presente at the customer project account ${table}"
	macro getCustomerProjectAccount {
		var curl = '''
			${supportLiferayUrl}/api/jsonws/osb.accountcustomer/get-corp-project-account-customer-users --tlsv1.2
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d corpProjectUuid=''
		''';

		var currentCustomerProjectAccount = JSONCurlUtil.post("${curl}");

		JSONOkta._checkJSOMFieldIsPresent(
			currentJson = "${currentCustomerProjectAccount}",
			table = "${table}");
	}

}