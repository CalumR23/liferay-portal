definition {

	@prose = "I click on the generate button on the generate activation key form"
	macro clickActivationKeyFormGenerateButton {
		Click(locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS");
	}

	@prose = "I click on the next button on generate activation key form"
	macro clickActivationKeyFormNextButton {
		Click(locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_NEXT");
	}

	@prose = "I click on the generate activation key button on activation keys index"
	macro clickGenerateActivationKeyButton {
		Click(locator1 = "CustomerActivationKey#ACTIONS");

		Click(locator1 = "CustomerActivationKey#GENERATE_NEW_ACTIVATION_KEY");
	}

	@prose = "I populate the activation key form with the following values ${table}"
	macro populateActivationKeyForm {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var option = "${row[1]}";
			var value = "${row[2]}";

			var key_projectField = "${field}";
			var key_projectValue = "${value}";

			if ("${option}" == "Select") {
				if ("${field}" == "Cluster Nodes") {
					Select(
						locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_OPTION_CLUSTER",
						value1 = "${key_projectValue}");				
				}
				else {
					Select(
						locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_OPTION",
						value1 = "${key_projectValue}");
				}

			}
			else if ("${option}" == "Radio Button") {
				Click(locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_SUBSCRIPTION");
			}
			else if ("${option}" == "Input") {
				Type(
					locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_INPUT",
					value1 = "${key_projectValue}");
			}
			else if ("${option}" == "Textarea") {
				Type(
					locator1 = "CustomerActivationKey#GENERATE_ACTIVATION_KEYS_FORM_TEXTAREA",
					value1 = "${key_projectValue}");
			}
			else {
				echo("No such ${field} field found.");
			}
		}
	}

}