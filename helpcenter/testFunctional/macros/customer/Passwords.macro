definition {
    var supportAdminEmailAdress = PropsUtil.get("support.admin.email.address");
    var supportAdminPassword = PropsUtil.get("support.admin.password");

    @prose = "I get all passwords"
    macro getPasswords {
        static var staticSupportAdminEmailAdress = "${supportAdminEmailAdress}";
        static var staticSupportAdminPassword = "${supportAdminPassword}";

        return "${staticSupportAdminEmailAdress}";
        return "${staticSupportAdminPassword}";
    }
}