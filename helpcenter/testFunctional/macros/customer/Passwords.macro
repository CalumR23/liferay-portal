definition {
    var supportAdminEmailAdress = PropsUtil.get("support.admin.email.address");
    var supportAdminPassword = PropsUtil.get("support.admin.password");
    var koroneikiAdminEmailAddress = PropsUtil.get("koroneiki.admin.email.address");
    var koroneikiAdminPassword = PropsUtil.get("koroneiki.admin.password");
    var supportUserTestPassword = PropsUtil.get("support.user.test.password");
    var provisioningQaUserPassword = PropsUtil.get("provisioning.qa.user.password");

    @prose = "I get all test passwords and admin emails"
    macro getPasswords {
        static var staticSupportAdminEmailAdress = "${supportAdminEmailAdress}";
        static var staticSupportAdminPassword = "${supportAdminPassword}";
        static var staticKoroneikiAdminEmailAddress = "${koroneikiAdminEmailAddress}";
        static var staticKoroneikiAdminPassword = "${koroneikiAdminPassword}";
        static var staticSupportUserTestPassword = "${supportUserTestPassword}";
        static var staticProvisioningQaUserPassword = "${provisioningQaUserPassword}";

        return "${staticSupportAdminEmailAdress}";
        return "${staticSupportAdminPassword}";
        return "${staticKoroneikiAdminEmailAddress}";
        return "${staticKoroneikiAdminPassword}";
        return "${staticSupportUserTestPassword}";
        return "${staticProvisioningQaUserPassword}";
    }
}