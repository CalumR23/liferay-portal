definition {

	var customerAdminEmailAddress = PropsUtil.get("customer.admin.email.address");
	var customerAdminPassword = PropsUtil.get("customer.admin.password");
    var customerURL = PropsUtil.get("customer.portal.url");

	@prose = "I should be able to view an user on the customer project index page with the name ${userName} and the following values ${table}"
	macro _viewCustomerUserViaIndex {
		var key_userName = "${userName}";
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals.assertPartialText(
					locator1 = "CustomerUser#USER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				var key_userEmailAddress = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#USER_EMAIL_ADDRESS",
					value1 = "${value}");
			}
			else if ("${field}" == "Role") {
				var key_userRoles = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#USER_ROLES",
					value1 = "${value}");
			}
			else {
				fail("No such user field ${field}");
			}
		}
	}

    @prose = "I should not be able to view a user on the customer index with the name ${userName}"
	macro _viewNoCustomerUserViaIndex {
		var key_userName = "${userName}";

		AssertElementNotPresent(locator1 = "CustomerUser#USER_NAME");
	}

	@prose = "I search the customer team member page using the keyword ${keyword}"
	macro searchCustomerSubscription {
		WaitForSPARefresh();

		CustomerProject.typeKeywordViaSearchCustomerProjectField(keyword = "${keyword}");

		CustomerProject.clickSearchCustomerProjectButton();
	}

	@prose = "I should be able to view a customer team member and the following values ${table}"
	macro _viewCustomerTeamMember {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				key_teamMemberValue = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#TEAM_MEMBER_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Email") {
				key_teamMemberValue = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#TEAM_MEMBER_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Seat") {
				key_teamMemberValue = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#TEAM_MEMBER_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Role") {
				key_teamMemberValue = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#TEAM_MEMBER_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				key_teamMemberValue = "${value}";
				AssertTextEquals(
					locator1 = "CustomerUser#TEAM_MEMBER_VALUE",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}


}