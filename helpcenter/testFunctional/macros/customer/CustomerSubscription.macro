definition{

	@prose = "I choose the ${subscription} subscription at the product activation tab"
	macro chooseSubscriptionAtActivationTab {
		key_subscriptionActivationTab = "${subscription}";

		if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION")) {
			Click(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB");
		}

		Click(locator1 = "CustomerSubscription#SUBSCRIPTION_PRODUCT_ACTIVATION_TAB_OPTION");
	}

	@prose = "I click on the customer subscription page"
	macro clickCustomerSubscriptionPage {
		Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
	}

	@prose = "I filter the subscriptions details page to show only ${filter} subscriptions"
	macro filterCustomerSubscriptionDropdown {

		if ("${filter}" == "Active") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
			else {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ACTIVE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if ("${filter}" == "Expired") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_EXPIRED");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
			else {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_EXPIRED");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
		else if ("${filter}" == "Future") {
			if (IsElementNotPresent(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL_SELECTED")) {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_FUTURE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
			else {
				Click.makeVisibleClickAt(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_ALL");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DROPDOWN_FUTURE");
				Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_HEADER");
			}
		}
	}

	@prose = "I select the subscriptions details page to show only ${filter} subscriptions"
	macro filterCustomerSubscriptionSelection {
		key_subscriptionFilter = "${filter}";

		Click(locator1 = "CustomerSubscription#SUBSCRIPTION_SELECT_FILTER");
	}

	@prose = "I go to the ${tab} tab at subscription details page"
	macro goToSubscriptionDetailsTab {
		key_subscriptionTab = "${tab}";

		Click(locator1 = "CustomerSubscription#SUBSCRIPTION_DETAILS_PAGE_TAB");
	}

	@prose = "I search the customer subscription page using the keyword ${keyword}"
	macro searchCustomerSubscription {
		WaitForSPARefresh();

		CustomerProject.typeKeywordViaSearchCustomerProjectField(keyword = "${keyword}");

		CustomerProject.clickSearchCustomerProjectButton();
	}

    @prose = "I should be able to view a ${subscriptionName} Support Level on the customer project page with the following values ${table}"
	macro viewCustomerSubscriptionDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
                key_subscriptionName = "${value}";
				AssertTextEquals(
					locator1 = "CustomerSubscription#SUBSCRIPTION_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Date") {
                    key_date = "${value}";
				AssertTextEquals.assertPartialText(
					locator1 = "CustomerSubscription#SUBSCRIPTION_DATE",
					value1 = "${value}");
			}
			else {
				fail("No such subscription detail field ${field}");
			}
		}
	}

}