	@prose = "I expand the Source Code Access user panel for the user with the email address ${userEmailAddress}"
	macro expandSourceCodeAccessUserPanel {
		var key_userEmailAddress = "${userEmailAddress}";

		if (IsElementNotPresent(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_PANEL_EXPANDED")) {
			Click(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_PANEL");

			AssertElementPresent(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_PANEL_EXPANDED");
		}
	}

