definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I add an environment configuration with the following values ${table}"
	macro addEnvironmentConfiguration {
		Click(locator1 = "ProjectDetailsProject#ADD_ENVIRONMENT_CONFIGURATION_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Commerce Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#COMMERCE_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Liferay Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#LIFERAY_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Operating System") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#OPERATING_SYSTEM_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Java Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#JAVA_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Application Server") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#APPLICATION_SERVER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Database") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#DATABASE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Cloud Services") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#CLOUD_SERVICES_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Browser") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#BROWSER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Search") {
				var key_option= "${value}";

				Click(locator1 = "ProjectDetailsEnvironmentForm#SEARCH_SELECT_OPTION");
			}
			else if ("${field}" == "Portal EXT") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Patch Info") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

	@prose = "I add a Source Code Access user with the following values ${table}"
	macro addSourceCodeAccessUser {
		Click(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_ADD_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "GitHub Username") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#GITHUB_USERNAME_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such Source Code Access user field ${field}");
			}
		}

		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#SUBMIT_BUTTON");

		AssertTextEquals(
			locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_TITLE",
			value1 = "Success! Your request submitted successfully.");

		AssertTextEquals(
			locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_BODY",
			value1 = "You will receive an email invitation from GitHub to collaborate on the liferaydxp/repository. Accept the invitation to gain access.");	

		AssertTextEquals(
			locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_GITHUB_LINK",
			value1 = "GitHub");

		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#CLOSE_BUTTON");
	}

	@prose = "I add a Source Code Access user with the following values on a closed project ${table}"
	macro addSourceCodeAccessUserOnClosedProject {
		Click(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_ADD_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#EMAIL_ADDRESS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "GitHub Username") {
				Type(
					locator1 = "ProjectDetailsSourceCodeAccessForm#GITHUB_USERNAME_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such Source Code Access user field ${field}");
			}
		}

		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#SUBMIT_BUTTON");

		AssertTextEquals(
			locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_TITLE",
			value1 = "Oh no, you can't be granted access yet.");

		AssertTextEquals(
			locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_BODY",
			value1 = "This request will be completed as soon as the support project becomes active.");	

		AssertElementNotPresent(locator1 = "ProjectDetailsSourceCodeAccessForm#MESSAGE_GITHUB_LINK");

		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#CLOSE_BUTTON");
	}

	@prose = "I add support instructions with the content ${supportInstructionsContent}"
	macro addSupportInstructions {
		Click(locator1 = "ProjectDetailsProject#ADD_SUPPORT_INSTRUCTIONS_BUTTON");

		SelectFrame(locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_IFRAME");

		Click(locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_BODY");

		Type.sendKeys(
			locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_BODY",
			value1 = "${supportInstructionsContent}");

		SelectFrameTop();		

		Button.save();

		Message.success();
	}

	@prose = "I click on the ticket link for the attachment with the keyword ${fileKeyword}"
	macro clickAttachmentTicketLink {
		var key_fileKeyword = "${fileKeyword}";

		Click(locator1 = "ProjectDetailsProject#ATTACHMENT_TICKET");
	}

	@prose = "I click on the edit button for the environment configuration with the name ${environmentName}"
	macro clickEnvironmentConfigurationEditButton {
		var key_environmentName = "${environmentName}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_EDIT_BUTTON");
	}

	@prose = "I click on the Source Code Access add user button"
	macro clickSourceCodeAccessAddUserButton {
		Click(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_ADD_BUTTON");
	}

	@prose = "I click on the Source Code Access Form cancel button"
	macro clickSourceCodeAccessFormCancelButton {
		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#CANCEL_BUTTON");
	}

	@prose = "I click on the Source Code Access Form close button"
	macro clickSourceCodeAccessFormCloseButton {
		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#CLOSE_BUTTON");
	}

	@prose = "I click on the Source Code Access Form submit button"
	macro clickSourceCodeAccessFormSubmitButton {
		Click(locator1 = "ProjectDetailsSourceCodeAccessForm#SUBMIT_BUTTON");
	}

	@prose = "I delete the attachment with the keyword ${fileKeyword}"
	macro deleteAttachment {
		var key_fileKeyword = "${fileKeyword}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK")) {
			Click(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");

			var key_action = "Delete";

			ClickNoError(locator1 = "ProjectDetailsProject#MENULIST_ACTION");
		}
		else {
			ClickNoError(locator1 = "ProjectDetailsProject#ATTACHMENT_DELETE_LINK");
		}

		Confirm(value1 = "Are you sure you want to delete this?");

		Message.success();
	}

	@prose = "I delete the environment configuration with the name ${environmentName}"
	macro deleteEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this?");

		Message.success();
	}

	@prose = "I delete the Source Code Access user with the email address ${userEmailAddress}"
	macro deleteSourceCodeAccessUser {
		var key_userEmailAddress = "${userEmailAddress}";

		ProjectDetails.expandSourceCodeAccessUserPanel(userEmailAddress = "${userEmailAddress}");

		ClickNoError(locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_DETAILS_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this?");
	}

	@prose = "I edit access for the file with the keyword ${fileKeyword} to be accessible from any support location"
	macro editAttachmentToBeAccessibleFromAnywhere {
		var key_fileKeyword = "${fileKeyword}";

		Click(locator1 = "ProjectDetailsProject#ATTACHMENT_ACTIONS_LINK");

		var key_action = "Edit Access";

		Click(locator1 = "ProjectDetailsProject#MENULIST_ACTION");

		SelectFrame(locator1 = "ProjectDetailsEditAccessForm#EDIT_ACCESS_IFRAME");

		AssertTextEquals.assertPartialText(
			locator1 = "ProjectDetailsEditAccessForm#INFO_MESSAGE",
			value1 = "Note: This action cannot be undone.");

		Check(locator1 = "ProjectDetailsEditAccessForm#NO_PERSONAL_DATA_CHECKBOX");

		Button.save();

		SelectFrameTop();
	}

	@prose = "I edit the environment configuration with the name ${environmentName} with the following values ${table}"
	macro editEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_EDIT_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Commerce Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#COMMERCE_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Liferay Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#LIFERAY_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Operating System") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#OPERATING_SYSTEM_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Java Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#JAVA_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Application Server") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#APPLICATION_SERVER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Database") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#DATABASE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Cloud Services") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#CLOUD_SERVICES_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Browser") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#BROWSER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Search") {
				var key_option= "${value}";

				Click(locator1 = "ProjectDetailsEnvironmentForm#SEARCH_SELECT_OPTION");
			}
			else if ("${field}" == "Portal EXT") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Patch Info") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

