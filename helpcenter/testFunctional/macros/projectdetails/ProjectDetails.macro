	@prose = "the history entry in position number ${positionValue} with the field value ${fieldName} should be visible with the following values ${table}"
	macro viewHistoryEntry {
		var key_positionValue = "${positionValue}";
		var key_fieldName = "${fieldName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Updater Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Summary") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_SUMMARY",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Description") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DESCRIPTION",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Date") {
				if ("${value}" == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonth();
					var year = DateUtil.getCurrentYear();

					var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

					var startDate = "${month}/${day}/${yearEdit}";

					if (IsTextNotEqual.isNotPartialText(locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE", value1 = "${startDate}")) {
						var day = DateUtil.getDate("1");
						var month = DateUtil.getMonth("1");
						var year = DateUtil.getYear("1");

						var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

						var startDate = "${month}/${day}/${yearEdit}";

						AssertTextEquals.assertPartialText(
							locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
							value1 = "${startDate}");
					}
					else {
						AssertTextEquals.assertPartialText(
							locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
							value1 = "${startDate}");						
					}
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Update Field Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Field Original Value") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Field New Value") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_NEW_VALUE",
					value1 = "${value}");
			}
			else {
				fail("No such history entry field ${field}");
			}
		}
	}

