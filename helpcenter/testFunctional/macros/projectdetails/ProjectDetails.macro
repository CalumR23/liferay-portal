	@prose = "the offering with the product name ${productName} should be visible with the following values ${table}"
	macro viewOffering {
		var key_productName = "${productName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				if ("${value}" == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonthName();
					var year = DateUtil.getCurrentYear();

					var startDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE", value1 = "${startDate}")) {
						var day = DateUtil.getDate("1");
						var month = DateUtil.getMonthName("1");
						var year = DateUtil.getYear("1");	

						var startDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
							value1 = "${startDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
							value1 = "${startDate}");
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Support End Date") {
				if (contains("${value}", "years from now")) {
					var numberOfYearsFromNow = StringUtil.replace("${value}", " years from now", "");

					var year = DateUtil.getYear("-1");

					var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

					var day = DateUtil.getDate("-1");
					var month = DateUtil.getMonthName("-1");

					var supportEndDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE", value1 = "${supportEndDate}")) {
						var year = DateUtil.getYear("0");

						var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

						var day = DateUtil.getDate("0");
						var month = DateUtil.getMonthName("0");

						var supportEndDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
				}
				else if (contains("${value}", "year from now")) {
					var numberOfYearsFromNow = StringUtil.replace("${value}", " year from now", "");

					var year = DateUtil.getYear("-1");

					var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

					var day = DateUtil.getDate("-1");
					var month = DateUtil.getMonthName("-1");

					var supportEndDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE", value1 = "${supportEndDate}")) {
						var year = DateUtil.getYear("0");

						var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

						var day = DateUtil.getDate("0");
						var month = DateUtil.getMonthName("0");

						var supportEndDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Quantity") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_QUANTITY",
					value1 = "${value}");
			}
			else if ("${field}" == "Provisioned") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_PROVISIONED",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_STATE",
					value1 = "${value}");
			}
			else {
				fail("No such offering field ${field}");
			}
		}
	}

	@prose = "I should be able to view the project in the Project Details index with the name ${projectName} and state ${projectState}"
	macro viewProjectViaIndex {
		var key_projectName = "${projectName}";

		AssertTextEquals(
			locator1 = "ProjectDetails#PROJECT_NAME",
			value1 = "${projectName}");

		AssertTextEquals(
			locator1 = "ProjectDetails#PROJECT_STATE",
			value1 = "${projectState}");
	}

	@prose = "the Source Code Access user details for a user with the email address ${userEmailAddress} should be visible with the following values ${table}"
	macro viewSourceCodeAccessUserDetails {
		var key_userEmailAddress = "${userEmailAddress}";

		ProjectDetails.expandSourceCodeAccessUserPanel(userEmailAddress = "${userEmailAddress}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_DETAILS_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "GitHub Username") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_DETAILS_GITHUB_USERNAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#SOURCE_CODE_ACCESS_USER_DETAILS_EMAIL_ADDRESS",
					value1 = "${value}");
			}
			else {
				fail("No such Source Code Access user field ${field}");
			}
		}
	}

	@prose = "I should be able to view the Source Code Access user form errors with the following values ${table}"
	macro viewSourceCodeAccessFormErrors {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Main Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#ERROR_MESSAGE",
					value1 = "${value}");
			}
			else if ("${field}" == "Name Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#NAME_FIELD_ERROR",
					value1 = "${value}");
			}
			else if ("${field}" == "Email Address Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#EMAIL_ADDRESS_FIELD_ERROR",
					value1 = "${value}");
			}
			else if ("${field}" == "GitHub Username Field Error") {
				AssertTextEquals.assertPartialText(
					locator1 = "ProjectDetailsSourceCodeAccessForm#GITHUB_USERNAME_FIELD_ERROR",
					value1 = "${value}");
			}
			else {
				fail("No such Source Code Access error ${field}. Please use Main Error, Name Field Error, Email Address Field Error, or GitHub Username Field Error");
			}
		}
	}

