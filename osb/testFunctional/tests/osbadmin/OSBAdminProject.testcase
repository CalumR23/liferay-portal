<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.3')" name="casEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.customer.name.4')" name="customerName" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.8')" name="cwatcherEmailAddress" />

	<var name="staticTearDownOffering" static="true" value="" />
	<var name="staticTearDownOrder" static="true" value="" />
	<var name="staticTearDownProject" static="true" value="" />

	<set-up>
		<var name="staticTearDownOffering" value="" />
		<var name="staticTearDownOrder" value="" />
		<var name="staticTearDownProject" value="" />

		<execute macro="OSBAdminUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownOrder}" arg2="" />
			</not>
			<then>
				<var method="StringUtil#extractFirst('${staticTearDownOrder}', ',')" name="projectCode" />
				<var method="StringUtil#extractLast('${staticTearDownOrder}', ',')" name="projectName" />

				<execute macro="OSBAdminSales#tearDownOrder">
					<var name="projectCode" value="${projectCode}" />
					<var name="projectName" value="${projectName}" />
				</execute>
			</then>
		</if>

		<if>
			<not>
				<equals arg1="${staticTearDownOffering}" arg2="" />
			</not>
			<then>
				<var method="StringUtil#extractFirst('${staticTearDownOffering}', ',')" name="product" />

				<var method="StringUtil#extractLast('${staticTearDownOffering}', ',')" name="support" />

				<execute macro="OSBAdminSales#tearDownOffering">
					<var name="description" value="QA Test" />
					<var name="product" value="${product}" />
					<var name="support" value="${support}" />
				</execute>
			</then>
		</if>

		<if>
			<not>
				<equals arg1="${staticTearDownProject}" arg2="" />
			</not>
			<then>
				<execute macro="OSBAdminProject#tearDownProject">
					<var name="projectCode" value="${staticTearDownProject}" />
				</execute>
			</then>
		</if>

		<execute macro="OSBAdminUser#logout" />
	</tear-down>

	<command name="AddProject">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 1" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST1" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 1" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST1" />
	</command>

	<command name="AddProjectWithOffering">
		<property name="lesa.acceptance" value="true" />

		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 5" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST5" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 5" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST5" />

		<execute macro="OSBAdminProject#viewProjectStatus">
			<var name="projectCode" value="QATEST5" />
			<var name="status" value="Closed" />
		</execute>

		<execute macro="OSBAdminSales#addOrder">
			<var name="product" value="Portal Non-Production" />
			<var name="projectCode" value="QATEST5" />
			<var name="support" value="Gold" />
		</execute>

		<var name="staticTearDownOrder" value="QATEST5,QA Test 5" />

		<execute macro="OSBAdminProject#viewProjectStatus">
			<var name="projectCode" value="QATEST5" />
			<var name="status" value="Approved" />
		</execute>
	</command>

	<command name="AssignCustomer">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 2" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST2" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 2" />
			<var name="state" value="Maine" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST2" />

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${cwatcherEmailAddress}" />
			<var name="projectCode" value="QATEST2" />
			<var name="role" value="Watcher" />
		</execute>
	</command>

	<command name="AssignWorker">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 3" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST3" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 3" />
			<var name="state" value="Maine" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST3" />

		<execute macro="OSBAdminProject#assignWorker">
			<var name="emailAddress" value="${casEmailAddress}" />
			<var name="projectCode" value="QATEST3" />
			<var name="role" value="Advocacy Specialist" />
		</execute>
	</command>

	<command name="EditProject">
		<property name="lesa.acceptance" value="true" />

		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 12" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST12" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 12" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST12" />

		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="QATEST12" />
		</execute>

		<execute macro="OSBAdminProject#editProject">
			<var name="additionalNotes" value="This is a test for editing a project." />
			<var name="addressLine" value="123 ABC Street" />
			<var name="businessAccountName" value="QA Test 12 Edited" />
			<var name="city" value="Vancouver" />
			<var name="code" value="QATEST12EDITED" />
			<var name="country" value="Canada" />
			<var name="industry" value="Agriculture" />
			<var name="language" value="Japanese" />
			<var name="maxContacts" value="15" />
			<var name="partnerCode" value="QA Test Partner" />
			<var name="projectName" value="QA Test 12 Edited" />
			<var name="specialInstructions" value="test" />
			<var name="state" value="Alberta" />
			<var name="tier" value="Strategic" />
			<var name="type" value="Individual" />
			<var name="zip" value="11111" />
		</execute>

		<var name="staticTearDownProject" value="QATEST12EDITED" />

		<execute macro="OSBAdminProject#viewProjectDetails">
			<var name="additionalNotes" value="This is a test for editing a project." />
			<var name="addressLine" value="123 ABC Street" />
			<var name="businessAccountName" value="QA Test 12 Edited" />
			<var name="city" value="Vancouver" />
			<var name="code" value="QATEST12EDITED" />
			<var name="country" value="Canada" />
			<var name="industry" value="Agriculture" />
			<var name="language" value="Japanese" />
			<var name="maxContacts" value="15" />
			<var name="partnerCode" value="QA Test Partner" />
			<var name="projectCode" value="QATEST12EDITED" />
			<var name="projectName" value="QA Test 12 Edited" />
			<var name="specialInstructions" value="test" />
			<var name="state" value="Alberta" />
			<var name="tier" value="Strategic" />
			<var name="type" value="Individual" />
			<var name="zip" value="11111" />
		</execute>
	</command>

	<command name="RemoveSupportLanguage">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 11" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST11" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 11" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST11" />

		<execute macro="OSBAdminProject#addSupportLanguageToProject">
			<var name="projectCode" value="QATEST11" />
			<var name="supportLanguage" value="Chinese" />
		</execute>

		<execute macro="OSBAdminProject#removeSupportLanguage">
			<var name="projectCode" value="QATEST11" />
			<var name="supportLanguage" value="Chinese" />
		</execute>
	</command>

	<command name="RemoveSupportRegion">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test 10" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST10" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Test 10" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<var name="staticTearDownProject" value="QATEST10" />

		<execute macro="OSBAdminProject#addSupportRegionToProject">
			<var name="projectCode" value="QATEST10" />
			<var name="supportRegion" value="Brazil" />
		</execute>

		<execute macro="OSBAdminProject#removeSupportRegion">
			<var name="projectCode" value="QATEST10" />
			<var name="supportRegion" value="Brazil" />
		</execute>
	</command>
</definition>