@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var casEmailAddress = PropsUtil.get("lesa.email.address.3");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerName = PropsUtil.get("lesa.customer.name.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var cwatcherEmailAddress = PropsUtil.get("lesa.email.address.8");
	static var staticTearDownOffering = "";
	static var staticTearDownOrder = "";
	static var staticTearDownProject = "";

	setUp {
		var staticTearDownOffering = "";
		var staticTearDownOrder = "";
		var staticTearDownProject = "";

		OSBAdminUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();
	}

	tearDown {
		if ("${staticTearDownOrder}" != "") {
			var projectCode = StringUtil.extractFirst("${staticTearDownOrder}", ",");
			var projectName = StringUtil.extractLast("${staticTearDownOrder}", ",");

			OSBAdminSales.tearDownOrder(
				projectCode = "${projectCode}",
				projectName = "${projectName}");
		}

		if ("${staticTearDownOffering}" != "") {
			var product = StringUtil.extractFirst("${staticTearDownOffering}", ",");
			var support = StringUtil.extractLast("${staticTearDownOffering}", ",");

			OSBAdminSales.tearDownOffering(
				description = "QA Test",
				product = "${product}",
				support = "${support}");
		}

		if ("${staticTearDownProject}" != "") {
			OSBAdminProject.tearDownProject(projectCode = "${staticTearDownProject}");
		}

		OSBAdminUser.logout();
	}

	test AddProject {
		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 1",
			city = "Augusta",
			code = "QATEST1",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 1",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		var staticTearDownProject = "QATEST1";
	}

	test AddProjectWithOffering {
		property lesa.acceptance = "true";

		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 5",
			city = "Augusta",
			code = "QATEST5",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 5",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		var staticTearDownProject = "QATEST5";

		OSBAdminProject.viewProjectStatus(
			projectCode = "QATEST5",
			status = "Closed");

		OSBAdminSales.addOrder(
			product = "Portal Non-Production",
			projectCode = "QATEST5",
			support = "Gold");

		var staticTearDownOrder = "QATEST5,QA Test 5";

		OSBAdminProject.viewProjectStatus(
			projectCode = "QATEST5",
			status = "Approved");
	}

	test AssignCustomer {
		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 2",
			city = "Augusta",
			code = "QATEST2",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 2",
			state = "Maine",
			zip = "04330");

		var staticTearDownProject = "QATEST2";

		OSBAdminProject.assignCustomer(
			emailAddress = "${cwatcherEmailAddress}",
			projectCode = "QATEST2",
			role = "Watcher");
	}

	test AssignWorker {
		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 3",
			city = "Augusta",
			code = "QATEST3",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 3",
			state = "Maine",
			zip = "04330");

		var staticTearDownProject = "QATEST3";

		OSBAdminProject.assignWorker(
			emailAddress = "${casEmailAddress}",
			projectCode = "QATEST3",
			role = "Advocacy Specialist");
	}

	test EditProject {
		property lesa.acceptance = "true";

		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 12",
			city = "Augusta",
			code = "QATEST12",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 12",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		var staticTearDownProject = "QATEST12";

		OSBAdminProject.gotoAccount(projectCode = "QATEST12");

		OSBAdminProject.editProject(
			additionalNotes = "This is a test for editing a project.",
			addressLine = "123 ABC Street",
			businessAccountName = "QA Test 12 Edited",
			city = "Vancouver",
			code = "QATEST12EDITED",
			country = "Canada",
			industry = "Agriculture",
			language = "Japanese",
			maxContacts = "15",
			partnerCode = "QA Test Partner",
			projectName = "QA Test 12 Edited",
			specialInstructions = "test",
			state = "Alberta",
			tier = "Strategic",
			type = "Individual",
			zip = "11111");

		var staticTearDownProject = "QATEST12EDITED";

		OSBAdminProject.viewProjectDetails(
			additionalNotes = "This is a test for editing a project.",
			addressLine = "123 ABC Street",
			businessAccountName = "QA Test 12 Edited",
			city = "Vancouver",
			code = "QATEST12EDITED",
			country = "Canada",
			industry = "Agriculture",
			language = "Japanese",
			maxContacts = "15",
			partnerCode = "QA Test Partner",
			projectCode = "QATEST12EDITED",
			projectName = "QA Test 12 Edited",
			specialInstructions = "test",
			state = "Alberta",
			tier = "Strategic",
			type = "Individual",
			zip = "11111");
	}

	test RemoveSupportLanguage {
		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 11",
			city = "Augusta",
			code = "QATEST11",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 11",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		var staticTearDownProject = "QATEST11";

		OSBAdminProject.addSupportLanguageToProject(
			projectCode = "QATEST11",
			supportLanguage = "Chinese");

		OSBAdminProject.removeSupportLanguage(
			projectCode = "QATEST11",
			supportLanguage = "Chinese");
	}

	test RemoveSupportRegion {
		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test 10",
			city = "Augusta",
			code = "QATEST10",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Test 10",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		var staticTearDownProject = "QATEST10";

		OSBAdminProject.addSupportRegionToProject(
			projectCode = "QATEST10",
			supportRegion = "Brazil");

		OSBAdminProject.removeSupportRegion(
			projectCode = "QATEST10",
			supportRegion = "Brazil");
	}

}