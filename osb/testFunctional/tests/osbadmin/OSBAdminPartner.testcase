@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	static var staticTearDownPartner = "";
	static var staticTearDownProject = "";

	setUp {
		var staticTearDownPartner = "";
		var staticTearDownProject = "";

		OSBAdminUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();
	}

	tearDown {
		if ("${staticTearDownProject}" != "") {
			OSBAdminProject.tearDownProject(projectCode = "${staticTearDownProject}");
		}

		if ("${staticTearDownPartner}" != "") {
			OSBAdminPartner.tearDownPartner(partnerCode = "${staticTearDownPartner}");
		}

		OSBAdminUser.logout();
	}

	test AddPartner {
		OSBAdminPartner.addPartner(
			additionalNotes = "This is a test.",
			city = "Diamond Bar",
			country = "United States",
			partnerCode = "QAPARTNER1",
			phoneNumber = "7145555555",
			postalCode = "91765",
			region = "California",
			streetAddress = "123 Main St.",
			supportRegion = "US");

		var staticTearDownPartner = "QAPARTNER1";
	}

	test AddPartnerManagedAccount {
		OSBAdminPartner.addPartner(
			additionalNotes = "This is a test.",
			city = "Diamond Bar",
			country = "United States",
			partnerCode = "QAPARTNER2",
			phoneNumber = "7145555555",
			postalCode = "91765",
			region = "California",
			streetAddress = "123 Main St.",
			supportRegion = "US");

		var staticTearDownPartner = "QAPARTNER2";

		OSBAdminProject.addProject(
			addressLine = "123 Main Street",
			businessAccountName = "QA Test Project 4",
			city = "Augusta",
			code = "QATEST4",
			country = "United States",
			industry = "Manufacturing",
			projectName = "QA Project 4",
			state = "Maine",
			zip = "04330");

		var staticTearDownProject = "QATEST4";

		OSBAdminPartner.addPartnerToAccount(
			partnerCode = "QAPARTNER2",
			projectCode = "QATEST4");
	}

	test RemovePartnerFromProject {
		OSBAdminPartner.addPartner(
			additionalNotes = "This is a test.",
			city = "Diamond Bar",
			country = "United States",
			partnerCode = "QAPARTNER3",
			phoneNumber = "7145555555",
			postalCode = "91765",
			region = "California",
			streetAddress = "123 Main St.",
			supportRegion = "US");

		var staticTearDownPartner = "QAPARTNER3";

		OSBAdminProject.addProject(
			addressLine = "123 Main Street",
			businessAccountName = "QA Test Project 9",
			city = "Augusta",
			code = "QATEST9",
			country = "United States",
			industry = "Manufacturing",
			projectName = "QA Project 9",
			state = "Maine",
			zip = "04330");

		var staticTearDownProject = "QATEST9";

		OSBAdminPartner.addPartnerToAccount(
			partnerCode = "QAPARTNER3",
			projectCode = "QATEST9");

		OSBAdminPartner.inactivatePartnerAccount(partnerCode = "QAPARTNER3");

		OSBAdminPartner.removePartnerFromProject(projectCode = "QATEST9");
	}

}