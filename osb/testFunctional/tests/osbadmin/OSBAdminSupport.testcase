<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />

	<set-up>
		<execute macro="OSBAdminUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>
	</set-up>

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseNamespacedClassCommandName">
			<return name="testCaseCommandName" />
		</execute>

		<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<if>
			<equals arg1="${testCaseName}" arg2="AddAndEditSupportWorker" />
			<then>
				<execute macro="OSBAdminNavigation#gotoOSBAdminSupportTeam">
					<var name="teamName" value="Platinum Critical US" />
				</execute>

				<execute macro="OSBAdminSupport#removeWorkerFromTeam">
					<var name="email" value="lesa.qa.cse.2@liferay.com.broken" />
				</execute>
			</then>
		</if>
	</tear-down>

	<command name="AddAndDeleteSupportRegion" priority="5">
		<execute macro="OSBAdminNavigation#gotoOSBAdminSupportRegions" />

		<execute macro="OSBAdminSupport#addSupportRegion">
			<var name="description" value="for QA test" />
			<var name="name" value="US-QA" />
			<var name="timeZone" value="Pacific Standard Time" />
		</execute>

		<execute macro="OSBAdminSupport#viewSupportRegionInfo">
			<var name="description" value="for QA test" />
			<var name="name" value="US-QA" />
			<var name="timeZone" value="Pacific Standard Time" />
		</execute>

		<execute macro="OSBAdminSupport#deleteSupportRegion">
			<var name="name" value="US-QA" />
		</execute>
	</command>

	<command name="AddAndEditSupportWorker" priority="5">
		<execute macro="OSBAdminNavigation#gotoOSBAdminSupportTeam">
			<var name="teamName" value="Platinum Critical US" />
		</execute>

		<execute macro="OSBAdminSupport#addWorkerToSupportTeam">
			<var name="email" value="lesa.qa.cse.2@liferay.com.broken" />
			<var name="role" value="Watcher" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdminSupportTeam">
			<var name="teamName" value="Platinum Critical US" />
		</execute>

		<execute macro="OSBAdminSupport#editWorkerRole">
			<var name="email" value="lesa.qa.cse.2@liferay.com.broken" />
			<var name="role" value="Developer" />
		</execute>
	</command>
</definition>