@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");

	setUp {
		OSBAdminUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");
	}

	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		if ("${testCaseName}" == "AddAndEditSupportWorker") {
			OSBAdminNavigation.gotoOSBAdminSupportTeam(teamName = "Platinum Critical US");

			OSBAdminSupport.removeWorkerFromTeam(email = "lesa.qa.cse.2@liferay.com.broken");
		}
	}

	@priority = "5"
	test AddAndDeleteSupportRegion {
		OSBAdminNavigation.gotoOSBAdminSupportRegions();

		OSBAdminSupport.addSupportRegion(
			description = "for QA test",
			name = "US-QA",
			timeZone = "Pacific Standard Time");

		OSBAdminSupport.viewSupportRegionInfo(
			description = "for QA test",
			name = "US-QA",
			timeZone = "Pacific Standard Time");

		OSBAdminSupport.deleteSupportRegion(name = "US-QA");
	}

	@priority = "5"
	test AddAndEditSupportWorker {
		OSBAdminNavigation.gotoOSBAdminSupportTeam(teamName = "Platinum Critical US");

		OSBAdminSupport.addWorkerToSupportTeam(
			email = "lesa.qa.cse.2@liferay.com.broken",
			role = "Watcher");

		OSBAdminNavigation.gotoOSBAdminSupportTeam(teamName = "Platinum Critical US");

		OSBAdminSupport.editWorkerRole(
			email = "lesa.qa.cse.2@liferay.com.broken",
			role = "Developer");
	}

}