@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var product = "Portal Non-Production";
	var projectCode = "QAPROJECT2";
	var projectName = "QA Test Project 2";
	var support = "Gold";
	static var staticTearDownOffering = "";
	static var staticTearDownOfferingBundle = "";
	static var staticTearDownOrder = "";

	setUp {
		var staticTearDownOffering = "";
		var staticTearDownOfferingBundle = "";
		var staticTearDownOrder = "";

		OSBAdminUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();
	}

	tearDown {
		if ("${staticTearDownOrder}" != "") {
			var projectCode = StringUtil.extractFirst("${staticTearDownOrder}", ",");
			var projectName = StringUtil.extractLast("${staticTearDownOrder}", ",");

			OSBAdminSales.tearDownOrder(
				projectCode = "${projectCode}",
				projectName = "${projectName}");
		}

		if ("${staticTearDownOffering}" != "") {
			var product = StringUtil.extractFirst("${staticTearDownOffering}", ",");
			var support = StringUtil.extractLast("${staticTearDownOffering}", ",");

			OSBAdminSales.tearDownOffering(
				description = "QA Test",
				product = "${product}",
				support = "${support}");
		}

		if ("${staticTearDownOfferingBundle}" != "") {
			OSBAdminSales.tearDownOfferingBundle(bundleName = "${staticTearDownOfferingBundle}");
		}

		OSBAdminUser.logout();
	}

	test AddOffering {
		property lesa.acceptance = "true";

		OSBAdminSales.addOffering(
			description = "QA Test",
			licenses = "yes",
			product = "Portal Non-Production",
			support = "Gold",
			supportTickets = "yes");

		var staticTearDownOffering = "${product},${support}";
	}

	test AddOrder {
		OSBAdminSales.addOrder(
			product = "${product}",
			projectCode = "${projectCode}",
			support = "${support}");

		var staticTearDownOrder = "${projectCode},${projectName}";
	}

	test AddOrderWithOfferingBundle {
		OSBAdminSales.addOfferingBundle(
			bundleName = "1AAA QA Bundle",
			offeringProductList = "Portal Production,Portal Backup,Portal Non-Production,Developer Tools,Productivity Tools (Sync)");

		var staticTearDownOfferingBundle = "1AAA QA Bundle";

		OSBAdminSales.addOrderWithOfferingBundle(
			bundleName = "1AAA QA Bundle",
			offeringProductList = "Portal Production,Portal Backup,Portal Non-Production,Developer Tools,Productivity Tools (Sync)",
			projectCode = "${projectCode}");

		var staticTearDownOrder = "${projectCode},${projectName}";
	}

	test RenewSupport {
		OSBAdminSales.addOrder(
			product = "Digital Enterprise Non-Production",
			projectCode = "${projectCode}",
			support = "${support}");

		var staticTearDownOrder = "${projectCode},${projectName}";

		OSBAdminSales.gotoOrderDetailCreatedByMe(
			project = "${projectName}",
			projectCode = "${projectCode}");

		OSBAdminSales.renewSupport(product = "Digital Enterprise Non-Production");
	}

}