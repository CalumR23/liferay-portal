definition {

	macro gotoAdminTab {
		if ("${adminTab}" == "Dashboard") {
			AssertClick(
				locator1 = "MPAdmin#DASHBOARD",
				value1 = "Dasboard");
		}
		else if ("${adminTab}" == "Apps") {
			AssertClick(
				locator1 = "MPAdmin#APPS",
				value1 = "Apps");
		}
		else if ("${adminTab}" == "Contracts") {
			AssertClick(
				locator1 = "MPAdmin#CONTRACTS",
				value1 = "Contracts");
		}
		else if ("${adminTab}" == "Customers") {
			AssertClick(
				locator1 = "MPAdmin#CUSTOMERS",
				value1 = "Customers");
		}
		else if ("${adminTab}" == "Developers") {
			AssertClick(
				locator1 = "MPAdmin#DEVELOPERS",
				value1 = "Developers");
		}
		else if ("${adminTab}" == "Lists") {
			AssertClick(
				locator1 = "MPAdmin#LISTS",
				value1 = "Lists");
		}
		else if ("${adminTab}" == "Metrics") {
			AssertClick(
				locator1 = "MPAdmin#METRICS",
				value1 = "Metrics");
		}
		else if ("${adminTab}" == "Reports") {
			AssertClick(
				locator1 = "MPAdmin#REPORTS",
				value1 = "Reports");
		}
	}

	macro gotoApp {
		var key_appTitle = "${appTitle}";

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Apps");

		MarketplaceAdminNavigator.gotoAppsTab(appsTab = "Manage");

		Type(
			locator1 = "MPAdminApps#TITLE_FIELD",
			value1 = "${appTitle}");

		MPButton.search();

		Click(
			locator1 = "MPAdminApps#APP_TITLE",
			value1 = "${appTitle}");
	}

	macro gotoAppsTab {
		if ("${appsTab}" == "Manage") {
			AssertClick(
				locator1 = "MPAdminApps#MANAGE",
				value1 = "Manage");
		}
		else if ("${appsTab}" == "Requests") {
			AssertClick(
				locator1 = "MPAdminApps#REQUESTS",
				value1 = "Requests");
		}
		else if ("${appsTab}" == "Pending QA") {
			AssertClick(
				locator1 = "MPAdminApps#PENDING_QA",
				value1 = "Pending QA");
		}
		else if ("${appsTab}" == "Denied") {
			AssertClick(
				locator1 = "MPAdminApps#DENIED",
				value1 = "Denied");
		}
		else if ("${appsTab}" == "Disabled") {
			AssertClick(
				locator1 = "MPAdminApps#DISABLED",
				value1 = "Disabled");
		}
	}

	macro gotoCustomer {
		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Customers");

		MarketplaceAdmin.lookforCustomer(
			appTitle = "${appTitle}",
			userEmailAddress = "${userEmailAddress}");
	}

	macro gotoDeveloper {
		var key_companyName = "${companyName}";

		Type(
			locator1 = "MPAdminDevelopers#KEYWORDS_FIELD",
			value1 = "${companyName}");

		Click(locator1 = "MPAdminDevelopers#SEARCH_BUTTON");

		Click(locator1 = "MPAdminDevelopers#CREATE_DATE");

		Click(locator1 = "MPAdminDevelopers#CREATE_DATE");

		Click(locator1 = "MPAdminDevelopers#NAME_LIST");
	}

	macro gotoDeveloperUser {
		var key_companyName = "${developerName}";

		Type(
			locator1 = "MPAdminDevelopers#KEYWORDS_FIELD",
			value1 = "${searchKeywords}");

		Select(
			locator1 = "MPAdminDevelopers#DEVELOPER_TYPE_SELECT",
			value1 = "${developerType}");

		Click(locator1 = "MPAdminDevelopers#SEARCH_BUTTON");

		AssertClick(
			locator1 = "MPAdminDevelopers#NAME_LIST",
			value1 = "${developerName}");
	}

	macro gotoEcommerce {
		var controlPanelURL = PropsUtil.get("portal.control.panel.url");

		Open(locator1 = "${controlPanelURL}");

		AssertClick(
			locator1 = "MPAdmin#ECOMMERCE",
			value1 = "E-commerce");
	}

	macro gotoEcommerceDocumentByID {
		Type(
			locator1 = "MPAdmin#DOCUMENT_ID_SEARCH",
			value1 = "${purchaseID}");

		MPButton.button1(buttonName = "Go");
	}

	macro gotoMPAdmin {
		var controlPanelURL = PropsUtil.get("portal.control.panel.url");

		Open(locator1 = "${controlPanelURL}");

		AssertClick(
			locator1 = "MPAdmin#MARKETPLACE_ADMIN",
			value1 = "Marketplace Admin");
	}

	macro searchDeveloper {
		var key_companyName = "${companyName}";

		Type(
			locator1 = "MPAdminDevelopers#KEYWORDS_FIELD",
			value1 = "${companyName}");

		Click(locator1 = "MPAdminDevelopers#SEARCH_BUTTON");
	}

}