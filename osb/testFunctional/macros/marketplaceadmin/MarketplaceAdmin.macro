definition {

	macro addLicense {
		AssertClick(
			locator1 = "MPAdminCustomers#ADD_LICENSE_BUTTON",
			value1 = "Add License");

		SelectWindow(locator1 = "title=Control Panel");

		Pause(locator1 = "3000");

		if ("${licenseType}" == "Standard") {
			ClickNoError(locator1 = "MPAdminCustomers#STANDARD_INSTANCE");
		}
		else if ("${licenseType}" == "Developer") {
			ClickNoError(locator1 = "MPAdminCustomers#DEVELOPER_INSTANCE");
		}
		else if ("${licenseType}" == "Trial") {
			ClickNoError(locator1 = "MPAdminCustomers#TRIAL_INSTANCE");
		}

		SelectWindow(locator1 = "title=Control Panel - Liferay.com");

		MPMessage.success();
	}

	macro approveSubmission {
		MPButton.button1(buttonName = "Approve");

		MPMessage.success();
	}

	macro completeInvoicePayment {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoEcommerce();

		MarketplaceAdminNavigator.gotoEcommerceDocumentByID(purchaseID = "${purchaseID}");

		MPButton.button1(buttonName = "Create Invoice");

		MPButton.button1(buttonName = "Paid");
	}

	macro customDenyOrApproveApp {
		MPButton.button1(buttonName = "${denyOrApprove}");

		if ("${denyOrApprove}" == "Deny App") {
			MPButton.button1(buttonName = "Deny");
		}

		MPMessage.success();
	}

	macro denySubmission {
		MPButton.button1(buttonName = "Deny");

		MPButton.button1(buttonName = "Deny");

		MPMessage.success();
	}

	macro disableCompany {
		AssertClick(
			locator1 = "MPAdminDevelopers#DISABLE_BUTTON",
			value1 = "Disable");

		AssertClick(
			locator1 = "MPAdminDevelopers#DISABLE_BUTTON",
			value1 = "Disable");

		MPMessage.success();
	}

	macro expirePaidStatus {
		Click(locator1 = "MPAdminDevelopers#EDIT_DEVELOPER_REGISTRATION");

		Type(
			locator1 = "MPAdminDevelopers#DOMAIN_NAME",
			value1 = "www.google.com");

		Select(
			locator1 = "MPAdminDevelopers#SUBSCRIPTION_EXPIRATION_DATE_YEAR",
			value1 = "2014");

		Click(locator1 = "MPButton#SAVE_BUTTON");

		MPMessage.success();
	}

	macro inputDossieraAccountKey {
		if (!(isSet(inputDossieraAccountKey))) {
			var dossieraAccountKey = StringUtil.randomString("18");
		}

		Type(
			locator1 = "MPAdminDevelopers#DOSSIERA_ACCOUNT_KEY_FIELD",
			value1 = "${dossieraAccountKey}");
	}

	macro lookforCustomer {
		var key_appTitle = "${appTitle}";

		Type(
			locator1 = "MPAdminCustomers#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		AssertClick(
			locator1 = "MPAdminCustomers#LOOKUP_BUTTON",
			value1 = "Lookup");

		AssertClick(
			locator1 = "MPAdminCustomers#APP_ENTRY_NAME",
			value1 = "${appTitle}");
	}

	macro reviewAppStatus {
		MarketplaceAdminNavigator.gotoApp(appTitle = "${appTitle}");

		AssertTextEquals(
			locator1 = "MPAdminReviewApps#STATUS_BAR",
			value1 = "${appStatus}");
	}

	macro setupAppApprove {
		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdmin.workflowSubmittedApp(
			appTitle = "${appTitle}",
			pendingQADenyOrApprove = "Approve",
			requestDenyOrSendToQA = "Send to Manual and Auto QA");
	}

	macro teardownApp {
		MarketplaceAdminNavigator.gotoApp(appTitle = "${appTitle}");

		var status = selenium.getText("MPAdminReviewApps#STATUS_BAR");

		if (contains("${status}", "Approved")) {
			MPButton.button1(buttonName = "Reject App");

			MPButton.button1(buttonName = "Deny");
		}
	}

	macro teardownCompany {
		MarketplaceAdminNavigator.searchDeveloper(companyName = "${companyName}");

		while (IsElementPresent(locator1 = "MPAdminDevelopers#STATUS_APPROVED")) {
			Click(locator1 = "MPAdminDevelopers#STATUS_APPROVED");

			MarketplaceAdmin.disableCompany();

			MarketplaceAdminNavigator.searchDeveloper(companyName = "${companyName}");
		}

		while (IsElementPresent(locator1 = "MPAdminDevelopers#STATUS_PENDING")) {
			Click(locator1 = "MPAdminDevelopers#STATUS_PENDING");

			MarketplaceAdmin.denySubmission();

			MarketplaceAdminNavigator.searchDeveloper(companyName = "${companyName}");
		}

		while (IsElementPresent(locator1 = "MPAdminDevelopers#STATUS_DENIED")) {
			Click(locator1 = "MPAdminDevelopers#STATUS_DENIED");

			MarketplaceAdmin.disableCompany();

			MarketplaceAdminNavigator.searchDeveloper(companyName = "${companyName}");
		}
	}

	macro tearDownPaidRegistration {
		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloperUser(
			developerName = "${developerName}",
			developerType = "${developerType}",
			searchKeywords = "${searchKeywords}");

		Click(locator1 = "MPAdminDevelopers#EDIT_DEVELOPER_REGISTRATION");

		Select(
			locator1 = "MPAdminDevelopers#DOMAIN_STATUS",
			value1 = "Expired");

		Select(
			locator1 = "MPAdminDevelopers#SUBSCRIPTION_STATUS",
			value1 = "Draft");

		Click(locator1 = "MPAdminDevelopers#SAVE_BUTTON");
	}

	macro workflowCompanyApprove {
		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyName}");

		MarketplaceAdmin.inputDossieraAccountKey(dossieraAccountKey = "${dossieraAccountKey}");

		MarketplaceAdmin.approveSubmission();
	}

	macro workflowCompanyApproveThenDisable {
		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyName}");

		MarketplaceAdmin.inputDossieraAccountKey(dossieraAccountKey = "${dossieraAccountKey}");

		MarketplaceAdmin.approveSubmission();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyName}");

		MarketplaceAdmin.disableCompany();
	}

	macro workflowSubmittedApp {
		MarketplaceAdminNavigator.gotoApp(appTitle = "${appTitle}");

		if (IsElementPresent(locator1 = "MPAdminReviewApps#REVIEW_DEVELOPER_PAGE")) {
			AssertClick(
				locator1 = "MPAdminReviewApps#REVIEW_DEVELOPER_PAGE",
				value1 = "Review Developer page");

			AssertClick(
				locator1 = "MPAdminDevelopers#APPROVE_PAID_DEVELOPER_STATUS_BUTTON",
				value1 = "Approve Paid Developer Status");

			MPMessage.success();
		}

		MarketplaceAdmin.customDenyOrApproveApp(denyOrApprove = "${requestDenyOrSendToQA}");

		if ("${requestDenyOrSendToQA}" == "Send to Manual and Auto QA") {
			MarketplaceAdminNavigator.gotoApp(appTitle = "${appTitle}");

			MarketplaceAdmin.customDenyOrApproveApp(denyOrApprove = "${pendingQADenyOrApprove}");
		}
	}

}