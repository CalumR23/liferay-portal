definition {

	var loginURL = PropsUtil.get("portal.login.url");
	var logoutURL = PropsUtil.get("portal.logout.url");
	var marketplaceURL = PropsUtil.get("portal.marketplace.url");

	macro login {
		Open(locator1 = "${loginURL}");

		Type(
			locator1 = "MPLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "MPLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "MPLogin#SIGN_IN_BUTTON");

		AssertElementPresent(locator1 = "MPLogin#LOGGED_IN_AS_CONFIRMATION");

		Open(locator1 = "${marketplaceURL}");
	}

	macro logout {
		Open(locator1 = "${logoutURL}");

		Open(locator1 = "${marketplaceURL}");
	}

	macro logoutAndLogin {
		MPUser.logout();

		MPUser.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

}