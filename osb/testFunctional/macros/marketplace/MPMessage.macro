definition {

	macro marketplaceUnavailable {
		AssertTextEquals(
			locator1 = "MPMessage#FAIL_MESSAGE",
			value1 = "Marketplace is temporarily unavailable.");
	}

	macro portletUnavailable {
		AssertTextEquals(
			locator1 = "MPMessage#FAIL_MESSAGE",
			value1 = "Portlet is temporarily unavailable.");
	}

	macro requestFailed {
		AssertTextEquals(
			locator1 = "MPMessage#FAIL_MESSAGE",
			value1 = "Your request failed to complete.");
	}

	macro success {
		AssertTextEquals(
			locator1 = "MPMessage#SUCCESS_MESSAGE",
			value1 = "Your request completed successfully.");
	}

}