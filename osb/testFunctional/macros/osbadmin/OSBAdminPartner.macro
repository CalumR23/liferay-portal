<definition>
	<command name="addPartner">
		<execute function="AssertClick" locator1="OSBAdmin#PARTNERS_TAB" value1="Partners" />
		<execute function="Click" locator1="OSBAdmin#ADD_PARTNER_BUTTON" />

		<execute function="Type" locator1="OSBAdminPartnerAdd#CODE_FIELD" value1="${partnerCode}" />

		<if>
			<isset var="additionalNotes" />
			<then>
				<execute function="Type" locator1="OSBAdminPartnerAdd#ADDITIONAL_NOTES_FIELD" value1="${additionalNotes}" />
			</then>
		</if>

		<if>
			<isset var="supportRegion" />
			<then>
				<execute function="Select" locator1="OSBAdminPartnerAdd#SUPPORT_REGION_SELECT" value1="${supportRegion}" />
			</then>
		</if>

		<if>
			<isset var="phoneNumber" />
			<then>
				<execute function="Type" locator1="OSBAdminPartnerAdd#PHONE_NUMBER_FIELD" value1="${phoneNumber}" />
			</then>
		</if>

		<if>
			<isset var="streetAddress" />
			<then>
				<execute function="Type" locator1="OSBAdminPartnerAdd#STREET_1_FIELD" value1="${streetAddress}" />
			</then>
		</if>

		<if>
			<isset var="country" />
			<then>
				<execute function="Select" locator1="OSBAdminPartnerAdd#COUNTRY_SELECT" value1="${country}" />
			</then>
		</if>

		<if>
			<isset var="region" />
			<then>
				<execute function="Select" locator1="OSBAdminPartnerAdd#REGION_SELECT" value1="${region}" />
			</then>
		</if>

		<if>
			<isset var="postalCode" />
			<then>
				<execute function="Type" locator1="OSBAdminPartnerAdd#POSTAL_CODE_FIELD" value1="${postalCode}" />
			</then>
		</if>

		<if>
			<isset var="city" />
			<then>
				<execute function="Type" locator1="OSBAdminPartnerAdd#CITY_FIELD" value1="${city}" />
			</then>
		</if>

		<execute macro="OSBAdminButton#save" />

		<execute macro="OSBAdminMessage#success" />
	</command>

	<command name="assignWorker">
		<execute macro="OSBAdminSearch#searchBasicPartner">
			<var name="partnerCode" value="${partnerCode}" />
		</execute>

		<var name="key_code" value="${partnerCode}" />

		<execute function="Click" locator1="OSBAdmin#SEARCH_RESULT_CODE" />

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_WORKERS_BUTTON" />

		<execute macro="OSBAdminProject#assignUser">
			<var name="emailAddress" value="${emailAddress}" />
			<var name="role" value="${role}" />
		</execute>
	</command>

	<command name="addPartnerToAccount">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminProject#editPartner">
			<var name="partnerCode" value="${partnerCode}" />
		</execute>

		<execute function="AssertTextEquals" locator1="OSBAdminAccount#SELECTED_PARTNER" value1="${partnerCode}" />

		<execute function="Click" locator1="OSBAdminAccount#PARTNER_MANAGED_SUPPORT_CHECKBOX" />

		<execute macro="OSBAdminButton#save" />

		<execute macro="OSBAdminMessage#success" />
	</command>

	<command name="inactivatePartnerAccount">
		<execute macro="OSBAdminSearch#searchBasicPartner">
			<var name="partnerCode" value="${partnerCode}" />
		</execute>

		<var name="key_code" value="${partnerCode}" />

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_CODE" value1="${partnerCode}" />

		<execute function="Select" locator1="OSBAdminPartnerAdd#STATUS_SELECT" value1="Inactive" />

		<execute macro="OSBAdminButton#save" />

		<execute macro="OSBAdminMessage#success" />
	</command>

	<command name="removePartnerFromProject">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_CODE" value1="${projectCode}" />

		<execute function="Click" locator1="OSBAdminAccountAdd#PARTNER_REMOVE_BUTTON" />

		<execute macro="OSBAdminButton#save" />

		<execute macro="OSBAdminMessage#success" />
	</command>

	<command name="tearDownPartner">
		<execute macro="OSBAdminSearch#searchBasicPartner">
			<var name="partnerCode" value="${partnerCode}" />
		</execute>

		<execute macro="OSBAdminSearch#tearDownSearchResultRow">
			<var name="code" value="${partnerCode}" />
		</execute>
	</command>
</definition>