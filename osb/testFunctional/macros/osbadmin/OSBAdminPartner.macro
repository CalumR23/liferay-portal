definition {

	macro addPartner {
		AssertClick(
			locator1 = "OSBAdmin#PARTNERS_TAB",
			value1 = "Partners");

		Click(locator1 = "OSBAdmin#ADD_PARTNER_BUTTON");

		Type(
			locator1 = "OSBAdminPartnerAdd#CODE_FIELD",
			value1 = "${partnerCode}");

		if (isSet(additionalNotes)) {
			Type(
				locator1 = "OSBAdminPartnerAdd#ADDITIONAL_NOTES_FIELD",
				value1 = "${additionalNotes}");
		}

		if (isSet(supportRegion)) {
			Select(
				locator1 = "OSBAdminPartnerAdd#SUPPORT_REGION_SELECT",
				value1 = "${supportRegion}");
		}

		if (isSet(phoneNumber)) {
			Type(
				locator1 = "OSBAdminPartnerAdd#PHONE_NUMBER_FIELD",
				value1 = "${phoneNumber}");
		}

		if (isSet(streetAddress)) {
			Type(
				locator1 = "OSBAdminPartnerAdd#STREET_1_FIELD",
				value1 = "${streetAddress}");
		}

		if (isSet(country)) {
			Select(
				locator1 = "OSBAdminPartnerAdd#COUNTRY_SELECT",
				value1 = "${country}");
		}

		if (isSet(region)) {
			Select(
				locator1 = "OSBAdminPartnerAdd#REGION_SELECT",
				value1 = "${region}");
		}

		if (isSet(postalCode)) {
			Type(
				locator1 = "OSBAdminPartnerAdd#POSTAL_CODE_FIELD",
				value1 = "${postalCode}");
		}

		if (isSet(city)) {
			Type(
				locator1 = "OSBAdminPartnerAdd#CITY_FIELD",
				value1 = "${city}");
		}

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addPartnerToAccount {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		OSBAdminProject.editPartner(partnerCode = "${partnerCode}");

		AssertTextEquals(
			locator1 = "OSBAdminAccount#SELECTED_PARTNER",
			value1 = "${partnerCode}");

		Click(locator1 = "OSBAdminAccount#PARTNER_MANAGED_SUPPORT_CHECKBOX");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro assignWorker {
		OSBAdminSearch.searchBasicPartner(partnerCode = "${partnerCode}");

		var key_code = "${partnerCode}";

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");

		Click(locator1 = "OSBAdminAccount#ASSIGN_WORKERS_BUTTON");

		OSBAdminProject.assignUser(
			emailAddress = "${emailAddress}",
			role = "${role}");
	}

	macro inactivatePartnerAccount {
		OSBAdminSearch.searchBasicPartner(partnerCode = "${partnerCode}");

		var key_code = "${partnerCode}";

		AssertClick(
			locator1 = "OSBAdmin#SEARCH_RESULT_CODE",
			value1 = "${partnerCode}");

		Select(
			locator1 = "OSBAdminPartnerAdd#STATUS_SELECT",
			value1 = "Inactive");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro removePartnerFromProject {
		OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

		var key_code = "${projectCode}";

		AssertClick(
			locator1 = "OSBAdmin#SEARCH_RESULT_CODE",
			value1 = "${projectCode}");

		Click(locator1 = "OSBAdminAccountAdd#PARTNER_REMOVE_BUTTON");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro tearDownPartner {
		OSBAdminSearch.searchBasicPartner(partnerCode = "${partnerCode}");

		OSBAdminSearch.tearDownSearchResultRow(code = "${partnerCode}");
	}

}