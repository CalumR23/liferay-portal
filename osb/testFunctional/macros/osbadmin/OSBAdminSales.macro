definition {

	macro addOffering {
		OSBAdminNavigation.gotoOSBAdminSalesOfferings();

		Click(locator1 = "OSBAdminSalesOfferings#ADD_OFFERING_BUTTON");

		Select(
			locator1 = "OSBAdminSalesOfferingAdd#PRODUCT_SELECT",
			value1 = "${product}");

		Type(
			locator1 = "OSBAdminSalesOfferingAdd#PRODUCT_DESCRIPTION_FIELD",
			value1 = "${description}");

		if ("licenses" == "yes") {
			Check(locator1 = "OSBAdminSalesOfferingAdd#LICENSES_CHECKBOX");
		}

		if ("unlimitedLicenses" == "yes") {
			Check(locator1 = "OSBAdminSalesOfferingAdd#UNLIMITED_LICENSES_CHECKBOX");
		}

		Select(
			locator1 = "OSBAdminSalesOfferingAdd#SUPPORT_SELECT",
			value1 = "${support}");

		if ("supportTickets" == "yes") {
			Check(locator1 = "OSBAdminSalesOfferingAdd#SUPPORT_TICKETS_CHECKBOX");
		}

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addOfferingBundle {
		OSBAdminNavigation.gotoOSBAdminSalesOfferingBundles();

		Click(locator1 = "OSBAdminSalesOfferingBundles#ADD_OFFERING_BUNDLE_BUTTON");

		Type(
			locator1 = "OSBAdminSalesOfferingBundleAdd#NAME_FIELD",
			value1 = "${bundleName}");

		for (var product : list "${offeringProductList}") {
			Click(locator1 = "OSBAdminSalesOfferingBundleAdd#ADD_OFFERING_BUTTON");

			SelectWindow(locator1 = "Control Panel");

			Select(
				locator1 = "OSBAdminSalesOfferings#PRODUCT_SELECT",
				value1 = "${product}");

			OSBAdminButton.search();

			ClickNoError(locator1 = "OSBAdminSalesOfferings#SEARCH_RESULT_FIRST_ROW_PRODUCT");

			SelectWindow(locator1 = "null");

			var key_product = "${product}";

			AssertTextEquals(
				locator1 = "OSBAdminSalesOfferingBundleAdd#SEARCH_RESULT_PRODUCT",
				value1 = "${product}");
		}

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addOrder {
		OSBAdminNavigation.gotoOSBAdminSalesOrders();

		Click(locator1 = "OSBAdminSalesOrders#ADD_ORDER_BUTTON");

		OSBAdminSales.selectProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminSalesOrderAdd#ADD_OFFERING_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		Select(
			locator1 = "OSBAdminSalesOfferings#PRODUCT_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "OSBAdminSalesOfferings#SUPPORT_SELECT",
			value1 = "${support}");

		OSBAdminButton.search();

		ClickNoError(locator1 = "OSBAdminSalesOfferings#SEARCH_RESULT_FIRST_ROW_PRODUCT");

		SelectWindow(locator1 = "null");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addOrderWithOfferingBundle {
		OSBAdminNavigation.gotoOSBAdminSalesOrders();

		Click(locator1 = "OSBAdminSalesOrders#ADD_ORDER_BUTTON");

		OSBAdminSales.selectProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminSalesOrderAdd#ADD_OFFERING_BUNDLE_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		var key_name = "${bundleName}";

		ClickNoError(locator1 = "OSBAdminSalesOfferingBundles#SEARCH_RESULT_NAME");

		SelectWindow(locator1 = "null");

		for (var product : list "${offeringProductList}") {
			var key_product = "${product}";

			AssertTextEquals(
				locator1 = "OSBAdminSalesOfferingBundleAdd#SEARCH_RESULT_PRODUCT",
				value1 = "${product}");
		}

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro editOfferingVersion {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_VERSION_SELECT",
			value1 = "${version}");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro editSupportLifetime {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		if (isSet(numDays)) {
			var day = DateUtil.getDate("${numDays}");
			var month = DateUtil.getMonthName("${numDays}");
			var year = DateUtil.getYear("${numDays}");

			Select(
				locator1 = "OSBAdminSalesOrderDetail#RENEW_DATE_MONTH_SELECT",
				value1 = "${month}");

			Select(
				locator1 = "OSBAdminSalesOrderDetail#RENEW_DATE_DAY_SELECT",
				value1 = "${day}");

			Select(
				locator1 = "OSBAdminSalesOrderDetail#RENEW_DATE_YEAR_SELECT",
				value1 = "${year}");
		}

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro gotoOrderDetailCreatedByMe {
		OSBAdminSearch.searchAdvancedOrders(
			createdBy = "Me",
			projectCode = "${projectCode}");

		var key_project = "${project}";

		AssertClick(
			locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT",
			value1 = "${project}");
	}

	macro gotoOrderDetails {
		OSBAdminSearch.searchAdvancedOrders(projectCode = "${projectCode}");

		var key_project = "${project}";

		AssertClick(
			locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT",
			value1 = "${project}");
	}

	macro renewSupport {
		var key_product = "${product}";
		var currentEndDate = selenium.getText("OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_END_DATE");

		var currentEndMonthDay = StringUtil.extractFirst("${currentEndDate}", ",");
		var currentEndYear = StringUtil.extractLast("${currentEndDate}", " ");

		var newEndYear = ${currentEndYear} + 1;

		var newEndDate = "${currentEndMonthDay}, ${newEndYear}";

		ClickNoError(locator1 = "OSBAdminSalesOrderDetail#RENEW_SUPPORT_BUTTON");

		Confirm(value1 = "Are you sure you want to renew this order?");

		AssertTextEquals(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_END_DATE",
			value1 = "${newEndDate}");
	}

	macro selectProject {
		Click(locator1 = "OSBAdminSalesOrderAdd#PROJECT_SELECT_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");

		var key_item = "${projectCode}";

		ClickNoError(locator1 = "OSBAdminAccountAddSupport#TABLE_ROW");

		SelectWindow(locator1 = "null");
	}

	macro tearDownOffering {
		OSBAdminSearch.searchOffering(
			product = "${product}",
			support = "${support}");

		OSBAdminSearch.tearDownSearchResultRow(code = "${description}");
	}

	macro tearDownOfferingBundle {
		OSBAdminNavigation.gotoOSBAdminSalesOfferingBundles();

		OSBAdminSearch.tearDownSearchResultRow(code = "${bundleName}");
	}

	macro tearDownOrder {
		OSBAdminSales.tearDownSearchAdvancedOrders(projectCode = "${projectCode}");

		OSBAdminSearch.tearDownSearchResultRow(code = "${projectName}");
	}

	macro tearDownSearchAdvancedOrders {
		OSBAdminNavigation.gotoOSBAdminSalesOrders();

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		Click(locator1 = "OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_PROJECT_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		OSBAdminSearch.toggleSearch(searchType = "Basic");

		Type(
			locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
			value1 = "${projectCode}");

		OSBAdminButton.search();

		var key_code = "${projectCode}";

		if (IsElementPresent(locator1 = "OSBAdmin#SEARCH_RESULT_CODE")) {
			ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");
		}
		else {
			Close(locator1 = "title=Control Panel");
		}

		SelectWindow(locator1 = "null");

		Select(
			locator1 = "OSBAdminSalesOrders#CREATED_BY_SELECT",
			value1 = "Me");

		OSBAdminButton.searchAdvanced();
	}

}