definition {

	macro addComponentMessage {
		Click(locator1 = "OSBAdminConfiguration#WRENCH_ICON");

		Click(locator1 = "OSBAdminConfiguration#CONFIGURATION_DROPDOWN_ITEM");

		SelectFrame(locator1 = "OSBAdminConfiguration#CONFIGURATION_IFRAME");

		var key_tab = "Support";

		Click(locator1 = "OSBAdminConfiguration#CONFIGURATION_TAB");

		var key_tab = "Component Messages";

		Click(locator1 = "OSBAdminConfiguration#CONFIGURATION_TAB");

		Select(
			locator1 = "OSBAdminConfiguration#COMPONENT_MESSAGE_PRODUCT_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "OSBAdminConfiguration#COMPONENT_MESSAGE_COMPONENT_SELECT",
			value1 = "${component}");

		Type(
			locator1 = "OSBAdminConfiguration#COMPONENT_MESSAGE_MESSAGE_TEXTBOX",
			value1 = "${componentMessage}");

		OSBAdminButton.save();

		OSBAdminMessage.success(message = "You have successfully updated the setup.");

		Close(locator1 = "title=Control Panel");

		SelectWindow(locator1 = "null");
	}

}