<definition>
	<var method="PropsUtil#get('portal.url')" name="liferayURL" />

	<command name="login">
		<execute function="Open" locator1="${liferayURL}/group/customer" />

		<execute function="Type" locator1="OSBAdminLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="OSBAdminLogin#PASSWORD_FIELD" value1="${userPassword}" />
		<execute function="Click" locator1="OSBAdminLogin#SIGN_IN_BUTTON" />
	</command>

	<command name="logout">
		<execute function="Open" locator1="${liferayURL}/c/portal/logout" />
	</command>

	<command name="logoutAndLogin">
		<execute macro="OSBAdminUser#logout" />

		<execute macro="OSBAdminUser#login">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>
	</command>
</definition>