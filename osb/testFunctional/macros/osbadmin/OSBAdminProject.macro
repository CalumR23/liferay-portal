definition {

	macro addProject {
		AssertClick(
			locator1 = "OSBAdmin#PROJECTS_TAB",
			value1 = "Projects");

		Click(locator1 = "OSBAdmin#ADD_PROJECT_BUTTON");

		OSBAdminProject.editProject(
			additionalNotes = "${additionalNotes}",
			addressLine = "${addressLine}",
			businessAccountName = "${businessAccountName}",
			city = "${city}",
			code = "${code}",
			country = "${country}",
			industry = "${industry}",
			language = "${language}",
			maxContacts = "${maxContacts}",
			partnerCode = "${partnerCode}",
			projectName = "${projectName}",
			region = "${region}",
			specialInstructions = "${specialInstructions}",
			state = "${state}",
			tier = "${tier}",
			type = "${type}",
			zip = "${zip}");
	}

	macro addSupportLanguage {
		AssertClick(
			locator1 = "OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB",
			value1 = "Support Languages");

		Click(locator1 = "OSBAdminAccountAdd#ADD_SUPPORT_LANGUAGE_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		var key_item = "${language}";

		ClickNoError(locator1 = "OSBAdminAccountAddSupport#TABLE_ROW");

		SelectWindow(locator1 = "null");

		AssertTextEquals(
			locator1 = "OSBAdminAccountAdd#SUPPORT_RESULT_ROW",
			value1 = "${language}");
	}

	macro addSupportLanguageToProject {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		OSBAdminProject.addSupportLanguage(language = "${supportLanguage}");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addSupportRegion {
		AssertClick(
			locator1 = "OSBAdminAccountAdd#SUPPORT_REGIONS_TAB",
			value1 = "Support Regions");

		Click(locator1 = "OSBAdminAccountAdd#ADD_SUPPORT_REGION_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		var key_item = "${region}";

		ClickNoError(locator1 = "OSBAdminAccountAddSupport#TABLE_ROW");

		SelectWindow(locator1 = "null");

		AssertTextEquals(
			locator1 = "OSBAdminAccountAdd#SUPPORT_RESULT_ROW",
			value1 = "${region}");
	}

	macro addSupportRegionToProject {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		OSBAdminProject.addSupportRegion(region = "${supportRegion}");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro assignCustomer {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdminProject.assignUser(
			emailAddress = "${emailAddress}",
			role = "${role}");
	}

	macro assignUser {
		AssertClick(
			locator1 = "OSBAdminAccountUsers#AVAILABLE_TAB",
			value1 = "Available");

		OSBAdminSearch.searchBasic(keyword = "${emailAddress}");

		var key_emailAddress = "${emailAddress}";

		Check(locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX");

		Select(
			locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON");

		OSBAdminMessage.success();
	}

	macro assignWorker {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccount#ASSIGN_WORKERS_BUTTON");

		OSBAdminProject.assignUser(
			emailAddress = "${emailAddress}",
			role = "${role}");
	}

	macro deleteCustomers {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdminProject.deleteUsers();
	}

	macro deleteUsers {
		if (IsVisible(locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX")) {
			AssertClick(
				locator1 = "OSBAdminAccountUsers#CURRENT_TAB",
				value1 = "Current");

			Uncheck(locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX");

			Click(locator1 = "OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON");

			OSBAdminMessage.success();
		}
	}

	macro deleteWorkers {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccount#ASSIGN_WORKERS_BUTTON");

		OSBAdminProject.deleteUsers();
	}

	macro editPartner {
		Click(locator1 = "OSBAdminAccount#PARTNER_SELECT_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		OSBAdminSearch.searchBasic(keyword = "${partnerCode}");

		var key_code = "${partnerCode}";

		ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");

		SelectWindow(locator1 = "null");
	}

	macro editProject {
		if (isSet(projectName) && isSet(projectName)) {
			Type(
				locator1 = "OSBAdminAccountAdd#PROJECT_NAME_FIELD",
				value1 = "${projectName}");
		}

		if (isSet(code) && isSet(code)) {
			Type(
				locator1 = "OSBAdminAccountAdd#CODE_FIELD",
				value1 = "${code}");
		}

		if (isSet(type) && isSet(type)) {
			Select(
				locator1 = "OSBAdminAccountAdd#TYPE_SELECT",
				value1 = "${type}");
		}

		if (isSet(industry) && isSet(industry)) {
			Select(
				locator1 = "OSBAdminAccountAdd#INDUSTRY_SELECT",
				value1 = "${industry}");
		}

		if (isSet(partnerCode) && isSet(partnerCode)) {
			OSBAdminProject.editPartner(partnerCode = "${partnerCode}");
		}

		if (isSet(tier) && isSet(tier)) {
			Select(
				locator1 = "OSBAdminAccountAdd#TIER_SELECT",
				value1 = "${tier}");
		}

		if (isSet(maxContacts) && isSet(maxContacts)) {
			Type(
				locator1 = "OSBAdminAccountAdd#MAXIMUM_CONTACTS_FIELD",
				value1 = "${maxContacts}");
		}

		if (isSet(specialInstructions) && isSet(specialInstructions)) {
			Type(
				locator1 = "OSBAdminAccountAdd#SPECIAL_INSTRUCTIONS_FIELD",
				value1 = "${specialInstructions}");
		}

		if (isSet(additionalNotes) && isSet(additionalNotes)) {
			Type(
				locator1 = "OSBAdminAccountAdd#ADDITIONAL_NOTES_FIELD",
				value1 = "${additionalNotes}");
		}

		if (isSet(addressLine) && isSet(addressLine)) {
			Type(
				locator1 = "OSBAdminAccountAdd#ADDRESS_LINE_FIELD",
				value1 = "${addressLine}");
		}

		if (isSet(country) && isSet(country)) {
			Select(
				locator1 = "OSBAdminAccountAdd#COUNTRY_SELECT",
				value1 = "${country}");
		}

		if (isSet(state) && isSet(state)) {
			Select(
				locator1 = "OSBAdminAccountAdd#STATE_PROVINCE_SELECT",
				value1 = "${state}");
		}

		if (isSet(city) && isSet(city)) {
			Type(
				locator1 = "OSBAdminAccountAdd#CITY_FIELD",
				value1 = "${city}");
		}

		if (isSet(zip) && isSet(zip)) {
			Type(
				locator1 = "OSBAdminAccountAdd#POSTAL_CODE_FIELD",
				value1 = "${zip}");
		}

		if (isSet(region) && isSet(region)) {
			OSBAdminProject.addSupportRegion(region = "${region}");
		}
		else {
			OSBAdminProject.addSupportRegion(region = "US");
		}

		if (isSet(language) && isSet(language)) {
			OSBAdminProject.addSupportLanguage(language = "${language}");
		}
		else {
			OSBAdminProject.addSupportLanguage(language = "English");
		}

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro getClosedProject {
		OSBAdminSearch.searchAdvancedProjects(status = "Closed");

		AssertTextEquals(
			locator1 = "OSBAdmin#SEARCH_RESULT_FIRST_ROW_STATUS",
			value1 = "Closed");

		var closedProjectName = selenium.getText("OSBAdmin#SEARCH_RESULT_FIRST_ROW_PROJECT_NAME");

		return "${closedProjectName}";
	}

	macro getExpiredProject {
		OSBAdminSearch.searchAdvancedProjects(status = "Expired");

		AssertTextEquals(
			locator1 = "OSBAdmin#SEARCH_RESULT_FIRST_ROW_STATUS",
			value1 = "Expired");

		var expiredProjectName = selenium.getText("OSBAdmin#SEARCH_RESULT_FIRST_EXPIRED_PROJECT_NAME");

		return "${expiredProjectName}";
	}

	macro gotoAccount {
		OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

		var key_code = "${projectCode}";

		AssertClick(
			locator1 = "OSBAdmin#SEARCH_RESULT_CODE",
			value1 = "${projectCode}");
	}

	macro removeSupportLanguage {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB");

		var key_item = "${supportLanguage}";

		Click(locator1 = "OSBAdminAccountAdd#SUPPORT_REMOVE_BUTTON");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro removeSupportRegion {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccountAdd#SUPPORT_REGIONS_TAB");

		var key_item = "${supportRegion}";

		Click(locator1 = "OSBAdminAccountAdd#SUPPORT_REMOVE_BUTTON");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro selectCorpProject {
		Click(locator1 = "OSBAdminAccountAdd#CORP_PROJECT_SELECT_BUTTON");

		SelectWindow(locator1 = "title=Control Panel");

		Type(
			locator1 = "OSBAdminAccountCorpProject#KEYWORDS_FIELD",
			value1 = "${corpProject}");

		OSBAdminButton.search();

		var key_keyword = "${corpProject}";

		ClickNoError(locator1 = "OSBAdminAccountCorpProject#RESULT_ROW");

		SelectWindow(locator1 = "null");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro tearDownAssignedCustomer {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdminProject.tearDownAssignedUser(emailAddress = "${emailAddress}");
	}

	macro tearDownAssignedUser {
		AssertClick(
			locator1 = "OSBAdminAccountUsers#CURRENT_TAB",
			value1 = "Current");

		var key_emailAddress = "${emailAddress}";

		if (IsElementPresent(locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX")) {
			Uncheck(locator1 = "OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX");

			Click(locator1 = "OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON");

			OSBAdminMessage.success();
		}
	}

	macro tearDownProject {
		var key_code = "${projectCode}";

		OSBAdminProject.deleteCustomers(projectCode = "${projectCode}");

		OSBAdminProject.deleteWorkers(projectCode = "${projectCode}");

		OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

		AssertClick(
			locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON",
			value1 = "Actions");

		ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

		Confirm(value1 = "Are you sure you want to delete this?");

		OSBAdminMessage.success();
	}

	macro viewProjectDetails {
		OSBAdminProject.gotoAccount(projectCode = "${projectCode}");

		if (isSet(projectName) && isSet(projectName)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#PROJECT_NAME_FIELD",
				value1 = "${projectName}");
		}

		if (isSet(code) && isSet(code)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#CODE_FIELD",
				value1 = "${code}");
		}

		if (isSet(type) && isSet(type)) {
			AssertSelectedLabel(
				locator1 = "OSBAdminAccountAdd#TYPE_SELECT",
				value1 = "${type}");
		}

		if (isSet(industry) && isSet(industry)) {
			AssertSelectedLabel(
				locator1 = "OSBAdminAccountAdd#INDUSTRY_SELECT",
				value1 = "${industry}");
		}

		if (isSet(partnerCode) && isSet(partnerCode)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#PARTNER",
				value1 = "${partnerCode}");
		}

		if (isSet(tier) && isSet(tier)) {
			AssertSelectedLabel(
				locator1 = "OSBAdminAccountAdd#TIER_SELECT",
				value1 = "${tier}");
		}

		if (isSet(maxContacts) && isSet(maxContacts)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#MAXIMUM_CONTACTS_FIELD",
				value1 = "${maxContacts}");
		}

		if (isSet(specialInstructions) && isSet(specialInstructions)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#SPECIAL_INSTRUCTIONS_FIELD",
				value1 = "${specialInstructions}");
		}

		if (isSet(additionalNotes) && isSet(additionalNotes)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#ADDITIONAL_NOTES_FIELD",
				value1 = "${additionalNotes}");
		}

		if (isSet(addressLine) && isSet(addressLine)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#ADDRESS_LINE_FIELD",
				value1 = "${addressLine}");
		}

		if (isSet(country) && isSet(country)) {
			AssertSelectedLabel(
				locator1 = "OSBAdminAccountAdd#COUNTRY_SELECT",
				value1 = "${country}");
		}

		if (isSet(state) && isSet(state)) {
			AssertSelectedLabel(
				locator1 = "OSBAdminAccountAdd#STATE_PROVINCE_SELECT",
				value1 = "${state}");
		}

		if (isSet(city) && isSet(city)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#CITY_FIELD",
				value1 = "${city}");
		}

		if (isSet(zip) && isSet(zip)) {
			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#POSTAL_CODE_FIELD",
				value1 = "${zip}");
		}

		if (isSet(region) && isSet(region)) {
			var key_item = "${region}";

			AssertClick(
				locator1 = "OSBAdminAccountAdd#SUPPORT_REGIONS_TAB",
				value1 = "Support Regions");

			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#SUPPORT_RESULT_ROW",
				value1 = "${region}");
		}

		if (isSet(language) && isSet(language)) {
			var key_item = "${language}";

			AssertClick(
				locator1 = "OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB",
				value1 = "Support Languages");

			AssertTextEquals(
				locator1 = "OSBAdminAccountAdd#SUPPORT_RESULT_ROW",
				value1 = "${language}");
		}
	}

	macro viewProjectStatus {
		OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

		var key_code = "${projectCode}";

		AssertTextEquals(
			locator1 = "OSBAdmin#SEARCH_RESULT_STATUS",
			value1 = "${status}");
	}

}