<definition>
	<command name="success">
		<if>
			<isset var="message" />
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminMessage#SUCCESS_MESSAGE" value1="${message}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="OSBAdminMessage#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</else>
		</if>
	</command>
</definition>