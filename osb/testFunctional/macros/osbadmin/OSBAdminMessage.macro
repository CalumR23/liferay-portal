definition {

	macro success {
		if (isSet(message)) {
			AssertTextEquals(
				locator1 = "OSBAdminMessage#SUCCESS_MESSAGE",
				value1 = "${message}");
		}
		else {
			AssertTextEquals(
				locator1 = "OSBAdminMessage#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully.");
		}
	}

}