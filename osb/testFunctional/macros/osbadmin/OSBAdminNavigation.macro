definition {

	var customerPortalURL = "/group/customer";

	macro gotoControlPanel {
		Open(locator1 = "${customerPortalURL}");

		Click(locator1 = "OSBAdminNavigation#CUSTOMER_PORTAL_NAVIGATION_MENU");

		Click(
			locator1 = "OSBAdminNavigation#CUSTOMER_PORTAL_NAVIGATION_MENU_CONTROL_PANEL",
			value1 = "Control Panel");
	}

	macro gotoOSBAdmin {
		if (IsElementNotPresent(locator1 = "OSBAdminNavigation#OSB_ADMIN")) {
			OSBAdminNavigation.gotoControlPanel();
		}

		Click(locator1 = "OSBAdminNavigation#OSB_ADMIN");
	}

	macro gotoOSBAdminSalesOfferingBundles {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#SALES_TAB",
			value1 = "Sales");

		AssertClick(
			locator1 = "OSBAdminSales#OFFERING_BUNDLES_TAB",
			value1 = "Offering Bundles");
	}

	macro gotoOSBAdminSalesOfferings {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#SALES_TAB",
			value1 = "Sales");

		AssertClick(
			locator1 = "OSBAdminSales#OFFERINGS_TAB",
			value1 = "Offerings");
	}

	macro gotoOSBAdminSalesOrders {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#SALES_TAB",
			value1 = "Sales");

		AssertClick(
			locator1 = "OSBAdminSales#ORDERS_TAB",
			value1 = "Orders");
	}

	macro gotoOSBAdminSupport {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#SUPPORT_TAB",
			value1 = "Support");
	}

	macro gotoOSBAdminSupportRegions {
		OSBAdminNavigation.gotoOSBAdminSupport();

		AssertClick(
			locator1 = "OSBAdminSupport#SUPPORT_REGIONS_TAB",
			value1 = "Support Regions");
	}

	macro gotoOSBAdminSupportTeam {
		OSBAdminNavigation.gotoOSBAdminSupport();

		AssertClick(
			locator1 = "OSBAdminSupport#SUPPORT_TEAMS_TAB",
			value1 = "Teams");

		var flag = "true";
		var key_name = "${teamName}";

		while (("${flag}" == "true")) {
			if (IsElementPresent(locator1 = "OSBAdminSupportTeams#TABLE_ROW_NAME")) {
				Click(locator1 = "OSBAdminSupportTeams#TABLE_ROW_NAME");

				var flag = "false";
			}
			else {
				Click(locator1 = "OSBAdminSupportTeams#NEXT_LINK");
			}
		}
	}

}