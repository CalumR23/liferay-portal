<definition>
	<var name="customerPortalURL" value="/group/customer" />

	<command name="gotoControlPanel">
		<execute function="Open" locator1="${customerPortalURL}" />

		<execute function="Click" locator1="OSBAdminNavigation#CUSTOMER_PORTAL_NAVIGATION_MENU" />
		<execute function="Click" locator1="OSBAdminNavigation#CUSTOMER_PORTAL_NAVIGATION_MENU_CONTROL_PANEL" value1="Control Panel" />
	</command>

	<command name="gotoOSBAdmin">
		<if>
			<condition function="IsElementNotPresent" locator1="OSBAdminNavigation#OSB_ADMIN" />
			<then>
				<execute macro="OSBAdminNavigation#gotoControlPanel" />
			</then>
		</if>

		<execute function="Click" locator1="OSBAdminNavigation#OSB_ADMIN" />
	</command>

	<command name="gotoOSBAdminSalesOfferingBundles">
		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SALES_TAB" value1="Sales" />

		<execute function="AssertClick" locator1="OSBAdminSales#OFFERING_BUNDLES_TAB" value1="Offering Bundles" />
	</command>

	<command name="gotoOSBAdminSalesOfferings">
		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SALES_TAB" value1="Sales" />

		<execute function="AssertClick" locator1="OSBAdminSales#OFFERINGS_TAB" value1="Offerings" />
	</command>

	<command name="gotoOSBAdminSalesOrders">
		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SALES_TAB" value1="Sales" />

		<execute function="AssertClick" locator1="OSBAdminSales#ORDERS_TAB" value1="Orders" />
	</command>

	<command name="gotoOSBAdminSupport">
		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SUPPORT_TAB" value1="Support" />
	</command>

	<command name="gotoOSBAdminSupportRegions">
		<execute macro="OSBAdminNavigation#gotoOSBAdminSupport" />

		<execute function="AssertClick" locator1="OSBAdminSupport#SUPPORT_REGIONS_TAB" value1="Support Regions" />
	</command>

	<command name="gotoOSBAdminSupportTeam">
		<execute macro="OSBAdminNavigation#gotoOSBAdminSupport" />

		<execute function="AssertClick" locator1="OSBAdminSupport#SUPPORT_TEAMS_TAB" value1="Teams" />

		<var name="flag" value="true" />
		<var name="key_name" value="${teamName}" />

		<while>
			<equals arg1="${flag}" arg2="true" />
			<then>
				<if>
					<condition function="IsElementPresent" locator1="OSBAdminSupportTeams#TABLE_ROW_NAME" />
					<then>
						<execute function="Click" locator1="OSBAdminSupportTeams#TABLE_ROW_NAME" />

						<var name="flag" value="false" />
					</then>
					<else>
						<execute function="Click" locator1="OSBAdminSupportTeams#NEXT_LINK" />
					</else>
				</if>
			</then>
		</while>
	</command>
</definition>