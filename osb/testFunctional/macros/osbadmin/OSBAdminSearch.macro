definition {

	macro searchAdvancedOrders {
		OSBAdminNavigation.gotoOSBAdminSalesOrders();

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		if (isSet(projectCode)) {
			Click(locator1 = "OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_PROJECT_BUTTON");

			SelectWindow(locator1 = "title=Control Panel");

			OSBAdminSearch.toggleSearch(searchType = "Basic");

			Type(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "${projectCode}");

			OSBAdminButton.search();

			var key_code = "${projectCode}";

			ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");
		}

		SelectWindow(locator1 = "null");

		if (isSet(createdBy)) {
			Select(
				locator1 = "OSBAdminSalesOrders#CREATED_BY_SELECT",
				value1 = "${createdBy}");
		}

		OSBAdminButton.searchAdvanced();
	}

	macro searchAdvancedProjects {
		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		if (isSet(support)) {
			Select(
				locator1 = "OSBAdmin#ADVANCED_SEARCH_SUPPORT_SELECT",
				value1 = "${support}");
		}

		if (isSet(hasExpiredSupport)) {
			Select(
				locator1 = "OSBAdmin#ADVANCED_SEARCH_HAS_EXPIRED_SUPPORT_SELECT",
				value1 = "${hasExpiredSupport}");
		}

		if (isSet(status)) {
			Select(
				locator1 = "OSBAdmin#ADVANCED_SEARCH_STATUS_SELECT",
				value1 = "${status}");
		}

		OSBAdminButton.searchAdvanced();
	}

	macro searchBasic {
		OSBAdminSearch.toggleSearch(searchType = "Basic");

		Type(
			locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
			value1 = "${keyword}");

		OSBAdminButton.search();
	}

	macro searchBasicPartner {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#PARTNERS_TAB",
			value1 = "Partners");

		OSBAdminSearch.searchBasic(keyword = "${partnerCode}");
	}

	macro searchBasicProject {
		OSBAdminNavigation.gotoOSBAdmin();

		AssertClick(
			locator1 = "OSBAdmin#PROJECTS_TAB",
			value1 = "Projects");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");
	}

	macro searchOffering {
		OSBAdminNavigation.gotoOSBAdminSalesOfferings();

		Select(
			locator1 = "OSBAdminSalesOfferings#PRODUCT_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "OSBAdminSalesOfferings#SUPPORT_SELECT",
			value1 = "${support}");

		OSBAdminButton.search();
	}

	macro tearDownSearchResultRow {
		var key_code = "${code}";

		if (IsElementPresent(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON")) {
			AssertClick(
				locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON",
				value1 = "Actions");

			ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

			Confirm(value1 = "Are you sure you want to delete this?");

			OSBAdminMessage.success();
		}
	}

	macro toggleSearch {
		if ("${searchType}" == "Basic") {
			if (IsVisible(locator1 = "OSBAdmin#BASIC_SEARCH_TOGGLE")) {
				Click(locator1 = "OSBAdmin#BASIC_SEARCH_TOGGLE");
			}
		}
		else {
			if (IsVisible(locator1 = "OSBAdmin#ADVANCED_SEARCH_TOGGLE")) {
				Click(locator1 = "OSBAdmin#ADVANCED_SEARCH_TOGGLE");
			}
		}
	}

}