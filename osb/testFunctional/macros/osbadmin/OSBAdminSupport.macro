definition {

	macro addSupportRegion {
		Click(locator1 = "OSBAdminSupport#ADD_SUPPORT_REGION_BUTTON");

		Type(
			locator1 = "OSBAdminSupport#SUPPORT_REGION_NAME_FIELD",
			value1 = "${name}");

		Type(
			locator1 = "OSBAdminSupport#SUPPORT_REGION_DESCRIPTION_FIELD",
			value1 = "${description}");

		Select(
			locator1 = "OSBAdminSupport#SUPPORT_REGION_TIME_ZONE_SELECT",
			value1 = "${timeZone}");

		OSBAdminButton.save();

		OSBAdminMessage.success();
	}

	macro addWorkerToSupportTeam {
		Click(locator1 = "OSBAdminSupportTeams#ASSIGN_WORKERS_BUTTON");

		OSBAdminProject.assignUser(
			emailAddress = "${email}",
			role = "${role}");
	}

	macro deleteSupportRegion {
		var key_code = "${name}";

		AssertClick(
			locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON",
			value1 = "Actions");

		ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

		Confirm(value1 = "Are you sure you want to delete this?");
	}

	macro editWorkerRole {
		Click(locator1 = "OSBAdminSupportTeams#ASSIGN_WORKERS_BUTTON");

		var key_name = "${email}";
		var role = "${role}";

		Select(
			locator1 = "OSBAdminSupportTeams#WORKER_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "OSBAdminSupportTeams#UPDATE_ASSOCIATIONS_BUTTON");

		OSBAdminMessage.success();
	}

	macro removeWorkerFromTeam {
		Click(locator1 = "OSBAdminSupportTeams#ASSIGN_WORKERS_BUTTON");

		var key_name = "${email}";

		Uncheck(locator1 = "OSBAdminSupportTeams#WORKER_CHECKBOX");

		Click(locator1 = "OSBAdminSupportTeams#UPDATE_ASSOCIATIONS_BUTTON");

		OSBAdminMessage.success();
	}

	macro viewSupportRegionInfo {
		var key_description = "${description}";
		var key_name = "${name}";
		var key_timeZone = "${timeZone}";

		AssertTextEquals(
			locator1 = "OSBAdminSupport#TABLE_ROW_DESCRIPTION",
			value1 = "${description}");

		AssertTextEquals(
			locator1 = "OSBAdminSupport#TABLE_ROW_TIME_ZONE",
			value1 = "${timeZone}");
	}

}