<html>
<head>
<title>MPDeveloperAppsAddUpload</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperAppsAddUpload</td></tr>
</thead>

<tbody>

<!--Upload-->

<tr>
	<td>VERSION_NUMBER_FIELD</td>
	<td>//input[contains(@name,'version')]</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_NEW_FIELD</td>
	<td>//textarea[contains(.,changelog)]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_BROWSE_BUTTON</td>
	<td>//div[contains(@data-swfid,'${key_portalVersionName}')]/div[contains(@class,'lfr-upload-movie-content')]/object</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_VERSIONS_CHECKBOX</td>
	<td>//span[contains(@class,'liferay-version-checkbox')]//label[contains(.,'${key_portalVersionName}')]/../span/input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//span/span[contains(@class,'msg')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE</td>
	<td>//a[contains(@class,'action delete')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_AREA</td>
	<td>//div[contains(@class,'app-package-uploader')]/div[contains(.,'${key_portalVersionName}')]/..//div[@class='upload-area']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_ERROR</td>
	<td>//li[contains(@class,'uploading error')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>