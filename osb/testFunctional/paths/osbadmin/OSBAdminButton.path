<html>
<head>
<title>OSBAdminButton</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminButton</td></tr>
</thead>

<tbody>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[@value='Search']</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_BUTTON</td>
	<td>//div[contains(@id,'searchadvanced')]//input[@value='Search']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>