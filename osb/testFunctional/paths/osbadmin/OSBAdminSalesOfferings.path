<html>
<head>
<title>OSBAdminSalesOfferings</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminSalesOfferings</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_OFFERING_BUTTON</td>
	<td>//input[@value='Add Offering']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@name,'productEntryIds')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_SELECT</td>
	<td>//select[contains(@name,'supportResponseIds')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_FIRST_ROW_PRODUCT</td>
	<td>//td[contains(@id,'col-product_row')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_SERVERS</td>
	<td>//td[contains(@headers,'col-servers') and contains(.,'${key_servers}')]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>