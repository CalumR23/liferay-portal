<html>
<head>
<title>OSBAdminAccountUsers</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminAccountUsers</td></tr>
</thead>

<tbody>
<tr>
	<td>CURRENT_TAB</td>
	<td>//a[contains(.,'Current')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_TAB</td>
	<td>//a[contains(.,'Available')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_ASSOCIATIONS_BUTTON</td>
	<td>//input[@value='Update Associations']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SEARCH RESULT -->

<tr>
	<td>SEARCH_RESULT_ALL_ROWS_CHECKBOX</td>
	<td>//tr[contains(@class,'results-header')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_CHECKBOX</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_emailAddress}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_EMAIL_ADDRESS</td>
	<td>//tr[contains(@class,'results-row')]/td[contains(@id,'col-email-address') and contains(.,'${key_emailAddress}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ROLE_SELECT</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_emailAddress}')]//select[contains(@name,'role')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>