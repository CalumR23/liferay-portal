<html>
<head>
<title>OSBAdminSupportTeams</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminSupportTeams</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_SUPPORT_TEAM_BUTTON</td>
	<td>//input[@value='Add Support Team']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_ROW_NAME</td>
	<td>//td[contains(@id,'col-name') and contains(.,'${key_name}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//a[@class='next']</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_WORKERS_BUTTON</td>
	<td>//input[@value='Assign Workers']</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_ASSOCIATIONS_BUTTON</td>
	<td>//input[@value='Update Associations']</td>
	<td></td>
</tr>
<tr>
	<td>WORKER_ROLE_SELECT</td>
	<td>//tr[contains(.,'${key_name}')]/td[contains(@class,'col-role')]/select</td>
	<td></td>
</tr>
<tr>
	<td>WORKER_CHECKBOX</td>
	<td>//tr[contains(.,'${key_name}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>