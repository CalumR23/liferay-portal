definition {

	macro createNewSecret {
		Default.WaitForElementPresent(
			key_headerTitle = "Create new",
			locator1 = "Utils#HEADER_TITLE");

		Default.Type(
			key_inputField = "name",
			locator1 = "Secrets#SECRETS_INPUT_FIELD",
			value1 = "${name}");

		Default.Type(
			key_inputField = "description",
			locator1 = "Secrets#SECRETS_INPUT_FIELD",
			value1 = "${description}");

		Default.Type(
			key_inputField = "value",
			locator1 = "Secrets#SECRETS_INPUT_FIELD",
			value1 = "${value}");

		if (isSet(canViewSecrets)) {
			for (var role : list "${canViewSecrets}") {
				Default.Click(
					key_userRole = "${role}",
					locator1 = "Secrets#CAN_VIEW_SECRETS_CHECKBOX");
			}
		}

		Default.Type(
			key_inputField = "Enter key",
			locator1 = "Secrets#SECRETS_INPUT_FIELD",
			value1 = "${keyName}");

		for (var checkbox : list "restart,stop receiving requests,behave differently") {
			Default.Check.toggleSwitch(
				key_stackItem = "${checkbox}",
				locator1 = "Secrets#CREATE_SECRET_CONFIRM_CHECKBOX");
		}

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro deleteSecret {
		for (var checkbox : list "restart,stop receiving requests,behave differently") {
			Default.Check.toggleSwitch(
				key_stackItem = "${checkbox}",
				locator1 = "Secrets#CREATE_SECRET_CONFIRM_CHECKBOX");
		}

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro useSecretInService {
		for (var services : list "${service}") {
			Default.Type(
				key_inputType = "text",
				key_serviceName = "${services}",
				locator1 = "Secrets#SERVICE_INPUT_FIELD",
				value1 = "${keyValue}");
		}

		for (var checkbox : list "restart,stop receiving requests,behave differently") {
			Default.Check.toggleSwitch(
				key_checkboxName = "${checkbox}",
				locator1 = "Utils#ANY_CHECKBOX");
		}
	}

}