definition {

	macro fetchInvitationToken {
		var remoteURL = Utils.getRemote();

		var curl = '''
            https://mailhog.${remoteURL}/api/v2/search?kind=to\&query=${email} \
			-H "accept: application/json" \
			-H "Content-Type: application/json"
        ''';

		var response = JSONCurlUtil.get("${curl}", "$.items[:1].Content.Body");

		var invitationToken = RegexUtil.replace("${response}", "(?<=invitationToken=)(?:3D)(\w*\D\w*)", "1");

		return "${invitationToken}";
	}

}