definition {

	macro changeEnvironmentAlertsFilter {
		Default.Click(
			key_filterOption = "${filterOption}",
			locator1 = "Alerts#ENVIRONMENT_ALERTS_FILTER");

		Default.Click(
			key_environmentItem = "${environmentItem}",
			locator1 = "Alerts#ALERTS_ENVIRONMENT_FILTER_DROPDOWN");
	}

	macro changeUnreadAlertsFilter {
		Default.Click(
			key_filterOption = "${filterOption}",
			locator1 = "Alerts#UNREAD_ALERTS_FILTER");

		Default.Click(
			key_dropdownItem = "${dropdownItem}",
			locator1 = "Alerts#ALERTS_FILTER_DROPDOWN");
	}

	macro clickAlertIcon {
		Default.Click(locator1 = "Alerts#ALERTS_ICON");
	}

	macro clickDocsLink {
		Default.Click(locator1 = "Alerts#DOCUMENTATION_LINK");
	}

}