definition {

	macro checkServiceReadyStatus {
		var tries = "0";
		var maxTries = "${maxTries}";
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = "${projectID}";
		var serviceID = "${serviceID}";

		while (("${tries}" != "${maxTries}") && ("${readyStatus}" != "true")) {
			var curl = '''
    			https://${baseURL}/projects/${projectID}/services/${serviceID} \
	    		-u ${user}:${password} \
    		''';

			var readyStatus = JSONCurlUtil.get("${curl}", "$['ready']");

			if ("${readyStatus}" != "true") {
				echo("Status for service is ${readyStatus}. Try attempt #${tries}");

				var tries = ${tries} + 1;

				Default.Pause(locator1 = "5000");
			}
			else {
				return "${readyStatus}";

				echo("Status for service is ${readyStatus}");
			}

			if ("${tries}" == "${maxTries}") {
				fail("Timed out with waiting for ${serviceID} service to be ready.");
			}
		}
	}

	macro fetchServiceStatus {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var serviceID = "${serviceID}";
		var projectID = "${projectID}";
		var serviceDomain = "${serviceDomain}";

		var curl = '''
			https://${serviceID}-${projectID}.${serviceDomain} \
			-u ${user}:${password} \
		''';

		var serviceStatus = JSONCurlUtil.get("${curl}", "$['status']");

		return "${serviceStatus}";

		echo("The service status is: ${serviceStatus}");
	}

}