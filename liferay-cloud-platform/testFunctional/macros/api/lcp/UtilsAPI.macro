definition {

	macro assertApiResponse {
		var key_response = "${response}";

		if (contains("${key_response}", "errors")) {
			fail("The API response: ${key_response}");
		}
	}

	macro getCluster {
		var baseURL = Utils.getApiBaseURL();
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");

		var curl = '''
                ${baseURL}/projects/${projectId} \
                -u ${user}:${password} \
            ''';

		var cluster = JSONCurlUtil.get("${curl}", "cluster");

		return "${cluster}";
	}

	macro getClusterLocation {
		var cluster = UtilsAPI.getCluster(projectId = "${projectId}");
		var remote = Utils.getRemote();

		if (contains("${remote}", ".coffee")) {
			if ("${cluster}" == "us-central1-c1") {
				var location = "Iowa, USA";
			}

			if ("${cluster}" == "europe-west2-c1-private") {
				var location = "London, England";
			}

			if ("${cluster}" == "us-west1-c1") {
				var location = "Oregon, USA";
			}
		}
		else if (contains("${remote}", ".sh")) {
			if ("${cluster}" == "europe-west2-c1") {
				var location = "London, England";
			}

			if ("${cluster}" == "us-west1-c1") {
				var location = "Oregon, USA";
			}
		}
		else {
			if ("${cluster}" == "europe-west2-c1-private") {
				var location = "London, England";
			}

			if ("${cluster}" == "us-west1-c1") {
				var location = "Oregon, USA";
			}

			if ("${cluster}" == "southamerica-east1-c1") {
				var location = "São Paulo, Brazil";
			}
		}

		return "${location}";
	}

	macro tearDownProjects {
		for (var projectId : list "${staticProjectIdTearDowns}") {
			ProjectsAPI.deleteProject(projectId = "${projectId}");
		}
	}

}