definition {

	var user = PropsUtil.get("test.this.lcp.test.account.user.email");
	var password = PropsUtil.get("test.this.lcp.test.account.user.password");

	macro createProject {
		var baseURL = Utils.getApiBaseURL();

		if (!(isSet(projectId))) {
			var projectId = Utils.createProjectId();
		}

		if (!(isSet(environment))) {
			var environment = "false";
		}

		if (!(isSet(cluster))) {
			var cluster = "us-west1-c1";
		}

		var curl = '''
            ${baseURL}/projects \
            -u ${user}:${password} \
            -H "accept: application/json" \
            -H "Content-Type: application/json" \
            -d '{
				"projectId": "${projectId}",
				"cluster": "${cluster}",
				"environment": '${environment}'
				}'
        ''';

		var apiResponse = JSONCurlUtil.post("${curl}");

		UtilsAPI.assertApiResponse(response = "${apiResponse}");

		if ("${environment}" == "false") {
			ListUtil.add("${staticProjectIdTearDowns}", "${projectId}");
		}

		return "${projectId}";
	}

	macro deleteProject {
		var baseURL = Utils.getApiBaseURL();

		var curl = '''
                ${baseURL}/projects/${projectId} \
                -u ${user}:${password} \
            ''';

		var apiResponse = JSONCurlUtil.delete("${curl}");

		UtilsAPI.assertApiResponse(response = "${apiResponse}");
	}

	macro fetchProjectUid {
		var baseURL = Utils.getApiBaseURL();

		var curl = '''
            ${baseURL}/projects/${projectId} \
			-H "accept: application/json" \
			-H "Content-Type: application/json"
        ''';

		var projectUid = JSONCurlUtil.get("${curl}", "$['id']");

		UtilsAPI.assertApiResponse(response = "Failed to fetch projectUid.\n${apiResponse}");

		return "${projectUid}";
	}

}