definition {

	macro acceptInvitation {
		var baseURL = Utils.getApiBaseURL();
		var token = MailhogAPI.fetchInvitationToken(email = "${email}");
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var curl = '''
            ${baseURL}/projects/${projectId}/invite?email=${email}\&invitationToken=${token} \
			-H "accept: application/json" \
			-H "Content-Type: application/json"
        ''';

		var apiResponse = JSONCurlUtil.get("${curl}");

		UtilsAPI.assertApiResponse(response = "Failed to accept invitation.\n${apiResponse}");
	}

	macro addTeamMember {
		InvitationAPI.sendInvitation(
			email = "${email}",
			projectId = "${projectId}",
			role = "${role}");

		InvitationAPI.acceptInvitation(
			email = "${email}",
			projectId = "${projectId}");
	}

	macro sendInvitation {
		var baseURL = Utils.getApiBaseURL();
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");

		var curl = '''
            ${baseURL}/projects/${projectId}/invite \
            -u ${user}:${password} \
            -H "accept: application/json" \
            -H "Content-Type: application/json" \
            -d '{
                "email": "${email}",
                "role": "${role}"
            }'
        ''';

		var apiResponse = JSONCurlUtil.post("${curl}");

		UtilsAPI.assertApiResponse(response = "${apiResponse}");
	}

}