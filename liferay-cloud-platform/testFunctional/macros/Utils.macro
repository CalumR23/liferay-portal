definition {

	var portalURL = PropsUtil.get("portal.url");

	macro assertApiResponse {
		var key_response = "${response}";

		if (contains("${key_response}", "errors")) {
			fail("The API response: ${key_response}");
		}
	}

	macro checkServiceReadyStatus {
		var tries = "0";
		var maxTries = "${maxTries}";
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = "${projectID}";
		var serviceID = "${serviceID}";

		while (("${tries}" != "${maxTries}") && ("${readyStatus}" != "true")) {
			var curl = '''
    			https://${baseURL}/projects/${projectID}/services/${serviceID} \
	    		-u ${user}:${password} \
    		''';

			var readyStatus = JSONCurlUtil.get("${curl}", "$['ready']");

			if ("${readyStatus}" != "true") {
				echo("Status for service is ${readyStatus}. Try attempt #${tries}");

				var tries = ${tries} + 1;

				Default.Pause(locator1 = "5000");
			}
			else {
				return "${readyStatus}";

				echo("Status for service is ${readyStatus}");
			}

			if ("${tries}" == "${maxTries}") {
				fail("Timed out with waiting for ${serviceID} service to be ready.");
			}
		}
	}

	macro fetchServiceStatus {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var serviceID = "${serviceID}";
		var projectID = "${projectID}";
		var serviceDomain = "${serviceDomain}";

		var curl = '''
			https://${serviceID}-${projectID}.${serviceDomain} \
			-u ${user}:${password} \
		''';

		var serviceStatus = JSONCurlUtil.get("${curl}", "$['status']");

		return "${serviceStatus}";

		echo("The service status is: ${serviceStatus}");
	}

	macro goToPage {
		var keyPage = "${page}";

		Default.Open(locator1 = "${portalURL}${keyPage}");
	}

	macro launchLCP {
		Default.Open(locator1 = "${portalURL}");
	}

	macro selectMenuOption {
		Default.Click(locator1 = "Utils#GENERIC_DROPDOWN");

		Default.Click(
			key_menuOption = "${menuOption}",
			locator1 = "Utils#ANY_MENU_OPTION");
	}

	macro switchWindow {
		Default.SelectWindow(locator1 = "title=${windowTitle} — Liferay Learn");

		Default.AssertElementPresent(
			key_headerTitle = "${windowTitle}",
			locator1 = "Utils#HEADER_TITLE");
	}

	macro tearDownProjects {
		Utils.goToPage(page = "projects");

		Default.WaitForElementPresent(
			key_headerTitle = "Projects",
			locator1 = "Utils#HEADER_TITLE");

		while (Default.IsElementPresent(locator1 = "Projects#PROJECT_NAME_NOT_PERSISTENT")) {
			var environmentName = selenium.getAttribute("Projects#PROJECT_NAME_VALUE");

			var deleteEnvironmentURL = StringUtil.replace("${environmentName}", "overview", "settings");

			Default.Open(locator1 = "${deleteEnvironmentURL}");

			SettingsPage.deleteEnvironment();

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}