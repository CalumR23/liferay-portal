definition {
	var portalURL = PropsUtil.get("portal.url");

	macro goToPage {
		var keyPage = "${page}";

		Open(locator1 = "${portalURL}${keyPage}");
	}

	macro launchLCP {
		Default.Open(locator1 = "${portalURL}");
	}

	macro selectMenuOption {
		Default.Click(locator1 = "LCPUtils#GENERIC_DROPDOWN");

		Default.Click(
			key_menuOption = "${menuOption}",
			locator1 = "LCPUtils#ANY_MENU_OPTION");
	}

	macro tearDownProjects {
		var key_environment = "poshitest";

		while (Default.IsElementPresent(locator1 = "LCPProjects#PROJECT_NAME")) {
			Default.Click(locator1 = "LCPProjects#PROJECT_NAME");

			LCPSettingsPage.deleteEnvironment();
	}

}