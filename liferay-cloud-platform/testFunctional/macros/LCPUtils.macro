definition {

	macro goToPage {
		var lcpURL = PropsUtil.get("lcp.url");
		var keyPage = "${page}";

		Open(locator1 = "${lcpURL}${keyPage}");
	}

	macro launchLCP {
		var lcpURL = PropsUtil.get("lcp.url");

		Default.Open(locator1 = "${lcpURL}");
	}

	macro selectMenuOption {
		Default.Click(locator1 = "LCPUtils#GENERIC_DROPDOWN");

		Default.Click(
			key_menuOption = "${menuOption}",
			locator1 = "LCPUtils#ANY_MENU_OPTION");
	}

}