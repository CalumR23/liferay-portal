definition {

	macro createProject {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = "${projectID}";

		var curl = '''
            https://${baseURL}/projects \
            -u ${user}:${password} \
            -H "accept: application/json" \
            -H "Content-Type: application/json" \
            -d '{
                "projectId": "${projectID}",
                "cluster": "us-west1-c1"
                }'
        ''';

		var createProject = JSONCurlUtil.post("${curl}");

		UtilsAPI.assertApiResponse(response = "${apiResponse}");
	}

}