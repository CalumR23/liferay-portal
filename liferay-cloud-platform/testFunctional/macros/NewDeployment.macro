definition {

	macro deployFromRepo {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");
		var baseURL = PropsUtil.get("test.this.lcp.test.base.url.api");
		var projectID = "${projectID}";
		var qaExamplesRepo = "https://github.com/LiferayCloud/qa-examples/tree/master";

		var curl = '''
            https://${baseURL}/projects/${projectID}/build \
            -u ${user}:${password} \
            -H "Content-Type: application/json" \
            -d '{
                "provider": "github",
				"repository": "${qaExamplesRepo}/${repo}",
				"deploy": true
                }'
        ''';

		var apiResponse = JSONCurlUtil.post("${curl}");

		Utils.assertApiResponse(response = "${apiResponse}");
	}

}