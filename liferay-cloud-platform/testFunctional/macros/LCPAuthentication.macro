definition {

	macro login {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");

		Default.Type(
			key_inputId = "email",
			locator1 = "LCPUtils#GENERIC_INPUT_FIELD",
			value1 = "${user}");

		Default.Type(
			key_inputId = "password",
			locator1 = "LCPUtils#GENERIC_INPUT_FIELD",
			value1 = "${password}");

		Default.Click(locator1 = "LCPUtils#SUBMIT_BUTTON");
	}

	macro logout {
		Default.Click(locator1 = "LCPUtils#USER_AVATAR_PORTRAIT");

		Default.Click(
			key_item = "Log Out",
			locator1 = "LCPUtils#USER_AVATAR_DROPDOWN_ANY_ITEM");
	}

}