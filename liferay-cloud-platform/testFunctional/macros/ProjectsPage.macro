definition {

	macro createNewProject {
		if (!(isSet(projectName))) {
			var projectName = "poshitest";
		}

		if (!(isSet(location))) {
			var location = "Oregon, USA";
		}

		Utils.goToPage(page = "projects/new-project");

		Default.Type(
			key_inputId = "projectId",
			locator1 = "Utils#GENERIC_INPUT_FIELD",
			value1 = "${projectName}");

		Utils.selectMenuOption(menuOption = "${location}");

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro openEnvironment {
		Default.Click(
			key_environment = "${environmentName}",
			locator1 = "Projects#PROJECT_NAME");
	}

}