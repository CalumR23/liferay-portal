definition {

	macro createNewProject {
		if (!(isSet(projectName))) {
			var projectName = "poshitest";
		}

		if (!(isSet(location))) {
			var location = "Oregon, USA";
		}

		Default.Open(locator1 = "https://console.liferay.coffee/projects/new-project");

		Default.Type(
			key_inputId = "projectId",
			locator1 = "LCPUtils#GENERIC_INPUT_FIELD",
			value1 = "${projectName}");

		LCPUtils.selectMenuOption(menuOption = "${location}");

		Default.Click(locator1 = "LCPUtils#SUBMIT_BUTTON");
	}

}