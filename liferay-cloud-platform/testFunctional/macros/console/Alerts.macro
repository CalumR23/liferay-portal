definition {

	macro assertAlertDuration {
		Default.AssertElementPresent(
			key_alertDuration = "${alertDuration}",
			key_messageRow = "${messageRow}",
			locator1 = "Alerts#ALERTS_DURATION");
	}

	macro assertAlertMessage {
		Default.AssertElementPresent(
			key_alertMessage = "${alertMessage}",
			key_messageRow = "${messageRow}",
			locator1 = "Alerts#ALERTS_MESSAGE");
	}

	macro assertAlertStatus {
		Default.AssertElementPresent(
			key_alertStatus = "${alertStatus}",
			key_messageRow = "${messageRow}",
			locator1 = "Alerts#ALERTS_STATUS");
	}

	macro clickAlertIcon {
		Default.Click(locator1 = "Alerts#ALERTS_ICON");
	}

	macro clickAlertsPreferencesIcon {
		Default.Click.javaScriptClick(locator1 = "Alerts#ALERTS_PREFERENCES_ICON");
	}

	macro clickDocsLink {
		Default.Click(locator1 = "Utils#LEARN_MORE_LINK");
	}

	macro selectAlertsFilter {
		Default.Click(
			key_filterOption = "${filterOption}",
			locator1 = "Alerts#ALERTS_FILTER");

		Default.Click(
			key_dropdownItem = "${dropdownItem}",
			locator1 = "Alerts#ALERTS_FILTER_DROPDOWN");
	}

}