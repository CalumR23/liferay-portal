definition {

	macro login {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.user.password");

		Default.Type(
			key_inputId = "email",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${user}");

		Default.Type(
			key_inputId = "password",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${password}");

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro loginAsGuest {
		var user = PropsUtil.get("test.this.lcp.test.account.guest.user.email");
		var password = PropsUtil.get("test.this.lcp.test.account.guest.user.password");

		Default.Type(
			key_inputId = "email",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${user}");

		Default.Type(
			key_inputId = "password",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${password}");

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro logout {
		Default.Click(locator1 = "Topbar#USER_AVATAR_PORTRAIT");

		Default.Click(
			key_item = "Log Out",
			locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");
	}

}