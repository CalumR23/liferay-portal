definition {

	macro addNewEnvironment {
		Default.Click(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

		Default.Click(
			key_menuOption = "Add new environment",
			locator1 = "Utils#MENU_OPTION");

		Default.Type(
			key_inputId = "environmentId",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${environmentType}");

		Utils.selectMenuOption(menuOption = "${location}");

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro countOfEnvironments {
		Default.WaitForElementPresent(
			key_headerTitle = "Projects",
			locator1 = "Utils#HEADER_TITLE");

		var environmentCount = selenium.getText("Projects#ENVIRONMENT_COUNT");

		var numberOfEnvironments = StringUtil.replace("${environmentCount}", "Environment (", "");

		var numberOfEnvironments = StringUtil.replace("${numberOfEnvironments}", ")", "");

		return "${numberOfEnvironments}";
	}

	macro createNewProject {
		if (!(isSet(projectName))) {
			var projectName = "poshitest";
		}

		if (!(isSet(location))) {
			var location = "Oregon, USA";
		}

		Utils.goToPage(page = "projects/new-project");

		Default.Type(
			key_inputId = "projectId",
			locator1 = "Utils#INPUT_FIELD",
			value1 = "${projectName}");

		Utils.selectMenuOption(menuOption = "${location}");

		Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
	}

	macro openEnvironment {
		Default.Click(
			key_environment = "${environmentName}",
			locator1 = "Projects#PROJECT_NAME");
	}

}