definition {

	macro assertBackupCardMessage {
		Default.AssertTextEquals.assertPartialText(
			locator1 = "Backups#BACKUP_CARD_STATUS_MESSAGE",
			value1 = "${backupText}");
	}

	macro assertLatestBackup {
		var projectUid = ProjectsAPI.fetchProjectUid();
		var displayDate = DateUtil.getFormattedCurrentDate("YYYYMMddHH", "GMT");
		var createdTime = DateUtil.getFormattedCurrentDate("MMM dd YYYY, h:");
		var backupName = "dxpcloud-${projectUid}-${displayDate}";

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Backups#BACKUP_HISTORY_NAME",
			value1 = "${backupName}");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Backups#BACKUP_HISTORY_TYPE",
			value1 = "${creationType}");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Backups#BACKUP_HISTORY_TIME",
			value1 = "${createdTime}");
	}

	macro backupProject {
		Default.Click(
			key_btnName = "Backup Now",
			locator1 = "Utils#CLICK_BUTTON");
	}

}