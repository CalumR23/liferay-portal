definition {

	macro getApiBaseURL {
		var remote = Utils.getRemote();

		return "https://api.${remote}";
	}

	macro getConsoleURL {
		var remote = Utils.getRemote();

		return "https://console.${remote}";
	}

	macro getRemote {
		var cloudEnv = PropsUtil.getEnvironmentVariable("CLOUD_ENVIRONMENT");
		var sandbox = PropsUtil.getEnvironmentVariable("SANDBOX");
		var remote = "";

		echo("CLOUD_ENVIRONMENT: ${cloudEnv}");

		echo("SANDBOX: ${sandbox}");

		if ("${sandbox}" != "") {
			if ("${cloudEnv}" != "sh") {
				fail("CLOUD_ENVIRONMENT must be 'sh' if SANDBOX is set");
			}

			var remote = "${sandbox}.liferay.${cloudEnv}";
		}
		else {
			var remote = "liferay.${cloudEnv}";
		}

		echo("Remote is ${remote}");

		return "${remote}";
	}

	macro goToPage {
		var keyPage = "${page}";
		var consoleURL = Utils.getConsoleURL();

		Default.Open(locator1 = "${consoleURL}/${keyPage}");
	}

	macro launchLCP {
		var consoleURL = Utils.getConsoleURL();

		echo("Console url is ${consoleURL}");

		Default.Open(locator1 = "${consoleURL}");
	}

	macro selectMenuOption {
		Default.Click(locator1 = "Utils#GENERIC_DROPDOWN");

		Default.Click(
			key_menuOption = "${menuOption}",
			locator1 = "Utils#MENU_OPTION");
	}

	macro switchWindow {
		Default.SelectWindow(locator1 = "title=${windowTitle} — Liferay Learn");

		Default.AssertElementPresent(
			key_headerTitle = "${windowTitle}",
			locator1 = "Utils#HEADER_TITLE");
	}

	macro tearDownProjects {
		Utils.goToPage(page = "projects");

		Default.WaitForElementPresent(
			key_headerTitle = "Projects",
			locator1 = "Utils#HEADER_TITLE");

		while (Default.IsElementPresent(locator1 = "Projects#PROJECT_NAME_NOT_PERSISTENT")) {
			var environmentName = selenium.getAttribute("Projects#PROJECT_NAME_VALUE");

			var deleteEnvironmentURL = StringUtil.replace("${environmentName}", "overview", "settings");

			Default.Open(locator1 = "${deleteEnvironmentURL}");

			SettingsPage.deleteEnvironment();

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}