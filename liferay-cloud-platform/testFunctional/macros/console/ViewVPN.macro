definition {

	macro connectVPN {
		if (Default.IsTextEqual(locator1 = "ViewVPN#VPN_STATUS", value1 = "Not connected")) {
			Default.Click(
				key_buttonName = "Connect",
				locator1 = "Utils#GENERIC_BUTTON");

			Default.AssertTextEquals(
				locator1 = "ViewVPN#VPN_STATUS",
				value1 = "Connected");
		}
	}

}