@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();
	}

	@description = "User can create an account via the Sign up link on the login page"
	@priority = "5"
	test CanCreate {
		task ("When: The User navigates to the Sign up page") {
			Utils.goToPage(page = "signup");
		}

		task ("And: The user fills out the form correctly") {
			Default.Type(
				key_inputId = "firstName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "QA");

			Default.Type(
				key_inputId = "lastName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "Tester");

			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "nonexistent@liferay.com");

			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "P4ssW0rd..");

			Default.Type(
				key_inputId = "confirm-password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "P4ssW0rd..");

			Default.Click(
				key_buttonName = "Create an account",
				locator1 = "Utils#GENERIC_BUTTON");
		}

		task ("Then: Account is created") {
			Default.AssertElementPresent(locator1 = "Utils#ACCOUNT_CREATION_SUCCESS_ALERT");
		}
	}

}