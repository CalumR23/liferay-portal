@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Individual member icon displays tooltip with full name and email on hover"
	@priority = "3"
	test DisplayMemberIconTooltips {
		task ("When: I hover over the member icon") {
			Default.MouseOver(
				key_environment = "projtest-infra",
				key_memberName = "Poshi Tester",
				locator1 = "Projects#ENVIRONMENT_MEMBER");
		}

		task ("Then: I can see the user's full name in the tooltip") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Poshi Tester");
		}

		task ("And: I can see the user's email in the tooltip") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "poshi.tester@liferay.cloud");
		}
	}

}