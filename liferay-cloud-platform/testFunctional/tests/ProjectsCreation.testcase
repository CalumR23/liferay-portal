@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Project is created when location and alphanumeric characters are provided for projectId"
	@priority = "5"
	test CanCreateProject {
		task ("Given: The user can view 'New Project' page") {
			Utils.goToPage(page = "projects/new-project");

			Default.AssertElementPresent(
				key_headerTitle = "New Project",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: I input alphanumeric characters in projectId and select location") {
			Default.Type(
				key_inputId = "projectId",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "poshitest");

			Utils.selectMenuOption(menuOption = "Oregon, USA");
		}

		task ("And: I click the 'Create new project' button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: The project is created") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Project was created successfully.");
		}

		task ("When: I access the Project page") {
			Utils.goToPage(page = "projects");
		}

		task ("Then: The project is shown on the page") {
			Default.AssertElementPresent(
				key_environment = "poshitest",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

	@description = "Validation message displays when projectId is absent or contains non-alphanumeric characters and when location is not selected"
	@priority = "3"
	test DisplayValidationMessages {
		task ("When: User doesn't fills out the projectId") {
			Utils.goToPage(page = "projects/new-project");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Related validation message is displayed") {
			Default.AssertTextEquals(
				key_warningMessageId = "projectIdHelp",
				locator1 = "Utils#REQUERED_PARAMETER_WARNING",
				value1 = "Enter a project ID");
		}

		task ("When: User tries to send the form with a projectId with wrong format") {
			Default.Type(
				key_inputId = "projectId",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "wrong*id");

			Utils.selectMenuOption(menuOption = "Oregon, USA");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Related validation message is displayed") {
			Default.AssertTextEquals(
				locator1 = "Utils#INVALID_ID_WARNING",
				value1 = "Project ID must only contain alphanumeric characters");
		}

		task ("When: User doesn't select a cluster") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Related validation message is displayed") {
			Default.AssertTextEquals(
				key_warningMessageId = "clusterHelp",
				locator1 = "Utils#REQUERED_PARAMETER_WARNING",
				value1 = "Please select a location");
		}

		task ("When: User tries to send the form with a projectId that already exists") {
			Default.Type(
				key_inputId = "projectId",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "projtest");

			Utils.selectMenuOption(menuOption = "Oregon, USA");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Related validation message is displayed") {
			Default.AssertTextEquals(
				key_warningMessageId = "projectIdHelp",
				locator1 = "Utils#ALREADY_EXISTING_ID_WARNING",
				value1 = "Another project with the same id already exists. Try a different one.");
		}
	}

	@description = "Project created <projectId> activity is generated on project creation"
	@priority = "5"
	test GenerateActivityForProjectCreated {
		var projectName = "poshitest";

		task ("When: User creates a new project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");
		}

		task ("Then: An activity is generated and shown in the project's activity history") {
			Utils.goToPage(page = "projects/${projectName}/activities");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE",
				value1 = "Project created");
		}
	}

	@description = "Uppercased alpbabetical characters are converted to lowercased characters"
	@priority = "5"
	test ProjectIDUppercaseToLowercase {
		task ("When: User creates a project with uppercase alphabetic characters") {
			ProjectsPage.createNewProject(projectName = "POSHITEST");
		}

		task ("Then: The characters are converted to lowercase characters") {
			Utils.goToPage(page = "projects");

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementNotPresent(
				key_environment = "POSHITEST",
				locator1 = "Projects#PROJECT_NAME");

			Default.AssertTextEquals(
				key_environment = "poshitest",
				locator1 = "Projects#PROJECT_NAME",
				value1 = "poshitest");
		}
	}

	@description = "Users without team scope cannot view the 'New Project' page"
	@priority = "5"
	test UserWithoutTeamScopeCannotCreateProject {
		task ("When: A user without team scope tries to navigate to the 'New Project' page") {
			Authentication.logout();

			Authentication.loginAsGuest();

			Utils.goToPage(page = "projects/new-project");
		}

		task ("Then: Console redirects to the Project page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}