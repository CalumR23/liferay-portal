@component-name = "liferay-cloud-platform"
definition {

	var projectName = "poshitest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();

		ProjectsPage.createNewProject(projectName = "${projectName}");
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Delete Environment button is disabled if all checkboxes are not checked"
	@priority = "5"
	test DeleteConfirmationCheckboxes {
		task ("When: User accesses the delete project page") {
			Utils.goToPage(page = "projects/${projectName}/delete-project");
		}

		task ("Then: User sees that all checkboxes are not checked") {
			for (var delete : list "access,domains,data") {
				Default.AssertNotChecked.assertNotCheckedNotVisible(
					key_checkboxName = "${delete}",
					locator1 = "Utils#ANY_CHECKBOX");
			}
		}

		task ("And: Delete Environment button is disabled") {
			Default.AssertElementPresent(locator1 = "Utils#DANGER_BUTTON_DISABLED");
		}

		task ("When: User selects all checkboxes") {
			for (var delete : list "access,domains,data") {
				Default.Check.toggleSwitch(
					key_checkboxName = "${delete}",
					locator1 = "Utils#ANY_CHECKBOX");
			}
		}

		task ("Then: User sees that the Delete environment button is enabled") {
			Default.AssertElementNotPresent(locator1 = "Utils#DANGER_BUTTON_DISABLED");

			Default.AssertElementPresent(locator1 = "Utils#DANGER_BUTTON");
		}
	}

	@description = "Delete Environment tab contains specific information about the implications of this action e environment information"
	@priority = "5"
	test DisplayInformation {
		task ("When: The user accesses the delete environment area") {
			Utils.goToPage(page = "projects/${projectName}/settings/delete-environment");
		}

		task ("Then: The user sees specific information about the implications of the exclusion action") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#IMPLICATIONS_INFORMATION",
				value1 = "Deleting an environment cannot be undone.");
		}

		task ("When: The user attempts to delete the environment") {
			Default.Click(locator1 = "Utils#DANGER_BUTTON");
		}

		task ("Then: The user sees that a warning message is displayed on the page") {
			Default.AssertTextEquals(
				locator1 = "DeleteProject#WARNING_MESSAGE",
				value1 = "Warning: deleting an environment cannot be undone! Confirm the deletion before proceeding.");
		}

		task ("And: Environment information is displayed") {
			Default.AssertElementPresent(
				key_environment = "${projectName}",
				key_information = "poshitest",
				locator1 = "DeleteProject#ENVIRONMENT_INFORMATION_TABLE");

			Default.AssertElementPresent(
				key_environment = "${projectName}",
				key_information = "-",
				locator1 = "DeleteProject#ENVIRONMENT_INFORMATION_TABLE");
		}
	}

}