@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();
	}

	@description = "Password feedback popup displays live feedback as user types in the Password field"
	@priority = "3"
	test DisplaysPasswordInputFeedback {
		task ("When: The user clicks on the password input field") {
			Utils.goToPage(page = "signup");

			Default.Click(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD");
		}

		task ("Then: Password feedback popup is displayed") {
			Default.AssertVisible(locator1 = "SignUp#PASSWORD_FEEDBACK_POPUP");
		}

		task ("When: The minimum requirements are met") {
			Default.AssertElementPresent(
				key_requiredItemMessage = "2 or more special characters",
				key_status = "pending",
				locator1 = "SignUp#REQUIRED_ITEM_STATUS");

			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..");
		}

		task ("Then: The requirement status is updated") {
			Default.AssertElementPresent(
				key_requiredItemMessage = "2 or more special characters",
				key_status = "ok",
				locator1 = "SignUp#REQUIRED_ITEM_STATUS");
		}
	}

	@description = "The password must follow all the mask rules and cannot contain any combination of the user name or e-mail address"
	@priority = "3"
	test MustFollowMaskRules {
		task ("When: User fills out all input fields with valid data") {
			Utils.goToPage(page = "signup");

			Default.Type(
				key_inputId = "firstName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "User");

			Default.Type(
				key_inputId = "lastName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "Tester");

			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "user.tester@liferay.com");
		}

		task ("And: The user clicks on the password input field") {
			Default.Click(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD");
		}

		task ("Then: The password feedback popup displays the status of the password requirements") {
			for (var requirement : list "8 or more characters,2 or more upper and lowercase letters,2 or more numbers,2 or more special characters") {
				Default.AssertElementPresent(
					key_requiredItemMessage = "${requirement}",
					key_status = "pending",
					locator1 = "SignUp#REQUIRED_ITEM_STATUS");
			}
		}

		task ("When: The password field is populated with a combination of the user first name") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00uSeR");
		}

		task ("Then: A text warning is displayed in the password feedback popup") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_FEEDBACK_POPUP_FOOTER",
				value1 = "Avoid any combination that has your user name within.");
		}

		task ("When: The password field is populated with a combination of the user last name") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00TeStEr");
		}

		task ("Then: A text warning is displayed in the password feedback popup") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_FEEDBACK_POPUP_FOOTER",
				value1 = "Avoid any combination that has your user name within.");
		}

		task ("When: The password field is populated with a combination of the user e-mail address") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00LiFeRaY");
		}

		task ("Then: A text warning is displayed in the password feedback popup") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_FEEDBACK_POPUP_FOOTER",
				value1 = "Avoid any combination that has your user name within.");
		}

		task ("When: All password requirements are met") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00ABcd");
		}

		task ("Then: All password requirement status is updated to OK") {
			for (var requirement : list "8 or more characters,2 or more upper and lowercase letters,2 or more numbers,2 or more special characters") {
				Default.AssertElementPresent(
					key_requiredItemMessage = "${requirement}",
					key_status = "ok",
					locator1 = "SignUp#REQUIRED_ITEM_STATUS");
			}
		}
	}

	@description = "Password strength must be moderate or high"
	@priority = "4"
	test StrengthMustBeModerateOrHigher {
		task ("When: User fills out all input fields with valid data") {
			Utils.goToPage(page = "signup");

			Default.Type(
				key_inputId = "firstName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "User");

			Default.Type(
				key_inputId = "lastName",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "Tester");

			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "user.tester@liferay.com");
		}

		task ("And: User inputs a password which doesn't meet 1 or more requirements") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00AB**");
		}

		task ("Then: Password feedback shows pending requirements") {
			Default.AssertElementPresent(
				key_requiredItemMessage = "2 or more upper and lowercase letters",
				key_status = "pending",
				locator1 = "SignUp#REQUIRED_ITEM_STATUS");
		}

		task ("And: Password feedback popup doesn't display the Strength") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL_TITLE",
				value1 = "Strength:");
		}

		task ("And: Strength level is red") {
			Default.AssertElementPresent(
				key_level = "0",
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL");
		}

		task ("When: Password meets all requirements") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00ABcd");
		}

		task ("Then: Popup displays moderate Strength") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL_TITLE",
				value1 = "Strength: moderate");
		}

		task ("And: Strength level is orange") {
			Default.AssertElementPresent(
				key_level = "1",
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL");
		}

		task ("When: Password meets all requirements and is at least 13 characters long") {
			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "..00ABcd12345");
		}

		task ("Then: Popup displays strong Strength") {
			Default.AssertTextEquals(
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL_TITLE",
				value1 = "Strength: strong");
		}

		task ("And: Strength level is now green") {
			Default.AssertElementPresent(
				key_level = "2",
				locator1 = "SignUp#PASSWORD_STRENGTH_LEVEL");
		}
	}

}