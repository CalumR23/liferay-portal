@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Project filtering with 'Latest activity' displays most recently updated project family first"
	@priority = "4"
	test CanSortProjectsByLatestActivity {
		task ("Given: User is a member of a project") {
			Default.AssertElementPresent(
				key_environment = "projtest",
				key_index = "1",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
		}

		task ("When: User create a new project") {
			ProjectsPage.createNewProject(projectName = "zeta");

			Default.WaitForElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");

			Utils.goToPage(page = "projects");
		}

		task ("And: Sort filter to 'Last activity'") {
			Default.Click(locator1 = "Projects#PROJECT_DROPDOWN_MENU");

			Default.Click(
				key_menuOption = "Last activity",
				locator1 = "Projects#PROJECT_DROPDOWN_MENU_OPTION");
		}

		task ("Then:The newly created/updated project is displayed first") {
			Default.AssertElementPresent(
				key_environment = "projtest",
				key_index = "2",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");

			Default.AssertElementPresent(
				key_environment = "zeta",
				key_index = "1",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
		}
	}

	@description = "Project filtering with 'Newest' filter displays newest project family first"
	@priority = "4"
	test CanSortProjectsByNewest {
		task ("Given: I create projects") {
			ProjectsPage.createNewProject(projectName = "alpha");

			ProjectsPage.createNewProject(projectName = "beta");
		}

		task ("When: I open the Projects page and sort filter to 'Newest'") {
			Utils.goToPage(page = "projects");

			Default.Click(locator1 = "Projects#PROJECT_DROPDOWN_MENU");

			Default.Click(
				key_menuOption = "Newest",
				locator1 = "Projects#PROJECT_DROPDOWN_MENU_OPTION");

			Default.AssertElementPresent(
				key_menuOption = "Newest",
				locator1 = "Projects#PROJECT_DROPDOWN_MENU_OPTION_SELECTED");
		}

		task ("Then: Projects are shown in newest order") {
			Default.AssertElementPresent(
				key_environment = "alpha",
				key_index = "2",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");

			Default.AssertElementPresent(
				key_environment = "beta",
				key_index = "1",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
		}
	}

	@description = "Different project families are separately grouped"
	@priority = "3"
	test DifferentProjectsAreNotGrouped {
		task ("When: I create project families") {
			ProjectsPage.createNewProject(projectName = "alpha");

			ProjectsPage.addNewEnvironment(
				environmentType = "DEV",
				location = "Oregon, USA");

			ProjectsPage.createNewProject(projectName = "beta");

			ProjectsPage.addNewEnvironment(
				environmentType = "INFRA",
				location = "Oregon, USA");
		}

		task ("And: Go to Projects page") {
			Utils.goToPage(page = "projects");
		}

		task ("Then: Different project families are separately grouped") {
			for (var environment : list "alpha,alpha-dev") {
				Default.AssertElementPresent(
					key_environment = "${environment}",
					key_index = "1",
					locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
			}

			for (var environment : list "beta,beta-infra") {
				Default.AssertElementPresent(
					key_environment = "${environment}",
					key_index = "2",
					locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
			}
		}
	}

	@description = "Environments in the same project family are grouped together alphanumerically"
	@priority = "3"
	test GroupEnvironmentsOnSameProject {
		task ("When: A project has multiple environments") {
			for (var environment : list "projtest-dev,projtest-infra,projtest-prd,projtest-uat") {
				Default.AssertElementPresent(
					key_environment = "${environment}",
					key_index = "1",
					locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
			}
		}

		task ("Then: The environments are shown in alphanumeric sort") {
			var key_projectName = "projtest";

			Default.AssertTextEquals(
				key_index = "1",
				locator1 = "Projects#PROJECT_ENVIRONMENT_POSITION",
				value1 = "projtest DEV");

			Default.AssertTextEquals(
				key_index = "2",
				locator1 = "Projects#PROJECT_ENVIRONMENT_POSITION",
				value1 = "projtest INFRA");

			Default.AssertTextEquals(
				key_index = "3",
				locator1 = "Projects#PROJECT_ENVIRONMENT_POSITION",
				value1 = "projtest PRD");

			Default.AssertTextEquals(
				key_index = "4",
				locator1 = "Projects#PROJECT_ENVIRONMENT_POSITION",
				value1 = "projtest UAT");
		}
	}

	@description = "Project families are sorted alphanumerically by default"
	@priority = "3"
	test SortProjectsAlphanumerically {
		task ("Given: I create projects") {
			ProjectsPage.createNewProject(projectName = "alpha");

			ProjectsPage.createNewProject(projectName = "beta");
		}

		task ("When: I open the Project Page") {
			Utils.goToPage(page = "projects");
		}

		task ("Then: Projects are shown in alphanumeric order") {
			Default.AssertElementPresent(
				key_menuOption = "Alphanumeric",
				locator1 = "Projects#PROJECT_DROPDOWN_MENU_OPTION_SELECTED");

			Default.AssertElementPresent(
				key_environment = "alpha",
				key_index = "1",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");

			Default.AssertElementPresent(
				key_environment = "beta",
				key_index = "2",
				locator1 = "Projects#PROJECT_ENVIRONMENT_FAMILY_POSITION");
		}
	}

}