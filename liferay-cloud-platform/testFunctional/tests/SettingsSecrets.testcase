@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "If no secrets are set for the environment and user doesn't has privilege to do so, 'No secrets' info is displayed as well as a message about roles with this permission and a link to the Team page"
	@priority = "5"
	test DisplayNoSecretsInformationAboutRoles {
		task ("When: User creates an environment but does not have team privileges and navigates to Secrets tab on Settings page") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");

			ProjectsPage.addNewEnvironment(
				environmentType = "nosecrets",
				location = "Oregon, USA");

			Utils.goToPage(page = "projects/projtest-nosecrets/settings/secrets");
		}

		task ("Then: 'No secrets' message is displayed") {
			Default.AssertElementPresent(locator1 = "Settings#NO_SECRETS_MESSAGE");
		}

		task ("And: User can see a link to the team page") {
			Default.AssertElementPresent(
				key_linkText = "go to Team page",
				locator1 = "Utils#EXTERNAL_LINK");
		}

		task ("And: Information about access is displayed") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Utils#INFO_ALERT_MESSAGE",
				value1 = "Info: Only Admin users can create new secrets to this environment");
		}

		task ("And: The 'Create New Secrets' button is not displayed") {
			Default.AssertElementNotPresent(
				key_btnName = "Create New Secrets",
				locator1 = "Settings#CREATE_BUTTON");
		}

		Utils.goToPage(page = "projects/projtest-nosecrets/settings");

		SettingsPage.deleteEnvironment();
	}

	@description = "When there are no secrets for the environment and user has privilege to do so, 'No secrets' info is displayed as well as a button to Create New Secrets"
	@priority = "5"
	test DisplayNoSecretsInformationAndCreateButton {
		var projectName = "poshitest";

		task ("Given: There are no secrets in an environment") {
			ProjectsPage.createNewProject();

			Default.WaitForElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: I access Secrets tab on Setting Page") {
			Utils.goToPage(page = "projects/${projectName}/settings/secrets");
		}

		task ("Then: 'No secrets' message is displayed") {
			Default.AssertElementPresent(locator1 = "Settings#NO_SECRETS_MESSAGE");
		}

		task ("And: The 'Create New Secrets' button is displayed") {
			Default.AssertElementPresent(locator1 = "Settings#CREATE_NEW_SECRET_BUTTON");
		}
	}

	@description = "Secrets for the current environment are displayed on the secrets table"
	@priority = "5"
	test DisplaySecretsTable {
		task ("Given: I open a specific environment When: I create a secret") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");

			Default.Click(locator1 = "Settings#CREATE_NEW_SECRET_BUTTON");

			Secrets.createNewSecret(
				description = "This secret is for testing purposes",
				keyName = "projtest-secret",
				name = "lcp-test-secret",
				value = "projtest");
		}

		task ("Then: The new secret is displayed on the secret table") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");

			Default.AssertElementPresent(
				key_secretName = "lcp-test-secret",
				locator1 = "Settings#SECRET_ROW_NAME");
		}

		task ("But: The new secret is not displayed on the secret table from another environment") {
			Utils.goToPage(page = "projects/projtest-dev/settings/secrets");

			Default.AssertElementNotPresent(
				key_secretName = "lcp-test-secret",
				locator1 = "Settings#SECRET_ROW_NAME");

			Utils.goToPage(page = "projects/projtest-infra/settings/secrets/lcp-test-secret/delete");

			Secrets.deleteSecret();
		}
	}

	@description = "Hovering over the service badge displays the service name and version"
	@priority = "3"
	test DisplayServiceInfo {
		task ("When: I access the Secrets tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");
		}

		task ("And: I hover over the service badge") {
			Default.MouseOver(
				key_secretName = "lcp-secret-ci-cli-user",
				key_serviceName = "ci",
				locator1 = "Settings#SERVICE_ICON");
		}

		task ("Then: I can see the service name and version") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "liferaycloud/jenkins:");
		}
	}

	@description = "Can View column displays Team Roles badges according to the Secret setup"
	@priority = "4"
	test DisplayTeamRolesBadges {
		task ("When: I access the Secrets tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");
		}

		task ("Then: I can see team role badges") {
			Default.AssertTextEquals(
				key_secretName = "lcp-secret-ci-cli-user",
				locator1 = "Settings#TEAM_ROLE_BADGE",
				value1 = "Admin");
		}
	}

	@description = "Hovering over the question mark icon displays a tooltip"
	@priority = "3"
	test DisplayTooltips {
		task ("When: I access the Secrets tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");
		}

		task ("Then: I can see a tooltip by hovering over the question mark icon") {
			Default.MouseOver(
				key_infoID = "Name",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Name that refers");

			Default.MouseOver(
				key_infoID = "Can View",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Can view specifies");

			Default.MouseOver(
				key_infoID = "Used in",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Used in specifies");
		}
	}

	@description = "Secrets tab displays a link to the corresponding documentation"
	@priority = "3"
	test LinkToDocumentation {
		task ("When: I access the Secrets tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");
		}

		task ("And: I click the Learn More link") {
			Default.Click(locator1 = "Utils#LEARN_MORE_LINK");
		}

		task ("Then: I can see the corresponding documentation page") {
			Default.SelectWindow(locator1 = "title=Managing Secure Environment Variables with Secrets — Liferay Learn");

			Default.AssertElementPresent(
				key_headerTitle = "Managing Secure Environment Variables with Secrets",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Clicking on Secret Name redirects to that Secret View page"
	@priority = "4"
	test SecretsTableRedirects {
		task ("When: I click on a Secret from the table") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");

			Default.Click(
				key_secretName = "lcp-secret-ci-cli-user",
				locator1 = "Settings#SECRET_ROW_NAME");
		}

		task ("Then: Console redirects to Secrets View page") {
			Default.AssertElementPresent(
				key_secretName = "lcp-secret-ci-cli-user",
				locator1 = "ViewSecrets#SECRET_NAME");
		}
	}

	@description = "Clicking on the Services icons under 'Used in' column redirects to the Service page"
	@priority = "4"
	test ServiceIconRedirects {
		task ("When: I click on the Services icons under 'Used in' column") {
			Utils.goToPage(page = "projects/projtest-infra/settings/secrets");

			Default.Click(
				key_secretName = "lcp-secret-ci-cli-user",
				key_serviceName = "ci",
				locator1 = "Settings#SERVICE_ICON");
		}

		task ("Then: Console redirects to corresponding Service Logs page") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "ServicesLogs#SERVICE_VERSION",
				value1 = "liferaycloud/jenkins:");
		}
	}

}