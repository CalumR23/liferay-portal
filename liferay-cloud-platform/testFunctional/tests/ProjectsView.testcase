@component-name = "liferay-cloud-platform"
definition {

	var projectName = "poshitest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Project row displays project/environment name"
	@priority = "4"
	test ProjectInformationIsDisplayed {
		task ("Given: I am a member of the project team Then: I can see the name of the project/environment in the project row") {
			Default.AssertTextEquals.assertPartialText(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_NAME",
				value1 = "projtest UAT");
		}

		task ("And: Environment tag is displayed in all caps") {
			Default.AssertTextEquals(
				key_environmentType = "UAT",
				key_projectName = "projtest",
				locator1 = "Projects#ENVIRONMENT_TYPE",
				value1 = "UAT");
		}

		task ("When: I hover over the Project row") {
			Default.MouseOver(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("Then: Project type is shown") {
			Default.AssertTextEquals(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_TYPE",
				value1 = "Non-Production");
		}
	}

}