@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Project is created when location and alphanumeric characters are provided for projectId and deleted in the Settings Page."
	@priority = "5"
	test CanCreateNewProject {
		var projectName = "poshitest";

		task ("Create a new project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");

			Utils.goToPage(page = "projects");

			Default.AssertElementPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

	@description = "Project is created when location and alphanumeric characters are provided for projectId and deleted in the Settings Page."
	@priority = "5"
	test CanDeleteProject {
		var projectName = "poshitest";

		task ("Create a new project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");
		}

		task ("Delete the new project") {
			Utils.goToPage(page = "projects");

			ProjectsPage.openEnvironment(environmentName = "${projectName}");

			SettingsPage.deleteEnvironment();

			Default.AssertElementPresent(locator1 = "Settings#ALERT_PROJECT_DELETED");

			Default.AssertElementNotPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

}