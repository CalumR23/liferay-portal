@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Hovering over the map location and the question mark icon displays a tooltip"
	@priority = "3"
	test DisplayTooltips {
		task ("When: I access the Info tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/info");
		}

		task ("Then: I can see a tooltip by hovering over each question mark icon") {
			Default.AssertElementPresent(
				key_cardTitle = "Environment Info",
				locator1 = "Settings#CARD_TITLE");

			Default.MouseOver(
				key_infoID = "Project Name",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Project Name is");

			Default.MouseOver(
				key_infoID = "Environment ID",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Environment ID is");

			Default.MouseOver(
				key_infoID = "Environment Type",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Environment Type is");

			Default.MouseOver(
				key_infoID = "Location",
				locator1 = "Settings#QUESTION_MARK_ICON");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Location specifies the area where");
		}

		task ("And: I can see a tooltip by hovering over the environment location map") {
			Default.MouseOver(locator1 = "Settings#ENVIRONMENT_LOCATION_MAP");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "projtest-infra is operating from Oregon, USA.");
		}
	}

}