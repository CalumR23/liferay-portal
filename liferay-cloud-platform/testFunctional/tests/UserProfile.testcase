@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Validation message displays on submit if First or Last name is not provided"
	@priority = "4"
	test DisplaysValidationMessages {
		task ("When: I access the Profile page") {
			Utils.goToPage(page = "account/profile");
		}

		task ("And: I submit the change in user data, but don't enter the first name") {
			Default.Type(
				key_inputId = "firstName",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Blank credential error messages are displayed for first name field") {
			Default.AssertTextEquals(
				key_warningMessageId = "firstNameHelp",
				locator1 = "Utils#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter first name");
		}

		task ("When: I submit the change in user data, but don't enter the last name") {
			Default.Type(
				key_inputId = "lastName",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Blank credential error messages are displayed for last name field") {
			Default.AssertTextEquals(
				key_warningMessageId = "lastNameHelp",
				locator1 = "Utils#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter last name");
		}
	}

	@description = "Email input field displays the user email and is disabled"
	@priority = "3"
	test EmailFieldIsDisabled {
		task ("When: I access the Profile page") {
			Utils.goToPage(page = "account/profile");
		}

		task ("Then: Email input field displays the user email") {
			Default.AssertTextEquals(
				key_inputId = "email",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "poshi.tester@liferay.cloud");
		}

		task ("And: Email field is not editable") {
			Default.AssertNotEditable(
				key_inputId = "email",
				locator1 = "Utils#GENERIC_INPUT_FIELD");
		}
	}

}