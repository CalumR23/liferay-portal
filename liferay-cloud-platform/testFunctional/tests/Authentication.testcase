@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();
	}

	@description = "Account is locked after 10 invalid login attempts"
	@priority = "4"
	test AccountLockedAfterTenAttempts {

		// TODO LRQA-74653 AccountLockedAfterTenAttempts pending implementation

	}

	@description = "User can login successfully with valid email and password"
	@priority = "5"
	test CanLogin {
		task ("Given: I provide correct login credentials") {
			Authentication.login();
		}

		task ("Then: Console redirects to Projects page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("And: The Welcome logged user message is displayed") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Welcome, Poshi Tester");
		}
	}

	@description = "Display error message if email or password are left blank"
	@priority = "4"
	test DisplayErrorMessageForBlankCredentials {
		task ("Given: I leave the credentials blank When: I click the Login button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: Blank credential error messages are displayed for email and password fields") {
			Default.AssertTextEquals(
				key_warningMessageId = "emailHelp",
				locator1 = "Utils#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter email address");

			Default.AssertTextEquals(
				key_warningMessageId = "passwordHelp",
				locator1 = "Utils#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter password");
		}
	}

	@description = "Display error message if email does not have valid format"
	@priority = "3"
	test DisplayErrorMessageForInvalidEmail {
		task ("Given: I input an invalid email") {
			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "@test.com");
		}

		task ("When: I click the login button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: An error message about invalid email format is displayed") {
			Default.AssertTextEquals(
				key_warningMessageId = "emailHelp",
				locator1 = "Utils#INVALID_PARAMETER_WARNING",
				value1 = "The provided email is not valid");
		}
	}

	@description = "Display invalid credentials message if the account does not exist or if password is incorrect"
	@priority = "4"
	test DisplayInvalidCredentialsMessage {
		var user = PropsUtil.get("test.this.lcp.test.account.user.email");

		task ("Given: I input a wrong password for a valid email") {
			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "${user}");

			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "wrong-password");
		}

		task ("When: I click the login button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: The invalid credentials error message is displayed") {
			Default.AssertElementPresent(
				key_message = "The provided credentials are invalid.",
				locator1 = "Authentication#TOAST_INCORRECT_INFORMATION");
		}

		task ("Given: I input an invalid email") {
			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "nonexistent@liferay.com");

			Default.Type(
				key_inputId = "password",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "P4ssW0rd..");
		}

		task ("When: I click the login button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: The invalid credentials error message is displayed") {
			Default.AssertElementPresent(
				key_message = "The provided credentials are invalid.",
				locator1 = "Authentication#TOAST_INCORRECT_INFORMATION");
		}
	}

	@description = "Display error message if email has not been confirmed by user"
	@priority = "4"
	test DisplayMessageForNotConfirmedEmail {

		// TODO LRQA-74652 DisplayMessageForNotConfirmedEmail pending implementation

	}

	@description = "Display invalid credentials message if account does not exist"
	@priority = "4"
	test DisplayMessageForNotExistentAccount {

		// TODO LRQA-74651 DisplayMessageForNotExistentAccount pending implementation

	}

	@description = "Display warning message if Organization ID is not found"
	@priority = "4"
	test DisplayOrganizationIDNotFoundMessage {
		task ("Given: I'm not logged in") {
			Utils.goToPage(page = "login-sso");
		}

		task ("When: I input a wrong organization ID") {
			Default.Type(
				key_inputId = "companyName",
				locator1 = "Utils#GENERIC_INPUT_FIELD",
				value1 = "wrong-id");
		}

		task ("And: I click submit button") {
			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: The invalid credentials error message is displayed") {
			Default.AssertElementPresent(
				key_message = "No provider was found for the company",
				locator1 = "Authentication#TOAST_INCORRECT_INFORMATION");
		}
	}

	@description = "If navigating via url to a specific page, redirect to the specified page on successful login"
	@priority = "3"
	test RedirectsAfterLogin {
		task ("Given: I try to access a specific page by URL") {
			Utils.goToPage(page = "projects/new-project");
		}

		task ("When: I log in") {
			Authentication.login();
		}

		task ("Then: Console redirects to the intended URL") {
			Default.AssertElementPresent(
				key_headerTitle = "New Project",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "When user is logged out, navigation to any Console page redirects to /login"
	@priority = "5"
	test RedirectToLoginForNotLoggedUser {
		task ("Given: I'm not logged in When: I try to access a page via URL before logging in") {
			Utils.goToPage(page = "projects/projtest-dev/settings");
		}

		task ("Then: Console redirects to the Login page") {
			Default.AssertElementPresent(
				key_headerTitle = "Log Into Your Account",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "User can navigate to specific pages by links on Login page"
	@priority = "4"
	test RedirectToPageByLink {
		task ("When: I click on 'Forgot your password?' link") {
			Default.Click(
				key_linkText = "Forgot your password?",
				locator1 = "Authentication#REDIRECT_LINK");
		}

		task ("Then: Console redirects to Reset Password page") {
			Default.AssertElementPresent(
				key_headerTitle = "Reset Password",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: I click on 'Login via SSO' link") {
			Utils.goToPage(page = "login");

			Default.Click(
				key_linkText = "Login via SSO",
				locator1 = "Authentication#REDIRECT_LINK");
		}

		task ("Then: Console redirects to Login-SSO page") {
			Default.AssertElementPresent(
				key_headerTitle = "Start single sign-on",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: I click on 'Sign up' link") {
			Utils.goToPage(page = "login");

			Default.Click(
				key_linkText = "Sign up",
				locator1 = "Authentication#REDIRECT_LINK");
		}

		task ("Then: Console redirects to account creation page") {
			Default.AssertElementPresent(
				key_headerTitle = "Create Your Account",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "When user is logged in, navigation to /login or /signup redirects to Projects page"
	@priority = "3"
	test RedirectToProjectsForLoggedUser {
		task ("Given: I log in") {
			Authentication.login();
		}

		task ("When: I try to access the login page Then: Console redirects to the Project page") {
			Utils.goToPage(page = "login");

			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: I try to access the signup page Then: Console redirects to the Project page") {
			Utils.goToPage(page = "signup");

			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}