@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();
	}

	@description = "Account is locked after 10 invalid login attempts"
	@priority = "4"
	test AccountLockedAfterTenAttempts {

		// TODO LRQA-74653 AccountLockedAfterTenAttempts pending implementation

	}

	@description = "User can login successfully with valid email and password"
	@priority = "5"
	test CanLogin {
		task ("Given: I provide correct login credentials") {
			Authentication.login();
		}

		task ("Then: Console redirects to Projects page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("And: The Welcome logged user message is displayed") {
			Default.AssertElementPresent(
				key_message = "Welcome, Poshi Tester",
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION");
		}
	}

	@description = "Display error message if email has not been confirmed by user"
	@priority = "4"
	test DisplayMessageForNotConfirmedEmail {

		// TODO LRQA-74652 DisplayMessageForNotConfirmedEmail pending implementation

	}

	@description = "Display invalid credentials message if account does not exist"
	@priority = "4"
	test DisplayMessageForNotExistentAccount {

		// TODO LRQA-74651 DisplayMessageForNotExistentAccount pending implementation

	}

}