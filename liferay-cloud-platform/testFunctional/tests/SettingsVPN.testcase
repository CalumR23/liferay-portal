@component-name = "liferay-cloud-platform"
definition {

	var projectName = "poshitest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "VPN tab displays a link to the corresponding documentation"
	@priority = "3"
	test LinkToDocumentation {
		task ("When: I access the VPN tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/vpn");
		}

		task ("And: I click the Learn More link") {
			Default.Click(locator1 = "Utils#LEARN_MORE_LINK");
		}

		task ("Then: The corresponding documentation page opens") {
			Default.SelectWindow(locator1 = "title=Connecting a VPN Server to DXP Cloud — Liferay Learn");

			Default.AssertElementPresent(
				key_headerTitle = "Connecting a VPN Server to DXP Cloud",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Admin users see 'No VPN' and 'Create New VPN' button on settings page when no vpn was created"
	@priority = "5"
	test NoVPNInformationForAdminUser {
		task ("Given: The admin user is logged in When: User navigates to VPN tab on Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/vpn");
		}

		task ("Then: 'No VPN' message is displayed") {
			Default.AssertElementPresent(locator1 = "Settings#NO_VPN_MESSAGE");
		}

		task ("And: The 'Create New VPN' button is displayed") {
			Default.AssertElementPresent(
				key_btnName = "Create New VPN",
				locator1 = "Settings#CREATE_BUTTON");
		}
	}

}