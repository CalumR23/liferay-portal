@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Utils.goToPage(page = "projects/projtest-dev/settings/secrets");

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Access control section displays team role badges for the roles set as 'Can view' for that secret and a link to Edit"
	@ignore = "Test Stub"
	@priority = "5"
	test AccessControlInformation {

		// LRQA-77810 AccessControlInformation pending implementation

	}

