@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Topbar.logout();
	}

	@description = "A toast is displayed when users with permissions enable/disable support access"
	@priority = "5"
	test CanSwitchSupportAccess {
		task ("Given: I have permission to enable/disable support access When: I disable support access") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");

			if (!(Default.IsTextEqual.isPartialText(locator1 = "Settings#SUPPORT_ACCESS_STATUS", value1 = "Enabled"))) {
				Default.Click(locator1 = "Utils#SWITCH_BUTTON");
			}

			Default.Click(locator1 = "Utils#SWITCH_BUTTON");
		}

		task ("Then: A toast with information about the change is displayed") {
			Default.AssertElementPresent(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Liferay Support Access disabled");
		}

		task ("And: Information about Support Access status is updated") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#SUPPORT_ACCESS_STATUS_DESCRIPTION",
				value1 = "Disabled. Liferay Support Access not allowed on projtest INFRA");
		}

		task ("When: I enable support access") {
			Default.Click(locator1 = "Utils#SWITCH_BUTTON");
		}

		task ("Then: A toast with information about the change is displayed") {
			Default.AssertElementPresent(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Liferay Support Access enabled");
		}

		task ("And: Information about Support Access status is updated") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#SUPPORT_ACCESS_STATUS_DESCRIPTION",
				value1 = "Enabled. Liferay Support Access allowed on projtest INFRA");
		}
	}

	@description = "Support Access Tab displays information about enabling and disabling support access, the project name and the environment badge"
	@priority = "4"
	test DisplaySupportAccessInformation {
		task ("When: I access the Support Access tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");
		}

		task ("Then: I can see information about enabling and disabling support access") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#SETTINGS_TAB_DESCRIPTION",
				value1 = "Enable or disable Liferay Support Access to this environment.");
		}

		task ("And: I can see the project name and the environment badge") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#ENVIRONMENT_NAME",
				value1 = "projtest");

			Default.AssertTextEquals(
				locator1 = "Settings#ENVIRONMENT_BADGE",
				value1 = "INFRA");
		}
	}

	@description = "Support Access Tab displays a link to the corresponding documentation"
	@priority = "3"
	test LinkToDocumentation {
		task ("When: I access the Support Access Tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");
		}

		task ("And: I click the Learn More link") {
			Default.Click(locator1 = "Utils#LEARN_MORE_LINK");
		}

		task ("Then: The corresponding documentation page opens") {
			Default.SelectWindow(locator1 = "title=Support Access — Liferay Learn");

			Default.AssertElementPresent(
				key_headerTitle = "Support Access",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Liferay support access enabled/disabled on <projectId> activity is generated when support access is enabled/disabled"
	@priority = "5"
	test SupportAccessActivityGenerated {
		task ("When: I access the Support Access tab on the Settings page") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");
		}

		task ("And: Support Access is enabled") {
			if (!(Default.IsTextEqual.isPartialText(locator1 = "Settings#SUPPORT_ACCESS_STATUS", value1 = "Enabled"))) {
				Default.Click(locator1 = "Utils#SWITCH_BUTTON");
			}
		}

		task ("Then: An activity about the Support Access is Enabled is displayed on Activities Page") {
			Utils.goToPage(page = "projects/projtest-infra/activities");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE",
				value1 = "Liferay support access enabled on");
		}

		task ("When: I disable support access") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");

			Default.Click(locator1 = "Utils#SWITCH_BUTTON");
		}

		task ("Then: An activity about the Support Access is Disabled is displayed on Activities Page") {
			Utils.goToPage(page = "projects/projtest-infra/activities");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE",
				value1 = "Liferay support access disabled on");
		}
	}

	@description = "Clicking on the environment badge redirects to the Environment overview page"
	@priority = "4"
	test SupportAccessRedirects {
		task ("When: I click the badge") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");

			Default.AssertElementPresent(
				key_cardTitle = "Support Access",
				locator1 = "Settings#CARD_TITLE");

			Default.Click(locator1 = "Settings#ENVIRONMENT_BADGE");
		}

		task ("Then: The console is redirected to the Overview page") {
			Default.AssertElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "infra");
		}

		task ("When: I click the username") {
			Utils.goToPage(page = "projects/projtest-infra/settings/support-access");

			Default.AssertElementPresent(
				key_cardTitle = "Support Access",
				locator1 = "Settings#CARD_TITLE");

			Default.Click(
				key_adminUser = "Poshi Tester",
				locator1 = "Settings#SUPPORT_ACCESS_USERNAME");
		}

		task ("Then: The console is redirected to the Team page") {
			Default.AssertElementPresent(
				key_headerTitle = "Team",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}