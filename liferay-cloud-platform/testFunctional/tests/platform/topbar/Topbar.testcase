@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Topbar.logout();
	}

	@description = "Clicking on Build link redirects to project builds page"
	@priority = "4"
	test BuildLinkRedirects {
		task ("When: User accesses a project's environment") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("And: The user clicks on the 'Build' link") {
			Default.Click(
				key_text = "Builds",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}

		task ("Then: Console redirects to 'Builds' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Builds",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Clicking on Deployments link redirects to project deployments page"
	@priority = "4"
	test DeploymentsLinkRedirects {
		task ("When: User accesses a project's environment") {
			ProjectsPage.openEnvironment(environmentName = "projtest-infra");
		}

		task ("And: The user clicks on the 'Deployments' link") {
			Default.Click(
				key_text = "Deployments",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}

		task ("Then: Console redirects to 'Deployments' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Deployments",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Environment dropdown displays currently selected environment"
	@priority = "5"
	test DisplayCurrentEnvironment {
		task ("When: The user navigates to the project environment overview page") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("Then: Topbar display a current environment") {
			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "dev");
		}

		task ("When: The user opens the environment dropdown") {
			Default.Click(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");
		}

		task ("Then: The 'selected' icon is displayed besides the current environment option") {
			Default.AssertElementPresent(
				key_environmentName = "dev",
				locator1 = "Environment#DROPDOWN_SELECTED_ENVIRONMENT_ICON");
		}
	}

	@description = "Environment dropdown, Visit Site, Builds link, and Deployments link are only displayed on project's overview pages"
	@priority = "5"
	test DisplayElementsOnProjectPageTopbar {
		task ("Then: The project specific elements are not shown in the topbar") {
			Default.AssertElementNotPresent(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.AssertElementNotPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertElementNotPresent(
				key_text = "Builds",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");

			Default.AssertElementNotPresent(
				key_text = "Deployments",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}

		task ("When: User navigates to Alerts page") {
			Utils.goToPage(page = "alerts");
		}

		task ("Then: The project specific elements are not shown in the topbar") {
			Default.WaitForElementPresent(
				key_headerTitle = "Alerts",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementNotPresent(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.AssertElementNotPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertElementNotPresent(
				key_text = "Builds",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");

			Default.AssertElementNotPresent(
				key_text = "Deployments",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}

		task ("When: User navigates to Profile page") {
			Utils.goToPage(page = "account/profile");
		}

		task ("Then: The project specific elements are not shown in the topbar") {
			Default.AssertElementNotPresent(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.AssertElementNotPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertElementNotPresent(
				key_text = "Builds",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");

			Default.AssertElementNotPresent(
				key_text = "Deployments",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}

		task ("When: The user navigates to the project environment") {
			Utils.goToPage(page = "projects/projtest-dev/overview");
		}

		task ("Then: The project specific elements are shown in the topbar") {
			Default.WaitForElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementPresent(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.AssertElementPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertElementPresent(
				key_text = "Builds",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");

			Default.AssertElementPresent(
				key_text = "Deployments",
				locator1 = "Topbar#TOPBAR_TEXT_LINK");
		}
	}

	@description = "Clicking Visit Site opens the endpoints dropdown"
	@priority = "4"
	test DisplayEndpointDropdown {
		task ("When: User clicks in 'Visit Site' button") {
			Utils.goToPage(page = "projects/projtest-dev");

			Default.Click(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: The 'Visit Site' button is shown in the top bar") {
			Default.Click(locator1 = "Topbar#ENDPOINTS_DROPDOWN");

			Default.AssertElementPresent(
				key_endpointName = "webserver-projtest-dev.lfr",
				locator1 = "Topbar#ENDPOINT_PILL");
		}
	}

	@description = "Clicking on the help icon opens a drop-down list with links to support sites"
	@priority = "4"
	test DisplayHelpDropdown {
		task ("When: The user navigates to the project environment") {
			ProjectsPage.openEnvironment(environmentName = "projtest-infra");
		}

		task ("And: The user clicks the Help icon in the top bar") {
			Default.Click(
				key_topbarItem = "docs",
				locator1 = "Topbar#TOPBAR_ICON");
		}

		task ("Then: A drop-down list with links to support sites is displayed") {
			Default.AssertVisible(
				key_item = "Contact Support",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Documentation",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Migration Guide",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Knowledge Base",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Announcements",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Uptime Status",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");
		}
	}

	@description = "Clicking on user icon opens user menu"
	@priority = "4"
	test DisplayUserDropdown {
		task ("When: The user clicks the user icon in the top bar") {
			Default.Click(locator1 = "Topbar#USER_AVATAR_PORTRAIT");
		}

		task ("Then: The user menu is displayed with all options visible") {
			Default.AssertVisible(
				key_item = "Poshi Tester",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "View Profile",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Alerts Preferences",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");

			Default.AssertVisible(
				key_item = "Log Out",
				locator1 = "Topbar#USER_AVATAR_DROPDOWN_ANY_ITEM");
		}
	}

	@description = "Visit Site displays only in environments where webserver service is deployed"
	@priority = "4"
	test DisplayVisitSite {
		task ("When: User navigates to an environment that has a webserver service") {
			Utils.goToPage(page = "projects/projtest-dev");
		}

		task ("Then: The 'Visit Site' button is shown in the top bar") {
			Default.AssertElementPresent(
				key_serviceName = "webserver",
				locator1 = "Overview#SERVICE_NAME");

			Default.AssertElementPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("When: User navigates to an environment that has no webserver service") {
			Utils.goToPage(page = "projects/projtest-infra");
		}

		task ("Then: The 'Visit Site' button is not shown in the top bar") {
			Default.AssertElementNotPresent(
				key_serviceName = "webserver",
				locator1 = "Overview#SERVICE_NAME");

			Default.AssertElementNotPresent(
				key_btnName = "Visit Site",
				locator1 = "Utils#CLICK_BUTTON");
		}
	}

	@description = "Selecting an environment from the dropdown redirects to selected environment's overview page"
	@priority = "5"
	test RedirectsToEnvironmentOverviewPage {
		task ("When: The user navigates to the project environment overview page") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("And:The user selects a different environment from the current one from the drop-down menu") {
			Default.Click(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.Click(
				key_menuOption = "infra",
				locator1 = "Utils#ANY_MENU_OPTION");
		}

		task ("Then: Console redirects to the selected environment's overview page") {
			Default.AssertElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "infra");

			Default.AssertLocation.assertPartialLocation(value1 = "console.liferay.coffee/projects/projtest-infra/overview");
		}
	}

	@description = "Clicking on DXP Cloud logo or DXP Cloud icon redirects to Projects page"
	@priority = "4"
	test RedirectsToProjectsPage {
		task ("When: User clikcs on the DXP Cloud title on a page other than the Projects page") {
			Utils.goToPage(page = "projects/projtest-infra/overview");

			Default.Click(locator1 = "Topbar#TOPBAR_DXP_CLOUD_TITLE");
		}

		task ("Then: Console redirecteds to the Projects page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("When: User clicks on the DXP Cloud logo on a page other than the Projects page") {
			Utils.goToPage(page = "alerts");

			Default.Click(locator1 = "Topbar#TOPBAR_LOGO_ICON");
		}

		task ("Then: Console redirects to the Projects page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Selecting 'Add new environment' redirects to Add New Environment page"
	@priority = "5"
	test RedirectToAddNewEnvironmentPage {
		task ("When: The user navigates to the project environment overview page") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("And: The user clicks on 'Add new environment' at the environment's dropdown") {
			Default.Click(locator1 = "Environment#ENVIRONMENTS_DROPDOWN");

			Default.Click(
				key_menuOption = "Add new environment",
				locator1 = "Utils#MENU_OPTION");
		}

		task ("Then: Console redirects to 'Add New Environment' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Add New Environment",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}