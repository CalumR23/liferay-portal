@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Topbar.logout();
	}

	@description = "The alerts page displays the 'Learn more...' link when no alerts are present"
	@priority = "5"
	test BlankPageLinksToDocumentation {
		task ("Given: We don't have any alerts / Alerts page is blank When: I access alerts page") {
			Utils.goToPage(page = "alerts");
		}

		task ("And: A User clicks on 'Learn more about alerts' link") {
			AlertsPage.clickDocsLink();
		}

		task ("Then: The user will be redirected to the related documentation page") {
			Utils.switchWindow(windowTitle = "Real-Time Alerts");
		}
	}

	@description = "User can access Alerts page by clicking the bell icon on the top navigation panel on console"
	@priority = "5"
	test CanAccessAlertsPage {
		task ("When: A User clicks the bell icon") {
			AlertsPage.clickAlertIcon();
		}

		task ("Then: The User is redirected to the Alerts page") {
			Default.AssertElementPresent(
				key_headerTitle = "Alerts",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "User can access Alerts Preference page by clicking the gear icon in the Alerts page"
	@priority = "5"
	test CanAccessAlertsPreferences {
		task ("When: A User clicks the gear icon on the alerts page") {
			Utils.goToPage(page = "alerts");

			AlertsPage.clickAlertsPreferencesIcon();
		}

		task ("Then: The user is redirected to the alerts preference page") {
			Default.AssertElementPresent(locator1 = "AlertsPreferences#ALERTS_PREFERENCE_TAB");
		}
	}

	@description = "User can filter alerts by unread alerts and alerts by all environments"
	@priority = "5"
	test CanFilterAlertsPage {
		task ("When: The User changes the filter for Unread and Environment alerts on the Alerts page") {
			Utils.goToPage(page = "alerts");

			AlertsPage.selectAlertsFilter(
				dropdownItem = "All alerts",
				filterOption = "Unread alerts");

			AlertsPage.selectAlertsFilter(
				dropdownItem = "uat",
				filterOption = "All environments");
		}

		task ("Then: The filter will show the new filtered options") {
			Default.AssertElementPresent(
				key_filterOption = "All alerts",
				locator1 = "Alerts#ALERTS_FILTER");

			Default.AssertElementPresent(
				key_filterOption = "projtest-uat",
				locator1 = "Alerts#ALERTS_FILTER");
		}
	}

	@description = "The status column will show Ongoing alerts for events that are still happening and Resolved when they are finished"
	@priority = "5"
	test StatusUpdates {
		task ("Given: I create a project and deploy nodehog as a service") {
			ProjectsAPI.createProject(projectID = "qaposhitest");

			NewDeploymentAPI.deployFromRepo(
				projectID = "qaposhitest",
				repo = "nodehog");
		}

		task ("When: The CPU usage for the nodehog service exceeds 80%") {
			Utils.goToPage(page = "alerts");

			Default.Pause(locator1 = "420000");

			AlertsPage.assertAlertMessage(
				alertMessage = "The nodehog service exceeded 80% of its allocated CPU.",
				messageRow = "1");
		}

		task ("Then: The status of the alert will be Ongoing") {
			AlertsPage.assertAlertStatus(
				alertStatus = "Ongoing",
				messageRow = "1");
		}

		task ("Then: The status of the alert will be Resolved after 3min duration") {
			Default.Pause(locator1 = "180000");

			Default.Refresh();

			AlertsPage.assertAlertStatus(
				alertStatus = "Resolved",
				messageRow = "1");

			AlertsPage.assertAlertDuration(
				alertDuration = "3min",
				messageRow = "1");
		}
	}

}