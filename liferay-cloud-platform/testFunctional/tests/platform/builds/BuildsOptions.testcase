@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Topbar.logout();
	}

	@description = "Must be contributor or above to have the 'Deploy build to' option"
	@priority = "5"
	test OnlyContributorOrAboveCanDeploy {
		task ("When: A user with no team scope navigates to the Build page") {
			Topbar.logout();

			LoginPage.loginAsGuest();

			Utils.goToPage(page = "projects/projtest/builds");
		}

		task ("And: Open ellipses menu") {
			Default.Click(
				key_buildID = "3",
				key_column = "settings",
				locator1 = "Builds#BUILDS_TABLE_ITEM");
		}

		task ("Then: The 'Deploy build to' option is not displayed") {
			Default.AssertElementNotPresent(
				key_item = "Deploy build to...",
				locator1 = "Utils#ELLIPSIS_MENU_ITEM");
		}
	}

	@description = "From Builds page, selecting 'Deploy build to' from ellipses menu redirects to 'Deploy build to...' page"
	@priority = "5"
	test RedirectsToDeployBuildToPage {
		var buildID = "4";

		task ("When: The user navigates to the Builds page") {
			Utils.goToPage(page = "projects/projtest/builds");
		}

		task ("And: The user clicks on 'Deploy build to...' from ellipses menu") {
			Default.Click(
				key_buildID = "${buildID}",
				key_column = "settings",
				locator1 = "Builds#BUILDS_TABLE_ITEM");

			Default.Click(
				key_item = "Deploy build to...",
				locator1 = "Utils#ELLIPSIS_MENU_ITEM");
		}

		task ("Then: Console redirects to 'Deploy build to...' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Deploy build to...",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/projtest/deploy/${buildID}");
		}
	}

	@description = "Selecting 'View build logs' redirects to project logs page with 'Build logs' and buildId filters applied"
	@priority = "4"
	test RedirectsToProjectLogsPage {
		task ("When: The user navigates to the Builds page") {
			Utils.goToPage(page = "projects/projtest/builds");
		}

		task ("And: The user clicks on 'View build logs' from ellipses menu") {
			Default.Click(
				key_buildID = "3",
				key_column = "settings",
				locator1 = "Builds#BUILDS_TABLE_ITEM");

			Default.Click(
				key_item = "View build logs",
				locator1 = "Utils#ELLIPSIS_MENU_ITEM");
		}

		task ("Then: Console redirects to Logs page") {
			Default.AssertElementPresent(
				key_headerTitle = "Logs",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}