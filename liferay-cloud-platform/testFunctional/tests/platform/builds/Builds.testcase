@component-name = "liferay-cloud-platform"
definition {

	var projectID = "projtest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Topbar.logout();
	}

	@description = "Clicking Branch opens github page in new tab -- github.com/dxpcoud-dev/:projectId/tree/:branch"
	@priority = "3"
	test BranchInfoRedirects {
		task ("When: I access the Builds page") {
			Utils.goToPage(page = "projects/${projectID}/builds");
		}

		task ("And: Click on the Branch pill") {
			var branchName = BuildsPage.getPillText(
				key_index = "2",
				key_typePill = "Branch");

			Default.Click(
				key_index = "2",
				key_typePill = "branch",
				locator1 = "Builds#BUILD_LINK_PILL");
		}

		task ("Then: Open the GitHub Branch page in a new tab") {
			Default.SelectWindow(locator1 = "title=Page not found · GitHub · GitHub");

			Default.AssertLocation.assertPartialLocation(value1 = "github.com/dxpcloud-dev/${projectID}/tree/${branchName}");

			Default.Close.closeWindow();
		}
	}

	@description = "Clicking Build ID redirects to 'Deploy build to...' page"
	@priority = "3"
	test BuildIDRedirects {
		task ("When: I access the Builds page") {
			Utils.goToPage(page = "projects/${projectID}/builds");
		}

		task ("And: Click on the Build ID pill") {
			Default.AssertElementPresent(
				key_headerTitle = "Builds",
				locator1 = "Utils#HEADER_TITLE");

			Default.Click(
				key_index = "1",
				key_typePill = "id",
				locator1 = "Builds#BUILD_LINK_PILL");
		}

		task ("Then: Console redirects to 'Deploy build to...' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Deploy build to...",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Clicking Ci button opens Jenkins Continuous Integration popup"
	@priority = "3"
	test CIPopupIsDisplayed {
		task ("When: User clicks on the CI button at the Builds page") {
			Utils.goToPage(page = "projects/projtest/builds");

			Default.Click(locator1 = "Builds#CI_BUTTON");
		}

		task ("Then: Jenkins Continuous Integration popup displayed") {
			Default.AssertTextEquals(
				locator1 = "Builds#CI_POPUP_TITLE",
				value1 = "Jenkins Continuous Integration");
		}
	}

	@description = "Clicking Commit opens github page in new tab -- github.com/dxpcloud-dev/:projectId/commit/:commitHash"
	@priority = "3"
	test CommitInfoRedirects {
		task ("When: I access the Builds page") {
			Utils.goToPage(page = "projects/${projectID}/builds");
		}

		task ("And: Click on the Commit pill") {
			var commit = BuildsPage.getPillText(
				key_index = "2",
				key_typePill = "Commit");

			Default.Click(
				key_index = "2",
				key_typePill = "commit",
				locator1 = "Builds#BUILD_LINK_PILL");
		}

		task ("Then: Open the GitHub Commit page in a new tab") {
			Default.SelectWindow(locator1 = "title=Page not found · GitHub · GitHub");

			Default.AssertLocation.assertPartialLocation(value1 = "github.com/dxpcloud-dev/${projectID}/commit/${commit}");

			Default.Close.closeWindow();
		}
	}

}