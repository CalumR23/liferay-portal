@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	@description = "User can extend session when popup displays by clicking 'Continue'"
	@priority = "4"
	test CanExtendSession {
		task ("Given: There is no interaction with the console for 12 minutes") {
			Default.Pause(locator1 = "720000");
		}

		task ("When: I click the Continue button on the session timeout popup") {
			Default.Click(locator1 = "Session#TIMEOUT_POPUP_CONTINUE_BUTTON");
		}

		task ("Then: The user stays logged in") {
			Default.AssertElementNotPresent(locator1 = "Session#TIMEOUT_POPUP_TITLE");

			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "User can log out when popup displays by clicking 'Log Out'"
	@priority = "3"
	test CanLogoutFromPopup {
		task ("Given: There is no interaction with the console for 12 minutes") {
			Default.Pause(locator1 = "720000");
		}

		task ("When: I click the 'Log Out' button on the session timeout popup") {
			Default.Click(locator1 = "Session#TIMEOUT_POPUP_LOGOUT_BUTTON");
		}

		task ("Then: The user stays logged in") {
			Default.AssertElementNotPresent(locator1 = "Session#TIMEOUT_POPUP_TITLE");

			Default.AssertElementPresent(
				key_headerTitle = "Log Into Your Account",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "User is logged out after session timeout (15 minutes)"
	@priority = "5"
	test LoggedOutAfterSessionTimeout {
		task ("Given: I log in When: There is no interaction with the console for 12 minutes") {
			Default.Pause(locator1 = "720000");
		}

		task ("Then: Session timeout pop-up displays") {
			Default.AssertElementPresent(locator1 = "Session#TIMEOUT_POPUP_TITLE");
		}

		task ("And: User is logged out after 15 minutes of timeout") {
			Default.Pause(locator1 = "180000");

			Default.AssertElementPresent(
				key_headerTitle = "Log Into Your Account",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}