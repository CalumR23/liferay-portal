@component-name = "liferay-cloud-platform"
definition {

	var projectName = "poshitest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Project row displays project/environment name"
	@priority = "4"
	test ProjectInformationIsDisplayed {
		task ("Given: I am a member of the project team Then: I can see the name of the project/environment in the project row") {
			Default.AssertTextEquals.assertPartialText(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_NAME",
				value1 = "projtest UAT");
		}

		task ("And: Environment tag is displayed in all caps") {
			Default.AssertTextEquals(
				key_environmentType = "UAT",
				key_projectName = "projtest",
				locator1 = "Projects#ENVIRONMENT_TYPE",
				value1 = "UAT");
		}

		task ("When: I hover over the Project row") {
			Default.MouseOver(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("Then: Project type is shown") {
			Default.AssertTextEquals(
				key_environment = "projtest-uat",
				locator1 = "Projects#PROJECT_TYPE",
				value1 = "Non-Production");
		}
	}

	@description = "Clicking project/environment name redirects to project overview page for the project/environment"
	@priority = "4"
	test ProjectListRedirects {
		task ("When: I click on the environment name") {
			ProjectsPage.openEnvironment(environmentName = "projtest-infra");
		}

		task ("Then: Console redirects to environment overview page") {
			Default.AssertElementPresent(
				key_headerTitle = "Overview",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "infra");
		}
	}

	@description = "Count and project/environment list are updated when the user is a member of an additional project/environment"
	@priority = "4"
	test ProjectsListIsUpdated {
		var initialCountOfEnvironments = ProjectsPage.countOfEnvironments();

		task ("When: I create a new project") {
			ProjectsPage.createNewProject();
		}

		task ("Then: The project is shown in the project list") {
			Utils.goToPage(page = "projects");

			Default.AssertElementPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("And: Environment count is updated") {
			var environmentCount = ${initialCountOfEnvironments} + 1;

			Default.AssertTextEquals(
				locator1 = "Projects#ENVIRONMENT_COUNT",
				value1 = "Environment (${environmentCount})");
		}

		task ("When: A new environment is added to the project") {
			Utils.goToPage(page = "projects/${projectName}/overview");

			ProjectsPage.addNewEnvironment(
				environmentType = "DEV",
				location = "Oregon, USA");
		}

		task ("Then: The new environment is shown in the project list") {
			Utils.goToPage(page = "projects");

			Default.AssertElementPresent(
				key_environment = "${projectName}-dev",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("And: Environment count is updated again") {
			var environmentCount = ${initialCountOfEnvironments} + 2;

			Default.AssertTextEquals(
				locator1 = "Projects#ENVIRONMENT_COUNT",
				value1 = "Environment (${environmentCount})");
		}
	}

	@description = "Project/environment list is updated when project is deleted"
	@priority = "4"
	test ProjectsListIsUpdatedUponDeletion {
		task ("When: I am a project member with additional environment") {
			ProjectsPage.createNewProject(projectName = "${projectName}");

			ProjectsPage.addNewEnvironment(
				environmentType = "DEV",
				location = "Oregon, USA");

			Utils.goToPage(page = "projects");

			var initialCountOfEnvironments = ProjectsPage.countOfEnvironments();
		}

		task ("And: Project environment is deleted") {
			Utils.goToPage(page = "projects/${projectName}-dev/settings");

			SettingsPage.deleteEnvironment();
		}

		task ("Then: The project/environment list is updated and the environment is not shown") {
			Utils.goToPage(page = "projects");

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementNotPresent(
				key_environment = "${projectName}-dev",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("And: Environment count is updated") {
			var environmentCount = ${initialCountOfEnvironments} - 1;

			Default.AssertTextEquals(
				locator1 = "Projects#ENVIRONMENT_COUNT",
				value1 = "Environment (${environmentCount})");
		}

		task ("When: Project is deleted ") {
			Utils.goToPage(page = "projects/${projectName}/settings");

			SettingsPage.deleteEnvironment();
		}

		task ("Then: The project/environment list is updated and the project is not shown") {
			Utils.goToPage(page = "projects");

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementNotPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}

		task ("And: Environment count is updated again") {
			var environmentCount = ${initialCountOfEnvironments} - 2;

			Default.AssertTextEquals(
				locator1 = "Projects#ENVIRONMENT_COUNT",
				value1 = "Environment (${environmentCount})");
		}
	}

}