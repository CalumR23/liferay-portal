@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		ProjectsAPI.createProject(projectID = "qaposhitest");

		Authentication.login();
	}

	tearDown {
		UtilsAPI.tearDownProjects(projectIdList = "qaposhitest");

		Authentication.logout();
	}

	@description = "Project status displays as 'None' when there are no services"
	@priority = "4"
	test DisplaysNoneForNoServices {
		task ("Given: User has a new project When: User navigates to projects page") {
			Utils.goToPage(page = "projects");
		}

		task ("Then: Status should show 'None' on projects page") {
			Default.AssertElementPresent(
				key_projectId = "qaposhitest",
				key_status = "None",
				locator1 = "Projects#PROJECT_WITH_STATUS");
		}

		task ("And: User hovers over 'None'") {
			Default.MouseOver(
				key_projectId = "qaposhitest",
				key_status = "None",
				locator1 = "Projects#PROJECT_WITH_STATUS");
		}

		task ("And: A tooltip displays 'No service is running on this environment'") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Utils#TOOLTIP_BODY",
				value1 = "No service is running on this environment");
		}

		task ("And: Services should show 'No services' on projects page") {
			Default.AssertElementPresent(
				key_environment = "qaposhitest",
				locator1 = "Projects#ENVIRONMENT_NO_SERVICES");
		}
	}

	@description = "Project status displays as an ellipsis when there is at least one service pending"
	@priority = "3"
	test PendingServiceStatus {
		task ("Given: A service was just deployed to a new project") {
			NewDeploymentAPI.deployFromRepo(
				projectID = "qaposhitest",
				repo = "hosting");
		}

		task ("When: User navigates to projects page") {
			Utils.goToPage(page = "projects");

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("And: User waits for pending status") {
			Default.WaitForElementPresent(
				key_projectId = "qaposhitest",
				locator1 = "Projects#PROJECT_PENDING_STATUS");
		}

		task ("Then: Status should show 'Pending' on projects page") {
			Default.AssertElementPresent(
				key_projectId = "qaposhitest",
				locator1 = "Projects#PROJECT_PENDING_STATUS");
		}

		task ("And: Hovering on 'Pending' status displays 'One or more services are getting ready' tooltip") {
			Default.MouseOver(
				key_projectId = "qaposhitest",
				locator1 = "Projects#PROJECT_PENDING_STATUS");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Utils#TOOLTIP_BODY",
				value1 = "One or more services are getting ready");
		}
	}

	@description = "Project status displays as 'Ready' when services are ready"
	@priority = "4"
	test ReadyServiceStatus {
		task ("Given: A service was just deployed to a new project") {
			NewDeploymentAPI.deployFromRepo(
				projectID = "qaposhitest",
				repo = "hosting");
		}

		task ("When: User navigates to projects page") {
			Utils.goToPage(page = "projects");

			Default.WaitForElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("Then: Status show 'Ready' on projects page when service successfully spins up") {
			Default.WaitForElementPresent(
				key_projectId = "qaposhitest",
				key_status = "Ready",
				locator1 = "Projects#PROJECT_WITH_STATUS");

			Default.AssertElementPresent(
				key_projectId = "qaposhitest",
				key_status = "Ready",
				locator1 = "Projects#PROJECT_WITH_STATUS");
		}

		task ("And: Hovering on 'Ready' status displays 'All services are ready to receive requests' tooltip") {
			Default.MouseOver(
				key_projectId = "qaposhitest",
				key_status = "Ready",
				locator1 = "Projects#PROJECT_WITH_STATUS");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Utils#TOOLTIP_BODY",
				value1 = "All services are ready to receive requests");
		}
	}

}