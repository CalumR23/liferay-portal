@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	var projectId = "qaposhimembers";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		UtilsAPI.tearDownProjects(projectIdList = "${projectId}");

		LoginPage.logout();
	}

	@description = "Members list reflects users which are members of the environment"
	@priority = "4"
	test DisplayMemberIcons {
		task ("When: I create a project And: I invite three users to my project") {
			ProjectsAPI.createProject(projectID = "${projectId}");

			InvitationAPI.addTeamMember(
				email = PropsUtil.get("test.this.account.guest.user1.email"),
				projectId = "${projectId}",
				role = "admin");

			InvitationAPI.addTeamMember(
				email = PropsUtil.get("test.this.account.guest.user2.email"),
				projectId = "${projectId}",
				role = "contributor");

			InvitationAPI.addTeamMember(
				email = PropsUtil.get("test.this.account.guest.user3.email"),
				projectId = "${projectId}",
				role = "guest");
		}

		task ("Then: The project reflects the added users") {
			for (var member : list "Poshi Tester,QA1 PTester,QA2 PTester,QA3 PTester") {
				Default.AssertElementPresent(
					key_environment = "${projectId}",
					key_memberName = "${member}",
					locator1 = "Projects#ENVIRONMENT_MEMBER");
			}
		}

		task ("When: Another user is added to the project") {
			InvitationAPI.addTeamMember(
				email = PropsUtil.get("test.this.account.guest.user4.email"),
				projectId = "${projectId}",
				role = "guest");
		}

		task ("Then: The project reflects the first three users") {
			for (var member : list "Poshi Tester,QA1 PTester,QA2 PTester") {
				Default.AssertElementPresent(
					key_environment = "${projectId}",
					key_memberName = "${member}",
					locator1 = "Projects#ENVIRONMENT_MEMBER");
			}
		}

		task ("And: The last two users are replaced with an avatar with the additional user count") {
			Default.AssertElementNotPresent(
				key_environment = "${projectId}",
				key_memberName = "QA3 PTester",
				locator1 = "Projects#ENVIRONMENT_MEMBER");

			Default.AssertElementNotPresent(
				key_environment = "${projectId}",
				key_memberName = "QA4 PTester",
				locator1 = "Projects#ENVIRONMENT_MEMBER");

			Default.AssertTextEquals.assertPartialText(
				key_environment = "${projectId}",
				locator1 = "Projects#MORE_MEMBERS_AVATAR",
				value1 = "+2");

			Default.MouseOver(
				key_environment = "${projectId}",
				locator1 = "Projects#MORE_MEMBERS_AVATAR");

			Default.AssertTextEquals(
				locator1 = "Utils#TOOLTIP_BODY",
				value1 = "2 more members");
		}
	}

	@description = "Individual member icon displays tooltip with full name and email on hover"
	@priority = "3"
	test DisplayMemberIconTooltips {
		task ("When: I hover over the member icon") {
			Default.MouseOver(
				key_environment = "projtest-infra",
				key_memberName = "Poshi Tester",
				locator1 = "Projects#ENVIRONMENT_MEMBER");
		}

		task ("Then: I can see the user's full name in the tooltip") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Poshi Tester");
		}

		task ("And: I can see the user's email in the tooltip") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "poshi.tester@liferay.cloud");
		}
	}

	@description = "Clicking member icon redirects to project team page"
	@priority = "4"
	test MemberIconRedirects {
		task ("When: I click on the user icon") {
			Default.Click(
				key_environment = "projtest-infra",
				key_memberName = "Poshi Tester",
				locator1 = "Projects#ENVIRONMENT_MEMBER");
		}

		task ("Then: Console redirects to corresponding Team page") {
			Default.AssertElementPresent(
				key_headerTitle = "Team",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "infra");
		}
	}

}