@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		LoginPage.logout();
	}

	@description = "Environment can be added to a project"
	@priority = "5"
	test CanAddEnvironmentToProject {
		var projectName = "poshitest";

		task ("Given: I create a project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");
		}

		task ("When: I add an environment to the project") {
			ProjectsPage.addNewEnvironment(
				environmentType = "DEV",
				location = "Oregon, USA");
		}

		task ("Then: The environment is shown on the Project page") {
			Utils.goToPage(page = "projects");

			Default.AssertElementPresent(
				key_environment = "${projectName}-dev",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

	@description = "Project is created when location and alphanumeric characters are provided for projectId and deleted in the Settings Page"
	@priority = "5"
	test CanCreateNewProject {
		var projectName = "poshitest";

		task ("Given: I create a project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");
		}

		task ("When: I access the Project page") {
			Utils.goToPage(page = "projects");
		}

		task ("Then: The project is shown on the page") {
			Default.AssertElementPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

	@description = "The project can be deleted"
	@priority = "5"
	test CanDeleteProject {
		var projectName = "poshitest";

		task ("Given: I create a project") {
			ProjectsPage.createNewProject(projectName = "${projectName}");
		}

		task ("When: The project is deleted") {
			Utils.goToPage(page = "projects/${projectName}/settings");

			SettingsPage.deleteEnvironment();
		}

		task ("Then: The success message is displayed") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Environment deleted");
		}

		task ("And: The project name is not shown on the projects page") {
			Default.AssertElementNotPresent(
				key_environment = "${projectName}",
				locator1 = "Projects#PROJECT_NAME");
		}
	}

	@description = "Can check the environment information on the project page"
	@priority = "5"
	test CanVerifyEnvironmentInformationOnProjectPage {
		task ("Then: The environment type is shown on the page") {
			for (var type : list "DEV,INFRA,PRD") {
				Default.AssertElementPresent(
					key_environmentType = "${type}",
					key_projectName = "projtest",
					locator1 = "Projects#ENVIRONMENT_TYPE");
			}
		}

		task ("Then: The environments status is shown on the page") {
			Default.AssertTextEquals(
				key_environment = "projtest-dev",
				locator1 = "Projects#ENVIRONMENT_STATUS",
				value1 = "Ready");

			Default.AssertTextEquals(
				key_environment = "projtest-infra",
				locator1 = "Projects#ENVIRONMENT_STATUS",
				value1 = "Ready");

			Default.AssertTextEquals(
				key_environment = "projtest-prd",
				locator1 = "Projects#ENVIRONMENT_STATUS",
				value1 = "None");
		}

		task ("Then: The environments services is shown on the page") {
			for (var serviceName : list "backup,database,liferay,search,webserver") {
				Default.AssertElementPresent(
					key_environment = "projtest-dev",
					key_serviceName = "${serviceName}",
					locator1 = "Projects#ENVIRONMENT_SERVICE");
			}

			Default.AssertElementPresent(
				key_environment = "projtest-infra",
				key_serviceName = "ci",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Default.AssertElementPresent(
				key_environment = "projtest-prd",
				locator1 = "Projects#ENVIRONMENT_NO_SERVICES");
		}

		task ("Then: The team member is shown on the page") {
			for (var environment : list "projtest-dev,projtest-infra,projtest-prd") {
				Default.AssertElementPresent(
					key_environment = "${environment}",
					key_memberName = "Poshi Tester",
					locator1 = "Projects#ENVIRONMENT_MEMBER");
			}
		}

		task ("Then: The project location is shown on the page") {
			for (var environment : list "projtest-dev,projtest-infra,projtest-prd") {
				Default.AssertElementPresent(
					key_environment = "${environment}",
					key_location = "Oregon, USA",
					locator1 = "Projects#ENVIRONMENT_LOCATION");
			}
		}
	}

}