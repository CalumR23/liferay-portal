@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		LoginPage.logout();
	}

	@description = "Hovering over service icon displays a tool-tip with service name and image details"
	@priority = "4"
	test DisplayDetailsHoveringServiceIcon {
		task ("When: I hover over the service icon") {
			Default.MouseOver(
				key_environment = "projtest-infra",
				key_serviceName = "ci",
				locator1 = "Projects#ENVIRONMENT_SERVICE");
		}

		task ("Then: I can see the service name and image details") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Ci");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "liferaycloud/jenkins:2.319.3-jdk8-5.0.0-alpha.3");
		}

		task ("When: I hover over the service icon of another environment") {
			Default.MouseOver(
				key_environment = "projtest-dev",
				key_serviceName = "search",
				locator1 = "Projects#ENVIRONMENT_SERVICE");
		}

		task ("Then: I can see the service name and image details") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "Search");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "liferaycloud/elasticsearch:7.17.1-5.0.0-alpha.1");
		}
	}

	@description = "Clicking service icon redirects to service logs page for selected service"
	@priority = "4"
	test ServiceIconRedirects {
		task ("When: I click on the service icon") {
			Default.Click(
				key_environment = "projtest-infra",
				key_serviceName = "ci",
				locator1 = "Projects#ENVIRONMENT_SERVICE");
		}

		task ("Then: Console redirects to corresponding service logs page") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "ServicesLogs#SERVICE_VERSION",
				value1 = "liferaycloud/jenkins:");

			Default.AssertTextEquals(
				locator1 = "Environment#ENVIRONMENTS_DROPDOWN",
				value1 = "infra");
		}
	}

}