@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Clicking the liveness probe section displays the configurations for the liveness probe"
	@priority = "5"
	test DisplaysLivenessProbeInfo {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: User opens service status popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");

			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_STATUS");

			Default.MouseOver(locator1 = "Services#POPOVER_SERVICE_STATUS");
		}

		task ("And: Click 'Liveness probe parameters'") {
			Default.Click(
				key_probeType = "Liveness",
				locator1 = "Services#PROBE_SECTION");
		}

		task ("Then: Liveliness probe configurations are displayed") {
			Default.AssertElementPresent(
				key_parametersInfo = "initialDelaySeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "initialDelaySeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "600");

			Default.AssertElementPresent(
				key_parametersInfo = "periodSeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "periodSeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "60");

			Default.AssertElementPresent(
				key_parametersInfo = "timeoutSeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "timeoutSeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "60");

			Default.AssertElementPresent(
				key_parametersInfo = "failureThreshold",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "failureThreshold",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "3");
		}
	}

	@description = "Clicking the liveness probe section displays the configurations for the liveness probe"
	@priority = "5"
	test DisplaysReadynessProbeInfo {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: User opens service status popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");

			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_STATUS");

			Default.MouseOver(locator1 = "Services#POPOVER_SERVICE_STATUS");
		}

		task ("And: Click 'Readiness probe parameters'") {
			Default.Click(
				key_probeType = "Readiness",
				locator1 = "Services#PROBE_SECTION");
		}

		task ("Then: Readiness probe configurations are displayed") {
			Default.AssertElementPresent(
				key_parametersInfo = "initialDelaySeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "initialDelaySeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "30");

			Default.AssertElementPresent(
				key_parametersInfo = "periodSeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "periodSeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "60");

			Default.AssertElementPresent(
				key_parametersInfo = "timeoutSeconds",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "timeoutSeconds",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "10");

			Default.AssertElementPresent(
				key_parametersInfo = "failureThreshold",
				locator1 = "Services#PROBE_SECTION_INFO");

			Default.AssertTextEquals(
				key_parametersInfo = "failureThreshold",
				locator1 = "Services#PROBE_SECTION_INFO_VALUE",
				value1 = "2");
		}
	}

	@description = "Hovering over status pill triggers service status popover"
	@priority = "5"
	test DisplaysWhenHoveringStatusPill {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: User opens service popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");
		}

		task ("And: Hovers the mouse over the status pill") {
			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_STATUS");

			Default.MouseOver(locator1 = "Services#POPOVER_SERVICE_STATUS");
		}

		task ("Then: Service status popover is displayed") {
			Default.AssertElementPresent(locator1 = "Services#STATUS_POPOVER");
		}
	}

	@description = "Clicking the 'Learn more' link opens a new tab to documentation regarding probe configurations"
	@priority = "4"
	test LearnMoreLinksToDocumentation {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: User opens service status popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");

			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_STATUS");

			Default.MouseOver(locator1 = "Services#POPOVER_SERVICE_STATUS");
		}

		task ("And: Clicks the Learn More link in Readiness probe parameters section") {
			Default.Click(
				key_probeType = "Readiness",
				locator1 = "Services#PROBE_SECTION");

			Default.Click(locator1 = "Utils#LEARN_MORE_LINK");
		}

		task ("Then: The corresponding documentation page opens") {
			Default.SelectWindow(locator1 = "title=Self-Healing — Liferay Learn");

			Default.AssertElementPresent(
				key_headerTitle = "Self-Healing",
				locator1 = "Utils#HEADER_TITLE");

			Default.Close.closeWindow();
		}
	}

}