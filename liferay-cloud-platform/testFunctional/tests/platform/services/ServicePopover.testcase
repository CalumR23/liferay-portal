@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Header displays service icon, name, image hint and status"
	@priority = "5"
	test DisplaysServiceInformation {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: The user hovers the mouse over the service icon on the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");
		}

		task ("Then: Service icon, name, image hint and status are displayed in the popover") {
			Default.AssertElementPresent(locator1 = "Services#POPOVER_SERVICE_ICON");

			Default.AssertTextEquals(
				locator1 = "Services#POPOVER_SERVICE_NAME",
				value1 = "database");

			Default.AssertTextEquals(
				locator1 = "Services#POPOVER_SERVICE_IMAGE_DETAILS",
				value1 = "liferaycloud/database:5.0.0-alpha.3");

			Default.AssertTextEquals(
				locator1 = "Services#POPOVER_SERVICE_STATUS",
				value1 = "Ready");
		}
	}

	@description = "Metrics for CPU, memory, and transfer are displayed under Usage"
	@priority = "4"
	test DisplaysUsageInformation {
		var service = "webserver";

		var key_serviceName = "${service}";

		task ("When: User hovers the mouse over the service icon on the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");
		}

		task ("Then: Usage cards are displayed") {
			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_NAME");

			Default.AssertElementPresent(
				key_usageCard = "cpu",
				locator1 = "Services#POPOVER_USAGE_CARD");

			Default.AssertElementPresent(
				key_usageCard = "memory",
				locator1 = "Services#POPOVER_USAGE_CARD");

			Default.AssertElementPresent(
				key_usageCard = "transfer",
				locator1 = "Services#POPOVER_USAGE_CARD");
		}
	}

	@description = "Clicking on service icon redirects to service logs page"
	@priority = "4"
	test ServiceIconRedirects {
		var service = "database";

		var key_serviceName = "${service}";

		task ("When: User clicks on the service icon in the service popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");

			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_ICON");

			Default.ClickNoError(locator1 = "Services#POPOVER_SERVICE_ICON");
		}

		task ("Then: Console redirects to service logs page") {
			Default.WaitForElementPresent(
				key_headerTitle = "${service}",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementPresent(
				key_headerTitle = "${service}",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/projtest-dev/services/${service}/logs");
		}
	}

	@description = "Clicking on service name redirects to service logs page"
	@priority = "4"
	test ServiceNameRedirects {
		var service = "liferay";

		var key_serviceName = "${service}";

		task ("When: User clicks service name in the service popover") {
			Utils.goToPage(page = "projects/projtest-dev/services");

			Default.MouseOver(locator1 = "Services#SERVICE_ICON");

			Default.WaitForElementPresent(locator1 = "Services#POPOVER_SERVICE_ICON");

			Default.ClickNoError(locator1 = "Services#POPOVER_SERVICE_NAME");
		}

		task ("Then: Console redirects to service logs page") {
			Default.WaitForElementPresent(
				key_headerTitle = "${service}",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementPresent(
				key_headerTitle = "${service}",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/projtest-dev/services/${service}/logs");
		}
	}

}