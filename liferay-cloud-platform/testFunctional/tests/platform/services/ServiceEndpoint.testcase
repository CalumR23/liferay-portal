@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Topbar.logout();
	}

	@description = "Endpoint pill for service is displayed in the endpoints column"
	@priority = "5"
	test PillIsDisplayed {
		task ("When: Admin user navigates to the Services page with a service deployed") {
			Utils.goToPage(page = "projects/projtest-dev/services");
		}

		task ("Then: The endpoint pill for the service is displayed") {
			Default.AssertElementPresent(
				key_endpointName = "backup",
				locator1 = "Services#ENDPOINTS_PILL");
		}
	}

}