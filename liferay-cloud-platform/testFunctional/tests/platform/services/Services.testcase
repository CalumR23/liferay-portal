@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Topbar.logout();
	}

	@description = "Can assert environment location on overview page"
	@priority = "5"
	test AssertEnvironmentLocation {
		var location = "Iowa, USA";

		task ("Given: A project is created When: The console is redirected to Overview page") {
			ProjectsPage.createNewProject(
				location = "${location}",
				projectName = "poshitest");
		}

		task ("Then: The location is shown on the Location card") {
			Default.AssertElementPresent(
				key_location = "${location}",
				locator1 = "Overview#SERVICE_LOCATION_NAME");
		}
	}

	@description = "Can assert services names on overview page"
	@priority = "5"
	test AssertServicesNames {
		task ("When: I access one environment") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("Then: The deployed services are shown on the Overview page") {
			for (var serviceName : list "backup,database,liferay,search,webserver") {
				Default.AssertElementPresent(
					key_serviceName = "${serviceName}",
					locator1 = "Overview#SERVICE_NAME");
			}
		}
	}

	@description = "Can assert services status on overview page"
	@priority = "5"
	test AssertServicesStatus {
		task ("When: I access one environment") {
			ProjectsPage.openEnvironment(environmentName = "projtest-dev");
		}

		task ("Then: The status of deployed services are presented on the Overview page") {
			for (var serviceName : list "backup,database,liferay,search,webserver") {
				Default.AssertElementPresent(
					key_serviceName = "${serviceName}",
					key_serviceStatus = "Ready",
					locator1 = "Overview#SERVICE_STATUS");
			}
		}
	}

	@description = "Toast appears when a service is restarted and a <serviceId> activity is generated"
	@priority = "4"
	test CanRestartsService {
		task ("When: Admin user restarts a service") {
			Utils.goToPage(page = "projects/projtest-infra/services");

			ServicesPage.selectActionMenuOption(
				menuOption = "Restart service",
				service = "ci");
		}

		task ("Then: 'Restart service request sent' message is displayed in a toast") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Restart service request sent. ci will restart soon");
		}

		task ("And: An activity is generated and shown in the environment's activity history") {
			Utils.goToPage(page = "projects/projtest-infra/activities");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE",
				value1 = "Service restarted");
		}
	}

	@description = "Clicking Delete service redirects to Delete service page"
	@priority = "5"
	test DeleteServiceRedirects {
		task ("When: User clicks 'Delete service' option in action menu") {
			Utils.goToPage(page = "projects/projtest-infra/services");

			Default.Click(
				key_serviceName = "ci",
				locator1 = "Services#ACTION_MENU_ICON");

			Default.Click(
				key_menuOption = "Delete service",
				locator1 = "Services#ACTION_MENU_OPTION");
		}

		task ("Then: Console redirects to the Delete Service page") {
			Default.AssertElementPresent(
				key_headerTitle = "Delete Service",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/projtest-infra/services/ci/delete");
		}
	}

	@description = "Service row displays each service deployed"
	@priority = "5"
	test DeployedDisplaysOnTable {
		task ("Given: A new project is created When: The user deploys new services") {
			ProjectsAPI.createProject(projectID = "qaposhitest");

			NewDeploymentAPI.deployFromRepo(
				projectID = "qaposhitest",
				repo = "2-services");

			Utils.goToPage(page = "projects/qaposhitest/services");
		}

		task ("Then: The service list will display the services that are deployed") {
			Default.AssertElementPresent(
				key_serviceName = "ui",
				locator1 = "Services#SERVICE_NAME");

			Default.AssertElementPresent(
				key_serviceName = "alpine",
				locator1 = "Services#SERVICE_NAME");
		}
	}

	@description = "Action menu icon displays if logged in user has permissions to take at least one action for the service"
	@priority = "5"
	test DisplaysActionMenu {
		task ("When: Admin user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-infra/services");
		}

		task ("Then: The action menu icon is displayed") {
			Default.AssertElementPresent(
				key_serviceName = "ci",
				locator1 = "Services#ACTION_MENU_ICON");
		}

		task ("When: Guest user logs in") {
			Topbar.logout();

			LoginPage.loginAsGuest();
		}

		task ("And: Guest user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-infra/services");
		}

		task ("Then: The action menu icon is not displayed") {
			Default.AssertElementNotPresent(
				key_serviceName = "ci",
				locator1 = "Services#ACTION_MENU_ICON");
		}
	}

	@description = "Clicking action menu icon displays menu option(s)"
	@priority = "5"
	test DisplaysActionMenuOptions {
		task ("When: Admin user clicks action menu icon") {
			Utils.goToPage(page = "projects/projtest-infra/services");

			Default.Click(
				key_serviceName = "ci",
				locator1 = "Services#ACTION_MENU_ICON");
		}

		task ("Then: Menu options are displayed") {
			Default.AssertElementPresent(
				key_menuOption = "Restart service",
				locator1 = "Services#ACTION_MENU_OPTION");

			Default.AssertElementPresent(
				key_menuOption = "Delete service",
				locator1 = "Services#ACTION_MENU_OPTION");
		}
	}

	@description = "Can assert placeholder message on services page when there are no services"
	@priority = "3"
	test DisplaysMessageForNoServicesYet {
		task ("Given: A new project is created When: The console is redirected to the Services page") {
			ProjectsAPI.createProject(projectID = "qaposhitest");

			Utils.goToPage(page = "projects/qaposhitest/services");
		}

		task ("Then: The service page will show there are no services yet") {
			Default.AssertTextEquals(
				locator1 = "Services#NO_SERVICE_TITLE",
				value1 = "No services yet");
		}
	}

	@description = "Service table header displays number of services deployed"
	@priority = "4"
	test DisplayTableHeaderCount {
		task ("Given: A new project is created When: The user navigates to the services page and deploys a service") {
			ProjectsAPI.createProject(projectID = "qaposhitest");

			Utils.goToPage(page = "projects/qaposhitest/services");

			Default.AssertTextEquals(
				locator1 = "Services#NO_SERVICE_TITLE",
				value1 = "No services yet");

			NewDeploymentAPI.deployFromRepo(
				projectID = "qaposhitest",
				repo = "hosting");
		}

		task ("Then: The header for the Service table will display the number of Services deployed") {
			Default.AssertElementPresent(
				key_serviceNumber = "1",
				locator1 = "Services#SERVICE_HEADER_NUMBER");
		}
	}

	@description = "Service row displays service icon"
	@priority = "3"
	test IconIsDisplayed {
		task ("When: The user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");
		}

		task ("Then: Services icons are displayed for services provisioned in the environment") {
			for (var service : list "backup,database,liferay,search,webserver") {
				Default.AssertElementPresent(
					key_serviceName = "${service}",
					locator1 = "Services#SERVICE_ICON");
			}
		}
	}

	@description = "Service row displays service name"
	@priority = "5"
	test NameIsDisplayed {
		task ("When: The user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");
		}

		task ("Then: Services names are displayed for services provisioned in the environment") {
			for (var services : list "backup,database,liferay,search,webserver") {
				Default.AssertTextEquals(
					key_serviceName = "${services}",
					locator1 = "Services#SERVICE_NAME",
					value1 = "${services}");
			}
		}
	}

	@description = "Clicking on the service name redirects to the service's logs page"
	@priority = "4"
	test NameRedirectsToServiceLogs {
		var environmentName = "infra";

		task ("When: User clicks on a service name at the Services page") {
			Utils.goToPage(page = "projects/projtest-${environmentName}/services");

			Default.Click(
				key_serviceName = "ci",
				locator1 = "Services#SERVICE_NAME");
		}

		task ("Then: Console redirects to that service's logs page") {
			Default.AssertLocation.assertPartialLocation(value1 = "projects/projtest-${environmentName}/services/ci/logs");
		}
	}

	@description = "Hovering over service icon displays service popover"
	@priority = "5"
	test PopoverIsDisplayedOnHover {
		task ("When: The user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");
		}

		task ("And: Hovers over the services icons Then: Service popover is displayed") {
			for (var service : list "backup,database,liferay,search,webserver") {
				var key_serviceName = "${service}";

				Default.MouseOver(locator1 = "Services#SERVICE_ICON");

				Default.AssertElementPresent(locator1 = "Services#SERVICE_POPOVER");
			}
		}
	}

	@description = "Services in ready status will display green Ready pill in the Status column"
	@priority = "5"
	test ReadyStatusIsDisplayed {
		task ("When: The user navigates to the Services page") {
			Utils.goToPage(page = "projects/projtest-dev/services");
		}

		task ("Then: The service will display a green Ready pill") {
			Default.AssertElementPresent(
				key_statusPill = "Ready",
				locator1 = "Services#STATUS_PILL");
		}
	}

}