@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	var projectName = "qaposhitest";

	setUp {
		Utils.launchLCP();

		ProjectsAPI.createProject(projectID = "qaposhitest");

		NewDeploymentAPI.deployFromRepo(
			projectID = "${projectName}",
			repo = "hosting");

		LoginPage.login();
	}

	tearDown {
		UtilsAPI.tearDownProjects(projectIdList = "qaposhitest");

		LoginPage.logout();
	}

	@description = "Clicking Cancel button returns user to previous page"
	@priority = "5"
	test CancelButtonRedirects {
		task ("When: User navigates to delete service page") {
			Default.WaitForElementPresent(
				key_environment = "${projectName}",
				key_serviceName = "ui",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Utils.goToPage(page = "projects/${projectName}/services/ui/delete");
		}

		task ("Then: Cancel button is displayed") {
			Default.AssertElementPresent(
				key_btnName = "Cancel",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("When: Clicks the 'Cancel' button") {
			Default.Click(
				key_btnName = "Cancel",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: The console is redirected to the service page") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "ServicesLogs#SERVICE_NAME",
				value1 = "ui-${projectName}");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectName}/services/ui/logs");
		}
	}

	@description = "Toast appears when a service is deleted and a <serviceId> activity is generated"
	@priority = "5"
	test CanDeletesService {
		task ("When: User deletes the service") {
			Default.WaitForElementPresent(
				key_environment = "${projectName}",
				key_serviceName = "ui",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Utils.goToPage(page = "projects/${projectName}/services/ui/delete");

			for (var checkbox : list "deletion is not advised,redeploy") {
				Default.Check.toggleSwitch(
					key_checkboxName = "${checkbox}",
					locator1 = "Utils#ANY_CHECKBOX");
			}

			Default.Click(locator1 = "Utils#DANGER_BUTTON");
		}

		task ("Then: A toast display indicating that the service has been deleted") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Service deleted");
		}

		task ("And: User is redirected to the service page") {
			Default.AssertElementPresent(
				key_headerTitle = "Services",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectName}/services");
		}

		task ("And: The deleted service is not displayed in the list of deployed services") {
			Default.AssertElementNotPresent(
				key_serviceName = "ui",
				locator1 = "Services#SERVICE_NAME");
		}

		task ("And: An activity is generated and shown in the environment's activity history") {
			Utils.goToPage(page = "projects/${projectName}/activities");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE",
				value1 = "Service deleted");

			Default.AssertTextEquals.assertPartialText(
				locator1 = "Activities#LAST_ACTIVITY_MESSAGE_SUBTITLE",
				value1 = "Ui");
		}
	}

	@description = "Delete service button is enabled when all checkboxes are selected"
	@priority = "5"
	test DeleteServiceConfirmationCheckboxes {
		task ("When: User accesses the Delete Service page") {
			Default.WaitForElementPresent(
				key_environment = "${projectName}",
				key_serviceName = "ui",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Utils.goToPage(page = "projects/${projectName}/services/ui/delete");
		}

		task ("Then: User sees that all checkboxes are not checked") {
			for (var checkbox : list "deletion is not advised,redeploy") {
				Default.AssertNotChecked.assertNotCheckedNotVisible(
					key_checkboxName = "${checkbox}",
					locator1 = "Utils#ANY_CHECKBOX");
			}
		}

		task ("And: Delete Service button is disabled by default") {
			Default.AssertElementPresent(locator1 = "Utils#DANGER_BUTTON_DISABLED");
		}

		task ("When: User selects all checkboxes") {
			for (var checkbox : list "deletion is not advised,redeploy") {
				Default.Check.toggleSwitch(
					key_checkboxName = "${checkbox}",
					locator1 = "Utils#ANY_CHECKBOX");
			}
		}

		task ("Then: User sees that the Delete Service button is enabled") {
			Default.AssertElementNotPresent(locator1 = "Utils#DANGER_BUTTON_DISABLED");

			Default.AssertElementPresent(locator1 = "Utils#DANGER_BUTTON");
		}
	}

	@description = "Service section displays service name, image name, status, and instances"
	@priority = "3"
	test DisplaysServiceInformation {
		task ("When: User navigates to delete service page") {
			Default.WaitForElementPresent(
				key_environment = "${projectName}",
				key_serviceName = "ui",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Utils.goToPage(page = "projects/${projectName}/services/ui/delete");
		}

		task ("Then: Service section displays service name, image name, status, and instances") {
			Default.AssertTextEquals(
				locator1 = "DeleteService#SERVICE_NAME",
				value1 = "ui");

			Default.AssertTextEquals(
				locator1 = "DeleteService#IMAGE_NAME",
				value1 = "wedeploy/hosting:2.0.1");

			Default.AssertElementPresent(locator1 = "DeleteService#STATUS_PILL");

			Default.AssertTextEquals(
				locator1 = "DeleteService#INSTANCES_PILL",
				value1 = "1 of 1");
		}
	}

	@description = "Delete service page displays warning about deleting a service"
	@priority = "3"
	test DisplayWarningMessage {
		task ("When: User navigates to delete service page") {
			Default.WaitForElementPresent(
				key_environment = "${projectName}",
				key_serviceName = "ui",
				locator1 = "Projects#ENVIRONMENT_SERVICE");

			Utils.goToPage(page = "projects/${projectName}/services/ui/delete");
		}

		task ("Then: Warning message is displayed") {
			Default.AssertTextEquals(
				locator1 = "DeleteProject#WARNING_MESSAGE",
				value1 = "Warning: deleting a service cannot be undone! Confirm the deletion before proceeding.");
		}
	}

}