@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();
	}

	@description = "User can go to Reset Password page via Forgot your password link on the Login page"
	@priority = "4"
	test CanBeOpenFromLoginPage {
		task ("When: User clicks 'Forgot your password?' link on Login page") {
			Default.Click(
				key_linkText = "Forgot your password?",
				locator1 = "Authentication#REDIRECT_LINK");
		}

		task ("Then: Console redirects to Reset Password page") {
			Default.AssertElementPresent(
				key_headerTitle = "Reset Password",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "User can go to Reset Password page via link on Profile page"
	@priority = "4"
	test CanBeOpenFromProfilePage {
		task ("When: User clicks on 'Forgot your password?' link at the Profile page") {
			Authentication.login();

			Utils.goToPage(page = "account/profile");

			Default.Click(
				key_linkText = "Reset password",
				locator1 = "Authentication#REDIRECT_LINK");
		}

		task ("Then: User is redirected to the Reset Password page") {
			Default.AssertElementPresent(
				key_headerTitle = "Reset Password",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

	@description = "Properly formatted email must be provided"
	@priority = "3"
	test EmailFieldValidationWorks {
		task ("When: User inputs an email without correct formatting at the Reset Password page") {
			Utils.goToPage(page = "password/reset");

			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "@test.com");
		}

		task ("Then: A warning message is displayed") {
			Default.AssertTextEquals(
				key_errorClass = "error",
				key_warningMessageId = "emailHelp",
				locator1 = "Utils#GENERIC_WARNING",
				value1 = "The provided email is not valid");
		}

		task ("When: User enters a valid email") {
			Default.Type(
				key_inputId = "email",
				locator1 = "Utils#INPUT_FIELD",
				value1 = "test@test.com");
		}

		task ("Then: No warning message is displayed") {
			Default.AssertElementNotPresent(
				key_errorClass = "error",
				key_warningMessageId = "emailHelp",
				locator1 = "Utils#GENERIC_WARNING",
				value1 = "The provided email is not valid");
		}
	}

}