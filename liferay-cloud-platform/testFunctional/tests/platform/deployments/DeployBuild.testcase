@component-name = "liferay-cloud-platform"
definition {

	var projectID = "projtest";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		Utils.tearDownProjects();

		LoginPage.logout();
	}

	@description = "Clicking Branch or Commit opens github page in new tab"
	@priority = "3"
	test OpensGitHub {
		task ("When: The user navigates to the Builds page") {
			Utils.goToPage(page = "projects/${projectID}/deploy/5");
		}

		task ("And: The user clicks on Branch pill") {
			var branchName = DeployBuildsPage.getPillValue(key_pillName = "branch");

			Default.Click(
				key_pillName = "branch",
				locator1 = "DeployBuild#SELECTED_BUILD_CLICKABLE_PILL");
		}

		task ("Then: GitHub branch page opens in a new tab") {
			Default.SelectWindow(locator1 = "title=Page not found · GitHub · GitHub");

			Default.AssertLocation.assertPartialLocation(value1 = "github.com/dxpcloud-dev/${projectID}/tree/${branchName}");

			Default.Close.closeWindow();
		}

		task ("When: The user clicks on Commit pill") {
			var commitHash = DeployBuildsPage.getPillValue(key_pillName = "commit");

			Default.Click(
				key_pillName = "commit",
				locator1 = "DeployBuild#SELECTED_BUILD_CLICKABLE_PILL");
		}

		task ("Then: GitHub commit page opens in a new tab") {
			Default.SelectWindow(locator1 = "title=Page not found · GitHub · GitHub");

			Default.AssertLocation.assertPartialLocation(value1 = "github.com/dxpcloud-dev/${projectID}/commit/${commitHash}");

			Default.Close.closeWindow();
		}
	}

}