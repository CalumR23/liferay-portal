@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	var projectId = "projtest";

	setUp {
		Utils.launchLCP();

		Utils.goToPage(page = "projects/${projectId}-dev/settings/view-vpn");

		Authentication.login();

		ViewVPN.connectVPN();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "If VPN is not connected, the 'Connect' button is shown"
	@priority = "5"
	test CanConnect {
		task ("When: User disconnects VPN") {
			ViewVPN.disconnectVPN();
		}

		task ("Then: Connect button is displayed") {
			Default.AssertElementPresent(
				key_buttonName = "Connect",
				locator1 = "Utils#GENERIC_BUTTON");
		}

		task ("When: User clicks connect button") {
			Default.Click(
				key_buttonName = "Connect",
				locator1 = "Utils#GENERIC_BUTTON");
		}

		task ("Then: Connected vpn") {
			Default.AssertTextEquals(
				locator1 = "ViewVPN#VPN_STATUS",
				value1 = "Connected");
		}
	}

	@description = "Selecting 'Disconnect' in the VPN menu will disconnect the VPN"
	@priority = "5"
	test CanDisconnect {
		task ("When: User goes to ellipsis and clicks disconnect") {
			Default.Click(locator1 = "ViewVPN#ELLIPSIS_BUTTON");

			Default.Click(
				key_item = "Disconnect",
				locator1 = "Utils#ELLIPSIS_MENU_ITEM");
		}

		task ("And: User confirms that he wants to disconnect the VPN") {
			for (var checkbox : list "disconnection will permanently interrupt,disconnection may cause") {
				Default.Click(
					key_stackItem = "${checkbox}",
					locator1 = "DisconnectVPN#DISCONNECT_CONFIRMATION_CHECKBOX");
			}

			Default.Click(
				key_btnName = "Disconnect VPN",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: VPN status is 'not connected'") {
			Default.AssertTextEquals(
				locator1 = "ViewVPN#VPN_STATUS",
				value1 = "Not Connected");
		}
	}

	@description = "Clicking 'Show more activities' will redirect the user to /view-vpn/activities page"
	@ignore = "Test Stub"
	@priority = "3"
	test MoreActivitiesRedirects {

		// LRQA-77852 MoreActivitiesRedirects pending implementation

	}

	@description = "Selecting 'Learn more about VPN' in the VPN menu will open the corresponding documentation in a new tab"
	@ignore = "Test Stub"
	@priority = "3"
	test PageLinksToDocumentation {

		// LRQA-77847 PageLinksToDocumentation pending implementation

	}

	@description = "Selecting 'Delete VPN' in the VPN menu will redirect the user to the /delete-vpn page"
	@ignore = "Test Stub"
	@priority = "3"
	test PageRedirectsToDeleteVPN {

		// LRQA-77848 PageRedirectsToDeleteVPN pending implementation

	}

	@description = "Clicking the 'Edit' button redirects the user to the /edit-vpn page"	
	@priority = "4"
	test PageRedirectsToEditVPN {
		task ("When: The 'Edit' button is displayed") {
			Default.AssertTextEquals(
				locator1 = "ViewVPN#VPN_STATUS",
				value1 = "Connected");

			Default.AssertElementPresent(locator1 = "ViewVPN#EDIT_BUTTON");
		}

		task ("And: User clicks on 'Edit' button") {
			Default.Click(locator1 = "ViewVPN#EDIT_BUTTON");
		}

		task ("Then: Console redirects to Edit VPN page") {
			Default.AssertElementPresent(
				key_headerTitle = "Edit VPN",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectId}-dev/settings/edit-vpn");
		}
	}

	@description = "Selecting 'See VPN logs' in the VPN menu will redirect the user to the filtered VPN logs"
	@ignore = "Test Stub"
	@priority = "3"
	test PageRedirectsToVPNLogs {

		// LRQA-77845 PageRedirectsToVPNLogs pending implementation

	}

	@description = "If VPN is not connected, a warning banner is displayed 'Warning: VPN is not connected. Please connect VPN'"
	@ignore = "Test Stub"
	@priority = "3"
	test PageShowsConnectionBanner {

		// LRQA-77849 PageShowsConnectionBanner pending implementation

	}

	@description = "Hover on Protocol tooltip shows suites of transmission and encryption"
	@priority = "5"
	test ProtocolTooltipInformation {
		task ("When: User hovers over protocol") {
			Default.MouseOver(
				key_itemName = "Protocol",
				locator1 = "ViewVPN#QUESTION_MARK_ICON");
		}

		task ("Then: A tooltip displays with information about the vpn protocol") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "ViewVPN#TOOLTIP_TITLE",
				value1 = "VPN protocols are");
		}
	}

	@description = "Hovering on the time will show a tooltip with the time indicating that it is in UTC"
	@ignore = "Test Stub"
	@priority = "4"
	test TimeTooltipInformation {

		// LRQA-77842 TimeTooltipInformation pending implementation

	}

}