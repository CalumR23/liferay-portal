@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	var projectName = "projtest";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Utils.tearDownProjects();

		Authentication.logout();
	}

	@description = "Hovering over the services badges displays a tooltip with the full service name"
	@priority = "3"
	test DisplayTooltips {
		task ("When: The user hovers the mouse over the service badge") {
			Utils.goToPage(page = "projects/${projectName}-dev/settings/secrets/lcp-test-secret/delete");

			Default.MouseOver(
				key_secretName = "lcp-test-secret",
				key_serviceName = "webserver",
				locator1 = "Settings#SERVICE_ICON");
		}

		task ("Then: A tooltip with the full service name is displayed") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "webserver liferaycloud/nginx:");
		}
	}

	@description = "Warning banner is displayed on top of the Delete secret page"
	@priority = "4"
	test DisplayWarningMessage {
		task ("When: The user navigates to the delete secret page") {
			Utils.goToPage(page = "projects/${projectName}-dev/settings/secrets/lcp-test-secret/delete");
		}

		task ("Then: The user sees that a warning message is displayed on the page") {
			Default.AssertTextEquals(
				locator1 = "DeleteProject#WARNING_MESSAGE",
				value1 = "Warning: This cannot be undone! All data related to this secret may be destroyed.");
		}
	}

}