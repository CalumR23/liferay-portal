@component-name = "liferay-cloud-platform"
definition {

	var projectID = "projtest";
	var secretName = "lcp-secret-projtest-test";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		LoginPage.login();
	}

	tearDown {
		LoginPage.logout();
	}

	@description = "Clicking the :secretId back button redirects the user to the /projects/<projectId>/settings/secrets/<secretId>/view page"
	@priority = "5"
	test BackButtonRedirects {
		task ("When: User clicks in <secretId> back button") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");

			Default.Click(
				key_secretName = "${secretName}",
				locator1 = "EditSecret#SECRET_ID_BACK_BUTTON");
		}

		task ("Then: Console redirects to View Secret page") {
			Default.AssertTextEquals(
				key_itemName = "${secretName}",
				locator1 = "Utils#TABLE_ITEM",
				value1 = "${secretName}");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectID}-dev/settings/secrets/${secretName}/view");
		}
	}

	@description = "User can't uncheck Admin role for 'Can view' secret section"
	@priority = "5"
	test CannotUncheckAdminCheckbox {
		task ("When: User navigates to the Edit Secret page") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");
		}

		task ("Then: The 'Admin' checkbox selection is disabled") {
			Default.AssertElementPresent(
				key_headerTitle = "Edit Secret",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementPresent(
				key_checkboxName = "ADMIN",
				locator1 = "Utils#CHECKBOX_DISABLED");
		}
	}

	@description = "Value of the secret in the input field can be hidden or shown"
	@priority = "5"
	test CanShowSecretValue {
		task ("When: User navigates to the Edit Secret page") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");
		}

		task ("Then: The value of the secret is hidden") {
			Default.AssertTextEquals(
				key_inputField = "Enter value",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "••••••••••••••••••••••••••••••");
		}

		task ("When: User tries to edit the value input field that is hidden") {
			Default.Click(
				key_inputField = "Enter value",
				locator1 = "Secrets#SECRETS_INPUT_FIELD");
		}

		task ("Then: A warning message is displayed") {
			Default.AssertTextEquals.assertPartialText(
				locator1 = "EditSecret#VALUE_FOOTER_MESSAGE",
				value1 = "To edit, reveal the content by clicking");
		}

		task ("When: User clicks 'Show' button") {
			Default.Click(
				key_btnName = "Show",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: The value of the secret is shown") {
			Default.AssertTextEquals(
				key_inputField = "Enter value",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "dxpcloud");
		}
	}

	@description = "Error messages are displayed if Name, Description or Value fields are left blank"
	@priority = "3"
	test DisplayErrorMessageForBlankInfo {
		task ("When: User submits changes without informing Name, Description and/or Value") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");

			Default.Type(
				key_inputField = "Enter name",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "");

			Default.Type(
				key_inputField = "Enter description",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "");

			Default.Click(
				key_btnName = "Show",
				locator1 = "Utils#CLICK_BUTTON");

			Default.Type(
				key_inputField = "Enter value",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: A warning message is displayed for each field submitted without content") {
			Default.AssertTextEquals(
				key_fieldName = "name",
				locator1 = "EditSecret#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter secret name");

			Default.AssertTextEquals(
				key_fieldName = "description",
				locator1 = "EditSecret#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter secret description");

			Default.AssertTextEquals(
				key_fieldName = "Value",
				locator1 = "EditSecret#REQUIRED_PARAMETER_WARNING",
				value1 = "Please enter value");
		}
	}

	@description = "If a user checks a service in 'Used in' the 'Key' value for that field is a required field and an error message is displayed if it's left blank"
	@priority = "5"
	test DisplayErrorMessageForBlankKeyField {
		task ("When: User tries to link a secret to a service without typing a key") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");

			SecretsPage.useSecretInService(
				keyValue = "",
				service = "backup");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: A warning message is displayed") {
			Default.AssertTextEquals(
				key_fieldName = "backup",
				locator1 = "EditSecret#INVALID_PARAMETER_WARNING",
				value1 = "Please enter secret service key");
		}
	}

	@description = "Secret information is displayed in the Edit secret page input fields"
	@priority = "5"
	test DisplaySecretsInfo {
		task ("When: User navigates to the Edit Secret page") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");
		}

		task ("Then: Secret information is displayed in the input fields") {
			Default.AssertTextEquals(
				key_inputField = "Enter name",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "${secretName}");

			Default.AssertTextEquals(
				key_inputField = "Enter description",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "Secret for test");
		}
	}

	@description = "Error message is displayed when Name field is filled with invalid characters"
	@priority = "4"
	test DisplayValidationMessages {
		task ("When: User tries to submit the name field with an invalid character") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");

			Default.Type(
				key_inputField = "Enter name",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "lcp-secret-*");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: A warning message is displayed") {
			Default.AssertTextEquals(
				key_fieldName = "name",
				locator1 = "EditSecret#INVALID_PARAMETER_WARNING",
				value1 = "Invalid name");
		}

		task ("When: User tries to submit the name field with underscore characters") {
			Default.Type(
				key_inputField = "Enter name",
				locator1 = "Secrets#SECRETS_INPUT_FIELD",
				value1 = "lcp_secret");

			Default.Click(locator1 = "Utils#SUBMIT_BUTTON");
		}

		task ("Then: A warning message is displayed") {
			Default.AssertTextEquals(
				key_fieldName = "name",
				locator1 = "EditSecret#INVALID_PARAMETER_WARNING",
				value1 = "Invalid name");
		}
	}

}