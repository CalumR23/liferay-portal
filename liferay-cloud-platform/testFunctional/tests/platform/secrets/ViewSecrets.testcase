@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	var projectId = "projtest";

	setUp {
		Utils.launchLCP();

		Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets");

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Access control section displays team role badges for the roles set as 'Can view' for that secret and a link to Edit"
	@priority = "5"
	test AccessControlInformation {
		task ("When: Admin user navigates to Secrets page") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/lcp-secret-database-name/view");
		}

		task ("Then: User can see team badges for the roles defined as 'Can see' in the Access Control card") {
			Default.AssertTextEquals(
				locator1 = "Settings#ENVIRONMENT_BADGE",
				value1 = "Admin");
		}

		task ("And: User can see the 'Edit' link") {
			Default.AssertElementPresent(
				key_cardId = "control",
				key_link = "Edit",
				locator1 = "Secrets#ACTION_FRAME_LINK");
		}
	}

	@description = "Secret value viewed <secret name> activity is generated on viewing secret value"
	@ignore = "Test Stub"
	@priority = "5"
	test ActivityIsGenerated {

		// LRQA-77816 ActivityIsGenerated pending implementation

	}

	@description = "All activities related to the secret are displayed in a list under 'Related activities' section"
	@priority = "4"
	test DisplaysRelatedActivities {
		task ("When: The user reveals the secret value") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/lcp-test-secret");

			Default.Click(
				key_btnName = "View",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Secret value revealed");
		}

		task ("Then: The activity is displayed in the first line of the list under 'Related activities' section") {
			for (var valueRow : list "Secret value viewed,just now") {
				Default.WaitForElementPresent(
					locator1 = "ViewSecrets#ACTIVITY_LIST",
					Row_order = "1",
					value1 = "${key_row}");
			}
		}
	}

	@description = "Hovering over the secret name displays a tooltip with the full secret name"
	@priority = "4"
	test FullNameOnHover {
		var secretName = "lcp-secret-database-name";

		task ("When: The user hovers the mouse over the secret name") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/${secretName}/view");

			Default.MouseOver(
				key_secretName = "${secretName}",
				locator1 = "ViewSecrets#SECRET_NAME");
		}

		task ("Then: A tooltip with the full secret name is displayed") {
			Default.AssertTextEquals(
				locator1 = "Settings#QUESTION_MARK_TOOLTIP",
				value1 = "${secretName}");
		}
	}

	@description = "'Contributor' can only view the secret if the 'Can view' section has been set for these roles"
	@priority = "5"
	test HiddenValuesContributorPermission {

		// TODO LCD-22610 HiddenValuesContributorPermission pending implementation

	}

	@description = "'Guest' can only view the secret if the 'Can view' section has been set for these roles"
	@priority = "5"
	test HiddenValuesGuestPermission {

		// TODO LCD-22610 HiddenValuesGuestPermission pending implementation

	}

	@description = "'Owner' or 'Administrator' user can view the secret."
	@priority = "5"
	test HiddenValuesOwnerAndAdminPermissions {
		var projectId = "qaposhisecret";
		var secretName = "lcp-secret-name";
		var secretValue = "lcp-secret-name";

		task ("Given: I create a project And: Create a secret") {
			ProjectsAPI.createProject(projectID = "${projectId}");

			SecretsAPI.createSecret(
				projectId = "${projectId}",
				secretDescription = "lcp-secret-description",
				secretName = "${secretName}",
				secretValue = "${secretValue}");
		}

		task ("When: The Owner user clicks 'View' button on the Secrets page") {
			Utils.goToPage(page = "projects/${projectId}/settings/secrets/${secretName}");

			Default.Click(
				key_btnName = "View",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: A toast message is displayed indicating that the value of the secret is revealed") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Secret value revealed");
		}

		task ("When: The user signs in as an Admin user") {
			InvitationAPI.addTeamMember(
				email = PropsUtil.get("test.this.lcp.test.account.guest.user.email"),
				projectId = "${projectId}",
				role = "admin");

			Authentication.logout();

			Authentication.loginAsGuest();
		}

		task ("And: The admin user clicks 'View' button on the Secrets page") {
			Utils.goToPage(page = "projects/${projectId}/settings/secrets/${secretName}");

			Default.Click(
				key_btnName = "View",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("Then: A toast message is displayed indicating that the value of the secret is revealed") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Secret value revealed");
		}
	}

	@description = "Secret name, 'Secret Description', 'Created by', 'Used in', and 'Latest update' information are displayed on the top of View Secret page"
	@ignore = "Test Stub"
	@priority = "4"
	test InformationOnPage {

		// TODO LRQA-77804 InformationOnPage pending implementation

	}

	@description = "Clicking on 'Learn more about Secrets' on the ellipsis menu redirects to the corresponding documentation"
	@ignore = "Test Stub"
	@priority = "3"
	test LinksToDocumentation {

		// LRQA-77814 LinksToDocumentation pending implementation

	}

	@description = "Clicking on 'Show more activities' redirects to the secret activities page"
	@priority = "3"
	test PageRedirectsToActivities {
		task ("When: User clicks 'Show more activities' on View Secret page") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/lcp-secret-database-name/view");

			Default.Click(
				key_linkText = "Show more activities",
				locator1 = "Utils#EXTERNAL_LINK");
		}

		task ("Then: Console redirects to 'Related Activities' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Related Activities",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectId}-dev/settings/secrets/lcp-secret-database-name/activities");
		}
	}

	@description = "Clicking on 'Delete secret' redirects to Delete secret page"
	@ignore = "Test Stub"
	@priority = "4"
	test PageRedirectsToDeleteSecret {

		// LRQA-77815 PageRedirectsToDeleteSecret pending implementation

	}

	@description = "Clicking the 'Edit' button and the edit button in 'Can view' under the 'Access Control' section redirects to the Edit secret page"
	@priority = "4"
	test PageRedirectsToEditSecret {
		var secretName = "lcp-secret-database-name";

		task ("When: User clicks Edit button in the 'Can view' section") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/${secretName}/view");

			Default.Click(
				key_linkName = "Edit",
				locator1 = "ViewSecrets#EDIT_ACCESS_CONTROL");
		}

		task ("Then: User is redirected to 'Edit Secret' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Edit Secret",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectId}-dev/settings/secrets/${secretName}/edit");
		}

		task ("When: User is on VPN details page and clicks the 'Edit' button") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/${secretName}/view");

			Default.Click(locator1 = "ViewSecrets#EDIT_VIEW_SECRET");
		}

		task ("Then: User is redirected to 'Edit Secret' page") {
			Default.AssertElementPresent(
				key_headerTitle = "Edit Secret",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectId}-dev/settings/secrets/${secretName}/edit");
		}
	}

	@description = "Clicking on a row under Environment variables redirects to the Environment Variables page for that specific service"
	@priority = "3"
	test RedirectsToEnvVariables {
		task ("When: User clicks a row under Environment variables") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/lcp-secret-database-name/view");

			Default.Click(
				key_serviceName = "database",
				locator1 = "ViewSecrets#ENVIRONMENT_VARIABLES");
		}

		task ("Then: Console redirects to the Service Environment Variable page") {
			Default.AssertElementPresent(
				key_headerTitle = "database",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectId}-dev/services/database/environment-variables");
		}
	}

	@description = "User can copy the secret value by clicking on it when the secret value is displayed"
	@priority = "3"
	test ValuesCanBeCopied {
		task ("When: User clicks 'view' to reveal the secret value") {
			Utils.goToPage(page = "projects/${projectId}-dev/settings/secrets/lcp-secret-database-name/view");

			Default.Click(
				key_btnName = "View",
				locator1 = "Utils#CLICK_BUTTON");

			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Secret value revealed");
		}

		task ("Then: User clicks secret value to copy") {
			Default.Click(
				key_btnName = "lportal",
				locator1 = "Utils#CLICK_BUTTON");
		}

		task ("And: A toast appears indicating the secret was copied") {
			Default.AssertTextEquals(
				locator1 = "Utils#GENERIC_TOAST_NOTIFICATION",
				value1 = "Secret value copied to your clipboard");
		}
	}

}