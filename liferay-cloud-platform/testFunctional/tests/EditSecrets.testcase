@component-name = "liferay-cloud-platform"
definition {

	var projectID = "projtest";
	var secretName = "lcp-secret-projtest-test";

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	tearDown {
		Authentication.logout();
	}

	@description = "Clicking the :secretId back button redirects the user to the /projects/<projectId>/settings/secrets/<secretId>/view page"
	@priority = "5"
	test BackButtonRedirects {
		task ("When: User clicks in <secretId> back button") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");

			Default.Click(
				key_secretName = "${secretName}",
				locator1 = "EditSecret#SECRET_ID_BACK_BUTTON");
		}

		task ("Then: Console redirects to View Secret page") {
			Default.AssertTextEquals(
				key_itemName = "${secretName}",
				locator1 = "Utils#TABLE_ITEM",
				value1 = "${secretName}");

			Default.AssertLocation.assertPartialLocation(value1 = "projects/${projectID}-dev/settings/secrets/${secretName}/view");
		}
	}

	@description = "User can't uncheck Admin role for 'Can view' secret section"
	@priority = "5"
	test CannotUncheckAdminCheckbox {
		task ("When: User navigates to the Edit Secret page") {
			Utils.goToPage(page = "projects/${projectID}-dev/settings/secrets/${secretName}/edit");
		}

		task ("Then: The 'Admin' checkbox selection is disabled") {
			Default.AssertElementPresent(
				key_headerTitle = "Edit Secret",
				locator1 = "Utils#HEADER_TITLE");

			Default.AssertElementPresent(
				key_checkboxName = "ADMIN",
				locator1 = "Utils#CHECKBOX_DISABLED");
		}
	}

}