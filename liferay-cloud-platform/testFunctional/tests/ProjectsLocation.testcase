@component-name = "liferay-cloud-platform"
definition {

	property testray.main.component.name = "liferay-cloud-platform";

	setUp {
		Utils.launchLCP();

		Authentication.login();
	}

	@description = "Location pill displays with flag, state, and country. When clicking the pill the console is redirected to the project settings page"
	@priority = "4"
	test DisplayLocationPill {
		task ("Given: The console is in the Project Page") {
			Default.AssertElementPresent(
				key_headerTitle = "Projects",
				locator1 = "Utils#HEADER_TITLE");
		}

		task ("Then: Location pill displays with flag, state, and country") {
			Default.AssertElementPresent(
				key_environment = "projtest-dev",
				key_location = "Oregon, USA",
				locator1 = "Projects#ENVIRONMENT_LOCATION");

			Default.AssertElementPresent(
				key_country = "USA",
				key_environment = "projtest-dev",
				locator1 = "Projects#ENVIRONMENT_FLAG");
		}

		task ("When: I click the location pill") {
			Default.Click(
				key_country = "USA",
				key_environment = "projtest-dev",
				locator1 = "Projects#ENVIRONMENT_FLAG");
		}

		task ("Then: Console redirects to the Settings page") {
			Default.AssertElementPresent(
				key_headerTitle = "Settings",
				locator1 = "Utils#HEADER_TITLE");
		}
	}

}