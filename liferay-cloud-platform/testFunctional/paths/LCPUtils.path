<html>
<head>
<title>LCPUtils</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LCPUtils</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_MENU_OPTION</td>
	<td>//div[contains(@class,'open')]//*[normalize-space(text())="${key_menuOption}"]</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_DROPDOWN</td>
	<td>//div[@class='dropdown']</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_INPUT_FIELD</td>
	<td>//input[@id='${key_inputId}']</td>
	<td></td>
</tr>
<tr>
	<td>HEADER_TITLE</td>
	<td>//h1[contains(text(),'${key_headerTitle}')]</td>
	<td></td>
</tr>
<!-- BUTTON -->
<tr>
	<td>DANGER_BUTTON</td>
	<td>xpath=(//a | //button)[contains (@class,'btn-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[contains(@type,'submit')]</td>
	<td></td>
</tr>
<!-- CHECKBOX -->
<tr>
	<td>ANY_CHECKBOX</td>
	<td>//label[contains(.,'${key_checkboxName}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<!-- SIDEBAR_MENU -->
<tr>
	<td>SIDEBAR_MENU_ICON</td>
	<td>//span[@class='sidebar-icon-right']</td>
	<td></td>
</tr>
<tr>
	<td>SIDEBAR_ITEM</td>
	<td>//li[contains(@class,'sidebar-item')]//span[contains(text(),'${key_itemName}')]</td>
	<td></td>
</tr>
<!-- USERBAR -->
<tr>
	<td>USER_AVATAR_DROPDOWN_ANY_ITEM</td>
	<td>//div[contains(@class,'dropdown')]//*[contains(text(),'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_AVATAR_PORTRAIT</td>
	<td>//nav[contains(@class,'topbar')]//button//span[contains(@class,'avatar-initials')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>