<html>
<head>
<title>SignUp</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SignUp</td></tr>
</thead>

<tbody>

<tr>
	<td>PASSWORD_FEEDBACK_POPUP</td>
	<td>//div[@class='password-strength show']</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_STRENGTH_LEVEL</td>
	<td>//div[contains(@class,'strength-level-${key_level}')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_STRENGTH_LEVEL_TITLE</td>
	<td>//h4[@class='strength-container-title']</td>
	<td></td>
</tr>
<tr>
	<td>REQUIRED_ITEM_STATUS</td>
	<td>//div[contains(@class,'must-have-status-${key_status}')]//span[contains(.,'${key_requiredItemMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FEEDBACK_POPUP_FOOTER</td>
	<td>//p[contains(@class,'footer')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>