<html>
<head>
<title>Projects</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Projects</td></tr>
</thead>

<tbody>

<tr>
	<td>PROJECT_NAME_NOT_PERSISTENT</td>
	<td>//tr[not(contains(@data-testid,'projtest'))]//a[contains(@class,'projects')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NAME_VALUE</td>
	<td>//tr[not(contains(@data-testid,'projtest'))]//a[contains(@class,'projects')]@href</td>
	<td></td>
</tr>

<!-- PROJECTS_PAGE -->

<tr>
	<td>ENVIRONMENT_COUNT</td>
	<td>//th[contains(@title,'Environment')]//span</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_LOCATION</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[contains(text(),'${key_location}')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_LOCATION_FLAG</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[*[name()='svg'][contains(@data-testid,'flag-${key_country}')]]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_MEMBER</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[@data-testid='project-member-${key_memberName}']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_NO_SERVICES</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[contains(text(),'No services')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_SERVICE</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[@data-testid='project-service-${key_serviceName}']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_STATUS</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//span[@data-testid='project-status']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_TYPE</td>
	<td>//tr[contains(@data-testid,'${key_projectName}')]//span[contains(text(),'${key_environmentType}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NAME</td>
	<td>//tr[contains(@data-testid,'${key_environment}')]//a[contains(@class,'projects')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_TYPE</td>
	<td>//tr[@data-row-key='${key_environment}']//span[contains(@class,'transition-appear')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_WITH_STATUS</td>
	<td>//tr[@data-row-key='${key_projectId}']//span[@data-testid='project-status' and contains(.,'${key_status}')]</td>
	<td></td>
</tr>

<!-- PROJECTS_DROPDOWN_MENU -->

<tr>
	<td>PROJECT_DROPDOWN_MENU</td>
	<td>//div[@class='ant-select-selector']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DROPDOWN_MENU_OPTION</td>
	<td>//div[contains(@class,'select-item-option') and @title='${key_menuOption}']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DROPDOWN_MENU_OPTION_SELECTED</td>
	<td>//span[contains(@class,'selection-item') and @title='${key_menuOption}']</td>
	<td></td>
</tr>

<!-- PROJECTS_POSITION -->

<tr>
	<td>PROJECT_ENVIRONMENT_POSITION</td>
	<td>//tr[contains(@data-testid,'${key_projectName}')][${key_index}]//a[contains(@class,'projects')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_ENVIRONMENT_FAMILY_POSITION</td>
	<td>//div[contains(@class,'projects-table')][${key_index}]//tr[contains(@data-row-key,'${key_environment}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>