<html>
<head>
<title>LCPSettings</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LCPSettings</td></tr>
</thead>

<tbody>
<tr>
	<td>SETTINGS_TAB</td>
	<td>//div[(@class='ant-tabs-tab-btn') and contains(text(),'${key_tabName}')]</td>
	<td></td>
</tr>
<!-- DELETE_PROJECT -->
<tr>
	<td>ALERT_PROJECT_DELETED</td>
	<td>//div[@role='alert' and contains(.,'Environment deleted')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>