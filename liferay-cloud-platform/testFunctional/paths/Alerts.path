<html>
<head>
<title>Alerts</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Alerts</td></tr>
</thead>

<tbody>
<tr>
	<td>ALERTS_ICON</td>
	<td>//span[@data-testid='alerts-badge']</td>
	<td></td>
</tr>
<tr>
	<td>DOCUMENTATION_LINK</td>
	<td>//a[contains(@class,'placeholder-docs-link')]</td>
	<td></td>
</tr>

<!-- ALERTS FILTER -->

<tr>
	<td>ALERTS_ENVIRONMENT_FILTER_DROPDOWN</td>
	<td>//ul[contains(@class, 'dropdown-menu')]//li//a//span[contains(text(), '${key_environmentItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_FILTER_DROPDOWN</td>
	<td>//ul[contains(@class, 'dropdown-menu')]//li//a[contains(text(), '${key_dropdownItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_ALERTS_FILTER</td>
	<td>//button[contains(text(),'${key_filterOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>UNREAD_ALERTS_FILTER</td>
	<td>//button//span[contains(text(),'${key_filterOption}')]</td>
	<td></td>
</tr>

<!-- ALERTS PREFERENCES -->

<tr>
	<td>ALERTS_PREFERENCES_ICON</td>
	<td>//a[contains(@data-title,'Alerts Preferences')]</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_PREFERENCES_TOOLTIP</td>
	<td>//div[contains(@class,'tooltip left tooltip-dark showing')]//section//div[contains(text(), 'Alerts Preferences')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>