<html>
<head>
<title>Alerts</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Alerts</td></tr>
</thead>

<tbody>
<tr>
	<td>ALERTS_ICON</td>
	<td>//span[@data-testid='alerts-badge']</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_DURATION</td>
	<td>//li['${key_messageRow}']//span[contains(@class, 'alert-duration')][contains(., '${key_alertDuration}')]</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_STATUS</td>
	<td>//li['${key_messageRow}']//span[contains(@class, 'pill-status')][contains(., '${key_alertStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_MESSAGE</td>
	<td>//li['${key_messageRow}']//a[contains(@class, 'msg-text')][contains(., '${key_alertMessage}')]</td>
	<td></td>
</tr>

<!-- ALERTS FILTER -->

<tr>
	<td>ALERTS_FILTER_DROPDOWN</td>
	<td>//ul[contains(@class, 'dropdown-menu')]//li//a[contains(., '${key_dropdownItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>ALERTS_FILTER</td>
	<td>//button[contains(.,'${key_filterOption}')]</td>
	<td></td>
</tr>

<!-- ALERTS PREFERENCES -->

<tr>
	<td>ALERTS_PREFERENCES_ICON</td>
	<td>//a[@data-title='Alerts Preferences']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>