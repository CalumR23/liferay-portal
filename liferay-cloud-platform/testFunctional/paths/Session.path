<html>
<head>
<title>Session</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Session</td></tr>
</thead>

<tbody>
<tr>
	<td>TIMEOUT_POPUP_TITLE</td>
	<td>//div[@class='ant-modal-title' and contains(text(),'Session timeout')]</td>
	<td></td>
</tr>
<tr>
	<td>TIMEOUT_POPUP_CONTINUE_BUTTON</td>
	<td>//div[contains(@class,'modal')]//button[@type='button']//*[contains(text(),'Continue')]</td>
	<td></td>
</tr>
<tr>
	<td>TIMEOUT_POPUP_LOGOUT_BUTTON</td>
	<td>//div[contains(@class,'modal')]//button[@type='button']//*[contains(text(),'Log Out')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>