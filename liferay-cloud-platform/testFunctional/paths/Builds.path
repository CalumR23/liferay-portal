<html>
<head>
<title>Builds</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Builds</td></tr>
</thead>

<tbody>

<tr>
	<td>BUILD_LINK_PILL</td>
	<td>//div[@class='item '][${key_index}]//span[@class='item-${key_typePill}']</td>
	<td></td>
</tr>
<tr>
	<td>PILL_TEXT</td>
	<td>//div[@class='item '][${key_index}]//a[contains(@data-title,'${key_typePill}')]//span[contains(@class,'tag-text')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>