<html>
<head>
<title>Builds</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Builds</td></tr>
</thead>

<tbody>

<tr>
	<td>BUILD_LINK_PILL</td>
	<td>//div[@class='item '][${key_index}]//span[@class='item-${key_typePill}']</td>
	<td></td>
</tr>
<tr>
	<td>BUILDS_TABLE_ITEM</td>
	<td>//span[@class='item-id']//span[contains(@class,'tag')][contains(text(),'${key_buildID}')]/ancestor::div[@class='item ']//*[contains(@class,'item-${key_column}')]</td>
	<td></td>
</tr>
<tr>
	<td>CI_BUTTON</td>
	<td>//button[contains(@class,'ci')]</td>
	<td></td>
</tr>
<tr>
	<td>CI_POPUP_TITLE</td>
	<td>//div[contains(@class,'ci-popup')]//p[@class='ci-dropdown-title']</td>
	<td></td>
</tr>
<tr>
	<td>ELLIPSIS_MENU_ITEM</td>
	<td>//div[contains(@class,'dropdown')][contains(@class,'open')]//a[contains(text(),'${key_item}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>