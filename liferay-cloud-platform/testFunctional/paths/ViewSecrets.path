<html>
<head>
<title>ViewSecrets</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ViewSecrets</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTION_FRAME_QUESTION_MARK_ICON</td>
	<td>//div[contains(@class,'${key_cardId}')]//span[@data-testid='questionMarkIcon']</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVITY_LIST</td>
	<td>//ul[contains(@data-testid,'secret-activity-list')]//li['${key_row}']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_VARIABLES</td>
	<td>//tr[@data-row-key='${key_serviceName}']</td>
	<td></td>
</tr>
<tr>
	<td>SECRET_NAME</td>
	<td>//span[contains(.,'${key_secretName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>