<html>
<head>
<title>Overview</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Overview</td></tr>
</thead>

<tbody>

<!-- SERVICES_CARD -->

<tr>
	<td>SERVICE_NAME</td>
	<td>//span[(@class='service-list-title') and contains(text(),'${key_serviceName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_STATUS</td>
	<td>//div[contains(@id,'${key_serviceName}')]//div[contains(@class,'status') and contains(text(),'${key_serviceStatus}')]</td>
	<td></td>
</tr>

<!-- LOCATION_CARD -->

<tr>
	<td>SERVICE_LOCATION_NAME</td>
	<td>//span[(@class='location-name') and contains(text(),'${key_location}')]</td>
	<td></td>
</tr>

<!-- LATEST_DEPLOYMENT_CARD -->

<tr>
	<td>IMPLEMENTED_SERVICE</td>
	<td>//div[@class='deployment-services']//a[@data-service-id='${key_serviceName}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>