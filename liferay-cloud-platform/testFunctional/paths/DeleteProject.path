<html>
<head>
<title>DeleteProject</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">DeleteProject</td></tr>
</thead>

<tbody>

<tr>
	<td>WARNING_MESSAGE</td>
	<td>//div[contains(@class,'alert-content')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_INFORMATION_TABLE</td>
	<td>//tr[@data-row-key='${key_environment}']//span[contains(text(),'${key_information}')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_MARK_ICON</td>
	<td>//div[contains(text(),'${key_infoID}')]//span[contains(@class,'icon-wrapper')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_MARK_TOOLTIP</td>
	<td>//div[contains(@class,'tooltip-placement') and not(contains(@class,'tooltip-hidden'))]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>