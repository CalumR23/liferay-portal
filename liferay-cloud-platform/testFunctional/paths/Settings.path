<html>
<head>
<title>Settings</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Settings</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_TITLE</td>
	<td>//h4[contains(text(),'${key_cardTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>SETTINGS_TAB</td>
	<td>//div[(@class='ant-tabs-tab-btn') and contains(text(),'${key_tabName}')]</td>
	<td></td>
</tr>

<!-- DELETE_PROJECT_TAB -->

<tr>
	<td>IMPLICATIONS_INFORMATION</td>
	<td>//div[contains(@class,'basic-info-card')]//p</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>