<html>
<head>
<title>Utils</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Utils</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_MENU_OPTION</td>
	<td>//div[contains(@class,'open')]//*[normalize-space(text())="${key_menuOption}"]</td>
	<td></td>
</tr>
<tr>
	<td>EXTERNAL_LINK</td>
	<td>//a[@class='lfr-link'][contains(.,'${key_linkText}')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_DROPDOWN</td>
	<td>//div[@class='dropdown']</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_INPUT_FIELD</td>
	<td>//input[@id='${key_inputId}']</td>
	<td></td>
</tr>
<tr>
	<td>HEADER_TITLE</td>
	<td>//h1[contains(text(),'${key_headerTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>LEARN_MORE_LINK</td>
	<td>//a[contains(@class,'link')][contains(.,'Learn more')]</td>
	<td></td>
</tr>

<!-- TOAST -->

<tr>
	<td>GENERIC_TOAST_NOTIFICATION</td>
	<td>//div[contains(@class,'notification')]</td>
	<td></td>
</tr>

<!-- INFO_ALERT -->

<tr>
	<td>INFO_ALERT_MESSAGE</td>
	<td>//div[contains(@class,'alert-info')]</td>
	<td></td>
</tr>

<!-- WARNING_MESSAGE -->

<tr>
	<td>REQUERED_PARAMETER_WARNING</td>
	<td>//div[contains(@class,'requiredParameter')]//p[@id='${key_warningMessageId}']</td>
	<td></td>
</tr>
<tr>
	<td>INVALID_PARAMETER_WARNING</td>
	<td>//div[contains(@class,'invalidParameter')]//p[@id='${key_warningMessageId}']</td>
	<td></td>
</tr>
<tr>
	<td>ALREADY_EXISTING_ID_WARNING</td>
	<td>//div[contains(@class,'AlreadyExists')]//p[@id='${key_warningMessageId}']</td>
	<td></td>
</tr>
<tr>
	<td>INVALID_ID_WARNING</td>
	<td>//div[contains(@class,'invalidProjectId')]//p[@id='projectIdHelp']</td>
	<td></td>
</tr>

<!-- BUTTON -->

<tr>
	<td>CLICK_BUTTON</td>
	<td>//span[contains(text(),'${key_btnName}')]</td>
	<td></td>
</tr>
<tr>
	<td>DANGER_BUTTON</td>
	<td>xpath=(//a | //button)[contains (@class,'btn-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>DANGER_BUTTON_DISABLED</td>
	<td>//button[@disabled and contains (@class,'btn-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//button[contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>SWITCH_BUTTON</td>
	<td>//button[@role='switch']</td>
	<td></td>
</tr>

<!-- CHECKBOX -->

<tr>
	<td>ANY_CHECKBOX</td>
	<td>//label[contains(.,'${key_checkboxName}')]//input[@type='checkbox']</td>
	<td></td>
</tr>

<!-- TOOLTIP -->

<tr>
	<td>TOOLTIP_BODY</td>
	<td>//div[@class='ant-tooltip-inner']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>