<html>
<head>
<title>Settings</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Settings</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_TITLE</td>
	<td>//h4[contains(text(),'${key_cardTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_BUTTON</td>
	<td>//a[contains (@class,'btn-primary')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_BADGE</td>
	<td>//span[contains(@class,'ant-tag-blue')]</td>
	<td></td>
</tr>
<tr>
	<td>SETTINGS_TAB</td>
	<td>//div[(@class='ant-tabs-tab-btn') and contains(text(),'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_MARK_ICON</td>
	<td>//div[contains(text(),'${key_infoID}')]//span[contains(@class,'icon-wrapper')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_MARK_TOOLTIP</td>
	<td>//div[contains(@class,'tooltip-placement') and not(contains(@class,'tooltip-hidden'))]</td>
	<td></td>
</tr>
<tr>
	<td>SETTINGS_TAB_DESCRIPTION</td>
	<td>//p[contains(@class,'leading')]</td>
	<td></td>
</tr>

<!-- INFO_TAB -->

<tr>
	<td>ENVIRONMENT_LOCATION_MAP</td>
	<td>//*[contains(@aria-label,'region map')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_SPECIFIC_INFORMATION</td>
	<td>//div[@data-testid="project-info-item"]//div[contains(.,'${key_infoItem}')]//following-sibling::div//span</td>
	<td></td>
</tr>

<!-- SECRETS_TAB -->

<tr>
	<td>CREATE_NEW_SECRET_BUTTON</td>
	<td>//a[contains (@class,'btn-primary')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_SECRETS_MESSAGE</td>
	<td>//p[contains(.,'No secrets')]</td>
	<td></td>
</tr>

<!-- SECRETS_TAB -->

<tr>
	<td>SERVICE_ICON</td>
	<td>//tr[@data-row-key='${key_secretName}']//div[@class='stacked-avatar-list']//a[contains(@href,'${key_serviceName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SECRET_ROW_NAME</td>
	<td>//span[contains(.,'${key_secretName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TEAM_ROLE_BADGE</td>
	<td>//tr[@data-row-key='${key_secretName}']//span[contains(@class,'tag')]</td>
	<td></td>
</tr>

<!-- SUPPORT_ACCESS -->

<tr>
	<td>SUPPORT_ACCESS_STATUS</td>
	<td>//div[contains(@class,'support-access-card-update-info')]//strong</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_NAME</td>
	<td>//a[@class='lfr-link group']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_ACCESS_USERNAME</td>
	<td>//div[contains(@class,'support-access-card-update-info')]//a[contains(text(),'${key_adminUser}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_ACCESS_STATUS_DESCRIPTION</td>
	<td>//div[contains(@class,'support-access-card-update-info')]</td>
	<td></td>
</tr>

<!-- VPN_TAB -->

<tr>
	<td>NO_VPN_MESSAGE</td>
	<td>//p[contains(.,'No VPN')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>