<html>
<head>
<title>Topbar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Navigation</td></tr>
</thead>

<tbody>

<tr>
	<td>USER_AVATAR_DROPDOWN_ANY_ITEM</td>
	<td>//div[contains(@class,'dropdown')]//*[contains(text(),'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_AVATAR_PORTRAIT</td>
	<td>//nav[contains(@class,'topbar')]//button//span[contains(@class,'avatar-initials')]</td>
	<td></td>
</tr>
<tr>
	<td>TOPBAR_ICON</td>
	<td>//li[contains(@class,'topbar')]//*[name()='svg'][contains(@class,'${key_topbarItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>TOPBAR_TEXT_LINK</td>
	<td>//li[contains(@class,'topbar')]//a[text()='${key_text}']</td>
	<td></td>
</tr>
<tr>
	<td>TOPBAR_DXP_CLOUD_TITLE</td>
	<td>//span[@class='topbar-title']</td>
	<td></td>
</tr>
<tr>
	<td>TOPBAR_LOGO_ICON</td>
	<td>//a[@class='topbar-logo-link']//*[name()='svg']</td>
	<td></td>
</tr>

<!-- VISIT_SITE_DROPDOWN -->

<tr>
	<td>ENDPOINTS_DROPDOWN</td>
	<td>//div[@class='menu-container']</td>
	<td></td>
</tr>
<tr>
	<td>ENDPOINT_PILL</td>
	<td>//div[@class='pill-status pill-custom']//span[contains(text(), '${key_endpointName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>