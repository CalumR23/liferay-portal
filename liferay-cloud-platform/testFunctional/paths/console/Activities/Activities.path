<html>
<head>
<title>Activities</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Activities</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTIVITY_MESSAGE_SUBTITLE</td>
	<td>//ul[@class='activity-list']//li[@class='activity-item'][${key_activityRow}]//span[@class='message-subtitle']</td>
	<td></td>
</tr>
<tr>
	<td>GENERAL_ACTIVITY_LOG</td>
	<td>//ul[@class='activity-list']//li['${key_activityRow}']//span[contains(text(), '${key_activityLog}')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_ACTIVITY_MESSAGE</td>
	<td>//h3[contains(.,'General')]/..//li[@class='activity-item'][1]//span[@class='message']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>