<html>
<head>
<title>ViewVPN</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ViewVPN</td></tr>
</thead>

<tbody>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//a[contains(@class,'btn')][contains(text(),'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_MARK_ICON</td>
	<td>//div[contains(text(),'${key_itemName}')]//*[name()='svg'][contains(@class,'help-icon')]</td>
	<td></td>
</tr>
<tr>
	<td>TOOLTIP_TITLE</td>
	<td>//div[@class='tooltip-title']</td>
	<td></td>
</tr>
<tr>
	<td>VPN_STATUS</td>
	<td>//span[contains(@class,'pill-status')]</td>
	<td></td>
</tr>

<tr>
	<td>ELLIPSIS_BUTTON</td>
	<td>//div[contains(@class,'dropdown-settings-squared')]//button[contains(@type,'button')]</td>
	<td></td>
</tr>
<tr>
	<td>CHECKBOX_VPN</td>
	<td>xpath=(//span[contains(@class,'checkbox-tabindex-wrapper')])[${key_indexNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>DISCONNECT_VPN</td>
	<td>//ul[contains(@class, 'dropdown-menu')]//li//a[contains(text(),'${key_ellipsis}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>