<html>
<head>
<title>DeleteService</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">DeleteService</td></tr>
</thead>

<tbody>

<tr>
	<td>SERVICE_NAME</td>
	<td>//div[contains(@class,'text-base')]//p[1]</td>
	<td></td>
</tr>
<tr>
	<td>IMAGE_NAME</td>
	<td>//div[contains(@class,'text-base')]//p[2]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_PILL</td>
	<td>//td[@class='ant-table-cell'][2]//span[contains(@class,'pill')]</td>
	<td></td>
</tr>
<tr>
	<td>INSTANCES_PILL</td>
	<td>//td[@class='ant-table-cell'][3]//span[contains(@class,'pill')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>