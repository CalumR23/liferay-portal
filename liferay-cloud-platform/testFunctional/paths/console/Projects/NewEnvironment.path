<html>
<head>
<title>NewEnvironment</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">NewEnvironment</td></tr>
</thead>

<tbody>

<tr>
	<td>ADD_ENVIRONMENT_VARIABLES_CHECKBOX</td>
	<td>//div[@class="checkbox"][contains(.,'Add environment variables')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_SERVICE_NAME</td>
	<td>//span[@class="item-title-medium"][contains(text(), '${key_serviceName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_VARIABLE_FIELD</td>
	<td>//span[contains(text(), '${key_serviceName}')]/ancestor::div[@class='service-envs']//input[@placeholder='Enter ${key_inputType}'][@data-row-index='${key_index}']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_SERVICE_VARIABLE_BUTTON</td>
	<td>//span[contains(text(), '${key_serviceName}')]/ancestor::div[@class='service-envs']//button[@data-row-index='${key_index}']</td>
	<td></td>
</tr>
<tr>
	<td>COPY_ALL_SERVICES_CHECKBOX</td>
	<td>//div[@class="checkbox"][contains(.,'Copy all services')]</td>
	<td></td>
</tr>
<tr>
	<td>ALL_ENVIRONMENTS_DROPDOWN</td>
	<td>//div[@class='body-section']//div[@class='dropdown']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>