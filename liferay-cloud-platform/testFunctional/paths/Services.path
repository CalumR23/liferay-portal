<html>
<head>
<title>Services</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Services</td></tr>
</thead>

<tbody>
<tr>
	<td>SERVICE_NAME</td>
	<td>//p[@title='${key_serviceName}']</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_ICON</td>
	<td>//*[contains(@data-testid,'${key_serviceName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_MENU_ICON</td>
	<td>//tr[@data-row-key='${key_serviceName}']//span[contains(@class,'dropdown')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_MENU_OPTION</td>
	<td>//li[contains(@class,'dropdown')]//span[normalize-space(text())='${key_menuOption}']</td>
	<td></td>
</tr>
<tr>
	<td>CARD_TITLE</td>
	<td>//h3[contains(text(),'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_SERVICE_TITLE</td>
	<td>//span[contains(@class,'lfr-placeholder__title')]</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_HEADER_NUMBER</td>
	<td>//th[contains(text(),'Services (${key_serviceNumber})')]</td>
	<td></td>
</tr>

<!-- SERVICE_POPOVER -->

<tr>
	<td>SERVICE_POPOVER</td>
	<td>//ancestor::div[contains(@Class,'popover-placement')]</td>
	<td></td>
</tr>
<tr>
	<td>POPOVER_SERVICE_ICON</td>
	<td>//div[contains(@class,'popover-placement')]//span[contains(@class,'avatar-string')]</td>
	<td></td>
</tr>
<tr>
	<td>POPOVER_SERVICE_NAME</td>
	<td>//div[contains(@class,'popover-placement')]//span[@role='heading']</td>
	<td></td>
</tr>
<tr>
	<td>POPOVER_SERVICE_IMAGE_DETAILS</td>
	<td>//div[contains(@class,'popover-placement')]//div[@class="inline-flex"]</td>
	<td></td>
</tr>
<tr>
	<td>POPOVER_SERVICE_STATUS</td>
	<td>//div[contains(@class,'popover-placement')]//span[@data-testid='service-status']</td>
	<td></td>
</tr>
<tr>
	<td>POPOVER_USAGE_CARD</td>
	<td>//div[contains(@class,'${key_usageCard}')]</td>
	<td></td>
</tr>

<!-- STATUS_POPOVER -->

<tr>
	<td>STATUS_POPOVER</td>
	<td>//div[contains(@class,'status-popover')]</td>
	<td></td>
</tr>
<tr>
	<td>PROBE_SECTION</td>
	<td>//div[contains(text(),'${key_probeType}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROBE_SECTION_INFO</td>
	<td>//span[contains(@class,'data__key')][contains(text(),'${key_parametersInfo}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROBE_SECTION_INFO_VALUE</td>
	<td>//span[contains(@class,'data__key')][contains(text(),'${key_parametersInfo}')]//following::span[position()=1]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_PILL</td>
	<td>//div[contains(@class,'lfr-services-table__status-pill')]//span[text()='${key_statusPill}']</td>
	<td></td>
</tr>

<!-- ENDPOINTS -->

<tr>
	<td>ENDPOINTS_PILL</td>
	<td>//span[contains(@class, 'lfr-services-table__endpoints-pill')]//span[contains(text(), '${key_endpointName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>