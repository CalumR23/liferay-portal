<html>
<head>
<title>ServicesLogs</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ServicesLogs</td></tr>
</thead>

<tbody>
<tr>
	<td>SERVICE_NAME</td>
	<td>//a[@class='header-title']</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_VERSION</td>
	<td>//span[contains(@class,'service-header-subtitle')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>