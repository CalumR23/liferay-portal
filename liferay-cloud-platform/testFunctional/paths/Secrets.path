<html>
<head>
<title>Secrets</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Secrets</td></tr>
</thead>

<tbody>
<tr>
	<td>SECRETS_INPUT_FIELD</td>
	<td>xpath=(//input | //textarea)[contains(@placeholder,'${key_inputField}')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_SECRET_CONFIRM_CHECKBOX</td>
	<td>//label[contains(@for,'checkbox')][contains(.,'${key_stackItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>CAN_VIEW_SECRETS_CHECKBOX</td>
	<td>//label[contains(@class,'checkbox')]//div[contains(.,'${key_userRole}')]</td>
	<td></td>
</tr>
<tr>
	<td>SERVICE_INPUT_FIELD</td>
	<td>//tr[@data-row-key='${key_serviceName}']//input[@type='${key_inputType}']</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_FRAME_LINK</td>
	<td>//div[contains(@class,'${key_cardId}')]//span[contains(text(),'${key_link}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>