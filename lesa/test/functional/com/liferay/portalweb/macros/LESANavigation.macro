<definition>
	<var name="customerPortalURL" value="/group/customer" />

	<command name="back">
		<execute function="Click" locator1="LESANavigation#BACK_LINK" />
	</command>

	<command name="gotoAssignWorkers">
		<execute macro="LESANavigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Assign Workers" />
		</execute>
	</command>

	<command name="gotoEditProject">
		<execute macro="LESANavigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Edit" />
		</execute>

		<execute function="SelectFrame" locator1="LESAProjectDetailsEdit#EDIT_PROJECT_IFRAME" />
	</command>

	<command name="gotoEditTicket">
		<execute macro="LESANavigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Edit" />
		</execute>
	</command>

	<command name="gotoEnvironmentConfigurations">
		<execute function="Click" locator1="LESALeftNavigation#PREFERENCES_BUTTON" />

		<execute function="AssertClick" locator1="LESAPreferences#ENVIRONMENT_CONFIGURATIONS_TAB" value1="Environment Configurations" />
	</command>

	<command name="gotoEnvironmentDetails">
		<execute macro="LESANavigation#gotoEditTicket" />

		<execute function="AssertClick" locator1="LESATicketEdit#ENVIRONMENT_DETAILS_TAB" value1="Environment Details" />
	</command>

	<command name="gotoForwardTicket">
		<execute macro="LESANavigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Forward" />
		</execute>
	</command>

	<command name="gotoHelp">
		<execute macro="LESANavigation#gotoLESA" />

		<execute function="Click" locator1="LESALeftNavigation#HELP_BUTTON" />
	</command>

	<command name="gotoHome">
		<execute function="Click" locator1="LESALeftNavigation#HOME_BUTTON" />

		<if>
			<condition function="IsElementPresent" locator1="LESALeftNavigation#HOME_SUBMENU" />
			<then>
				<var name="key_item" value="My Open Tickets" />

				<execute function="AssertClick" locator1="LESALeftNavigation#HOME_SUBMENU_ITEM" value1="${key_item}" />
			</then>
		</if>
	</command>

	<command name="gotoLESA">
		<execute function="Open" locator1="${customerPortalURL}" />
		<execute function="Click" locator1="LESANavigation#LESA_BUTTON" />
	</command>

	<command name="gotoLESASearch">
		<if>
			<condition function="IsElementNotPresent" locator1="LESANavigation#LESA_LIFERAY_SUPPORT_IMG" />
			<then>
				<execute macro="LESANavigation#gotoLESA" />
			</then>
		</if>

		<execute function="Click" locator1="LESALeftNavigation#LESA_SEARCH_BUTTON" />
	</command>

	<command name="gotoManagerDashboard">
		<execute function="Click" locator1="LESALeftNavigation#PREFERENCES_BUTTON" />

		<execute function="AssertClick" locator1="LESAPreferences#MANAGER_DASHBOARD_TAB" value1="Manager Dashboard" />
	</command>

	<command name="gotoProjectAdminMessages">
		<execute macro="OSBAdminNavigation#gotoControlPanel" />

		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="QAPROJECT1" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccountAdd#PROJECT_MESSAGES_TAB" />
		<execute function="Click" locator1="OSBAdminAccountAdd#MANAGE_MESSAGES_BUTTON" />
	</command>

	<command name="gotoProposeSolution">
		<execute macro="LESANavigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Propose Solution" />
		</execute>
	</command>

	<command name="gotoTicket">
		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#search">
			<var name="keyword" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="gotoTicketAsDifferentUser">
		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoTicket">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="gotoTicketThreeDotMenuItem">
		<var name="key_menuItem" value="${menuItem}" />

		<execute function="Click" locator1="LESATicketDetails#THREE_DOT_ICON" />
		<execute function="AssertClick" locator1="LESATicketDetails#THREE_DOT_MENU_ITEM" value1="${menuItem}" />
	</command>
</definition>