<definition>
	<command name="inputActivationKeyDetails">
		<execute function="Select" locator1="CreateTicket#TYPE_OF_KEY_SELECT" value1="${typeOfKey}" />
		<execute function="Select" locator1="CreateTicket#PURPOSE_SELECT" value1="${purpose}" />
	</command>

	<command name="inputBasicForm">
		<execute function="Select" locator1="CreateTicket#PROJECT_SELECT" value1="${project}" />
		<execute function="Select" locator1="CreateTicket#PRODUCT_SELECT" value1="${product}" />

		<if>
			<equals arg1="${configType}" arg2="saved" />
			<then>
				<execute macro="CreateTicketEntry#selectSavedConfig">
					<var name="browser" value="${browser}" />
					<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
				</execute>
			</then>
			<elseif>
				<equals arg1="${configType}" arg2="new" />
				<then>
					<execute macro="CreateTicketEntry#selectNewConfig">
						<var name="appServer" value="${appServer}" />
						<var name="browser" value="${browser}" />
						<var name="database" value="${database}" />
						<var name="javaVM" value="${javaVM}" />
						<var name="liferayVersion" value="${liferayVersion}" />
						<var name="operatingSystem" value="${operatingSystem}" />
					</execute>
				</then>
			</elseif>
		</if>

		<execute function="Select" locator1="CreateTicket#COMPONENT_SELECT" value1="${component}" />
		<execute function="Select" locator1="CreateTicket#SYSTEM_STATUS_SELECT" value1="${systemStatus}" />
		<execute function="Type" locator1="CreateTicket#SUMMARY_FIELD" value1="${summary}" />
		<execute function="Type" locator1="CreateTicket#DESCRIPTION_FIELD" value1="${description}" />
	</command>

	<command name="inputClusteringDetails">
		<execute function="Select" locator1="CreateTicket#SERVER_COMMUNICATION_TYPE_SELECT" value1="${serverCommunicationType}" />
	</command>

	<command name="inputUpgradeDetails">
		<execute function="Select" locator1="CreateTicket#TO_LIFERAY_VERSION_SELECT" value1="${toLiferayVersion}" />
		<execute function="Select" locator1="CreateTicket#DL_PERSISTENCE_SELECT" value1="${documentPersistence}" />
		<execute function="Type" locator1="CreateTicket#STEPS_USED_FIELD" value1="${upgradeSteps}" />

		<execute macro="CreateTicketEntry#uploadToPatchLevel" />

		<execute macro="CreateTicketEntry#uploadToPortalExt" />
	</command>
</definition>