<definition>
	<command name="error">
		<var name="key_errorMessage" value="${errorMessage}" />

		<if>
			<condition function="IsElementPresent" locator1="Message#ERROR_MESSAGE_1" />
			<then>
				<execute function="AssertTextEquals" locator1="Message#ERROR_MESSAGE_1" value1="${errorMessage}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="Message#ERROR_MESSAGE_2" value1="${errorMessage}" />
			</else>
		</if>
	</command>

	<command name="info">
		<execute function="AssertTextEquals#assertPartialText" locator1="Message#INFO_MESSAGE" value1="${message}" />
	</command>

	<command name="limitedSupport">
		<var name="key_message" value="${message}" />

		<if>
			<condition function="IsVisible" locator1="Message#LIMITED_SUPPORT_MESSAGE_TICKET_DETAIL" />
			<then>
				<execute function="AssertTextEquals" locator1="Message#LIMITED_SUPPORT_MESSAGE_TICKET_DETAIL" value1="${message}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="Message#LIMITED_SUPPORT_MESSAGE_DESCRIPTION_TAB" value1="${message}" />
			</else>
		</if>
	</command>

	<command name="success">
		<execute function="AssertTextEquals" locator1="Message#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>
</definition>