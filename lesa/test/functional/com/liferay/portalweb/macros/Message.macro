<definition>
	<command name="error">
		<execute function="AssertTextEquals" locator1="Message#ERROR_MESSAGE" value1="${errorMessage}" />
	</command>

	<command name="info">
		<execute function="AssertTextEquals#assertPartialText" locator1="Message#INFO_MESSAGE" value1="${message}" />
	</command>

	<command name="limitedSupport">
		<var name="key_message" value="${message}" />

		<execute function="AssertTextEquals" locator1="Message#LIMITED_SUPPORT_MESSAGE" value1="${message}" />
	</command>

	<command name="success">
		<execute function="AssertTextEquals" locator1="Message#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>
</definition>