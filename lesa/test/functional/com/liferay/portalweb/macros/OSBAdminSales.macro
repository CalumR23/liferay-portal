<definition>
	<command name="addOffering">
		<execute macro="Navigation#gotoOSBAdminSalesOfferings" />

		<execute function="Click" locator1="OSBAdminSalesOfferings#ADD_OFFERING_BUTTON" />

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#PRODUCT_SELECT" value1="${product}" />

		<if>
			<isset var="servers" />
			<then>
				<execute function="Type" locator1="OSBAdminSalesOfferingAdd#SERVERS_FIELD" value1="${servers}" />
			</then>
		</if>

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#SUPPORT_SELECT" value1="${support}" />

		<if>
			<isset var="supportedServers" />
			<then>
				<execute function="Type" locator1="OSBAdminSalesOfferingAdd#SUPPORTED_SERVERS_FIELD" value1="${supportedServers}" />
			</then>
		</if>

		<if>
			<equals arg1="unlimitedSupportTickets" arg2="yes" />
			<then>
				<execute function="Check" locator1="OSBAdminSalesOfferingAdd#UNLIMITED_SUPPORT_TICKETS_CHECKBOX" />
			</then>
			<elseif>
				<equals arg1="unlimitedSupportTickets" arg2="no" />
				<then>
					<execute function="Uncheck" locator1="OSBAdminSalesOfferingAdd#UNLIMITED_SUPPORT_TICKETS_CHECKBOX" />
				</then>
			</elseif>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="addOrder">
		<execute macro="Navigation#gotoOSBAdminSalesOrders" />

		<execute function="Click" locator1="OSBAdminSalesOrders#ADD_ORDER_BUTTON" />

		<execute function="Select" locator1="OSBAdminSalesOrderAdd#ACCOUNT_SELECT" value1="${projectName}" />

		<execute function="Click" locator1="OSBAdminSalesOrderAdd#ADD_OFFERING_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute function="Select" locator1="OSBAdminSalesOfferings#PRODUCT_SELECT" value1="${product}" />
		<execute function="Select" locator1="OSBAdminSalesOfferings#SUPPORT_SELECT" value1="${support}" />

		<execute macro="Button#search" />

		<var name="key_servers" value="${servers}" />

		<execute function="ClickNoError" locator1="OSBAdminSalesOfferings#SEARCH_RESULT_SERVERS" />

		<execute function="SelectWindow" locator1="null" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="editOfferingVersion">
		<execute macro="OSBAdminSales#gotoOrderDetails">
			<var name="project" value="${project}" />
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_product" value="${product}" />

		<execute function="Select" locator1="OSBAdminSalesOrderDetail#RESULT_ROW_VERSION_SELECT" value1="${version}" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="editSupportLifetime">
		<execute macro="OSBAdminSales#gotoOrderDetails">
			<var name="project" value="${project}" />
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_product" value="${product}" />

		<execute function="Select" locator1="OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT" value1="${supportLifetime}" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="gotoOrderDetails">
		<execute macro="OSBAdminSearch#searchAdvancedOrders">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_project" value="${project}" />

		<execute function="AssertClick" locator1="OSBAdminSalesOrders#SEARCH_RESULT_PROJECT" value1="${project}" />
	</command>

	<command name="tearDownOffering">
		<execute macro="OSBAdminSearch#searchOffering">
			<var name="product" value="${product}" />
			<var name="support" value="${support}" />
			<var name="supportedServers" value="${supportedServers}" />
		</execute>

		<execute macro="OSBAdminSearch#tearDownSearchResultRow">
			<var name="code" value="${supportedServers}" />
		</execute>
	</command>

	<command name="tearDownOrder">
		<execute macro="OSBAdminSales#tearDownSearchAdvancedOrders">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminSearch#tearDownSearchResultRow">
			<var name="code" value="${projectName}" />
		</execute>
	</command>

	<command name="tearDownSearchAdvancedOrders">
		<execute macro="Navigation#gotoOSBAdminSalesOrders" />

		<execute macro="OSBAdminSearch#toggleSearch">
			<var name="searchType" value="Advanced" />
		</execute>

		<execute function="Click" locator1="OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_PROJECT_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute macro="OSBAdminSearch#toggleSearch">
			<var name="searchType" value="Basic" />
		</execute>

		<execute function="Type" locator1="OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD" value1="${projectCode}" />

		<execute macro="Button#search" />

		<var name="key_code" value="${projectCode}" />

		<if>
			<condition function="IsElementPresent" locator1="OSBAdmin#SEARCH_RESULT_CODE" />
			<then>
				<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_CODE" />
			</then>
			<else>
				<execute function="Close" locator1="title=Control Panel" />
			</else>
		</if>

		<execute function="SelectWindow" locator1="null" />

		<execute function="Select" locator1="OSBAdminSalesOrders#CREATED_BY_SELECT" value1="Me" />

		<execute macro="Button#searchAdvanced" />
	</command>
</definition>