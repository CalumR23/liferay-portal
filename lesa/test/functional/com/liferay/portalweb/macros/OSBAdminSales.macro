<definition>
	<command name="addOffering">
		<execute macro="Navigation#gotoOSBAdminSalesOfferings" />

		<execute function="Click" locator1="OSBAdminSalesOfferings#ADD_OFFERING_BUTTON" />

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#PRODUCT_SELECT" value1="${product}" />

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#LICENSE_LIFETIME_SELECT" value1="${licenseLifetime}" />

		<if>
			<isset var="servers" />
			<then>
				<execute function="Type" locator1="OSBAdminSalesOfferingAdd#SERVERS_FIELD" value1="${servers}" />
			</then>
		</if>

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#SUPPORT_SELECT" value1="${support}" />

		<if>
			<isset var="supportLifetime" />
			<then>
				<execute function="Select" locator1="OSBAdminSalesOfferingAdd#SUPPORT_LIFETIME_SELECT" value1="${supportLifetime}" />
			</then>
		</if>

		<if>
			<isset var="supportedServers" />
			<then>
				<execute function="Type" locator1="OSBAdminSalesOfferingAdd#SUPPORTED_SERVERS_FIELD" value1="${supportedServers}" />
			</then>
		</if>

		<if>
			<equals arg1="unlimitedSupportTickets" arg2="yes" />
			<then>
				<execute function="Check" locator1="OSBAdminSalesOfferingAdd#UNLIMITED_SUPPORT_TICKETS_CHECKBOX" />
			</then>
			<elseif>
				<equals arg1="unlimitedSupportTickets" arg2="no" />
				<then>
					<execute function="Uncheck" locator1="OSBAdminSalesOfferingAdd#UNLIMITED_SUPPORT_TICKETS_CHECKBOX" />
				</then>
			</elseif>
		</if>

		<execute function="Select" locator1="OSBAdminSalesOfferingAdd#CURRENCY_SELECT" value1="${currency}" />

		<if>
			<isset var="retailPrice" />
			<then>
				<execute function="Type" locator1="OSBAdminSalesOfferingAdd#RETAIL_PRICE_FIELD" value1="${retailPrice}" />
			</then>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="addOrder">
		<execute macro="Navigation#gotoOSBAdminSalesOrders" />

		<execute function="Click" locator1="OSBAdminSalesOrders#ADD_ORDER_BUTTON" />

		<execute function="Select" locator1="OSBAdminSalesOrderAdd#CURRENCY_SELECT" value1="${currency}" />

		<execute macro="Button#next" />

		<execute function="Select" locator1="OSBAdminSalesOrderAdd#ACCOUNT_SELECT" value1="${projectName}" />

		<execute function="Type" locator1="OSBAdminSalesOrderAdd#ACTUAL_PRICE_FIELD" value1="${actualPrice}" />
		<execute function="Click" locator1="OSBAdminSalesOrderAdd#ADD_OFFERING_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute function="Select" locator1="OSBAdminSalesOfferings#PRODUCT_SELECT" value1="${product}" />
		<execute function="Select" locator1="OSBAdminSalesOfferings#SUPPORT_SELECT" value1="${support}" />

		<execute macro="Button#search" />

		<var name="key_retailPrice" value="${retailPrice}" />

		<execute function="ClickNoError" locator1="OSBAdminSalesOfferings#SEARCH_RESULT_RETAIL_PRICE" />

		<execute function="SelectWindow" locator1="null" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="deleteOffering">
		<execute macro="OSBAdminSearch#searchOffering">
			<var name="currency" value="${currency}" />
			<var name="product" value="${product}" />
			<var name="support" value="${support}" />
		</execute>

		<execute macro="OSBAdminSearch#deleteSearchResultRow">
			<var name="code" value="${retailPrice}" />
		</execute>
	</command>

	<command name="deleteOrder">
		<execute macro="OSBAdminSearch#searchAdvancedOrders">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminSearch#deleteSearchResultRow">
			<var name="code" value="${actualPrice}" />
		</execute>
	</command>
</definition>