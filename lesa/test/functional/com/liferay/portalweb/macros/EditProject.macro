<definition>
	<command name="addCallLog">
		<execute function="AssertClick" locator1="ProjectDetails#CALL_LOG_TAB" value1="Call Log" />
		<execute function="Click" locator1="ProjectDetails#ADD_CALL_LOG_BUTTON" />

		<execute function="SelectFrame" locator1="AddCallLog#CALL_LOG_IFRAME" />
		<execute function="Select" locator1="AddCallLog#CALL_TYPE_SLECT" value1="${callType}" />
		<execute function="Select" locator1="AddCallLog#CALL_DATE_MONTH_SELECT" value1="${callDateMonth}" />
		<execute function="Select" locator1="AddCallLog#CALL_DATE_DAY_SELECT" value1="${callDateDay}" />
		<execute function="Select" locator1="AddCallLog#CALL_DATE_YEAR_SELECT" value1="${callDateYear}" />
		<execute function="Select" locator1="AddCallLog#CALL_LENGTH_HOURS_SELECT" value1="${callLengthHours}" />
		<execute function="Select" locator1="AddCallLog#CALL_LENGTH_MINUTES_SELECT" value1="${callLengthMinutes}" />
		<execute function="Select" locator1="AddCallLog#CALL_LENGTH_SECONDS_SELECT" value1="${callLengthSeconds}" />
		<execute function="Type" locator1="AddCallLog#SUMMARY_FIELD" value1="${summary}" />
		<execute function="Type" locator1="AddCallLog#CLIENTS_PRESENT_FIELD" value1="${clientsPresent}" />
		<execute function="Type" locator1="AddCallLog#NOTES_FIELD" value1="${notes}" />
		<execute function="Type" locator1="AddCallLog#ACTION_ITEMS_FIELD" value1="${actionItems}" />

		<execute macro="Button#save" />

		<execute function="SelectFrame" value1="relative=top" />
	</command>

	<command name="deleteCallLog">
		<execute macro="Search#searchProject">
			<var name="projectName" value="${projectName}" />
		</execute>

		<execute function="AssertClick" locator1="ProjectDetails#CALL_LOG_TAB" value1="Call Log" />

		<var name="key_summary" value="${summary}" />

		<if>
			<condition function="IsElementPresent" locator1="ProjectDetails#CALL_LOG_SUMMARY" />
			<then>
				<execute function="AssertClick" locator1="ProjectDetails#CALL_LOG_SUMMARY" value1="${summary}" />
				<execute function="ClickNoError" locator1="Button#DELETE_BUTTON" />

				<execute function="Confirm" value1="Are you sure you want to delete this call log?" />

				<execute macro="Message#success" />

				<execute function="AssertElementNotPresent" locator1="ProjectDetails#CALL_LOG_SUMMARY" />
			</then>
		</if>
	</command>

	<command name="editCASInformation">
		<execute function="AssertClick" locator1="ProjectDetails#CAS_INFORMATION_TAB" value1="CAS Information" />
		<execute function="Click" locator1="ProjectDetails#CAS_INFO_EDIT_BUTTON" />
		<execute function="Type" locator1="ProjectDetails#REASONS_FOR_STRATEGIC_FIELD" value1="${reasonsForStrategic}" />
		<execute function="Type" locator1="ProjectDetails#PROJECT_OVERVIEW_FIELD" value1="${projectOverview}" />
		<execute function="Type" locator1="ProjectDetails#CONTACT_OVERVIEW_FIELD" value1="${contactOverview}" />
		<execute function="Type" locator1="ProjectDetails#MILESTONES_FIELD" value1="${majorMilestones}" />
		<execute function="Click" locator1="ProjectDetails#CAS_INFO_SAVE_BUTTON" />
	</command>

	<command name="editCEMCXMInformation">
		<execute function="AssertClick" locator1="ProjectDetails#CEM_CXM_INFORMATION_TAB" value1="CEM/CXM Information" />
		<execute function="Click" locator1="ProjectDetails#CEM_CXM_INFO_EDIT_BUTTON" />
		<execute function="Type" locator1="ProjectDetails#LICENSE_INFORMATION_FIELD" value1="${licenseInformation}" />
		<execute function="Type" locator1="ProjectDetails#SALESFORCE_URL_FIELD" value1="${salesforceURL}" />
		<execute function="Type" locator1="ProjectDetails#TRAININGS_ATTENDED_FIELD" value1="${trainingsAttended}" />
		<execute function="Click" locator1="ProjectDetails#CEM_CXM_INFO_SAVE_BUTTON" />
	</command>
</definition>