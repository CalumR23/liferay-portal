<definition>
	<command name="addProject">
		<execute function="AssertClick" locator1="OSBAdmin#PROJECTS_TAB" value1="Projects" />
		<execute function="Click" locator1="OSBAdmin#ADD_PROJECT_BUTTON" />

		<execute macro="OSBAdminProject#editProject">
			<var name="additionalNotes" value="${additionalNotes}" />
			<var name="addressLine" value="${addressLine}" />
			<var name="businessAccountName" value="${businessAccountName}" />
			<var name="city" value="${city}" />
			<var name="code" value="${code}" />
			<var name="country" value="${country}" />
			<var name="industry" value="${industry}" />
			<var name="language" value="${language}" />
			<var name="maxContacts" value="${maxContacts}" />
			<var name="partnerCode" value="${partnerCode}" />
			<var name="projectName" value="${projectName}" />
			<var name="region" value="${region}" />
			<var name="specialInstructions" value="${specialInstructions}" />
			<var name="state" value="${state}" />
			<var name="tier" value="${tier}" />
			<var name="type" value="${type}" />
			<var name="zip" value="${zip}" />
		</execute>
	</command>

	<command name="addProjectMessage">
		<execute function="Click" locator1="OSBAdminAccountAdd#PROJECT_MESSAGES_TAB" />
		<execute function="Click" locator1="OSBAdminAccountAdd#MANAGE_MESSAGES_BUTTON" />

		<var locator="PAEdit#SALESFORCE_PROJECT_KEY" name="salesforceProjectKey" />

		<if>
			<equals arg1="${salesforceProjectKey}" arg2="" />
			<then>
				<execute function="Click" locator1="PAEdit#EDIT_BUTTON" />
				<execute function="Type" locator1="PAEdit#SALESFORCE_PROJECT_KEY_FIELD" value1="12345" />

				<execute macro="Button#save" />

				<execute macro="Message#success" />

				<execute function="Click" locator1="Button#CANCEL_BUTTON" />
			</then>
		</if>

		<execute function="Click" locator1="PAMessages#ADD_MESSAGE_BUTTON" />
		<execute function="Type" locator1="PAMessages#CORP_PROJECT_MESSAGE_TITLE_FIELD" value1="${title}" />
		<execute function="Type" locator1="PAMessages#CORP_PROJECT_MESSAGE_FIELD" value1="${message}" />
		<execute function="Select" locator1="PAMessages#SEVERITY_SELECT" value1="${severity}" />
		<execute function="Check" locator1="PAMessages#DISPLAY_LESA_CHECKBOX" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="addSupportLanguage">
		<execute function="AssertClick" locator1="OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB" value1="Support Languages" />
		<execute function="Click" locator1="OSBAdminAccountAdd#ADD_SUPPORT_LANGUAGE_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<var name="key_item" value="${language}" />

		<execute function="ClickNoError" locator1="OSBAdminAccountAddSupport#TABLE_ROW" />

		<execute function="SelectWindow" locator1="null" />

		<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#SUPPORT_RESULT_ROW" value1="${language}" />
	</command>

	<command name="addSupportLanguageToProject">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminProject#addSupportLanguage">
			<var name="language" value="${supportLanguage}" />
		</execute>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="addSupportRegion">
		<execute function="AssertClick" locator1="OSBAdminAccountAdd#SUPPORT_REGIONS_TAB" value1="Support Regions" />
		<execute function="Click" locator1="OSBAdminAccountAdd#ADD_SUPPORT_REGION_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<var name="key_item" value="${region}" />

		<execute function="ClickNoError" locator1="OSBAdminAccountAddSupport#TABLE_ROW" />

		<execute function="SelectWindow" locator1="null" />

		<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#SUPPORT_RESULT_ROW" value1="${region}" />
	</command>

	<command name="addSupportRegionToProject">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminProject#addSupportRegion">
			<var name="region" value="${supportRegion}" />
		</execute>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="assignCustomer">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON" />

		<execute macro="OSBAdminProject#assignUser">
			<var name="emailAddress" value="${emailAddress}" />
			<var name="role" value="${role}" />
		</execute>
	</command>

	<command name="assignUser">
		<execute function="AssertClick" locator1="OSBAdminAccountUsers#AVAILABLE_TAB" value1="Available" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${emailAddress}" />
		</execute>

		<var name="key_emailAddress" value="${emailAddress}" />

		<execute function="Check" locator1="OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX" />
		<execute function="Select" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ROLE_SELECT" value1="${role}" />
		<execute function="Click" locator1="OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="assignWorker">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_WORKERS_BUTTON" />

		<execute macro="OSBAdminProject#assignUser">
			<var name="emailAddress" value="${emailAddress}" />
			<var name="role" value="${role}" />
		</execute>
	</command>

	<command name="deleteCustomers">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON" />

		<execute macro="OSBAdminProject#deleteUsers" />
	</command>

	<command name="deleteProjectMessage">
		<execute function="Click" locator1="OSBAdminAccountAdd#PROJECT_MESSAGES_TAB" />
		<execute function="Click" locator1="OSBAdminAccountAdd#MANAGE_MESSAGES_BUTTON" />

		<var name="key_code" value="${message}" />

		<execute function="Click" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" />
		<execute function="Click" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />

		<execute macro="Message#success" />
	</command>

	<command name="deleteUsers">
		<if>
			<condition function="IsVisible" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX" />
			<then>
				<execute function="AssertClick" locator1="OSBAdminAccountUsers#CURRENT_TAB" value1="Current" />
				<execute function="Uncheck" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX" />
				<execute function="Click" locator1="OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON" />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="deleteWorkers">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_WORKERS_BUTTON" />

		<execute macro="OSBAdminProject#deleteUsers" />
	</command>

	<command name="editPartner">
		<execute function="Click" locator1="OSBAdminAccount#PARTNER_SELECT_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${partnerCode}" />
		</execute>

		<var name="key_code" value="${partnerCode}" />

		<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_CODE" />

		<execute function="SelectWindow" locator1="null" />
	</command>

	<command name="editProject">
		<if>
			<and>
				<isset var="projectName" />
				<not>
					<contains string="${projectName}" substring="{projectName}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#PROJECT_NAME_FIELD" value1="${projectName}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="code" />
				<not>
					<contains string="${code}" substring="{code}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#CODE_FIELD" value1="${code}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="type" />
				<not>
					<contains string="${type}" substring="{type}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#TYPE_SELECT" value1="${type}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="industry" />
				<not>
					<contains string="${industry}" substring="{industry}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#INDUSTRY_SELECT" value1="${industry}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="partnerCode" />
				<not>
					<contains string="${partnerCode}" substring="{partnerCode}" />
				</not>
			</and>
			<then>
				<execute macro="OSBAdminProject#editPartner">
					<var name="partnerCode" value="${partnerCode}" />
				</execute>
			</then>
		</if>

		<if>
			<and>
				<isset var="tier" />
				<not>
					<contains string="${tier}" substring="{tier}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#TIER_SELECT" value1="${tier}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="maxContacts" />
				<not>
					<contains string="${maxContacts}" substring="{maxContacts}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#MAXIMUM_CONTACTS_FIELD" value1="${maxContacts}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="specialInstructions" />
				<not>
					<contains string="${specialInstructions}" substring="{specialInstructions}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#SPECIAL_INSTRUCTIONS_FIELD" value1="${specialInstructions}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="additionalNotes" />
				<not>
					<contains string="${additionalNotes}" substring="{additionalNotes}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#ADDITIONAL_NOTES_FIELD" value1="${additionalNotes}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="addressLine" />
				<not>
					<contains string="${addressLine}" substring="{addressLine}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#ADDRESS_LINE_FIELD" value1="${addressLine}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="country" />
				<not>
					<contains string="${country}" substring="{country}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#COUNTRY_SELECT" value1="${country}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="state" />
				<not>
					<contains string="${state}" substring="{state}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#STATE_PROVINCE_SELECT" value1="${state}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="city" />
				<not>
					<contains string="${city}" substring="{city}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#CITY_FIELD" value1="${city}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="zip" />
				<not>
					<contains string="${zip}" substring="{zip}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#POSTAL_CODE_FIELD" value1="${zip}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="region" />
				<not>
					<contains string="${region}" substring="{region}" />
				</not>
			</and>
			<then>
				<execute macro="OSBAdminProject#addSupportRegion">
					<var name="region" value="${region}" />
				</execute>
			</then>
			<else>
				<execute macro="OSBAdminProject#addSupportRegion">
					<var name="region" value="US" />
				</execute>
			</else>
		</if>

		<if>
			<and>
				<isset var="language" />
				<not>
					<contains string="${language}" substring="{language}" />
				</not>
			</and>
			<then>
				<execute macro="OSBAdminProject#addSupportLanguage">
					<var name="language" value="${language}" />
				</execute>
			</then>
			<else>
				<execute macro="OSBAdminProject#addSupportLanguage">
					<var name="language" value="English" />
				</execute>
			</else>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="getClosedProject" returns="closedProjectName">
		<execute macro="OSBAdminSearch#searchAdvancedProjects">
			<var name="status" value="Closed" />
		</execute>

		<execute function="AssertTextEquals" locator1="OSBAdmin#SEARCH_RESULT_FIRST_ROW_STATUS" value1="Closed" />

		<var locator="OSBAdmin#SEARCH_RESULT_FIRST_ROW_PROJECT_NAME" name="closedProjectName" />

		<return name="closedProjectName" value="${closedProjectName}" />
	</command>

	<command name="getExpiredProject" returns="expiredProjectName">
		<execute macro="OSBAdminSearch#searchAdvancedProjects">
			<var name="status" value="Expired" />
		</execute>

		<execute function="AssertTextEquals" locator1="OSBAdmin#SEARCH_RESULT_FIRST_ROW_STATUS" value1="Expired" />

		<var locator="OSBAdmin#SEARCH_RESULT_FIRST_EXPIRED_PROJECT_NAME" name="expiredProjectName" />

		<return name="expiredProjectName" value="${expiredProjectName}" />
	</command>

	<command name="gotoAccount">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_CODE" value1="${projectCode}" />
	</command>

	<command name="removeSupportLanguage">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB" />

		<var name="key_item" value="${supportLanguage}" />

		<execute function="Click" locator1="OSBAdminAccountAdd#SUPPORT_REMOVE_BUTTON" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="removeSupportRegion">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccountAdd#SUPPORT_REGIONS_TAB" />

		<var name="key_item" value="${supportRegion}" />

		<execute function="Click" locator1="OSBAdminAccountAdd#SUPPORT_REMOVE_BUTTON" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="selectCorpProject">
		<execute function="Click" locator1="OSBAdminAccountAdd#CORP_PROJECT_SELECT_BUTTON" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute function="Type" locator1="OSBAdminAccountCorpProject#KEYWORDS_FIELD" value1="${corpProject}" />

		<execute macro="Button#search" />

		<var name="key_keyword" value="${corpProject}" />

		<execute function="ClickNoError" locator1="OSBAdminAccountCorpProject#RESULT_ROW" />

		<execute function="SelectWindow" locator1="null" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="tearDownAssignedCustomer">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON" />

		<execute macro="OSBAdminProject#tearDownAssignedUser">
			<var name="emailAddress" value="${emailAddress}" />
		</execute>
	</command>

	<command name="tearDownAssignedUser">
		<execute function="AssertClick" locator1="OSBAdminAccountUsers#CURRENT_TAB" value1="Current" />

		<var name="key_emailAddress" value="${emailAddress}" />

		<if>
			<condition function="IsElementPresent" locator1="OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX" />
			<then>
				<execute function="Uncheck" locator1="OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX" />
				<execute function="Click" locator1="OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON" />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="tearDownProject">
		<var name="key_code" value="${projectCode}" />

		<execute macro="OSBAdminProject#deleteCustomers">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminProject#deleteWorkers">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" value1="Actions" />
		<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this?" />

		<execute macro="Message#success" />
	</command>

	<command name="viewProjectDetails">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<if>
			<and>
				<isset var="projectName" />
				<not>
					<contains string="${projectName}" substring="{projectName}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#PROJECT_NAME_FIELD" value1="${projectName}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="code" />
				<not>
					<contains string="${code}" substring="{code}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#CODE_FIELD" value1="${code}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="type" />
				<not>
					<contains string="${type}" substring="{type}" />
				</not>
			</and>
			<then>
				<execute function="AssertSelectedLabel" locator1="OSBAdminAccountAdd#TYPE_SELECT" value1="${type}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="industry" />
				<not>
					<contains string="${industry}" substring="{industry}" />
				</not>
			</and>
			<then>
				<execute function="AssertSelectedLabel" locator1="OSBAdminAccountAdd#INDUSTRY_SELECT" value1="${industry}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="partnerCode" />
				<not>
					<contains string="${partnerCode}" substring="{partnerCode}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#PARTNER" value1="${partnerCode}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="tier" />
				<not>
					<contains string="${tier}" substring="{tier}" />
				</not>
			</and>
			<then>
				<execute function="AssertSelectedLabel" locator1="OSBAdminAccountAdd#TIER_SELECT" value1="${tier}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="maxContacts" />
				<not>
					<contains string="${maxContacts}" substring="{maxContacts}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#MAXIMUM_CONTACTS_FIELD" value1="${maxContacts}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="specialInstructions" />
				<not>
					<contains string="${specialInstructions}" substring="{specialInstructions}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#SPECIAL_INSTRUCTIONS_FIELD" value1="${specialInstructions}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="additionalNotes" />
				<not>
					<contains string="${additionalNotes}" substring="{additionalNotes}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#ADDITIONAL_NOTES_FIELD" value1="${additionalNotes}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="addressLine" />
				<not>
					<contains string="${addressLine}" substring="{addressLine}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#ADDRESS_LINE_FIELD" value1="${addressLine}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="country" />
				<not>
					<contains string="${country}" substring="{country}" />
				</not>
			</and>
			<then>
				<execute function="AssertSelectedLabel" locator1="OSBAdminAccountAdd#COUNTRY_SELECT" value1="${country}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="state" />
				<not>
					<contains string="${state}" substring="{state}" />
				</not>
			</and>
			<then>
				<execute function="AssertSelectedLabel" locator1="OSBAdminAccountAdd#STATE_PROVINCE_SELECT" value1="${state}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="city" />
				<not>
					<contains string="${city}" substring="{city}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#CITY_FIELD" value1="${city}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="zip" />
				<not>
					<contains string="${zip}" substring="{zip}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#POSTAL_CODE_FIELD" value1="${zip}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="region" />
				<not>
					<contains string="${region}" substring="{region}" />
				</not>
			</and>
			<then>
				<var name="key_item" value="${region}" />

				<execute function="AssertClick" locator1="OSBAdminAccountAdd#SUPPORT_REGIONS_TAB" value1="Support Regions" />
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#SUPPORT_RESULT_ROW" value1="${region}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="language" />
				<not>
					<contains string="${language}" substring="{language}" />
				</not>
			</and>
			<then>
				<var name="key_item" value="${language}" />

				<execute function="AssertClick" locator1="OSBAdminAccountAdd#SUPPORT_LANGUAGES_TAB" value1="Support Languages" />
				<execute function="AssertTextEquals" locator1="OSBAdminAccountAdd#SUPPORT_RESULT_ROW" value1="${language}" />
			</then>
		</if>
	</command>

	<command name="viewProjectStatus">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<execute function="AssertTextEquals" locator1="OSBAdmin#SEARCH_RESULT_STATUS" value1="${status}" />
	</command>
</definition>