<definition>
	<command name="addProject">
		<execute function="AssertClick" locator1="OSBAdmin#PROJECTS_TAB" value1="Projects" />
		<execute function="Click" locator1="OSBAdmin#ADD_PROJECT_BUTTON" />

		<if>
			<isset var="businessAccountName" />
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#BUSINESS_ACCOUNT_NAME_FIELD" value1="${businessAccountName}" />
			</then>
		</if>

		<execute function="Type" locator1="OSBAdminAccountAdd#PROJECT_NAME_FIELD" value1="${projectName}" />
		<execute function="Type" locator1="OSBAdminAccountAdd#CODE_FIELD" value1="${code}" />

		<if>
			<isset var="type" />
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#TYPE_SELECT" value1="${type}" />
			</then>
		</if>

		<execute function="Select" locator1="OSBAdminAccountAdd#INDUSTRY_SELECT" value1="${industry}" />

		<if>
			<isset var="tier" />
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#TIER_SELECT" value1="${tier}" />
			</then>
		</if>

		<if>
			<isset var="maxContacts" />
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#MAXIMUM_CONTACTS_FIELD" value1="${maxContacts}" />
			</then>
		</if>

		<if>
			<isset var="specialInstructions" />
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#SPECIAL_INSTRUCTIONS_FIELD" value1="${specialInstructions}" />
			</then>
		</if>

		<if>
			<isset var="additionalNotes" />
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#ADDITIONAL_NOTES_FIELD" value1="${additionalNotes}" />
			</then>
		</if>

		<execute function="Type" locator1="OSBAdminAccountAdd#ADDRESS_LINE_FIELD" value1="${addressLine}" />

		<if>
			<isset var="country" />
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#COUNTRY_SELECT" value1="${country}" />
			</then>
		</if>

		<if>
			<isset var="state" />
			<then>
				<execute function="Select" locator1="OSBAdminAccountAdd#STATE_PROVINCE_SELECT" value1="${state}" />
			</then>
		</if>

		<execute function="Type" locator1="OSBAdminAccountAdd#CITY_FIELD" value1="${city}" />

		<if>
			<isset var="zip" />
			<then>
				<execute function="Type" locator1="OSBAdminAccountAdd#POSTAL_CODE_FIELD" value1="${zip}" />
			</then>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="assignCustomer">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON" />

		<execute macro="OSBAdminProject#assignUser">
			<var name="emailAddress" value="${emailAddress}" />
			<var name="role" value="${role}" />
		</execute>
	</command>

	<command name="assignUser">
		<execute function="AssertClick" locator1="OSBAdminAccountUsers#AVAILABLE_TAB" value1="Available" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${emailAddress}" />
		</execute>

		<var name="key_emailAddress" value="${emailAddress}" />

		<execute function="Check" locator1="OSBAdminAccountUsers#SEARCH_RESULT_CHECKBOX" />
		<execute function="Select" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ROLE_SELECT" value1="${role}" />
		<execute function="Click" locator1="OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="assignWorker">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_WORKERS_BUTTON" />

		<execute macro="OSBAdminProject#assignUser">
			<var name="emailAddress" value="${emailAddress}" />
			<var name="role" value="${role}" />
		</execute>
	</command>

	<command name="deleteCustomers">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_CUSTOMERS_BUTTON" />

		<execute macro="OSBAdminProject#deleteUsers" />
	</command>

	<command name="deleteUsers">
		<if>
			<condition function="IsVisible" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX" />
			<then>
				<execute function="AssertClick" locator1="OSBAdminAccountUsers#CURRENT_TAB" value1="Current" />
				<execute function="Uncheck" locator1="OSBAdminAccountUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX" />
				<execute function="Click" locator1="OSBAdminAccountUsers#UPDATE_ASSOCIATIONS_BUTTON" />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="deleteWorkers">
		<execute macro="OSBAdminProject#gotoAccount">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<execute function="Click" locator1="OSBAdminAccount#ASSIGN_WORKERS_BUTTON" />

		<execute macro="OSBAdminProject#deleteUsers" />
	</command>

	<command name="gotoAccount">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_CODE" value1="${projectCode}" />
	</command>

	<command name="tearDownProject">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<if>
			<condition function="IsElementPresent" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" />
			<then>
				<execute macro="OSBAdminProject#deleteCustomers">
					<var name="projectCode" value="${projectCode}" />
				</execute>

				<execute macro="OSBAdminProject#deleteWorkers">
					<var name="projectCode" value="${projectCode}" />
				</execute>

				<execute macro="OSBAdminSearch#searchBasicProject">
					<var name="projectCode" value="${projectCode}" />
				</execute>

				<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" value1="Actions" />
				<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />

				<execute function="Confirm" value1="Are you sure you want to delete this?" />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="viewProjectStatus">
		<execute macro="OSBAdminSearch#searchBasicProject">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${projectCode}" />

		<execute function="AssertTextEquals" locator1="OSBAdmin#SEARCH_RESULT_STATUS" value1="${status}" />
	</command>
</definition>