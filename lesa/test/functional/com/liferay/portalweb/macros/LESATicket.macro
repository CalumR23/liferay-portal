<definition>
	<command name="createTicketBasicForm">
		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="appServer" value="Tomcat 7.0" />
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="${configType}" />
			<var name="database" value="MySQL 5.5" />
			<var name="description" value="${description}" />
			<var name="javaVM" value="Java 7" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 13" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="summary" value="${summary}" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="Button#createTicket" />

		<execute macro="Message#success" />
	</command>
</definition>