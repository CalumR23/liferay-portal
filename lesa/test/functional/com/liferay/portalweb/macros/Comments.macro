<definition>
	<command name="addComment">
		<execute macro="Comments#clickCommentTab">
			<var name="commentType" value="${commentType}" />
		</execute>

		<if>
			<isset var="commentLines" />
			<then>
				<for list="${commentLines}" param="line">
					<execute function="KeyPress" locator1="TicketDetails#NEW_COMMENT_FIELD" value1="${line}" />
					<execute function="KeyPress" locator1="TicketDetails#NEW_COMMENT_FIELD" value1="\RETURN" />
				</for>
			</then>
			<else>
				<execute function="Type" locator1="TicketDetails#NEW_COMMENT_FIELD" value1="${comment}" />
			</else>
		</if>

		<if>
			<isset var="fileName" />
			<then>
				<execute function="Click" locator1="TicketDetails#ADD_ATTACHMENTS_BUTTON" />
				<execute function="UploadCommonFile" locator1="TicketDetails#BROWSE_1_BUTTON" value1="${fileName}" />
			</then>
		</if>

		<execute function="Click" locator1="TicketDetails#POST_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="clickCommentTab">
		<if>
			<equals arg1="${commentType}" arg2="Public" />
			<then>
				<execute function="Click" locator1="TicketDetails#PUBLIC_TAB" />
			</then>
			<elseif>
				<equals arg1="${commentType}" arg2="Worker" />
				<then>
					<execute function="Click" locator1="TicketDetails#WORKERS_TAB" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${commentType}" arg2="Liferay" />
				<then>
					<execute function="Click" locator1="TicketDetails#LIFERAY_TAB" />
				</then>
			</elseif>
		</if>
	</command>

	<command name="viewCommentAsCustomer">
		<execute macro="Navigation#gotoLESA" />

		<execute macro="Search#search">
			<var name="keyword" value="${ticketNumber}" />
		</execute>

		<var name="key_comment" value="${comment}" />

		<if>
			<equals arg1="${commentType}" arg2="Public" />
			<then>
				<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_TEXT" value1="${comment}" />
				<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
			</then>
			<else>
				<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
			</else>
		</if>
	</command>

	<command name="viewCommentAttachment">
		<execute macro="Comments#clickCommentTab">
			<var name="commentType" value="${commentType}" />
		</execute>

		<var name="key_comment" value="${comment}" />

		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_ATTACHMENT" value1="${fileName}" />
	</command>

	<command name="viewCommentWithReturns">
		<execute macro="Comments#clickCommentTab">
			<var name="commentType" value="${commentType}" />
		</execute>

		<for list="${commentLines}" param="line">
			<var name="key_comment" value="${line}" />

			<execute function="AssertTextEquals#assertPartialText" locator1="TicketDetails#COMMENT_TEXT" value1="${line}" />
			<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		</for>
	</command>

	<command name="viewLiferayComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="TicketDetails#PUBLIC_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#WORKERS_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#LIFERAY_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="TicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_VISIBILITY" value1="Visible to Liferay." />
	</command>

	<command name="viewPublicComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="TicketDetails#PUBLIC_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="TicketDetails#WORKERS_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#LIFERAY_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertElementPresent" locator1="TicketDetails#COMMENT_TEXT" />
	</command>

	<command name="viewWorkerComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="TicketDetails#PUBLIC_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#WORKERS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="TicketDetails#LIFERAY_TAB" />
		<execute function="AssertElementNotPresent" locator1="TicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="TicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#COMMENT_VISIBILITY" value1="Visible to Workers." />
	</command>
</definition>