<definition>
	<command name="assignWorker">
		<execute macro="Navigation#gotoAssignWorkers" />

		<var name="key_emailAddress" value="${emailAddress}" />

		<execute function="AssertClick" locator1="LESATicketWorkersEdit#AVAILABLE_TAB" value1="Available" />
		<execute function="Type" locator1="LESATicketWorkersEdit#EMAIL_ADDRESS_FIELD" value1="${emailAddress}" />

		<execute macro="Button#searchAdvanced" />

		<execute function="Check" locator1="LESATicketWorkersEdit#RESULT_ROW_CHECKBOX" />
		<execute function="Select" locator1="LESATicketWorkersEdit#RESULT_ROW_ROLE_SELECT" value1="${role}" />
		<execute function="Click" locator1="LESATicketWorkersEdit#RESULT_ROW_PRIMARY_RADIO" />
		<execute function="Click" locator1="LESATicketWorkersEdit#UPDATE_ASSOCIATIONS_BUTTON" />

		<execute macro="Message#success" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LESATicketWorkersEdit#BACK_TO_PREVIOUS_PAGE_BUTTON" value1="BACK TO PREVIOUS PAGE" />

		<execute function="AssertTextEquals" locator1="LESATicketDetails#ASSIGNEE_NAME" value1="${name}" />
	</command>

	<command name="changeTicketStatus">
		<execute macro="LESATicketTransition#selectTicketStatus">
			<var name="status" value="${newStatus}" />
		</execute>

		<if>
			<equals arg1="${newStatus}" arg2="Closed" />
			<then>
				<execute function="SelectNoError" locator1="LESATicketDetails#RESOLUTION_SELECT" value1="${resolution}" />

				<execute function="Confirm" value1="Are you sure you want to modify the status from (${currentStatus}) to (Closed - ${resolution})?" />

				<execute macro="LESATicketView#viewTicketResolution">
					<var name="resolution" value="(${resolution})" />
				</execute>
			</then>
			<else>
				<execute function="Confirm" value1="Are you sure you want to modify the status from (${currentStatus}) to (${newStatus})?" />
			</else>
		</if>

		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="${newStatus}" />
		</execute>
	</command>

	<command name="completeTicket">
		<execute function="Click" locator1="LESATicketDetails#COMPLETE_TICKET_BUTTON" />

		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Closed" />
		</execute>

		<execute macro="LESATicketView#viewTicketResolution">
			<var name="resolution" value="(Completed)" />
		</execute>
	</command>

	<command name="forwardTicket">
		<execute macro="Navigation#gotoForwardTicket" />

		<execute function="Type" locator1="LESATicketForward#MAIN_GOAL_FIELD" value1="${mainGoal}" />
		<execute function="Type" locator1="LESATicketForward#WORK_DONE_FIELD" value1="${workDone}" />
		<execute function="Type" locator1="LESATicketForward#CUSTOMER_NEXT_STEPS_FIELD" value1="${customerNextSteps}" />
		<execute function="Type" locator1="LESATicketForward#NEXT_REGION_NEXT_STEPS_FIELD" value1="${nextRegionNextSteps}" />
		<execute function="Click" locator1="LESATicketForward#FORWARD_BUTTON" />

		<execute macro="Message#success" />

		<execute function="AssertTextNotEquals" locator1="LESATicketDetails#ASSIGNEE_NAME" value1="${name}" />
	</command>

	<command name="reproduceSteps">
		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Reproduce" />
		</execute>

		<execute function="SelectWindow" locator1="title=Support" />

		<execute function="Type" locator1="LESATicketReproductionSteps#REPRODUCTION_STEPS_FIELD" value1="${steps}" />

		<execute function="ClickNoError" locator1="Button#SAVE_BUTTON" />

		<execute function="SelectWindow" locator1="null" />

		<execute macro="Message#success" />
	</command>

	<command name="selectTicketStatus">
		<execute function="Click" locator1="LESATicketDetails#STATUS" />
		<execute function="SelectNoError" locator1="LESATicketDetails#STATUS_SELECT" value1="${status}" />
	</command>

	<command name="workflowTicket">
		<var name="key_workflowStep" value="${workflowStep}" />

		<execute function="Click" locator1="LESATicketDetails#WORKFLOW_STEP_BUTTON" />
	</command>
</definition>