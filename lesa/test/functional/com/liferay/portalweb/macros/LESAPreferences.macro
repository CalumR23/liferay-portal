<definition>
	<command name="assertNoEnvironmentConfigurationsTab">
		<execute function="Click" locator1="LESALeftNavigation#PREFERENCES_BUTTON" />

		<execute function="AssertElementNotPresent" locator1="LESAPreferences#ENVIRONMENT_CONFIGURATIONS_TAB" />
	</command>

	<command name="changeStatusViaManagerDashboard">
		<execute macro="Navigation#gotoManagerDashboard" />

		<var name="key_cseName" value="${cseName}" />

		<if>
			<condition function="IsElementPresent" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_IN" />
			<then>
				<echo message="status= in" />
				<execute function="Click" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_TOGGLE" />
				<execute function="MouseOver" locator1="LESAPreferences#MANAGER_DASHBOARD_TAB" />

				<execute function="Pause" locator1="1000" />

				<execute function="AssertElementNotPresent" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_IN" />
				<execute function="AssertElementPresent" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_ON_PTO" />
			</then>
			<else>
				<echo message="status = on pto" />
				<execute function="Click" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_TOGGLE" />
				<execute function="MouseOver" locator1="LESAPreferences#MANAGER_DASHBOARD_TAB" />

				<execute function="Pause" locator1="1000" />

				<execute function="AssertElementPresent" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_IN" />
				<execute function="AssertElementNotPresent" locator1="LESAPreferences#MANAGER_DASHBOARD_STATUS_ON_PTO" />
			</else>
		</if>

		<execute macro="Message#success" />
	</command>

	<command name="createEnvironmentConfiguration">
		<execute macro="Navigation#gotoEnvironmentConfigurations" />

		<execute function="Click" locator1="LESAEnvironmentConfigurations#CREATE_ENVIRONMENT_BUTTON" />
		<execute function="SelectFrame" locator1="LESAEnvironmentConfigurations#ENVIRONMENT_CONFIGURATION_IFRAME" />
		<execute function="Type" locator1="LESAEnvironmentConfigurations#NAME_FIELD"  value1="${name}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#SERVER_SELECT"  value1="${server}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#LIFERAY_VERSION_SELECT"  value1="${liferayVersion}" />
		<execute function="Click" locator1="LESAEnvironmentConfigurations#CREATE_BUTTON" />

		<execute function="SelectWindow" locator1="null" />
	</command>

	<command name="tearDownEnvironmentConfiguration">
		<var name="key_name" value="${name}" />
		<var name="key_product" value="${product}" />

		<if>
			<condition function="IsElementPresent" locator1="LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_DELETE_BUTTON" />
			<then>
				<execute function="ClickNoError" locator1="LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_DELETE_BUTTON" />
				<execute function="Confirm" value1="Are you sure you want to delete your saved environment configuration &quot;${name}&quot; permanently? This change cannot be undone." />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="updateEnvironmentConfiguration">
		<execute macro="Navigation#gotoEnvironmentConfigurations" />

		<var name="key_name" value="${name}" />
		<var name="key_product" value="${product}" />

		<execute function="Click" locator1="LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_EDIT_BUTTON" />
		<execute function="SelectFrame" locator1="LESAEnvironmentConfigurations#ENVIRONMENT_CONFIGURATION_IFRAME" />
		<execute function="Type" locator1="LESAEnvironmentConfigurations#NAME_FIELD"  value1="${newName}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#APPLICATION_SERVER_SELECT"  value1="${appServer}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#OPERATING_SYSTEM_SELECT"  value1="${os}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#DATABASE_SELECT"  value1="${database}" />
		<execute function="Select" locator1="LESAEnvironmentConfigurations#JAVA_VIRTUAL_MACHINE_SELECT"  value1="${jvm}" />
		<execute function="UploadCommonFile" locator1="LESAEnvironmentConfigurations#PORTAL_EXT_FILE" value1="${portalExtFile}" />
		<execute function="UploadCommonFile" locator1="LESAEnvironmentConfigurations#PATCH_LEVEL_FILE" value1="${patchLevelFile}" />

		<execute function="Click" locator1="Button#UPDATE_BUTTON" />

		<execute function="SelectWindow" locator1="null" />
	</command>

	<command name="viewEnvironmentConfiguration">
		<var name="key_name" value="${name}" />
		<var name="key_product" value="${product}" />

		<for list="${contentList}" param="content">
			<var name="key_content" value="${content}" />

			<execute function="AssertElementPresent" locator1="LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_CONTENT" />
		</for>
	</command>
</definition>