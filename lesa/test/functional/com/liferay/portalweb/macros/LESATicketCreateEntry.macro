<definition>
	<command name="selectNewConfig">
		<execute function="Select" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" value1="Select New Configuration" />
		<execute function="Select" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" value1="${liferayVersion}" />
		<execute function="Select" locator1="LESATicketCreate#APPLICATION_SERVER_SELECT" value1="${appServer}" />
		<execute function="Select" locator1="LESATicketCreate#OPERATING_SYSTEM_SELECT" value1="${operatingSystem}" />
		<execute function="Select" locator1="LESATicketCreate#DATABASE_SELECT" value1="${database}" />
		<execute function="Select" locator1="LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT" value1="${javaVM}" />

		<execute macro="LESATicketCreateEntry#uploadPatchLevel" />

		<execute macro="LESATicketCreateEntry#uploadPortalExt" />
	</command>

	<command name="selectSavedConfig">
		<execute function="Select" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" value1="${savedEnvConfigName}" />
		<execute function="Check" locator1="LESATicketCreate#PORTAL_EXT_CHECKBOX" />
		<execute function="Check" locator1="LESATicketCreate#PATCH_LEVEL_CHECKBOX" />
	</command>

	<command name="uploadPatchLevel">
		<execute function="Click" locator1="LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="patchinfo.txt" />
	</command>

	<command name="uploadPortalExt">
		<execute function="Click" locator1="LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="portal-ext.properties" />
	</command>

	<command name="uploadToPatchLevel">
		<execute function="ScrollWebElementIntoView" locator1="LESATicketCreate#CREATE_BUTTON" />
		<execute function="Click" locator1="LESATicketCreate#UPLOAD_TO_PATCH_LEVEL_BUTTON" />
		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="patchinfo.txt" />
	</command>

	<command name="uploadToPortalExt">
		<execute function="Click" locator1="LESATicketCreate#UPLOAD_TO_PORTAL_EXT_BUTTON" />
		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="Document_1.txt" />
	</command>
</definition>