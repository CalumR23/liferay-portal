<definition>
	<command name="selectComponent">
		<execute function="Select" locator1="LESATicketCreate#COMPONENT_SELECT" value1="${component}" />
	</command>

	<command name="selectEnvironmentConfiguration">
		<execute function="Select" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" value1="${configuration}" />
	</command>

	<command name="selectLiferayVersion">
		<execute function="Select" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" value1="${liferayVersion}" />
	</command>

	<command name="selectNewConfig">
		<execute macro="LESATicketCreateEntry#selectEnvironmentConfiguration">
			<var name="configuration" value="Select New Configuration" />
		</execute>

		<execute function="Select" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" value1="${liferayVersion}" />
		<execute function="Select" locator1="LESATicketCreate#APPLICATION_SERVER_SELECT" value1="${appServer}" />
		<execute function="Select" locator1="LESATicketCreate#OPERATING_SYSTEM_SELECT" value1="${operatingSystem}" />
		<execute function="Select" locator1="LESATicketCreate#DATABASE_SELECT" value1="${database}" />
		<execute function="Select" locator1="LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT" value1="${javaVM}" />

		<execute macro="LESATicketCreateEntry#uploadPatchLevel" />

		<execute macro="LESATicketCreateEntry#uploadPortalExt" />
	</command>

	<command name="selectProduct">
		<if>
			<condition function="IsElementPresent" locator1="LESATicketCreate#PRODUCT_SELECT" />
			<then>
				<var name="key_item" value="${product}" />

				<execute function="AssertElementPresent" locator1="LESATicketCreate#PRODUCT_SELECT_ITEM" />
				<execute function="Select" locator1="LESATicketCreate#PRODUCT_SELECT" value1="${product}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESATicketCreate#PRODUCT" value1="${product}" />
			</else>
		</if>
	</command>

	<command name="selectProject">
		<if>
			<condition function="IsElementPresent" locator1="LESATicketCreate#PROJECT_SELECT" />
			<then>
				<execute function="Select" locator1="LESATicketCreate#PROJECT_SELECT" value1="${project}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESATicketCreate#PROJECT_NAME" value1="${project}" />
			</else>
		</if>
	</command>

	<command name="selectSavedConfig">
		<execute macro="LESATicketCreateEntry#selectEnvironmentConfiguration">
			<var name="configuration" value="${savedEnvConfigName}" />
		</execute>

		<!-- Temporary workaround for LRIS-21152.  Remove this when issue is resolved. -->

		<var method="StringUtil#extractLast('${savedEnvConfigName}',' ')" name="liferayVersion" />

		<if>
			<equals arg1="${liferayVersion}" arg2="6.2" />
			<then>
				<execute function="Select" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" value1="6.2 EE" />
			</then>
			<else>
				<execute function="Select" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" value1="7.0 DE" />
			</else>
		</if>

		<!-- End temp workaround -->

		<if>
			<condition function="IsElementPresent" locator1="LESATicketCreate#PATCH_LEVEL_FILE_NAME" />
			<then>
				<execute function="Check" locator1="LESATicketCreate#PATCH_LEVEL_CHECKBOX" />
			</then>
			<else>
				<execute macro="LESATicketCreateEntry#uploadPatchLevel" />
			</else>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="LESATicketCreate#PORTAL_EXT_FILE_NAME" />
			<then>
				<execute function="Check" locator1="LESATicketCreate#PORTAL_EXT_CHECKBOX" />
			</then>
			<else>
				<execute macro="LESATicketCreateEntry#uploadPortalExt" />
			</else>
		</if>
	</command>

	<command name="selectServer">
		<if>
			<condition function="IsElementPresent" locator1="LESATicketCreate#SERVER_SELECT" />
			<then>
				<execute function="Select" locator1="LESATicketCreate#SERVER_SELECT" value1="${server}" />
			</then>
		</if>
	</command>

	<command name="uploadPatchLevel">
		<execute function="ScrollWebElementIntoView" locator1="LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON" />
		<execute function="MouseDown" locator1="LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON" />
		<execute function="MouseUp" locator1="LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="patchinfo.txt" />
	</command>

	<command name="uploadPortalExt">
		<execute function="ScrollWebElementIntoView" locator1="LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON" />
		<execute function="MouseDown" locator1="LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON" />
		<execute function="MouseUp" locator1="LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="portal-ext.properties" />
	</command>

	<command name="uploadToPatchLevel">
		<execute function="ScrollWebElementIntoView" locator1="LESATicketCreate#CREATE_BUTTON" />
		<execute function="MouseDown" locator1="LESATicketCreate#UPLOAD_TO_PATCH_LEVEL_BUTTON" />
		<execute function="MouseUp" locator1="LESATicketCreate#UPLOAD_TO_PATCH_LEVEL_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="Document_2.txt" />

		<execute function="AssertTextEquals" locator1="LESATicketCreate#TO_PATCH_LEVEL_FILE_NAME" value1="Document_2.txt" />
	</command>

	<command name="uploadToPortalExt">
		<execute function="MouseDown" locator1="LESATicketCreate#UPLOAD_TO_PORTAL_EXT_BUTTON" />
		<execute function="MouseUp" locator1="LESATicketCreate#UPLOAD_TO_PORTAL_EXT_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="Document_1.txt" />

		<execute function="AssertTextEquals" locator1="LESATicketCreate#TO_PORTAL_EXT_FILE_NAME" value1="Document_1.txt" />
	</command>
</definition>