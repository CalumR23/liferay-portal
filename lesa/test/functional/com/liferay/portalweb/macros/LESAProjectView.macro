<definition>
	<command name="viewCallLog">
		<execute function="AssertClick" locator1="LESAProjectDetails#CALL_LOG_TAB" value1="Call Log" />

		<var name="key_callDate" value="${callDate}" />
		<var name="key_summary" value="${summary}" />

		<execute function="AssertElementPresent" locator1="LESAProjectDetails#CALL_LOG_ROW" />
		<execute function="AssertClick" locator1="LESAProjectDetails#CALL_LOG_SUMMARY" value1="${summary}" />

		<if>
			<not>
				<condition function="IsVisible" locator1="Button#DELETE_BUTTON" />
			</not>
			<then>
				<execute function="AssertClick" locator1="LESAProjectDetails#CALL_LOG_SUMMARY" value1="${summary}" />
			</then>
		</if>

		<var name="key_callLength" value="${callLength}" />
		<var name="key_callType" value="${callType}" />

		<execute function="AssertElementPresent" locator1="LESAProjectDetails#CALL_TYPE_FIELD" />
		<execute function="AssertElementPresent" locator1="LESAProjectDetails#CALL_LENGTH_FIELD" />

		<if>
			<isset var="summary" />
			<then>
				<execute function="AssertElementPresent" locator1="LESAProjectDetails#SUMMARY_FIELD" />
			</then>
		</if>

		<if>
			<isset var="clientsPresent" />
			<then>
				<var name="key_clientsPresent" value="${clientsPresent}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#CLIENTS_PRESENT_FIELD" />
			</then>
		</if>

		<if>
			<isset var="notes" />
			<then>
				<var name="key_notes" value="${notes}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#NOTES_FIELD" />
			</then>
		</if>

		<if>
			<isset var="actionItems" />
			<then>
				<var name="key_actionItems" value="${actionItems}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#ACTION_ITEMS_FIELD" />
			</then>
		</if>
	</command>

	<command name="viewCASInformation">
		<execute function="AssertClick" locator1="LESAProjectDetails#CAS_INFORMATION_TAB" value1="CAS Information" />

		<if>
			<isset var="reasonsForStrategic" />
			<then>
				<var name="key_reasonsForStrategic" value="${reasonsForStrategic}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#REASONS_FOR_STRATEGIC_ROW" />
			</then>
		</if>

		<if>
			<isset var="projectOverview" />
			<then>
				<var name="key_projectOverview" value="${projectOverview}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#PROJECT_OVERVIEW_ROW" />
			</then>
		</if>

		<if>
			<isset var="contactOverview" />
			<then>
				<var name="key_contactOverview" value="${contactOverview}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#CONTACT_OVERVIEW_ROW" />
			</then>
		</if>

		<if>
			<isset var="majorMilestones" />
			<then>
				<var name="key_majorMilestones" value="${majorMilestones}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#MILESTONES_ROW" />
			</then>
		</if>

		<if>
			<isset var="otherInformation" />
			<then>
				<var name="key_otherInformation" value="${otherInformation}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#OTHER_INFORMATION_ROW" />
			</then>
		</if>
	</command>

	<command name="viewCEMCXMInformation">
		<execute function="AssertClick" locator1="LESAProjectDetails#CEM_CXM_INFORMATION_TAB" value1="CEM/CXM Information" />

		<if>
			<isset var="licenseInformation" />
			<then>
				<var name="key_licenseInformation" value="${licenseInformation}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#LICENSE_INFORMATION_ROW" />
			</then>
		</if>

		<if>
			<isset var="salesforceURL" />
			<then>
				<var name="key_salesforceURL" value="${salesforceURL}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#SALESFORCE_URL_ROW" />
			</then>
		</if>

		<if>
			<isset var="trainingsAttended" />
			<then>
				<var name="key_trainingsAttended" value="${trainingsAttended}" />

				<execute function="AssertElementPresent" locator1="LESAProjectDetails#TRAININGS_ATTENDED_ROW" />
			</then>
		</if>
	</command>
</definition>