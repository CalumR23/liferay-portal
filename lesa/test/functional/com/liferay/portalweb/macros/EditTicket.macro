<definition>
	<command name="addLinks">
		<execute function="Click" locator1="TicketDetails#LINKS_TAB" />

		<if>
			<isset var="url" />
			<then>
				<execute function="Type" locator1="TicketDetails#URL_1_FIELD" value1="${url}" />
			</then>
		</if>

		<if>
			<isset var="url1" />
			<then>
				<execute function="Type" locator1="TicketDetails#URL_1_FIELD" value1="${url1}" />
			</then>
		</if>

		<if>
			<isset var="url2" />
			<then>
				<execute function="Type" locator1="TicketDetails#URL_2_FIELD" value1="${url2}" />
			</then>
		</if>

		<if>
			<isset var="url3" />
			<then>
				<execute function="Type" locator1="TicketDetails#URL_3_FIELD" value1="${url3}" />
			</then>
		</if>

		<execute function="Select" locator1="TicketDetails#VISIBILITY_SELECT" value1="${visibility}" />
		<execute function="Click" locator1="TicketDetails#SAVE_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="editTicketDetails">
		<execute function="SelectFrame" locator1="EditTicket#EDIT_TICKET_IFRAME" />
		<execute function="Type" locator1="EditTicket#SUMMARY_FIELD" value1="${subject}" />
		<execute function="Type" locator1="EditTicket#DESCRIPTION_FIELD" value1="${description}" />
		<execute function="Select" locator1="EditTicket#COMPONENT_SELECT" value1="${component}" />
		<execute function="Select" locator1="EditTicket#STATUS_SELECT" value1="${status}" />

		<execute function="ScrollWebElementIntoView" locator1="Button#SAVE_BUTTON" />
		<execute function="Click" locator1="Button#SAVE_BUTTON" />

		<execute function="SelectFrame" value1="relative=top" />
	</command>
</definition>