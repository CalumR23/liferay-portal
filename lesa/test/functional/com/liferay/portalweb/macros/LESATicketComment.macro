<definition>
	<command name="addComment">
		<execute macro="LESAHomepage#closeAllBanners" />

		<if>
			<isset var="commentType" />
			<then>
				<execute macro="LESATicketComment#clickCommentTab">
					<var name="commentType" value="${commentType}" />
				</execute>
			</then>
		</if>

		<execute macro="LESATicketComment#inputCommentText">
			<var name="comment" value="${comment}" />
			<var name="commentLines" value="${commentLines}" />
		</execute>

		<if>
			<isset var="fileName" />
			<then>
				<execute macro="LESATicketComment#inputCommentAttachment">
					<var name="fileName" value="${fileName}" />
				</execute>
			</then>
		</if>

		<execute function="Click" locator1="LESATicketDetails#POST_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="addCommentWithDuplicateAttachment">
		<execute macro="LESATicketComment#inputCommentText">
			<var name="comment" value="${comment}." />
		</execute>

		<execute macro="LESATicketComment#inputCommentAttachment">
			<var name="fileName" value="${fileName}" />
		</execute>

		<execute function="Click" locator1="LESATicketDetails#POST_BUTTON" />

		<execute macro="Message#error">
			<var name="errorMessage" value="Your request failed to complete." />
		</execute>

		<execute macro="Message#error">
			<var name="errorMessage" value="Please enter a unique document name." />
		</execute>

		<var name="key_comment" value="${comment}" />

		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
	</command>

	<command name="assertCommentNotEditable">
		<var name="key_comment" value="${comment}" />

		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_THREE_DOT_MENU" />
	</command>

	<command name="clickCommentTab">
		<if>
			<equals arg1="${commentType}" arg2="Public" />
			<then>
				<execute function="Click" locator1="LESATicketDetails#PUBLIC_TAB" />
			</then>
			<elseif>
				<equals arg1="${commentType}" arg2="Worker" />
				<then>
					<execute function="Click" locator1="LESATicketDetails#WORKERS_TAB" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${commentType}" arg2="Liferay" />
				<then>
					<execute function="Click" locator1="LESATicketDetails#LIFERAY_TAB" />
				</then>
			</elseif>
		</if>
	</command>

	<command name="inputCommentAttachment">
		<execute function="Click" locator1="LESATicketDetails#ADD_ATTACHMENTS_BUTTON" />
		<execute function="UploadCommonFile" locator1="LESATicketDetails#BROWSE_1_BUTTON" value1="${fileName}" />
	</command>

	<command name="inputCommentText">
		<if>
			<isset var="commentLines" />
			<then>
				<for list="${commentLines}" param="line">
					<execute function="KeyPress" locator1="LESATicketDetails#NEW_COMMENT_FIELD" value1="${line}" />
					<execute function="KeyPress" locator1="LESATicketDetails#NEW_COMMENT_FIELD" value1="\RETURN" />
				</for>
			</then>
			<else>
				<execute function="Type" locator1="LESATicketDetails#NEW_COMMENT_FIELD" value1="${comment}" />
			</else>
		</if>
	</command>

	<command name="viewCommentAsCustomer">
		<execute macro="Navigation#gotoTicket">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>

		<var name="key_comment" value="${comment}" />

		<if>
			<equals arg1="${commentType}" arg2="Public" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_TEXT" value1="${comment}" />
				<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
			</then>
			<else>
				<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
			</else>
		</if>
	</command>

	<command name="viewCommentAttachment">
		<execute macro="LESATicketComment#clickCommentTab">
			<var name="commentType" value="${commentType}" />
		</execute>

		<var name="key_comment" value="${comment}" />

		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_ATTACHMENT" value1="${fileName}" />
	</command>

	<command name="viewCommentWithReturns">
		<execute macro="LESATicketComment#clickCommentTab">
			<var name="commentType" value="${commentType}" />
		</execute>

		<for list="${commentLines}" param="line">
			<var name="key_comment" value="${line}" />

			<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetails#COMMENT_TEXT" value1="${line}" />
			<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		</for>
	</command>

	<command name="viewLiferayComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="LESATicketDetails#PUBLIC_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#WORKERS_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#LIFERAY_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="LESATicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_VISIBILITY" value1="Visible to Liferay." />
	</command>

	<command name="viewPublicComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="LESATicketDetails#PUBLIC_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="LESATicketDetails#WORKERS_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#LIFERAY_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertElementPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
	</command>

	<command name="viewWorkerComment">
		<var name="key_comment" value="${comment}" />

		<execute function="Click" locator1="LESATicketDetails#PUBLIC_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#WORKERS_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_TEXT" value1="${comment}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${commentCreator}" />
		<execute function="Click" locator1="LESATicketDetails#LIFERAY_TAB" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMMENT_TEXT" />
		<execute function="Click" locator1="LESATicketDetails#ALL_COMMENTS_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_VISIBILITY" value1="Visible to Workers." />
	</command>
</definition>