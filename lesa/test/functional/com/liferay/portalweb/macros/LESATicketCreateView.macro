<definition>
	<command name="viewASDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envAS" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewBRDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envBrowser" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewCSDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envCS" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewDBDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envDB" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewDropdownItems">
		<var name="key_dropdownName" value="${dropdownName}" />

		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#ENVIRONMENT_DROPDOWN_LIST_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewJVMDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envJVM" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewOSDropdownItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envOS" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>

	<command name="viewSHMultiselectItems">
		<execute macro="LESATicketCreateView#viewDropdownItems">
			<var name="dropdownName" value="envSearch" />
			<var name="itemList" value="${itemList}" />
		</execute>
	</command>
</definition>