<definition>
	<command name="viewASDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#APPLICATION_SERVER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewBRDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#BROWSER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewCSDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#CLOUD_SERVER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewDBDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#DATABASE_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewJVMDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewOSDropdownItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#OPERATING_SYSTEM_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewSHMultiselectItems">
		<for list="${itemList}" param="item" >
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#SEARCH_SELECT_ITEM" value1="${item}" />
		</for>
	</command>
</definition>