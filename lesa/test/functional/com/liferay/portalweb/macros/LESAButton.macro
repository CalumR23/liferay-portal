<definition>
	<command name="next">
		<execute function="Click" locator1="LESAButton#NEXT_BUTTON" />
	</command>

	<command name="save">
		<execute function="Click" locator1="LESAButton#SAVE_BUTTON" />
	</command>

	<command name="search">
		<execute function="Click" locator1="LESAButton#SEARCH_BUTTON" />
	</command>

	<command name="searchAdvanced">
		<execute function="Click" locator1="LESAButton#ADVANCED_SEARCH_BUTTON" />
	</command>

	<command name="send">
		<execute function="ClickNoError" locator1="LESAButton#SEND_BUTTON" />
	</command>
</definition>