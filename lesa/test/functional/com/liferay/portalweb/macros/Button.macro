<definition>
	<command name="createTicket">
		<execute function="Click" locator1="CreateTicket#CREATE_BUTTON" />
	</command>

	<command name="newTicket">
		<execute function="Click" locator1="Button#NEW_TICKET_BUTTON" />
	</command>

	<command name="save">
		<execute function="Click" locator1="Button#SAVE_BUTTON" />
	</command>

	<command name="search">
		<execute function="Click" locator1="Button#SEARCH_BUTTON" />
	</command>

	<command name="send">
		<execute function="ClickNoError" locator1="Button#SEND_BUTTON" />
	</command>
</definition>