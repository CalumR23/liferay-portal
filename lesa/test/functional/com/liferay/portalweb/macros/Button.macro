<definition>
	<command name="next">
		<execute function="Click" locator1="Button#NEXT_BUTTON" />
	</command>

	<command name="save">
		<execute function="Click" locator1="Button#SAVE_BUTTON" />
	</command>

	<command name="search">
		<execute function="Click" locator1="Button#SEARCH_BUTTON" />
	</command>

	<command name="searchAdvanced">
		<execute function="Click" locator1="Button#ADVANCED_SEARCH_BUTTON" />
	</command>

	<command name="send">
		<execute function="ClickNoError" locator1="Button#SEND_BUTTON" />
	</command>
</definition>