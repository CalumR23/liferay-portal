<definition>
	<command name="viewNoProjectMessages">
		<execute function="Click" locator1="LESALeftNavigation#MESSAGES_BUTTON" />

		<execute macro="Message#info">
			<var name="message" value="There are no messages regarding your Liferay Subscription at this time." />
		</execute>
	</command>

	<command name="viewProjectMessage">
		<execute function="Click" locator1="LESALeftNavigation#MESSAGES_BUTTON" />

		<var name="key_severity" value="${severity}" />
		<var name="key_title" value="${projectName}: ${title}" />

		<execute function="AssertElementPresent" locator1="LESASubscriptionMessages#MESSAGE_TITLE" />
		<execute function="Click" locator1="LESASubscriptionMessages#MESSAGE_TITLE" />
		<execute function="AssertTextEquals" locator1="LESASubscriptionMessages#MESSAGE_CONTENT" value1="${message}" />
	</command>

	<command name="viewProjectMessageNotPresent">
		<var name="key_title" value="${projectName}: ${title}" />

		<execute function="AssertElementNotPresent" locator1="LESASubscriptionMessages#MESSAGE_TITLE" />
	</command>
</definition>