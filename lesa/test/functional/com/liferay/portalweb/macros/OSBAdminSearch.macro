<definition>
	<command name="deleteSearchResultRow">
		<var name="key_code" value="${code}" />

		<if>
			<condition function="IsElementPresent" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" />
			<then>
				<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" value1="Actions" />
				<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />

				<execute function="Confirm" value1="Are you sure you want to delete this?" />

				<execute macro="Message#success" />
			</then>
		</if>
	</command>

	<command name="searchAdvancedOrders">
		<execute macro="Navigation#gotoOSBAdminSalesOrders" />

		<if>
			<condition function="IsVisible" locator1="OSBAdmin#ADVANCED_SEARCH_TOGGLE" />
			<then>
				<execute function="Click" locator1="OSBAdmin#ADVANCED_SEARCH_TOGGLE" />
			</then>
		</if>

		<if>
			<isset var="projectCode" />
			<then>
				<execute function="Click" locator1="OSBAdminSalesOrders#ADVANCED_SEARCH_CHOOSE_BUTTON" />

				<execute function="SelectWindow" locator1="title=Control Panel" />

				<execute function="Type" locator1="OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD" value1="${projectCode}" />

				<execute macro="Button#search" />

				<var name="key_code" value="${projectCode}" />

				<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_CODE" />
			</then>
		</if>

		<execute function="SelectWindow" locator1="null" />

		<execute macro="Button#searchAdvanced" />
	</command>

	<command name="searchBasic">
		<if>
			<condition function="IsVisible" locator1="OSBAdmin#BASIC_SEARCH_TOGGLE" />
			<then>
				<execute function="Click" locator1="OSBAdmin#BASIC_SEARCH_TOGGLE" />
			</then>
		</if>

		<execute function="Type" locator1="OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD" value1="${keyword}" />

		<execute macro="Button#search" />
	</command>

	<command name="searchBasicPartner">
		<execute macro="Navigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#PARTNERS_TAB" value1="Partners" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${partnerCode}" />
		</execute>
	</command>

	<command name="searchBasicProject">
		<execute macro="Navigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#PROJECTS_TAB" value1="Projects" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${projectCode}" />
		</execute>
	</command>

	<command name="searchOffering">
		<execute macro="Navigation#gotoOSBAdminSalesOfferings" />

		<execute function="Select" locator1="OSBAdminSalesOfferings#PRODUCT_SELECT" value1="${product}" />
		<execute function="Select" locator1="OSBAdminSalesOfferings#SUPPORT_SELECT" value1="${support}" />
		<execute function="Select" locator1="OSBAdminSalesOfferings#CURRENCY_SELECT" value1="${currency}" />

		<execute macro="Button#search" />
	</command>
</definition>