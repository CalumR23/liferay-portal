<definition>
	<command name="searchBasic">
		<if>
			<condition function="IsVisible" locator1="OSBAdminProjects#BASIC_SEARCH_TOGGLE" />
			<then>
				<execute function="Click" locator1="OSBAdminProjects#BASIC_SEARCH_TOGGLE" />
			</then>
		</if>

		<execute function="Type" locator1="OSBAdminProjects#BASIC_SEARCH_KEYWORD_FIELD" value1="${keyword}" />
		<execute function="Click" locator1="OSBAdminProjects#SEARCH_BUTTON" />
	</command>

	<command name="searchBasicProject">
		<execute function="Click" locator1="LESANavigation#OSB_ADMIN" />

		<execute function="AssertClick" locator1="OSBAdminProjects#PROJECTS_TAB" value1="Projects" />

		<execute macro="OSBAdminSearch#searchBasic">
			<var name="keyword" value="${projectCode}" />
		</execute>
	</command>
</definition>