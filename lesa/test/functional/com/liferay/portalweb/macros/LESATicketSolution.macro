<definition>
	<command name="acceptSolution">
		<execute function="Click" locator1="LESATicketDetails#SOLUTION_TAB" />
		<execute function="AssertClick" locator1="LESATicketDetails#YES_BUTTON" value1="YES" />

		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Resolved" />
		</execute>

		<execute function="AssertClick" locator1="LESATicketDetails#YES_BUTTON" value1="YES" />

		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Closed" />
		</execute>

		<execute macro="LESATicketView#viewTicketResolution">
			<var name="resolution" value="(Completed)" />
		</execute>
	</command>

	<command name="proposeSolution">
		<execute function="SelectWindow" locator1="title=Support" />

		<execute function="Type" locator1="LESATicketSolutionProposedDetails#DESCRIPTION_FIELD" value1="${solutionDescription}" />

		<execute function="ScrollWebElementIntoView" locator1="LESATicketSolutionProposedDetails#URL_1_FIELD" />

		<if>
			<isset var="fileName" />
			<then>
				<execute function="MouseDown" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON" />
				<execute function="MouseUp" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON" />

				<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="${fileName}" />
			</then>
		</if>

		<if>
			<isset var="fileName1" />
			<then>
				<execute function="MouseDown" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON" />
				<execute function="MouseUp" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON" />

				<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="${fileName1}" />
			</then>
		</if>

		<if>
			<isset var="fileName2" />
			<then>
				<execute function="MouseDown" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_2_BUTTON" />
				<execute function="MouseUp" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_2_BUTTON" />

				<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="${fileName2}" />
			</then>
		</if>

		<if>
			<isset var="fileName3" />
			<then>
				<execute function="MouseDown" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_3_BUTTON" />
				<execute function="MouseUp" locator1="LESATicketSolutionProposedDetails#UPLOAD_FILE_3_BUTTON" />

				<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="${fileName3}" />
			</then>
		</if>

		<if>
			<isset var="url" />
			<then>
				<execute function="Type" locator1="LESATicketSolutionProposedDetails#URL_1_FIELD" value1="${url}" />
				<if>
					<condition function="IsElementPresent" locator1="LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT" />
					<then>
						<execute function="Select" locator1="LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT" value1="${urlType}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url1" />
			<then>
				<execute function="Type" locator1="LESATicketSolutionProposedDetails#URL_1_FIELD" value1="${url1}" />
				<if>
					<condition function="IsElementPresent" locator1="LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT" />
					<then>
						<execute function="Select" locator1="LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT" value1="${urlType1}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url2" />
			<then>
				<execute function="Type" locator1="LESATicketSolutionProposedDetails#URL_2_FIELD" value1="${url2}" />
				<if>
					<condition function="IsElementPresent" locator1="LESATicketSolutionProposedDetails#URL_2_TYPE_SELECT" />
					<then>
						<execute function="Select" locator1="LESATicketSolutionProposedDetails#URL_2_TYPE_SELECT" value1="${urlType2}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url3" />
			<then>
				<execute function="Type" locator1="LESATicketSolutionProposedDetails#URL_3_FIELD" value1="${url3}" />
				<if>
					<condition function="IsElementPresent" locator1="LESATicketSolutionProposedDetails#URL_3_TYPE_SELECT" />
					<then>
						<execute function="Select" locator1="LESATicketSolutionProposedDetails#URL_3_TYPE_SELECT" value1="${urlType3}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="subcomponent" />
			<then>
				<execute function="Select" locator1="LESATicketSolutionProposedDetails#SUBCOMPONENT_SELECT" value1="${subcomponent}" />
			</then>
		</if>

		<if>
			<isset var="issueType" />
			<then>
				<execute function="Select" locator1="LESATicketSolutionProposedDetails#ISSUE_TYPE_SELECT" value1="${issueType}" />
			</then>
		</if>

		<if>
			<isset var="issueSummary" />
			<then>
				<execute function="Select" locator1="LESATicketSolutionProposedDetails#ISSUE_SUMMARY_SELECT" value1="${issueSummary}" />
			</then>
		</if>

		<if>
			<isset var="issueSummaryDescription" />
			<then>
				<execute function="Type" locator1="LESATicketSolutionProposedDetails#ISSUE_SUMMARY_DESCRIPTION_FIELD" value1="${issueSummaryDescription}" />
			</then>
		</if>

		<execute macro="Button#send" />

		<execute function="SelectWindow" locator1="null" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Proposed" />
		</execute>
	</command>

	<command name="rejectSolution">
		<execute function="Click" locator1="LESATicketDetails#SOLUTION_TAB" />
		<execute function="AssertClick" locator1="LESATicketDetails#NO_BUTTON" value1="NO" />

		<execute function="Select" locator1="LESATicketSolutionRejected#REASON_SELECT" value1="${reason}" />
		<execute function="Type" locator1="LESATicketSolutionRejected#EXPLANATION_FIELD" value1="${explanation}" />

		<execute macro="Button#send" />

		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Investigating" />
		</execute>
	</command>

	<command name="viewProposedSolution">
		<execute function="Click" locator1="LESATicketDetails#SOLUTION_TAB" />

		<if>
			<isset var="issueSummary" />
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetails#ISSUE_SUMMARY" value1="Issue Summary: ${issueSummary}" />
			</then>
		</if>

		<if>
			<isset var="issueSummaryDescription" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#ISSUE_SUMMARY_DESCRIPTION" value1="${issueSummaryDescription}" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTION_DESCRIPTION" value1="${solutionDescription}" />

		<if>
			<isset var="fileNames" />
			<then>
				<for list="${fileNames}" param="file">
					<var name="key_fileName" value="${file}" />

					<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTION_ATTACHMENTS" value1="${file}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="urls" />
			<then>
				<for list="${urls}" param="url">
					<var name="key_url" value="${url}" />

					<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTION_LINKS" value1="${url}" />
				</for>
			</then>
		</if>
	</command>

	<command name="viewProposedSolutionComment">
		<execute function="Click" locator1="LESATicketDetails#SOLUTIONS_TAB" />

		<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_PROPOSER_NAME" value1="${solutionProposer}" />

		<if>
			<isset var="issueSummary" />
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetails#SOLUTIONS_ISSUE_SUMMARY" value1="Issue Summary: ${issueSummary}" />
				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_ISSUE_SUMMARY_DESCRIPTION" value1="${issueSummaryDescription}" />
				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_DESCRIPTION" value1="${solutionDescription}" />
			</then>
		</if>

		<if>
			<isset var="fileNames" />
			<then>
				<for list="${fileNames}" param="file">
					<var name="key_fileName" value="${file}" />

					<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_ATTACHMENTS" value1="${file}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="url" />
			<then>
				<var name="key_url" value="${url}" />

				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK" value1="${url}" />

				<if>
					<condition function="IsElementPresent" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" />
					<then>
						<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" value1="${urlType}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url1" />
			<then>
				<var name="key_url" value="${url1}" />

				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK" value1="${url1}" />

				<if>
					<condition function="IsElementPresent" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" />
					<then>
						<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" value1="${urlType1}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url2" />
			<then>
				<var name="key_url" value="${url2}" />

				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK" value1="${url2}" />

				<if>
					<condition function="IsElementPresent" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" />
					<then>
						<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" value1="${urlType2}" />
					</then>
				</if>
			</then>
		</if>

		<if>
			<isset var="url3" />
			<then>
				<var name="key_url" value="${url3}" />

				<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK" value1="${url3}" />

				<if>
					<condition function="IsElementPresent" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" />
					<then>
						<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTIONS_LINK_TYPE" value1="${urlType3}" />
					</then>
				</if>
			</then>
		</if>
	</command>

	<command name="viewProposedSolutionPublicComment">
		<execute function="Click" locator1="LESATicketDetails#PUBLIC_TAB" />

		<var name="key_comment" value="${solutionDescription}" />

		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_CREATOR" value1="${solutionProposer}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_TEXT" value1="Solution: ${solutionDescription}" />

		<if>
			<isset var="fileNames" />
			<then>
				<for list="${fileNames}" param="file">
					<var name="key_fileName" value="${file}" />

					<execute function="AssertTextEquals" locator1="LESATicketDetails#COMMENT_ATTACHMENT_WITHOUT_COMMENT_TEXT" value1="${file}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="urls" />
			<then>
				<for list="${urls}" param="url">
					<var name="key_url" value="${url}" />

					<execute function="AssertTextEquals" locator1="LESATicketDetails#SOLUTION_COMMENT_LINK" value1="${url}" />
				</for>
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="LESATicketDetails#SOLUTION_COMMENT_FOOTER" />
	</command>

	<command name="viewRejectedSolutionComment">
		<execute function="Click" locator1="LESATicketDetails#SOLUTIONS_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#REJECTER_NAME" value1="${rejecter}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#REJECTED_REASON" value1="Solution Rejected: ${reason}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#REJECTED_EXPLANATION" value1="${explanation}" />
	</command>
</definition>