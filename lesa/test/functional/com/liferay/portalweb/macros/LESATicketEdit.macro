<definition>
	<command name="addAttachment">
		<execute function="Click" locator1="LESATicketDetails#ATTACHMENTS_TAB" />

		<execute function="Click" locator1="LESATicketDetails#SELECT_FILE_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="${fileName}" />
	</command>

	<command name="addAttachmentAsCustomer">
		<execute macro="LESATicketEdit#addAttachment">
			<var name="fileName" value="Document_1.doc" />
		</execute>

		<execute function="AssertNotVisible" locator1="Button#SAVE_BUTTON" />
	</command>

	<command name="addLinks">
		<execute function="Click" locator1="LESATicketDetails#LINKS_TAB" />

		<if>
			<isset var="url" />
			<then>
				<execute function="Type" locator1="LESATicketDetails#URL_1_FIELD" value1="${url}" />
			</then>
		</if>

		<if>
			<isset var="url1" />
			<then>
				<execute function="Type" locator1="LESATicketDetails#URL_1_FIELD" value1="${url1}" />
			</then>
		</if>

		<if>
			<isset var="url2" />
			<then>
				<execute function="Type" locator1="LESATicketDetails#URL_2_FIELD" value1="${url2}" />
			</then>
		</if>

		<if>
			<isset var="url3" />
			<then>
				<execute function="Type" locator1="LESATicketDetails#URL_3_FIELD" value1="${url3}" />
			</then>
		</if>

		<execute function="Select" locator1="LESATicketDetails#VISIBILITY_SELECT" value1="${visibility}" />
		<execute function="Click" locator1="LESATicketDetails#SAVE_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="assertComponentDetailsNotOnTicketDetailsTab">
		<execute macro="Navigation#gotoEditTicket" />

		<execute function="AssertNotVisible" locator1="LESATicketEdit#TYPE_OF_KEY_SELECT" />
		<execute function="AssertNotVisible" locator1="LESATicketEdit#SERVER_COMMUNICATION_TYPE_SELECT" />
		<execute function="AssertNotVisible" locator1="LESATicketEdit#DL_PERSISTENCE_SELECT" />
		<execute function="ScrollWebElementIntoView" locator1="LESATicketEdit#TICKET_DETAILS_CANCEL_BUTTON" />

		<execute function="Click" locator1="LESATicketEdit#TICKET_DETAILS_CANCEL_BUTTON" />
	</command>

	<command name="editComponentActivationKey">
		<execute macro="Navigation#gotoEditTicket" />

		<execute function="Select" locator1="LESATicketEdit#COMPONENT_SELECT" value1="Activation Key" />
		<execute function="AssertClick" locator1="LESATicketEdit#ACTIVATION_KEY_DETAILS_TAB" value1="Activation Key Details" />

		<execute macro="LESATicketCreate#inputActivationKeyDetails">
			<var name="purpose" value="${purpose}" />
			<var name="typeOfKey" value="${typeOfKey}" />
		</execute>

		<execute macro="Button#save" />
	</command>

	<command name="editComponentClustering">
		<execute macro="Navigation#gotoEditTicket" />

		<execute function="Select" locator1="LESATicketEdit#COMPONENT_SELECT" value1="Clustering" />
		<execute function="AssertClick" locator1="LESATicketEdit#CLUSTERING_DETAILS_TAB" value1="Clustering Details" />

		<execute macro="LESATicketCreate#inputClusteringDetails">
			<var name="serverCommunicationType" value="${serverCommunicationType}" />
		</execute>

		<execute macro="Button#save" />
	</command>

	<command name="editComponentUpgrade">
		<execute macro="Navigation#gotoEditTicket" />

		<execute function="Select" locator1="LESATicketEdit#COMPONENT_SELECT" value1="Upgrade" />
		<execute function="AssertClick" locator1="LESATicketEdit#UPGRADE_DETAILS_TAB" value1="Upgrade Details" />

		<execute macro="LESATicketCreate#inputUpgradeDetails">
			<var name="documentPersistence" value="${documentPersistence}" />
			<var name="upgradeSteps" value="${upgradeSteps}" />
		</execute>

		<execute macro="Button#save" />
	</command>

	<command name="editEnvironmentDetails">
		<if>
			<isset var="liferayVersion" />
			<then>
				<execute function="Select" locator1="LESATicketEdit#LIFERAY_VERSION_SELECT" value1="${liferayVersion}" />

				<execute macro="LESATicketView#viewLimitedSupportMessage">
					<var name="liferayVersion" value="${liferayVersion}" />
				</execute>
			</then>
		</if>

		<execute macro="LESATicketEdit#save" />
	</command>

	<command name="editPending">
		<execute function="Click" locator1="LESATicketDetails#PENDING" />

		<var method="StringUtil#contains('${pendingList}','Customer')" name="containsCustomer" />

		<if>
			<equals arg1="${containsCustomer}" arg2="true" />
			<then>
				<execute function="Check" locator1="LESATicketDetails#PENDING_CUSTOMER_CHECKBOX" />
			</then>
			<else>
				<execute function="Uncheck" locator1="LESATicketDetails#PENDING_CUSTOMER_CHECKBOX" />
			</else>
		</if>

		<var method="StringUtil#contains('${pendingList}','Liferay')" name="containsLiferay" />

		<if>
			<equals arg1="${containsLiferay}" arg2="true" />
			<then>
				<execute function="Check" locator1="LESATicketDetails#PENDING_LIFERAY_CHECKBOX" />
			</then>
			<else>
				<execute function="Uncheck" locator1="LESATicketDetails#PENDING_LIFERAY_CHECKBOX" />
			</else>
		</if>

		<var method="StringUtil#contains('${pendingList}','Partner')" name="containsPartner" />

		<if>
			<equals arg1="${containsPartner}" arg2="true" />
			<then>
				<execute function="Check" locator1="LESATicketDetails#PENDING_PARTNER_CHECKBOX" />
			</then>
			<else>
				<execute function="Uncheck" locator1="LESATicketDetails#PENDING_PARTNER_CHECKBOX" />
			</else>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="editTicketDetails">
		<execute function="Type" locator1="LESATicketEdit#SUMMARY_FIELD" value1="${subject}" />
		<execute function="Type" locator1="LESATicketEdit#DESCRIPTION_FIELD" value1="${description}" />
		<execute function="Select" locator1="LESATicketEdit#COMPONENT_SELECT" value1="${component}" />
		<execute function="Select" locator1="LESATicketEdit#TICKET_DETAILS_STATUS_SELECT" value1="${status}" />

		<execute macro="LESATicketEdit#save" />
	</command>

	<command name="save">
		<execute function="ScrollWebElementIntoView" locator1="Button#SAVE_BUTTON" />
		<execute function="Click" locator1="Button#SAVE_BUTTON" />

		<execute function="SelectFrame" value1="relative=top" />
	</command>

	<command name="viewTicketAsWatcher">
		<execute function="AssertElementPresent" locator1="LESATicketDetails#WATCH_TICKET_BUTTON" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#COMPLETE_TICKET_BUTTON" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#THREE_DOT_ICON" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#NEW_COMMENT_FIELD" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#POST_BUTTON" />
		<execute function="Click" locator1="LESATicketDetails#SEVERITY" />
		<execute function="AssertNotVisible" locator1="LESATicketDetails#SEVERITY_SELECT" />
		<execute function="Click" locator1="LESATicketDetails#PENDING" />
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#PENDING_CUSTOMER_CHECKBOX" />
		<execute function="Click" locator1="LESATicketDetails#STATUS" />
		<execute function="AssertNotVisible" locator1="LESATicketDetails#STATUS_SELECT" />
	</command>
</definition>