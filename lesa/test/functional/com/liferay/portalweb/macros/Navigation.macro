<definition>
	<var name="customerPortalURL" value="/group/customer" />

	<command name="gotoAssignWorkers">
		<execute macro="Navigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Assign Workers" />
		</execute>
	</command>

	<command name="gotoControlPanel">
		<execute function="Click" locator1="LESANavigation#NAVIGATION_MENU" />
		<execute function="Click" locator1="LESANavigation#NAVIGATION_MENU_CONTROL_PANEL" value1="Control Panel" />
	</command>

	<command name="gotoEditTicket">
		<execute macro="Navigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Edit" />
		</execute>
	</command>

	<command name="gotoForwardTicket">
		<execute macro="Navigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Forward" />
		</execute>
	</command>

	<command name="gotoLESA">
		<execute function="Open" locator1="${customerPortalURL}" />
		<execute function="Click" locator1="LESANavigation#LESA_BUTTON" />
	</command>

	<command name="gotoOSBAdmin">
		<if>
			<condition function="IsElementNotPresent" locator1="CPNavigation#OSB_ADMIN" />
			<then>
				<execute macro="Navigation#gotoControlPanel" />
			</then>
		</if>

		<if>
			<condition function="IsElementNotPresent" locator1="OSBAdmin#OSB_ADMIN_TITLE" />
			<then>
				<execute function="Click" locator1="CPNavigation#OSB_ADMIN" />
			</then>
		</if>
	</command>

	<command name="gotoOSBAdminSalesOfferings">
		<execute macro="Navigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SALES_TAB" value1="Sales" />

		<execute function="AssertClick" locator1="OSBAdminSales#OFFERINGS_TAB" value1="Offerings" />
	</command>

	<command name="gotoOSBAdminSalesOrders">
		<execute macro="Navigation#gotoOSBAdmin" />

		<execute function="AssertClick" locator1="OSBAdmin#SALES_TAB" value1="Sales" />

		<execute function="AssertClick" locator1="OSBAdminSales#ORDERS_TAB" value1="Orders" />
	</command>

	<command name="gotoProposeSolution">
		<execute macro="Navigation#gotoTicketThreeDotMenuItem">
			<var name="menuItem" value="Propose Solution" />
		</execute>
	</command>

	<command name="gotoTicket">
		<execute macro="Navigation#gotoLESA" />

		<execute macro="Search#search">
			<var name="keyword" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="gotoTicketAsDifferentUser">
		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>

		<execute macro="Navigation#gotoTicket">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="gotoTicketThreeDotMenuItem">
		<var name="key_menuItem" value="${menuItem}" />

		<execute function="Click" locator1="TicketDetails#THREE_DOT_ICON" />
		<execute function="AssertClick" locator1="TicketDetails#THREE_DOT_MENU_ITEM" value1="${menuItem}" />
	</command>
</definition>