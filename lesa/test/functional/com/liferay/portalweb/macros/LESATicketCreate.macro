<definition>
	<command name="createTicket">
		<execute function="Click" locator1="LESATicketCreate#CREATE_BUTTON" />
	</command>

	<command name="inputActivationKeyDetails">
		<execute function="Select" locator1="LESATicketCreate#TYPE_OF_KEY_SELECT" value1="${typeOfKey}" />
		<execute function="Select" locator1="LESATicketCreate#PURPOSE_SELECT" value1="${purpose}" />
	</command>

	<command name="inputBasicForm">
		<execute function="Click" locator1="LESALeftNavigation#NEW_TICKET_BUTTON" />

		<execute function="Select" locator1="LESATicketCreate#PROJECT_SELECT" value1="${project}" />
		<execute function="Select" locator1="LESATicketCreate#PRODUCT_SELECT" value1="${product}" />

		<if>
			<equals arg1="${configType}" arg2="saved" />
			<then>
				<execute macro="LESATicketCreateEntry#selectSavedConfig">
					<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
				</execute>
			</then>
			<elseif>
				<equals arg1="${configType}" arg2="new" />
				<then>
					<execute macro="LESATicketCreateEntry#selectNewConfig">
						<var name="appServer" value="${appServer}" />
						<var name="database" value="${database}" />
						<var name="javaVM" value="${javaVM}" />
						<var name="liferayVersion" value="${liferayVersion}" />
						<var name="operatingSystem" value="${operatingSystem}" />
					</execute>
				</then>
			</elseif>
		</if>

		<if>
			<isset var="browser" />
			<then>
				<execute function="Select" locator1="LESATicketCreate#BROWSER_SELECT" value1="${browser}" />
			</then>
		</if>

		<if>
			<not>
				<equals arg1="${product}" arg2="Social Office" />
			</not>
			<then>
				<execute function="Select" locator1="LESATicketCreate#COMPONENT_SELECT" value1="${component}" />
				<execute function="Select" locator1="LESATicketCreate#SYSTEM_STATUS_SELECT" value1="${systemStatus}" />
			</then>
		</if>

		<execute function="Type" locator1="LESATicketCreate#SUMMARY_FIELD" value1="${summary}" />
		<execute function="Type" locator1="LESATicketCreate#DESCRIPTION_FIELD" value1="${description}" />
	</command>

	<command name="inputClusteringDetails">
		<execute function="Select" locator1="LESATicketCreate#SERVER_COMMUNICATION_TYPE_SELECT" value1="${serverCommunicationType}" />
	</command>

	<command name="inputUpgradeDetails">
		<execute function="Select" locator1="LESATicketCreate#TO_LIFERAY_VERSION_SELECT" value1="${toLiferayVersion}" />
		<execute function="Select" locator1="LESATicketCreate#DL_PERSISTENCE_SELECT" value1="${documentPersistence}" />
		<execute function="Type" locator1="LESATicketCreate#STEPS_USED_FIELD" value1="${upgradeSteps}" />

		<execute macro="LESATicketCreateEntry#uploadToPatchLevel" />

		<execute macro="LESATicketCreateEntry#uploadToPortalExt" />
	</command>
</definition>