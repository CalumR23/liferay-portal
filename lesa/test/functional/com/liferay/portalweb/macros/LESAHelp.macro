<definition>
	<command name="viewUserGuide">
		<execute function="AssertTextEquals" locator1="LESAUserGuide#TITLE" value1="The LESA User Guide" />

		<if>
			<equals arg1="${role}" arg2="CSE" />
			<then>
				<var name="key_welcomeText" value="Welcome to Liferay Enterprise Support Application" />

				<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />
			</then>
			<elseif>
				<equals arg1="${role}" arg2="Customer" />
				<then>
					<var name="key_welcomeText" value="Thank you for being a valued member of Liferay EE Support!" />

					<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${role}" arg2="Partner" />
				<then>
					<var name="key_welcomeText" value="Thank you for being a valued partner of Liferay EE Support!" />

					<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${role}" arg2="Admin" />
				<then>
					<execute function="AssertElementPresent" locator1="Button#EDIT_BUTTON" />

					<var name="key_welcomeText" value="Welcome to Liferay Enterprise Support Application" />

					<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />

					<var name="key_welcomeText" value="Thank you for being a valued member of Liferay EE Support!" />

					<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />

					<var name="key_welcomeText" value="Thank you for being a valued partner of Liferay EE Support!" />

					<execute function="AssertTextEquals#assertPartialText" locator1="LESAUserGuide#WELCOME_TEXT" value1="${key_welcomeText}" />
				</then>
			</elseif>
		</if>
	</command>
</definition>