<definition>
	<command name="addSupportRegion">
		<execute function="Click" locator1="OSBAdminSupport#ADD_SUPPORT_REGION_BUTTON" />
		<execute function="Type" locator1="OSBAdminSupport#SUPPORT_REGION_NAME_FIELD" value1="${name}" />
		<execute function="Type" locator1="OSBAdminSupport#SUPPORT_REGION_DESCRIPTION_FIELD" value1="${description}" />
		<execute function="Select" locator1="OSBAdminSupport#SUPPORT_REGION_TIME_ZONE_SELECT" value1="${timeZone}" />

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="deleteSupportRegion">
		<var name="key_code" value="${name}" />

		<execute function="AssertClick" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" value1="Actions" />
		<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />
	</command>

	<command name="viewSupportRegionInfo">
		<var name="key_description" value="${description}" />
		<var name="key_name" value="${name}" />
		<var name="key_timeZone" value="${timeZone}" />

		<execute function="AssertTextEquals" locator1="OSBAdminSupport#TABLE_ROW_DESCRIPTION" value1="${description}" />
		<execute function="AssertTextEquals" locator1="OSBAdminSupport#TABLE_ROW_TIME_ZONE" value1="${timeZone}" />
	</command>
</definition>