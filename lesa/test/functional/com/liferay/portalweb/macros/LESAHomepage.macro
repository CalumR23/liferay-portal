<definition>
	<command name="viewAllOpenTickets">
		<execute function="AssertElementPresent" locator1="LESAHomepage#OPEN_TICKETS" />
	</command>

	<command name="viewAuxiliaryAssignments">
		<if>
			<condition function="IsElementPresent" locator1="LESAHomepage#AUXILIARY_ASSIGNMENTS" />
			<then>
				<execute function="AssertElementPresent" locator1="LESAHomepage#AUXILIARY_ASSIGNMENTS_TABLE" />
			</then>
		</if>
	</command>

	<command name="viewNeedsResponse">
		<if>
			<condition function="IsElementPresent" locator1="LESAHomepage#NEEDS_RESPONSE" />
			<then>
				<execute function="AssertElementPresent" locator1="LESAHomepage#NEEDS_RESPONSE_TABLE" />
			</then>
		</if>
	</command>

	<command name="viewPrimaryAssignments">
		<execute function="AssertElementPresent" locator1="LESAHomepage#PRIMARY_ASSIGNMENTS" />
	</command>

	<command name="viewProjectMessageBanner">
		<if>
			<equals arg1="${severity}" arg2="urgent" />
			<then>
				<execute function="AssertElementPresent" locator1="LESAHomepage#BANNER_URGENT" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="LESAHomepage#BANNER_MESSAGE" value1="${projectName}: ${message}" />
	</command>

	<command name="viewProjectMessageBannerNotPresent">
		<execute function="AssertElementNotPresent" locator1="LESAHomepage#BANNER" />
	</command>

	<command name="viewWatching">
		<if>
			<equals arg1="${customer}" arg2="true" />
			<then>
				<execute function="AssertElementNotPresent" locator1="LESAHomepage#WATCHING_TABLE" />
			</then>
			<elseif>
				<condition function="IsElementPresent" locator1="LESAHomepage#WATCHING" />
				<then>
					<execute function="AssertElementPresent" locator1="LESAHomepage#WATCHING_TABLE" />
				</then>
			</elseif>
		</if>
	</command>
</definition>