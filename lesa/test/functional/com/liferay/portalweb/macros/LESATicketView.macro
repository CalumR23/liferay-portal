<definition>
	<command name="viewActivationKeyDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Activation Key Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ACTIVATION_KEY_DETAILS_TYPE_OF_KEY" value1="Type of Key: ${typeOfKey}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ACTIVATION_KEY_DETAILS_PURPOSE" value1="Purpose: ${purpose}" />
	</command>

	<command name="viewClusteringDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Clustering Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#CLUSTERING_DETAILS_SERVER_COMMUNICATION_TYPE" value1="Server Communication Type: ${serverCommunicationType}" />
	</command>

	<command name="viewComponent">
		<execute function="MouseOver" locator1="LESATicketDetails#COMPONENT_ICON" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMPONENT_TOOLTIP" value1="${component}" />
	</command>

	<command name="viewDescription">
		<execute function="AssertClick" locator1="LESATicketDetails#DESCRIPTION_TAB" value1="Description" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#DESCRIPTION_CONTENT" value1="${description}" />
	</command>

	<command name="viewLink">
		<execute function="Click" locator1="LESATicketDetails#LINKS_TAB" />

		<var name="key_url" value="${url}" />
		<var name="key_visibility" value="${visibility}" />

		<execute function="AssertElementPresent" locator1="LESATicketDetails#LINKS_ROW" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#LINKS_URL_LINK" value1="${url}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#LINKS_VISIBILITY_LINK" value1="${visibility}" />
	</command>

	<command name="viewSummary">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#SUMMARY" value1="${summary}" />
	</command>

	<command name="viewTicketDetails">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#REPORTER_NAME" value1="${reporterName}" />
		<execute function="AssertTextNotEquals" locator1="LESATicketDetails#ASSIGNEE_NAME" value1="" />

		<if>
			<isset var="toLiferayVersion" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#TO_LIFERAY_VERSION" value1="${toLiferayVersion}" />
			</then>
		</if>

		<if>
			<isset var="browser" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#BROWSER" value1="${browser}" />
			</then>
		</if>
	</command>

	<command name="viewTicketResolution">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#RESOLUTION" value1="${resolution}" />
	</command>

	<command name="viewTicketStatus">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#STATUS" value1="${status}" />
	</command>

	<command name="viewUpgradeDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Upgrade Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#UPGRADE_DETAILS_DOCUMENT_PERSISTENCE" value1="How is the Document Library server persisting documents? ${documentPersistence}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#UPGRADE_DETAILS_UPGRADE_STEPS" value1="${upgradeSteps}" />
	</command>
</definition>