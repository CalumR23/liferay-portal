<definition>
	<command name="assertNotAssignedTo">
		<execute function="AssertTextNotEquals" locator1="LESATicketDetails#ASSIGNEE_NAME" value1="${name}" />
	</command>

	<command name="viewActivationKeyDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Activation Key Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ACTIVATION_KEY_DETAILS_TYPE_OF_KEY" value1="Type of Key: ${typeOfKey}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ACTIVATION_KEY_DETAILS_PURPOSE" value1="Purpose: ${purpose}" />
	</command>

	<command name="viewAttachment">
		<var name="key_fileName" value="${fileName}" />

		<execute function="Click" locator1="LESATicketDetails#ATTACHMENTS_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ATTACHMENT_FILE_NAME" value1="${fileName}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ATTACHED_BY" value1="${attachedBy}" />
	</command>

	<command name="viewClusteringDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Clustering Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#CLUSTERING_DETAILS_SERVER_COMMUNICATION_TYPE" value1="Server Communication Type: ${serverCommunicationType}" />
	</command>

	<command name="viewComponent">
		<execute function="MouseOver" locator1="LESATicketDetails#COMPONENT_ICON" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#COMPONENT_TOOLTIP" value1="${component}" />
	</command>

	<command name="viewComponentDisclaimerMessage">
		<execute function="AssertTextEquals" locator1="LESATicketCreate#COMPONENT_MESSAGE" value1="${componentMessage}" />
	</command>

	<command name="viewCreateTicketEmptyServerError">
		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="${product}" />
		</execute>

		<execute function="Select" locator1="LESATicketCreate#COMPONENT_SELECT" value1="${component}" />

		<execute macro="Message#error">
			<var name="errorMessage" value="Please select a valid server." />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="${server}" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="Message#ERROR_MESSAGE_2" />
	</command>

	<command name="viewCreateTicketFormLoad">
		<execute function="AssertElementPresent" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" />
		<execute function="AssertElementPresent" locator1="LESATicketCreate#SYSTEM_STATUS_SELECT" />
		<execute function="AssertElementPresent" locator1="LESATicketCreate#SUMMARY_FIELD" />
		<execute function="AssertElementPresent" locator1="LESATicketCreate#DESCRIPTION_FIELD" />
	</command>

	<command name="viewCreateTicketLiferayVersion">
		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="${product}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="${server}" />
		</execute>

		<execute function="Select" locator1="LESATicketCreate#COMPONENT_SELECT" value1="${component}" />
		<execute function="Select" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" value1="Select New Configuration" />

		<if>
			<equals arg1="${product}" arg2="Digital Enterprise" />
			<then>
				<execute function="Click" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" />

				<var name="key_item" value="7.0" />

				<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM" value1="${key_item}" />

				<for list="5.2,6.0,6.1,6.2" param="listItem">
					<var name="key_item" value="${listItem}" />

					<execute function="AssertElementNotPresent" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM" />
				</for>
			</then>
			<elseif>
				<equals arg1="${product}" arg2="Portal" />
				<then>
					<execute function="Click" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT" />

					<var name="key_item" value="7.0" />

					<execute function="AssertElementNotPresent" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM" value1="${key_item}" />

					<for list="5.2,6.0,6.1,6.2" param="listItem">
						<var name="key_item" value="${listItem}" />

						<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM" value1="${listItem}" />
					</for>
				</then>
			</elseif>
		</if>
	</command>

	<command name="viewCreateTicketNonActiveProject">
		<execute macro="LESATicketCreate#newTicket" />

		<var name="key_projectName" value="${projectName}" />

		<execute function="AssertElementNotPresent" locator1="LESATicketCreate#PROJECT_SELECT_LIST_ITEM" />
	</command>

	<command name="viewDescription">
		<execute function="AssertClick" locator1="LESATicketDetails#DESCRIPTION_TAB" value1="Description" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#DESCRIPTION_CONTENT" value1="${description}" />
	</command>

	<command name="viewEscalation">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#ESCALATION" value1="${escalation}" />
	</command>

	<command name="viewExpiredSupport">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#EXPIRED" value1="EXPIRED" />
	</command>

	<command name="viewLimitedSupportMessage">
		<var method="StringUtil#extractFirst('${liferayVersion}',' ')" name="version" />
		
		<var name="message" value="Liferay Portal 5.2 EE, 5.2 EE SP1, 5.2 EE SP2, 5.2 EE SP3, 5.2 EE SP4, and 5.2 EE SP5 are currently in Phase 2 Support of their lifecycle. Active development of these products is limited to security issues. For more information, see Liferay End of Version for Liferay 5.2." />

		<if>
			<equals arg1="${version}" arg2="6.0" />
			<then>
				<var name="message" value="Liferay Portal 6.0 EE, 6.0 EE SP1, and 6.0 EE SP2 are currently in the Limited Support Phase of their lifecycle. Active development of these products is limited to security issues. For more information, see: Liferay End of Version for 6.0 EE." />
			</then>
		</if>

		<if>
			<equals arg1="${version}" arg2="6.1" />
			<then>
				<var name="message" value="Liferay Portal 6.1 EE GA1, 6.1 EE GA2, and 6.1 EE GA3 are currently in the Limited Support Phase. For more information, please see the End of Service Life Policy." />
			</then>
		</if>

		<execute macro="Message#limitedSupport">
			<var name="message" value="${message}" />
		</execute>
	</command>

	<command name="viewLink">
		<execute function="Click" locator1="LESATicketDetails#LINKS_TAB" />

		<var name="key_url" value="${url}" />
		<var name="key_visibility" value="${visibility}" />

		<execute function="AssertElementPresent" locator1="LESATicketDetails#LINKS_ROW" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#LINKS_URL_LINK" value1="${url}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#LINKS_VISIBILITY_LINK" value1="${visibility}" />
	</command>

	<command name="viewPending">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#PENDING" value1="${pending}" />
	</command>

	<command name="viewProduct">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#PRODUCT" value1="${product}" />
	</command>

	<command name="viewSeverity">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#SEVERITY" value1="${severity}" />
	</command>

	<command name="viewSubcomponent">
		<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetails#SUBCOMPONENT" value1="${subcomponent}" />
	</command>

	<command name="viewSummary">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#SUMMARY" value1="${summary}" />
	</command>

	<command name="viewTicketDetails">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#REPORTER_NAME" value1="${reporterName}" />
		<execute function="AssertTextNotEquals" locator1="LESATicketDetails#ASSIGNEE_NAME" value1="" />

		<if>
			<isset var="toLiferayVersion" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#TO_LIFERAY_VERSION" value1="${toLiferayVersion}" />
			</then>
		</if>

		<if>
			<isset var="browser" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#BROWSER" value1="${browser}" />
			</then>
		</if>
	</command>

	<command name="viewTicketResolution">
		<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetails#RESOLUTION" value1="${resolution}" />
	</command>

	<command name="viewTicketStatus">
		<execute function="AssertTextEquals" locator1="LESATicketDetails#STATUS" value1="${status}" />
	</command>

	<command name="viewUpgradeDetails">
		<execute function="AssertClick" locator1="LESATicketDetails#COMPONENT_DETAILS_TAB" value1="Upgrade Details" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#UPGRADE_DETAILS_DOCUMENT_PERSISTENCE" value1="How is the Document Library server persisting documents? ${documentPersistence}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#UPGRADE_DETAILS_UPGRADE_STEPS" value1="${upgradeSteps}" />
	</command>
</definition>