<definition>
	<command name="viewActivationKeyDetails">
		<execute function="Click" locator1="TicketDetails#COMPONENT_DETAILS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#ACTIVATION_KEY_DETAILS_TYPE_OF_KEY" value1="Type of Key: ${typeOfKey}" />
		<execute function="AssertTextEquals" locator1="TicketDetails#ACTIVATION_KEY_DETAILS_PURPOSE" value1="Purpose: ${purpose}" />
	</command>

	<command name="viewClusteringDetails">
		<execute function="Click" locator1="TicketDetails#COMPONENT_DETAILS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#CLUSTERING_DETAILS_SERVER_COMMUNICATION_TYPE" value1="Server Communication Type: ${serverCommunicationType}" />
	</command>

	<command name="viewDescription">
		<execute function="Click" locator1="TicketDetails#DESCRIPTION_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#DESCRIPTION_CONTENT" value1="${description}" />
	</command>

	<command name="viewTicketDetails">
		<execute function="AssertTextEquals" locator1="TicketDetails#REPORTER_NAME" value1="${reporterName}" />
		<execute function="AssertTextNotEquals" locator1="TicketDetails#ASSIGNEE_NAME" value1="" />

		<if>
			<isset var="toLiferayVersion" />
			<then>
				<execute function="AssertTextEquals" locator1="TicketDetails#TO_LIFERAY_VERSION" value1="${toLiferayVersion}" />
			</then>
		</if>

		<if>
			<isset var="browser" />
			<then>
				<execute function="AssertTextEquals" locator1="TicketDetails#BROWSER" value1="${browser}" />
			</then>
		</if>
	</command>

	<command name="viewUpdateDetails">
		<execute function="Click" locator1="TicketDetails#COMPONENT_DETAILS_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#UPGRADE_DETAILS_DOCUMENT_PERSISTENCE" value1="How is the Document Library server persisting documents? ${documentPersistence}" />
		<execute function="AssertTextEquals" locator1="TicketDetails#UPGRADE_DETAILS_UPGRADE_STEPS" value1="${upgradeSteps}" />
	</command>
</definition>