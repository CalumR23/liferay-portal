<definition>
	<command name="viewDescription">
		<execute function="Click" locator1="TicketDetails#DESCRIPTION_TAB" />
		<execute function="AssertTextEquals" locator1="TicketDetails#DESCRIPTION_CONTENT" value1="${description}" />
	</command>

	<command name="viewTicketDetails">
		<execute function="AssertTextEquals" locator1="TicketDetails#REPORTER_NAME" value1="${reporterName}" />
		<execute function="AssertTextNotEquals" locator1="TicketDetails#ASSIGNEE_NAME" value1="" />
		<execute function="AssertTextEquals" locator1="TicketDetails#BROWSER" value1="${browser}" />
	</command>
</definition>