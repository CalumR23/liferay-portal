<definition>
	<command name="selectNewConfig">
		<execute function="Select" locator1="CreateTicket#SAVED_ENV_CONFIG_SELECT" value1="Select New Configuration" />
		<execute function="Select" locator1="CreateTicket#LIFERAY_VERSION_SELECT" value1="${liferayVersion}" />
		<execute function="Select" locator1="CreateTicket#APPLICATION_SERVER_SELECT" value1="${appServer}" />
		<execute function="Select" locator1="CreateTicket#OPERATING_SYSTEM_SELECT" value1="${operatingSystem}" />
		<execute function="Select" locator1="CreateTicket#DATABASE_SELECT" value1="${database}" />
		<execute function="Select" locator1="CreateTicket#JAVA_VIRTUAL_MACHINE_SELECT" value1="${javaVM}" />
		<execute function="Select" locator1="CreateTicket#BROWSER_SELECT" value1="${browser}" />

		<execute macro="CreateTicketEntry#uploadPatchLevel" />

		<execute macro="CreateTicketEntry#uploadPortalExt" />
	</command>

	<command name="selectSavedConfig">
		<execute function="Select" locator1="CreateTicket#SAVED_ENV_CONFIG_SELECT" value1="${savedEnvConfigName}" />
		<execute function="Select" locator1="CreateTicket#BROWSER_SELECT" value1="${browser}" />
		<execute function="Check" locator1="CreateTicket#PORTAL_EXT_CHECKBOX" />
		<execute function="Check" locator1="CreateTicket#PATCH_LEVEL_CHECKBOX" />
	</command>

	<command name="uploadPatchLevel">
		<execute function="Click" locator1="CreateTicket#UPLOAD_NEW_PATCH_LEVEL_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="patchinfo.txt" />
	</command>

	<command name="uploadPortalExt">
		<execute function="Click" locator1="CreateTicket#UPLOAD_NEW_PORTAL_EXT_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG" value1="portal-ext.properties" />
	</command>
</definition>