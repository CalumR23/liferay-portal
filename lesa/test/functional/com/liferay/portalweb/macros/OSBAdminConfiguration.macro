<definition>
	<command name="addComponentMessage">
		<execute function="Click" locator1="OSBAdminConfiguration#WRENCH_ICON" />
		<execute function="Click" locator1="OSBAdminConfiguration#CONFIGURATION_DROPDOWN_ITEM" />
		<execute function="SelectFrame" locator1="OSBAdminConfiguration#CONFIGURATION_IFRAME" />

		<var name="key_tab" value="Support" />

		<execute function="Click" locator1="OSBAdminConfiguration#CONFIGURATION_TAB" />

		<var name="key_tab" value="Component Messages" />

		<execute function="Click" locator1="OSBAdminConfiguration#CONFIGURATION_TAB" />
		<execute function="Select" locator1="OSBAdminConfiguration#COMPONENT_MESSAGE_PRODUCT_SELECT" value1="${product}" />
		<execute function="Select" locator1="OSBAdminConfiguration#COMPONENT_MESSAGE_COMPONENT_SELECT" value1="${component}" />
		<execute function="Type" locator1="OSBAdminConfiguration#COMPONENT_MESSAGE_MESSAGE_TEXTBOX" value1="${componentMessage}" />

		<execute macro="Button#save" />

		<execute macro="Message#success">
			<var name="message" value="You have successfully updated the setup." />
		</execute>

		<execute function="Close" locator1="title=Control Panel" />
		<execute function="SelectWindow" locator1="null" />
	</command>
</definition>