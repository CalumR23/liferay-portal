<definition>
	<command name="assertTicketCountEqual">
		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="LESASearch#TICKET_COUNT" value1="${ticketCount}" />
	</command>

	<command name="assertTicketCountNotEqual">
		<execute function="AssertTextNotEquals" locator1="LESASearch#TICKET_COUNT" value1="${ticketCount}" />
	</command>

	<command name="assertTicketNotInResult">
		<var name="key_ticketNumber" value="${ticketNumber}" />

		<execute function="AssertElementNotPresent" locator1="LESASearch#RESULT_ROW_NUMBER" />
	</command>

	<command name="checkTicketStatus">
		<var name="key_status" value="${status}" />

		<execute function="Check" locator1="LESASearch#TICKETS_TAB_STATUS_CHECKBOX" />
	</command>

	<command name="displayTicketsAssigneeFilters">
		<if>
			<condition function="IsNotVisible" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON" />
			<then>
				<var name="key_filter" value="Assignee" />

				<execute function="Click" locator1="LESASearch#TICKETS_TAB" />
				<execute function="Click" locator1="LESASearch#TICKETS_TAB_FILTER" />
			</then>
		</if>
	</command>

	<command name="filterTicketsByProject">
		<if>
			<condition function="IsNotVisible" locator1="LESASearch#TICKETS_TAB_ALL_SELECTED_PROJECTS" />
			<then>
				<var name="key_filter" value="Project" />

				<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Project" />
			</then>
		</if>

		<var name="key_filter" value="Project" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON" />

		<execute function="SelectWindow" locator1="title=Support" />

		<var name="key_name" value="${projectName}" />

		<execute function="AssertClick" locator1="LESASearchTicketsChooseProject#SEARCH_RESULT_NAME" value1="${projectName}" />

		<execute function="Close" locator1="title=Support" />
	</command>

	<command name="filterTicketsByStatusAndResolution">
		<var name="key_filter" value="Status" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_FILTER" />

		<execute macro="LESASearch#checkTicketStatus">
			<var name="status" value="${status}" />
		</execute>

		<execute macro="LESASearch#checkTicketStatus">
			<var name="status" value="${resolution}" />
		</execute>
	</command>

	<command name="getTicketCount" returns="ticketCount">
		<var locator="LESASearch#TICKET_COUNT" name="ticketCount" />

		<return name="ticketCount" value="${ticketCount}" />
	</command>

	<command name="gotoSearchResultTicket">
		<var name="key_ticketNumber" value="${ticketNumber}" />

		<execute function="Click" locator1="LESASearch#RESULT_ROW_NUMBER" />
	</command>

	<command name="removeFilterTicketsAccountWorker">
		<execute macro="LESASearch#displayTicketsAssigneeFilters" />

		<for list="${accountWorkerList}" param="worker">
			<var name="key_accountWorker" value="${worker}" />

			<execute function="AssertClick#assertPartialTextClickAt" locator1="LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER" value1="${worker}" />
			<execute function="AssertElementNotPresent" locator1="LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER" />
		</for>
	</command>

	<command name="removeFilterTicketsAssignee">
		<execute macro="LESASearch#displayTicketsAssigneeFilters" />

		<for list="${assigneeList}" param="assignee">
			<var name="key_assignee" value="${assignee}" />

			<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE" value1="${assignee}" />
			<execute function="AssertElementNotPresent" locator1="LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE" />
		</for>
	</command>

	<command name="search">
		<execute function="Click" locator1="LESALeftNavigation#LESA_SEARCH_BUTTON" />

		<execute function="Type" locator1="LESASearch#KEYWORD_FIELD" value1="${keyword}" />
		<execute function="KeyPress" locator1="LESASearch#KEYWORD_FIELD" value1="\RETURN"  />
	</command>

	<command name="searchAndSelectByName">
		<execute function="SelectWindow" locator1="title=Support" />

		<for list="${nameList}" param="name">
			<execute macro="OSBAdminSearch#searchBasic">
				<var name="keyword" value="${name}" />
			</execute>

			<var name="key_name" value="${name}" />

			<execute function="AssertClick" locator1="LESASearchTicketsChooseAssignee#SEARCH_RESULT_NAME" value1="${name}" />
		</for>

		<execute function="Close" locator1="title=Support" />
	</command>

	<command name="searchPartnersViaTicketsChooseAssignee">
		<var name="key_filter" value="Assignee" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_FILTER" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON" />

		<execute function="SelectWindow" locator1="title=Support" />

		<execute function="AssertClick" locator1="LESASearchTicketsChooseAssignee#PARTNERS_TAB"  value1="Partners" />

		<execute macro="OSBAdminSearch#toggleSearch">
			<var name="searchType" value="Advanced" />
		</execute>

		<if>
			<isset var="managingSupport" />
			<then>
				<execute function="Select" locator1="LESASearchTicketsChooseAssignee#PARTNERS_MANAGING_SUPPORT_SELECT" value1="${managingSupport}" />
			</then>
		</if>

		<if>
			<isset var="code" />
			<then>
				<execute function="Type" locator1="LESASearchTicketsChooseAssignee#PARTNERS_CODE_FIELD" value1="${code}" />
			</then>
		</if>

		<execute macro="Button#searchAdvanced" />

		<execute function="AssertElementNotPresent" locator1="LESASearchTicketsChooseAssignee#SUPPORT_UNAVAILABLE_MESSAGE" />

		<if>
			<isset var="code" />
			<then>
				<var name="key_code" value="${code}" />

				<execute function="ClickNoError" locator1="OSBAdmin#SEARCH_RESULT_CODE" />
			</then>
		</if>

		<execute function="Close" locator1="title=Support" />
	</command>

	<command name="searchProject">
		<execute macro="LESASearch#search">
			<var name="keyword" value="${projectCode}" />
		</execute>

		<execute function="AssertClick" locator1="LESASearch#PROJECTS_TAB" value1="Projects(-)" />

		<execute function="Pause" locator1="1000" />

		<var name="key_projectCode" value="${projectCode}" />

		<execute function="Click" locator1="LESASearch#RESULT_ROW_PROJECT_CODE" />
	</command>

	<command name="selectFilterTicketsAccountWorker">
		<execute macro="LESASearch#displayTicketsAssigneeFilters" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON" />

		<execute macro="LESASearch#searchAndSelectByName">
			<var name="nameList" value="${accountWorkerList}" />
		</execute>
	</command>

	<command name="selectFilterTicketsAssignee">
		<execute macro="LESASearch#displayTicketsAssigneeFilters" />

		<execute function="Click" locator1="LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON" />

		<execute macro="LESASearch#searchAndSelectByName">
			<var name="nameList" value="${assigneeList}" />
		</execute>
	</command>

	<command name="sortByTicketNumberDescending">
		<while>
			<condition function="IsElementNotPresent" locator1="LESASearch#TICKETS_TAB_TICKET_NUMBER_ARROW_DOWN" />
			<then>
				<execute function="Click" locator1="LESASearch#TICKETS_TAB_TICKET_NUMBER" />
			</then>
		</while>
	</command>

	<command name="viewPartnerTicketSearchFilters">
		<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB" value1="Tickets(-)" />
		<execute function="AssertTextEquals" locator1="LESASearch#PROJECTS_TAB" value1="Projects(-)" />
		<execute function="AssertTextEquals" locator1="LESASearch#FEEDBACK_TAB" value1="Feedback(-)" />
		<execute function="AssertElementNotPresent" locator1="LESASearch#PARTNERS_TAB" />

		<var name="key_filter" value="Project" />

		<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Project" />
		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON" />
		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_TIERS" />

		<var name="key_filter" value="Assignee" />

		<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Assignee" />
		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON" />
		<execute function="AssertElementNotPresent" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON" />

		<var name="key_filter" value="Component" />

		<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Component" />

		<var name="key_filter" value="Date" />

		<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Date" />

		<for list="Created Between,Closed Between,Due Between,Satisfied Due Date" param="dateRange">
			<var name="key_dateRange" value="${dateRange}" />

			<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_DATE_RANGES" />
		</for>

		<var name="key_filter" value="Environment" />

		<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Environment" />

		<var name="key_filter" value="Pending" />

		<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Pending" />

		<var name="key_filter" value="Severity" />

		<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Severity" />

		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_SEVERITY" />
		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_ESCALATION_LEVEL" />

		<var name="key_filter" value="Status" />

		<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Status" />

		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_STATUS" />
		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_RESOLUTION" />

		<var name="key_filter" value="Support Region" />

		<execute function="AssertElementNotPresent" locator1="LESASearch#TICKETS_TAB_FILTER" />

		<execute function="AssertElementPresent" locator1="LESASearch#TICKETS_TAB_SEARCH_ATTACHMENTS_CHECKBOX" />
	</command>

	<command name="viewSelectedAccountWorkers">
		<for list="${accountWorkerList}" param="worker">
			<var name="key_accountWorker" value="${worker}" />

			<execute function="AssertTextEquals#assertPartialText" locator1="LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER" value1="${worker}" />
		</for>
	</command>

	<command name="viewSelectedAssignees">
		<for list="${assigneeList}" param="assignee">
			<var name="key_assignee" value="${assignee}" />

			<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE" value1="${assignee}" />
		</for>
	</command>

	<command name="viewSelectedProjects">
		<if>
			<condition function="IsNotVisible" locator1="LESASearch#TICKETS_TAB_ALL_SELECTED_PROJECTS" />
			<then>
				<var name="key_filter" value="Project" />

				<execute function="AssertClick" locator1="LESASearch#TICKETS_TAB_FILTER" value1="Project" />
			</then>
		</if>

		<for list="${projectList}" param="project">
			<var name="key_project" value="${project}" />

			<execute function="AssertTextEquals" locator1="LESASearch#TICKETS_TAB_SELECTED_PROJECT" value1="${project}" />
		</for>
	</command>

	<command name="viewSelectedProjectSingle">
		<execute macro="LESASearch#viewSelectedProjects">
			<var name="projectList" value="${project}" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON" />
	</command>
</definition>