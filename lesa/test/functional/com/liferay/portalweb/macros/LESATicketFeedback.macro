<definition>
	<command name="assertFeedbackTabNotPresent">
		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#FEEDBACK_TAB" />
	</command>

	<command name="convertAnswerToCode" returns="code">
		<if>
			<equals arg1="${answer}" arg2="Yes" />
			<then>
				<return name="code" value="1" />
			</then>
			<elseif>
				<equals arg1="${answer}" arg2="No" />
				<then>
					<return name="code" value="2" />
				</then>
			</elseif>
			<else>
				<return name="code" value="3" />
			</else>
		</if>
	</command>

	<command name="submitPartnerFeedback">
		<execute function="Click" locator1="LESATicketDetails#FEEDBACK_TAB" />
		<execute function="Click" locator1="LESATicketDetailsFeedbackPartner#FEEDBACK_EDIT_FEEDBACK_BUTTON" />

		<execute macro="LESAHomepage#closeAllBanners" />

		<execute macro="LESATicketFeedback#convertAnswerToCode">
			<var name="answer" value="${reproduced}" />
			<return from="code" name="code" />
		</execute>

		<var name="key_value" value="${code}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#REPRODUCED_RADIO" />

		<execute macro="LESATicketFeedback#convertAnswerToCode">
			<var name="answer" value="${timely}" />
			<return from="code" name="code" />
		</execute>

		<var name="key_value" value="${code}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#TIMELY_MANNER_RADIO" />

		<execute macro="LESATicketFeedback#convertAnswerToCode">
			<var name="answer" value="${escalatedProperly}" />
			<return from="code" name="code" />
		</execute>

		<var name="key_value" value="${code}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#ESCALATED_PROPERLY_RADIO" />

		<var name="key_value" value="${responseTime}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#RESPONSE_TIME_RADIO" />

		<var name="key_value" value="${technicalKnowledge}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#TECHNICAL_KNOWLEDGE_RADIO" />

		<var name="key_value" value="${professionalism}" />

		<execute function="Click" locator1="LESATicketFeedbackPartner#PROFESSIONALISM_RADIO" />

		<if>
			<isset var="comment" />
			<then>
				<execute function="Type" locator1="LESATicketFeedbackPartner#COMMENTS_FIELD" value1="${comment}" />
			</then>
		</if>

		<execute macro="Button#save" />

		<execute macro="Message#success" />
	</command>

	<command name="submitReply">
		<if>
			<equals arg1="${reply}" arg2="Yes" />
			<then>
				<execute function="Click" locator1="LESATicketFeedback#YES_RADIO_BUTTON" />
			</then>
			<else>
				<execute function="Click" locator1="LESATicketFeedback#NO_RADIO_BUTTON" />
			</else>
		</if>

		<if>
			<isset var="comment" />
			<then>
				<execute function="Type" locator1="LESATicketFeedback#COMMENT_TEXTBOX" value1="${comment}" />
			</then>
		</if>

		<execute function="Click" locator1="LESATicketFeedback#SUBMIT_BUTTON" />

		<execute macro="Message#success" />

		<execute function="AssertElementNotPresent" locator1="LESATicketDetails#FEEDBACK_TAB" />
	</command>

	<command name="viewFeedback">
		<execute function="Click" locator1="LESATicketDetails#FEEDBACK_TAB" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#FEEDBACK_SUBMITTER_NAME" value1="${submitter}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetails#FEEDBACK_REPLY" value1="${reply}" />

		<if>
			<isset var="comment" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#FEEDBACK_REPLY_COMMENT" value1="${comment}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESATicketDetails#FEEDBACK_REPLY_COMMENT" value1="" />
			</else>
		</if>
	</command>

	<command name="viewPartnerFeedback">
		<execute function="Click" locator1="LESATicketDetails#FEEDBACK_TAB" />

		<execute function="AssertTextEquals" locator1="LESATicketDetailsFeedbackPartner#REPRODUCIBLE" value1="${reproduced}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetailsFeedbackPartner#ESCALATED_PROPERLY" value1="${escalatedProperly}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetailsFeedbackPartner#RESPONSE_TIME" value1="${responseTime}" />
		<execute function="AssertTextEquals" locator1="LESATicketDetailsFeedbackPartner#TIMELY_ESCALATED" value1="${timely}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetailsFeedbackPartner#TECHNICAL_KNOWLEDGE" value1="${technicalKnowledge}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LESATicketDetailsFeedbackPartner#PROFESSIONALISM" value1="${professionalism}" />

		<if>
			<isset var="comment" />
			<then>
				<execute function="AssertTextEquals" locator1="LESATicketDetailsFeedbackPartner#COMMENT" value1="${comment}" />
			</then>
		</if>
	</command>
</definition>