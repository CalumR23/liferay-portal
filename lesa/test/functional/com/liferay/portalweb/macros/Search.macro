<definition>
	<command name="search">
		<execute macro="Button#search" />

		<execute function="Type" locator1="Search#KEYWORD_FIELD" value1="${keyword}" />
		<execute function="KeyPress" locator1="Search#KEYWORD_FIELD" value1="\RETURN"  />
	</command>

	<command name="searchProject">
		<execute macro="Search#search">
			<var name="keyword" value="${projectName}" />
		</execute>

		<execute function="AssertClick" locator1="Search#PROJECTS_TAB" value1="Projects(-)" />

		<var name="key_projectName" value="${projectName}" />

		<execute function="Click" locator1="Search#RESULT_ROW_PROJECT_NAME" />
	</command>
</definition>