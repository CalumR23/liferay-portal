<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="cseName" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />

	<command name="AddFormattedComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="CreateTicket#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a formatted comment." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Add Formatted Comment" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="Button#createTicket" />
		
		<execute macro="Message#success" />

		<execute macro="Comments#addComment">
			<var name="commentLines" value="[i]italics comment[/i],[u]underline[/u],[quote]This is quoted text.[/quote],[code] This is a line of code.[/code],[url=http://www.google.com]Google[/url],[url=https://en.wikipedia.org/wiki/Zip_(file_format)]Wikipedia article on Zip (file format)[/url],[url=https://issues.liferay.com/browse/LPP-17573?focusedCommentId=646544#comment-646544]JIRA Comment[/url]" />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="Comments#viewCommentWithReturns">
			<var name="commentCreator" value="${cseName}" />
			<var name="commentLines" value="italics comment,underline,This is quoted text., This is a line of code.,Google,Wikipedia article on Zip (file format),JIRA Comment" />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="User#logout" />
	</command>

	<command name="AddLiferayComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="CreateTicket#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a Liferay comment." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Add Liferay Comment" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="Button#createTicket" />
		
		<execute macro="Message#success" />

		<var locator="TicketDetails#TICKET_NUMBER" name="ticketNumber" />

		<execute macro="Comments#addComment">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentType" value="Liferay" />
		</execute>

		<execute macro="Comments#viewLiferayComment">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />			
		</execute>

		<execute macro="Comments#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="ticketNumber" value="${ticketNumber}" />			
		</execute>

		<execute macro="User#logout" />
	</command>

	<command name="AddPublicComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="CreateTicket#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a public comment." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Add Public Comment" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="Button#createTicket" />
		
		<execute macro="Message#success" />

		<var locator="TicketDetails#TICKET_NUMBER" name="ticketNumber" />

		<execute macro="Comments#addComment">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="Comments#viewPublicComment">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />			
		</execute>

		<execute macro="Comments#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="public" value="true" />
			<var name="ticketNumber" value="${ticketNumber}" />			
		</execute>

		<execute macro="User#logout" />
	</command>

	<command name="AddAttachmentOnComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="CreateTicket#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a public comment with an attachment." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Add An Attachment On Comment" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="Button#createTicket" />
		
		<execute macro="Message#success" />

		<execute macro="Comments#addComment">
			<var name="comment" value="This is a QA test public comment with an attachment." />
			<var name="commentType" value="Public" />
			<var name="fileName" value="patchinfo.txt" />
		</execute>

		<execute macro="Comments#viewCommentWithAttachment">
			<var name="comment" value="This is a QA test public comment with an attachment." />
			<var name="commentType" value="Public" />
			<var name="fileName" value="patchinfo.txt" />
		</execute>

		<execute macro="User#logout" />
	</command>

	<command name="AddWorkerComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="Button#newTicket" />

		<execute macro="CreateTicket#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a worker comment." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Add Worker Comment" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="Button#createTicket" />
		
		<execute macro="Message#success" />

		<var locator="TicketDetails#TICKET_NUMBER" name="ticketNumber" />

		<execute macro="Comments#addComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentType" value="Worker" />
		</execute>

		<execute macro="Comments#viewWorkerComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />			
		</execute>

		<execute macro="Comments#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="ticketNumber" value="${ticketNumber}" />			
		</execute>

		<execute macro="User#logout" />
	</command>
</definition>