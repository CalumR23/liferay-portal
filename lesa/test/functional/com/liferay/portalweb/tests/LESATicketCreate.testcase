<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="reporterName" />
	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />

	<set-up>
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="User#logout" />
	</tear-down>

	<command name="CreateTicketActivationKeyComponent">
		<execute macro="Navigation#gotoLESA" />
		
		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Activation Key" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Activation Key component." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Activation Key" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketCreate#inputActivationKeyDetails">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />
		
		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Activation Key component." />
		</execute>

		<execute macro="LESATicketView#viewActivationKeyDetails">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>
	</command>

	<command name="CreateTicketAsCustomerDeveloper">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="customer" value="yes" />
			<var name="description" value="QA Test for creating a ticket as a customer developer." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="summary" value="QA Test Create Ticket As Customer Developer" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>
	</command>

	<command name="CreateTicketAsCustomerWatcher">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cwatcherEmailAddress}" />
			<var name="userPassword" value="${cwatcherPassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="Message#info">
			<var name="message" value="Watchers cannot create tickets in LESA; please contact your Liferay provisioning representative to request any changes to your project." />
		</execute>
	</command>

	<command name="CreateTicketAsPartnerManager">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket as a partner manager." />
			<var name="product" value="${product}" />
			<var name="project" value="California Casualty" />
			<var name="savedEnvConfigName" value="Liferay EE Upgrade" />
			<var name="summary" value="QA Test Create Ticket As Partner Manager" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>
	</command>

	<command name="CreateTicketAsPartnerWatcher">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${pwatcherEmailAddress}" />
			<var name="userPassword" value="${pwatcherPassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="Message#info">
			<var name="message" value="Watchers cannot create tickets in LESA; please contact your Liferay provisioning representative to request any changes to your project." />
		</execute>
	</command>

	<command name="CreateTicketClusteringComponent">
		<execute macro="Navigation#gotoLESA" />
		
		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Clustering" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Clustering component." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Clustering" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketCreate#inputClusteringDetails">
			<var name="serverCommunicationType" value="Multicast" />	
		</execute>

		<execute macro="LESATicketCreate#createTicket" />
		
		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="Firefox 20+" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Clustering component." />
		</execute>

		<execute macro="LESATicketView#viewClusteringDetails">
			<var name="serverCommunicationType" value="Multicast" />	
		</execute>
	</command>

	<command name="CreateTicketLongSummary">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket a long summary.  Summary field should only allow up to 255 characters.  * is the 255th character in the summary." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*sttesttest" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketView#viewSummary">
			<var name="summary" value="QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*" />
		</execute>
	</command>

	<command name="CreateTicketNewConfig" priority="5">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c" />
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11.2" />
			<var name="description" value="QA Test for creating a ticket with a new environment configuration." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="summary" value="QA Test New Config" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="Firefox 20+" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with a new environment configuration." />
		</execute>
	</command>

	<command name="CreateTicketSavedConfig" priority="5">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with a saved environment configuration." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Saved Config" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="Firefox 20+" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with a saved environment configuration." />
		</execute>
	</command>

	<command name="CreateTicketSocialOfficeProduct" priority="5">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c" />
			<var name="browser" value="Firefox 20+" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11.2" />
			<var name="description" value="QA Test for creating a ticket with SO product." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="3.1.1" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Social Office" />
			<var name="project" value="Liferay Support Training" />
			<var name="summary" value="QA Test SO Product" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Social Office" />
		</execute>		
	</command>

	<command name="CreateTicketUpgradeComponent" priority="5">
		<execute macro="Navigation#gotoLESA" />
	
		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Upgrade" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Upgrade component." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Upgrade" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<execute macro="LESATicketCreate#inputUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="toLiferayVersion" value="6.2 EE" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />
	
		<execute macro="Message#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="Firefox 20+" />
			<var name="reporterName" value="${reporterName}" />
			<var name="toLiferayVersion" value="6.2 EE" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Upgrade component." />
		</execute>

		<execute macro="LESATicketView#viewUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>
	</command>
</definition>