<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="sequential" value="OSBAdmin" />

	<var method="TestPropsUtil#get('lesa.email.address.3')" name="casEmailAddress" />
	<var method="TestPropsUtil#get('lesa.cas.name.3')" name="casName" />
	<var method="TestPropsUtil#get('lesa.email.password.3')" name="casPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />

	<var name="staticTearDownPartner" static="true" value="" />
	<var name="staticTearDownProject" static="true" value="" />

	<set-up>
		<var name="staticTearDownPartner" value="" />
		<var name="staticTearDownProject" value="" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${casEmailAddress}" />
			<var name="userPassword" value="${casPassword}" />
		</execute>

		<execute macro="Navigation#gotoOSBAdmin" />
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownProject}" arg2="" />
			</not>
			<then>
				<execute macro="OSBAdminProject#tearDownProject">
					<var name="projectCode" value="${staticTearDownProject}" />
				</execute>
			</then>
		</if>

		<if>
			<not>
				<equals arg1="${staticTearDownPartner}" arg2="" />
			</not>
			<then>
				<execute macro="OSBAdminPartner#tearDownPartner">
					<var name="partnerCode" value="${staticTearDownPartner}" />
				</execute>
			</then>
		</if>

		<execute macro="User#logout" />
	</tear-down>

	<command name="AddPartner">
		<var name="staticTearDownPartner" value="QAPARTNER1" />

		<execute macro="OSBAdminPartner#addPartner">
			<var name="additionalNotes" value="This is a test." />
			<var name="city" value="Diamond Bar" />
			<var name="country" value="United States" />
			<var name="partnerCode" value="QAPARTNER1" />
			<var name="phoneNumber" value="7145555555" />
			<var name="postalCode" value="91765" />
			<var name="region" value="California" />
			<var name="streetAddress" value="123 Main St." />
			<var name="supportRegion" value="US" />
		</execute>
	</command>

	<command name="AddPartnerManagedAccount">
		<var name="staticTearDownPartner" value="QAPARTNER2" />
		<var name="staticTearDownProject" value="QATEST4" />

		<execute macro="OSBAdminPartner#addPartner">
			<var name="additionalNotes" value="This is a test." />
			<var name="city" value="Diamond Bar" />
			<var name="country" value="United States" />
			<var name="partnerCode" value="QAPARTNER2" />
			<var name="phoneNumber" value="7145555555" />
			<var name="postalCode" value="91765" />
			<var name="region" value="California" />
			<var name="streetAddress" value="123 Main St." />
			<var name="supportRegion" value="US" />
		</execute>

		<execute macro="OSBAdminProject#addProject">
			<var name="addressLine" value="123 Main Street" />
			<var name="city" value="Augusta" />
			<var name="country" value="United States" />
			<var name="businessAccountName" value="QA Test Project 4" />
			<var name="code" value="QATEST4" />
			<var name="industry" value="Manufacturing" />
			<var name="projectName" value="QA Project 4" />
			<var name="state" value="Maine" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="OSBAdminPartner#addPartnerToAccount">
			<var name="partnerCode" value="QAPARTNER2" />
			<var name="projectCode" value="QATEST4" />
		</execute>
	</command>
</definition>