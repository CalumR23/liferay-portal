<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.3')" name="casEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.3')" name="casPassword" />

	<set-up>
		<execute macro="User#login">
			<var name="userEmailAddress" value="${casEmailAddress}" />
			<var name="userPassword" value="${casPassword}" />
		</execute>

		<execute macro="Navigation#gotoLESA" />
	</set-up>

	<tear-down>
		<execute macro="EditProject#deleteCallLog">
			<var name="projectName" value="Ameriprise Financial" />
			<var name="summary" value="QA Test call log" />		
		</execute>

		<execute macro="User#logout" />
	</tear-down>

	<command name="AddCallLogAsCAS">
		<execute macro="Search#searchProject">
			<var name="projectName" value="Ameriprise Financial" />
		</execute>

		<execute macro="EditProject#addCallLog">
			<var name="actionItems" value="Test action items." />
			<var name="callDateDay" value="6" />
			<var name="callDateMonth" value="January" />
			<var name="callDateYear" value="2016" />
			<var name="callLengthHours" value="0" />
			<var name="callLengthMinutes" value="45" />
			<var name="callLengthSeconds" value="10" />
			<var name="callType" value="Incoming" />
			<var name="clientsPresent" value="Client A, Client B" />
			<var name="notes" value="This is a QA test." />
			<var name="summary" value="QA Test call log" />
		</execute>

		<execute macro="ViewProject#viewCallLog">
			<var name="actionItems" value="Test action items." />
			<var name="callDate" value="2016-01-06" />
			<var name="callLength" value="00:45:10" />
			<var name="callType" value="incoming" />
			<var name="clientsPresent" value="Client A, Client B" />
			<var name="notes" value="This is a QA test." />
			<var name="summary" value="QA Test call log" />
		</execute>		
	</command>

	<command name="EditCASInformation">
		<execute macro="Search#searchProject">
			<var name="projectName" value="ACME PORTAL" />
		</execute>

		<execute macro="EditProject#editCASInformation">
			<var name="contactOverview" value="Contact QA Test" />
			<var name="majorMilestones" value="Building a Death Star by 2020" />
			<var name="projectOverview" value="Liferay Version: 6.2.10 EE" />
			<var name="reasonsForStrategic" value="QA Test" />
		</execute>

		<execute macro="ViewProject#viewCASInformation">
			<var name="contactOverview" value="Contact QA Test" />
			<var name="majorMilestones" value="Building a Death Star by 2020" />
			<var name="projectOverview" value="Liferay Version: 6.2.10 EE" />
			<var name="reasonsForStrategic" value="QA Test" />
		</execute>
	</command>

	<command name="EditCEMCXMInformation">
		<execute macro="Search#searchProject">
			<var name="projectName" value="ACME PORTAL" />
		</execute>

		<execute macro="EditProject#editCEMCXMInformation">
			<var name="licenseInformation" value="Platinum Prod (5); Non-Prod (2)" />
			<var name="salesforceURL" value="Insert Salesforce link here." />
			<var name="trainingsAttended" value="Liferay Certification" />
		</execute>

		<execute macro="ViewProject#viewCEMCXMInformation">
			<var name="licenseInformation" value="Platinum Prod (5); Non-Prod (2)" />
			<var name="salesforceURL" value="Insert Salesforce link here." />
			<var name="trainingsAttended" value="Liferay Certification" />
		</execute>
	</command>
</definition>