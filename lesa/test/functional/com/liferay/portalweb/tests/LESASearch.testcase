<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.cas.name.3')" name="casName" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />
	<var method="TestPropsUtil#get('lesa.partner.name.6')" name="partnerName" />
	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseCommandName">
			<return name="testCaseCommandName" />
	  	</execute>

	  	<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<if>
			<equals arg1="${testCaseName}" arg2="CreateTicketAsCustomerAndViewWithPartnerFilter" />
			<then>
				<execute macro="User#logoutAndLogin">
					<var name="userEmailAddress" value="${adminEmailAddress}" />
					<var name="userPassword" value="${adminPassword}" />
				</execute>

				<execute macro="OSBAdminProject#tearDownAssignedCustomer">
					<var name="emailAddress" value="${partnerEmailAddress}" />
					<var name="projectCode" value="QAPROJECT2" />
				</execute>
			</then>
		</if>

		<if>
			<equals arg1="${testCaseName}" arg2="FilterTicketsByProjectAsCustomer" />
			<then>
				<execute macro="User#logoutAndLogin">
					<var name="userEmailAddress" value="${adminEmailAddress}" />
					<var name="userPassword" value="${adminPassword}" />
				</execute>

				<execute macro="OSBAdminProject#tearDownAssignedCustomer">
					<var name="emailAddress" value="${customerEmailAddress}" />
					<var name="projectCode" value="QAPROJECT2" />
				</execute>
			</then>
		</if>

		<execute macro="User#logout" />
	</tear-down>

	<command name="CreateTicketAsCustomerAndViewWithPartnerFilter">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>
		
		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${partnerEmailAddress}" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="role" value="Developer" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="Chrome" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket as a customer and viewing it with the partner." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Portal" />
			<var name="project" value="QA Test Project 2" />
			<var name="server" value="Production" />
			<var name="summary" value="QA Test Create Ticket As Customer And View With Partner Filter" />
			<var name="systemStatus" value="Functioning with Limited Capabilities" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketView#assertNotAssignedTo">
			<var name="name" value="${partnerName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#searchPartnersViaTicketsChooseAssignee">
			<var name="code" value="QA Test Partner" />
		</execute>

		<execute macro="LESASearch#sortByTicketNumberDescending" />

		<execute macro="LESASearch#assertTicketNotInResult">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="FilterTicketsByProjectAsCustomer">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>
		
		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#viewSelectedProjectSingle">
			<var name="project" value="QA Test Project 1" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${customerEmailAddress}" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="role" value="Developer" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#filterTicketsByProject">
			<var name="projectName" value="QA Test Project 1" />
		</execute>

		<execute macro="LESASearch#filterTicketsByProject">
			<var name="projectName" value="QA Test Project 2" />
		</execute>

		<execute macro="LESASearch#viewSelectedProjects">
			<var name="projectList" value="QA Test Project 1,QA Test Project 2" />
		</execute>
	</command>

	<command name="FilterTicketsByProjectAsPartner">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>
		
		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#filterTicketsByProject">
			<var name="projectName" value="QA Test Project 1" />
		</execute>

		<execute macro="LESASearch#viewSelectedProjects">
			<var name="projectList" value="QA Test Project 1" />
		</execute>
	</command>

	<command name="RemoveTicketAssigneeFilters">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>
		
		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#selectFilterTicketsAccountWorker">
			<var name="accountWorkerList" value="${casName}" />
		</execute>

		<execute macro="LESASearch#viewSelectedAccountWorkers">
			<var name="accountWorkerList" value="${casName}" />
		</execute>

		<execute macro="LESASearch#removeFilterTicketsAccountWorker">
			<var name="accountWorkerList" value="${casName}" />
		</execute>

		<execute macro="LESASearch#selectFilterTicketsAssignee">
			<var name="assigneeList" value="${partnerName}" />
		</execute>

		<execute macro="LESASearch#viewSelectedAssignees">
			<var name="assigneeList" value="${partnerName}" />
		</execute>

		<execute macro="LESASearch#removeFilterTicketsAssignee">
			<var name="assigneeList" value="${partnerName}" />
		</execute>

		<execute macro="LESASearch#selectFilterTicketsAccountWorker">
			<var name="accountWorkerList" value="${casName}" />
		</execute>

		<execute macro="LESASearch#selectFilterTicketsAssignee">
			<var name="assigneeList" value="${partnerName}" />
		</execute>

		<execute function="Refresh" />

		<execute macro="LESASearch#removeFilterTicketsAssignee">
			<var name="assigneeList" value="${partnerName}" />
		</execute>

		<execute macro="LESASearch#removeFilterTicketsAccountWorker">
			<var name="accountWorkerList" value="${casName}" />
		</execute>
	</command>

	<command name="ReturnToSearchResults">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#search">
			<var name="keyword" value="QAPROJECT1" />
		</execute>

		<execute macro="LESASearch#getTicketCount">
			<return from="ticketCount" name="firstTicketCount" />
		</execute>

		<execute macro="LESASearch#gotoSearchResultTicket">
			<var name="ticketNumber" value="QAPROJECT1" />
		</execute>

		<execute macro="Navigation#back" />

		<execute macro="LESASearch#assertTicketCountEqual">
			<var name="ticketCount" value="${firstTicketCount}" />
		</execute>
	</command>

	<command name="SearchInvalidTicket">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="Navigation#gotoTicket">
			<var name="ticketNumber" value="CALCAS-60" />
		</execute>

		<execute macro="Message#error">
			<var name="errorMessage" value="Invalid ticket search, please try again." />
		</execute>

		<execute macro="LESASearch#search">
			<var name="keyword" value="QAPROJECT1-123456" />			
		</execute>

		<execute macro="Message#error">
			<var name="errorMessage" value="Invalid ticket search, please try again." />
		</execute>
	</command>

	<command name="SearchPartnersViaTicketsChooseAssignee">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />
		
		<execute macro="LESASearch#searchPartnersViaTicketsChooseAssignee">
			<var name="managingSupport" value="Yes" />
		</execute>
	</command>

	<command name="ViewTicketCountWithStatusAndResolutionFilters">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#filterTicketsByStatusAndResolution">
			<var name="resolution" value="Future Release" />
			<var name="status" value="Closed" />
		</execute>

		<execute macro="LESASearch#getTicketCount">
			<return from="ticketCount" name="firstTicketCount" />
		</execute>

		<execute macro="LESASearch#checkTicketStatus">
			<var name="status" value="Open" />
		</execute>

		<execute macro="LESASearch#assertTicketCountNotEqual">
			<var name="ticketCount" value="${firstTicketCount}" />
		</execute>
	</command>

	<command name="ViewPartnerTicketSearchFilters">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="Navigation#gotoLESASearch" />

		<execute macro="LESASearch#viewPartnerTicketSearchFilters" />
	</command>
</definition>