<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />

	<set-up>
		<execute macro="User#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="Navigation#gotoOSBAdmin" />
	</set-up>

	<tear-down>
		<execute macro="OSBAdminSales#deleteOrder">
			<var name="actualPrice" value="222" />
			<var name="projectCode" value="QATEST5" />
		</execute>

		<execute macro="OSBAdminSales#deleteOffering">
			<var name="currency" value="USD" />
			<var name="product" value="Portal Non-Production" />
			<var name="retailPrice" value="333" />
			<var name="support" value="Americas English Gold" />			
		</execute>

		<for list="QATEST1,QATEST2,QATEST3,QATEST5" param="projectCode">
			<execute macro="OSBAdminProject#deleteProject">
				<var name="projectCode" value="${projectCode}" />
			</execute>
		</for>

		<execute macro="User#logout" />
	</tear-down>

	<command name="AddProject">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="city" value="Augusta" />
			<var name="country" value="United States" />
			<var name="businessAccountName" value="QA Test Project 1" />
			<var name="code" value="QATEST1" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 1" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>
	</command>

	<command name="AddProjectWithOffering">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="city" value="Augusta" />
			<var name="country" value="United States" />
			<var name="businessAccountName" value="QA Test Project 5" />
			<var name="code" value="QATEST5" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 5" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="OSBAdminProject#viewProjectStatus">
			<var name="projectCode" value="QATEST5" />
			<var name="status" value="Closed" />
		</execute>

		<execute macro="OSBAdminSales#addOffering">
			<var name="product" value="Portal Non-Production" />
			<var name="servers" value="33" />
			<var name="support" value="Americas English Gold" />
			<var name="supportedServers" value="33" />
			<var name="unlimitedSupportTickets" value="yes" />
		</execute>

		<execute macro="OSBAdminSales#addOrder">
			<var name="product" value="Portal Non-Production" />
			<var name="projectName" value="QA Project 5" />
			<var name="servers" value="33" />
			<var name="support" value="Americas English Gold" />
		</execute>
	
		<execute macro="OSBAdminProject#viewProjectStatus">
			<var name="projectCode" value="QATEST5" />
			<var name="status" value="Active" />
		</execute>
	</command>

	<command name="AssignCustomer">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test Project 2" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST2" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 2" />
			<var name="state" value="Maine" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${customerEmailAddress}" />
			<var name="projectCode" value="QATEST2" />
			<var name="role" value="Developer" />
		</execute>
	</command>

	<command name="AssignWorker">
		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test Project 3" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST3" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 3" />
			<var name="state" value="Maine" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="OSBAdminProject#assignWorker">
			<var name="emailAddress" value="${casEmailAddress}" />
			<var name="projectCode" value="QATEST3" />
			<var name="role" value="Advocacy Specialist" />
		</execute>
	</command>
</definition>