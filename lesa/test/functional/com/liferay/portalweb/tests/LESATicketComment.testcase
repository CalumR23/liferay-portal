<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="cseName" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />

	<var name="browser" value="Firefox" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<tear-down>
		<execute macro="User#logout" />
	</tear-down>

	<command name="AddCommentAttachment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a public comment with an attachment." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add An Attachment On Comment" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test public comment with an attachment." />
			<var name="commentType" value="Public" />
			<var name="fileName" value="Document_1.txt" />
		</execute>

		<execute macro="LESATicketComment#viewCommentAttachment">
			<var name="comment" value="This is a QA test public comment with an attachment." />
			<var name="commentType" value="Public" />
			<var name="fileName" value="Document_1.txt" />
		</execute>
	</command>

	<command name="AddCommentWithDuplicateAttachment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for adding a duplicate attachment to a comment." />
			<var name="javaVM" value="Java 7" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Comment With Duplicate Attachment" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketComment#addCommentWithDuplicateAttachment">
			<var name="comment" value="Test comment with duplicate attachment." />
			<var name="fileName" value="patchinfo.txt" />
		</execute>
	</command>

	<command name="AddFormattedComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a formatted comment." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Formatted Comment" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="commentLines" value="[i]italics comment[/i],[u]underline[/u],[quote]This is quoted text.[/quote],[code] This is a line of code.[/code],[url=http://www.google.com]Google[/url],[url=https://en.wikipedia.org/wiki/Zip_(file_format)]Wikipedia article on Zip (file format)[/url],[url=https://issues.liferay.com/browse/LPP-17573?focusedCommentId=646544#comment-646544]JIRA Comment[/url]" />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketComment#viewCommentWithReturns">
			<var name="commentCreator" value="${cseName}" />
			<var name="commentLines" value="italics comment,underline,This is quoted text., This is a line of code.,Google,Wikipedia article on Zip (file format),JIRA Comment" />
			<var name="commentType" value="Public" />
		</execute>
	</command>

	<command name="AddLiferayComment">
		<property name="lesa.acceptance" value="true" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a Liferay comment." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Liferay Comment" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentType" value="Liferay" />
		</execute>

		<execute macro="LESATicketComment#viewLiferayComment">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketComment#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test Liferay comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="AddPublicComment">
		<property name="lesa.acceptance" value="true" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a public comment." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Public Comment" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketComment#viewPublicComment">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketComment#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test public comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="commentType" value="Public" />
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="AddWorkerComment">
		<property name="lesa.acceptance" value="true" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a worker comment." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Worker Comment" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentType" value="Worker" />
		</execute>

		<execute macro="LESATicketComment#viewWorkerComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketComment#viewCommentAsCustomer">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentCreator" value="${cseName}" />
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>
	</command>

	<command name="AddWorkerCommentOnPartnerManagedProject">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding a worker comment on a partner managed project." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Worker Comment On Partner Managed Project" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="P1" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentType" value="Worker" />
		</execute>

		<execute macro="LESATicketComment#viewWorkerComment">
			<var name="comment" value="This is a QA test worker comment." />
			<var name="commentCreator" value="${cseName}" />
		</execute>
	</command>

	<command name="AutoSaveAndDeleteDraftComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Application Display Templates" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for auto saving a comment." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Auto Save and Delete Draft Comment" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketComment#autoSaveComment">
			<var name="comment" value="QA test autosave comment." />
		</execute>

		<execute macro="LESATicketComment#deleteDraftComment">
			<var name="comment" value="QA test autosave comment." />
		</execute>
	</command>

	<command name="EditComment">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Portal Services" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for editing a comment." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Comment" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="QA CSE test comment." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="QA Partner test comment 1." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="QA Partner test comment 2." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketComment#assertCommentNotEditable">
			<var name="comment" value="QA CSE test comment." />
		</execute>

		<execute macro="LESATicketComment#assertCommentNotEditable">
			<var name="comment" value="QA Parter test comment 1." />
		</execute>

		<execute macro="LESATicketComment#editComment">
			<var name="newComment" value="QA Partner edited comment." />
			<var name="originalComment" value="QA Partner test comment 2." />
		</execute>

		<execute macro="LESATicketComment#viewComment">
			<var name="comment" value="QA Partner edited comment." />
			<var name="commentType" value="Public" />
		</execute>
	</command>

	<command name="ViewCommentNotEditableAsCustomer">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Portal Services" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test to confirm a Customer cannot edit a comment." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View Comment Not Editable As Customer" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="QA Customer test comment." />
		</execute>

		<execute macro="LESATicketComment#assertCommentNotEditable">
			<var name="comment" value="QA Customer test comment." />
		</execute>
	</command>
</definition>