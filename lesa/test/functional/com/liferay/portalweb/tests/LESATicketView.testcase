<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />

	<var name="browser" value="Firefox 20+" />
	<var name="product" value="Portal" />
	<var name="project" value="Ameriprise Financial" />
	<var name="savedEnvConfigName" value="Ameriprise Environment" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseCommandName">
			<return name="testCaseCommandName" />
	  	</execute>

	  	<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<if>
			<equals arg1="${testCaseName}" arg2="ViewTicketExpiredSupport" />
			<then>
				<execute macro="OSBAdminSales#editSupportLifetime">
					<var name="product" value="Portal Production" />
					<var name="project" value="${project}" />
					<var name="projectCode" value="AMERIPRISE" />
					<var name="supportLifetime" value="1 Year" />
				</execute>	
			</then>
		</if>

		<if>
			<equals arg1="${testCaseName}" arg2="ViewCreateTicketLiferayVersions" />
			<then>
				<execute macro="OSBAdminSales#editOfferingVersion">
					<var name="product" value="Portal Production" />
					<var name="project" value="QA Test Project 1" />
					<var name="projectCode" value="QAPROJECT1" />
					<var name="version" value="Any" />
				</execute>	
			</then>
		</if>

		<execute macro="User#logout" />
	</tear-down>

	<command name="ViewCreateTicketLiferayVersions">
		<var name="project" value="QA Test Project 1" />
		<var name="projectCode" value="QAPROJECT1" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminSales#editOfferingVersion">
			<var name="product" value="Portal Production" />
			<var name="project" value="${project}" />
			<var name="projectCode" value="${projectCode}" />
			<var name="version" value="Any" />
		</execute>	

		<execute macro="Navigation#gotoLESA" />

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Document Library" />
			<var name="product" value="Portal" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Authentication" />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="OSBAdminSales#editOfferingVersion">
			<var name="product" value="Portal Production" />
			<var name="project" value="${project}" />
			<var name="projectCode" value="${projectCode}" />
			<var name="version" value="6.1" />
		</execute>	

		<execute macro="Navigation#gotoLESA" />

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Document Library" />
			<var name="product" value="Portal" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="OSBAdminSales#editOfferingVersion">
			<var name="product" value="Portal Production" />
			<var name="project" value="${project}" />
			<var name="projectCode" value="${projectCode}" />
			<var name="version" value="7.0" />
		</execute>	

		<execute macro="Navigation#gotoLESA" />

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Authentication" />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>
	</command>

	<command name="ViewProjectAsPartner">
		<var name="project" value="California Casualty" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c" />
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11.2" />
			<var name="description" value="QA Test for navigating to Project view from Ticket view as a partner." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Portal" />
			<var name="project" value="${project}" />
			<var name="server" value="Production" />
			<var name="summary" value="QA Test View Project As Partner" />
			<var name="systemStatus" value="Functioning with Limited Capabilities" />
		</execute>

		<execute macro="LESAProjectView#viewProject">
			<var name="project" value="${project}" />
		</execute>
	</command>

	<command name="ViewTicketExpiredSupport">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="Navigation#gotoOSBAdmin" />

		<execute macro="OSBAdminSales#editSupportLifetime">
			<var name="product" value="Portal Production" />
			<var name="project" value="${project}" />
			<var name="projectCode" value="AMERIPRISE" />
			<var name="supportLifetime" value="1 Minute" />
		</execute>	

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for viewing expired support on a ticket." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View Ticket Expired Support" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewExpiredSupport" />
	</command>
</definition>