<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="sequential" value="CreateTicket" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.manager.name.2')" name="managerName" />
	<var method="TestPropsUtil#get('lesa.email.address.2')" name="managerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.2')" name="managerPassword" />

	<var name="browser" value="Firefox" />
	<var name="component" value="Document Library" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<command name="CloseTicketAsDuplicate">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for closing a ticket as duplicate." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Close Ticket As Duplicate" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Incident Reported" />
			<var name="newStatus" value="Closed" />
			<var name="resolution" value="Duplicate" />
		</execute>

		<execute macro="User#logout" />		
	</command>

	<command name="CompleteTicketClosedPendingCustomer">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for completing a ticket with status Closed (Pending Customer)." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Complete Ticket Closed Pending Customer" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Incident Reported" />
			<var name="newStatus" value="Closed" />
			<var name="resolution" value="Pending Customer" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#completeTicket" />

		<execute macro="User#logout" />		
	</command>

	<command name="CompleteAllWorkflowSteps">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for transitioning a ticket through every step of workflow." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Complete All Workflow Steps" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Incident Reported" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Investigate" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Investigating" />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Investigating" />
			<var name="newStatus" value="On Hold" />
		</execute>

		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Resume" />
		</execute>

		<execute macro="LESATicketTransition#reproduceSteps">
			<var name="steps" value="Ticket reproduction steps here..." />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Reproduced" />
		</execute>		

		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Analyze" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Engineer Analyzing" />
		</execute>

		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Build Patch" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Building Patch" />
		</execute>

		<execute macro="LESATicketTransition#workflowTicket">
			<var name="workflowStep" value="Propose Solution" />
		</execute>

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="solutionDescription" value="Test solution" />
			<var name="subcomponent" value="Cookies" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Proposed" />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Solution Proposed" />
			<var name="newStatus" value="Solution Delivered" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />
	</command>
	
	<command name="ForwardTicket">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for forwarding a ticket." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Forward Ticket" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#assignWorker">
			<var name="emailAddress" value="${managerEmailAddress}" />
			<var name="name" value="${managerName}" />
			<var name="role" value="Manager" />
		</execute>

		<execute macro="LESATicketTransition#forwardTicket">
			<var name="customerNextSteps" value="Customer next steps." />
			<var name="mainGoal" value="Main goal." />
			<var name="name" value="${managerName}" />
			<var name="nextRegionNextSteps" value="Next region next steps." />
			<var name="workDone" value="Work done." />
		</execute>

		<execute macro="User#logout" />		
	</command>
</definition>