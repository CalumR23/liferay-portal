<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.manager.name.2')" name="managerName" />
	<var method="TestPropsUtil#get('lesa.email.address.2')" name="managerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.2')" name="managerPassword" />

	<command name="CloseTicketAsDuplicate">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for closing a ticket as duplicate." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Close Ticket As Duplicate" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<var locator="LESATicketDetails#TICKET_NUMBER" name="ticketNumber" />

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#closeTicket">
			<var name="currentStatus" value="Incident Reported" />
			<var name="resolution" value="Duplicate" />
		</execute>
	</command>
	
	<command name="ForwardTicket">
		<execute macro="User#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="Firefox 20+" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for forwarding a ticket." />
			<var name="product" value="Portal Production" />
			<var name="project" value="Ameriprise Financial" />
			<var name="savedEnvConfigName" value="Ameriprise Environment" />
			<var name="summary" value="QA Test Forward Ticket" />
			<var name="systemStatus" value="Completely Inoperable/Shutdown" />
		</execute>

		<var locator="LESATicketDetails#TICKET_NUMBER" name="ticketNumber" />

		<execute macro="Navigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />			
		</execute>

		<execute macro="LESATicketTransition#assignWorker">
			<var name="emailAddress" value="${managerEmailAddress}" />
			<var name="name" value="${managerName}" />
			<var name="role" value="Manager" />
		</execute>

		<execute macro="LESATicketTransition#forwardTicket">
			<var name="customerNextSteps" value="Customer next steps." />
			<var name="mainGoal" value="Main goal." />
			<var name="name" value="${managerName}" />
			<var name="nextRegionNextSteps" value="Next region next steps." />
			<var name="workDone" value="Work done." />
		</execute>

		<execute macro="User#logout" />		
	</command>
</definition>