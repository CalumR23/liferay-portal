<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="sequential" value="OSBAdmin" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />

	<set-up>
		<execute macro="User#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>
	</set-up>

	<command name="AddAndDeleteSupportRegion" >
		<execute macro="Navigation#gotoOSBAdminSupportRegions" />

		<execute macro="OSBAdminSupport#addSupportRegion">
			<var name="description" value="for QA test" />
			<var name="name" value="US-QA" />
			<var name="timeZone" value="Pacific Standard Time" />
		</execute>

		<execute macro="OSBAdminSupport#viewSupportRegionInfo">
			<var name="description" value="for QA test" />
			<var name="name" value="US-QA" />
			<var name="timeZone" value="Pacific Standard Time" />
		</execute>

		<execute macro="OSBAdminSupport#deleteSupportRegion">
			<var name="name" value="US-QA" />
		</execute>
	</command>
</definition>