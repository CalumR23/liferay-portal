<html>
<head>
<title>LESANavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESANavigation</td></tr>
</thead>
<tbody>
<!--Navigation Bar-->
<tr>
	<td>NAVIGATION_MENU</td>
	<td>//div[contains(@class,'banner')]//div[contains(@class,'class-toggle-off-click menu-navigation')]|//div[contains(@id,'mainMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_IN</td>
	<td>//div[contains(@class,'banner')]//a[.='Sign In']</td>
	<td></td>
</tr>
<tr>
	<td>LESA_BUTTON</td>
	<td>//div[@id='mainNavigation']/nav/ul/li[4]/a</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_OUT</td>
	<td>//div[contains(@class,'banner')]//a[.='Sign Out']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>