<html>
<head>
<title>OSBAdminSalesOfferings</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminSalesOfferings</td></tr>
</thead>
<tbody>
<tr>
	<td>ADD_OFFERING_BUTTON</td>
	<td>//input[@value='Add Offering']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@name,'productEntryIds')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_SELECT</td>
	<td>//select[contains(@name,'supportResponseIds')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENCY_SELECT</td>
	<td>//select[contains(@name,'currencyEntryIds')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_RETAIL_PRICE</td>
	<td>//td[contains(@headers,'retail-price') and contains(.,'${key_retailPrice}')]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>