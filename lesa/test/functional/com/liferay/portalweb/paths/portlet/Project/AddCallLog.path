<html>
<head>
<title>AddCallLog</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">AddCallLog</td></tr>
</thead>
<tbody>
<tr>
	<td>CALL_LOG_IFRAME</td>
	<td>//iframe[contains(@id,'updateAccountCall')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_TYPE_SLECT</td>
	<td>//select[contains(@id,'type')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_DATE_MONTH_SELECT</td>
	<td>//select[contains(@id,'callDateMonth')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_DATE_DAY_SELECT</td>
	<td>//select[contains(@id,'callDateDay')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_DATE_YEAR_SELECT</td>
	<td>//select[contains(@id,'callDateYear')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LENGTH_HOURS_SELECT</td>
	<td>//select[contains(@name,'callLengthHours')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LENGTH_MINUTES_SELECT</td>
	<td>//select[contains(@name,'callLengthMinutes')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LENGTH_SECONDS_SELECT</td>
	<td>//select[contains(@name,'callLengthSeconds')]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_FIELD</td>
	<td>//textarea[contains(@name,'summary')]</td>
	<td></td>
</tr>
<tr>
	<td>CLIENTS_PRESENT_FIELD</td>
	<td>//textarea[contains(@name,'clientsPresent')]</td>
	<td></td>
</tr>
<tr>
	<td>NOTES_FIELD</td>
	<td>//textarea[contains(@name,'notes')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_ITEMS_FIELD</td>
	<td>//textarea[contains(@name,'actionItems')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>