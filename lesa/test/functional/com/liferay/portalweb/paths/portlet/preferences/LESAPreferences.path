<html>
<head>
<title>LESAPreferences</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESAPreferences</td></tr>
</thead>
<tbody>
<tr>
	<td>GENERAL_TAB</td>
	<td>//a[contains(.,'General')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_DASHBOARD_TAB</td>
	<td>//a[contains(.,'Manager Dashboard')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MANAGER DASHBOARD -->
<tr>
	<td>MANAGER_DASHBOARD_STATUS_TOGGLE</td>
	<td>//td[contains(@class,'user-name') and contains(.,'${key_cseName}')]/..//span[contains(@class,'toggle-on-off-switch-inner')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_DASHBOARD_STATUS_IN</td>
	<td>//td[contains(@class,'user-name') and contains(.,'${key_cseName}')]/..//div/a[contains(@class,'switch-ctrl on')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_DASHBOARD_STATUS_ON_PTO</td>
	<td>//td[contains(@class,'user-name') and contains(.,'${key_cseName}')]/..//div/a[contains(@class,'switch-ctrl off')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>