<html>
<head>
<title>OSBAdminAccountAdd</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminAccountAdd</td></tr>
</thead>
<tbody>
<tr>
	<td>PROJECT_NAME_FIELD</td>
	<td>//input[contains(@name,'name')]</td>
	<td></td>
</tr>
<tr>
	<td>CODE_FIELD</td>
	<td>//input[contains(@name,'code')]</td>
	<td></td>
</tr>
<tr>
	<td>CORP_PROJECT_SELECT_BUTTON</td>
	<td>//span[contains(@id,'corpProjectName')]/following-sibling::input[@value='Select']</td>
	<td></td>
</tr>
<tr>
	<td>CORP_PROJECT_REMOVE_BUTTON</td>
	<td>//span[contains(@id,'corpProjectName')]/following-sibling::input[@value='Remove']</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_SELECT</td>
	<td>//select[contains(@name,'type')]</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRY_SELECT</td>
	<td>//select[contains(@name,'industry')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER</td>
	<td>//span[contains(@id,'partnerEntryCode')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_SELECT_BUTTON</td>
	<td>//input[contains(@onclick,'partnerEntryWindow')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_REMOVE_BUTTON</td>
	<td>//input[contains(@id,'removePartnerEntryButton')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_MANAGED_SUPPORT_CHECKBOX</td>
	<td>//input[contains(@name,'partnerManagedSupportCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>TIER_SELECT</td>
	<td>//select[contains(@name,'tier')]</td>
	<td></td>
</tr>
<tr>
	<td>MAXIMUM_CONTACTS_FIELD</td>
	<td>//input[contains(@name,'maxCustomers')]</td>
	<td></td>
</tr>
<tr>
	<td>SPECIAL_INSTRUCTIONS_FIELD</td>
	<td>//textarea[contains(@name,'instructions')]</td>
	<td></td>
</tr>
<tr>
	<td>ADDITIONAL_NOTES_FIELD</td>
	<td>//textarea[contains(@name,'notes')]</td>
	<td></td>
</tr>
<tr>
	<td>ADDRESS_LINE_FIELD</td>
	<td>//input[contains(@name,'street1')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[contains(@name,'countryId')]</td>
	<td></td>
</tr>
<tr>
	<td>STATE_PROVINCE_SELECT</td>
	<td>//select[contains(@name,'regionId')]</td>
	<td></td>
</tr>
<tr>
	<td>CITY_FIELD</td>
	<td>//input[contains(@name,'city')]</td>
	<td></td>
</tr>
<tr>
	<td>POSTAL_CODE_FIELD</td>
	<td>//input[contains(@name,'zip')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REGIONS_TAB</td>
	<td>//a[contains(.,'Support Regions')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_LANGUAGES_TAB</td>
	<td>//a[contains(.,'Support Languages')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_SUPPORT_REGION_BUTTON</td>
	<td>//input[@value='Add Support Region']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_SUPPORT_LANGUAGE_BUTTON</td>
	<td>//input[@value='Add Support Language']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_RESULT_ROW</td>
	<td>//tr[contains(@class,'results-row')]/td[contains(.,'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REMOVE_BUTTON</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_item}')]//input[@value='Remove']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_MESSAGES_TAB</td>
	<td>//a[contains(.,'Project Messages')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGE_MESSAGES_BUTTON</td>
	<td>//input[@value='Manage Messages']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>