	<td>PARTNER_MANAGED_SUPPORT_CHECKBOX</td>
	<td>//input[contains(@name,'partnerManagedSupportCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>TIER_SELECT</td>
	<td>//select[contains(@name,'tier')]</td>
	<td></td>
</tr>
<tr>
	<td>MAXIMUM_CONTACTS_FIELD</td>
	<td>//input[contains(@name,'maxCustomers')]</td>
	<td></td>
</tr>
<tr>
	<td>SPECIAL_INSTRUCTIONS_FIELD</td>
