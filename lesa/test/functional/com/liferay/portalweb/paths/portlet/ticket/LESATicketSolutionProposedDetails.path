<html>
<head>
<title>LESATicketSolutionProposedDetails</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketSolutionProposedDetails</td></tr>
</thead>
<tbody>
<tr>
	<td>DESCRIPTION_FIELD</td>
	<td>//textarea[contains(@id,'solution')]</td>
	<td></td>
</tr>
<tr>
	<td>FILE_1_NAME</td>
	<td>//li[contains(@id,'SWFUpload_0')]/span[@class='title']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_1_BUTTON</td>
	<td>//object[contains(@id,'SWFUpload_0')]</td>
	<td></td>
</tr>
<tr>
	<td>FILE_2_NAME</td>
	<td>//li[contains(@id,'SWFUpload_1')]/span[@class='title']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_2_BUTTON</td>
	<td>//object[contains(@id,'SWFUpload_1')]</td>
	<td></td>
</tr>
<tr>
	<td>FILE_3_NAME</td>
	<td>//li[contains(@id,'SWFUpload_2')]/span[@class='title']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_3_BUTTON</td>
	<td>//object[contains(@id,'SWFUpload_2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_1_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL1')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_1_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType1')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_2_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_2_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_3_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL3')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_3_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType3')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBCOMPONENT_SELECT</td>
	<td>//select[contains(@name,'ticketEntrySubcomponent')]</td>
	<td></td>
</tr>
<tr>
	<td>ISSUE_TYPE_SELECT</td>
	<td>//select[contains(@name,'issueType')]</td>
	<td></td>
</tr>
<tr>
	<td>ISSUE_SUMMARY_SELECT</td>
	<td>//select[contains(@name,'useCustomerSummary')]</td>
	<td></td>
</tr>
<tr>
	<td>ISSUE_SUMMARY_DESCRIPTION_FIELD</td>
	<td>//textarea[contains(@id,'summary')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>