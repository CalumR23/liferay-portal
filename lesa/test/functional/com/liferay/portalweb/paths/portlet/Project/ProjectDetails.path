<html>
<head>
<title>ProjectDetails</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectDetails</td></tr>
</thead>
<tbody>
<!--Lower Tabs-->
<tr>
	<td>CALL_LOG_TAB</td>
	<td>//span[contains(@id,'callLog')]</td>
	<td></td>
</tr>
<tr>
	<td>CAS_INFORMATION_TAB</td>
	<td>//span[contains(@id,'casInformation')]</td>
	<td></td>
</tr>
<tr>
	<td>CEM_CXM_INFORMATION_TAB</td>
	<td>//span[contains(@id,'cemCxmInformation')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_INSTRUCTIONS_TAB</td>
	<td>//span[contains(@id,'supportInstructions')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NOTES_TAB</td>
	<td>//span[contains(@id,'projectNotes')]</td>
	<td></td>
</tr>
<!-- Call Log Tab Content -->
<tr>
	<td>CALL_LOG_ROW</td>
	<td>//tr[contains(.,'${key_callDate}') and contains(.,'${key_summary}')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LOG_DATE</td>
	<td>//a[contains(.,'${key_callDate}')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LOG_SUMMARY</td>
	<td>//a[contains(.,'${key_summary}')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_TYPE_FIELD</td>
	<td>//div[contains(@class,'customer-info')]/div[contains(.,'Call Type') and contains(.,'${key_callType}')]</td>
	<td></td>
</tr>
<tr>
	<td>CALL_LENGTH_FIELD</td>
	<td>//div[contains(@class,'customer-info')]/div[contains(.,'Call Length') and contains(.,'${key_callLength}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_FIELD</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Summary:') and contains(.,'${key_summary}')]</td>
	<td></td>
</tr>
<tr>
	<td>CLIENTS_PRESENT_FIELD</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Clients Present:') and contains(.,'${key_clientsPresent}')]</td>
	<td></td>
</tr>
<tr>
	<td>NOTES_FIELD</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Notes:') and contains(.,'${key_notes}')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTION_ITEMS_FIELD</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Action Items:') and contains(.,'${key_actionItems}')]</td>
	<td></td>
</tr>
<!-- CAS Information Tab Content -->
<tr>
	<td>REASONS_FOR_STRATEGIC_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Reasons for Strategic:') and contains(.,'${key_reasonsForStrategic}')]</td>
	<td></td>
</tr>
<tr>
	<td>REASONS_FOR_STRATEGIC_FIELD</td>
	<td>//textarea[contains(@name,'field--2')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_OVERVIEW_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Project Overview') and contains(.,'${key_projectOverview}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_OVERVIEW_FIELD</td>
	<td>//textarea[contains(@name,'field--3')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_OVERVIEW_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Contact Overview:') and contains(.,'${key_contactOverview}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_OVERVIEW_FIELD</td>
	<td>//textarea[contains(@name,'field--4')]</td>
	<td></td>
</tr>
<tr>
	<td>MILESTONES_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Major Milestones and Dates:') and contains(.,'${key_majorMilestones}')]</td>
	<td></td>
</tr>
<tr>
	<td>MILESTONES_FIELD</td>
	<td>//textarea[contains(@name,'field--5')]</td>
	<td></td>
</tr>
<tr>
	<td>OTHER_INFORMATION_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Other Information:') and contains(.,'${key_otherInformation}')]</td>
	<td></td>
</tr>
<tr>
	<td>OTHER_INFORMATION_FIELD</td>
	<td>//textarea[contains(@name,'field--6')]</td>
	<td></td>
</tr>
<tr>
	<td>CAS_INFO_EDIT_BUTTON</td>
	<td>//div[contains(@id,'contentCasInformation')]//input[@value='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>CAS_INFO_SAVE_BUTTON</td>
	<td>//div[contains(@id,'contentCasInformation')]//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>CAS_INFO_CANCEL_BUTTON</td>
	<td>//div[contains(@id,'contentCasInformation')]//input[@value='Cancel']</td>
	<td></td>
</tr>
<!-- CEM/CXM Information Tab Content -->
<tr>
	<td>LICENSE_INFORMATION_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'License Information:') and contains(.,'${key_licenseInformation}')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_INFORMATION_FIELD</td>
	<td>//textarea[contains(@name,'field--8')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_URL_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Salesforce URL:') and contains(.,'${key_salesforceURL}')]</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_URL_FIELD</td>
	<td>//textarea[contains(@name,'field--9')]</td>
	<td></td>
</tr>
<tr>
	<td>TRAININGS_ATTENDED_ROW</td>
	<td>//div[contains(@class,'customer-info') and contains(.,'Trainings Attended:') and contains(.,'${key_trainingsAttended}')]</td>
	<td></td>
</tr>
<tr>
	<td>TRAININGS_ATTENDED_FIELD</td>
	<td>//textarea[contains(@name,'field--10')]</td>
	<td></td>
</tr>
<tr>
	<td>CEM_CXM_INFO_EDIT_BUTTON</td>
	<td>//div[contains(@id,'contentCemCxmInformation')]//input[@value='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>CEM_CXM_INFO_SAVE_BUTTON</td>
	<td>//div[contains(@id,'contentCemCxmInformation')]//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>CEM_CXM_INFO_CANCEL_BUTTON</td>
	<td>//div[contains(@id,'contentCemCxmInformation')]//input[@value='Cancel']</td>
	<td></td>
</tr>
<!-- Bottom buttons -->
<tr>
	<td>ADD_CALL_LOG_BUTTON</td>
	<td>//input[@value='Add Call Log']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>