<html>
<head>
<title>CreateTicket</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CreateTicket</td></tr>
</thead>
<tbody>
<tr>
	<td>PROJECT_SELECT</td>
	<td>//select[contains(@name,'accountEntryId')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@name,'offeringEntryId')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVED_ENV_CONFIG_SELECT</td>
	<td>//select[contains(@name,'accountEnvironmentId')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_VERSION_SELECT</td>
	<td>//select[contains(@name,'envLFR')]</td>
	<td></td>
</tr>
<tr>
	<td>APPLICATION_SERVER_SELECT</td>
	<td>//select[contains(@name,'envAS')]</td>
	<td></td>
</tr>
<tr>
	<td>OPERATING_SYSTEM_SELECT</td>
	<td>//select[contains(@name,'envOS')]</td>
	<td></td>
</tr>
<tr>
	<td>DATABASE_SELECT</td>
	<td>//select[contains(@name,'envDB')]</td>
	<td></td>
</tr>
<tr>
	<td>JAVA_VIRTUAL_MACHINE_SELECT</td>
	<td>//select[contains(@name,'envJVM')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSER_SELECT</td>
	<td>//select[contains(@name,'envBrowser')]</td>
	<td></td>
</tr>
<tr>
	<td>PORTAL_EXT_CHECKBOX</td>
	<td>//input[contains(@id,'portalExtCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_NEW_PORTAL_EXT_BUTTON</td>
	<td>//a[contains(@id,'selectportalExtFile')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_NEW_PORTAL_EXT_PNG</td>
	<td>/os/buttons/upload_new_button.png</td>
	<td></td>
</tr>
<tr>
	<td>PATCH_LEVEL_CHECKBOX</td>
	<td>//input[contains(@id,'patchLevelCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_NEW_PATCH_LEVEL_BUTTON</td>
	<td>//a[contains(@id,'selectpatchLevelFile')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_SELECT</td>
	<td>//select[contains(@name,'component')]</td>
	<td></td>
</tr>
<tr>
	<td>SYSTEM_STATUS_SELECT</td>
	<td>//select[contains(@name,'systemStatus')]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_FIELD</td>
	<td>//input[contains(@name,'subject')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_FIELD</td>
	<td>//textarea[contains(@name,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_BUTTON</td>
	<td>//input[@value='Create']</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[@value='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>