<html>
<head>
<title>EditTicket</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">EditTicket</td></tr>
</thead>
<tbody>
<tr>
	<td>EDIT_TICKET_IFRAME</td>
	<td>//iframe[contains(@name,'updateTicketEntry')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_TAB</td>
	<td>//span[contains(@id,'ticketDetails')]</td>
	<td></td>
</tr>
<!--Ticket Details -->
<tr>
	<td>SUBJECT_FIELD</td>
	<td>//input[contains(@name,'subject')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_FIELD</td>
	<td>//textarea[contains(@name,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_SELECT</td>
	<td>//select[contains(@name,'component')]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_SELECT</td>
	<td>//select[contains(@name,'status')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[@value='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>