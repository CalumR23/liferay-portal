<html>
<head>
<title>OSBAdminConfiguration</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminConfiguration</td></tr>
</thead>
<tbody>
<tr>
	<td>WRENCH_ICON</td>
	<td>//header//a[contains(@id,'menuButton')]</td>
	<td></td>
</tr>
<tr>
	<td>CONFIGURATION_DROPDOWN_ITEM</td>
	<td>//li[contains(@class,'configuration-icon')]/a[contains(.,'Configuration')]</td>
	<td></td>
</tr>
<tr>
	<td>CONFIGURATION_IFRAME</td>
	<td>//iframe[contains(@id,'configurationIframeDialog')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_IFRAME_BUTTON</td>
	<td>//button[@id='closethick']</td>
	<td></td>
</tr>
<tr>
	<td>CONFIGURATION_TAB</td>
	<td>//ul[contains(@class,'tabview')]//a[text()=' ${key_tab} ']</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_MESSAGE_PRODUCT_SELECT</td>
	<td>//select[contains(@name,'productDisplayName')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_MESSAGE_COMPONENT_SELECT</td>
	<td>//select[contains(@name,'component')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_MESSAGE_MESSAGE_TEXTBOX</td>
	<td>//textarea[contains(@name,'componentMessage')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>