<html>
<head>
<title>LESASearch</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESASearch</td></tr>
</thead>
<tbody>
<tr>
	<td>KEYWORD_FIELD</td>
	<td>//input[contains(@class,'advanced-search keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB</td>
	<td>//span[contains(@id,'tickets')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_COUNT</td>
	<td>//span[contains(@id,'tickets')]/span</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//span[contains(@id,'accounts')]</td>
	<td></td>
</tr>
<tr>
	<td>FEEDBACK_TAB</td>
	<td>//span[contains(@id,'feedback')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNERS_TAB</td>
	<td>//span[contains(@id,'partners')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--TICKETS_TAB-->
<tr>
	<td>TICKETS_TAB_FILTER</td>
	<td>//div[contains(@class,'advanced-search ticket')]//span[contains(.,'${key_filter}')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_CHOOSE_PROJECT_BUTTON</td>
	<td>//div[contains(@class,'advanced-search ticket')]//input[@value='Choose Project']</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_SELECTED_PROJECT</td>
	<td>//span[contains(@id,'accountEntryIdsList')]/span[contains(.,'${key_project}')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_ALL_SELECTED_PROJECTS</td>
	<td>//span[contains(@id,'accountEntryIdsList')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_CHOOSE_PROJECT_TIERS</td>
	<td>//div[contains(@class,'account search')]/div[contains(.,'Project Tiers')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON</td>
	<td>//div[contains(@class,'advanced-search ticket')]//input[@value='Choose Assignee']</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_SELECTED_ASSIGNEE</td>
	<td>//span[contains(@id,'assignedUserIdsList')]/span[contains(.,'${key_assignee}')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_SELECTED_ACCOUNT_WORKER</td>
	<td>//span[contains(@id,'accountWorkersList')]/span[contains(.,'${key_accountWorker}')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON</td>
	<td>//div[contains(@class,'advanced-search ticket')]//input[@value='Choose Project Worker']</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_DATE_RANGES</td>
	<td>//div[contains(@class,'date search')]/div/div[contains(.,'${key_dateRange}')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_SEVERITY</td>
	<td>//div[contains(@class,'severity shown')]/div[contains(.,'Severity')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_ESCALATION_LEVEL</td>
	<td>//div[contains(@class,'severity shown')]/div[contains(.,'Escalation Level')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_STATUS</td>
	<td>//div[contains(@class,'status shown')]/div[contains(.,'Status')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_STATUS_CHECKBOX</td>
	<td>//label[contains(.,'${key_status}')]/input</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_RESOLUTION</td>
	<td>//div[contains(@class,'status shown')]/div[contains(.,'Resolution')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_SEARCH_ATTACHMENTS_CHECKBOX</td>
	<td>//div[contains(@class,'advanced-search ticket')]//input[contains(@name,'searchAttachments')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_TICKET_NUMBER</td>
	<td>//div[contains(@class,'ticket-column number')]/a</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_TAB_TICKET_NUMBER_ARROW_DOWN</td>
	<td>//div[contains(@class,'ticket-column number arrow-down')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!-- RESULT ROW -->
<tr>
	<td>RESULT_ROW_NUMBER</td>
	<td>//div[contains(@class,'number')]/div/span[contains(.,'${key_ticketNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_PROJECT_CODE</td>
	<td>//div[contains(@class,'column code')]/div/span[contains(.,'${key_projectCode}')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_PROJECT_NAME</td>
	<td>//div[contains(@class,'project-name')]/div/span[contains(.,'${key_projectName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!-- RESULT TABLE-->
<tr>
	<td>RESULT_TABLE_PAGE_LINKS</td>
	<td>//div[contains(@class,'page-links')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>