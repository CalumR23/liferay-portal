<html>
<head>
<title>LESATicketComment</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketComment</td></tr>
</thead>
<tbody>
<tr>
	<td>NEW_COMMENT_FIELD</td>
	<td>//textarea[contains(@id,'commentBody0')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_ATTACHMENTS_BUTTON</td>
	<td>//input[contains(@id,'addAttachmentsButton')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_1_BUTTON</td>
	<td>//input[contains(@name,'file0_1')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_2_BUTTON</td>
	<td>//input[contains(@name,'file0_2')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_3_BUTTON</td>
	<td>//input[contains(@name,'file0_3')]</td>
	<td></td>
</tr>
<tr>
	<td>POST_BUTTON</td>
	<td>//input[contains(@id,'addCommentButton0')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_CREATOR</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//div[contains(@class,'user-name')]/span</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_TEXT</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//pre</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_THREE_DOT_MENU</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//span[@class='three-dot-icon']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_THREE_DOT_MENU_ITEM</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//li/a[contains(.,'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_COMMENT_FIELD</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//textarea</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_BUTTON</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//input[@value='Update']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_ATTACHMENT</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//a[contains(@href,'ticketAttachmentId')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_ATTACHMENT_WITHOUT_COMMENT_TEXT</td>
	<td>//div[contains(@id,'commentContainer')]//div[contains(.,'Attachments:')]/div/a[contains(.,'${key_fileName}')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_VISIBILITY</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//div[contains(@class,'visibility')]</td>
	<td></td>
</tr>
<tr>
	<td>SOLUTION_COMMENT_LINK</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'Solution')]//div[contains(.,'Links')]/div/a[contains(.,'${key_url}')]</td>
	<td></td>
</tr>
<tr>
	<td>SOLUTION_COMMENT_FOOTER</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'Solution')]//div[contains(@class,'type-solution')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>