<html>
<head>
<title>OSBAdmin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdmin</td></tr>
</thead>
<tbody>
<tr>
	<td>OSB_ADMIN_TITLE</td>
	<td>//h1[contains(.,'OSB Admin')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//a[contains(.,'Projects')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNERS_TAB</td>
	<td>//a[contains(.,'Partners')]</td>
	<td></td>
</tr>
<tr>
	<td>SALES_TAB</td>
	<td>//ul[contains(@class,'tabview-list')]//a[contains(.,'Sales')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_TAB</td>
	<td>//ul[contains(@class,'tabview-list')]//a[contains(.,'Support')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PROJECT_BUTTON</td>
	<td>//input[@value='Add Project']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PARTNER_BUTTON</td>
	<td>//input[@value='Add Partner']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--BASIC SEARCH-->
<tr>
	<td>BASIC_SEARCH_TOGGLE</td>
	<td>//a[contains(.,'Basic')]</td>
	<td></td>
</tr>
<tr>
	<td>BASIC_SEARCH_KEYWORD_FIELD</td>
	<td>//input[contains(@id,'searchkeywords')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADVANCED SEARCH-->
<tr>
	<td>ADVANCED_SEARCH_TOGGLE</td>
	<td>//a[contains(.,'Advanced')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_SUPPORT_SELECT</td>
	<td>//select[contains(@id,'support')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_HAS_EXPIRED_SUPPORT_SELECT</td>
	<td>//select[contains(@id,'expiredSupport')]</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_STATUS_SELECT</td>
	<td>//select[contains(@id,'statuses')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SEARCH RESULT-->
<tr>
	<td>SEARCH_RESULT_FIRST_ROW_PROJECT_NAME</td>
	<td>//tr[contains(@class,'results-row')]//td[contains(@id,'col-project-name')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_FIRST_ROW_STATUS</td>
	<td>//tr[contains(@class,'results-row')]//td[contains(@id,'col-status')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_FIRST_EXPIRED_PROJECT_NAME</td>
	<td>//tr[contains(@class,'results-row')]//td[contains(@id,'col-status')]/a[text()=' Expired ']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_CODE</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_code}')]//td[contains(@id,'col-code')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_STATUS</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_code}')]//td[contains(@id,'col-status')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_EMAIL</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_code}')]//td[contains(@id,'col-email')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_BUTTON</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_code}')]//a[contains(.,'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_MENU_DELETE</td>
	<td>//a[contains(@id,'menu_delete')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>