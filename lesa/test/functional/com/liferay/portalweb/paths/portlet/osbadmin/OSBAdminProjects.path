<html>
<head>
<title>OSBAdminProjects</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminProjects</td></tr>
</thead>
<tbody>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//a[contains(.,'Projects')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNERS_TAB</td>
	<td>//a[contains(.,'Partners')]</td>
	<td></td>
</tr>
<tr>
	<td>SALES_TAB</td>
	<td>//ul[contains(@class,'tabview-list')]//a[contains(.,'Sales')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_ACCOUNT_BUTTON</td>
	<td>//input[@value='Add Account']</td>
	<td></td>
</tr>
<tr>
	<td>BASIC_SEARCH_TOGGLE</td>
	<td>//a[contains(.,'Basic')]</td>
	<td></td>
</tr>
<tr>
	<td>BASIC_SEARCH_KEYWORD_FIELD</td>
	<td>//input[contains(@id,'searchkeywords')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[@value='Search']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_CODE</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_projectCode}')]//td[contains(@id,'col-code')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_BUTTON</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_projectCode}')]//a[contains(.,'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ACTION_MENU_DELETE</td>
	<td>//a[contains(@id,'menu_delete')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>