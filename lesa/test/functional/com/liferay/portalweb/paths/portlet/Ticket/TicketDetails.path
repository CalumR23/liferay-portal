<html>
<head>
<title>TicketDetails</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">TicketDetails</td></tr>
</thead>
<tbody>
<!-- Header -->
<tr>
	<td>TICKET_NUMBER</td>
	<td>//span[contains(@id,'ticketDisplayId')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY</td>
	<td>//span[contains(@id,'subject')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_ICON</td>
	<td>//img[contains(@id,'componentDisplay')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_TOOLTIP</td>
	<td>//div[contains(@class,'tooltip-content')]/div</td>
	<td></td>
</tr>
<tr>
	<td>STATUS</td>
	<td>//span[contains(@id,'statusLabel')]</td>
	<td></td>
</tr>
<tr>
	<td>THREE_DOT_ICON</td>
	<td>//span[contains(@id,'threeDotIcon')]</td>
	<td></td>
</tr>
<tr>
	<td>THREE_DOT_MENU_ITEM</td>
	<td>//a[contains(.,'${key_menuItem}')]</td>
	<td></td>
</tr>
<!--Top Tier Tabs -->
<tr>
	<td>SUPPORT_INSTRUCTIONS_TAB</td>
	<td>//span[contains(@id,'supportInstructions')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION_TAB</td>
	<td>//span[contains(@id,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_DETAILS_TAB</td>
	<td>//span[contains(@id,'component')]</td>
	<td></td>
</tr>
<tr>
	<td>FEEDBACK_TAB</td>
	<td>//span[contains(@id,'feedback')]</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_TAB</td>
	<td>//span[contains(@id,'attachments')]</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_TAB</td>
	<td>//span[contains(@id,'links')]</td>
	<td></td>
</tr>
<!--Description Tab Content-->
<tr>
	<td>DESCRIPTION_CONTENT</td>
	<td>//div[contains(@id,'description')]/pre</td>
	<td></td>
</tr>
<!--Activation Key Details Tab Content-->
<tr>
	<td>ACTIVATION_KEY_DETAILS_TYPE_OF_KEY</td>
	<td>//div[@class='component-details']//div[contains(@class,'content-column') and contains(.,'Type of Key')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVATION_KEY_DETAILS_PURPOSE</td>
	<td>//div[@class='component-details']//div[contains(@class,'content-column') and contains(.,'Purpose')]</td>
	<td></td>
</tr>
<!--Clustering Details Tab Content-->
<tr>
	<td>CLUSTERING_DETAILS_SERVER_COMMUNICATION_TYPE</td>
	<td>//div[@class='component-details']//div[contains(@class,'content-column') and contains(.,'Server Communication Type')]</td>
	<td></td>
</tr>
<!--Upgrade Details Tab Content-->
<tr>
	<td>UPGRADE_DETAILS_DOCUMENT_PERSISTENCE</td>
	<td>//div[@class='component-details']/div[contains(.,'persist')]</td>
	<td></td>
</tr>
<tr>
	<td>UPGRADE_DETAILS_UPGRADE_STEPS</td>
	<td>//div[@class='component-details']/div[contains(.,'Steps')]/pre</td>
	<td></td>
</tr>
<!-- Links Tab Content-->
<tr>
	<td>LINKS_ROW</td>
	<td>//tr[contains(.,'${key_url}') and contains(.,'${key_visibility}')]</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_URL_LINK</td>
	<td>//a[contains(@href,'${key_url}')]</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_VISIBILITY_LINK</td>
	<td>//a[contains(@href,'${key_url}') and contains(.,'${key_visibility}')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_1_FIELD</td>
	<td>//input[contains(@name,'url1')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_2_FIELD</td>
	<td>//input[contains(@name,'url2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_3_FIELD</td>
	<td>//input[contains(@name,'url3')]</td>
	<td></td>
</tr>
<tr>
	<td>VISIBILITY_SELECT</td>
	<td>//td/select[contains(@name,'visibility')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//form/input[@value='Save']</td>
	<td></td>
</tr>
<!--Lower Tier Tabs -->
<tr>
	<td>PUBLIC_TAB</td>
	<td>//span[contains(@id,'public')]</td>
	<td></td>
</tr>
<tr>
	<td>WORKERS_TAB</td>
	<td>//span[contains(@id,'workers')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_TAB</td>
	<td>//span[contains(@id,'liferay')]</td>
	<td></td>
</tr>
<tr>
	<td>ALL_COMMENTS_TAB</td>
	<td>//span[contains(@id,'all-comments')]</td>
	<td></td>
</tr>
<tr>
	<td>HISTORY_TAB</td>
	<td>//span[contains(@id,'history')]</td>
	<td></td>
</tr>
<tr>
	<td>SOLUTIONS_TAB</td>
	<td>//span[contains(@id,'solutions')]</td>
	<td></td>
</tr>
<!--Right Side Bar-->
<tr>
	<td>ASSIGNEE_NAME</td>
	<td>//div[@class='sidebar']//div[contains(.,'Assignee:')]/span</td>
	<td></td>
</tr>
<tr>
	<td>REPORTER_NAME</td>
	<td>//div[@class='sidebar']//div[contains(.,'Reporter:')]/span</td>
	<td></td>
</tr>
<tr>
	<td>TO_LIFERAY_VERSION</td>
	<td>//div[@class='sub-section last']/div[contains(.,'To')]/span[3]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSER</td>
	<td>//div[@class='sub-section last']/div[contains(.,'BR')]/span[@class='txt-sb']</td>
	<td></td>
</tr>
<!-- Comments -->
<tr>
	<td>NEW_COMMENT_FIELD</td>
	<td>//textarea[contains(@id,'commentBody0')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_ATTACHMENTS_BUTTON</td>
	<td>//input[contains(@id,'addAttachmentsButton')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_1_BUTTON</td>
	<td>//input[contains(@name,'file0_1')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_2_BUTTON</td>
	<td>//input[contains(@name,'file0_2')]</td>
	<td></td>
</tr>
<tr>
	<td>BROWSE_3_BUTTON</td>
	<td>//input[contains(@name,'file0_3')]</td>
	<td></td>
</tr>
<tr>
	<td>POST_BUTTON</td>
	<td>//input[contains(@id,'addCommentButton0')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_CREATOR</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//div[contains(@class,'user-name')]/span</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_TEXT</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//pre</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_ATTACHMENT</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//a[contains(@href,'ticketAttachmentId')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_VISIBILITY</td>
	<td>//div[contains(@id,'commentContainer') and contains(.,'${key_comment}')]//div[contains(@class,'visibility')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>