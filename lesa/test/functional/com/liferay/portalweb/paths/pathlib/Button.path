<html>
<head>
<title>Button</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Button</td></tr>
</thead>
<tbody>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[@value='Cancel']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//input[@value='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_TICKET_BUTTON</td>
	<td>//div[contains(@id,'newTicketIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_BUTTON</td>
	<td>//input[@value='Next']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>SEND_BUTTON</td>
	<td>//input[@value='Send']</td>
	<td></td>
</tr>
<tr>
	<td>LESA_SEARCH_BUTTON</td>
	<td>//div[contains(@id,'advSearchIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[@value='Search']</td>
	<td></td>
</tr>
<tr>
	<td>ADVANCED_SEARCH_BUTTON</td>
	<td>//div[contains(@id,'searchadvanced')]//input[@value='Search']</td>
	<td></td>
</tr>
<tr>
	<td>PREFERENCES_BUTTON</td>
	<td>//div[contains(@id,'settingsIcon')]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>