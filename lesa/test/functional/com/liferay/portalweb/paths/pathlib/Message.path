<html>
<head>
<title>Message</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Message</td></tr>
</thead>
<tbody>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//span[contains(@class,'portlet-msg-error')]</td>
	<td></td>
</tr>
<tr>
	<td>INFO_MESSAGE</td>
	<td>//div[contains(@class,'portlet-msg-info')]</td>
	<td></td>
</tr>
<tr>
	<td>LIMITED_SUPPORT_MESSAGE</td>
	<td>//div[contains(@id,'supportMessageDisplay')]/span[contains(.,'${key_message}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[@class='portlet-msg-success']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>