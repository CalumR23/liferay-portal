@component-name = "support-qa"
definition {

	property group = "3";
	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	var browser = "Firefox";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		if (("${testCaseName}" == "ViewTicketExpiredSupport") || ("${testCaseName}" == "ViewTicketExpiredSupportGracePeriod")) {
			OSBAdminSales.editSupportLifetime(
				product = "Portal Production",
				project = "QA Test Project 2",
				projectCode = "QAPROJECT2",
				supportLifetime = "Indefinite");
		}

		if ("${testCaseName}" == "ViewCreateTicketCustomerMultipleProjects") {
			OSBAdminProject.tearDownAssignedCustomer(
				emailAddress = "${customerEmailAddress}",
				projectCode = "QAPROJECT2");
		}

		LESAUser.logout();
	}

	test AddAndViewComponentDisclaimer {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminConfiguration.addComponentMessage(
			component = "Liferay Developer Studio",
			componentMessage = "QA test component message.",
			product = "Developer Tools");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "Developer Tools");

		LESATicketCreateEntry.selectComponent(component = "Liferay Developer Studio");

		LESATicketView.viewComponentDisclaimerMessage(componentMessage = "QA test component message.");

		LESATicketCreate.cancel();
	}

	test ViewCreateTicket62Environments {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "${product}");

		LESATicketCreateEntry.selectServer(server = "${server}");

		LESATicketCreateEntry.selectComponent(component = "Patch Management");

		LESATicketCreateEntry.selectEnvironmentConfiguration(configuration = "Select New Configuration");

		LESATicketCreateEntry.selectLiferayVersion(liferayVersion = "6.2 EE (Limited)");

		LESATicketCreateView.viewOSDropdownItems(itemList = "AIX 6.1,AIX 7.1,CentOS 5,CentOS 6,Debian 6.0,HP-UX,openSUSE 13.1,Oracle Linux 6,Other,Red Hat Enterprise 5,Red Hat Enterprise 6,Red Hat Enterprise 7,Solaris 10,Solaris 11,SUSE Enterprise Linux 11,Ubuntu 10,Ubuntu 11,Ubuntu 12,Ubuntu 13,Windows Server 2008,Windows Server 2012");

		LESATicketCreateView.viewJVMDropdownItems(itemList = "IBM JDK 6,IBM JDK 7,IBM JDK 8,JRocket JDK 6,Oracle Sun JDK 6,Oracle Sun JDK 7,Oracle Sun JDK 8");

		LESATicketCreateView.viewASDropdownItems(itemList = "Glassfish 3.1,Glassfish 4.0,JBoss AS 7.1,JBoss EAP 5.2,JBoss EAP 6.0,JBoss EAP 6.1,JBoss EAP 6.2,JBoss EAP 6.3,JBoss EAP 6.4,JBoss EAP 6.4,Resin 4.0,Tcat 6.4,Tcat 7.0,tcServer 2.6,tcServer 2.9,Tomcat 6.0,Tomcat 7.0,Weblogic 11g,Weblogic 12c R1,Websphere 7.0,Websphere 8.0,Websphere 8.5");

		LESATicketCreateView.viewDBDropdownItems(itemList = "DB2 10.1,DB2 9.7,MariaDB 10.0,MySQL 5.5,MySQL 5.6,Oracle 10g Release 2,Oracle 11g Release 1,Oracle 11g Release 2,Oracle 12c Release 1,PostgreSQL 8.4,PostgreSQL 9.0,PostgreSQL 9.1,PostgreSQL 9.2,PostgreSQL 9.3,PostgreSQL 9.4,SQL Server 2005,SQL Server 2008,SQL Server 2008 R2,SQL Server 2012,SQL Server 2014,Sybase ASE 15.5,Sybase ASE 15.7");

		LESATicketCreateView.viewBRDropdownItems(itemList = "Android Browser 4.3+,Chrome,Edge,Firefox,IE 6,IE 7,IE 8,IE 9,iOS Safari,Other,Safari 5,Safari 6");

		LESATicketCreateView.viewCSDropdownItems(itemList = "AWS Elastic Compute Cloud,AWS Relational Database Service,AWS S3,Azure Files,Azure SQL Databases,Azure Virtual Machines");

		LESATicketCreateView.viewSHMultiselectItems();

		LESATicketCreate.cancel();
	}

	test ViewCreateTicketCustomerMultipleProjects {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminProject.assignCustomer(
			emailAddress = "${customerEmailAddress}",
			projectCode = "QAPROJECT2",
			role = "Watcher");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "QA Test Project 1");

		LESATicketCreateView.viewWatcherMessage(present = "no");

		LESATicketCreateEntry.selectProject(project = "QA Test Project 2");

		LESATicketCreateView.viewWatcherMessage(present = "yes");

		LESATicketCreateView.assertFormNotLoaded();
	}

	test ViewCreateTicketDXPEnvironments {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "Digital Experience Platform");

		LESATicketCreateEntry.selectServer(server = "Production");

		LESATicketCreateEntry.selectComponent(component = "Patch Management");

		LESATicketCreateEntry.selectEnvironmentConfiguration(configuration = "Select New Configuration");

		LESATicketCreateEntry.selectLiferayVersion(liferayVersion = "7.0");

		LESATicketCreateView.viewOSDropdownItems(itemList = "AIX 7.1,CentOS 6,CentOS 7,Debian 7,Debian 8,Oracle Linux 6,Oracle Linux 7,Red Hat Enterprise 6,Red Hat Enterprise 7,Solaris 10,Solaris 11,SUSE Enterprise Linux 11,SUSE Enterprise Linux 12,Ubuntu LTS 14.04,Windows Server 2012");

		LESATicketCreateView.viewJVMDropdownItems(itemList = "IBM JDK 8,OpenJDK 8,Oracle Sun JDK 8");

		LESATicketCreateView.viewASDropdownItems(itemList = "JBoss EAP 6.4,tcServer 3,Tomcat 8.0,Weblogic 12c R1,Weblogic 12c R2,Websphere 8.5,Wildfly 10.0");

		LESATicketCreateView.viewDBDropdownItems(itemList = "DB2 10.1,DB2 9.7,MariaDB 10.0,MySQL 5.6,MySQL 5.7,Oracle 11g Release 2,Oracle 12c Release 1,PostgreSQL 9.3,PostgreSQL 9.4,SQL Server 2008,SQL Server 2008 R2,SQL Server 2012,Sybase ASE 15.7,Sybase ASE 16");

		LESATicketCreateView.viewBRDropdownItems(itemList = "Chrome,Edge,Firefox,Firefox ESR 45,IE 10,IE 11,IE 9,iOS Safari,Mobile Chrome,Safari 8,Safari 9");

		LESATicketCreateView.viewCSDropdownItems(itemList = "AWS Elastic Compute Cloud,AWS Relational Database Service,AWS S3,Azure Files,Azure SQL Databases,Azure Virtual Machines");

		LESATicketCreateView.viewSHMultiselectItems(itemList = "Elasticsearch 2.x,Elasticsearch 6.x,Kibana 4.x,Kibana 6.x,Marvel 2.x,Shield 2.x,X-Pack 6.x");

		LESATicketCreate.cancel();
	}

	test ViewCreateTicketLiferayVersions {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketView.viewCreateTicketLiferayVersion(
			component = "Document Library",
			product = "Portal",
			project = "${project}",
			server = "${server}");

		LESATicketView.viewCreateTicketLiferayVersion(
			component = "Authentication",
			product = "Digital Experience Platform",
			project = "${project}",
			server = "${server}");

		LESATicketView.viewCreateTicketLiferayVersion(
			component = "BLADE",
			product = "Developer Tools",
			project = "${project}");

		LESATicketView.viewCreateTicketLiferayVersion(
			component = "LCS Client",
			product = "Management Tools (LCS)",
			project = "${project}");

		LESATicketView.viewCreateTicketLiferayVersion(
			component = "Sync Connector",
			product = "Productivity Tools (Sync)",
			project = "${project}");

		LESATicketView.viewCreateTicketLiferayVersion(
			product = "Mobile Device Detection",
			project = "${project}");
	}

	test ViewCreateTicketNonActiveProjects {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		var closedProjectName = OSBAdminProject.getClosedProject();
		var expiredProjectName = OSBAdminProject.getExpiredProject();

		LESANavigation.gotoLESA();

		LESATicketView.viewCreateTicketNonActiveProject(projectName = "${closedProjectName}");

		LESATicketView.viewCreateTicketNonActiveProject(projectName = "${expiredProjectName}");
	}

	test ViewCreateTicketUpgradeDisclaimers {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "QA Test Project 1");

		LESATicketCreateView.viewUpgradePotentialUpgradeDisclaimer();

		LESATicketCreateEntry.selectProduct(product = "Digital Experience Platform");

		LESATicketCreateEntry.selectServer(server = "Production");

		LESATicketCreateEntry.selectComponent(component = "Upgrade");

		LESATicketCreateView.viewUpgradeSavedEnvDisclaimer();

		LESATicketCreateView.viewUpgradeContactProvisioningDisclaimer(present = "no");

		LESATicketCreateEntry.selectProduct(product = "Portal");

		LESATicketCreateView.viewUpgradePotentialUpgradeDisclaimer();

		LESATicketCreateEntry.selectServer(server = "Production");

		LESATicketCreateEntry.selectComponent(component = "Upgrade");

		LESATicketCreateView.viewUpgradeSavedEnvDisclaimer(present = "no");

		LESATicketCreateView.viewUpgradeContactProvisioningDisclaimer(present = "no");

		LESATicketCreateEntry.selectProject(project = "QA Test Project 2");

		LESATicketCreateView.viewUpgradePotentialUpgradeDisclaimer(present = "no");

		LESATicketCreateEntry.selectComponent(component = "Upgrade");

		LESATicketCreateView.viewUpgradeSavedEnvDisclaimer(present = "no");

		LESATicketCreateView.viewUpgradeContactProvisioningDisclaimer();
	}

	test ViewCreateTicketUpgradeToVersion {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketView.viewCreateTicketUpgradeToVersion(
			liferayVersion = "6.1 GA3 (Limited)",
			product = "${product}",
			project = "${project}",
			server = "${server}");

		LESATicketView.viewCreateTicketUpgradeToVersion(
			liferayVersion = "6.2 EE (Limited)",
			product = "${product}",
			project = "${project}",
			server = "${server}");

		LESATicketView.viewCreateTicketUpgradeToVersion(
			liferayVersion = "7.0",
			product = "Digital Experience Platform",
			project = "QA Test Project 1",
			server = "Production");
	}

	test ViewProjectAsPartner {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "Firefox",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for navigating to Project view from Ticket view as a partner.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test View Project As Partner",
			systemStatus = "Functioning with Limited Capabilities");

		LESAProjectView.viewProject(project = "${project}");
	}

	test ViewTicketExpiredSupport {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminSales.editSupportLifetime(
			numDays = "-30",
			product = "Portal Production",
			project = "QA Test Project 2",
			projectCode = "QAPROJECT2",
			supportLifetime = "1 Minute");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.searchByKeyword(keyword = "QAPROJECT2");

		LESASearch.gotoSearchResultTicket(ticketNumber = "QAPROJECT2");

		LESATicketView.viewExpiredSupportLabel();
	}

	test ViewTicketExpiredSupportGracePeriod {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminSales.editSupportLifetime(
			numDays = "-29",
			product = "Portal Production",
			project = "QA Test Project 2",
			projectCode = "QAPROJECT2",
			supportLifetime = "1 Minute");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.searchByKeyword(keyword = "QAPROJECT2");

		LESASearch.gotoSearchResultTicket(ticketNumber = "QAPROJECT2");

		LESATicketView.viewExpiredSupportLabelNotPresent();
	}

}