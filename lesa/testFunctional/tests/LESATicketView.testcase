<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="3" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />

	<var name="browser" value="Firefox" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseNamespacedClassCommandName">
			<return name="testCaseCommandName" />
		</execute>

		<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<if>
			<or>
				<equals arg1="${testCaseName}" arg2="ViewTicketExpiredSupport" />
				<equals arg1="${testCaseName}" arg2="ViewTicketExpiredSupportGracePeriod" />
			</or>
			<then>
				<execute macro="OSBAdminSales#editSupportLifetime">
					<var name="product" value="Portal Production" />
					<var name="project" value="QA Test Project 2" />
					<var name="projectCode" value="QAPROJECT2" />
					<var name="supportLifetime" value="Indefinite" />
				</execute>
			</then>
		</if>

		<if>
			<equals arg1="${testCaseName}" arg2="ViewCreateTicketCustomerMultipleProjects" />
			<then>
				<execute macro="OSBAdminProject#tearDownAssignedCustomer">
					<var name="emailAddress" value="${customerEmailAddress}" />
					<var name="projectCode" value="QAPROJECT2" />
				</execute>
			</then>
		</if>

		<execute macro="LESAUser#logout" />
	</tear-down>

	<command name="AddAndViewComponentDisclaimer">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminConfiguration#addComponentMessage">
			<var name="component" value="Liferay Developer Studio" />
			<var name="componentMessage" value="QA test component message." />
			<var name="product" value="Developer Tools" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Developer Tools" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Liferay Developer Studio" />
		</execute>

		<execute macro="LESATicketView#viewComponentDisclaimerMessage">
			<var name="componentMessage" value="QA test component message." />
		</execute>

		<execute macro="LESATicketCreate#cancel" />
	</command>

	<command name="ViewCreateTicket62Environments">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="${product}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Patch Management" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectEnvironmentConfiguration">
			<var name="configuration" value="Select New Configuration" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectLiferayVersion">
			<var name="liferayVersion" value="6.2 EE (Limited)" />
		</execute>

		<execute macro="LESATicketCreateView#viewOSDropdownItems">
			<var name="itemList" value="AIX 6.1,AIX 7.1,CentOS 5,CentOS 6,Debian 6.0,HP-UX,openSUSE 13.1,Oracle Linux 6,Other,Red Hat Enterprise 5,Red Hat Enterprise 6,Red Hat Enterprise 7,Solaris 10,Solaris 11,SUSE Enterprise Linux 11,Ubuntu 10,Ubuntu 11,Ubuntu 12,Ubuntu 13,Windows Server 2008,Windows Server 2012" />
		</execute>

		<execute macro="LESATicketCreateView#viewJVMDropdownItems">
			<var name="itemList" value="IBM JDK 6,IBM JDK 7,Java 6,Java 7,Java 8,JRocket JDK 6" />
		</execute>

		<execute macro="LESATicketCreateView#viewASDropdownItems">
			<var name="itemList" value="Glassfish 3.1,Glassfish 4.0,JBoss AS 7.1,JBoss EAP 5.2,JBoss EAP 6.0,JBoss EAP 6.1,JBoss EAP 6.2,JBoss EAP 6.3,JBoss EAP 6.4,JBoss EAP 6.4,Resin 4.0,Tcat 6.4,Tcat 7.0,tcServer 2.6,tcServer 2.9,Tomcat 6.0,Tomcat 7.0,Weblogic 11g,Weblogic 12c R1,Websphere 7.0,Websphere 8.0,Websphere 8.5" />
		</execute>

		<execute macro="LESATicketCreateView#viewDBDropdownItems">
			<var name="itemList" value="DB2 10.1,DB2 9.7,MariaDB 10.0,MySQL 5.5,MySQL 5.6,Oracle 10g Release 2,Oracle 11g Release 1,Oracle 11g Release 2,Oracle 12c Release 1,PostgreSQL 8.4,PostgreSQL 9.0,PostgreSQL 9.1,PostgreSQL 9.2,PostgreSQL 9.3,PostgreSQL 9.4,SQL Server 2005,SQL Server 2008,SQL Server 2008 R2,SQL Server 2012,SQL Server 2014,Sybase ASE 15.5,Sybase ASE 15.7" />
		</execute>

		<execute macro="LESATicketCreateView#viewBRDropdownItems">
			<var name="itemList" value="Android Browser 4.3+,Chrome,Edge,Firefox,IE 6,IE 7,IE 8,IE 9,iOS Safari,Other,Safari 5,Safari 6" />
		</execute>

		<execute macro="LESATicketCreateView#viewCSDropdownItems">
			<var name="itemList" value="AWS Elastic Compute Cloud,AWS Relational Database Service,AWS S3,Azure Files,Azure SQL Databases,Azure Virtual Machines" />
		</execute>

		<execute macro="LESATicketCreateView#viewSHMultiselectItems" />

		<execute macro="LESATicketCreate#cancel" />
	</command>

	<command name="ViewCreateTicketCustomerMultipleProjects">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${customerEmailAddress}" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="role" value="Watcher" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 1" />
		</execute>

		<execute macro="LESATicketCreateView#viewWatcherMessage">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 2" />
		</execute>

		<execute macro="LESATicketCreateView#viewWatcherMessage">
			<var name="present" value="yes" />
		</execute>

		<execute macro="LESATicketCreateView#assertFormNotLoaded" />
	</command>

	<command name="ViewCreateTicketDXPEnvironments">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Digital Experience Platform" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="Production" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Patch Management" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectEnvironmentConfiguration">
			<var name="configuration" value="Select New Configuration" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectLiferayVersion">
			<var name="liferayVersion" value="7.0" />
		</execute>

		<execute macro="LESATicketCreateView#viewOSDropdownItems">
			<var name="itemList" value="AIX 7.1,CentOS 6,CentOS 7,Debian 7,Debian 8,Oracle Linux 6,Oracle Linux 7,Red Hat Enterprise 6,Red Hat Enterprise 7,Solaris 10,Solaris 11,SUSE Enterprise Linux 11,SUSE Enterprise Linux 12,Ubuntu LTS 14.04,Windows Server 2012" />
		</execute>

		<execute macro="LESATicketCreateView#viewJVMDropdownItems">
			<var name="itemList" value="IBM JDK 8,Java 8" />
		</execute>

		<execute macro="LESATicketCreateView#viewASDropdownItems">
			<var name="itemList" value="JBoss EAP 6.4,tcServer 3,Tomcat 8.0,Weblogic 12c R1,Weblogic 12c R2,Websphere 8.5,Wildfly 10.0" />
		</execute>

		<execute macro="LESATicketCreateView#viewDBDropdownItems">
			<var name="itemList" value="DB2 10.1,DB2 9.7,MariaDB 10.0,MySQL 5.6,MySQL 5.7,Oracle 11g Release 2,Oracle 12c Release 1,PostgreSQL 9.3,PostgreSQL 9.4,SQL Server 2008,SQL Server 2008 R2,SQL Server 2012,Sybase ASE 15.7,Sybase ASE 16" />
		</execute>

		<execute macro="LESATicketCreateView#viewBRDropdownItems">
			<var name="itemList" value="Chrome,Edge,Firefox,Firefox ESR 45,IE 10,IE 11,IE 9,iOS Safari,Mobile Chrome,Safari 8,Safari 9" />
		</execute>

		<execute macro="LESATicketCreateView#viewCSDropdownItems">
			<var name="itemList" value="AWS Elastic Compute Cloud,AWS Relational Database Service,AWS S3,Azure Files,Azure SQL Databases,Azure Virtual Machines" />
		</execute>

		<execute macro="LESATicketCreateView#viewSHMultiselectItems">
			<var name="itemList" value="Elasticsearch 2.x,Elasticsearch 6.x,Kibana 4.x,Kibana 6.x,Marvel 2.x,Shield 2.x,X-Pack 6.x" />
		</execute>

		<execute macro="LESATicketCreate#cancel" />
	</command>

	<command name="ViewCreateTicketLiferayVersions">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Document Library" />
			<var name="product" value="Portal" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Authentication" />
			<var name="product" value="Digital Experience Platform" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="BLADE" />
			<var name="product" value="Developer Tools" />
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="LCS Client" />
			<var name="product" value="Management Tools (LCS)" />
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="component" value="Sync Connector" />
			<var name="product" value="Productivity Tools (Sync)" />
			<var name="project" value="${project}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketLiferayVersion">
			<var name="product" value="Mobile Device Detection" />
			<var name="project" value="${project}" />
		</execute>
	</command>

	<command name="ViewCreateTicketNonActiveProjects">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminProject#getClosedProject">
			<return from="closedProjectName" name="closedProjectName" />
		</execute>

		<execute macro="OSBAdminProject#getExpiredProject">
			<return from="expiredProjectName" name="expiredProjectName" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketView#viewCreateTicketNonActiveProject">
			<var name="projectName" value="${closedProjectName}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketNonActiveProject">
			<var name="projectName" value="${expiredProjectName}" />
		</execute>
	</command>

	<command name="ViewCreateTicketUpgradeDisclaimers">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 1" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradePotentialUpgradeDisclaimer" />

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Digital Experience Platform" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="Production" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Upgrade" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradeSavedEnvDisclaimer" />

		<execute macro="LESATicketCreateView#viewUpgradeContactProvisioningDisclaimer">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Portal" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradePotentialUpgradeDisclaimer" />

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="Production" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Upgrade" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradeSavedEnvDisclaimer">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradeContactProvisioningDisclaimer">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 2" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradePotentialUpgradeDisclaimer">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Upgrade" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradeSavedEnvDisclaimer">
			<var name="present" value="no" />
		</execute>

		<execute macro="LESATicketCreateView#viewUpgradeContactProvisioningDisclaimer" />
	</command>

	<command name="ViewCreateTicketUpgradeToVersion">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketUpgradeToVersion">
			<var name="liferayVersion" value="6.1 GA3 (Limited)" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketUpgradeToVersion">
			<var name="liferayVersion" value="6.2 EE (Limited)" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
		</execute>

		<execute macro="LESATicketView#viewCreateTicketUpgradeToVersion">
			<var name="liferayVersion" value="7.0" />
			<var name="product" value="Digital Experience Platform" />
			<var name="project" value="QA Test Project 1" />
			<var name="server" value="Production" />
		</execute>
	</command>

	<command name="ViewProjectAsPartner">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="Firefox" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for navigating to Project view from Ticket view as a partner." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE (Limited)" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View Project As Partner" />
			<var name="systemStatus" value="Functioning with Limited Capabilities" />
		</execute>

		<execute macro="LESAProjectView#viewProject">
			<var name="project" value="${project}" />
		</execute>
	</command>

	<command name="ViewTicketExpiredSupport">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminSales#editSupportLifetime">
			<var name="numDays" value="-30" />
			<var name="product" value="Portal Production" />
			<var name="project" value="QA Test Project 2" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="supportLifetime" value="1 Minute" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESASearch" />

		<execute macro="LESASearch#searchByKeyword">
			<var name="keyword" value="QAPROJECT2" />
		</execute>

		<execute macro="LESASearch#gotoSearchResultTicket">
			<var name="ticketNumber" value="QAPROJECT2" />
		</execute>

		<execute macro="LESATicketView#viewExpiredSupportLabel" />
	</command>

	<command name="ViewTicketExpiredSupportGracePeriod">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminSales#editSupportLifetime">
			<var name="numDays" value="-29" />
			<var name="product" value="Portal Production" />
			<var name="project" value="QA Test Project 2" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="supportLifetime" value="1 Minute" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESASearch" />

		<execute macro="LESASearch#searchByKeyword">
			<var name="keyword" value="QAPROJECT2" />
		</execute>

		<execute macro="LESASearch#gotoSearchResultTicket">
			<var name="ticketNumber" value="QAPROJECT2" />
		</execute>

		<execute macro="LESATicketView#viewExpiredSupportLabelNotPresent" />
	</command>
</definition>