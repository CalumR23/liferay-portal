@component-name = "support-qa"
definition {

	property group = "2";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var cseName = PropsUtil.get("lesa.cse.name.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerName = PropsUtil.get("lesa.customer.name.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var managerEmailAddress = PropsUtil.get("lesa.email.address.2");
	var managerName = PropsUtil.get("lesa.manager.name.2");
	var managerPassword = PropsUtil.get("lesa.email.password.2");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerName = PropsUtil.get("lesa.partner.name.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	var browser = "Firefox";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	test AcceptLiferaySolution {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for accepting a liferay proposed solution.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Accept Liferay Solution",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(
			fileName1 = "Document_1.txt",
			fileName2 = "Document_2.txt",
			solutionDescription = "This is a QA test solution.",
			url1 = "http://google.com",
			url2 = "http://yahoo.com",
			urlType1 = "Community Resource",
			urlType2 = "Community Resource");

		LESATicketSolution.viewProposedSolution(
			fileNames = "Document_1.txt,Document_2.txt",
			issueSummary = "QA Test for accepting a liferay proposed solution.",
			solutionDescription = "This is a QA test solution.",
			urls = "http://google.com,http://yahoo.com");

		LESATicketSolution.viewProposedSolutionPublicComment(
			fileNames = "Document_1.txt,Document_2.txt",
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${managerName}",
			urls = "http://google.com,http://yahoo.com");

		LESATicketSolution.viewProposedSolutionComment(
			fileNames = "Document_1.txt,Document_2.txt",
			issueSummary = "QA Test for accepting a liferay proposed solution.",
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${managerName}",
			url1 = "http://google.com",
			url2 = "http://yahoo.com",
			urlType1 = "Community Resource",
			urlType2 = "Community Resource");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();

		LESAUser.logout();
	}

	test AcceptPartnerSolution {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Tomcat 7.0",
			browser = "${browser}",
			component = "Document Library",
			configType = "new",
			database = "MySQL 5.5",
			description = "QA Test for accepting a Partner proposed solution.",
			javaVM = "IBM JDK 8",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 13",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Accept Partner Solution",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(
			fileName = "Document_1.txt",
			solutionDescription = "This is a QA test solution.",
			url = "http://google.com",
			urlType = "Community Resource");

		LESATicketSolution.viewProposedSolution(
			fileNames = "Document_1.txt",
			issueSummary = "QA Test for accepting a Partner proposed solution.",
			solutionDescription = "This is a QA test solution.");

		LESATicketSolution.viewProposedSolutionPublicComment(
			fileNames = "Document_1.txt",
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${partnerName}");

		LESATicketSolution.viewProposedSolutionComment(
			fileNames = "Document_1.txt",
			issueSummary = "QA Test for accepting a Partner proposed solution.",
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${partnerName}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();

		LESAUser.logout();
	}

	test CommentOnSolutionDeliveredTicket {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for commenting on a ticket with Solution Delivered status.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Comment On Solution Delivered Ticket",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.assignWorker(
			emailAddress = "${cseEmailAddress}",
			name = "${cseName}",
			role = "Developer");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(
			fileName = "Document_1.txt",
			solutionDescription = "This is a QA test solution.");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Solution Proposed",
			newStatus = "Solution Delivered");

		LESATicketComment.addComment(
			comment = "This is a QA test comment.",
			commentType = "Public");

		LESATicketView.viewTicketStatus(status = "Solution Delivered");

		LESATicketComment.addComment(
			comment = "This is a QA test comment.",
			commentType = "Worker");

		LESATicketView.viewTicketStatus(status = "Solution Delivered");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketComment.addComment(comment = "This is a QA test comment.");

		LESATicketView.viewTicketStatus(status = "Solution Proposed");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESAHomepage.viewTicketPrimaryAssignment(ticketNumber = "${ticketNumber}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Solution Proposed",
			newStatus = "Solution Delivered");

		LESATicketComment.addComment(
			comment = "This is a QA test comment.",
			commentType = "Public");

		LESATicketView.viewTicketStatus(status = "Solution Proposed");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Solution Proposed",
			newStatus = "Solution Delivered");

		LESATicketComment.addComment(
			comment = "This is a QA test comment.",
			commentType = "Worker");

		LESATicketView.viewTicketStatus(status = "Solution Proposed");

		LESAUser.logout();
	}

	test RejectLiferaySolution {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for rejecting a Liferay proposed solution.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Reject Liferay Solution",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(solutionDescription = "This is a QA test solution.");

		LESATicketSolution.viewProposedSolution(solutionDescription = "This is a QA test solution.");

		LESATicketSolution.viewProposedSolutionPublicComment(
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${managerName}");

		LESATicketSolution.viewProposedSolutionComment(
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${managerName}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.rejectSolution(
			explanation = "Plugin not registering.",
			reason = "The fix did not deploy.");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketSolution.viewRejectedSolutionComment(
			explanation = "Plugin not registering.",
			reason = "The fix did not deploy.",
			rejecter = "${customerName}");

		LESAUser.logout();
	}

	test RejectPartnerSolution {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Tomcat 7.0",
			browser = "${browser}",
			component = "Document Library",
			configType = "new",
			database = "MySQL 5.5",
			description = "QA Test for rejecting a Partner proposed solution.",
			javaVM = "IBM JDK 8",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 13",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Reject Partner Solution",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(solutionDescription = "This is a QA test solution.");

		LESATicketSolution.viewProposedSolution(solutionDescription = "This is a QA test solution.");

		LESATicketSolution.viewProposedSolutionPublicComment(
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${partnerName}");

		LESATicketSolution.viewProposedSolutionComment(
			solutionDescription = "This is a QA test solution.",
			solutionProposer = "${partnerName}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.rejectSolution(
			explanation = "Plugin not registering.",
			reason = "The fix did not deploy.");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketSolution.viewRejectedSolutionComment(
			explanation = "Plugin not registering.",
			reason = "The fix did not deploy.",
			rejecter = "${customerName}");

		LESAUser.logout();
	}

}