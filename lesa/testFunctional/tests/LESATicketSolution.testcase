<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="2" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="cseName" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.customer.name.4')" name="customerName" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.2')" name="managerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.manager.name.2')" name="managerName" />
	<var method="TestPropsUtil#get('lesa.email.password.2')" name="managerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.partner.name.6')" name="partnerName" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />

	<var name="browser" value="Firefox" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<command name="AcceptLiferaySolution">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for accepting a liferay proposed solution." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Accept Liferay Solution" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="fileName1" value="Document_1.txt" />
			<var name="fileName2" value="Document_2.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="url1" value="http://google.com" />
			<var name="url2" value="http://yahoo.com" />
			<var name="urlType1" value="Community Resource" />
			<var name="urlType2" value="Community Resource" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolution">
			<var name="fileNames" value="Document_1.txt,Document_2.txt" />
			<var name="issueSummary" value="QA Test for accepting a liferay proposed solution." />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="urls" value="http://google.com,http://yahoo.com" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionPublicComment">
			<var name="fileNames" value="Document_1.txt,Document_2.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${managerName}" />
			<var name="urls" value="http://google.com,http://yahoo.com" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionComment">
			<var name="fileNames" value="Document_1.txt,Document_2.txt" />
			<var name="issueSummary" value="QA Test for accepting a liferay proposed solution." />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${managerName}" />
			<var name="url1" value="http://google.com" />
			<var name="url2" value="http://yahoo.com" />
			<var name="urlType1" value="Community Resource" />
			<var name="urlType2" value="Community Resource" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />

		<execute macro="LESAUser#logout" />
	</command>

	<command name="AcceptPartnerSolution">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Tomcat 7.0" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="new" />
			<var name="database" value="MySQL 5.5" />
			<var name="description" value="QA Test for accepting a Partner proposed solution." />
			<var name="javaVM" value="Java 7" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 13" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Accept Partner Solution" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="fileName" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="url" value="http://google.com" />
			<var name="urlType" value="Community Resource" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolution">
			<var name="fileNames" value="Document_1.txt" />
			<var name="issueSummary" value="QA Test for accepting a Partner proposed solution." />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionPublicComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${partnerName}" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="issueSummary" value="QA Test for accepting a Partner proposed solution." />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${partnerName}" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />

		<execute macro="LESAUser#logout" />
	</command>

	<command name="CommentOnSolutionDeliveredTicket">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for commenting on a ticket with Solution Delivered status." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Comment On Solution Delivered Ticket" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#assignWorker">
			<var name="emailAddress" value="${cseEmailAddress}" />
			<var name="name" value="${cseName}" />
			<var name="role" value="Developer" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="fileName" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Solution Proposed" />
			<var name="newStatus" value="Solution Delivered" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test comment." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Delivered" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test comment." />
			<var name="commentType" value="Worker" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Delivered" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test comment." />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Proposed" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESAHomepage#viewTicketPrimaryAssignment">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Solution Proposed" />
			<var name="newStatus" value="Solution Delivered" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test comment." />
			<var name="commentType" value="Public" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Proposed" />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Solution Proposed" />
			<var name="newStatus" value="Solution Delivered" />
		</execute>

		<execute macro="LESATicketComment#addComment">
			<var name="comment" value="This is a QA test comment." />
			<var name="commentType" value="Worker" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Solution Proposed" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>

	<command name="RejectLiferaySolution">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for rejecting a Liferay proposed solution." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Reject Liferay Solution" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="fileName" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolution">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionPublicComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${managerName}" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${managerName}" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#rejectSolution" >
			<var name="explanation" value="Plugin not registering." />
			<var name="reason" value="The fix did not deploy." />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketSolution#viewRejectedSolutionComment">
			<var name="explanation" value="Plugin not registering." />
			<var name="reason" value="The fix did not deploy." />
			<var name="rejecter" value="${customerName}" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>

	<command name="RejectPartnerSolution">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Tomcat 7.0" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="new" />
			<var name="database" value="MySQL 5.5" />
			<var name="description" value="QA Test for rejecting a Partner proposed solution." />
			<var name="javaVM" value="Java 7" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 13" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Reject Partner Solution" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="fileName" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolution">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionPublicComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${partnerName}" />
		</execute>

		<execute macro="LESATicketSolution#viewProposedSolutionComment">
			<var name="fileNames" value="Document_1.txt" />
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="solutionProposer" value="${partnerName}" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#rejectSolution" >
			<var name="explanation" value="Plugin not registering." />
			<var name="reason" value="The fix did not deploy." />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketSolution#viewRejectedSolutionComment">
			<var name="explanation" value="Plugin not registering." />
			<var name="reason" value="The fix did not deploy." />
			<var name="rejecter" value="${customerName}" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>
</definition>