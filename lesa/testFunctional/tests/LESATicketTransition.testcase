@component-name = "support-qa"
definition {

	property group = "2";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var managerEmailAddress = PropsUtil.get("lesa.email.address.2");
	var managerName = PropsUtil.get("lesa.manager.name.2");
	var managerPassword = PropsUtil.get("lesa.email.password.2");
	var browser = "Firefox";
	var component = "Document Library";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	test CompleteAllWorkflowSteps {
		property lesa.acceptance = "true";

		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for transitioning a ticket through every step of workflow.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Complete All Workflow Steps",
			systemStatus = "${systemStatus}");

		LESATicketView.viewTicketStatus(status = "Open");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.workflowTicket(workflowStep = "Diagnose");

		LESATicketView.viewTicketStatus(status = "In Diagnosis");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "In Diagnosis",
			newStatus = "On Hold");

		LESATicketTransition.workflowTicket(workflowStep = "Resume");

		LESATicketTransition.reproduceSteps(steps = "Ticket reproduction steps here...");

		LESATicketView.viewTicketStatus(status = "Resolution Planning");

		LESATicketTransition.workflowTicket(workflowStep = "Propose Solution");

		LESATicketSolution.proposeSolution(
			solutionDescription = "Test solution",
			subcomponent = "Cookies");

		LESATicketView.viewTicketStatus(status = "Solution Proposed");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Solution Proposed",
			newStatus = "Solution Delivered");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();
	}

	test CompleteTicketClosedPendingCustomer {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "${component}",
			configType = "saved",
			description = "QA Test for completing a ticket with status Closed (Pending Customer).",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Complete Ticket Closed Pending Customer",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Open",
			newStatus = "Closed",
			resolution = "Pending Customer");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketTransition.completeTicket();

		LESAUser.logout();
	}

	test ForwardTicket {
		property lesa.acceptance = "true";

		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "${component}",
			configType = "saved",
			description = "QA Test for forwarding a ticket.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Forward Ticket",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.assignWorker(
			emailAddress = "${managerEmailAddress}",
			name = "${managerName}",
			role = "Manager");

		LESATicketTransition.forwardTicket(
			customerNextSteps = "Customer next steps.",
			mainGoal = "Main goal.",
			name = "${managerName}",
			nextRegionNextSteps = "Next region next steps.",
			workDone = "Work done.");

		LESAUser.logout();
	}

}