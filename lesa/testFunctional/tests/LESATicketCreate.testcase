<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="lesa.acceptance" value="true" />
	<property name="group" value="1" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.8')" name="cwatcherEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.8')" name="cwatcherPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.9')" name="pwatcherEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.9')" name="pwatcherPassword" />
	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="reporterName" />

	<var name="browser" value="Firefox" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<tear-down>
		<execute macro="LESAUser#logout" />
	</tear-down>

	<command name="CreateTicketAsCustomerDeveloper">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Patch Management" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket as a customer developer." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="Production" />
			<var name="summary" value="QA Test Create Ticket As Customer Developer" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="1" />
		</execute>
	</command>

	<command name="CreateTicketAsCustomerWatcher">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cwatcherEmailAddress}" />
			<var name="userPassword" value="${cwatcherPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateView#viewWatcherMessage">
			<var name="present" value="yes" />
		</execute>
	</command>

	<command name="CreateTicketAsPartnerManager">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Project Administration" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket as a partner manager." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Create Ticket As Partner Manager" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="1" />
		</execute>
	</command>

	<command name="CreateTicketAsPartnerWatcher">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${pwatcherEmailAddress}" />
			<var name="userPassword" value="${pwatcherPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateView#viewWatcherMessage">
			<var name="present" value="yes" />
		</execute>
	</command>

	<command name="CreateTicketComponentActivationKey">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Activation Key" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Activation Key component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Activation Key" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketCreate#inputActivationKeyDetails">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />

		<execute macro="LESAMessage#success" />

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="1" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Activation Key component." />
		</execute>

		<execute macro="LESATicketView#viewActivationKeyDetails">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>
	</command>

	<command name="CreateTicketComponentClustering">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Clustering" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Clustering component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Clustering" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketCreate#inputClusteringDetails">
			<var name="serverCommunicationType" value="Multicast" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />

		<execute macro="LESAMessage#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="${browser}" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Clustering component." />
		</execute>

		<execute macro="LESATicketView#viewClusteringDetails">
			<var name="serverCommunicationType" value="Multicast" />
		</execute>

		<execute macro="LESATicketView#viewAttachment">
			<var name="attachedBy" value="${reporterName}" />
			<var name="fileName" value="Document_1.txt" />
		</execute>

		<execute macro="LESATicketView#viewAttachment">
			<var name="attachedBy" value="${reporterName}" />
			<var name="fileName" value="Document_2.txt" />
		</execute>
	</command>

	<command name="CreateTicketComponentLCS">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Liferay Connected Services" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket with LCS component." />
			<var name="javaVM" value="Java 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="operatingSystem" value="Solaris 11" />
			<var name="product" value="Management Tools (LCS)" />
			<var name="project" value="${project}" />
			<var name="subcomponent" value="Subscription Management" />
			<var name="summary" value="QA Test LCS" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Liferay Connected Services" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Liferay Connected Services" />
		</execute>

		<execute macro="LESATicketView#viewSubcomponent">
			<var name="subcomponent" value="Subscription Management" />
		</execute>
	</command>

	<command name="CreateTicketComponentLiferayFaces">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Liferay Faces" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Liferay Faces component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Create Ticket Component Liferay Faces" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="P1" />
		</execute>
	</command>

	<command name="CreateTicketComponentLiferaySync">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Liferay Sync" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Liferay Sync component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Create Ticket Component Liferay Sync" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="P1" />
		</execute>
	</command>

	<command name="CreateTicketComponentUpgrade">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Upgrade" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with Upgrade component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Upgrade" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketCreate#inputUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="toLiferayVersion" value="Other" />
			<var name="upgradeSteps" value="Test upgrade steps" />
			<var name="upload" value="yes" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />

		<execute macro="LESAMessage#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="${browser}" />
			<var name="reporterName" value="${reporterName}" />
			<var name="toLiferayVersion" value="Other" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with Upgrade component." />
		</execute>

		<execute macro="LESATicketView#viewUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>
	</command>

	<command name="CreateTicketComponentUpgradeDXP">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Upgrade" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating an Upgrade ticket for DXP." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Upgrade DXP" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketCreate#inputUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="fromLiferayVersion" value="6.2 EE" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>

		<execute macro="LESATicketCreate#createTicket" />

		<execute macro="LESAMessage#success" />

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="${browser}" />
			<var name="fromLiferayVersion" value="6.2 EE" />
			<var name="reporterName" value="${reporterName}" />
			<var name="toLiferayVersion" value="7.0" />
		</execute>

		<execute macro="LESATicketView#viewUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>
	</command>

	<command name="CreateTicketLongSummary">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket a long summary.  Summary field should only allow up to 255 characters.  * is the 255th character in the summary." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*sttesttest" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewSummary">
			<var name="summary" value="QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="P1" />
		</execute>
	</command>

	<command name="CreateTicketNewConfig">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket with a new environment configuration." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test New Config" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="${browser}" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with a new environment configuration." />
		</execute>
	</command>

	<command name="CreateTicketProductDeviceRecognition">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket with Mobile Device Detection product." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Mobile Device Detection" />
			<var name="project" value="${project}" />
			<var name="summary" value="QA Test Mobile Device Detection Product" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Mobile Device Detection" />
		</execute>
	</command>

	<command name="CreateTicketProductDigitalEnterprise">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Tomcat 8.0" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="MySQL 5.6" />
			<var name="description" value="QA Test for creating a ticket with a DE product." />
			<var name="javaVM" value="Java 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="operatingSystem" value="Debian 8" />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="server" value="Non-Production" />
			<var name="summary" value="QA Test Create Ticket DE Product" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="product" value="Digital Enterprise Non-Production" />
		</execute>
	</command>

	<command name="CreateTicketProductEnterpriseSearch">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket with Enterprise Search product." />
			<var name="javaVM" value="Java 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="operatingSystem" value="Oracle Linux 7" />
			<var name="product" value="Enterprise Search Standard" />
			<var name="project" value="${project}" />
			<var name="server" value="Any" />
			<var name="summary" value="QA Test Enterprise Search Product" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Enterprise Search" />
		</execute>
	</command>

	<command name="CreateTicketProductSocialOffice">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for creating a ticket with SO product." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="3.1.1" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="Social Office" />
			<var name="project" value="${project}" />
			<var name="summary" value="QA Test SO Product" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Social Office" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="P1" />
		</execute>
	</command>

	<command name="CreateTicketSavedConfig">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for creating a ticket with a saved environment configuration." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Saved Config" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="browser" value="${browser}" />
			<var name="reporterName" value="${reporterName}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for creating a ticket with a saved environment configuration." />
		</execute>
	</command>
</definition>