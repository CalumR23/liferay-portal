@component-name = "support-qa"
definition {

	property group = "1";
	property lesa.acceptance = "true";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var cwatcherEmailAddress = PropsUtil.get("lesa.email.address.8");
	var cwatcherPassword = PropsUtil.get("lesa.email.password.8");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	var pwatcherEmailAddress = PropsUtil.get("lesa.email.address.9");
	var pwatcherPassword = PropsUtil.get("lesa.email.password.9");
	var reporterName = PropsUtil.get("lesa.cse.name.1");
	var browser = "Firefox";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	tearDown {
		LESAUser.logout();
	}

	test CreateTicketAsCustomerDeveloper {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Patch Management",
			configType = "saved",
			description = "QA Test for creating a ticket as a customer developer.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "Production",
			summary = "QA Test Create Ticket As Customer Developer",
			systemStatus = "${systemStatus}");

		LESATicketView.viewEscalation(escalation = "1");
	}

	test CreateTicketAsCustomerWatcher {
		LESAUser.login(
			userEmailAddress = "${cwatcherEmailAddress}",
			userPassword = "${cwatcherPassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateView.viewWatcherMessage(present = "yes");
	}

	test CreateTicketAsPartnerManager {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Project Administration",
			configType = "saved",
			description = "QA Test for creating a ticket as a partner manager.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Create Ticket As Partner Manager",
			systemStatus = "${systemStatus}");

		LESATicketView.viewEscalation(escalation = "1");
	}

	test CreateTicketAsPartnerWatcher {
		LESAUser.login(
			userEmailAddress = "${pwatcherEmailAddress}",
			userPassword = "${pwatcherPassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateView.viewWatcherMessage(present = "yes");
	}

	test CreateTicketComponentActivationKey {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			browser = "${browser}",
			component = "Activation Key",
			configType = "saved",
			description = "QA Test for creating a ticket with Activation Key component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Activation Key",
			systemStatus = "${systemStatus}");

		LESATicketCreate.inputActivationKeyDetails(
			purpose = "Permanent Key",
			typeOfKey = "Standalone");

		LESATicketCreate.createTicket();

		LESAMessage.success();

		LESATicketView.viewEscalation(escalation = "1");

		LESATicketView.viewTicketDetails(reporterName = "${reporterName}");

		LESATicketView.viewDescription(description = "QA Test for creating a ticket with Activation Key component.");

		LESATicketView.viewActivationKeyDetails(
			purpose = "Permanent Key",
			typeOfKey = "Standalone");
	}

	test CreateTicketComponentClustering {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			browser = "${browser}",
			component = "Clustering",
			configType = "saved",
			description = "QA Test for creating a ticket with Clustering component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Clustering",
			systemStatus = "${systemStatus}");

		LESATicketCreate.inputClusteringDetails(serverCommunicationType = "Multicast");

		LESATicketCreate.createTicket();

		LESAMessage.success();

		LESATicketView.viewTicketDetails(
			browser = "${browser}",
			reporterName = "${reporterName}");

		LESATicketView.viewDescription(description = "QA Test for creating a ticket with Clustering component.");

		LESATicketView.viewClusteringDetails(serverCommunicationType = "Multicast");

		LESATicketView.viewAttachment(
			attachedBy = "${reporterName}",
			fileName = "Document_1.txt");

		LESATicketView.viewAttachment(
			attachedBy = "${reporterName}",
			fileName = "Document_2.txt");
	}

	test CreateTicketComponentLCS {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Liferay Connected Services",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for creating a ticket with LCS component.",
			javaVM = "OpenJDK 8",
			liferayVersion = "7.0",
			operatingSystem = "Solaris 11",
			product = "Management Tools (LCS)",
			project = "${project}",
			subcomponent = "Subscription Management",
			summary = "QA Test LCS",
			systemStatus = "${systemStatus}");

		LESATicketView.viewComponent(component = "Liferay Connected Services");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketView.viewComponent(component = "Liferay Connected Services");

		LESATicketView.viewSubcomponent(subcomponent = "Subscription Management");
	}

	test CreateTicketComponentLiferayFaces {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Liferay Faces",
			configType = "saved",
			description = "QA Test for creating a ticket with Liferay Faces component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Create Ticket Component Liferay Faces",
			systemStatus = "${systemStatus}");

		LESATicketView.viewEscalation(escalation = "P1");
	}

	test CreateTicketComponentLiferaySync {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Liferay Sync",
			configType = "saved",
			description = "QA Test for creating a ticket with Liferay Sync component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Create Ticket Component Liferay Sync",
			systemStatus = "${systemStatus}");

		LESATicketView.viewEscalation(escalation = "P1");
	}

	test CreateTicketComponentUpgrade {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			browser = "${browser}",
			component = "Upgrade",
			configType = "saved",
			description = "QA Test for creating a ticket with Upgrade component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Upgrade",
			systemStatus = "${systemStatus}");

		LESATicketCreate.inputUpgradeDetails(
			documentPersistence = "CMIS Store",
			toLiferayVersion = "Other",
			upgradeSteps = "Test upgrade steps",
			upload = "yes");

		LESATicketCreate.createTicket();

		LESAMessage.success();

		LESATicketView.viewTicketDetails(
			browser = "${browser}",
			reporterName = "${reporterName}",
			toLiferayVersion = "Other");

		LESATicketView.viewDescription(description = "QA Test for creating a ticket with Upgrade component.");

		LESATicketView.viewUpgradeDetails(
			documentPersistence = "CMIS Store",
			upgradeSteps = "Test upgrade steps");
	}

	test CreateTicketComponentUpgradeDXP {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			browser = "${browser}",
			component = "Upgrade",
			configType = "saved",
			description = "QA Test for creating an Upgrade ticket for DXP.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Upgrade DXP",
			systemStatus = "${systemStatus}");

		LESATicketCreate.inputUpgradeDetails(
			documentPersistence = "CMIS Store",
			fromLiferayVersion = "6.2 EE (Limited)",
			upgradeSteps = "Test upgrade steps");

		LESATicketCreate.createTicket();

		LESAMessage.success();

		LESATicketView.viewTicketDetails(
			browser = "${browser}",
			fromLiferayVersion = "6.2 EE",
			reporterName = "${reporterName}",
			toLiferayVersion = "7.0");

		LESATicketView.viewUpgradeDetails(
			documentPersistence = "CMIS Store",
			upgradeSteps = "Test upgrade steps");
	}

	test CreateTicketLongSummary {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Security",
			configType = "saved",
			description = "QA Test for creating a ticket a long summary.  Summary field should only allow up to 255 characters.  * is the 255th character in the summary.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*sttesttest",
			systemStatus = "${systemStatus}");

		LESATicketView.viewSummary(summary = "QA Test Create Ticket Long Summary testtesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttesttes*");

		LESATicketView.viewEscalation(escalation = "P1");
	}

	test CreateTicketNewConfig {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for creating a ticket with a new environment configuration.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test New Config",
			systemStatus = "${systemStatus}");

		LESATicketView.viewTicketDetails(
			browser = "${browser}",
			reporterName = "${reporterName}");

		LESATicketView.viewDescription(description = "QA Test for creating a ticket with a new environment configuration.");
	}

	test CreateTicketProductDeviceRecognition {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for creating a ticket with Mobile Device Detection product.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "Mobile Device Detection",
			project = "${project}",
			summary = "QA Test Mobile Device Detection Product",
			systemStatus = "${systemStatus}");

		LESATicketView.viewComponent(component = "Mobile Device Detection");
	}

	test CreateTicketProductDigitalEnterprise {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Tomcat 8.0",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "MySQL 5.6",
			description = "QA Test for creating a ticket with a DE product.",
			javaVM = "OpenJDK 8",
			liferayVersion = "7.0",
			operatingSystem = "Debian 8",
			product = "Digital Experience Platform",
			project = "${project}",
			server = "Non-Production",
			summary = "QA Test Create Ticket DE Product",
			systemStatus = "${systemStatus}");

		LESATicketView.viewTicketDetails(product = "Digital Enterprise Non-Production");
	}

	test CreateTicketProductSocialOffice {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for creating a ticket with SO product.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "3.1.1",
			operatingSystem = "Ubuntu 12",
			product = "Social Office",
			project = "${project}",
			summary = "QA Test SO Product");

		LESATicketView.viewComponent(component = "Social Office");

		LESATicketView.viewEscalation(escalation = "P1");
	}

	test CreateTicketSavedConfig {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Security",
			configType = "saved",
			description = "QA Test for creating a ticket with a saved environment configuration.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Saved Config",
			systemStatus = "${systemStatus}");

		LESATicketView.viewTicketDetails(
			browser = "${browser}",
			reporterName = "${reporterName}");

		LESATicketView.viewDescription(description = "QA Test for creating a ticket with a saved environment configuration.");
	}

}