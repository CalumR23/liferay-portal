<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="3" />

	<var method="TestPropsUtil#get('lesa.email.address.7')" name="adminEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.7')" name="adminPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.customer.name.4')" name="customerName" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseCommandName">
			<return name="testCaseCommandName" />
		</execute>

		<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<if>
			<equals arg1="${testCaseName}" arg2="AddAndViewProjectMessage" />
			<then>
				<execute macro="LESAUser#logoutAndLogin">
					<var name="userEmailAddress" value="${adminEmailAddress}" />
					<var name="userPassword" value="${adminPassword}" />
				</execute>

				<execute macro="ProjectAdminMessage#tearDownProjectMessage">
					<var name="message" value="This is a test QA message." />
					<var name="projectCode" value="QAPROJECT1" />
				</execute>
			</then>
		</if>

		<if>
			<equals arg1="${testCaseName}" arg2="ViewMessageIcon" />
			<then>
				<execute macro="LESAUser#logoutAndLogin">
					<var name="userEmailAddress" value="${adminEmailAddress}" />
					<var name="userPassword" value="${adminPassword}" />
				</execute>

				<execute macro="OSBAdminProject#deleteCustomers">
					<var name="projectCode" value="QAPROJECT2" />
				</execute>
			</then>
		</if>
	</tear-down>

	<command name="AddAndViewProjectMessage">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProjectAdminMessages">
			<var name="projectCode" value="QAPROJECT1" />
		</execute>

		<execute macro="ProjectAdminMessage#addProjectMessage">
			<var name="message" value="This is a test QA message." />
			<var name="severity" value="Urgent" />
			<var name="title" value="QA Test" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewProjectMessage">
			<var name="message" value="This is a test QA message." />
			<var name="projectName" value="QA Test Project 1" />
			<var name="severity" value="urgent" />
			<var name="title" value="QA Test" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProjectAdminMessages">
			<var name="projectCode" value="QAPROJECT1" />
		</execute>

		<execute macro="ProjectAdminMessage#deleteProjectMessage">
			<var name="message" value="This is a test QA message." />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewProjectMessageNotPresent">
			<var name="projectName" value="QA Test Project 1" />
			<var name="title" value="QA Test" />
		</execute>
	</command>

	<command name="ViewMessageIcon">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewMessageIconNotPresent" />

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewMessageIconNotPresent" />

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${partnerEmailAddress}" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="role" value="Developer" />
		</execute>

		<execute macro="OSBAdminProject#assignCustomer">
			<var name="emailAddress" value="${cseEmailAddress}" />
			<var name="projectCode" value="QAPROJECT2" />
			<var name="role" value="Watcher" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewMessageIcon" />

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewMessageIcon" />
	</command>

	<command name="ViewNoProjectMessages">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="ProjectAdminMessage#tearDownProjectMessage">
			<var name="message" value="" />
			<var name="projectCode" value="QAPROJECT1" />
		</execute>

		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASubscriptionMessages#viewNoProjectMessages" />
	</command>
</definition>