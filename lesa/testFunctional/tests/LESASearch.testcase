@component-name = "support-qa"
definition {

	property group = "3";
	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var casName = PropsUtil.get("lesa.cas.name.3");
	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var managerEmailAddress = PropsUtil.get("lesa.email.address.2");
	var managerPassword = PropsUtil.get("lesa.email.password.2");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerName = PropsUtil.get("lesa.partner.name.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");

	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		if ("${testCaseName}" == "CreateTicketAsCustomerAndViewWithPartnerFilter") {
			LESAUser.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			OSBAdminProject.tearDownAssignedCustomer(
				emailAddress = "${partnerEmailAddress}",
				projectCode = "QAPROJECT2");
		}

		if ("${testCaseName}" == "FilterTicketsByProjectAsCustomer") {
			LESAUser.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			OSBAdminProject.tearDownAssignedCustomer(
				emailAddress = "${customerEmailAddress}",
				projectCode = "QAPROJECT2");
		}

		if ("${testCaseName}" == "CreateCustomFilter") {
			LESASearch.deleteCustomFilter(filterName = "QA Test Filter 1");
		}

		if ("${testCaseName}" == "CreateDuplicateCustomFilter") {
			LESASearch.deleteCustomFilter(filterName = "QA Test Filter 2");

			LESASearch.deleteCustomFilter(filterName = "QA Test Filter 3");
		}

		if ("${testCaseName}" == "UpdateCustomFilter") {
			LESASearch.deleteCustomFilter(filterName = "QA Test Filter 4");
		}

		if ("${testCaseName}" == "ViewPartnerSupportProjects") {
			LESAUser.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			OSBAdminPartner.removePartnerFromProject(projectCode = "QAPROJECT2");
		}

		LESAUser.logout();
	}

	test BulkEditAssignee {
		LESAUser.login(
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "Chrome",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for bulk editing assignee.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "Portal",
			project = "QA Test Project 2",
			server = "Production",
			summary = "QA Test Bulk Edit Assignee",
			systemStatus = "Functioning with Limited Capabilities");

		LESANavigation.gotoLESASearch();

		LESASearch.searchByKeyword(keyword = "&quot;QA Test Bulk Edit Assignee&quot;");

		var firstTicketCount = LESASearch.getTicketCount();

		LESASearch.bulkEditAssignee(assignee = "QATest CSE2 (lesa.qa.cse.2@liferay.com.broken)");

		LESASearch.searchByKeyword(keyword = "&quot;QA Test Bulk Edit Assignee&quot;");

		LESASearch.selectFilterTicketsAssignee(assigneeList = "QATest CSE2");

		LESASearch.assertTicketCountEqual(ticketCount = "${firstTicketCount}");
	}

	test BulkEditViewManagerMode {
		LESAUser.login(
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.checkManagerMode();

		LESASearch.viewManagerModeFilters();
	}

	test BulkEditViewValidationMessages {
		LESAUser.login(
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.searchByKeyword(keyword = "QAPROJECT2");

		LESASearch.checkManagerMode();

		LESASearch.bulkEditSelectAll();

		LESASearch.bulkEditViewDisclaimer();

		LESASearch.bulkEditViewValidationMessages();
	}

	test CreateCustomFilter {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT1",
			projectName = "QA Test Project 1");

		LESASearch.filterTicketsByStatusAndResolution(status = "Solution Proposed");

		LESASearch.sortByTicketNumberDescending();

		LESASearch.createCustomFilter(filterName = "QA Test Filter 1");

		LESASearch.selectCustomFilter(menuItem = "QA Test Filter 1");

		LESASearch.viewSelectedProjects(projectList = "QA Test Project 1");

		LESASearch.viewSelectedStatus(statusList = "Solution Proposed");

		LESASearch.viewSelectedSort(
			column = "Ticket Number",
			sort = "down");
	}

	test CreateDuplicateCustomFilter {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.createCustomFilter(filterName = "QA Test Filter 2");

		LESANavigation.gotoLESASearch();

		LESASearch.createDuplicateCustomFilter(
			filterName = "QA Test Filter 2",
			newFilterName = "QA Test Filter 3");

		LESASearch.viewCustomFilters(filterNames = "QA Test Filter 2,QA Test Filter 3");
	}

	test CreateTicketAsCustomerAndViewWithPartnerFilter {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminProject.assignCustomer(
			emailAddress = "${partnerEmailAddress}",
			projectCode = "QAPROJECT2",
			role = "Developer");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "Chrome",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for creating a ticket as a customer and viewing it with the partner.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "Portal",
			project = "QA Test Project 2",
			server = "Production",
			summary = "QA Test Create Ticket As Customer And View With Partner Filter",
			systemStatus = "Functioning with Limited Capabilities");

		LESATicketView.assertNotAssignedTo(name = "${partnerName}");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.searchPartnersViaTicketsChooseAssignee(code = "QA Test Partner");

		LESASearch.sortByTicketNumberDescending();

		LESASearch.assertTicketNotInResult(ticketNumber = "${ticketNumber}");
	}

	test FilterTicketsByProjectAsCustomer {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.viewSelectedProjectSingle(project = "QA Test Project 1");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminProject.assignCustomer(
			emailAddress = "${customerEmailAddress}",
			projectCode = "QAPROJECT2",
			role = "Developer");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT1",
			projectName = "QA Test Project 1");

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT2",
			projectName = "QA Test Project 2");

		LESASearch.viewSelectedProjects(projectList = "QA Test Project 1,QA Test Project 2");
	}

	test FilterTicketsByProjectAsPartner {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT1",
			projectName = "QA Test Project 1");

		LESASearch.viewSelectedProjects(projectList = "QA Test Project 1");
	}

	test RemoveTicketAssigneeFilters {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.selectFilterTicketsAccountWorker(accountWorkerList = "${casName}");

		LESASearch.viewSelectedAccountWorkers(accountWorkerList = "${casName}");

		LESASearch.removeFilterTicketsAccountWorker(accountWorkerList = "${casName}");

		LESASearch.selectFilterTicketsAssignee(assigneeList = "${partnerName}");

		LESASearch.viewSelectedAssignees(assigneeList = "${partnerName}");

		LESASearch.removeFilterTicketsAssignee(assigneeList = "${partnerName}");

		LESASearch.selectFilterTicketsAccountWorker(accountWorkerList = "${casName}");

		LESASearch.selectFilterTicketsAssignee(assigneeList = "${partnerName}");

		Refresh();

		LESASearch.removeFilterTicketsAssignee(assigneeList = "${partnerName}");

		LESASearch.removeFilterTicketsAccountWorker(accountWorkerList = "${casName}");
	}

	test ReturnToSearchResults {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.search(keyword = "QAPROJECT1");

		var firstTicketCount = LESASearch.getTicketCount();

		LESASearch.gotoSearchResultTicket(ticketNumber = "QAPROJECT1");

		LESANavigation.back();

		LESASearch.assertTicketCountEqual(ticketCount = "${firstTicketCount}");
	}

	test SearchInvalidTicket {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoTicket(ticketNumber = "CALCAS-60");

		LESAMessage.error(errorMessage = "Invalid ticket search, please try again.");

		LESASearch.search(keyword = "QAPROJECT1-123456");

		LESAMessage.error(errorMessage = "Invalid ticket search, please try again.");
	}

	test SearchPartnerFeedback {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterFeedbackByAssignee(partner = "${partnerName}");

		LESASearch.searchByKeyword(keyword = "negative");

		LESAMessage.assertNoErrorMessage(message = "An error occurred while searching.  Please try again.");
	}

	test SearchPartnersViaTicketsChooseAssignee {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.searchPartnersViaTicketsChooseAssignee(managingSupport = "Yes");
	}

	test UpdateCustomFilter {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT2",
			projectName = "QA Test Project 2");

		LESASearch.createCustomFilter(filterName = "QA Test Filter 4");

		LESASearch.selectCustomFilter(menuItem = "QA Test Filter 4");

		LESASearch.filterTicketsByStatusAndResolution(status = "On Hold");

		LESASearch.updateCustomFilter(filterName = "QA Test Filter 4");

		LESASearch.viewSelectedProjects(projectList = "QA Test Project 2");

		LESASearch.viewSelectedStatus(statusList = "On Hold");
	}

	test ViewPartnerSupportProjects {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminPartner.addPartnerToAccount(
			partnerCode = "QA Test Partner",
			projectCode = "QAPROJECT2");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.viewProjectsInProjectsTab(projectList = "QAPROJECT1,QAPROJECT2");

		LESANavigation.gotoLESASearch();

		LESASearch.viewPartnerFLSProjectsFilter(projectList = "QAPROJECT1,QAPROJECT2");
	}

	test ViewPartnerTicketSearchFilters {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.viewPartnerTicketSearchFilters();
	}

	test ViewTicketCountWithStatusAndResolutionFilters {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByStatusAndResolution(
			resolution = "Completed",
			status = "Closed");

		var firstTicketCount = LESASearch.getTicketCount();

		LESASearch.checkTicketStatus(status = "Open");

		LESASearch.assertTicketCountNotEqual(ticketCount = "${firstTicketCount}");
	}

}