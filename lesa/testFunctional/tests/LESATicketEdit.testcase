<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="1" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.customer.name.4')" name="customerName" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.8')" name="cwatcherEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.8')" name="cwatcherPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.2')" name="managerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.2')" name="managerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.9')" name="pwatcherEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.9')" name="pwatcherPassword" />

	<var name="browser" value="Firefox" />
	<var name="component" value="Security" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<set-up>
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="LESAUser#logout" />
	</tear-down>

	<command name="AddAttachmentAsCustomer">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for adding an attachment to a ticket as a customer." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Attachment As Customer" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#addAttachment">
			<var name="fileName" value="Document_1.doc" />
		</execute>

		<execute macro="LESATicketView#viewAttachment">
			<var name="attachedBy" value="${customerName}" />
			<var name="fileName" value="Document_1.doc" />
		</execute>
	</command>

	<command name="AddLinks">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for adding links to a ticket." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Add Links" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#addLinks">
			<var name="url1" value="http://www.google.com" />
			<var name="url2" value="http://www.support-kb.liferay.com" />
			<var name="visibility" value="Liferay" />
		</execute>

		<execute macro="LESATicketView#viewLink">
			<var name="url" value="http://www.google.com" />
			<var name="visibility" value="Liferay" />
		</execute>

		<execute macro="LESATicketView#viewLink">
			<var name="url" value="http://www.support-kb.liferay.com" />
			<var name="visibility" value="Liferay" />
		</execute>
	</command>

	<command name="EditAndViewPendingValues">
		<execute macro="LESAUser#logoutAndLogin">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for editing and viewing Pending values." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit And View Pending Values" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Liferay" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Support" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#editPending">
			<var name="pendingList" value="Liferay,Partner" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Liferay, Partner" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Support" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#editPending">
			<var name="pendingList" value="Customer,Liferay,Partner" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Customer, Liferay, Partner" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Customer" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#editPending">
			<var name="pendingList" value="Customer" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Customer" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Customer" />
		</execute>
	</command>

	<command name="EditEnvironmentDetails">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Performance" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for editing Environment Details." />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Environment Details" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoEnvironmentDetails" />

		<execute macro="LESATicketView#viewEditTicketEnvironmentDetailsNonUpgradeTicket" />

		<execute macro="LESATicketEdit#editEnvironmentDetails">
			<var name="appServer" value="Wildfly 10.0" />
			<var name="browser" value="Chrome" />
			<var name="db" value="DB2 10.1" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="os" value="Solaris 11" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetailsEnvironmentDetails">
			<var name="appServer" value="Wildfly 10.0" />
			<var name="browser" value="Chrome" />
			<var name="db" value="DB2 10.1" />
			<var name="fromLR" value="7.0" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="os" value="Solaris 11" />
		</execute>
	</command>

	<command name="EditEnvironmentDetailsDXPUpgradeTicket">
		<property name="lesa.acceptance" value="true" />

		<var name="appServer" value="Tomcat 8.0" />
		<var name="browser" value="${browser}" />
		<var name="database" value="Oracle 11g Release 2" />
		<var name="documentPersistence" value="CMIS Store" />
		<var name="fromLiferayVersion" value="6.2 EE" />
		<var name="javaVM" value="Java 8" />
		<var name="liferayVersion" value="7.0" />
		<var name="operatingSystem" value="Solaris 11" />

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="appServer" value="${appServer}" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Upgrade" />
			<var name="configType" value="new" />
			<var name="database" value="${database}" />
			<var name="description" value="QA Test for editing Environment Details for an Upgrade ticket." />
			<var name="javaVM" value="${javaVM}" />
			<var name="liferayVersion" value="${liferayVersion}" />
			<var name="operatingSystem" value="${operatingSystem}" />
			<var name="product" value="Digital Enterprise" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Environment Details Upgrade Component" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketCreate#inputUpgradeDetails">
			<var name="documentPersistence" value="${documentPersistence}" />
			<var name="fromLiferayVersion" value="${fromLiferayVersion}" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>

		<execute macro="LESATicketCreate#createTicketAndGetTicketNumber">
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoEnvironmentDetails" />

		<execute macro="LESATicketView#viewEditTicketEnvironmentDetails">
			<var name="appServer" value="${appServer}" />
			<var name="browser" value="${browser}" />
			<var name="db" value="${database}" />
			<var name="fromLR" value="${fromLiferayVersion}" />
			<var name="jvm" value="${javaVM}" />
			<var name="os" value="${operatingSystem}" />
			<var name="toLR" value="${liferayVersion}" />
		</execute>

		<execute macro="LESATicketEdit#editEnvironmentDetails">
			<var name="appServer" value="Wildfly 10.0" />
			<var name="browser" value="Chrome" />
			<var name="db" value="DB2 10.1" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="os" value="CentOS 7" />
		</execute>

		<execute macro="LESATicketView#viewTicketDetailsEnvironmentDetails">
			<var name="appServer" value="Wildfly 10.0" />
			<var name="browser" value="Chrome" />
			<var name="db" value="DB2 10.1" />
			<var name="fromLR" value="${fromLiferayVersion}" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="os" value="CentOS 7" />
			<var name="toLR" value="${liferayVersion}" />
		</execute>
	</command>

	<command name="EditEnvironmentDetailsLimitedLiferayVersion">
		<var name="description" value="QA Test for editing the Environment Details using a limited Liferay Version." />
		<var name="liferayVersion1" value="6.1 GA1 (Limited)" />
		<var name="liferayVersion2" value="6.0 (End of Service Life)" />
		<var name="liferayVersion3" value="5.2 (End of Service Life)" />

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#inputBasicForm">
			<var name="appServer" value="Weblogic 11" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Project Administration" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 10g Release 2" />
			<var name="description" value="${description}" />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="${liferayVersion1}" />
			<var name="operatingSystem" value="Ubuntu 10" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Environment Details Limited Liferay Version" />
			<var name="systemStatus" value="${systemStatus}" />
		</execute>

		<execute macro="LESATicketView#viewLimitedSupportMessage">
			<var name="liferayVersion" value="${liferayVersion1}" />
		</execute>

		<execute macro="LESATicketCreate#createTicketAndGetTicketNumber">
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="${description}" />
		</execute>

		<execute macro="LESATicketView#viewLimitedSupportMessage">
			<var name="liferayVersion" value="${liferayVersion1}" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoEnvironmentDetails" />

		<execute macro="LESATicketEdit#editEnvironmentDetails">
			<var name="liferayVersion" value="${liferayVersion2}" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="${description}" />
		</execute>

		<execute macro="LESATicketView#viewLimitedSupportMessage">
			<var name="liferayVersion" value="${liferayVersion2}" />
		</execute>

		<execute macro="LESANavigation#gotoEnvironmentDetails" />

		<execute macro="LESATicketEdit#editEnvironmentDetails">
			<var name="liferayVersion" value="${liferayVersion3}" />
		</execute>

		<execute macro="LESATicketView#viewLimitedSupportMessage">
			<var name="liferayVersion" value="${liferayVersion3}" />
		</execute>
	</command>

	<command name="EditTicketAssignedToAnotherWorker">
		<execute macro="LESANavigation#gotoLESASearch" />

		<execute macro="LESASearch#filterTicketsByProject">
			<var name="projectCode" value="QAPROJECT1" />
			<var name="projectName" value="QA Test Project 1" />
		</execute>

		<execute macro="LESASearch#searchPartnersViaTicketsChooseAssignee">
			<var name="code" value="QA Test Partner" />
		</execute>

		<execute macro="LESASearch#filterTicketsByStatusAndResolution">
			<var name="status" value="Incident Reported" />
		</execute>

		<execute macro="LESASearch#gotoSearchResultTicket">
			<var name="ticketNumber" value="QAPROJECT1" />
		</execute>

		<execute macro="LESATicketEdit#editTicketAssignedToAnotherWorker" />
	</command>

	<command name="EditTicketDetails">
		<property name="lesa.acceptance" value="true" />

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for editing ticket details." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Ticket Details" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#editTicketDetails">
			<var name="component" value="Web Content Management" />
			<var name="description" value="QA Test for editing ticket details.  This ticket was edited." />
			<var name="escalationLevel" value="2" />
			<var name="needsResponseFrom" value="Customer" />
			<var name="product" value="Portal Backup" />
			<var name="reporter" value="${customerEmailAddress}" />
			<var name="severity" value="Major" />
			<var name="status" value="Investigating" />
			<var name="subcomponent" value="Templates" />
			<var name="subject" value="QA Test Edit Ticket Details - Edited" />
			<var name="supportLanguage" value="Chinese" />
			<var name="supportRegion" value="China" />
		</execute>

		<execute macro="LESATicketView#viewSummary">
			<var name="summary" value="QA Test Edit Ticket Details - Edited" />
		</execute>

		<execute macro="LESATicketView#viewComponent">
			<var name="component" value="Web Content Management" />
		</execute>

		<execute macro="LESATicketView#viewSubcomponent">
			<var name="subcomponent" value="Templates" />
		</execute>

		<execute macro="LESATicketView#viewSeverity">
			<var name="severity" value="Major" />
		</execute>

		<execute macro="LESATicketView#viewPending">
			<var name="pending" value="Customer, Partner" />
		</execute>

		<execute macro="LESATicketView#viewEscalation">
			<var name="escalation" value="2" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Investigating" />
		</execute>

		<execute macro="LESATicketView#viewDescription">
			<var name="description" value="QA Test for editing ticket details.  This ticket was edited." />
		</execute>

		<execute macro="LESATicketView#viewTicketDetails">
			<var name="language" value="Chinese" />
			<var name="product" value="Portal Backup" />
			<var name="region" value="China Support Region" />
			<var name="reporterName" value="${customerName}" />
		</execute>

		<execute macro="LESATicketEdit#editTicketDetails">
			<var name="resolution" value="Duplicate" />
			<var name="status" value="Closed" />
		</execute>

		<execute macro="LESATicketView#viewTicketStatus">
			<var name="status" value="Closed" />
		</execute>

		<execute macro="LESATicketView#viewTicketResolution">
			<var name="resolution" value="Duplicate" />
		</execute>
	</command>

	<command name="EditTicketSpecialComponents">
		<property name="lesa.acceptance" value="true" />

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for editing a ticket's component." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Edit Ticket Special Component" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#editComponentActivationKey">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>

		<execute macro="LESATicketView#viewActivationKeyDetails">
			<var name="purpose" value="Permanent Key" />
			<var name="typeOfKey" value="Standalone" />
		</execute>

		<execute macro="LESATicketEdit#editComponentClustering">
			<var name="serverCommunicationType" value="Multicast" />
		</execute>

		<execute macro="LESATicketView#viewClusteringDetails">
			<var name="serverCommunicationType" value="Multicast" />
		</execute>

		<execute macro="LESATicketEdit#editComponentUpgrade">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>

		<execute macro="LESATicketView#viewUpgradeDetails">
			<var name="documentPersistence" value="CMIS Store" />
			<var name="upgradeSteps" value="Test upgrade steps" />
		</execute>

		<execute macro="LESATicketEdit#assertComponentDetailsNotOnTicketDetailsTab" />
	</command>

	<command name="RemoveAllTicketAssignees">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="appServer" value="Weblogic 12c R1" />
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="new" />
			<var name="database" value="Oracle 11g Release 2" />
			<var name="description" value="QA Test for removing all assignees from a ticket." />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.2 EE" />
			<var name="operatingSystem" value="Ubuntu 12" />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Remove All Ticket Assignees" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketEdit#removeAllTicketAssignees" />
	</command>

	<command name="ViewTicketAsCustomerWatcher">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="${component}" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for viewing ticket as a customer watcher." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View Ticket As Customer Watcher" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cwatcherEmailAddress}" />
			<var name="userPassword" value="${cwatcherPassword}" />
		</execute>

		<execute macro="LESATicketEdit#viewTicketAsWatcher" />
	</command>

	<command name="ViewTicketAsPartnerWatcher">
		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for viewing ticket as a partner watcher." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View Ticket As Partner Watcher" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${pwatcherEmailAddress}" />
			<var name="userPassword" value="${pwatcherPassword}" />
		</execute>

		<execute macro="LESATicketEdit#viewTicketAsWatcher" />
	</command>
</definition>