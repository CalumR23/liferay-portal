@component-name = "support-qa"
definition {

	property group = "1";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerName = PropsUtil.get("lesa.customer.name.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var cwatcherEmailAddress = PropsUtil.get("lesa.email.address.8");
	var cwatcherPassword = PropsUtil.get("lesa.email.password.8");
	var managerEmailAddress = PropsUtil.get("lesa.email.address.2");
	var managerPassword = PropsUtil.get("lesa.email.password.2");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	var pwatcherEmailAddress = PropsUtil.get("lesa.email.address.9");
	var pwatcherPassword = PropsUtil.get("lesa.email.password.9");
	var browser = "Firefox";
	var component = "Security";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	setUp {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");
	}

	tearDown {
		LESAUser.logout();
	}

	test AddAttachmentAsCustomer {
		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for adding an attachment to a ticket as a customer.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Add Attachment As Customer",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketEdit.addAttachment(fileName = "Document_1.doc");

		LESATicketView.viewAttachment(
			attachedBy = "${customerName}",
			fileName = "Document_1.doc");
	}

	test AddLinks {
		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "${component}",
			configType = "saved",
			description = "QA Test for adding links to a ticket.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Links",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketEdit.addLinks(
			url1 = "http://www.google.com",
			url2 = "http://www.support-kb.liferay.com",
			visibility = "Liferay");

		LESATicketView.viewLink(
			url = "http://www.google.com",
			visibility = "Liferay");

		LESATicketView.viewLink(
			url = "http://www.support-kb.liferay.com",
			visibility = "Liferay");
	}

	test EditAndViewPendingValues {
		LESAUser.logoutAndLogin(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for editing and viewing Pending values.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Edit And View Pending Values",
			systemStatus = "${systemStatus}");

		LESATicketView.viewPending(pending = "Liferay");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketView.viewPending(pending = "Support");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicketEdit.editPending(pendingList = "Liferay,Partner");

		LESATicketView.viewPending(pending = "Liferay, Partner");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketView.viewPending(pending = "Support");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicketEdit.editPending(pendingList = "Customer,Liferay,Partner");

		LESATicketView.viewPending(pending = "Customer, Liferay, Partner");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketView.viewPending(pending = "Customer");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicketEdit.editPending(pendingList = "Customer");

		LESATicketView.viewPending(pending = "Customer");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketView.viewPending(pending = "Customer");
	}

	test EditEnvironmentDetails {
		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Performance",
			configType = "saved",
			description = "QA Test for editing Environment Details.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Edit Environment Details",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoEnvironmentDetails();

		LESATicketView.viewEditTicketEnvironmentDetailsNonUpgradeTicket();

		LESATicketEdit.editEnvironmentDetails(
			appServer = "Wildfly 10.0",
			browser = "Chrome",
			db = "DB2 10.1",
			jvm = "IBM JDK 8",
			os = "Solaris 11");

		LESATicketView.viewTicketDetailsEnvironmentDetails(
			appServer = "Wildfly 10.0",
			browser = "Chrome",
			db = "DB2 10.1",
			fromLR = "7.0",
			jvm = "IBM JDK 8",
			os = "Solaris 11");
	}

	test EditEnvironmentDetailsDXPUpgradeTicket {
		property lesa.acceptance = "true";

		var appServer = "Tomcat 8.0";
		var browser = "${browser}";
		var database = "Oracle 11g Release 2";
		var documentPersistence = "CMIS Store";
		var fromLiferayVersion = "6.2 EE (Limited)";
		var javaVM = "IBM JDK 8";
		var liferayVersion = "7.0";
		var operatingSystem = "Solaris 11";

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			appServer = "${appServer}",
			browser = "${browser}",
			component = "Upgrade",
			configType = "new",
			database = "${database}",
			description = "QA Test for editing Environment Details for an Upgrade ticket.",
			javaVM = "${javaVM}",
			liferayVersion = "${liferayVersion}",
			operatingSystem = "${operatingSystem}",
			product = "Digital Experience Platform",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Edit Environment Details Upgrade Component",
			systemStatus = "${systemStatus}");

		LESATicketCreate.inputUpgradeDetails(
			documentPersistence = "${documentPersistence}",
			fromLiferayVersion = "${fromLiferayVersion}",
			upgradeSteps = "Test upgrade steps");

		var ticketNumber = LESATicketCreate.createTicketAndGetTicketNumber();

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoEnvironmentDetails();

		LESATicketView.viewEditTicketEnvironmentDetails(
			appServer = "${appServer}",
			browser = "${browser}",
			db = "${database}",
			fromLR = "6.2 EE(Limited)",
			jvm = "${javaVM}",
			os = "${operatingSystem}",
			toLR = "${liferayVersion}");

		LESATicketEdit.editEnvironmentDetails(
			appServer = "Wildfly 10.0",
			browser = "Chrome",
			db = "DB2 10.1",
			jvm = "IBM JDK 8",
			os = "CentOS 7");

		LESATicketView.viewTicketDetailsEnvironmentDetails(
			appServer = "Wildfly 10.0",
			browser = "Chrome",
			db = "DB2 10.1",
			fromLR = "6.2 EE",
			jvm = "IBM JDK 8",
			os = "CentOS 7",
			toLR = "${liferayVersion}");
	}

	test EditEnvironmentDetailsLimitedLiferayVersion {
		var description = "QA Test for editing the Environment Details using a limited Liferay Version.";
		var liferayVersion1 = "6.1 GA1 (Limited)";
		var liferayVersion2 = "6.0 (End of Service Life)";
		var liferayVersion3 = "5.2 (End of Service Life)";

		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			appServer = "Weblogic 11",
			browser = "${browser}",
			component = "Project Administration",
			configType = "new",
			database = "Oracle 10g Release 2",
			description = "${description}",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "${liferayVersion1}",
			operatingSystem = "Ubuntu 10",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Edit Environment Details Limited Liferay Version",
			systemStatus = "${systemStatus}");

		LESATicketView.viewLimitedSupportMessage(liferayVersion = "${liferayVersion1}");

		var ticketNumber = LESATicketCreate.createTicketAndGetTicketNumber();

		LESATicketView.viewDescription(description = "${description}");

		LESATicketView.viewLimitedSupportMessage(liferayVersion = "${liferayVersion1}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoEnvironmentDetails();

		LESATicketEdit.editEnvironmentDetails(liferayVersion = "${liferayVersion2}");

		LESATicketView.viewDescription(description = "${description}");

		LESATicketView.viewLimitedSupportMessage(liferayVersion = "${liferayVersion2}");

		LESANavigation.gotoEnvironmentDetails();

		LESATicketEdit.editEnvironmentDetails(liferayVersion = "${liferayVersion3}");

		LESATicketView.viewLimitedSupportMessage(liferayVersion = "${liferayVersion3}");
	}

	test EditTicketAssignedToAnotherWorker {
		LESANavigation.gotoLESASearch();

		LESASearch.filterTicketsByProject(
			projectCode = "QAPROJECT1",
			projectName = "QA Test Project 1");

		LESASearch.searchPartnersViaTicketsChooseAssignee(code = "QA Test Partner");

		LESASearch.filterTicketsByStatusAndResolution(status = "In Diagnosis");

		LESASearch.gotoSearchResultTicket(ticketNumber = "QAPROJECT1");

		LESATicketEdit.editTicketAssignedToAnotherWorker();
	}

	test EditTicketDetails {
		property lesa.acceptance = "true";

		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "${component}",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for editing ticket details.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Edit Ticket Details",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketEdit.editTicketDetails(
			component = "Web Content Management",
			description = "QA Test for editing ticket details.  This ticket was edited.",
			escalationLevel = "2",
			needsResponseFrom = "Customer",
			product = "Portal Backup",
			reporter = "${customerEmailAddress}",
			severity = "Major",
			status = "Resolution Planning",
			subcomponent = "Templates",
			subject = "QA Test Edit Ticket Details - Edited",
			supportLanguage = "Chinese",
			supportRegion = "China");

		LESATicketView.viewSummary(summary = "QA Test Edit Ticket Details - Edited");

		LESATicketView.viewComponent(component = "Web Content Management");

		LESATicketView.viewSubcomponent(subcomponent = "Templates");

		LESATicketView.viewSeverity(severity = "Major");

		LESATicketView.viewPending(pending = "Customer, Partner");

		LESATicketView.viewEscalation(escalation = "2");

		LESATicketView.viewTicketStatus(status = "Resolution Planning");

		LESATicketView.viewDescription(description = "QA Test for editing ticket details.  This ticket was edited.");

		LESATicketView.viewTicketDetails(
			language = "Chinese",
			product = "Portal Backup",
			region = "China Support Region",
			reporterName = "${customerName}");

		LESATicketEdit.editTicketDetails(
			resolution = "Completed",
			status = "Closed");

		LESATicketView.viewTicketStatus(status = "Closed");

		LESATicketView.viewTicketResolution(resolution = "Completed");
	}

	test EditTicketSpecialComponents {
		property lesa.acceptance = "true";

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "${component}",
			configType = "saved",
			description = "QA Test for editing a ticket's component.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Edit Ticket Special Component",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketEdit.editComponentActivationKey(
			purpose = "Permanent Key",
			typeOfKey = "Standalone");

		LESATicketView.viewActivationKeyDetails(
			purpose = "Permanent Key",
			typeOfKey = "Standalone");

		LESATicketEdit.editComponentClustering(serverCommunicationType = "Multicast");

		LESATicketView.viewClusteringDetails(serverCommunicationType = "Multicast");

		LESATicketEdit.editComponentUpgrade(
			documentPersistence = "CMIS Store",
			upgradeSteps = "Test upgrade steps");

		LESATicketView.viewUpgradeDetails(
			documentPersistence = "CMIS Store",
			upgradeSteps = "Test upgrade steps");

		LESATicketEdit.assertComponentDetailsNotOnTicketDetailsTab();
	}

	test RemoveAllTicketAssignees {
		var ticketNumber = LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for removing all assignees from a ticket.",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Remove All Ticket Assignees",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketEdit.removeAllTicketAssignees();
	}

	test ViewTicketAsCustomerWatcher {
		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "${component}",
			configType = "saved",
			description = "QA Test for viewing ticket as a customer watcher.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test View Ticket As Customer Watcher",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cwatcherEmailAddress}",
			userPassword = "${cwatcherPassword}");

		LESATicketEdit.viewTicketAsWatcher();
	}

	test ViewTicketAsPartnerWatcher {
		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for viewing ticket as a partner watcher.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test View Ticket As Partner Watcher",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${pwatcherEmailAddress}",
			userPassword = "${pwatcherPassword}");

		LESATicketEdit.viewTicketAsWatcher();
	}

}