@component-name = "support-qa"
definition {

	property group = "2";
	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var cseName = PropsUtil.get("lesa.cse.name.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	var browser = "Firefox";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		if ("${testCaseName}" == "EditCommentAsPartnerCustomer") {
			LESAUser.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			OSBAdminNavigation.gotoOSBAdmin();

			OSBAdminProject.tearDownAssignedCustomer(
				emailAddress = "${partnerEmailAddress}",
				projectCode = "QAPROJECT1");
		}

		if ("${testCaseName}" == "ViewWorkerTabHiddenForPartnerCustomer") {
			LESAUser.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			OSBAdminNavigation.gotoOSBAdmin();

			OSBAdminProject.tearDownAssignedCustomer(
				emailAddress = "${partnerEmailAddress}",
				projectCode = "QAPROJECT2");
		}

		LESAUser.logout();
	}

	test AddCommentAttachment {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a public comment with an attachment.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add An Attachment On Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "This is a QA test public comment with an attachment.",
			commentType = "Public",
			fileName = "Document_1.txt");

		LESATicketComment.viewCommentAttachment(
			comment = "This is a QA test public comment with an attachment.",
			commentType = "Public",
			fileName = "Document_1.txt");
	}

	test AddCommentWithDuplicateAttachment {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Document Library",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test for adding a duplicate attachment to a comment.",
			javaVM = "IBM JDK 8",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "${project}",
			server = "${server}",
			summary = "QA Test Add Comment With Duplicate Attachment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addCommentWithDuplicateAttachment(
			comment = "Test comment with duplicate attachment.",
			fileName = "patchinfo.txt");
	}

	test AddFormattedComment {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a formatted comment.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Formatted Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			commentLines = "[i]italics comment[/i],[u]underline[/u],[quote]This is quoted text.[/quote],[code] This is a line of code.[/code],[url=http://www.google.com]Google[/url],[url=https://en.wikipedia.org/wiki/Zip_(file_format)]Wikipedia article on Zip (file format)[/url],[url=https://issues.liferay.com/browse/LPP-17573?focusedCommentId=646544#comment-646544]JIRA Comment[/url]",
			commentType = "Public");

		LESATicketComment.viewCommentWithReturns(
			commentCreator = "${cseName}",
			commentLines = "italics comment,underline,This is quoted text., This is a line of code.,Google,Wikipedia article on Zip (file format),JIRA Comment",
			commentType = "Public");
	}

	test AddLiferayComment {
		property lesa.acceptance = "true";

		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a Liferay comment.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Liferay Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "This is a QA test Liferay comment.",
			commentType = "Liferay");

		LESATicketComment.viewLiferayComment(
			comment = "This is a QA test Liferay comment.",
			commentCreator = "${cseName}");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketComment.viewCommentAsCustomer(
			comment = "This is a QA test Liferay comment.",
			commentCreator = "${cseName}",
			ticketNumber = "${ticketNumber}");
	}

	test AddPublicComment {
		property lesa.acceptance = "true";

		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a public comment.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Public Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "This is a QA test public comment.",
			commentType = "Public");

		LESATicketComment.viewPublicComment(
			comment = "This is a QA test public comment.",
			commentCreator = "${cseName}");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketComment.viewCommentAsCustomer(
			comment = "This is a QA test public comment.",
			commentCreator = "${cseName}",
			commentType = "Public",
			ticketNumber = "${ticketNumber}");
	}

	test AddWorkerComment {
		property lesa.acceptance = "true";

		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a worker comment.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Worker Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "This is a QA test worker comment.",
			commentType = "Worker");

		LESATicketComment.viewWorkerComment(
			comment = "This is a QA test worker comment.",
			commentCreator = "${cseName}");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketComment.viewCommentAsCustomer(
			comment = "This is a QA test worker comment.",
			commentCreator = "${cseName}",
			ticketNumber = "${ticketNumber}");
	}

	test AddWorkerCommentOnPartnerManagedProject {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for adding a worker comment on a partner managed project.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Add Worker Comment On Partner Managed Project",
			systemStatus = "${systemStatus}");

		LESATicketView.viewEscalation(escalation = "P1");

		LESATicketComment.addComment(
			comment = "This is a QA test worker comment.",
			commentType = "Worker");

		LESATicketComment.viewWorkerComment(
			comment = "This is a QA test worker comment.",
			commentCreator = "${cseName}");
	}

	test AutoSaveAndDeleteDraftComment {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Application Display Templates",
			configType = "saved",
			description = "QA Test for auto saving a comment.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Auto Save and Delete Draft Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.autoSaveComment(comment = "QA test autosave comment.");

		LESATicketComment.deleteDraftComment(comment = "QA test autosave comment.");
	}

	test EditComment {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Portal Services",
			configType = "saved",
			description = "QA Test for editing a comment.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Edit Comment",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "QA CSE test comment.",
			commentType = "Public");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicketComment.addComment(
			comment = "QA Partner test comment 1.",
			commentType = "Public");

		LESATicketComment.addComment(
			comment = "QA Partner test comment 2.",
			commentType = "Public");

		LESATicketComment.assertCommentNotEditable(comment = "QA CSE test comment.");

		LESATicketComment.assertCommentNotEditable(comment = "QA Parter test comment 1.");

		LESATicketComment.editComment(
			newComment = "QA Partner edited comment.",
			originalComment = "QA Partner test comment 2.");

		LESATicketComment.viewComment(
			comment = "QA Partner edited comment.",
			commentType = "Public");
	}

	test EditCommentAsPartnerCustomer {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminProject.assignCustomer(
			emailAddress = "${partnerEmailAddress}",
			projectCode = "QAPROJECT1",
			role = "Developer");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Localization",
			configType = "saved",
			description = "QA Test for editing a comment as Partner/Customer.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Edit Comment As Partner Customer",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(
			comment = "QA test comment.",
			commentType = "Worker");

		LESATicketComment.editComment(
			newComment = "QA test edited comment.",
			originalComment = "QA test comment.");

		LESATicketComment.viewComment(
			comment = "QA test edited comment.",
			commentType = "Worker");
	}

	test ViewCommentNotEditableAsCustomer {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Portal Services",
			configType = "saved",
			description = "QA Test to confirm a Customer cannot edit a comment.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test View Comment Not Editable As Customer",
			systemStatus = "${systemStatus}");

		LESATicketComment.addComment(comment = "QA Customer test comment.");

		LESATicketComment.assertCommentNotEditable(comment = "QA Customer test comment.");
	}

	test ViewWorkerTabHiddenForPartnerCustomer {
		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminProject.assignCustomer(
			emailAddress = "${partnerEmailAddress}",
			projectCode = "QAPROJECT2",
			role = "Developer");

		LESAUser.logoutAndLogin(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESATicket.createTicketBasicForm(
			appServer = "Weblogic 12c R1",
			browser = "${browser}",
			component = "Security",
			configType = "new",
			database = "Oracle 11g Release 2",
			description = "QA Test to assert Worker tab is hidden if Customer is a Partner on a different account",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.2 EE (Limited)",
			operatingSystem = "Ubuntu 12",
			product = "${product}",
			project = "QA Test Project 2",
			server = "${server}",
			summary = "QA Test View Worker Tab Hidden For Partner Customer",
			systemStatus = "${systemStatus}");

		LESATicketComment.viewWorkerTabNotPresent();
	}

}