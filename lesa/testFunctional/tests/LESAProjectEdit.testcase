@component-name = "support-qa"
definition {

	property group = "1";
	property testray.main.component.name = "Support QA";

	var adminEmailAddress = PropsUtil.get("lesa.email.address.7");
	var adminPassword = PropsUtil.get("lesa.email.password.7");
	static var staticTearDownCallLog = "";
	static var staticTearDownProject = "";

	setUp {
		var staticTearDownCallLog = "";
		var staticTearDownProject = "";

		LESAUser.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");
	}

	tearDown {
		if ("${staticTearDownCallLog}" != "") {
			var projectCode = StringUtil.extractFirst("${staticTearDownCallLog}", ",");
			var summary = StringUtil.extractLast("${staticTearDownCallLog}", ",");

			LESAProjectEdit.tearDownCallLog(
				projectCode = "${projectCode}",
				summary = "${summary}");
		}

		if ("${staticTearDownProject}" != "") {
			OSBAdminNavigation.gotoOSBAdmin();

			OSBAdminProject.tearDownProject(projectCode = "${staticTearDownProject}");
		}

		LESAUser.logout();
	}

	test AddCallLogAsCAS {
		var staticTearDownCallLog = "QAPROJECT1,QA Test call log";

		LESANavigation.gotoLESA();

		LESASearch.searchProject(projectCode = "QAPROJECT1");

		LESAProjectEdit.addCallLog(
			actionItems = "Test action items.",
			callDateDay = "6",
			callDateMonth = "January",
			callDateYear = "2016",
			callLengthHours = "0",
			callLengthMinutes = "45",
			callLengthSeconds = "10",
			callType = "Incoming",
			clientsPresent = "Client A, Client B",
			notes = "This is a QA test.",
			summary = "QA Test call log");

		LESAProjectView.viewCallLog(
			actionItems = "Test action items.",
			callDate = "2016-01-06",
			callLength = "00:45:10",
			callType = "incoming",
			clientsPresent = "Client A, Client B",
			notes = "This is a QA test.",
			summary = "QA Test call log");
	}

	test EditCASInformation {
		var staticTearDownProject = "QATEST6";

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test Project 6",
			city = "Augusta",
			code = "QATEST6",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Project 6",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		LESANavigation.gotoLESA();

		LESASearch.searchProject(projectCode = "QATEST6");

		LESAProjectEdit.editCASInformation(
			contactOverview = "Contact QA Test",
			majorMilestones = "Building a Death Star by 2020",
			projectOverview = "Liferay Version: 6.2.10 EE",
			reasonsForStrategic = "QA Test");

		LESAProjectView.viewCASInformation(
			contactOverview = "Contact QA Test",
			majorMilestones = "Building a Death Star by 2020",
			projectOverview = "Liferay Version: 6.2.10 EE",
			reasonsForStrategic = "QA Test");
	}

	test EditProjectDetails {
		var staticTearDownProject = "QATEST8";

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test Project 8",
			city = "Augusta",
			code = "QATEST8",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Project 8",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		LESANavigation.gotoLESA();

		LESASearch.searchProject(projectCode = "QATEST8");

		LESANavigation.gotoEditProject();

		LESAProjectEdit.editProjectDetail(
			additionalNotes = "Test additional notes - edited.",
			specialInstructions = "Test special instructions - edited.");

		LESAProjectView.viewSupportInstructions(supportInstructions = "Test special instructions - edited.");

		LESAProjectView.viewProjectNotes(projectNotes = "Test additional notes - edited.");
	}

	test EditSalesInformation {
		var staticTearDownProject = "QATEST7";

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminProject.addProject(
			additionalNotes = "This is a test",
			addressLine = "123 Main Street",
			businessAccountName = "QA Test Project 7",
			city = "Augusta",
			code = "QATEST7",
			country = "United States",
			industry = "Manufacturing",
			maxContacts = "10",
			projectName = "QA Project 7",
			specialInstructions = "none",
			state = "Maine",
			tier = "Premier",
			type = "Group",
			zip = "04330");

		LESANavigation.gotoLESA();

		LESASearch.searchProject(projectCode = "QATEST7");

		LESAProjectEdit.editSalesInformation(
			licenseInformation = "Platinum Prod (5); Non-Prod (2)",
			salesforceURL = "Insert Salesforce link here.",
			trainingsAttended = "Liferay Certification");

		LESAProjectView.viewSalesInformation(
			licenseInformation = "Platinum Prod (5); Non-Prod (2)",
			salesforceURL = "Insert Salesforce link here.",
			trainingsAttended = "Liferay Certification");
	}

}