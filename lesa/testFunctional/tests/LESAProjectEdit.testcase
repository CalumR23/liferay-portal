<definition component-name="support-qa">
	<property name="group" value="1" />

	<var method="TestPropsUtil#get('lesa.email.address.3')" name="casEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.3')" name="casPassword" />

	<var name="staticTearDownCallLog" static="true" value="" />
	<var name="staticTearDownProject" static="true" value="" />

	<set-up>
		<var name="staticTearDownCallLog" value="" />
		<var name="staticTearDownProject" value="" />

		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${casEmailAddress}" />
			<var name="userPassword" value="${casPassword}" />
		</execute>
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownCallLog}" arg2="" />
			</not>
			<then>
				<var method="StringUtil#extractFirst('${staticTearDownCallLog}', ',')" name="projectCode" />
				<var method="StringUtil#extractLast('${staticTearDownCallLog}', ',')" name="summary" />

				<execute macro="LESAProjectEdit#tearDownCallLog">
					<var name="projectCode" value="${projectCode}" />
					<var name="summary" value="${summary}" />
				</execute>
			</then>
		</if>

		<if>
			<not>
				<equals arg1="${staticTearDownProject}" arg2="" />
			</not>
			<then>
				<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

				<execute macro="OSBAdminProject#tearDownProject">
					<var name="projectCode" value="${staticTearDownProject}" />
				</execute>
			</then>
		</if>

		<execute macro="LESAUser#logout" />
	</tear-down>

	<command name="AddCallLogAsCAS">
		<var name="staticTearDownCallLog" value="QAPROJECT1,QA Test call log" />

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#searchProject">
			<var name="projectCode" value="QAPROJECT1" />
		</execute>

		<execute macro="LESAProjectEdit#addCallLog">
			<var name="actionItems" value="Test action items." />
			<var name="callDateDay" value="6" />
			<var name="callDateMonth" value="January" />
			<var name="callDateYear" value="2016" />
			<var name="callLengthHours" value="0" />
			<var name="callLengthMinutes" value="45" />
			<var name="callLengthSeconds" value="10" />
			<var name="callType" value="Incoming" />
			<var name="clientsPresent" value="Client A, Client B" />
			<var name="notes" value="This is a QA test." />
			<var name="summary" value="QA Test call log" />
		</execute>

		<execute macro="LESAProjectView#viewCallLog">
			<var name="actionItems" value="Test action items." />
			<var name="callDate" value="2016-01-06" />
			<var name="callLength" value="00:45:10" />
			<var name="callType" value="incoming" />
			<var name="clientsPresent" value="Client A, Client B" />
			<var name="notes" value="This is a QA test." />
			<var name="summary" value="QA Test call log" />
		</execute>
	</command>

	<command name="EditCASInformation">
		<var name="staticTearDownProject" value="QATEST6" />

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test Project 6" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST6" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 6" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#searchProject">
			<var name="projectCode" value="QATEST6" />
		</execute>

		<execute macro="LESAProjectEdit#editCASInformation">
			<var name="contactOverview" value="Contact QA Test" />
			<var name="majorMilestones" value="Building a Death Star by 2020" />
			<var name="projectOverview" value="Liferay Version: 6.2.10 EE" />
			<var name="reasonsForStrategic" value="QA Test" />
		</execute>

		<execute macro="LESAProjectView#viewCASInformation">
			<var name="contactOverview" value="Contact QA Test" />
			<var name="majorMilestones" value="Building a Death Star by 2020" />
			<var name="projectOverview" value="Liferay Version: 6.2.10 EE" />
			<var name="reasonsForStrategic" value="QA Test" />
		</execute>
	</command>

	<command name="EditProjectDetails">
		<var name="staticTearDownProject" value="QATEST8" />

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test Project 8" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST8" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 8" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#searchProject">
			<var name="projectCode" value="QATEST8" />
		</execute>

		<execute macro="LESANavigation#gotoEditProject" />

		<execute macro="LESAProjectEdit#editProjectDetail">
			<var name="additionalNotes" value="Test additional notes - edited." />
			<var name="specialInstructions" value="Test special instructions - edited." />
		</execute>

		<execute macro="LESAProjectView#viewSupportInstructions">
			<var name="supportInstructions" value="Test special instructions - edited." />
		</execute>

		<execute macro="LESAProjectView#viewProjectNotes">
			<var name="projectNotes" value="Test additional notes - edited." />
		</execute>
	</command>

	<command name="EditSalesInformation">
		<var name="staticTearDownProject" value="QATEST7" />

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminProject#addProject">
			<var name="additionalNotes" value="This is a test" />
			<var name="addressLine" value="123 Main Street" />
			<var name="businessAccountName" value="QA Test Project 7" />
			<var name="city" value="Augusta" />
			<var name="code" value="QATEST7" />
			<var name="country" value="United States" />
			<var name="industry" value="Manufacturing" />
			<var name="maxContacts" value="10" />
			<var name="projectName" value="QA Project 7" />
			<var name="specialInstructions" value="none" />
			<var name="state" value="Maine" />
			<var name="tier" value="Premier" />
			<var name="type" value="Group" />
			<var name="zip" value="04330" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#searchProject">
			<var name="projectCode" value="QATEST7" />
		</execute>

		<execute macro="LESAProjectEdit#editSalesInformation">
			<var name="licenseInformation" value="Platinum Prod (5); Non-Prod (2)" />
			<var name="salesforceURL" value="Insert Salesforce link here." />
			<var name="trainingsAttended" value="Liferay Certification" />
		</execute>

		<execute macro="LESAProjectView#viewSalesInformation">
			<var name="licenseInformation" value="Platinum Prod (5); Non-Prod (2)" />
			<var name="salesforceURL" value="Insert Salesforce link here." />
			<var name="trainingsAttended" value="Liferay Certification" />
		</execute>
	</command>
</definition>