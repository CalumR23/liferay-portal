<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="2" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.cse.name.1')" name="cseName" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.customer.name.4')" name="customerName" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.2')" name="managerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.2')" name="managerPassword" />

	<var name="browser" value="Firefox" />
	<var name="product" value="Portal" />
	<var name="project" value="QA Test Project 1" />
	<var name="savedEnvConfigName" value="QA Config 6.2" />
	<var name="server" value="Production" />
	<var name="systemStatus" value="Completely Inoperable/Shutdown" />

	<command name="SubmitFeedbackAfterLiferayClosesTicket">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for submitting feedback after Liferay worker closes the ticket." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Submit Feedback After Liferay Closes Ticket" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#escalateTicket" />

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESATicketTransition#changeTicketStatus">
			<var name="currentStatus" value="Solution Proposed" />
			<var name="newStatus" value="Closed" />
			<var name="resolution" value="Completed" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketFeedback#submitReply">
			<var name="comment" value="Test negative feedback comment." />
			<var name="reply" value="No" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketFeedback#viewFeedback">
			<var name="comment" value="Test negative feedback comment." />
			<var name="reply" value="No" />
			<var name="submitter" value="${customerName}" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>

	<command name="SubmitNegativeFeedback">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for submitting negative feedback." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Submit Negative Feedback" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#escalateTicket" />

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESASearch#selectCustomFilter">
			<var name="menuItem" value="Ticket Feedback" />
		</execute>

		<execute macro="LESASearch#sortByTicketNumberDescending" />

		<execute macro="LESASearch#gotoSearchResultTicket">
			<var name="ticketNumber" value="${ticketNumber}" />
		</execute>

		<execute macro="LESATicketFeedback#submitReply">
			<var name="comment" value="Test negative feedback comment." />
			<var name="reply" value="No" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketFeedback#viewFeedback">
			<var name="comment" value="Test negative feedback comment." />
			<var name="reply" value="No" />
			<var name="submitter" value="${customerName}" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>

	<command name="SubmitPartnerFeedback">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for submitting partner feedback" />
			<var name="product" value="Digital Experience Platform" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Submit Partner Feedback" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#escalateTicket" />

		<execute macro="LESATicket#assertTabNotSelected">
			<var name="tabName" value="Feedback" />
		</execute>

		<execute macro="LESATicketTransition#assignWorker">
			<var name="emailAddress" value="${cseEmailAddress}" />
			<var name="name" value="${cseName}" />
			<var name="role" value="Developer" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#assertTabNotSelected">
			<var name="tabName" value="Feedback" />
		</execute>

		<execute macro="LESATicketFeedback#submitPartnerFeedback">
			<var name="comment" value="QA test" />
			<var name="escalatedProperly" value="Yes" />
			<var name="professionalism" value="5" />
			<var name="reproduced" value="Not Applicable" />
			<var name="responseTime" value="4" />
			<var name="technicalKnowledge" value="3" />
			<var name="timely" value="No" />
		</execute>

		<execute macro="LESATicketFeedback#viewPartnerFeedback">
			<var name="comment" value="QA test" />
			<var name="escalatedProperly" value="Yes" />
			<var name="professionalism" value="5" />
			<var name="reproduced" value="Not Applicable" />
			<var name="responseTime" value="4" />
			<var name="technicalKnowledge" value="3" />
			<var name="timely" value="No" />
		</execute>
	</command>

	<command name="SubmitPositiveFeedback">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Document Library" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test for submitting positive feedback." />
			<var name="product" value="${product}" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="${savedEnvConfigName}" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test Submit Positive Feedback" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESATicketTransition#escalateTicket" />

		<execute macro="LESATicket#assertTabNotSelected">
			<var name="tabName" value="Feedback" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="solutionDescription" value="This is a QA test solution." />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />

		<execute macro="LESATicketFeedback#submitReply">
			<var name="comment" value="Test positive feedback comment." />
			<var name="reply" value="Yes" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicket#assertTabSelected">
			<var name="tabName" value="Feedback" />
		</execute>

		<execute macro="LESATicketFeedback#viewFeedback">
			<var name="comment" value="Test positive feedback comment." />
			<var name="reply" value="Yes" />
			<var name="submitter" value="${customerName}" />
		</execute>

		<execute macro="LESAUser#logout" />
	</command>

	<command name="ViewNoLiferayFeedbackForP1Tickets">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicket#createTicketBasicForm">
			<var name="browser" value="${browser}" />
			<var name="component" value="Security" />
			<var name="configType" value="saved" />
			<var name="description" value="QA Test to assert Liferay feedback is not available for P1 tickets." />
			<var name="product" value="Digital Experience Platform" />
			<var name="project" value="${project}" />
			<var name="savedEnvConfigName" value="QA Config 7.0" />
			<var name="server" value="${server}" />
			<var name="summary" value="QA Test View No Liferay Feedback For P1 Tickets" />
			<var name="systemStatus" value="${systemStatus}" />
			<return from="ticketNumber" name="ticketNumber" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${managerEmailAddress}" />
			<var name="userPassword" value="${managerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoProposeSolution" />

		<execute macro="LESATicketSolution#proposeSolution">
			<var name="solutionDescription" value="This is a QA test solution." />
			<var name="subcomponent" value="Permissions" />
		</execute>

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESATicketSolution#acceptSolution" />

		<execute macro="LESATicketFeedback#assertFeedbackTabNotPresent" />

		<execute macro="LESANavigation#gotoTicketAsDifferentUser">
			<var name="ticketNumber" value="${ticketNumber}" />
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESATicketFeedback#assertFeedbackTabNotPresent" />
	</command>
</definition>