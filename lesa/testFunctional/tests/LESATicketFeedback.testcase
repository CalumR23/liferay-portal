@component-name = "support-qa"
definition {

	property group = "2";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var cseName = PropsUtil.get("lesa.cse.name.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerName = PropsUtil.get("lesa.customer.name.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var managerEmailAddress = PropsUtil.get("lesa.email.address.2");
	var managerPassword = PropsUtil.get("lesa.email.password.2");
	var browser = "Firefox";
	var product = "Portal";
	var project = "QA Test Project 1";
	var savedEnvConfigName = "QA Config 6.2";
	var server = "Production";
	var systemStatus = "Completely Inoperable/Shutdown";

	test SubmitFeedbackAfterLiferayClosesTicket {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for submitting feedback after Liferay worker closes the ticket.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Submit Feedback After Liferay Closes Ticket",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.escalateTicket();

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(solutionDescription = "This is a QA test solution.");

		LESATicketTransition.changeTicketStatus(
			currentStatus = "Solution Proposed",
			newStatus = "Closed",
			resolution = "Completed");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketFeedback.submitReply(
			comment = "Test negative feedback comment.",
			reply = "No");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketFeedback.viewFeedback(
			comment = "Test negative feedback comment.",
			reply = "No",
			submitter = "${customerName}");

		LESAUser.logout();
	}

	test SubmitNegativeFeedback {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for submitting negative feedback.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Submit Negative Feedback",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.escalateTicket();

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(solutionDescription = "This is a QA test solution.");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();

		LESANavigation.gotoLESA();

		LESASearch.selectCustomFilter(menuItem = "Ticket Feedback");

		LESASearch.sortByTicketNumberDescending();

		LESASearch.gotoSearchResultTicket(ticketNumber = "${ticketNumber}");

		LESATicketFeedback.submitReply(
			comment = "Test negative feedback comment.",
			reply = "No");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketFeedback.viewFeedback(
			comment = "Test negative feedback comment.",
			reply = "No",
			submitter = "${customerName}");

		LESAUser.logout();
	}

	test SubmitPartnerFeedback {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Security",
			configType = "saved",
			description = "QA Test for submitting partner feedback",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test Submit Partner Feedback",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.escalateTicket();

		LESATicket.assertTabNotSelected(tabName = "Feedback");

		LESATicketTransition.assignWorker(
			emailAddress = "${cseEmailAddress}",
			name = "${cseName}",
			role = "Developer");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.assertTabNotSelected(tabName = "Feedback");

		LESATicketFeedback.submitPartnerFeedback(
			comment = "QA test",
			escalatedProperly = "Yes",
			professionalism = "5",
			reproduced = "Not Applicable",
			responseTime = "4",
			technicalKnowledge = "3",
			timely = "No");

		LESATicketFeedback.viewPartnerFeedback(
			comment = "QA test",
			escalatedProperly = "Yes",
			professionalism = "5",
			reproduced = "Not Applicable",
			responseTime = "4",
			technicalKnowledge = "3",
			timely = "No");
	}

	test SubmitPositiveFeedback {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Document Library",
			configType = "saved",
			description = "QA Test for submitting positive feedback.",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			summary = "QA Test Submit Positive Feedback",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESATicketTransition.escalateTicket();

		LESATicket.assertTabNotSelected(tabName = "Feedback");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(solutionDescription = "This is a QA test solution.");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();

		LESATicketFeedback.submitReply(
			comment = "Test positive feedback comment.",
			reply = "Yes");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicket.assertTabSelected(tabName = "Feedback");

		LESATicketFeedback.viewFeedback(
			comment = "Test positive feedback comment.",
			reply = "Yes",
			submitter = "${customerName}");

		LESAUser.logout();
	}

	test ViewNoLiferayFeedbackForP1Tickets {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		var ticketNumber = LESATicket.createTicketBasicForm(
			browser = "${browser}",
			component = "Security",
			configType = "saved",
			description = "QA Test to assert Liferay feedback is not available for P1 tickets.",
			product = "Digital Experience Platform",
			project = "${project}",
			savedEnvConfigName = "QA Config 7.0",
			server = "${server}",
			summary = "QA Test View No Liferay Feedback For P1 Tickets",
			systemStatus = "${systemStatus}");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${managerEmailAddress}",
			userPassword = "${managerPassword}");

		LESANavigation.gotoProposeSolution();

		LESATicketSolution.proposeSolution(
			solutionDescription = "This is a QA test solution.",
			subcomponent = "Permissions");

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESATicketSolution.acceptSolution();

		LESATicketFeedback.assertFeedbackTabNotPresent();

		LESANavigation.gotoTicketAsDifferentUser(
			ticketNumber = "${ticketNumber}",
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESATicketFeedback.assertFeedbackTabNotPresent();
	}

}