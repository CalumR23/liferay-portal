@component-name = "support-qa"
definition {

	property group = "1";
	property testray.main.component.name = "Support QA";

	var cseEmailAddress = PropsUtil.get("lesa.email.address.1");
	var csePassword = PropsUtil.get("lesa.email.password.1");
	var customerEmailAddress = PropsUtil.get("lesa.email.address.4");
	var customerPassword = PropsUtil.get("lesa.email.password.4");
	var partnerEmailAddress = PropsUtil.get("lesa.email.address.6");
	var partnerPassword = PropsUtil.get("lesa.email.password.6");
	static var staticTearDownEnvironmentConfig = "";

	setUp {
		var staticTearDownEnvironmentConfig = "";
	}

	tearDown {
		if ("${staticTearDownEnvironmentConfig}" != "") {
			var name = StringUtil.extractLast("${staticTearDownEnvironmentConfig}", ",");
			var product = StringUtil.extractFirst("${staticTearDownEnvironmentConfig}", ",");

			LESAPreferences.tearDownEnvironmentConfiguration(
				name = "${name}",
				product = "${product}");
		}

		LESAUser.logout();
	}

	@priority = "5"
	test CreateAndUpdateEnvironment {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESAPreferences.createEnvironmentConfiguration(
			as = "Wildfly 10.0",
			db = "MySQL 5.6",
			jvm = "IBM JDK 8",
			liferayVersion = "7.0",
			name = "QA Test Environment 1",
			os = "CentOS 6",
			patchLevelFile = "patchinfo.txt",
			portalExtFile = "portal-ext.properties",
			product = "Developer Tools");

		var staticTearDownEnvironmentConfig = "Developer Tools,QA Test Environment 1";

		LESAPreferences.viewEnvironmentConfiguration(
			contentList = "Product: Developer Tools,LR: 7.0,OS: CentOS 6,JVM: IBM JDK 8,AS: Wildfly 10.0,DB: MySQL 5.6,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt",
			name = "QA Test Environment 1",
			product = "Developer Tools");

		LESAPreferences.updateEnvironmentConfiguration(
			as = "Tomcat 8.0",
			db = "MySQL 5.7",
			jvm = "OpenJDK 8",
			liferayVersion = "7.0",
			name = "QA Test Environment 1",
			newName = "QA Updated Test Environment 1",
			os = "CentOS 7",
			patchLevelFile = "Document_1.txt",
			portalExtFile = "Document_2.txt",
			product = "Developer Tools");

		var staticTearDownEnvironmentConfig = "Developer Tools,QA Updated Test Environment 1";

		LESAPreferences.viewEnvironmentConfiguration(
			contentList = "Product: Developer Tools,LR: 7.0,OS: CentOS 7,JVM: OpenJDK 8,AS: Tomcat 8.0,DB: MySQL 5.7,Portal-Ext:  Document_2.txt,Patch Level:  Document_1.txt",
			name = "QA Updated Test Environment 1",
			product = "Developer Tools");
	}

	@priority = "5"
	test CreatePortalEnvironmentViaCreateTicket {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "QA Test Project 1");

		LESATicketCreateEntry.selectProduct(product = "Portal");

		LESATicketCreateEntry.selectServer(server = "Production");

		LESATicketCreateEntry.selectComponent(component = "Upgrade");

		LESATicketCreate.createEnvironmentConfiguration(
			appServer = "Glassfish 3.1",
			database = "Hypersonic",
			envName = "QA Test Environment 2",
			javaVM = "Oracle Sun JDK 6",
			liferayVersion = "6.1 GA3 (Limited)",
			operatingSystem = "CentOS 6");

		var staticTearDownEnvironmentConfig = "Portal,QA Test Environment 2";

		LESANavigation.gotoEnvironmentConfigurations();

		LESATicketCreateEntry.selectProject(project = "QA Test Project 1");

		LESAPreferences.viewEnvironmentConfiguration(
			contentList = "Product: Portal Production,LR: 6.1 GA3,OS: CentOS 6,JVM: Oracle Sun JDK 6,AS: Glassfish 3.1,DB: Hypersonic,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt",
			name = "QA Test Environment 2",
			product = "Portal");
	}

	@priority = "5"
	test UpdateEnvironmentViaCreateTicket {
		LESAUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		LESANavigation.gotoLESA();

		LESAPreferences.createEnvironmentConfiguration(
			as = "Tomcat 8.5",
			db = "DB2 9.7",
			jvm = "IBM JDK 8",
			liferayVersion = "7.0",
			name = "QA Test Environment 3",
			os = "Oracle Linux 6",
			patchLevelFile = "patchinfo.txt",
			portalExtFile = "portal-ext.properties",
			product = "Management Tools (LCS)");

		var staticTearDownEnvironmentConfig = "Management Tools (LCS),QA Test Environment 3";

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProduct(product = "Management Tools (LCS)");

		LESATicketCreateEntry.selectComponent(component = "LCS Client");

		LESATicketCreateEntry.selectSavedConfig(savedEnvConfigName = "QA Test Environment 3");

		LESATicketCreateEntry.updateEnvironment(
			appServer = "Tomcat 8.0",
			database = "MySQL 5.7",
			envName = "QA Test Environment 3",
			javaVM = "OpenJDK 8",
			liferayVersion = "7.0",
			operatingSystem = "Debian 8");

		LESANavigation.gotoEnvironmentConfigurations();

		LESAPreferences.viewEnvironmentConfiguration(
			contentList = "Product: Management Tools (LCS),LR: 7.0,OS: Debian 8,JVM: OpenJDK 8,AS: Tomcat 8.0,DB: MySQL 5.7,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt",
			name = "QA Test Environment 3",
			product = "Management Tools (LCS)");
	}

	@priority = "4"
	test ViewNoSavedEnvironmentMessage {
		LESAUser.login(
			userEmailAddress = "${cseEmailAddress}",
			userPassword = "${csePassword}");

		LESANavigation.gotoLESA();

		LESANavigation.gotoEnvironmentConfigurations();

		LESATicketCreateEntry.selectProject(project = "QA Test Project 2");

		LESAMessage.info(message = "There are no saved environment configurations for this product.");
	}

	@priority = "5"
	test ViewNoSavedEnvironmentTab {
		LESAUser.login(
			userEmailAddress = "${partnerEmailAddress}",
			userPassword = "${partnerPassword}");

		LESANavigation.gotoLESA();

		LESAPreferences.assertNoEnvironmentConfigurationsTab();
	}

}