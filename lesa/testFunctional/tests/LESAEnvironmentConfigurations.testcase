<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />
	<property name="group" value="1" />

	<var method="TestPropsUtil#get('lesa.email.address.1')" name="cseEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.1')" name="csePassword" />
	<var method="TestPropsUtil#get('lesa.email.address.4')" name="customerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.4')" name="customerPassword" />
	<var method="TestPropsUtil#get('lesa.email.address.6')" name="partnerEmailAddress" />
	<var method="TestPropsUtil#get('lesa.email.password.6')" name="partnerPassword" />

	<var name="staticTearDownEnvironmentConfig" static="true" value="" />

	<set-up>
		<var name="staticTearDownEnvironmentConfig" value="" />
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownEnvironmentConfig}" arg2="" />
			</not>
			<then>
				<var method="StringUtil#extractLast('${staticTearDownEnvironmentConfig}', ',')" name="name" />
				<var method="StringUtil#extractFirst('${staticTearDownEnvironmentConfig}', ',')" name="product" />

				<execute macro="LESAPreferences#tearDownEnvironmentConfiguration">
					<var name="name" value="${name}" />
					<var name="product" value="${product}" />
				</execute>
			</then>
		</if>

		<execute macro="LESAUser#logout" />
	</tear-down>

	<command name="CreateAndUpdateEnvironment" priority="5">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESAPreferences#createEnvironmentConfiguration">
			<var name="as" value="Wildfly 10.0" />
			<var name="db" value="MySQL 5.6" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="name" value="QA Test Environment 1" />
			<var name="os" value="CentOS 6" />
			<var name="patchLevelFile" value="patchinfo.txt" />
			<var name="portalExtFile" value="portal-ext.properties" />
			<var name="product" value="Developer Tools" />
		</execute>

		<var name="staticTearDownEnvironmentConfig" value="Developer Tools,QA Test Environment 1" />

		<execute macro="LESAPreferences#viewEnvironmentConfiguration">
			<var name="contentList" value="Product: Developer Tools,LR: 7.0,OS: CentOS 6,JVM: IBM JDK 8,AS: Wildfly 10.0,DB: MySQL 5.6,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt" />
			<var name="name" value="QA Test Environment 1" />
			<var name="product" value="Developer Tools" />
		</execute>

		<execute macro="LESAPreferences#updateEnvironmentConfiguration">
			<var name="as" value="Tomcat 8.0" />
			<var name="db" value="MySQL 5.7" />
			<var name="jvm" value="Java 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="name" value="QA Test Environment 1" />
			<var name="newName" value="QA Updated Test Environment 1" />
			<var name="os" value="CentOS 7" />
			<var name="patchLevelFile" value="Document_1.txt" />
			<var name="portalExtFile" value="Document_2.txt" />
			<var name="product" value="Developer Tools" />
		</execute>

		<var name="staticTearDownEnvironmentConfig" value="Developer Tools,QA Updated Test Environment 1" />

		<execute macro="LESAPreferences#viewEnvironmentConfiguration">
			<var name="contentList" value="Product: Developer Tools,LR: 7.0,OS: CentOS 7,JVM: Java 8,AS: Tomcat 8.0,DB: MySQL 5.7,Portal-Ext:  Document_2.txt,Patch Level:  Document_1.txt" />
			<var name="name" value="QA Updated Test Environment 1" />
			<var name="product" value="Developer Tools" />
		</execute>
	</command>

	<command name="CreatePortalEnvironmentViaCreateTicket" priority="5">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 1" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Portal" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectServer">
			<var name="server" value="Production" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectComponent">
			<var name="component" value="Upgrade" />
		</execute>

		<execute macro="LESATicketCreate#createEnvironmentConfiguration">
			<var name="appServer" value="Glassfish 3.1" />
			<var name="database" value="Hypersonic" />
			<var name="envName" value="QA Test Environment 2" />
			<var name="javaVM" value="Java 6" />
			<var name="liferayVersion" value="6.1 GA3 (Limited)" />
			<var name="operatingSystem" value="CentOS 6" />
		</execute>

		<var name="staticTearDownEnvironmentConfig" value="Portal,QA Test Environment 2" />

		<execute macro="LESANavigation#gotoEnvironmentConfigurations" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 1" />
		</execute>

		<execute macro="LESAPreferences#viewEnvironmentConfiguration">
			<var name="contentList" value="Product: Portal Production,LR: 6.1 GA3,OS: CentOS 6,JVM: Java 6,AS: Glassfish 3.1,DB: Hypersonic,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt" />
			<var name="name" value="QA Test Environment 2" />
			<var name="product" value="Portal" />
		</execute>
	</command>

	<command name="UpdateEnvironmentViaCreateTicket" priority="5">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${customerEmailAddress}" />
			<var name="userPassword" value="${customerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESAPreferences#createEnvironmentConfiguration">
			<var name="as" value="Tomcat 8.5" />
			<var name="db" value="DB2 9.7" />
			<var name="jvm" value="IBM JDK 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="name" value="QA Test Environment 3" />
			<var name="os" value="Oracle Linux 6" />
			<var name="patchLevelFile" value="patchinfo.txt" />
			<var name="portalExtFile" value="portal-ext.properties" />
			<var name="product" value="Enterprise Search - Standard Production" />
		</execute>

		<var name="staticTearDownEnvironmentConfig" value="Enterprise Search Standard,QA Test Environment 3" />

		<execute macro="LESATicketCreate#newTicket" />

		<execute macro="LESATicketCreateEntry#selectProduct">
			<var name="product" value="Enterprise Search Standard" />
		</execute>

		<execute macro="LESATicketCreateEntry#selectSavedConfig">
			<var name="savedEnvConfigName" value="QA Test Environment 3" />
		</execute>

		<execute macro="LESATicketCreateEntry#updateEnvironment">
			<var name="appServer" value="Tomcat 8.0" />
			<var name="database" value="MySQL 5.7" />
			<var name="envName" value="QA Test Environment 3" />
			<var name="javaVM" value="Java 8" />
			<var name="liferayVersion" value="7.0" />
			<var name="operatingSystem" value="Debian 8" />
		</execute>

		<execute macro="LESANavigation#gotoEnvironmentConfigurations" />

		<execute macro="LESAPreferences#viewEnvironmentConfiguration">
			<var name="contentList" value="Product: Enterprise Search - Standard Production,LR: 7.0,OS: Debian 8,JVM: Java 8,AS: Tomcat 8.0,DB: MySQL 5.7,Portal-Ext:  portal-ext.properties,Patch Level:  patchinfo.txt" />
			<var name="name" value="QA Test Environment 3" />
			<var name="product" value="Enterprise Search Standard" />
		</execute>
	</command>

	<command name="ViewNoSavedEnvironmentMessage" priority="4">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${cseEmailAddress}" />
			<var name="userPassword" value="${csePassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESANavigation#gotoEnvironmentConfigurations" />

		<execute macro="LESATicketCreateEntry#selectProject">
			<var name="project" value="QA Test Project 2" />
		</execute>

		<execute macro="LESAMessage#info">
			<var name="message" value="There are no saved environment configurations for this product." />
		</execute>
	</command>

	<command name="ViewNoSavedEnvironmentTab" priority="5">
		<execute macro="LESAUser#login">
			<var name="userEmailAddress" value="${partnerEmailAddress}" />
			<var name="userPassword" value="${partnerPassword}" />
		</execute>

		<execute macro="LESANavigation#gotoLESA" />

		<execute macro="LESAPreferences#assertNoEnvironmentConfigurationsTab" />
	</command>
</definition>