<html>
<head>
<title>LESASubscriptionMessages</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESASubscriptionMessages</td></tr>
</thead>
<tbody>
<tr>
	<td>MESSAGE_TITLE</td>
	<td>//div[@id='${key_severity}']//div[contains(@class,'title')]/span[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>MESSAGE_CONTENT</td>
	<td>//div[@id='${key_severity}']//div[contains(@class,'title')]/span[contains(.,'${key_title}')]/../../..//div[@class='inline']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>