<html>
<head>
<title>ProjectAdminEdit</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectAdminEdit</td></tr>
</thead>

<tbody>
<tr>
	<td>SALESFORCE_PROJECT_KEY</td>
	<td>//td[contains(.,'Salesforce Project Key:')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>SALESFORCE_PROJECT_KEY_FIELD</td>
	<td>//input[contains(@id,'salesforceProjectKey')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//input[@value='Edit']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>