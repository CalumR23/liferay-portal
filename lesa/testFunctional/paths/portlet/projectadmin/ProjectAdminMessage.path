<html>
<head>
<title>ProjectAdminMessage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProjectAdminMessage</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_MESSAGE_BUTTON</td>
	<td>//input[@value='Add Message']</td>
	<td></td>
</tr>
<tr>
	<td>CORP_PROJECT_MESSAGE_TITLE_FIELD</td>
	<td>//input[contains(@name,'osbportlet_title')]</td>
	<td></td>
</tr>
<tr>
	<td>CORP_PROJECT_MESSAGE_FIELD</td>
	<td>//textarea[contains(@name,'osbportlet_content')]</td>
	<td></td>
</tr>
<tr>
	<td>SEVERITY_SELECT</td>
	<td>//select[contains(@name,'severityLevel')]</td>
	<td></td>
</tr>
<tr>
	<td>DISPLAY_LESA_CHECKBOX</td>
	<td>//input[contains(@name,'displayLESA')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>