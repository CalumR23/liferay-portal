<html>
<head>
<title>LESAPartner</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESAPartner</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACTS_TAB</td>
	<td>//span[contains(@id,'contacts')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACTS_EMAIL_ADDRESS</td>
	<td>//td[contains(@class,'email-address') and contains(.,'${key_email}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//span[contains(@id,'accounts')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_NAME</td>
	<td>//td[contains(@class,'col-name') and contains(.,'${key_name}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>