<html>
<head>
<title>LESALeftNavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESALeftNavigation</td></tr>
</thead>
<tbody>
<tr>
	<td>HOME_BUTTON</td>
	<td>//div[contains(@id,'homeIcon')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_SUBMENU</td>
	<td>//ul[contains(@id,'homeSubMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_SUBMENU_ITEM</td>
	<td>//ul[contains(@id,'homeSubMenu')]//a[contains(.,'${key_item}')]</td>
	<td></td>
</tr>
<tr>
	<td>LESA_SEARCH_BUTTON</td>
	<td>//div[contains(@id,'advSearchIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>NEW_TICKET_BUTTON</td>
	<td>//div[contains(@id,'newTicketIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>MESSAGES_BUTTON</td>
	<td>//div[contains(@id,'messagesIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>HELP_BUTTON</td>
	<td>//div[contains(@id,'helpIcon')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PREFERENCES_BUTTON</td>
	<td>//div[contains(@id,'settingsIcon')]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>