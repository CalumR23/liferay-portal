<html>
<head>
<title>LESANavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESANavigation</td></tr>
</thead>
<tbody>
<!--Navigation Bar-->
<tr>
	<td>LESA_LIFERAY_SUPPORT_IMG</td>
	<td>//img[@alt='Liferay']</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU</td>
	<td>//div[contains(@id,'sideMenu')]/a[contains(@id,'menuToggle')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_IN</td>
	<td>//div[contains(@id,'sideMenu')]//a[.='Sign In']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_OUT</td>
	<td>//div[contains(@id,'sideMenu')]//a[.='Sign Out']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PORTAL_NAVIGATION_MENU</td>
	<td>//div[contains(@class,'banner')]//div[contains(@class,'class-toggle-off-click menu-navigation')]|//div[contains(@id,'mainMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_PORTAL_NAVIGATION_MENU_CONTROL_PANEL</td>
	<td>//div[contains(@class,'banner')]//a[.='Control Panel']</td>
	<td></td>
</tr>
<tr>
	<td>LESA_BUTTON</td>
	<td>//div[@id='mainNavigation']//li/a[contains(.,'LESA')]</td>
	<td></td>
</tr>
<tr>
	<td>BACK_LINK</td>
	<td>//div[contains(@class,'back-link')]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>