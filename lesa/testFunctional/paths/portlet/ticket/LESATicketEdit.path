<html>
<head>
<title>LESATicketEdit</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketEdit</td></tr>
</thead>
<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>LESATicketCreate</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>EDIT_TICKET_IFRAME</td>
	<td>//iframe[contains(@name,'updateTicketEntry')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_TAB</td>
	<td>//span[contains(@id,'ticketDetails')]</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_DETAILS_TAB</td>
	<td>//span[contains(@id,'environmentDetails')]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVATION_KEY_DETAILS_TAB</td>
	<td>//span[contains(@id,'activationKeyDetails')]</td>
	<td></td>
</tr>
<tr>
	<td>CLUSTERING_DETAILS_TAB</td>
	<td>//span[contains(@id,'clusteringDetails')]</td>
	<td></td>
</tr>
<tr>
	<td>UPGRADE_DETAILS_TAB</td>
	<td>//span[contains(@id,'upgradeDetails')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--TICKET_DETAILS-->
<tr>
	<td>TICKET_DETAILS_SUBCOMPONENT_SELECT</td>
	<td>//select[contains(@id,'subcomponent')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_ESCALATION_LEVEL_SELECT</td>
	<td>//select[contains(@name,'escalationLevel')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_SEVERITY_SELECT</td>
	<td>//div[contains(@id,'ticketDetails')]//select[contains(@name,'severity')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_STATUS_SELECT</td>
	<td>//div[contains(@id,'ticketDetails')]//select[contains(@name,'status')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_RESOLUTION_SELECT</td>
	<td>//div[contains(@id,'ticketDetails')]//select[contains(@id,'resolution')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_NEED_RESPONSE_FROM_CUSTOMER_CHECKBOX</td>
	<td>//div[contains(@id,'editTicketTabContent')]//input[contains(@name,'pendingTypes') and @value='2']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_CHOOSE_PRODUCT_BUTTON</td>
	<td>//span[contains(@id,'productEntryName')]//..//input</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_SUPPORT_REGION_SELECT</td>
	<td>//select[contains(@name,'supportRegionId')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_SUPPORT_LANGUAGE_SELECT</td>
	<td>//select[contains(@name,'languageId')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_CHOOSE_REPORTER_BUTTON</td>
	<td>//span[contains(@id,'reportedByUserName')]//..//input</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_SAVE_BUTTON</td>
	<td>//div[contains(@class,'tab-view-dialog')]/div/input[@value='Save']</td>
	<td></td>
</tr>
<tr>
	<td>TICKET_DETAILS_CANCEL_BUTTON</td>
	<td>//div[contains(@class,'tab-view-dialog')]/div/input[@value='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>