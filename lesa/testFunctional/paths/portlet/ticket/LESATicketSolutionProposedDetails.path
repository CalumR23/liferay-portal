<html>
<head>
<title>LESATicketSolutionProposedDetails</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketSolutionProposedDetails</td></tr>
</thead>

<tbody>
<tr>
	<td>DESCRIPTION_FIELD</td>
	<td>//textarea[contains(@id,'solution')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_1_BUTTON</td>
	<td>//input[@value='Upload New' and contains(@onclick,'file1')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_2_BUTTON</td>
	<td>//input[@value='Upload New' and contains(@onclick,'file2')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_FILE_3_BUTTON</td>
	<td>//input[@value='Upload New' and contains(@onclick,'file3')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_1_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL1')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_1_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType1')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_2_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_2_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType2')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_3_FIELD</td>
	<td>//input[contains(@name,'ticketLinkURL3')]</td>
	<td></td>
</tr>
<tr>
	<td>URL_3_TYPE_SELECT</td>
	<td>//select[contains(@name,'ticketLinkType3')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>