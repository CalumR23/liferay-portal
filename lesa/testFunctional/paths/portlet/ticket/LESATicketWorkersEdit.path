<html>
<head>
<title>LESATicketWorkersEdit</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketWorkersEdit</td></tr>
</thead>

<tbody>
<tr>
	<td>BACK_TO_PREVIOUS_PAGE_BUTTON</td>
	<td>//div[@class='fr']/a</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_TAB</td>
	<td>//span/a[contains(@href,'current')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_TAB</td>
	<td>//span/a[contains(@href,'available')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_ASSOCIATIONS_BUTTON</td>
	<td>//input[@value='Update Associations']</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_SELECT_ALL_CHECKBOX</td>
	<td>//th[contains(@id,'col-rowChecker')]/input</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_CHECKBOX</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_emailAddress}')]/td/input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_ROLE_SELECT</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_emailAddress}')]/td/select</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_ROW_PRIMARY_RADIO</td>
	<td>//tr[contains(@class,'results-row') and contains(.,'${key_emailAddress}')]/td/input[@type='radio']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>