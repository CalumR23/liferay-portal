<html>
<head>
<title>LESATicketDetailsFeedbackPartner</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESATicketDetailsFeedbackPartner</td></tr>
</thead>

<tbody>
<tr>
	<td>REPRODUCIBLE</td>
	<td>//span[contains(.,'reproducible:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>ESCALATED_PROPERLY</td>
	<td>//span[contains(.,'Escalated Properly:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>RESPONSE_TIME</td>
	<td>//span[contains(.,'Response Time:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>TIMELY_ESCALATED</td>
	<td>//span[contains(.,'Timely Escalated:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>TECHNICAL_KNOWLEDGE</td>
	<td>//span[contains(.,'Technical Knowledge:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>PROFESSIONALISM</td>
	<td>//span[contains(.,'Professionalism:')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT</td>
	<td>//div[contains(@id,'feedback')]//div/pre</td>
	<td></td>
</tr>
<tr>
	<td>FEEDBACK_EDIT_FEEDBACK_BUTTON</td>
	<td>//input[@value='Edit Feedback']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>