<html>
<head>
<title>LESAHomepage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESAHomepage</td></tr>
</thead>

<tbody>
<tr>
	<td>NEEDS_RESPONSE</td>
	<td>//div[contains(@id,'needsResponse')]</td>
	<td></td>
</tr>
<tr>
	<td>NEEDS_RESPONSE_TABLE</td>
	<td>//div[contains(@id,'needsResponse')]//div[contains(@class,'need-response')]</td>
	<td></td>
</tr>
<tr>
	<td>IN_PROGRESS_TICKETS</td>
	<td>//div[contains(@id,'inProgress')]</td>
	<td></td>
</tr>
<tr>
	<td>IN_PROGRESS_TICKETS_TABLE</td>
	<td>//div[contains(@id,'inProgress')]//div[contains(@class,'row-url')]</td>
	<td></td>
</tr>
<tr>
	<td>PRIMARY_ASSIGNMENTS</td>
	<td>//div[contains(@id,'primary')]</td>
	<td></td>
</tr>
<tr>
	<td>PRIMARY_ASSIGNMENTS_TABLE</td>
	<td>//div[contains(@id,'primary')]//a[contains(@class,'need-response')]</td>
	<td></td>
</tr>
<tr>
	<td>PRIMARY_ASSIGNMENTS_TICKET</td>
	<td>//div[contains(@id,'primary')]//span[contains(@title,'${key_ticketNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>AUXILIARY_ASSIGNMENTS</td>
	<td>//div[contains(@id,'auxiliary')]</td>
	<td></td>
</tr>
<tr>
	<td>AUXILIARY_ASSIGNMENTS_TABLE</td>
	<td>//div[contains(@id,'auxiliary')]//div[contains(@class,'ticket-row')]</td>
	<td></td>
</tr>
<tr>
	<td>WATCHING</td>
	<td>//div[contains(@id,'watching')]</td>
	<td></td>
</tr>
<tr>
	<td>WATCHING_TABLE</td>
	<td>//div[contains(@id,'watching')]//a[contains(@class,'ticket-row')]</td>
	<td></td>
</tr>
<tr>
	<td>BANNER</td>
	<td>//div[@id='lesaBanner']</td>
	<td></td>
</tr>
<tr>
	<td>BANNER_URGENT</td>
	<td>//span[@class='announcement urgent']</td>
	<td></td>
</tr>
<tr>
	<td>BANNER_MESSAGE</td>
	<td>//span[@class='announcement-text' and contains(.,'${key_message}')]</td>
	<td></td>
</tr>
<tr>
	<td>BANNER_CLOSE_BUTTON</td>
	<td>//div[@class='announcement ${key_level}']/span[contains(@class,'close-announcement')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>