<html>
<head>
<title>LESAEnvironmentConfigurations</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LESAEnvironmentConfigurations</td></tr>
</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>LESATicketCreate</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_NAME</td>
	<td>//form/div/strong</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_ENVIRONMENT_BUTTON</td>
	<td>//input[@value='Create Environment']</td>
	<td></td>
</tr>
<tr>
	<td>SAVED_ENVIRONMENT_CONTENT</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../div[contains(.,'Name: ${key_name}') and contains(.,'${key_content}')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVED_ENVIRONMENT_DELETE_BUTTON</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../div[@class='environment' and contains(.,'Name: ${key_name}')]//input[@value='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>SAVED_ENVIRONMENT_EDIT_BUTTON</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../div[@class='environment' and contains(.,'Name: ${key_name}')]//input[@value='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>DE_OR_PORTAL_SAVED_ENVIRONMENT_CONTENT</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../following-sibling::div[2]//div[contains(.,'Name: ${key_name}') and contains(.,'${key_content}')]</td>
	<td></td>
</tr>
<tr>
	<td>DE_OR_PORTAL_SAVED_ENVIRONMENT_DELETE_BUTTON</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../following-sibling::div[2]//div[contains(.,'Name: ${key_name}')]//input[@value='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>DE_OR_PORTAL_SAVED_ENVIRONMENT_EDIT_BUTTON</td>
	<td>//div[@class='product-heading' and contains(.,'${key_product}')]/../following-sibling::div[2]//div[contains(.,'Name: ${key_name}')]//input[@value='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>ENVIRONMENT_CONFIGURATION_IFRAME</td>
	<td>//iframe[contains(@id,'updateAccountEnvironment')]</td>
	<td></td>
</tr>
<tr>
	<td>NAME_FIELD</td>
	<td>//input[contains(@id,'name')]</td>
	<td></td>
</tr>
<tr>
	<td>PORTAL_EXT_FILE</td>
	<td>//input[contains(@id,'portalExt') and @type='file']</td>
	<td></td>
</tr>
<tr>
	<td>PATCH_LEVEL_FILE</td>
	<td>//input[contains(@id,'patchLevel') and @type='file']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>