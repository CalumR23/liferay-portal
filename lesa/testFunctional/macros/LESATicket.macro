definition {

	macro assertTabNotSelected {
		var key_tabName = "${tabName}";

		AssertElementPresent(locator1 = "LESATicketDetails#TICKET_TAB");

		AssertElementNotPresent(locator1 = "LESATicketDetails#SELECTED_TAB");
	}

	macro assertTabSelected {
		var key_tabName = "${tabName}";

		AssertTextEquals(
			locator1 = "LESATicketDetails#SELECTED_TAB",
			value1 = "${tabName}");
	}

	macro createTicketBasicForm {
		LESANavigation.gotoLESA();

		LESATicketCreate.inputBasicForm(
			appServer = "${appServer}",
			browser = "${browser}",
			component = "${component}",
			configType = "${configType}",
			database = "${database}",
			description = "${description}",
			javaVM = "${javaVM}",
			liferayVersion = "${liferayVersion}",
			operatingSystem = "${operatingSystem}",
			product = "${product}",
			project = "${project}",
			savedEnvConfigName = "${savedEnvConfigName}",
			server = "${server}",
			subcomponent = "${subcomponent}",
			summary = "${summary}",
			systemStatus = "${systemStatus}");

		var ticketNumber = LESATicketCreate.createTicketAndGetTicketNumber();

		return "${ticketNumber}";
	}

}