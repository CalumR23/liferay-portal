definition {

	macro assignWorker {
		LESANavigation.gotoAssignWorkers();

		var key_emailAddress = "${emailAddress}";

		AssertClick(
			locator1 = "LESATicketWorkersEdit#AVAILABLE_TAB",
			value1 = "Available");

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		Type(
			locator1 = "LESATicketWorkersEdit#EMAIL_ADDRESS_FIELD",
			value1 = "${emailAddress}");

		LESAButton.searchAdvanced();

		Check(locator1 = "LESATicketWorkersEdit#RESULT_ROW_CHECKBOX");

		Select(
			locator1 = "LESATicketWorkersEdit#RESULT_ROW_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "LESATicketWorkersEdit#RESULT_ROW_PRIMARY_RADIO");

		Click(locator1 = "LESATicketWorkersEdit#UPDATE_ASSOCIATIONS_BUTTON");

		LESAMessage.success();

		AssertClick.assertPartialTextClickAt(
			locator1 = "LESATicketWorkersEdit#BACK_TO_PREVIOUS_PAGE_BUTTON",
			value1 = "BACK TO PREVIOUS PAGE");

		AssertTextEquals(
			locator1 = "LESATicketDetails#ASSIGNEE_NAME",
			value1 = "${name}");
	}

	macro changeTicketStatus {
		LESATicketTransition.selectTicketStatus(status = "${newStatus}");

		if ("${newStatus}" == "Closed") {
			SelectNoError(
				locator1 = "LESATicketDetails#RESOLUTION_SELECT",
				value1 = "${resolution}");

			Confirm(value1 = "Are you sure you want to modify the status from (${currentStatus}) to (Closed - ${resolution})?");

			LESATicketView.viewTicketResolution(resolution = "(${resolution})");
		}
		else {
			Confirm(value1 = "Are you sure you want to modify the status from (${currentStatus}) to (${newStatus})?");
		}

		LESAMessage.success();

		LESATicketView.viewTicketStatus(status = "${newStatus}");
	}

	macro completeTicket {
		Click(locator1 = "LESATicketDetails#COMPLETE_TICKET_BUTTON");

		LESAMessage.success();

		LESATicketView.viewTicketStatus(status = "Closed");

		LESATicketView.viewTicketResolution(resolution = "(Completed)");
	}

	macro escalateTicket {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Escalate");

		SelectWindow(locator1 = "title=Support");

		ClickNoError(locator1 = "LESAButton#ESCALATE_BUTTON");

		SelectWindow(locator1 = "null");
	}

	macro forwardTicket {
		LESANavigation.gotoForwardTicket();

		Type(
			locator1 = "LESATicketForward#MAIN_GOAL_FIELD",
			value1 = "${mainGoal}");

		Type(
			locator1 = "LESATicketForward#WORK_DONE_FIELD",
			value1 = "${workDone}");

		Type(
			locator1 = "LESATicketForward#CUSTOMER_NEXT_STEPS_FIELD",
			value1 = "${customerNextSteps}");

		Type(
			locator1 = "LESATicketForward#NEXT_REGION_NEXT_STEPS_FIELD",
			value1 = "${nextRegionNextSteps}");

		Click(locator1 = "LESATicketForward#FORWARD_BUTTON");

		LESAMessage.success();

		AssertTextNotEquals(
			locator1 = "LESATicketDetails#ASSIGNEE_NAME",
			value1 = "${name}");
	}

	macro reproduceSteps {
		LESATicketTransition.workflowTicket(workflowStep = "Plan Resolution");

		SelectWindow(locator1 = "title=Support");

		Type(
			locator1 = "LESATicketReproductionSteps#REPRODUCTION_STEPS_FIELD",
			value1 = "${steps}");

		ClickNoError(locator1 = "LESAButton#SAVE_BUTTON");

		SelectWindow(locator1 = "null");

		LESAMessage.success();
	}

	macro selectTicketStatus {
		Click(locator1 = "LESATicketDetails#STATUS");

		SelectNoError(
			locator1 = "LESATicketDetails#STATUS_SELECT",
			value1 = "${status}");
	}

	macro workflowTicket {
		var key_workflowStep = "${workflowStep}";

		Click(locator1 = "LESATicketDetails#WORKFLOW_STEP_BUTTON");
	}

}