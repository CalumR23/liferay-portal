definition {

	macro closeAllBanners {
		for (var level : list "urgent,warning,info,maintenance") {
			var key_level = "${level}";

			while (IsElementPresent(locator1 = "LESAHomepage#BANNER_CLOSE_BUTTON")) {
				Click(locator1 = "LESAHomepage#BANNER_CLOSE_BUTTON");
			}
		}
	}

	macro viewAllInProgressTickets {
		AssertElementPresent(locator1 = "LESAHomepage#IN_PROGRESS_TICKETS");
	}

	macro viewAuxiliaryAssignments {
		if (IsElementPresent(locator1 = "LESAHomepage#AUXILIARY_ASSIGNMENTS")) {
			AssertElementPresent(locator1 = "LESAHomepage#AUXILIARY_ASSIGNMENTS_TABLE");
		}
	}

	macro viewNeedsResponse {
		if (IsElementPresent(locator1 = "LESAHomepage#NEEDS_RESPONSE")) {
			AssertElementPresent(locator1 = "LESAHomepage#NEEDS_RESPONSE_TABLE");
		}
	}

	macro viewPrimaryAssignments {
		AssertElementPresent(locator1 = "LESAHomepage#PRIMARY_ASSIGNMENTS");
	}

	macro viewTicketPrimaryAssignment {
		LESANavigation.gotoHome();

		var key_ticketNumber = "${ticketNumber}";

		AssertTextEquals(
			locator1 = "LESAHomepage#PRIMARY_ASSIGNMENTS_TICKET",
			value1 = "${ticketNumber}");
	}

	macro viewWatching {
		if ("${customer}" == "true") {
			AssertElementNotPresent(locator1 = "LESAHomepage#WATCHING_TABLE");
		}
		else if (IsElementPresent(locator1 = "LESAHomepage#WATCHING")) {
			AssertElementPresent(locator1 = "LESAHomepage#WATCHING_TABLE");
		}
	}

}