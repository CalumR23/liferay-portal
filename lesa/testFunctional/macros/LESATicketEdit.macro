definition {

	macro addAttachment {
		Click(locator1 = "LESATicketDetails#ATTACHMENTS_TAB");

		Click(locator1 = "LESATicketDetails#SELECT_FILE_BUTTON");

		UploadCommonFile(
			locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG_2",
			value1 = "${fileName}");

		LESAButton.save();

		LESAMessage.success();
	}

	macro addLinks {
		Click(locator1 = "LESATicketDetails#LINKS_TAB");

		if (isSet(url)) {
			Type(
				locator1 = "LESATicketDetails#URL_1_FIELD",
				value1 = "${url}");
		}

		if (isSet(url1)) {
			Type(
				locator1 = "LESATicketDetails#URL_1_FIELD",
				value1 = "${url1}");
		}

		if (isSet(url2)) {
			Type(
				locator1 = "LESATicketDetails#URL_2_FIELD",
				value1 = "${url2}");
		}

		if (isSet(url3)) {
			Type(
				locator1 = "LESATicketDetails#URL_3_FIELD",
				value1 = "${url3}");
		}

		Select(
			locator1 = "LESATicketDetails#VISIBILITY_SELECT",
			value1 = "${visibility}");

		Click(locator1 = "LESATicketDetails#SAVE_BUTTON");

		LESAMessage.success();
	}

	macro assertComponentDetailsNotOnTicketDetailsTab {
		LESANavigation.gotoEditTicket();

		AssertNotVisible(locator1 = "LESATicketEdit#TYPE_OF_KEY_SELECT");

		AssertNotVisible(locator1 = "LESATicketEdit#SERVER_COMMUNICATION_TYPE_SELECT");

		AssertNotVisible(locator1 = "LESATicketEdit#DL_PERSISTENCE_SELECT");

		ScrollWebElementIntoView(locator1 = "LESATicketEdit#TICKET_DETAILS_CANCEL_BUTTON");

		Click(locator1 = "LESATicketEdit#TICKET_DETAILS_CANCEL_BUTTON");
	}

	macro assertThreeDotMenuItemNotPresent {
		Click(locator1 = "LESATicketDetails#THREE_DOT_ICON");

		for (var item : list "${menuItemList}") {
			var key_menuItem = "item";

			AssertElementNotPresent(locator1 = "LESATicketDetails#THREE_DOT_MENU_ITEM");
		}
	}

	macro chooseProduct {
		Click(locator1 = "LESATicketEdit#TICKET_DETAILS_CHOOSE_PRODUCT_BUTTON");

		SelectWindow(locator1 = "title=Support");

		Select(
			locator1 = "LESATicketEditChooseProject#ITEMS_SELECT",
			value1 = "100");

		var key_product = "${product}";

		ClickNoError(locator1 = "LESATicketEditChooseProject#CHOOSE_BUTTON");

		SelectWindow(locator1 = "null");
	}

	macro chooseReporter {
		Click(locator1 = "LESATicketEdit#TICKET_DETAILS_CHOOSE_REPORTER_BUTTON");

		SelectWindow(locator1 = "title=Support");

		var key_email = "${reporter}";

		ClickNoError(locator1 = "LESATicketEditChooseReporter#REPORTER_EMAIL");

		SelectWindow(locator1 = "null");
	}

	macro editComponentActivationKey {
		LESANavigation.gotoEditTicket();

		Select(
			locator1 = "LESATicketEdit#COMPONENT_SELECT",
			value1 = "Activation Key");

		AssertClick(
			locator1 = "LESATicketEdit#ACTIVATION_KEY_DETAILS_TAB",
			value1 = "Activation Key Details");

		LESATicketCreate.inputActivationKeyDetails(
			purpose = "${purpose}",
			typeOfKey = "${typeOfKey}");

		LESATicketEdit.save();
	}

	macro editComponentClustering {
		LESANavigation.gotoEditTicket();

		Select(
			locator1 = "LESATicketEdit#COMPONENT_SELECT",
			value1 = "Clustering");

		AssertClick(
			locator1 = "LESATicketEdit#CLUSTERING_DETAILS_TAB",
			value1 = "Clustering Details");

		LESATicketCreate.inputClusteringDetails(serverCommunicationType = "${serverCommunicationType}");

		LESATicketEdit.save();
	}

	macro editComponentUpgrade {
		LESANavigation.gotoEditTicket();

		Select(
			locator1 = "LESATicketEdit#COMPONENT_SELECT",
			value1 = "Upgrade");

		AssertClick(
			locator1 = "LESATicketEdit#UPGRADE_DETAILS_TAB",
			value1 = "Upgrade Details");

		LESATicketCreate.inputUpgradeDetails(
			documentPersistence = "${documentPersistence}",
			upgradeSteps = "${upgradeSteps}");

		LESATicketEdit.save();
	}

	macro editEnvironmentDetails {
		if (isSet(liferayVersion)) {
			Select(
				locator1 = "LESATicketEdit#LIFERAY_VERSION_SELECT",
				value1 = "${liferayVersion}");

			LESATicketView.viewLimitedSupportMessage(liferayVersion = "${liferayVersion}");
		}

		if (isSet(os)) {
			Select(
				locator1 = "LESATicketEdit#OPERATING_SYSTEM_SELECT",
				value1 = "${os}");
		}

		if (isSet(appServer)) {
			Select(
				locator1 = "LESATicketEdit#APPLICATION_SERVER_SELECT",
				value1 = "${appServer}");
		}

		if (isSet(jvm)) {
			Select(
				locator1 = "LESATicketEdit#JAVA_VIRTUAL_MACHINE_SELECT",
				value1 = "${jvm}");
		}

		if (isSet(db)) {
			Select(
				locator1 = "LESATicketEdit#DATABASE_SELECT",
				value1 = "${db}");
		}

		if (isSet(browser)) {
			Select(
				locator1 = "LESATicketEdit#BROWSER_SELECT",
				value1 = "${browser}");
		}

		LESATicketEdit.save();

		LESAMessage.success();
	}

	macro editPending {
		Click(locator1 = "LESATicketDetails#PENDING");

		var containsCustomer = StringUtil.contains("${pendingList}", "Customer");

		if ("${containsCustomer}" == "true") {
			Check(locator1 = "LESATicketDetails#PENDING_CUSTOMER_CHECKBOX");
		}
		else {
			Uncheck(locator1 = "LESATicketDetails#PENDING_CUSTOMER_CHECKBOX");
		}

		var containsLiferay = StringUtil.contains("${pendingList}", "Liferay");

		if ("${containsLiferay}" == "true") {
			Check(locator1 = "LESATicketDetails#PENDING_LIFERAY_CHECKBOX");
		}
		else {
			Uncheck(locator1 = "LESATicketDetails#PENDING_LIFERAY_CHECKBOX");
		}

		var containsPartner = StringUtil.contains("${pendingList}", "Partner");

		if ("${containsPartner}" == "true") {
			Check(locator1 = "LESATicketDetails#PENDING_PARTNER_CHECKBOX");
		}
		else {
			Uncheck(locator1 = "LESATicketDetails#PENDING_PARTNER_CHECKBOX");
		}

		LESAButton.save();

		LESAMessage.success();
	}

	macro editTicketAssignedToAnotherWorker {
		Click(locator1 = "LESATicketDetails#STATUS");

		AssertNotVisible(locator1 = "LESATicketDetails#STATUS_SELECT");

		var key_workflowStep = "Close Ticket";

		AssertElementPresent(locator1 = "LESATicketDetails#WORKFLOW_STEP_BUTTON");

		LESATicketEdit.assertThreeDotMenuItemNotPresent(menuItemList = "Assign Workers,Edit,Escalate,Propose Solution");
	}

	macro editTicketDetails {
		LESANavigation.gotoEditTicket();

		if (isSet(subject)) {
			Type(
				locator1 = "LESATicketEdit#SUMMARY_FIELD",
				value1 = "${subject}");
		}

		if (isSet(description)) {
			Type(
				locator1 = "LESATicketEdit#DESCRIPTION_FIELD",
				value1 = "${description}");
		}

		if (isSet(product)) {
			LESATicketEdit.chooseProduct(product = "${product}");
		}

		if (isSet(component)) {
			Select(
				locator1 = "LESATicketEdit#COMPONENT_SELECT",
				value1 = "${component}");
		}

		if (isSet(subcomponent)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_SUBCOMPONENT_SELECT",
				value1 = "${subcomponent}");
		}

		if (isSet(escalationLevel)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_ESCALATION_LEVEL_SELECT",
				value1 = "${escalationLevel}");
		}

		if (isSet(severity)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_SEVERITY_SELECT",
				value1 = "${severity}");
		}

		ScrollWebElementIntoView(locator1 = "LESATicketEdit#TICKET_DETAILS_SAVE_BUTTON");

		if (isSet(status)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_STATUS_SELECT",
				value1 = "${status}");
		}

		if (isSet(resolution)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_RESOLUTION_SELECT",
				value1 = "${resolution}");
		}

		if (isSet(needsResponseFrom)) {
			if ("${needsResponseFrom}" == "Customer") {
				Check(locator1 = "LESATicketEdit#TICKET_DETAILS_NEED_RESPONSE_FROM_CUSTOMER_CHECKBOX");
			}
		}

		if (isSet(supportRegion)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_SUPPORT_REGION_SELECT",
				value1 = "${supportRegion}");
		}

		if (isSet(supportLanguage)) {
			Select(
				locator1 = "LESATicketEdit#TICKET_DETAILS_SUPPORT_LANGUAGE_SELECT",
				value1 = "${supportLanguage}");
		}

		if (isSet(reporter)) {
			LESATicketEdit.chooseReporter(reporter = "${reporter}");
		}

		LESATicketEdit.save();
	}

	macro removeAllTicketAssignees {
		LESANavigation.gotoAssignWorkers();

		Uncheck(locator1 = "LESATicketWorkersEdit#RESULT_SELECT_ALL_CHECKBOX");

		Click(locator1 = "LESATicketWorkersEdit#UPDATE_ASSOCIATIONS_BUTTON");

		LESAMessage.error(errorMessage = "Your request failed to complete.");

		LESAMessage.error(errorMessage = "Tickets must have at least one worker assigned.");
	}

	macro save {
		ScrollWebElementIntoView(locator1 = "LESATicketEdit#TICKET_DETAILS_SAVE_BUTTON");

		Click(locator1 = "LESATicketEdit#TICKET_DETAILS_SAVE_BUTTON");
	}

	macro viewTicketAsWatcher {
		AssertElementPresent(locator1 = "LESATicketDetails#WATCH_TICKET_BUTTON");

		AssertElementNotPresent(locator1 = "LESATicketDetails#COMPLETE_TICKET_BUTTON");

		AssertElementNotPresent(locator1 = "LESATicketDetails#THREE_DOT_ICON");

		AssertElementNotPresent(locator1 = "LESATicketComment#NEW_COMMENT_FIELD");

		AssertElementNotPresent(locator1 = "LESATicketComment#POST_BUTTON");

		Click(locator1 = "LESATicketDetails#SEVERITY");

		AssertNotVisible(locator1 = "LESATicketDetails#SEVERITY_SELECT");

		Click(locator1 = "LESATicketDetails#PENDING");

		AssertElementNotPresent(locator1 = "LESATicketDetails#PENDING_CUSTOMER_CHECKBOX");

		Click(locator1 = "LESATicketDetails#STATUS");

		AssertNotVisible(locator1 = "LESATicketDetails#STATUS_SELECT");
	}

}