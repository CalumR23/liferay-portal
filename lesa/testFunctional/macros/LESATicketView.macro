definition {

	macro assertNotAssignedTo {
		AssertTextNotEquals(
			locator1 = "LESATicketDetails#ASSIGNEE_NAME",
			value1 = "${name}");
	}

	macro viewActivationKeyDetails {
		AssertClick(
			locator1 = "LESATicketDetails#COMPONENT_DETAILS_TAB",
			value1 = "Activation Key Details");

		AssertTextEquals(
			locator1 = "LESATicketDetails#ACTIVATION_KEY_DETAILS_TYPE_OF_KEY",
			value1 = "Type of Key: ${typeOfKey}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#ACTIVATION_KEY_DETAILS_PURPOSE",
			value1 = "Purpose: ${purpose}");
	}

	macro viewAttachment {
		var key_fileName = "${fileName}";

		Click(locator1 = "LESATicketDetails#ATTACHMENTS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketDetails#ATTACHMENT_FILE_NAME",
			value1 = "${fileName}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#ATTACHED_BY",
			value1 = "${attachedBy}");
	}

	macro viewClusteringDetails {
		AssertClick(
			locator1 = "LESATicketDetails#COMPONENT_DETAILS_TAB",
			value1 = "Clustering Details");

		AssertTextEquals(
			locator1 = "LESATicketDetails#CLUSTERING_DETAILS_SERVER_COMMUNICATION_TYPE",
			value1 = "Server Communication Type: ${serverCommunicationType}");
	}

	macro viewComponent {
		MouseOver(locator1 = "LESATicketDetails#COMPONENT_ICON");

		AssertTextEquals(
			locator1 = "LESATicketDetails#COMPONENT_TOOLTIP",
			value1 = "${component}");
	}

	macro viewComponentDisclaimerMessage {
		AssertTextEquals(
			locator1 = "LESATicketCreate#COMPONENT_MESSAGE",
			value1 = "${componentMessage}");
	}

	macro viewCreateTicketLiferayVersion {
		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "${product}");

		LESATicketCreateEntry.selectServer(server = "${server}");

		if (isSet(component)) {
			Select(
				locator1 = "LESATicketCreate#COMPONENT_SELECT",
				value1 = "${component}");
		}

		Select(
			locator1 = "LESATicketCreate#SAVED_ENV_CONFIG_SELECT",
			value1 = "Select New Configuration");

		Click(locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT");

		if (contains("Management Tools (LCS)", "${product}")) {
			for (var listItem : list "6.2,7.0") {
				var key_item = "${listItem}";

				AssertTextEquals.assertPartialText(
					locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM",
					value1 = "${listItem}");
			}

			for (var listItem : list "5.2,6.0,6.1") {
				var key_item = "${listItem}";

				AssertElementNotPresent(
					locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM",
					value1 = "${listItem}");
			}
		}
		else if (contains("Portal,Mobile Device Detection", "${product}")) {
			var key_item = "7.0";

			AssertElementNotPresent(
				locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM",
				value1 = "${key_item}");

			for (var listItem : list "5.2,6.0,6.1,6.2") {
				var key_item = "${listItem}";

				AssertTextEquals.assertPartialText(
					locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM",
					value1 = "${listItem}");
			}
		}
		else {
			var key_item = "7.0";

			AssertTextEquals.assertPartialText(
				locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM",
				value1 = "${key_item}");

			for (var listItem : list "5.2,6.0,6.1,6.2") {
				var key_item = "${listItem}";

				AssertElementNotPresent(locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT_ITEM");
			}
		}
	}

	macro viewCreateTicketNonActiveProject {
		LESATicketCreate.newTicket();

		var key_projectName = "${projectName}";

		AssertElementNotPresent(locator1 = "LESATicketCreate#PROJECT_SELECT_LIST_ITEM");
	}

	macro viewCreateTicketUpgradeToVersion {
		LESANavigation.gotoLESA();

		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "${product}");

		LESATicketCreateEntry.selectServer(server = "${server}");

		LESATicketCreateEntry.selectComponent(component = "Upgrade");

		LESATicketCreateEntry.selectEnvironmentConfiguration(configuration = "Select New Configuration");

		LESATicketCreateEntry.selectLiferayVersion(liferayVersion = "${liferayVersion}");

		if ("${liferayVersion}" == "7.0") {
			for (var version : list "5.2,6.0,6.1,6.2,Other") {
				var key_option = "${version}";

				AssertElementPresent(locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT_ITEM");
			}

			var key_option = "7.0";

			AssertElementNotPresent(locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT_ITEM");

			AssertElementPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");

			for (var version : list "5.2,6.0,6.1,6.2,Other") {
				var key_option = "${version}";

				AssertElementNotPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");
			}
		}
		else {
			var key_option = "${liferayVersion}";

			AssertElementPresent(locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT_ITEM");

			if ("${liferayVersion}" == "6.2 EE (Limited)") {
				for (var version : list "5.2,6.0,6.1,7.0") {
					var key_option = "${version}";

					AssertElementNotPresent(locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT_ITEM");
				}

				var key_option = "Other";

				AssertElementPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");

				for (var version : list "5.2,6.0,6.1,6.2,7.0") {
					var key_option = "${version}";

					AssertElementNotPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");
				}
			}

			if ("${liferayVersion}" == "6.1 GA3 (Limited)") {
				for (var version : list "5.2,6.0,6.1 GA1, 6.1 GA2,7.0") {
					var key_option = "${version}";

					AssertElementNotPresent(locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT_ITEM");
				}

				for (var version : list "6.2 EE (Limited),Other") {
					var key_option = "${version}";

					AssertElementPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");
				}

				for (var version : list "5.2,6.0,6.1,7.0") {
					var key_option = "${version}";

					AssertElementNotPresent(locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT_ITEM");
				}
			}
		}
	}

	macro viewDescription {
		AssertClick(
			locator1 = "LESATicketDetails#DESCRIPTION_TAB",
			value1 = "Description");

		AssertTextEquals(
			locator1 = "LESATicketDetails#DESCRIPTION_CONTENT",
			value1 = "${description}");
	}

	macro viewEditTicketEnvironmentDetails {
		AssertSelectedLabel(
			locator1 = "LESATicketEdit#LIFERAY_VERSION_SELECT",
			value1 = "${fromLR}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#TO_LIFERAY_VERSION_SELECT",
			value1 = "${toLR}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#OPERATING_SYSTEM_SELECT",
			value1 = "${os}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#APPLICATION_SERVER_SELECT",
			value1 = "${appServer}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#JAVA_VIRTUAL_MACHINE_SELECT",
			value1 = "${jvm}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#DATABASE_SELECT",
			value1 = "${db}");

		AssertSelectedLabel(
			locator1 = "LESATicketEdit#BROWSER_SELECT",
			value1 = "${browser}");
	}

	macro viewEditTicketEnvironmentDetailsNonUpgradeTicket {
		AssertElementNotPresent(locator1 = "LESATicketEdit#TO_LIFERAY_VERSION_SELECT");
	}

	macro viewEscalation {
		AssertTextEquals(
			locator1 = "LESATicketDetails#ESCALATION",
			value1 = "${escalation}");
	}

	macro viewExpiredSupportLabel {
		AssertTextEquals(
			locator1 = "LESATicketDetails#EXPIRED",
			value1 = "EXPIRED");
	}

	macro viewExpiredSupportLabelNotPresent {
		AssertElementNotPresent(locator1 = "LESATicketDetails#EXPIRED");
	}

	macro viewLimitedSupportMessage {
		var version = StringUtil.extractFirst("${liferayVersion}", " ");
		var message = "Please note that the EOSL date for Liferay Portal 5.2 EE has passed and your Support Services may be limited. Please review the Liferay Portal 5.2 End of Version announcement and reach out to your sales representative for available options.";

		if ("${version}" == "6.0") {
			var message = "Please note that the EOSL date for Liferay Portal 6.0 EE has passed and your Support Services may be limited. Please review our End of Service Life Policy and reach out to your sales representative for available options.";
		}

		if ("${version}" == "6.1") {
			var message = "Liferay Portal 6.1 EE GA1, 6.1 EE GA2, and 6.1 EE GA3 are currently in the Limited Support Phase. For more information, please see the End of Service Life Policy.";
		}

		LESAMessage.limitedSupport(message = "${message}");
	}

	macro viewLink {
		Click(locator1 = "LESATicketDetails#LINKS_TAB");

		var key_url = "${url}";
		var key_visibility = "${visibility}";

		AssertElementPresent(locator1 = "LESATicketDetails#LINKS_ROW");

		AssertTextEquals(
			locator1 = "LESATicketDetails#LINKS_URL_LINK",
			value1 = "${url}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#LINKS_VISIBILITY_LINK",
			value1 = "${visibility}");
	}

	macro viewPending {
		AssertTextEquals(
			locator1 = "LESATicketDetails#PENDING",
			value1 = "${pending}");
	}

	macro viewSeverity {
		AssertTextEquals(
			locator1 = "LESATicketDetails#SEVERITY",
			value1 = "${severity}");
	}

	macro viewSubcomponent {
		AssertTextEquals.assertPartialText(
			locator1 = "LESATicketDetails#SUBCOMPONENT",
			value1 = "${subcomponent}");
	}

	macro viewSummary {
		AssertTextEquals(
			locator1 = "LESATicketDetails#SUMMARY",
			value1 = "${summary}");
	}

	macro viewTicketDetails {
		AssertTextNotEquals(
			locator1 = "LESATicketDetails#ASSIGNEE_NAME",
			value1 = "");

		if (isSet(product)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#PRODUCT",
				value1 = "${product}");
		}

		if (isSet(region)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#REGION",
				value1 = "${region}");
		}

		if (isSet(language)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#LANGUAGE",
				value1 = "${language}");
		}

		if (isSet(reporterName)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#REPORTER_NAME",
				value1 = "${reporterName}");
		}

		if (isSet(fromLiferayVersion)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#FROM_LIFERAY_VERSION",
				value1 = "${fromLiferayVersion}");
		}

		if (isSet(toLiferayVersion)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#TO_LIFERAY_VERSION",
				value1 = "${toLiferayVersion}");
		}

		if (isSet(browser)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#BROWSER",
				value1 = "${browser}");
		}
	}

	macro viewTicketDetailsEnvironmentDetails {
		if (isSet(toLR)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#TO_LIFERAY_VERSION",
				value1 = "${toLR}");
		}

		AssertTextEquals(
			locator1 = "LESATicketDetails#FROM_LIFERAY_VERSION",
			value1 = "${fromLR}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#OS",
			value1 = "${os}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#AS",
			value1 = "${appServer}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#JVM",
			value1 = "${jvm}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#DB",
			value1 = "${db}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#BROWSER",
			value1 = "${browser}");
	}

	macro viewTicketResolution {
		AssertTextEquals.assertPartialText(
			locator1 = "LESATicketDetails#RESOLUTION",
			value1 = "${resolution}");
	}

	macro viewTicketStatus {
		AssertTextEquals(
			locator1 = "LESATicketDetails#STATUS",
			value1 = "${status}");
	}

	macro viewUpgradeDetails {
		AssertClick(
			locator1 = "LESATicketDetails#COMPONENT_DETAILS_TAB",
			value1 = "Upgrade Details");

		AssertTextEquals(
			locator1 = "LESATicketDetails#UPGRADE_DETAILS_DOCUMENT_PERSISTENCE",
			value1 = "How is the Document Library server persisting documents? ${documentPersistence}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#UPGRADE_DETAILS_UPGRADE_STEPS",
			value1 = "${upgradeSteps}");
	}

}