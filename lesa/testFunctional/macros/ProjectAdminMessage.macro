<definition>
	<command name="addProjectMessage">
		<var method="selenium#getText(ProjectAdminEdit#SALESFORCE_PROJECT_KEY)" name="salesforceProjectKey" />

		<if>
			<equals arg1="${salesforceProjectKey}" arg2="" />
			<then>
				<execute function="Click" locator1="ProjectAdminEdit#EDIT_BUTTON" />
				<execute function="Type" locator1="ProjectAdminEdit#SALESFORCE_PROJECT_KEY_FIELD" value1="12345" />

				<execute macro="LESAButton#save" />

				<execute macro="LESAMessage#success" />

				<execute function="Click" locator1="LESAButton#CANCEL_BUTTON" />
			</then>
		</if>

		<execute function="Click" locator1="ProjectAdminMessage#ADD_MESSAGE_BUTTON" />
		<execute function="Type" locator1="ProjectAdminMessage#CORP_PROJECT_MESSAGE_TITLE_FIELD" value1="${title}" />
		<execute function="Type" locator1="ProjectAdminMessage#CORP_PROJECT_MESSAGE_FIELD" value1="${message}" />
		<execute function="Select" locator1="ProjectAdminMessage#SEVERITY_SELECT" value1="${severity}" />
		<execute function="Check" locator1="ProjectAdminMessage#DISPLAY_LESA_CHECKBOX" />

		<execute macro="LESAButton#save" />

		<execute macro="LESAMessage#success" />
	</command>

	<command name="deleteProjectMessage">
		<var name="key_code" value="${message}" />

		<execute function="Click" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" />
		<execute function="Click" locator1="OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE" />

		<execute macro="LESAMessage#success" />
	</command>

	<command name="tearDownProjectMessage">
		<execute macro="LESANavigation#gotoProjectAdminMessages">
			<var name="projectCode" value="${projectCode}" />
		</execute>

		<var name="key_code" value="${message}" />

		<while>
			<condition function="IsElementPresent" locator1="OSBAdmin#SEARCH_RESULT_ACTION_BUTTON" />
			<then>
				<execute macro="ProjectAdminMessage#deleteProjectMessage">
					<var name="message" value="${message}" />
				</execute>
			</then>
		</while>
	</command>
</definition>