definition {

	macro addProjectMessage {
		var salesforceProjectKey = selenium.getText("ProjectAdminEdit#SALESFORCE_PROJECT_KEY");

		if ("${salesforceProjectKey}" == "") {
			Click(locator1 = "ProjectAdminEdit#EDIT_BUTTON");

			Type(
				locator1 = "ProjectAdminEdit#SALESFORCE_PROJECT_KEY_FIELD",
				value1 = "12345");

			LESAButton.save();

			LESAMessage.success();

			Click(locator1 = "LESAButton#CANCEL_BUTTON");
		}

		Click(locator1 = "ProjectAdminMessage#ADD_MESSAGE_BUTTON");

		Type(
			locator1 = "ProjectAdminMessage#CORP_PROJECT_MESSAGE_TITLE_FIELD",
			value1 = "${title}");

		Type(
			locator1 = "ProjectAdminMessage#CORP_PROJECT_MESSAGE_FIELD",
			value1 = "${message}");

		Select(
			locator1 = "ProjectAdminMessage#SEVERITY_SELECT",
			value1 = "${severity}");

		Check(locator1 = "ProjectAdminMessage#DISPLAY_LESA_CHECKBOX");

		LESAButton.save();

		LESAMessage.success();
	}

	macro deleteProjectMessage {
		var key_code = "${message}";

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON");

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

		LESAMessage.success();
	}

	macro tearDownProjectMessage {
		LESANavigation.gotoProjectAdminMessages(projectCode = "${projectCode}");

		var key_code = "${message}";

		while (IsElementPresent(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON")) {
			ProjectAdminMessage.deleteProjectMessage(message = "${message}");
		}
	}

}