definition {

	macro selectComponent {
		Select(
			locator1 = "LESATicketCreate#COMPONENT_SELECT",
			value1 = "${component}");
	}

	macro selectEnvironmentConfiguration {
		Select(
			locator1 = "LESATicketCreate#SAVED_ENV_CONFIG_SELECT",
			value1 = "${configuration}");
	}

	macro selectEnvironmentFields {
		Select(
			locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT",
			value1 = "${liferayVersion}");

		Select(
			locator1 = "LESATicketCreate#APPLICATION_SERVER_SELECT",
			value1 = "${appServer}");

		Select(
			locator1 = "LESATicketCreate#OPERATING_SYSTEM_SELECT",
			value1 = "${operatingSystem}");

		Select(
			locator1 = "LESATicketCreate#DATABASE_SELECT",
			value1 = "${database}");

		Select(
			locator1 = "LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT",
			value1 = "${javaVM}");
	}

	macro selectLiferayVersion {
		Select(
			locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT",
			value1 = "${liferayVersion}");
	}

	macro selectNewConfig {
		LESATicketCreateEntry.selectEnvironmentConfiguration(configuration = "Select New Configuration");

		LESATicketCreateEntry.selectEnvironmentFields(
			appServer = "${appServer}",
			database = "${database}",
			javaVM = "${javaVM}",
			liferayVersion = "${liferayVersion}",
			operatingSystem = "${operatingSystem}");

		LESATicketCreateEntry.uploadPatchLevel();

		LESATicketCreateEntry.uploadPortalExt();
	}

	macro selectProduct {
		if (IsElementPresent(locator1 = "LESATicketCreate#PRODUCT_SELECT")) {
			var key_item = "${product}";

			AssertElementPresent(locator1 = "LESATicketCreate#PRODUCT_SELECT_ITEM");

			Select(
				locator1 = "LESATicketCreate#PRODUCT_SELECT",
				value1 = "${product}");
		}
		else {
			AssertTextEquals(
				locator1 = "LESATicketCreate#PRODUCT",
				value1 = "${product}");
		}
	}

	macro selectProject {
		if (IsElementPresent(locator1 = "LESATicketCreate#PROJECT_SELECT")) {
			Select(
				locator1 = "LESATicketCreate#PROJECT_SELECT",
				value1 = "${project}");
		}
		else {
			if (IsElementPresent(locator1 = "LESATicketCreate#PROJECT_NAME")) {
				AssertTextEquals(
					locator1 = "LESATicketCreate#PROJECT_NAME",
					value1 = "${project}");
			}
			else {
				AssertTextEquals(
					locator1 = "LESAEnvironmentConfigurations#PROJECT_NAME",
					value1 = "${project}");
			}
		}
	}

	macro selectSavedConfig {
		LESATicketCreateEntry.selectEnvironmentConfiguration(configuration = "${savedEnvConfigName}");

		// Temporary workaround for LRIS-21152.  Remove this when issue is resolved.

		var liferayVersion = StringUtil.extractLast("${savedEnvConfigName}", " ");

		if ("${liferayVersion}" == "6.2") {
			Select(
				locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT",
				value1 = "6.2 EE (Limited)");
		}
		else {
			Select(
				locator1 = "LESATicketCreate#LIFERAY_VERSION_SELECT",
				value1 = "7.0");
		}

		// End temp workaround

		if (IsElementPresent(locator1 = "LESATicketCreate#PATCH_LEVEL_FILE_NAME")) {
			Check(locator1 = "LESATicketCreate#PATCH_LEVEL_CHECKBOX");
		}
		else {
			LESATicketCreateEntry.uploadPatchLevel();
		}

		if (IsElementPresent(locator1 = "LESATicketCreate#PORTAL_EXT_FILE_NAME")) {
			Check(locator1 = "LESATicketCreate#PORTAL_EXT_CHECKBOX");
		}
		else {
			LESATicketCreateEntry.uploadPortalExt();
		}
	}

	macro selectServer {
		if (IsElementPresent(locator1 = "LESATicketCreate#SERVER_SELECT")) {
			Select(
				locator1 = "LESATicketCreate#SERVER_SELECT",
				value1 = "${server}");
		}
	}

	macro selectSubcomponent {
		Select(
			locator1 = "LESATicketCreate#SUBCOMPONENT_SELECT",
			value1 = "${subcomponent}");
	}

	macro updateEnvironment {
		LESATicketCreateEntry.selectEnvironmentFields(
			appServer = "${appServer}",
			database = "${database}",
			javaVM = "${javaVM}",
			liferayVersion = "${liferayVersion}",
			operatingSystem = "${operatingSystem}");

		ClickNoError(locator1 = "LESATicketCreate#UPDATE_ENVIRONMENT_BUTTON");

		Confirm(value1 = "Are you sure you want to update your saved environment configuration &quot;${envName}&quot;?");
	}

	macro uploadPatchLevel {
		ScrollWebElementIntoView(locator1 = "LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON");

		MouseDown(locator1 = "LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON");

		MouseUp(locator1 = "LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON");

		UploadCommonFile(
			locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG_2",
			value1 = "patchinfo.txt");
	}

	macro uploadPortalExt {
		ScrollWebElementIntoView(locator1 = "LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON");

		MouseDown(locator1 = "LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON");

		MouseUp(locator1 = "LESATicketCreate#UPLOAD_NEW_PORTAL_EXT_BUTTON");

		UploadCommonFile(
			locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG_2",
			value1 = "portal-ext.properties");
	}

	macro uploadToPatchLevel {
		ScrollWebElementIntoView(locator1 = "LESATicketCreate#CREATE_BUTTON");

		MouseDown(locator1 = "LESATicketCreate#UPLOAD_TO_PATCH_LEVEL_BUTTON");

		MouseUp(locator1 = "LESATicketCreate#UPLOAD_TO_PATCH_LEVEL_BUTTON");

		UploadCommonFile(
			locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG_2",
			value1 = "Document_2.txt");

		AssertTextEquals(
			locator1 = "LESATicketCreate#TO_PATCH_LEVEL_FILE_NAME",
			value1 = "Document_2.txt");
	}

	macro uploadToPortalExt {
		MouseDown(locator1 = "LESATicketCreate#UPLOAD_TO_PORTAL_EXT_BUTTON");

		MouseUp(locator1 = "LESATicketCreate#UPLOAD_TO_PORTAL_EXT_BUTTON");

		UploadCommonFile(
			locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG_2",
			value1 = "Document_1.txt");

		AssertTextEquals(
			locator1 = "LESATicketCreate#TO_PORTAL_EXT_FILE_NAME",
			value1 = "Document_1.txt");
	}

}