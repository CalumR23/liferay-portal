definition {

	var liferayURL = PropsUtil.get("portal.url");

	macro login {
		Open(locator1 = "${liferayURL}/group/customer");

		Type(
			locator1 = "LESALogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "LESALogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "LESALogin#SIGN_IN_BUTTON");
	}

	macro logout {
		Open(locator1 = "${liferayURL}/c/portal/logout");
	}

	macro logoutAndLogin {
		LESAUser.logout();

		LESAUser.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

}