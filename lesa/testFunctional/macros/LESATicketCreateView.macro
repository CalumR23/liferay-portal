<definition>
	<command name="assertFormNotLoaded">
		<execute function="AssertElementNotPresent" locator1="LESATicketCreate#PRODUCT_SELECT" />
		<execute function="AssertElementNotPresent" locator1="LESATicketCreate#SERVER_SELECT" />
		<execute function="AssertElementNotPresent" locator1="LESATicketCreate#COMPONENT_SELECT" />
		<execute function="AssertElementNotPresent" locator1="LESATicketCreate#SAVED_ENV_CONFIG_SELECT" />
	</command>

	<command name="viewASDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#APPLICATION_SERVER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewBRDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#BROWSER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewCSDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#CLOUD_SERVER_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewDBDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#DATABASE_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewJVMDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewOSDropdownItems">
		<for list="${itemList}" param="item">
			<var name="key_item" value="${item}" />

			<execute function="AssertElementPresent" locator1="LESATicketCreate#OPERATING_SYSTEM_SELECT_ITEM" value1="${item}" />
		</for>
	</command>

	<command name="viewSHMultiselectItems">
		<if>
			<isset var="itemList" />
			<then>
				<for list="${itemList}" param="item">
					<var name="key_item" value="${item}" />

					<execute function="AssertElementPresent" locator1="LESATicketCreate#SEARCH_SELECT_ITEM" value1="${item}" />
				</for>
			</then>
			<else>
				<execute function="IsNotVisible" locator1="LESATicketCreate#SEARCH_SELECT" />
			</else>
		</if>
	</command>

	<command name="viewUpgradeContactProvisioningDisclaimer">
		<if>
			<equals arg1="${present}" arg2="no" />
			<then>
				<execute function="AssertElementNotPresent" locator1="LESAMessage#UPGRADE_TICKET_CONTACT_PROVISIONING_DISCLAIMER_MESSAGE" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESAMessage#UPGRADE_TICKET_CONTACT_PROVISIONING_DISCLAIMER_MESSAGE" value1="If you require support for a potential upgrade to DXP, please contact your Provisioning representative for further assistance." />
			</else>
		</if>
	</command>

	<command name="viewUpgradePotentialUpgradeDisclaimer">
		<if>
			<equals arg1="${present}" arg2="no" />
			<then>
				<execute function="AssertElementNotPresent" locator1="LESAMessage#UPGRADE_TICKET_POTENTIAL_UPGRADE_DISCLAIMER_MESSAGE" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESAMessage#UPGRADE_TICKET_POTENTIAL_UPGRADE_DISCLAIMER_MESSAGE" value1="If you require support for a potential upgrade to DXP, please choose Digital Experience Platform as your product and Upgrade as your component." />
			</else>
		</if>
	</command>

	<command name="viewUpgradeSavedEnvDisclaimer">
		<if>
			<equals arg1="${present}" arg2="no" />
			<then>
				<execute function="AssertElementNotPresent" locator1="LESAMessage#UPGRADE_TICKET_SAVED_ENV_DISCLAIMER_MESSAGE" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="LESAMessage#UPGRADE_TICKET_SAVED_ENV_DISCLAIMER_MESSAGE" value1="Please provide the environment configuration details for the Liferay DXP environment that you are upgrading to." />
			</else>
		</if>
	</command>

	<command name="viewWatcherMessage">
		<var name="message" value="Watchers cannot create tickets in LESA; please contact your Liferay Provisioning representative to request any changes to your project." />

		<if>
			<equals arg1="${present}" arg2="yes" />
			<then>
				<execute macro="LESAMessage#info">
					<var name="message" value="${message}" />
				</execute>
			</then>
			<else>
				<var name="key_message" value="${message}" />

				<execute function="AssertElementNotPresent" locator1="LESAMessage#INFO_MESSAGE" />
			</else>
		</if>
	</command>
</definition>