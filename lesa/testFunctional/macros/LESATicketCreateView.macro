definition {

	macro assertFormNotLoaded {
		AssertElementNotPresent(locator1 = "LESATicketCreate#PRODUCT_SELECT");

		AssertElementNotPresent(locator1 = "LESATicketCreate#SERVER_SELECT");

		AssertElementNotPresent(locator1 = "LESATicketCreate#COMPONENT_SELECT");

		AssertElementNotPresent(locator1 = "LESATicketCreate#SAVED_ENV_CONFIG_SELECT");
	}

	macro viewASDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#APPLICATION_SERVER_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewBRDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#BROWSER_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewCSDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#CLOUD_SERVER_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewDBDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#DATABASE_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewJVMDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#JAVA_VIRTUAL_MACHINE_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewOSDropdownItems {
		for (var item : list "${itemList}") {
			var key_item = "${item}";

			AssertElementPresent(
				locator1 = "LESATicketCreate#OPERATING_SYSTEM_SELECT_ITEM",
				value1 = "${item}");
		}
	}

	macro viewSHMultiselectItems {
		if (isSet(itemList)) {
			for (var item : list "${itemList}") {
				var key_item = "${item}";

				AssertElementPresent(
					locator1 = "LESATicketCreate#SEARCH_SELECT_ITEM",
					value1 = "${item}");
			}
		}
		else {
			IsNotVisible(locator1 = "LESATicketCreate#SEARCH_SELECT");
		}
	}

	macro viewUpgradeContactProvisioningDisclaimer {
		if ("${present}" == "no") {
			AssertElementNotPresent(locator1 = "LESAMessage#UPGRADE_TICKET_CONTACT_PROVISIONING_DISCLAIMER_MESSAGE");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#UPGRADE_TICKET_CONTACT_PROVISIONING_DISCLAIMER_MESSAGE",
				value1 = "If you require support for a potential upgrade to DXP, please contact your Provisioning representative for further assistance.");
		}
	}

	macro viewUpgradePotentialUpgradeDisclaimer {
		if ("${present}" == "no") {
			AssertElementNotPresent(locator1 = "LESAMessage#UPGRADE_TICKET_POTENTIAL_UPGRADE_DISCLAIMER_MESSAGE");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#UPGRADE_TICKET_POTENTIAL_UPGRADE_DISCLAIMER_MESSAGE",
				value1 = "If you require support for a potential upgrade to DXP, please choose Digital Experience Platform as your product and Upgrade as your component.");
		}
	}

	macro viewUpgradeSavedEnvDisclaimer {
		if ("${present}" == "no") {
			AssertElementNotPresent(locator1 = "LESAMessage#UPGRADE_TICKET_SAVED_ENV_DISCLAIMER_MESSAGE");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#UPGRADE_TICKET_SAVED_ENV_DISCLAIMER_MESSAGE",
				value1 = "Please provide the environment configuration details for the Liferay DXP environment that you are upgrading to.");
		}
	}

	macro viewWatcherMessage {
		var message = "Watchers cannot create tickets in LESA; please contact your Liferay Provisioning representative to request any changes to your project.";

		if ("${present}" == "yes") {
			LESAMessage.info(message = "${message}");
		}
		else {
			var key_message = "${message}";

			AssertElementNotPresent(locator1 = "LESAMessage#INFO_MESSAGE");
		}
	}

}