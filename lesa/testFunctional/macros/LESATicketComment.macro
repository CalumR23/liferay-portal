definition {

	macro addComment {
		LESAHomepage.closeAllBanners();

		if (isSet(commentType)) {
			LESATicketComment.clickCommentTab(commentType = "${commentType}");
		}

		LESATicketComment.inputCommentText(
			comment = "${comment}",
			commentLines = "${commentLines}");

		if (isSet(fileName)) {
			LESATicketComment.inputCommentAttachment(fileName = "${fileName}");
		}

		Click(locator1 = "LESATicketComment#POST_BUTTON");

		LESAMessage.success();
	}

	macro addCommentWithDuplicateAttachment {
		LESATicketComment.inputCommentText(comment = "${comment}.");

		LESATicketComment.inputCommentAttachment(fileName = "${fileName}");

		Click(locator1 = "LESATicketComment#POST_BUTTON");

		LESAMessage.error(errorMessage = "Your request failed to complete.");

		LESAMessage.error(errorMessage = "Please enter a unique document name.");

		var key_comment = "${comment}";

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");
	}

	macro assertCommentNotEditable {
		var key_comment = "${comment}";

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_THREE_DOT_MENU");
	}

	macro autoSaveComment {
		if (isSet(commentType)) {
			LESATicketComment.clickCommentTab(commentType = "${commentType}");
		}

		LESATicketComment.inputCommentText(comment = "${comment}");

		Pause(locator1 = "10000");

		AssertElementPresent(locator1 = "LESATicketComment#SAVED_AS_DRAFT_MESSAGE");

		Refresh();

		LESATicketComment.viewDraftComment(comment = "${comment}");
	}

	macro clickCommentTab {
		if ("${commentType}" == "Public") {
			Click(locator1 = "LESATicketDetails#PUBLIC_TAB");
		}
		else if ("${commentType}" == "Worker") {
			Click(locator1 = "LESATicketDetails#WORKERS_TAB");
		}
		else if ("${commentType}" == "Liferay") {
			Click(locator1 = "LESATicketDetails#LIFERAY_TAB");
		}
	}

	macro deleteDraftComment {
		var key_comment = "${comment}";
		var key_item = "Delete";

		Click(locator1 = "LESATicketComment#COMMENT_THREE_DOT_MENU");

		ClickNoError(locator1 = "LESATicketComment#COMMENT_THREE_DOT_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this?");

		LESAMessage.success();

		AssertElementNotPresent(locator1 = "DRAFT_COMMENT_TEXT");
	}

	macro editComment {
		LESAHomepage.closeAllBanners();

		var key_comment = "${originalComment}";
		var key_item = "Edit";

		Click(locator1 = "LESATicketComment#COMMENT_THREE_DOT_MENU");

		Click(locator1 = "LESATicketComment#COMMENT_THREE_DOT_MENU_ITEM");

		Type(
			locator1 = "LESATicketComment#EDIT_COMMENT_FIELD",
			value1 = "${newComment}");

		Click(locator1 = "LESATicketComment#UPDATE_BUTTON");

		LESAMessage.success();
	}

	macro inputCommentAttachment {
		Click(locator1 = "LESATicketComment#ADD_ATTACHMENTS_BUTTON");

		UploadCommonFile(
			locator1 = "LESATicketComment#BROWSE_1_BUTTON",
			value1 = "${fileName}");
	}

	macro inputCommentText {
		if (isSet(commentLines)) {
			for (var line : list "${commentLines}") {
				KeyPress(
					locator1 = "LESATicketComment#NEW_COMMENT_FIELD",
					value1 = "${line}");

				KeyPress(
					locator1 = "LESATicketComment#NEW_COMMENT_FIELD",
					value1 = "\RETURN");
			}
		}
		else {
			Type(
				locator1 = "LESATicketComment#NEW_COMMENT_FIELD",
				value1 = "${comment}");
		}
	}

	macro viewComment {
		LESATicketComment.clickCommentTab(commentType = "${commentType}");

		var key_comment = "${comment}";

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_TEXT",
			value1 = "${comment}");
	}

	macro viewCommentAsCustomer {
		LESANavigation.gotoTicket(ticketNumber = "${ticketNumber}");

		var key_comment = "${comment}";

		if ("${commentType}" == "Public") {
			AssertTextEquals(
				locator1 = "LESATicketComment#COMMENT_TEXT",
				value1 = "${comment}");

			AssertTextEquals(
				locator1 = "LESATicketComment#COMMENT_CREATOR",
				value1 = "${commentCreator}");
		}
		else {
			AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");
		}
	}

	macro viewCommentAttachment {
		LESATicketComment.clickCommentTab(commentType = "${commentType}");

		var key_comment = "${comment}";

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_ATTACHMENT",
			value1 = "${fileName}");
	}

	macro viewCommentWithReturns {
		LESATicketComment.clickCommentTab(commentType = "${commentType}");

		for (var line : list "${commentLines}") {
			var key_comment = "${line}";

			AssertTextEquals.assertPartialText(
				locator1 = "LESATicketComment#COMMENT_TEXT",
				value1 = "${line}");

			AssertTextEquals(
				locator1 = "LESATicketComment#COMMENT_CREATOR",
				value1 = "${commentCreator}");
		}
	}

	macro viewDraftComment {
		var key_comment = "${comment}";

		AssertTextEquals(
			locator1 = "LESATicketComment#DRAFT_COMMENT_TEXT",
			value1 = "${comment}");
	}

	macro viewLiferayComment {
		var key_comment = "${comment}";

		Click(locator1 = "LESATicketDetails#PUBLIC_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#WORKERS_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#LIFERAY_TAB");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_TEXT",
			value1 = "${comment}");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_CREATOR",
			value1 = "${commentCreator}");

		Click(locator1 = "LESATicketDetails#ALL_COMMENTS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_VISIBILITY",
			value1 = "Visible to Liferay.");
	}

	macro viewPublicComment {
		var key_comment = "${comment}";

		Click(locator1 = "LESATicketDetails#PUBLIC_TAB");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_TEXT",
			value1 = "${comment}");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_CREATOR",
			value1 = "${commentCreator}");

		Click(locator1 = "LESATicketDetails#WORKERS_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#LIFERAY_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#ALL_COMMENTS_TAB");

		AssertElementPresent(locator1 = "LESATicketComment#COMMENT_TEXT");
	}

	macro viewWorkerComment {
		var key_comment = "${comment}";

		Click(locator1 = "LESATicketDetails#PUBLIC_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#WORKERS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_TEXT",
			value1 = "${comment}");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_CREATOR",
			value1 = "${commentCreator}");

		Click(locator1 = "LESATicketDetails#LIFERAY_TAB");

		AssertElementNotPresent(locator1 = "LESATicketComment#COMMENT_TEXT");

		Click(locator1 = "LESATicketDetails#ALL_COMMENTS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_VISIBILITY",
			value1 = "Visible to Workers.");
	}

	macro viewWorkerTabNotPresent {
		AssertElementNotPresent(locator1 = "LESATicketDetails#WORKERS_TAB");
	}

}