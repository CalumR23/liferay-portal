definition {

	macro assertNoEnvironmentConfigurationsTab {
		Click(locator1 = "LESALeftNavigation#PREFERENCES_BUTTON");

		AssertElementNotPresent(locator1 = "LESAPreferences#ENVIRONMENT_CONFIGURATIONS_TAB");
	}

	macro changeStatusViaManagerDashboard {
		LESANavigation.gotoManagerDashboard();

		var key_cseName = "${cseName}";

		if (IsElementPresent(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_IN")) {
			echo("status= in");

			Click(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_TOGGLE");

			MouseOver(locator1 = "LESAPreferences#MANAGER_DASHBOARD_TAB");

			Pause(locator1 = "1000");

			AssertElementNotPresent(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_IN");

			AssertElementPresent(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_ON_PTO");
		}
		else {
			echo("status = on pto");

			Click(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_TOGGLE");

			MouseOver(locator1 = "LESAPreferences#MANAGER_DASHBOARD_TAB");

			Pause(locator1 = "1000");

			AssertElementPresent(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_IN");

			AssertElementNotPresent(locator1 = "LESAPreferences#MANAGER_DASHBOARD_STATUS_ON_PTO");
		}

		LESAMessage.success();
	}

	macro createEnvironmentConfiguration {
		LESANavigation.gotoEnvironmentConfigurations();

		Click(locator1 = "LESAEnvironmentConfigurations#CREATE_ENVIRONMENT_BUTTON");

		LESAPreferences.inputEnvironmentConfigurationFields(
			as = "${as}",
			db = "${db}",
			jvm = "${jvm}",
			liferayVersion = "${liferayVersion}",
			name = "${name}",
			os = "${os}",
			patchLevelFile = "${patchLevelFile}",
			portalExtFile = "${portalExtFile}",
			product = "${product}");

		Click(locator1 = "LESAEnvironmentConfigurations#CREATE_BUTTON");

		SelectWindow(locator1 = "null");
	}

	macro inputEnvironmentConfigurationFields {
		SelectFrame(locator1 = "LESAEnvironmentConfigurations#ENVIRONMENT_CONFIGURATION_IFRAME");

		Type(
			locator1 = "LESAEnvironmentConfigurations#NAME_FIELD",
			value1 = "${name}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#SERVER_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#LIFERAY_VERSION_SELECT",
			value1 = "${liferayVersion}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#OPERATING_SYSTEM_SELECT",
			value1 = "${os}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#JAVA_VIRTUAL_MACHINE_SELECT",
			value1 = "${jvm}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#APPLICATION_SERVER_SELECT",
			value1 = "${as}");

		Select(
			locator1 = "LESAEnvironmentConfigurations#DATABASE_SELECT",
			value1 = "${db}");

		UploadCommonFile(
			locator1 = "LESAEnvironmentConfigurations#PORTAL_EXT_FILE",
			value1 = "${portalExtFile}");

		UploadCommonFile(
			locator1 = "LESAEnvironmentConfigurations#PATCH_LEVEL_FILE",
			value1 = "${patchLevelFile}");
	}

	macro tearDownEnvironmentConfiguration {
		LESANavigation.gotoEnvironmentConfigurations();

		var key_name = "${name}";
		var key_product = "${product}";

		if (("${product}" == "Digital Experience Platform") || ("${product}" == "Portal")) {
			ClickNoError(locator1 = "LESAEnvironmentConfigurations#DE_OR_PORTAL_SAVED_ENVIRONMENT_DELETE_BUTTON");
		}
		else {
			ClickNoError(locator1 = "LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_DELETE_BUTTON");
		}

		Confirm(value1 = "Are you sure you want to delete your saved environment configuration &quot;${name}&quot; permanently? This change cannot be undone.");

		LESAMessage.success();
	}

	macro updateEnvironmentConfiguration {
		LESANavigation.gotoEnvironmentConfigurations();

		var key_name = "${name}";
		var key_product = "${product}";

		if (("${product}" == "Digital Experience Platform") || ("${product}" == "Portal")) {
			Click(locator1 = "LESAEnvironmentConfigurations#DE_OR_PORTAL_SAVED_ENVIRONMENT_EDIT_BUTTON");
		}
		else {
			Click(locator1 = "LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_EDIT_BUTTON");
		}

		LESAPreferences.inputEnvironmentConfigurationFields(
			as = "${as}",
			db = "${db}",
			jvm = "${jvm}",
			liferayVersion = "${liferayVersion}",
			name = "${newName}",
			os = "${os}",
			patchLevelFile = "${patchLevelFile}",
			portalExtFile = "${portalExtFile}",
			product = "${product}");

		Click(locator1 = "LESAButton#UPDATE_BUTTON");

		SelectWindow(locator1 = "null");
	}

	macro viewEnvironmentConfiguration {
		var key_name = "${name}";
		var key_product = "${product}";

		for (var content : list "${contentList}") {
			var key_content = "${content}";

			if (("${product}" == "Digital Experience Platform") || ("${product}" == "Portal")) {
				AssertElementPresent(locator1 = "LESAEnvironmentConfigurations#DE_OR_PORTAL_SAVED_ENVIRONMENT_CONTENT");
			}
			else {
				AssertElementPresent(locator1 = "LESAEnvironmentConfigurations#SAVED_ENVIRONMENT_CONTENT");
			}
		}
	}

}