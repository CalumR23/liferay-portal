definition {

	macro viewContacts {
		Click(locator1 = "LESAPartner#CONTACTS_TAB");

		for (var email : list "${emails}") {
			var key_email = "${email}";

			AssertElementPresent(locator1 = "LESAPartner#CONTACTS_EMAIL_ADDRESS");
		}
	}

	macro viewProjects {
		Click(locator1 = "LESAPartner#PROJECTS_TAB");

		for (var project : list "${projects}") {
			var key_name = "${project}";

			AssertElementPresent(locator1 = "LESAPartner#PROJECTS_NAME");
		}
	}

}