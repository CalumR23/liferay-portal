<definition>
	<command name="viewContacts">
		<execute function="Click" locator1="LESAPartner#CONTACTS_TAB" />

		<for list="${emails}" param="email">
			<var name="key_email" value="${email}" />

			<execute function="AssertElementPresent" locator1="LESAPartner#CONTACTS_EMAIL_ADDRESS" />
		</for>
	</command>

	<command name="viewProjects">
		<execute function="Click" locator1="LESAPartner#PROJECTS_TAB" />

		<for list="${projects}" param="project">
			<var name="key_name" value="${project}" />

			<execute function="AssertElementPresent" locator1="LESAPartner#PROJECTS_NAME" />
		</for>
	</command>
</definition>