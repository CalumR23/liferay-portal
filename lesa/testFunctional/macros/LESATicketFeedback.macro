definition {

	macro assertFeedbackTabNotPresent {
		AssertElementNotPresent(locator1 = "LESATicketDetails#FEEDBACK_TAB");
	}

	macro convertAnswerToCode {
		if ("${answer}" == "Yes") {
			return "1";
		}
		else if ("${answer}" == "No") {
			return "2";
		}
		else {
			return "3";
		}
	}

	macro submitPartnerFeedback {
		Click(locator1 = "LESATicketDetails#FEEDBACK_TAB");

		Click(locator1 = "LESATicketDetailsFeedbackPartner#FEEDBACK_EDIT_FEEDBACK_BUTTON");

		LESAHomepage.closeAllBanners();

		var code = LESATicketFeedback.convertAnswerToCode(answer = "${reproduced}");

		var key_value = "${code}";

		Click(locator1 = "LESATicketFeedbackPartner#REPRODUCED_RADIO");

		var code = LESATicketFeedback.convertAnswerToCode(answer = "${timely}");

		var key_value = "${code}";

		Click(locator1 = "LESATicketFeedbackPartner#TIMELY_MANNER_RADIO");

		var code = LESATicketFeedback.convertAnswerToCode(answer = "${escalatedProperly}");

		var key_value = "${code}";

		Click(locator1 = "LESATicketFeedbackPartner#ESCALATED_PROPERLY_RADIO");

		var key_value = "${responseTime}";

		Click(locator1 = "LESATicketFeedbackPartner#RESPONSE_TIME_RADIO");

		var key_value = "${technicalKnowledge}";

		Click(locator1 = "LESATicketFeedbackPartner#TECHNICAL_KNOWLEDGE_RADIO");

		var key_value = "${professionalism}";

		Click(locator1 = "LESATicketFeedbackPartner#PROFESSIONALISM_RADIO");

		if (isSet(comment)) {
			Type(
				locator1 = "LESATicketFeedbackPartner#COMMENTS_FIELD",
				value1 = "${comment}");
		}

		LESAButton.save();

		LESAMessage.success();
	}

	macro submitReply {
		if ("${reply}" == "Yes") {
			Click(locator1 = "LESATicketFeedback#YES_RADIO_BUTTON");
		}
		else {
			Click(locator1 = "LESATicketFeedback#NO_RADIO_BUTTON");
		}

		if (isSet(comment)) {
			Type(
				locator1 = "LESATicketFeedback#COMMENT_TEXTBOX",
				value1 = "${comment}");
		}

		Click(locator1 = "LESATicketFeedback#SUBMIT_BUTTON");

		LESAMessage.success();

		AssertElementNotPresent(locator1 = "LESATicketDetails#FEEDBACK_TAB");
	}

	macro viewFeedback {
		Click(locator1 = "LESATicketDetails#FEEDBACK_TAB");

		AssertTextEquals(
			locator1 = "LESATicketDetails#FEEDBACK_SUBMITTER_NAME",
			value1 = "${submitter}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#FEEDBACK_REPLY",
			value1 = "${reply}");

		if (isSet(comment)) {
			AssertTextEquals(
				locator1 = "LESATicketDetails#FEEDBACK_REPLY_COMMENT",
				value1 = "${comment}");
		}
		else {
			AssertTextEquals(
				locator1 = "LESATicketDetails#FEEDBACK_REPLY_COMMENT",
				value1 = "");
		}
	}

	macro viewPartnerFeedback {
		Click(locator1 = "LESATicketDetails#FEEDBACK_TAB");

		AssertTextEquals(
			locator1 = "LESATicketDetailsFeedbackPartner#REPRODUCIBLE",
			value1 = "${reproduced}");

		AssertTextEquals(
			locator1 = "LESATicketDetailsFeedbackPartner#ESCALATED_PROPERLY",
			value1 = "${escalatedProperly}");

		AssertTextEquals.assertPartialText(
			locator1 = "LESATicketDetailsFeedbackPartner#RESPONSE_TIME",
			value1 = "${responseTime}");

		AssertTextEquals(
			locator1 = "LESATicketDetailsFeedbackPartner#TIMELY_ESCALATED",
			value1 = "${timely}");

		AssertTextEquals.assertPartialText(
			locator1 = "LESATicketDetailsFeedbackPartner#TECHNICAL_KNOWLEDGE",
			value1 = "${technicalKnowledge}");

		AssertTextEquals.assertPartialText(
			locator1 = "LESATicketDetailsFeedbackPartner#PROFESSIONALISM",
			value1 = "${professionalism}");

		if (isSet(comment)) {
			AssertTextEquals(
				locator1 = "LESATicketDetailsFeedbackPartner#COMMENT",
				value1 = "${comment}");
		}
	}

}