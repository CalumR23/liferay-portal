definition {

	macro cancel {
		LESAHomepage.closeAllBanners();

		Click(locator1 = "LESATicketCreate#CANCEL_BUTTON");
	}

	macro createEnvironmentConfiguration {
		LESATicketCreateEntry.selectNewConfig(
			appServer = "${appServer}",
			database = "${database}",
			javaVM = "${javaVM}",
			liferayVersion = "${liferayVersion}",
			operatingSystem = "${operatingSystem}");

		ClickNoError(locator1 = "LESAEnvironmentConfigurations#CREATE_ENVIRONMENT_BUTTON");

		Confirm.assertPrompt(
			locator1 = "Please enter a valid name for this environment configuration:",
			value1 = "${envName}");
	}

	macro createTicket {
		LESAHomepage.closeAllBanners();

		ScrollWebElementIntoView(locator1 = "LESATicketCreate#CREATE_BUTTON");

		Click(locator1 = "LESATicketCreate#CREATE_BUTTON");
	}

	macro createTicketAndGetTicketNumber {
		LESATicketCreate.createTicket();

		LESAMessage.success();

		var newTicketNumber = selenium.getText("LESATicketDetails#TICKET_NUMBER");

		return "${newTicketNumber}";
	}

	macro inputActivationKeyDetails {
		if (isSet(typeOfKey)) {
			Select(
				locator1 = "LESATicketCreate#TYPE_OF_KEY_SELECT",
				value1 = "${typeOfKey}");
		}

		if (isSet(purpose)) {
			Select(
				locator1 = "LESATicketCreate#PURPOSE_SELECT",
				value1 = "${purpose}");
		}
	}

	macro inputBasicForm {
		LESATicketCreate.newTicket();

		LESATicketCreateEntry.selectProject(project = "${project}");

		LESATicketCreateEntry.selectProduct(product = "${product}");

		if (("${product}" == "Portal") || ("${product}" == "Digital Experience Platform")) {
			LESATicketCreateEntry.selectServer(server = "${server}");
		}
		else {
			AssertElementNotPresent(locator1 = "LESATicketCreate#SERVER_SELECT");
		}

		if (isSet(component)) {
			LESATicketCreateEntry.selectComponent(component = "${component}");
		}

		if (isSet(subcomponent)) {
			LESATicketCreateEntry.selectSubcomponent(subcomponent = "${subcomponent}");
		}

		if ("${configType}" == "saved") {
			LESATicketCreateEntry.selectSavedConfig(savedEnvConfigName = "${savedEnvConfigName}");
		}
		else if ("${configType}" == "new") {
			LESATicketCreateEntry.selectNewConfig(
				appServer = "${appServer}",
				database = "${database}",
				javaVM = "${javaVM}",
				liferayVersion = "${liferayVersion}",
				operatingSystem = "${operatingSystem}");
		}

		if (isSet(browser)) {
			Select(
				locator1 = "LESATicketCreate#BROWSER_SELECT",
				value1 = "${browser}");
		}

		if (isSet(systemStatus)) {
			Select(
				locator1 = "LESATicketCreate#SYSTEM_STATUS_SELECT",
				value1 = "${systemStatus}");
		}

		Type(
			locator1 = "LESATicketCreate#SUMMARY_FIELD",
			value1 = "${summary}");

		Type(
			locator1 = "LESATicketCreate#DESCRIPTION_FIELD",
			value1 = "${description}");
	}

	macro inputClusteringDetails {
		Select(
			locator1 = "LESATicketCreate#SERVER_COMMUNICATION_TYPE_SELECT",
			value1 = "${serverCommunicationType}");

		if (IsElementPresent(locator1 = "LESATicketCreate#UPLOAD_NEW_PATCH_LEVEL_BUTTON")) {
			LESATicketCreateEntry.uploadToPatchLevel();

			LESATicketCreateEntry.uploadToPortalExt();
		}
	}

	macro inputUpgradeDetails {
		if (isSet(fromLiferayVersion)) {
			Select(
				locator1 = "LESATicketCreate#FROM_LIFERAY_VERSION_SELECT",
				value1 = "${fromLiferayVersion}");
		}

		if (isSet(toLiferayVersion)) {
			Select(
				locator1 = "LESATicketCreate#TO_LIFERAY_VERSION_SELECT",
				value1 = "${toLiferayVersion}");
		}

		if (isSet(documentPersistence)) {
			Select(
				locator1 = "LESATicketCreate#DL_PERSISTENCE_SELECT",
				value1 = "${documentPersistence}");
		}

		if (isSet(upgradeSteps)) {
			Type(
				locator1 = "LESATicketCreate#STEPS_USED_FIELD",
				value1 = "${upgradeSteps}");
		}

		if ("${upload}" == "yes") {
			LESATicketCreateEntry.uploadToPatchLevel();

			LESATicketCreateEntry.uploadToPortalExt();
		}
	}

	macro newTicket {
		Click(locator1 = "LESALeftNavigation#NEW_TICKET_BUTTON");
	}

}