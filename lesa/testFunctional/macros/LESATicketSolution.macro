definition {

	macro acceptSolution {
		Click(locator1 = "LESATicketDetails#SOLUTION_TAB");

		AssertClick(
			locator1 = "LESATicketDetails#YES_BUTTON",
			value1 = "YES");

		LESAMessage.success();

		LESATicketView.viewTicketStatus(status = "Closed");

		LESATicketView.viewTicketResolution(resolution = "(Completed)");
	}

	macro proposeSolution {
		SelectWindow(locator1 = "title=Support");

		Type(
			locator1 = "LESATicketSolutionProposedDetails#DESCRIPTION_FIELD",
			value1 = "${solutionDescription}");

		ScrollWebElementIntoView(locator1 = "LESATicketSolutionProposedDetails#URL_1_FIELD");

		if (isSet(fileName)) {
			MouseDown(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON");

			MouseUp(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON");

			UploadCommonFile(
				locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG",
				value1 = "${fileName}");
		}

		if (isSet(fileName1)) {
			MouseDown(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON");

			MouseUp(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_1_BUTTON");

			UploadCommonFile(
				locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG",
				value1 = "${fileName1}");
		}

		if (isSet(fileName2)) {
			MouseDown(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_2_BUTTON");

			MouseUp(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_2_BUTTON");

			UploadCommonFile(
				locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG",
				value1 = "${fileName2}");
		}

		if (isSet(fileName3)) {
			MouseDown(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_3_BUTTON");

			MouseUp(locator1 = "LESATicketSolutionProposedDetails#UPLOAD_FILE_3_BUTTON");

			UploadCommonFile(
				locator1 = "LESAOS#FILE_DIALOG_BOX_TYPE_FILE_NAME_ICON_PNG",
				value1 = "${fileName3}");
		}

		if (isSet(url)) {
			Type(
				locator1 = "LESATicketSolutionProposedDetails#URL_1_FIELD",
				value1 = "${url}");

			if (IsElementPresent(locator1 = "LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT")) {
				Select(
					locator1 = "LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT",
					value1 = "${urlType}");
			}
		}

		if (isSet(url1)) {
			Type(
				locator1 = "LESATicketSolutionProposedDetails#URL_1_FIELD",
				value1 = "${url1}");

			if (IsElementPresent(locator1 = "LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT")) {
				Select(
					locator1 = "LESATicketSolutionProposedDetails#URL_1_TYPE_SELECT",
					value1 = "${urlType1}");
			}
		}

		if (isSet(url2)) {
			Type(
				locator1 = "LESATicketSolutionProposedDetails#URL_2_FIELD",
				value1 = "${url2}");

			if (IsElementPresent(locator1 = "LESATicketSolutionProposedDetails#URL_2_TYPE_SELECT")) {
				Select(
					locator1 = "LESATicketSolutionProposedDetails#URL_2_TYPE_SELECT",
					value1 = "${urlType2}");
			}
		}

		if (isSet(url3)) {
			Type(
				locator1 = "LESATicketSolutionProposedDetails#URL_3_FIELD",
				value1 = "${url3}");

			if (IsElementPresent(locator1 = "LESATicketSolutionProposedDetails#URL_3_TYPE_SELECT")) {
				Select(
					locator1 = "LESATicketSolutionProposedDetails#URL_3_TYPE_SELECT",
					value1 = "${urlType3}");
			}
		}

		LESAButton.send();

		SelectWindow(locator1 = "null");

		LESATicketView.viewTicketStatus(status = "Solution Proposed");
	}

	macro rejectSolution {
		Click(locator1 = "LESATicketDetails#SOLUTION_TAB");

		AssertClick(
			locator1 = "LESATicketDetails#NO_BUTTON",
			value1 = "NO");

		Select(
			locator1 = "LESATicketSolutionRejected#REASON_SELECT",
			value1 = "${reason}");

		Type(
			locator1 = "LESATicketSolutionRejected#EXPLANATION_FIELD",
			value1 = "${explanation}");

		LESAButton.send();

		LESAMessage.success();

		LESATicketView.viewTicketStatus(status = "In Diagnosis");
	}

	macro viewProposedSolution {
		Click(locator1 = "LESATicketDetails#SOLUTION_TAB");

		if (isSet(issueSummary)) {
			AssertTextEquals.assertPartialText(
				locator1 = "LESATicketDetails#ISSUE_SUMMARY",
				value1 = "${issueSummary}");
		}

		AssertTextEquals(
			locator1 = "LESATicketDetails#SOLUTION_DESCRIPTION",
			value1 = "${solutionDescription}");

		if (isSet(fileNames)) {
			for (var file : list "${fileNames}") {
				var key_fileName = "${file}";

				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTION_ATTACHMENTS",
					value1 = "${file}");
			}
		}

		if (isSet(urls)) {
			for (var url : list "${urls}") {
				var key_url = "${url}";

				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTION_LINKS",
					value1 = "${url}");
			}
		}
	}

	macro viewProposedSolutionComment {
		Click(locator1 = "LESATicketDetails#SOLUTIONS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketDetails#SOLUTIONS_PROPOSER_NAME",
			value1 = "${solutionProposer}");

		if (isSet(issueSummary)) {
			AssertTextEquals.assertPartialText(
				locator1 = "LESATicketDetails#SOLUTIONS_ISSUE_SUMMARY",
				value1 = "${issueSummary}");

			AssertTextEquals(
				locator1 = "LESATicketDetails#SOLUTIONS_DESCRIPTION",
				value1 = "${solutionDescription}");
		}

		if (isSet(fileNames)) {
			for (var file : list "${fileNames}") {
				var key_fileName = "${file}";

				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTIONS_ATTACHMENTS",
					value1 = "${file}");
			}
		}

		if (isSet(url)) {
			var key_url = "${url}";

			AssertTextEquals(
				locator1 = "LESATicketDetails#SOLUTIONS_LINK",
				value1 = "${url}");

			if (IsElementPresent(locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE")) {
				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE",
					value1 = "${urlType}");
			}
		}

		if (isSet(url1)) {
			var key_url = "${url1}";

			AssertTextEquals(
				locator1 = "LESATicketDetails#SOLUTIONS_LINK",
				value1 = "${url1}");

			if (IsElementPresent(locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE")) {
				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE",
					value1 = "${urlType1}");
			}
		}

		if (isSet(url2)) {
			var key_url = "${url2}";

			AssertTextEquals(
				locator1 = "LESATicketDetails#SOLUTIONS_LINK",
				value1 = "${url2}");

			if (IsElementPresent(locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE")) {
				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE",
					value1 = "${urlType2}");
			}
		}

		if (isSet(url3)) {
			var key_url = "${url3}";

			AssertTextEquals(
				locator1 = "LESATicketDetails#SOLUTIONS_LINK",
				value1 = "${url3}");

			if (IsElementPresent(locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE")) {
				AssertTextEquals(
					locator1 = "LESATicketDetails#SOLUTIONS_LINK_TYPE",
					value1 = "${urlType3}");
			}
		}
	}

	macro viewProposedSolutionPublicComment {
		Click(locator1 = "LESATicketDetails#PUBLIC_TAB");

		var key_comment = "${solutionDescription}";

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_CREATOR",
			value1 = "${solutionProposer}");

		AssertTextEquals(
			locator1 = "LESATicketComment#COMMENT_TEXT",
			value1 = "Solution: ${solutionDescription}");

		if (isSet(fileNames)) {
			for (var file : list "${fileNames}") {
				var key_fileName = "${file}";

				AssertTextEquals(
					locator1 = "LESATicketComment#COMMENT_ATTACHMENT_WITHOUT_COMMENT_TEXT",
					value1 = "${file}");
			}
		}

		if (isSet(urls)) {
			for (var url : list "${urls}") {
				var key_url = "${url}";

				AssertTextEquals(
					locator1 = "LESATicketComment#SOLUTION_COMMENT_LINK",
					value1 = "${url}");
			}
		}

		AssertElementPresent(locator1 = "LESATicketComment#SOLUTION_COMMENT_FOOTER");
	}

	macro viewRejectedSolutionComment {
		Click(locator1 = "LESATicketDetails#SOLUTIONS_TAB");

		AssertTextEquals(
			locator1 = "LESATicketDetails#REJECTER_NAME",
			value1 = "${rejecter}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#REJECTED_REASON",
			value1 = "Solution Rejected: ${reason}");

		AssertTextEquals(
			locator1 = "LESATicketDetails#REJECTED_EXPLANATION",
			value1 = "${explanation}");
	}

}