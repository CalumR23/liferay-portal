definition {

	var customerPortalURL = "/group/customer";

	macro back {
		Click(locator1 = "LESANavigation#BACK_LINK");
	}

	macro gotoAssignWorkers {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Assign Workers");
	}

	macro gotoEditProject {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Edit");

		SelectFrame(locator1 = "LESAProjectDetailsEdit#EDIT_PROJECT_IFRAME");
	}

	macro gotoEditTicket {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Edit");
	}

	macro gotoEnvironmentConfigurations {
		Click(locator1 = "LESALeftNavigation#PREFERENCES_BUTTON");

		AssertClick(
			locator1 = "LESAPreferences#ENVIRONMENT_CONFIGURATIONS_TAB",
			value1 = "Environment Configurations");
	}

	macro gotoEnvironmentDetails {
		LESANavigation.gotoEditTicket();

		AssertClick(
			locator1 = "LESATicketEdit#ENVIRONMENT_DETAILS_TAB",
			value1 = "Environment Details");
	}

	macro gotoForwardTicket {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Forward");
	}

	macro gotoHelp {
		LESANavigation.gotoLESA();

		Click(locator1 = "LESALeftNavigation#HELP_BUTTON");
	}

	macro gotoHome {
		Click(locator1 = "LESALeftNavigation#HOME_BUTTON");

		if (IsElementPresent(locator1 = "LESALeftNavigation#HOME_SUBMENU")) {
			var key_item = "My Open Tickets";

			AssertClick(
				locator1 = "LESALeftNavigation#HOME_SUBMENU_ITEM",
				value1 = "${key_item}");
		}
	}

	macro gotoLESA {
		Open(locator1 = "${customerPortalURL}");

		Click(locator1 = "LESANavigation#LESA_BUTTON");
	}

	macro gotoLESASearch {
		if (IsElementNotPresent(locator1 = "LESANavigation#LESA_LIFERAY_SUPPORT_IMG")) {
			LESANavigation.gotoLESA();
		}

		Click(locator1 = "LESALeftNavigation#LESA_SEARCH_BUTTON");
	}

	macro gotoManagerDashboard {
		Click(locator1 = "LESALeftNavigation#PREFERENCES_BUTTON");

		AssertClick(
			locator1 = "LESAPreferences#MANAGER_DASHBOARD_TAB",
			value1 = "Manager Dashboard");
	}

	macro gotoProjectAdminMessages {
		OSBAdminNavigation.gotoControlPanel();

		OSBAdminProject.gotoAccount(projectCode = "QAPROJECT1");

		Click(locator1 = "OSBAdminAccountAdd#PROJECT_MESSAGES_TAB");

		Click(locator1 = "OSBAdminAccountAdd#MANAGE_MESSAGES_BUTTON");
	}

	macro gotoProposeSolution {
		LESANavigation.gotoTicketThreeDotMenuItem(menuItem = "Propose Solution");
	}

	macro gotoTicket {
		LESANavigation.gotoLESA();

		LESASearch.search(keyword = "${ticketNumber}");
	}

	macro gotoTicketAsDifferentUser {
		LESAUser.logoutAndLogin(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");

		LESANavigation.gotoTicket(ticketNumber = "${ticketNumber}");
	}

	macro gotoTicketThreeDotMenuItem {
		var key_menuItem = "${menuItem}";

		Click(locator1 = "LESATicketDetails#THREE_DOT_ICON");

		AssertClick(
			locator1 = "LESATicketDetails#THREE_DOT_MENU_ITEM",
			value1 = "${menuItem}");
	}

}