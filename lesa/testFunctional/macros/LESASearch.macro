definition {

	macro assertTicketCountEqual {
		AssertElementPresent(locator1 = "LESASearch#RESULT_TABLE_PAGE_LINKS");

		AssertTextEquals(
			locator1 = "LESASearch#TICKET_COUNT",
			value1 = "${ticketCount}");
	}

	macro assertTicketCountNotEqual {
		AssertTextNotEquals(
			locator1 = "LESASearch#TICKET_COUNT",
			value1 = "${ticketCount}");
	}

	macro assertTicketNotInResult {
		var key_ticketNumber = "${ticketNumber}";

		AssertElementNotPresent(locator1 = "LESASearch#RESULT_ROW_NUMBER");
	}

	macro bulkEditAssignee {
		LESASearch.checkManagerMode();

		LESASearch.bulkEditSelectAll();

		Click(locator1 = "LESASearch#BULK_EDIT_EDIT_BUTTON");

		Select(
			locator1 = "LESASearch#BULK_EDIT_ASSIGNEE_SELECT",
			value1 = "${assignee}");

		ClickNoError(locator1 = "LESAButton#SAVE_BUTTON");

		Confirm(value1 = "Are you sure you want to make these changes?");

		LESAMessage.success();
	}

	macro bulkEditSelectAll {
		Click(locator1 = "LESASearch#BULK_EDIT_SELECT");

		var key_option = "Select All";

		Click(locator1 = "LESASearch#BULK_EDIT_SELECT_OPTION");
	}

	macro bulkEditSelectNone {
		Click(locator1 = "LESASearch#BULK_EDIT_SELECT");

		var key_option = "Select None";

		Click(locator1 = "LESASearch#BULK_EDIT_SELECT_OPTION");
	}

	macro bulkEditViewDisclaimer {
		Click(locator1 = "LESASearch#BULK_EDIT_EDIT_BUTTON");

		LESAMessage.info(message = "Please choose to assign these tickets to a single assignee or to a support office which distributes the tickets to the available support engineers in that office. Please note that any partner managed or closed tickets will be excluded from any bulk edits.");
	}

	macro bulkEditViewValidationMessages {
		Select(
			locator1 = "LESASearch#BULK_EDIT_ASSIGNEE_SELECT",
			value1 = "QATest CSE2 (lesa.qa.cse.2@liferay.com.broken)");

		Select(
			locator1 = "LESASearch#BULK_EDIT_SUPPORT_REGION_SELECT",
			value1 = "China");

		LESAMessage.error(errorMessage = "Please select an assignee or a support office. You cannot choose both.");

		LESAButton.save();

		LESAMessage.error(errorMessage = "Please select an assignee or a support office. You cannot choose both.");

		Select(
			locator1 = "LESASearch#BULK_EDIT_SUPPORT_REGION_SELECT",
			value1 = "");

		var key_errorMessage = "Please select an assignee or a support office. You cannot choose both.";

		AssertNotVisible(locator1 = "LESAMessage#ERROR_MESSAGE_2");

		LESAButton.save();
	}

	macro checkManagerMode {
		var key_filter = "Manager Mode";

		Click(locator1 = "LESASearch#TICKETS_TAB");

		Click(locator1 = "LESASearch#TICKETS_TAB_FILTER");
	}

	macro checkTicketStatus {
		var key_status = "${status}";

		Check(locator1 = "LESASearch#TICKETS_TAB_STATUS_CHECKBOX");
	}

	macro createCustomFilter {
		ClickNoError(locator1 = "LESASearch#CREATE_FILTER_BUTTON");

		Confirm.assertPrompt(
			locator1 = "Please enter a valid name for this filter:",
			value1 = "${filterName}");

		LESAMessage.success();
	}

	macro createDuplicateCustomFilter {
		ClickNoError(locator1 = "LESASearch#CREATE_FILTER_BUTTON");

		Confirm.assertPrompt(
			locator1 = "Please enter a valid name for this filter:",
			value1 = "${filterName}");

		Confirm.assertPrompt(
			locator1 = "&quot;${filterName}&quot; already exists. Please choose a different name for this custom filter.",
			value1 = "${newFilterName}");

		LESAMessage.success();
	}

	macro deleteCustomFilter {
		LESASearch.selectCustomFilter(menuItem = "${filterName}");

		Click(locator1 = "LESASearch#CUSTOM_FILTER_THREE_DOT_MENU");

		var key_item = "Delete Filter";

		ClickNoError(locator1 = "LESASearch#CUSTOM_FILTER_THREE_DOT_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete your saved custom filter &quot;${filterName}&quot; permanently? This change cannot be undone.");

		LESAMessage.success();
	}

	macro displayTicketsAssigneeFilters {
		if (IsNotVisible(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON")) {
			var key_filter = "Assignee";

			Click(locator1 = "LESASearch#TICKETS_TAB");

			Click(locator1 = "LESASearch#TICKETS_TAB_FILTER");
		}
	}

	macro filterFeedbackByAssignee {
		Click(locator1 = "LESASearch#FEEDBACK_TAB");

		var key_filter = "Assignee";

		AssertClick(
			locator1 = "LESASearch#FEEDBACK_TAB_FILTER",
			value1 = "Assignee");

		Click(locator1 = "LESASearch#FEEDBACK_TAB_CHOOSE_ASSIGNEE_BUTTON");

		SelectWindow(locator1 = "title=Support");

		Type(
			locator1 = "LESASearchTicketsChooseAssignee#BASIC_SEARCH_KEYWORD_FIELD",
			value1 = "${partner}");

		LESAButton.search();

		var key_name = "${partner}";

		AssertClick(
			locator1 = "LESASearchTicketsChooseAssignee#SEARCH_RESULT_NAME",
			value1 = "${partner}");

		Close.closeWindow(locator1 = "title=Support");

		SelectWindow(locator1 = "null");
	}

	macro filterTicketsByProject {
		if (IsNotVisible(locator1 = "LESASearch#TICKETS_TAB_ALL_SELECTED_PROJECTS")) {
			var key_filter = "Project";

			AssertClick(
				locator1 = "LESASearch#TICKETS_TAB_FILTER",
				value1 = "Project");
		}

		var key_filter = "Project";

		Click(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON");

		SelectWindow(locator1 = "title=Support");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");

		var key_name = "${projectName}";

		AssertClick(
			locator1 = "LESASearchTicketsChooseProject#SEARCH_RESULT_NAME",
			value1 = "${projectName}");

		Close.closeWindow(locator1 = "title=Support");

		SelectWindow(locator1 = "null");
	}

	macro filterTicketsByStatusAndResolution {
		var key_filter = "Status";

		Click(locator1 = "LESASearch#TICKETS_TAB_FILTER");

		if (isSet(status)) {
			LESASearch.checkTicketStatus(status = "${status}");
		}

		if (isSet(resolution)) {
			LESASearch.checkTicketStatus(status = "${resolution}");
		}
	}

	macro getTicketCount {
		AssertElementPresent(locator1 = "LESASearch#RESULT_TABLE_PAGE_LINKS");

		var ticketCount = selenium.getText("LESASearch#TICKET_COUNT");

		return "${ticketCount}";
	}

	macro gotoSearchResultTicket {
		var key_ticketNumber = "${ticketNumber}";

		Click(locator1 = "LESASearch#RESULT_ROW_NUMBER");
	}

	macro removeFilterTicketsAccountWorker {
		LESASearch.displayTicketsAssigneeFilters();

		for (var worker : list "${accountWorkerList}") {
			var key_accountWorker = "${worker}";

			AssertClick.assertPartialTextClickAt(
				locator1 = "LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER",
				value1 = "${worker}");

			AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER");
		}
	}

	macro removeFilterTicketsAssignee {
		LESASearch.displayTicketsAssigneeFilters();

		for (var assignee : list "${assigneeList}") {
			var key_assignee = "${assignee}";

			AssertClick(
				locator1 = "LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE",
				value1 = "${assignee}");

			AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE");
		}
	}

	macro search {
		Click(locator1 = "LESALeftNavigation#LESA_SEARCH_BUTTON");

		LESASearch.searchByKeyword(keyword = "${keyword}");
	}

	macro searchAndSelectByName {
		SelectWindow(locator1 = "title=Support");

		for (var name : list "${nameList}") {
			OSBAdminSearch.searchBasic(keyword = "${name}");

			var key_name = "${name}";

			AssertClick(
				locator1 = "LESASearchTicketsChooseAssignee#SEARCH_RESULT_NAME",
				value1 = "${name}");
		}

		Close.closeWindow(locator1 = "title=Support");

		SelectWindow(locator1 = "null");
	}

	macro searchByKeyword {
		Type(
			locator1 = "LESASearch#KEYWORD_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "LESASearch#KEYWORD_FIELD",
			value1 = "\RETURN");
	}

	macro searchPartner {
		LESASearch.search(keyword = "${partner}");

		AssertClick(
			locator1 = "LESASearch#PARTNERS_TAB",
			value1 = "Partners(-)");

		var key_partner = "${partner}";

		Click(locator1 = "LESASearch#RESULT_ROW_PARTNER_NAME");
	}

	macro searchPartnersViaTicketsChooseAssignee {
		var key_filter = "Assignee";

		Click(locator1 = "LESASearch#TICKETS_TAB_FILTER");

		Click(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON");

		SelectWindow(locator1 = "title=Support");

		AssertClick(
			locator1 = "LESASearchTicketsChooseAssignee#PARTNERS_TAB",
			value1 = "Partners");

		OSBAdminSearch.toggleSearch(searchType = "Advanced");

		if (isSet(managingSupport)) {
			Select(
				locator1 = "LESASearchTicketsChooseAssignee#PARTNERS_MANAGING_SUPPORT_SELECT",
				value1 = "${managingSupport}");
		}

		if (isSet(code)) {
			Type(
				locator1 = "LESASearchTicketsChooseAssignee#PARTNERS_CODE_FIELD",
				value1 = "${code}");
		}

		LESAButton.searchAdvanced();

		AssertElementNotPresent(locator1 = "LESASearchTicketsChooseAssignee#SUPPORT_UNAVAILABLE_MESSAGE");

		if (isSet(code)) {
			var key_code = "${code}";

			ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");
		}

		Close.closeWindow(locator1 = "title=Support");

		SelectWindow(locator1 = "null");
	}

	macro searchProject {
		LESASearch.search(keyword = "${projectCode}");

		AssertClick(
			locator1 = "LESASearch#PROJECTS_TAB",
			value1 = "Projects(-)");

		Pause(locator1 = "1000");

		var key_projectCode = "${projectCode}";

		Click(locator1 = "LESASearch#RESULT_ROW_PROJECT_CODE");
	}

	macro selectCustomFilter {
		Click(locator1 = "LESALeftNavigation#HOME_BUTTON");

		var key_item = "${menuItem}";

		AssertClick(
			locator1 = "LESALeftNavigation#HOME_SUBMENU_ITEM",
			value1 = "${menuItem}");
	}

	macro selectFilterTicketsAccountWorker {
		LESASearch.displayTicketsAssigneeFilters();

		Click(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON");

		LESASearch.searchAndSelectByName(nameList = "${accountWorkerList}");
	}

	macro selectFilterTicketsAssignee {
		LESASearch.displayTicketsAssigneeFilters();

		Click(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON");

		LESASearch.searchAndSelectByName(nameList = "${assigneeList}");
	}

	macro sortByTicketNumberDescending {
		var key_column = "Ticket Number";
		var key_sort = "down";

		while (IsElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_SORT_ARROW")) {
			Click(locator1 = "LESASearch#TICKETS_TAB_TICKET_NUMBER");
		}
	}

	macro updateCustomFilter {
		Click(locator1 = "LESASearch#CUSTOM_FILTER_THREE_DOT_MENU");

		var key_item = "Update Filter";

		ClickNoError(locator1 = "LESASearch#CUSTOM_FILTER_THREE_DOT_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to update your saved custom filter &quot;${filterName}&quot;? Any existing search settings will be overwritten.");

		LESAMessage.success();
	}

	macro viewCustomFilters {
		Click(locator1 = "LESALeftNavigation#HOME_BUTTON");

		for (var filterName : list "${filterNames}") {
			var key_item = "${filterName}";

			AssertTextEquals(
				locator1 = "LESALeftNavigation#HOME_SUBMENU_ITEM",
				value1 = "${filterName}");
		}
	}

	macro viewManagerModeFilters {
		var key_filter = "Severity";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Severity");

		var key_escalationLevel = "1";

		AssertChecked(locator1 = "LESASearch#TICKETS_TAB_ESCALATION_LEVEL_CHECKBOX");

		var key_escalationLevel = "2";

		AssertChecked(locator1 = "LESASearch#TICKETS_TAB_ESCALATION_LEVEL_CHECKBOX");

		var key_escalationLevel = "P1";

		AssertNotChecked(locator1 = "LESASearch#TICKETS_TAB_ESCALATION_LEVEL_CHECKBOX");

		var key_filter = "Status";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Status");

		AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_STATUS_CHECKED_CHECKBOXES_NOT_OPEN");

		AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_RESOLUTION_CHECKED_CHECKBOXES");
	}

	macro viewPartnerFLSProjectsFilter {
		LESASearch.selectCustomFilter(menuItem = "Partner First Line Support Projects");

		var key_tabName = "Projects";

		AssertElementPresent(locator1 = "LESASearch#SELECTED_TAB");

		LESASearch.viewProjectsInProjectsTab(projectList = "${projectList}");
	}

	macro viewPartnerTicketSearchFilters {
		AssertTextEquals(
			locator1 = "LESASearch#TICKETS_TAB",
			value1 = "Tickets(-)");

		AssertTextEquals(
			locator1 = "LESASearch#PROJECTS_TAB",
			value1 = "Projects(-)");

		AssertTextEquals(
			locator1 = "LESASearch#FEEDBACK_TAB",
			value1 = "Feedback(-)");

		AssertElementNotPresent(locator1 = "LESASearch#PARTNERS_TAB");

		var key_filter = "Project";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Project");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_TIERS");

		var key_filter = "Assignee";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Assignee");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_ASSIGNEE_BUTTON");

		AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_WORKER_BUTTON");

		var key_filter = "Component";

		AssertTextEquals(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Component");

		var key_filter = "Date";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Date");

		for (var dateRange : list "Created Between,Closed Between,Due Between,Satisfied Due Date") {
			var key_dateRange = "${dateRange}";

			AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_DATE_RANGES");
		}

		var key_filter = "Environment";

		AssertTextEquals(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Environment");

		var key_filter = "Pending";

		AssertTextEquals(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Pending");

		var key_filter = "Severity";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Severity");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_SEVERITY");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_ESCALATION_LEVEL");

		var key_filter = "Status";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Status");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_STATUS");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_RESOLUTION");

		var key_filter = "Support Region";

		AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_FILTER");

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_SEARCH_ATTACHMENTS_CHECKBOX");
	}

	macro viewProjectsInProjectsTab {
		Click(locator1 = "LESASearch#PROJECTS_TAB");

		for (var project : list "${projectList}") {
			var key_projectCode = "${project}";

			AssertElementPresent(locator1 = "LESASearch#RESULT_ROW_PROJECT_CODE");
		}
	}

	macro viewSelectedAccountWorkers {
		for (var worker : list "${accountWorkerList}") {
			var key_accountWorker = "${worker}";

			AssertTextEquals.assertPartialText(
				locator1 = "LESASearch#TICKETS_TAB_SELECTED_ACCOUNT_WORKER",
				value1 = "${worker}");
		}
	}

	macro viewSelectedAssignees {
		for (var assignee : list "${assigneeList}") {
			var key_assignee = "${assignee}";

			AssertTextEquals(
				locator1 = "LESASearch#TICKETS_TAB_SELECTED_ASSIGNEE",
				value1 = "${assignee}");
		}
	}

	macro viewSelectedProjects {
		if (IsNotVisible(locator1 = "LESASearch#TICKETS_TAB_ALL_SELECTED_PROJECTS")) {
			var key_filter = "Project";

			AssertClick(
				locator1 = "LESASearch#TICKETS_TAB_FILTER",
				value1 = "Project");
		}

		for (var project : list "${projectList}") {
			var key_project = "${project}";

			AssertTextEquals(
				locator1 = "LESASearch#TICKETS_TAB_SELECTED_PROJECT",
				value1 = "${project}");
		}
	}

	macro viewSelectedProjectSingle {
		LESASearch.viewSelectedProjects(projectList = "${project}");

		AssertElementNotPresent(locator1 = "LESASearch#TICKETS_TAB_CHOOSE_PROJECT_BUTTON");
	}

	macro viewSelectedSort {
		var key_column = "${column}";
		var key_sort = "${sort}";

		AssertElementPresent(locator1 = "LESASearch#TICKETS_TAB_SORT_ARROW");
	}

	macro viewSelectedStatus {
		var key_filter = "Status";

		AssertClick(
			locator1 = "LESASearch#TICKETS_TAB_FILTER",
			value1 = "Status");

		for (var status : list "${statusList}") {
			var key_status = "${status}";

			AssertChecked(locator1 = "LESASearch#TICKETS_TAB_STATUS_CHECKBOX");
		}
	}

}