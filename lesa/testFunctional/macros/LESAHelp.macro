definition {

	macro viewUserGuide {
		AssertTextEquals(
			locator1 = "LESAUserGuide#TITLE",
			value1 = "The LESA User Guide");

		if ("${role}" == "CSE") {
			var key_welcomeText = "Welcome to Liferay Enterprise Support Application";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");
		}
		else if ("${role}" == "Customer") {
			var key_welcomeText = "Thank you for being a valued member of Liferay EE Support!";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");
		}
		else if ("${role}" == "Partner") {
			var key_welcomeText = "Thank you for being a valued partner of Liferay EE Support!";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");
		}
		else if ("${role}" == "Admin") {
			AssertElementPresent(locator1 = "LESAButton#EDIT_BUTTON");

			var key_welcomeText = "Welcome to Liferay Enterprise Support Application";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");

			var key_welcomeText = "Thank you for being a valued member of Liferay EE Support!";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");

			var key_welcomeText = "Thank you for being a valued partner of Liferay EE Support!";

			AssertTextEquals.assertPartialText(
				locator1 = "LESAUserGuide#WELCOME_TEXT",
				value1 = "${key_welcomeText}");
		}
	}

}