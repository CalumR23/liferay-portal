definition {

	macro viewCallLog {
		AssertClick(
			locator1 = "LESAProjectDetails#CALL_LOG_TAB",
			value1 = "Call Log");

		var key_callDate = "${callDate}";
		var key_summary = "${summary}";

		AssertElementPresent(locator1 = "LESAProjectDetails#CALL_LOG_ROW");

		AssertClick(
			locator1 = "LESAProjectDetails#CALL_LOG_SUMMARY",
			value1 = "${summary}");

		if (!(IsVisible(locator1 = "LESAButton#DELETE_BUTTON"))) {
			AssertClick(
				locator1 = "LESAProjectDetails#CALL_LOG_SUMMARY",
				value1 = "${summary}");
		}

		var key_callLength = "${callLength}";
		var key_callType = "${callType}";

		AssertElementPresent(locator1 = "LESAProjectDetails#CALL_TYPE_FIELD");

		AssertElementPresent(locator1 = "LESAProjectDetails#CALL_LENGTH_FIELD");

		if (isSet(summary)) {
			AssertElementPresent(locator1 = "LESAProjectDetails#SUMMARY_FIELD");
		}

		if (isSet(clientsPresent)) {
			var key_clientsPresent = "${clientsPresent}";

			AssertElementPresent(locator1 = "LESAProjectDetails#CLIENTS_PRESENT_FIELD");
		}

		if (isSet(notes)) {
			var key_notes = "${notes}";

			AssertElementPresent(locator1 = "LESAProjectDetails#NOTES_FIELD");
		}

		if (isSet(actionItems)) {
			var key_actionItems = "${actionItems}";

			AssertElementPresent(locator1 = "LESAProjectDetails#ACTION_ITEMS_FIELD");
		}
	}

	macro viewCASInformation {
		AssertClick(
			locator1 = "LESAProjectDetails#CAS_INFORMATION_TAB",
			value1 = "CAS Information");

		if (isSet(reasonsForStrategic)) {
			var key_reasonsForStrategic = "${reasonsForStrategic}";

			AssertElementPresent(locator1 = "LESAProjectDetails#REASONS_FOR_STRATEGIC_ROW");
		}

		if (isSet(projectOverview)) {
			var key_projectOverview = "${projectOverview}";

			AssertElementPresent(locator1 = "LESAProjectDetails#PROJECT_OVERVIEW_ROW");
		}

		if (isSet(contactOverview)) {
			var key_contactOverview = "${contactOverview}";

			AssertElementPresent(locator1 = "LESAProjectDetails#CONTACT_OVERVIEW_ROW");
		}

		if (isSet(majorMilestones)) {
			var key_majorMilestones = "${majorMilestones}";

			AssertElementPresent(locator1 = "LESAProjectDetails#MILESTONES_ROW");
		}

		if (isSet(otherInformation)) {
			var key_otherInformation = "${otherInformation}";

			AssertElementPresent(locator1 = "LESAProjectDetails#OTHER_INFORMATION_ROW");
		}
	}

	macro viewProject {
		AssertClick(
			locator1 = "LESATicketDetails#PROJECT",
			value1 = "${project}");

		SelectWindow(locator1 = "title=Support | Liferay");

		AssertTextEquals(
			locator1 = "LESAProjectDetails#PROJECT_NAME",
			value1 = "${project}");
	}

	macro viewProjectNotes {
		Click(locator1 = "LESAProjectDetails#PROJECT_NOTES_TAB");

		AssertTextEquals(
			locator1 = "LESAProjectDetails#PROJECT_NOTES_FIELD",
			value1 = "${projectNotes}");
	}

	macro viewSalesInformation {
		AssertClick(
			locator1 = "LESAProjectDetails#SALES_INFORMATION_TAB",
			value1 = "Sales Information");

		if (isSet(licenseInformation)) {
			var key_licenseInformation = "${licenseInformation}";

			AssertElementPresent(locator1 = "LESAProjectDetails#LICENSE_INFORMATION_ROW");
		}

		if (isSet(salesforceURL)) {
			var key_salesforceURL = "${salesforceURL}";

			AssertElementPresent(locator1 = "LESAProjectDetails#SALESFORCE_URL_ROW");
		}

		if (isSet(trainingsAttended)) {
			var key_trainingsAttended = "${trainingsAttended}";

			AssertElementPresent(locator1 = "LESAProjectDetails#TRAININGS_ATTENDED_ROW");
		}
	}

	macro viewSupportInstructions {
		Click(locator1 = "LESAProjectDetails#SUPPORT_INSTRUCTIONS_TAB");

		AssertTextEquals(
			locator1 = "LESAProjectDetails#SUPPORT_INSTRUCTIONS_FIELD",
			value1 = "${supportInstructions}");
	}

}