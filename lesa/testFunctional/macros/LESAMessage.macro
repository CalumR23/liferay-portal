definition {

	macro assertNoErrorMessage {
		var key_errorMessage = "${errorMessage}";

		AssertElementNotPresent(locator1 = "LESAMessage#ERROR_MESSAGE_1");

		AssertElementNotPresent(locator1 = "LESAMessage#ERROR_MESSAGE_2");

		AssertTextNotPresent(value1 = "${errorMessage}");
	}

	macro error {
		var key_errorMessage = "${errorMessage}";

		if (IsElementPresent(locator1 = "LESAMessage#ERROR_MESSAGE_1")) {
			AssertTextEquals(
				locator1 = "LESAMessage#ERROR_MESSAGE_1",
				value1 = "${errorMessage}");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#ERROR_MESSAGE_2",
				value1 = "${errorMessage}");
		}
	}

	macro info {
		var key_message = "${message}";

		AssertTextEquals.assertPartialText(
			locator1 = "LESAMessage#INFO_MESSAGE",
			value1 = "${message}");
	}

	macro limitedSupport {
		var key_message = "${message}";

		if (IsVisible(locator1 = "LESAMessage#LIMITED_SUPPORT_MESSAGE_TICKET_DETAIL")) {
			AssertTextEquals(
				locator1 = "LESAMessage#LIMITED_SUPPORT_MESSAGE_TICKET_DETAIL",
				value1 = "${message}");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#LIMITED_SUPPORT_MESSAGE_DESCRIPTION_TAB",
				value1 = "${message}");
		}
	}

	macro success {
		if (isSet(message)) {
			AssertTextEquals(
				locator1 = "LESAMessage#SUCCESS_MESSAGE",
				value1 = "${message}");
		}
		else {
			AssertTextEquals(
				locator1 = "LESAMessage#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully.");
		}
	}

}