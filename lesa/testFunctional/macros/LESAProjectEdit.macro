definition {

	macro addCallLog {
		AssertClick(
			locator1 = "LESAProjectDetails#CALL_LOG_TAB",
			value1 = "Call Log");

		Click(locator1 = "LESAProjectDetails#ADD_CALL_LOG_BUTTON");

		SelectFrame(locator1 = "LESAProjectCallLogAdd#CALL_LOG_IFRAME");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_TYPE_SLECT",
			value1 = "${callType}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_DATE_MONTH_SELECT",
			value1 = "${callDateMonth}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_DATE_DAY_SELECT",
			value1 = "${callDateDay}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_DATE_YEAR_SELECT",
			value1 = "${callDateYear}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_LENGTH_HOURS_SELECT",
			value1 = "${callLengthHours}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_LENGTH_MINUTES_SELECT",
			value1 = "${callLengthMinutes}");

		Select(
			locator1 = "LESAProjectCallLogAdd#CALL_LENGTH_SECONDS_SELECT",
			value1 = "${callLengthSeconds}");

		Type(
			locator1 = "LESAProjectCallLogAdd#SUMMARY_FIELD",
			value1 = "${summary}");

		Type(
			locator1 = "LESAProjectCallLogAdd#CLIENTS_PRESENT_FIELD",
			value1 = "${clientsPresent}");

		Type(
			locator1 = "LESAProjectCallLogAdd#NOTES_FIELD",
			value1 = "${notes}");

		Type(
			locator1 = "LESAProjectCallLogAdd#ACTION_ITEMS_FIELD",
			value1 = "${actionItems}");

		LESAButton.save();

		SelectFrame(value1 = "relative=top");
	}

	macro editCASInformation {
		AssertClick(
			locator1 = "LESAProjectDetails#CAS_INFORMATION_TAB",
			value1 = "CAS Information");

		Click(locator1 = "LESAProjectDetails#CAS_INFO_EDIT_BUTTON");

		Type(
			locator1 = "LESAProjectDetails#REASONS_FOR_STRATEGIC_FIELD",
			value1 = "${reasonsForStrategic}");

		Type(
			locator1 = "LESAProjectDetails#PROJECT_OVERVIEW_FIELD",
			value1 = "${projectOverview}");

		Type(
			locator1 = "LESAProjectDetails#CONTACT_OVERVIEW_FIELD",
			value1 = "${contactOverview}");

		Type(
			locator1 = "LESAProjectDetails#MILESTONES_FIELD",
			value1 = "${majorMilestones}");

		Click(locator1 = "LESAProjectDetails#CAS_INFO_SAVE_BUTTON");
	}

	macro editProjectDetail {
		if (isSet(specialInstructions)) {
			Type(
				locator1 = "LESAProjectDetailsEdit#SPECIAL_INSTRUCTIONS_FIELD",
				value1 = "${specialInstructions}");
		}

		if (isSet(additionalNotes)) {
			Type(
				locator1 = "LESAProjectDetailsEdit#ADDITIONAL_NOTES_FIELD",
				value1 = "${additionalNotes}");
		}

		Click(locator1 = "LESAProjectDetailsEdit#SAVE_BUTTON");

		SelectFrame(value1 = "relative=top");
	}

	macro editSalesInformation {
		AssertClick(
			locator1 = "LESAProjectDetails#SALES_INFORMATION_TAB",
			value1 = "Sales Information");

		Click(locator1 = "LESAProjectDetails#SALES_INFO_EDIT_BUTTON");

		Type(
			locator1 = "LESAProjectDetails#LICENSE_INFORMATION_FIELD",
			value1 = "${licenseInformation}");

		Type(
			locator1 = "LESAProjectDetails#SALESFORCE_URL_FIELD",
			value1 = "${salesforceURL}");

		Type(
			locator1 = "LESAProjectDetails#TRAININGS_ATTENDED_FIELD",
			value1 = "${trainingsAttended}");

		Click(locator1 = "LESAProjectDetails#SALES_INFO_SAVE_BUTTON");
	}

	macro tearDownCallLog {
		LESASearch.searchProject(projectCode = "${projectCode}");

		AssertClick(
			locator1 = "LESAProjectDetails#CALL_LOG_TAB",
			value1 = "Call Log");

		var key_summary = "${summary}";

		if (IsElementPresent(locator1 = "LESAProjectDetails#CALL_LOG_SUMMARY")) {
			AssertClick(
				locator1 = "LESAProjectDetails#CALL_LOG_SUMMARY",
				value1 = "${summary}");

			ClickNoError(locator1 = "LESAButton#DELETE_BUTTON");

			Confirm(value1 = "Are you sure you want to delete this call log?");

			LESAMessage.success();

			AssertElementNotPresent(locator1 = "LESAProjectDetails#CALL_LOG_SUMMARY");
		}
	}

}