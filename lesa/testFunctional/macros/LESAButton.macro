definition {

	macro next {
		Click(locator1 = "LESAButton#NEXT_BUTTON");
	}

	macro save {
		Click(locator1 = "LESAButton#SAVE_BUTTON");
	}

	macro search {
		Click(locator1 = "LESAButton#SEARCH_BUTTON");
	}

	macro searchAdvanced {
		Click(locator1 = "LESAButton#ADVANCED_SEARCH_BUTTON");
	}

	macro send {
		ClickNoError(locator1 = "LESAButton#SEND_BUTTON");
	}

}