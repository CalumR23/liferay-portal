definition {

	macro viewMessageIcon {
		AssertElementPresent(locator1 = "LESALeftNavigation#MESSAGES_BUTTON");
	}

	macro viewMessageIconNotPresent {
		AssertElementNotPresent(locator1 = "LESALeftNavigation#MESSAGES_BUTTON");
	}

	macro viewNoProjectMessages {
		Click(locator1 = "LESALeftNavigation#MESSAGES_BUTTON");

		LESAMessage.info(message = "There are no messages regarding your Liferay Subscription at this time.");
	}

	macro viewProjectMessage {
		Click(locator1 = "LESALeftNavigation#MESSAGES_BUTTON");

		var key_severity = "${severity}";
		var key_title = "${projectName}: ${title}";

		AssertElementPresent(locator1 = "LESASubscriptionMessages#MESSAGE_TITLE");

		Click(locator1 = "LESASubscriptionMessages#MESSAGE_TITLE");

		AssertTextEquals(
			locator1 = "LESASubscriptionMessages#MESSAGE_CONTENT",
			value1 = "${message}");
	}

	macro viewProjectMessageNotPresent {
		var key_title = "${projectName}: ${title}";

		AssertElementNotPresent(locator1 = "LESASubscriptionMessages#MESSAGE_TITLE");
	}

}