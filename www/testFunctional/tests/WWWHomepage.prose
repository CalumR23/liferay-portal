@testray.main.component.name = "Support QA"

Feature: WWW Homepage
	Frontend testing for the www homepage

Scenario: Product Dropdown Navigation
	End users should be able to view all links in the product dropdown.

	Given I go to the www homepage
	And I click on the "Digital Experience Platform" link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "All Features" link under the "Digital Experience Platform" product link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "DXP Cloud" link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "Key Features" link under the "DXP Cloud" product link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "Commerce" link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "All Features" link under the "Commerce" product link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "Analytics Cloud" link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"
	When I go to the www homepage
	And I click on the "All Features" link under the "Analytics Cloud" product link on the Product dropdown
	Then there should be no errors on the page
	And the current url content should contain the text "www-uat.liferay.com"

