<html>
<head>
<title>WebContentCreate</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WebContentCreate</td></tr>
</thead>

<tbody>
<tr>
	<td>LOCALIZATION_BUTTON</td>
	<td>xpath=(//button[contains(@class,'input-localized-trigger')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_OPTION</td>
	<td>xpath=(//a[@data-value='${key_localization}'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_FIELD</td>
	<td>//input[contains(@aria-describedby,'JournalPortlet_title')]</td>
	<td></td>
</tr>
<tr>
	<td>PUBLISH_BUTTON</td>
	<td>//button[contains(.,'Publish')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/following-sibling::input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_INPUT_FIELD_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::div//input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_INPUT_FIELD_EXACT</td>
	<td>xpath=(//label[.=' ${key_field} ']/following-sibling::div//input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_CHECKBOX_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/input)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>TEXTAREA_FIELD_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::textarea)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>TEXTAREA_FIELD_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/following-sibling::textarea)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>RICH_TEXT_EDITOR_FIELD_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::div//div[contains(@id,'cke')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>RICH_TEXT_EDITOR_FIELD_EXACT</td>
	<td>xpath=(//label[.=' ${key_field} ']/following-sibling::div//div[contains(@id,'cke')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::div//button[contains(.,'Select')]/parent::div)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/following-sibling::div//button[contains(.,'Select')]/parent::div)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_ITEM_CLOSE_BUTTON_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::div//span[@id='item-tag' and contains(.,'${key_entryTitle}')]//button[contains(@class,'close')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_ITEM_CLOSE_BUTTON_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/following-sibling::div//span[@id='item-tag' and contains(.,'${key_entryTitle}')]//button[contains(@class,'close')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_ITEM_OTHER_CLOSE_BUTTON_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/following-sibling::div//span[@id='item-tag' and not(contains(.,'${key_entryTitle}'))]//button[contains(@class,'close')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_ITEM_OTHER_CLOSE_BUTTON_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/following-sibling::div//span[@id='item-tag' and not(contains(.,'${key_entryTitle}'))]//button[contains(@class,'close')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE</td>
	<td>xpath=(//label[contains(.,'${key_field}')]/ancestor::div[contains(@class,'form-group')]/div/button[contains(@class,'add-button')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_DUPLICATE_FIELD_BUTTON_EXACT</td>
	<td>xpath=(//label[.='${key_field}']/ancestor::div[contains(@class,'form-group')]/div/button[contains(@class,'add-button')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SIDE_PANEL-->

<tr>
	<td>SIDE_PANEL_HEADER_EXPANDED</td>
	<td>//div[@id='${key_sidePanelCategory}Title']/a[@aria-expanded='true']</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_PANEL_HEADER_COLLAPSED</td>
	<td>//div[@id='${key_sidePanelCategory}Title']/a[@aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SELECT_FILE-->

<tr>
	<td>SELECT_FILE_IFRAME</td>
	<td>//iframe[contains(@title,'Select Document')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_FIELD</td>
	<td>//input[@class='input-file']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_PREVIEW_FOOTER_RIGHT_BUTTON</td>
	<td>xpath=(//a[contains(@class,'footer-control-right')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_PREVIEW_FOOTER_LEFT_BUTTON</td>
	<td>xpath=(//a[contains(@class,'footer-control-left')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_ADD_BUTTON</td>
	<td>//button[contains(.,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_ADD_BUTTON_DISABLED</td>
	<td>//button[contains(.,'Add') and contains(@class,'disabled')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FILE_DOCUMENTS_AND_MEDIA</td>
	<td>//div[contains(@class,'navbar-collapse')]//a[contains(.,'Documents and Media')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--SELECT_CATEGORY-->

<tr>
	<td>SELECT_CATEGORY_IFRAME</td>
	<td>//iframe[contains(@id,'selectCategory_iframe')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_CATEGORY_ENTRY_SELECTED</td>
	<td>//div[contains(@class,'treeview-node')]//div[contains(@class,'selected')]//p[contains(@class,'card-title')]/span[.='${key_entryTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_CATEGORY_ENTRY</td>
	<td>//div[contains(@class,'treeview-node')]//p[contains(@class,'card-title')]/span[.='${key_entryTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_CATEGORY_ENTRY_OTHER</td>
	<td>//div[@class='lfr-treeview-node-list-item__children']/div[@class='lfr-treeview-node-list']/div[contains(@class,'lfr-treeview-node-list-item')]//p[contains(@class,'card-title')]/span[not(.='${key_entryTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_CATEGORY_DONE_BUTTON</td>
	<td>//button[contains(.,'Done')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>