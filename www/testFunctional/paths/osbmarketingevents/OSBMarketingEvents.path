<html>
<head>
<title>OSBMarketingEvents</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBMarketingEvents</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Keywords']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_EVENT_BUTTON</td>
	<td>//a[contains(.,'add-event')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_SETTINGS_BUTTON</td>
	<td>//a[contains(.,'Edit Settings')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MARKETING_EVENT-->
<tr>
	<td>MARKETING_EVENT_TYPE</td>
	<td>//tr[contains(.,'${key_title}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_EVENT_TITLE</td>
	<td>//tr[contains(.,'${key_title}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_EVENT_START_DATE</td>
	<td>//tr[contains(.,'${key_title}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_EVENT_GLOBAL_REGION</td>
	<td>//tr[contains(.,'${key_title}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_EVENT_ACTIONS</td>
	<td>//tr[contains(.,'${key_title}')]/td[contains(@class,'last')]//a[@title='Actions']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_LINK</td>
	<td>//a[contains(.,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_LINK</td>
	<td>//a[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>