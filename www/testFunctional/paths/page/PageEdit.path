<html>
<head>
<title>PageEdit</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PageEdit</td></tr>
</thead>
<tbody>
<tr>
	<td>PUBLISH_BUTTON</td>
	<td>//button[contains(.,'Publish')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION</td>
	<td>//section[@data-drag-source-label='Section'][${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_NAV</td>
	<td>//section[@data-drag-source-label='Section'][${key_positionValue}]/nav</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>EDITOR_SIDEBAR_HEADER</td>
	<td>//h1[.='${key_sidebarCategory}']</td>
	<td></td>
</tr>
<tr>
	<td>EDITOR_SIDEBAR_BUTTON</td>
	<td>//button[@data-title='${key_sidebarCategory}']</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP</td>
	<td>//div[contains(@class,'panel-group') and contains(.,'${key_panelGroup}')]//a</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP_COLLAPSED</td>
	<td>//div[contains(@class,'panel-group') and contains(.,'${key_panelGroup}')]//a[@aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP_EXPANDED</td>
	<td>//div[contains(@class,'panel-group') and contains(.,'${key_panelGroup}')]//a[@aria-expanded='true']</td>
	<td></td>
</tr>
<tr>
	<td>CARD</td>
	<td>//div[contains(@class,'card-interactive') and contains(.,'${key_card}')]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_DRAG_HANDLER</td>
	<td>//div[contains(@class,'card-interactive') and contains(.,'${key_card}')]/div[contains(@class,'drag-handler')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>