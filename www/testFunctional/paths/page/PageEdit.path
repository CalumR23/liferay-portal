<html>
<head>
<title>PageEdit</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PageEdit</td></tr>
</thead>
<tbody>
<tr>
	<td>PUBLISH_BUTTON</td>
	<td>//button[contains(.,'Publish')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION</td>
	<td>//div[contains(@class,'root page-editor')]/div[contains(@class,'page-editor__topper')][${key_positionValue}]/div[contains(@class,'page-editor__topper__content')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_NAV</td>
	<td>//div[contains(@class,'root page-editor')]/div[contains(@class,'page-editor__topper')][${key_positionValue}]/div[contains(@class,'page-editor__topper__bar tbar')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_NAV_ALT</td>
	<td>//div[contains(@class,'root page-editor')]/div[contains(@class,'page-editor__topper')][${key_positionValue}]/div[contains(@class,'page-editor__topper__content')]//div[contains(@class,'page-editor__row')]//div[contains(@class,'page-editor__topper__bar tbar')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>EDITOR_SIDEBAR_HEADER</td>
	<td>//div[contains(@class,'sidebar') and contains(@class,'open')]//h1[.='${key_sidebarCategory}']</td>
	<td></td>
</tr>
<tr>
	<td>EDITOR_SIDEBAR_BUTTON</td>
	<td>//div[contains(@class,'page-editor__sidebar__buttons')]/button[contains(@id,'${key_sidebarCategory}')]</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP</td>
	<td>//div[contains(@class,'page-editor') and contains(.,'${key_panelGroup}')]/button</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP_COLLAPSED</td>
	<td>//div[contains(@class,'page-editor') and contains(.,'${key_panelGroup}')]/button[@aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_GROUP_EXPANDED</td>
	<td>//div[contains(@class,'page-editor') and contains(.,'${key_panelGroup}')]/button[@aria-expanded='true']</td>
	<td></td>
</tr>
<tr>
	<td>CARD</td>
	<td>//li[contains(@class,'page-editor') and contains(.,'${key_card}') and @draggable]/div/div</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_CARD</td>
	<td>xpath=(//div[contains(@class,'lfr-treeview-node-list-item ')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_CARD_REMOVE_BUTTON</td>
	<td>xpath=(//div[contains(@class,'lfr-treeview-node-list-item ')]//button[contains(@class,'remove-button')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>REFRESH_BUTTON</td>
	<td>//button[contains(.,'Refresh')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>