<html>
<head>
<title>Page</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Page</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//*[@class='lexicon-icon lexicon-icon-trash']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PUBLIC_PAGE</td>
	<td>//*[local-name()='svg' and contains(@class,'plus')]/parent::button</td>
	<td></td>
</tr>
<tr>
	<td>MENUITEM_PUBLIC_PAGE</td>
	<td>//a[contains(@class,'dropdown-item') and .='Public Page']</td>
	<td></td>
</tr>
<tr>
	<td>MENUITEM_PUBLIC_COLLECTION_PAGE</td>
	<td>//a[contains(@class,'dropdown-item') and .='Public Collection Page']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ENTRY_CARDS-->
<tr>
	<td>ENTRY_CARDS_THUMBNAIL</td>
	<td>//*[contains(@class,'card-title') and contains(.,'${key_entryTitle}')]/ancestor::div[contains(@class,'card-body')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ENTRY_LIST-->
<tr>
	<td>ENTRY_LIST_CHECKBOX</td>
	<td>//tr[contains(.,'${key_entryTitle}')]/td/input</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADD_PAGE-->
<tr>
	<td>ADD_PAGE_IFRAME</td>
	<td>//iframe[@title='Add Page']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PAGE_NAME_FIELD</td>
	<td>//input[contains(@id,'GroupPagesPortlet_name')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_PAGE_ADD_BUTTON</td>
	<td>//button[contains(.,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PUBLIC_PAGE</td>
	<td>//li[contains(.,'${key_pageName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>