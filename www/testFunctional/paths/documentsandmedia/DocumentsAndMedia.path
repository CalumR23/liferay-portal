<html>
<head>
<title>DocumentsAndMedia</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">DocumentsAndMedia</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTIVE_BREADCRUMB</td>
	<td>//li[@class='breadcrumb-item']/span[contains(@class,'active')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Search for']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//*[local-name()='svg' and contains(@class,'plus')]/parent::button</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_TO_RECYCLE_BIN_BUTTON</td>
	<td>//button[@aria-label='trash']</td>
	<td></td>
</tr>
<tr>
	<td>MORE_BUTTON</td>
	<td>//button[contains(.,'More')]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_ASSET_BUTTON</td>
	<td>//a[contains(.,'Marketing Asset')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--MORE_MENU-->

<tr>
	<td>MORE_MENU_IFRAME</td>
	<td>//iframe[@title='More']</td>
	<td></td>
</tr>
<tr>
	<td>MORE_MENU_SEARCH_BAR</td>
	<td>//div[@id='journalViewMoreMenuItemsManagementToolbar']//input[@aria-label='Search']</td>
	<td></td>
</tr>
<tr>
	<td>MORE_MENU_ITEM_NAME</td>
	<td>//tr[contains(.,'${key_menuItemName}')]/td[contains(@class,'lfr-name-column')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ENTRY_CARDS-->

<tr>
	<td>ENTRY_CARDS_THUMBNAIL</td>
	<td>//div[contains(@class,'card-horizontal') and contains(.,'${key_entryTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ENTRY_LIST-->

<tr>
	<td>ENTRY_LIST_THUMBNAIL</td>
	<td>//li[contains(@data-title,'${key_entryTitle}')]//*[@data-qa-id='rowItemContent']/div</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_THUMBNAIL_GENERIC</td>
	<td>//*[@data-qa-id='rowItemContent']/div</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_MENULIST_ICON</td>
	<td>//li[contains(@data-title,'${key_entryTitle}')]//*[contains(@class,'dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_CHECKBOX</td>
	<td>//li[contains(.,'${key_entryTitle}')]//input</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_TITLE</td>
	<td>//li[contains(@data-title,'${key_entryTitle}')]//*[@data-qa-id='rowItemContent']//a</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_TITLE_ON_LIVE</td>
	<td>//li[contains(@data-title,'${key_entryTitle}')]//*[@data-qa-id='rowItemContent']//p</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_LAST_MODIFIED</td>
	<td>//*[@data-qa-id='row' and contains(.,'${key_entryTitle}')]//span[contains(.,'modified')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_LIST_WORKFLOW_STATUS</td>
	<td>//li[contains(@data-title,'${key_entryTitle}')]//span[contains(@class,'label')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>