<html>
<head>
<title>WWWSignIn</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWSignIn</td></tr>
</thead>

<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'signin-username')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[contains(@id,'signin-password')]</td>
	<td></td>
</tr>
<tr>
	<td>REMEMBER_ME_CHECKBOX</td>
	<td>//input[@name='remember']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//input[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>