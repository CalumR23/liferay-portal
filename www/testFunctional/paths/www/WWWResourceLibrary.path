<html>
<head>
<title>WWWResourceLibrary</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWResourceLibrary</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@class='r-search-input']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//button[@class='r-search-button']</td>
	<td></td>
</tr>
<tr>
	<td>RESET_SEARCH_BUTTON</td>
	<td>//button[@class='r-clear-search-button']</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_BUTTON</td>
	<td>//button[contains(@class,'r-filter-button')]</td>
	<td></td>
</tr>
<tr>
	<td>SOLUTIONS_FILTER_LABEL</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Solutions')]/following-sibling::ul/li[contains(.,'${key_value}')]/label</td>
	<td></td>
</tr>
<tr>
	<td>SOLUTIONS_FILTER_CHECKBOX</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Solutions')]/following-sibling::ul/li[contains(.,'${key_value}')]/input</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRIES_FILTER_LABEL</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Industries')]/following-sibling::ul/li[contains(.,'${key_value}')]/label</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRIES_FILTER_CHECKBOX</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Industries')]/following-sibling::ul/li[contains(.,'${key_value}')]/input</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TYPES_FILTER_LABEL</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Resource Types')]/following-sibling::ul/li[contains(.,'${key_value}')]/label</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TYPES_FILTER_CHECKBOX</td>
	<td>//div[contains(@class,'r-filter-vocabulary-title') and contains(.,'Resource Types')]/following-sibling::ul/li[contains(.,'${key_value}')]/input</td>
	<td></td>
</tr>
<tr>
	<td>CLEAR_ALL_BUTTON</td>
	<td>//button[contains(@class,'r-filter-clear-button')]</td>
	<td></td>
</tr>
<tr>
	<td>APPLY_BUTTON</td>
	<td>//button[contains(@class,'r-filter-apply-button')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_COUNT</td>
	<td>//div[@class='r-search-notice']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--RESOURCE-->
<tr>
	<td>RESOURCE_LINK_VIA_TITLE</td>
	<td>//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource') and contains(.,'${key_resourceTitle}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_LINK_VIA_TYPE</td>
	<td>//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource') and contains(.,'${key_resourceType}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_LINK_VIA_POSITION</td>
	<td>xpath=(//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource')]/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TYPE</td>
	<td>//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource') and contains(.,'${key_resourceTitle}')]//div[contains(@class,'small-caps')]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TITLE</td>
	<td>//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource') and contains(.,'${key_resourceTitle}')]//p</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_IMAGE</td>
	<td>//div[contains(@class,'r-filtered-overview')]//div[contains(@class,'r-resource') and contains(.,'${key_resourceTitle}')]//div[contains(@class,'r-resource-image')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_ITEMS_PER_PAGE_BUTTON</td>
	<td>//div[contains(@class,'pagination-items-per-page')]/button</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_ITEMS_PER_PAGE_OPTION</td>
	<td>//button[@class='dropdown-item' and contains(.,'${key_resultsPerPage}')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_NEXT_PAGE_DISABLED</td>
	<td>//button[@aria-label='Next' and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_NEXT_PAGE</td>
	<td>//button[@aria-label='Next']</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_PAGE_ONE_ACTIVE</td>
	<td>//li[contains(@class,'active')]/button[@class='page-link' and contains(.,'1')]</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_PAGE_ONE</td>
	<td>//button[@class='page-link' and contains(.,'1')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--RESOURCES_FORM-->
<tr>
	<td>RESOURCES_FORM_HEADER</td>
	<td>//div/h4[contains(@class,'f-text-heading')]</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_FIELD</td>
	<td>//input[@name='Email']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[@name='Country']</td>
	<td></td>
</tr>
<tr>
	<td>STATE_TERRITORY_SELECT</td>
	<td>//select[contains(@name,'State')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[@name='FirstName']</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[@name='LastName']</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME_FIELD</td>
	<td>//input[@name='Company']</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>//button[@type='submit' and contains(.,'Download')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>