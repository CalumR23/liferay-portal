<html>
<head>
<title>WWWResourceLibrary</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWResourceLibrary</td></tr>
</thead>
<tbody>
<tr>
	<td>SOLUTION_SELECT</td>
	<td>//label[contains(.,'Solution')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRY_SELECT</td>
	<td>//label[contains(.,'Industry')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>TOPIC_SELECT</td>
	<td>//label[contains(.,'Topic')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TYPE_SELECT</td>
	<td>//label[contains(.,'Resource Type')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>RESULT_COUNT</td>
	<td>//span[@class='results']</td>
	<td></td>
</tr>
<tr>
	<td>SORT_BY_SELECT</td>
	<td>//select[@title='Sort By']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@title='Keywords']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//*[local-name()='svg' and @class='search-icon')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--RESOURCE-->
<tr>
	<td>RESOURCE_LINK_VIA_TITLE</td>
	<td>//div[contains(@class,'asset-entry block resource') and contains(.,'${key_resourceTitle}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_LINK_VIA_TYPE</td>
	<td>//div[contains(@class,'asset-entry block resource') and contains(.,'${key_resourceType}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TYPE</td>
	<td>//div[contains(@class,'asset-entry block resource') and contains(.,'${key_resourceTitle}')]//div[contains(@class,'small-caps')]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TITLE</td>
	<td>//div[contains(@class,'asset-entry block resource') and contains(.,'${key_resourceTitle}')]//h4[@class='asset-entry-title']</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_IMAGE</td>
	<td>//div[contains(@class,'asset-entry block resource') and contains(.,'${key_resourceTitle}')]//img</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>