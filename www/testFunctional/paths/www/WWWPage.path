<html>
<head>
<title>WWWPage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWPage</td></tr>
</thead>

<tbody>
<tr>
	<td>DROPDOWN_LANGUAGE_LINK</td>
	<td>xpath=(//div[contains(@class,'utility-nav-right')]//li[contains(@class,'osb-nav-item')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_LINK</td>
	<td>xpath=(//li[contains(@class,'adt-nav-item dropdown')]//div[contains(@class,'adt-submenu-item-text')])[${key_linkPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_DROPDOWN</td>
	<td>xpath=(//div[contains(@class,'language-selector')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM</td>
	<td>xpath=(//*[contains(@class,'mktoForm')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_INPUT_FIELD</td>
	<td>xpath=(//input[contains(@class,'mktoRequired')])[${key_inputPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_SELECT_FIELD</td>
	<td>xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_SUBMIT_BUTTON</td>
	<td>//*[contains(@class,'mktoButton') and contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_IMAGE</td>
	<td>xpath=(//div[contains(@class,'fragments')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_LINK</td>
	<td>xpath=(//div[contains(@class,'d-lg-block container-fluid')]//a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>TAB_DROPDOWN</td>
	<td>xpath=(//li[contains(@class,'adt-nav-item dropdown')])[${key_tabPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>TOP_INFO_NAVIGATION_LINK</td>
	<td>xpath=(//div[contains(@class,'utility-nav-left')])[1]//a[${key_positionValue}]</td>
	<td></td>
</tr>

<!--FOOTER-->

<tr>
	<td>FOOTER_DROPDOWN_LANGUAGE_LINK</td>
	<td>xpath=(//div[contains(@class,'footer-navigation')]//li[contains(@class,'osb-nav-item')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_LANGUAGE_DROPDOWN</td>
	<td>//div[contains(@class,'footer-navigation')]//div[contains(@class,'language-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_LINK</td>
	<td>xpath=(//h4[contains(@class,'nav-item-header')]/following-sibling::ul//a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA_LINK</td>
	<td>xpath=(//div[contains(@class,'social-nav')]//li/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>