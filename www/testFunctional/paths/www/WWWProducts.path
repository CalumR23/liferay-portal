<html>
<head>
<title>WWWProducts</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWProducts</td></tr>
</thead>
<tbody>
<tr>
	<td>30_DAY_TRIAL_HEADER</td>
	<td>//h4/div[contains(.,'Start your free 30 day Trial with')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//button[contains(@class,'close')]</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_FIELD</td>
	<td>//input[@name='Email']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[@name='Country']</td>
	<td></td>
</tr>
<tr>
	<td>STATE_TERRITORY_SELECT</td>
	<td>//select[contains(@name,'State')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_TYPE_SELECT</td>
	<td>//select[contains(@name,'trial_download_type')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[@name='FirstName']</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[@name='LastName']</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME_FIELD</td>
	<td>//input[@name='Company']</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_FIELD</td>
	<td>//input[@name='Phone']</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_BUTTON</td>
	<td>//button[@type='submit' and contains(.,'Download')]</td>
	<td></td>
</tr>
<tr>
	<td>DXP_PAGE_SECTION_LINK</td>
	<td>//div[contains(@id,'fragment') and contains(.,'${key_sectionText}')]/ancestor::div[contains(@class,'align-items-center')]//a[contains(.,'${key_linkName}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_PLAY_IMAGE</td>
	<td>//div[contains(@class,'f-embedded-video-overlay')]//*[contains(@class,'play-dark')][2]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_PLAY_BUTTON</td>
	<td>//div[contains(@class,'w-bottom-bar w-css-reset')]//button[contains(@aria-label,'Play Video')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_PAUSE_BUTTON</td>
	<td>//div[contains(@class,'w-bottom-bar w-css-reset')]//button[contains(@aria-label,'Pause')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_REWATCH_BUTTON</td>
	<td>//div/button[contains(@class,'w-css-reset')]/span[contains(.,'Rewatch')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>