<html>
<head>
<title>WWWContactSales</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWContactSales</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACT_SALES_HEADER</td>
	<td>//h2[contains(.,'Talk to Sales')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//button[contains(@class,'close')]</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_FIELD</td>
	<td>//input[@name='Email']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[@name='Country']</td>
	<td></td>
</tr>
<tr>
	<td>STATE_TERRITORY_SELECT</td>
	<td>//select[contains(@name,'State')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_FIELD</td>
	<td>//textarea[contains(@name,'Contact_Sales_Comments')]</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_YOUR_CHALLENGE_SELECT</td>
	<td>//select[contains(@name,'What_s_your_challenge')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[@name='FirstName']</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[@name='LastName']</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME_FIELD</td>
	<td>//input[@name='Company']</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_FIELD</td>
	<td>//input[@name='Phone']</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRY_SELECT</td>
	<td>//select[contains(@name,'Industry')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_REVENUE</td>
	<td>//select[contains(@name,'Annual_Revenue')]</td>
	<td></td>
</tr>
<tr>
	<td>DEPARTMENT_SELECT</td>
	<td>//select[contains(@name,'Department')]</td>
	<td></td>
</tr>
<tr>
	<td>JOB_ROLE</td>
	<td>//select[contains(@name,'Job_Role')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_SIZE</td>
	<td>//select[@name='NumberOfEmployees']</td>
	<td></td>
</tr>
<tr>
	<td>JOB_TITLE</td>
	<td>//input[@name='Title']</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_ME_BUTTON</td>
	<td>//button[@type='submit' and contains(.,'Contact Me')]</td>
	<td></td>
</tr>
<tr>
	<td>SENT_MESSAGE</td>
	<td>//h2/div[contains(.,'Sent!')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>