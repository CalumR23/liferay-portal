<html>
<head>
<title>WWWContactSales</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWContactSales</td></tr>
</thead>
<tbody>
<tr>
	<td>CONTACT_SALES_HEADER</td>
	<td>//h2[contains(.,'Contact Sales')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//button[contains(@class,'close')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_FIELD</td>
	<td>//input[@name='firstname']</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_FIELD</td>
	<td>//input[@name='lastname']</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_FIELD</td>
	<td>//input[@name='email']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_SELECT</td>
	<td>//select[@name='country']</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME_FIELD</td>
	<td>//input[@name='company']</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_FIELD</td>
	<td>//input[@name='phone']</td>
	<td></td>
</tr>
<tr>
	<td>INDUSTRY_SELECT</td>
	<td>//select[@name='industry']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_FIELD</td>
	<td>//textarea[@name='contact_sales_comments']</td>
	<td></td>
</tr>
<tr>
	<td>DXP_CHECKBOX</td>
	<td>//input[@name='explicit_interest_dxp']</td>
	<td></td>
</tr>
<tr>
	<td>DXP_CLOUD_CHECKBOX</td>
	<td>//input[@name='explicit_interest_dxp_cloud']</td>
	<td></td>
</tr>
<tr>
	<td>ANALYTICS_CLOUD_CHECKBOX</td>
	<td>//input[@name='explicit_interest_analytics_cloud']</td>
	<td></td>
</tr>
<tr>
	<td>COMMERCE_CHECKBOX</td>
	<td>//input[@name='explicit_interest_commerce']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//input[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>