<html>
<head>
<title>WWWRedirects</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWRedirects</td></tr>
</thead>
<tbody>
<tr>
	<td>SOURCE_URL_FIELD</td>
	<td>//input[contains(@title,'Source URL')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_URL_FIELD</td>
	<td>//input[contains(@aria-label,'Destination URL')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_FIELD</td>
	<td>//select[contains(@class,'form-control')]</td>
	<td></td>
</tr>
<tr>
	<td>EXPIRATION_DATE_FIELD</td>
	<td>//input[contains(@id,'expirationDate')]</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_URL_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SHORT_LINK-->
<tr>
	<td>SHORT_LINK_ID</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_CREATE_DATE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_MODIFIED_DATE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_LINK_SOURCE_URL</td>
	<td>//tr[contains(.,'${key_sourceUrl}') and contains(.,'${key_destinationUrl}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_LINK_DESTINATION_URL</td>
	<td>//tr[contains(.,'${key_sourceUrl}') and contains(.,'${key_destinationUrl}')]/td[5]</td>
	<td></td>
</tr>

<tr>
	<td>SHORT_LINK_HTTP_STATUS_CODE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_LINK_ACTIONS</td>
	<td>//td[contains(.,'${key_sourceUrl}')]/following-sibling::td[contains(.,'${key_destinationUrl}')]/following-sibling::td/div/div[contains(@class,'dropdown-action')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//a[contains(@aria-label,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_LINK</td>
	<td>//a[contains(.,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_LINK</td>
	<td>//a[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PAGE_LINK</td>
	<td>//div[contains(@class,'lfr-pagination-page-selector')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>ITEMS_PER_PAGE_LINK</td>
	<td>//div[contains(@class,'lfr-pagination-delta-selector')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>VALUE_LINK</td>
	<td>//span[.='${key_value}']/parent::a</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_LINK</td>
	<td>//li/a[contains(.,'First')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'First')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_LINK</td>
	<td>//li/a[contains(.,'Previous')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Previous')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//li/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_LINK</td>
	<td>//li/a[contains(.,'Last')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Last')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>