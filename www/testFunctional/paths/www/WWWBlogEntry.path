<html>
<head>
<title>WWWBlogEntry</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWBlogEntry</td></tr>
</thead>
<tbody>
<tr>
	<td>BLOG_ENTRY_CATEGORY</td>
	<td>//a/div[contains(@class,'small-caps')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_TITLE</td>
	<td>//div[contains(@class,'color-neutral-1')]/div</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_IMAGE</td>
	<td>//div[contains(@class,'fragments-image-div')]/img</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_AUTHOR</td>
	<td>//div[contains(@id,'fragment-0-bcze')]/h5/div[contains(@class,'color-black')]/div</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_DATE</td>
	<td>//div[contains(@id,'fragment-0-ptzr')]/div[contains(@class,'f-text-content')]/div</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_CONTENT</td>
	<td>//div[contains(@class,'f-blog-content')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>