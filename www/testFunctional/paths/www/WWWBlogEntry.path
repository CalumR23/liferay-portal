<html>
<head>
<title>WWWBlogEntry</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWBlogEntry</td></tr>
</thead>
<tbody>
<tr>
	<td>BLOG_ENTRY_CATEGORY</td>
	<td>//p[@class='small-caps']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_TITLE</td>
	<td>//h1[@class='small-padding-vertical']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_AUTHOR</td>
	<td>//div[@class='blogs-entry-author']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_DATE</td>
	<td>//div[@class='blogs-entry-display-date']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_CONTENT</td>
	<td>//div[contains(@class,'blogs-content')]/div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>