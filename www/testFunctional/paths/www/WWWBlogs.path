<html>
<head>
<title>WWWBlogs</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWBlogs</td></tr>
</thead>
<tbody>
<tr>
	<td>BLOG_ENTRY_LINK</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a[@class='blog-entry-link']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_IMAGE</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/div[@class='image-wrapper']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_CATEGORY</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a[contains(@class,'blogs-category-link')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_TITLE</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/h4[@class='title']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_DESCRIPTION</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>