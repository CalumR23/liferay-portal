<html>
<head>
<title>WWWBlogs</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWBlogs</td></tr>
</thead>
<tbody>
<tr>
	<td>BLOG_ENTRY_LINK</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a[@class='blog-entry-link']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_IMAGE</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/div[@class='image-wrapper']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_CATEGORY</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a[contains(@class,'blogs-category-link')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_TITLE</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/h4[@class='title']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_DESCRIPTION</td>
	<td>//div[contains(@class,'blogs-entry tile') and contains(.,'${key_blogsEntryTitle}')]/a/div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_LINK_BY_POSITION</td>
	<td>xpath=(//div[contains(@class,'blog-post-title')]/ancestor::a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_IMAGE_BY_POSITION</td>
	<td>xpath=(//div/img[contains(@class,'blog-post-image')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_CATEGORY_BY_POSITION</td>
	<td>xpath=(//div[contains(@class,'blog-post-tag')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_TITLE_BY_POSITION</td>
	<td>xpath=(//div[contains(@class,'blog-post-title')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_ENTRY_DESCRIPTION_BY_POSITION</td>
	<td>xpath=(//div[contains(@class,'blog-post-description')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>READ_POST_BUTTON</td>
	<td>//a[.='Read Post']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@placeholder='Search All Blogs']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_CATEGORY_LINK</td>
	<td>//div[contains(@data-lfr-editable-id,'blogsCategoryItemText') and contains(.,"${key_blogCategory}")]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_BLOG_CATEGORY_LINK</td>
	<td>xpath=(//div[contains(@class,'blog-post-tag')]/span[contains(.,"${key_blogCategory}")])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOMER_EXPERIENCE_LINK</td>
	<td>//h3[@class='blog-title' and .='Customer Experience']</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_CUSTOMER_EXPERIENCE_LINK</td>
	<td>xpath=(//h3[@class='blog-title' and .='Customer Experience']/parent::a/parent::div//h4[@class='title'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_CUSTOMER_EXPERIENCE_LINK_ONE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Customer Experience']/parent::a/parent::div//h4[@class='title'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_CUSTOMER_EXPERIENCE_LINK_TWO</td>
	<td>xpath=(//h3[@class='blog-title' and .='Customer Experience']/parent::a/parent::div//h4[@class='title'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_CUSTOMER_EXPERIENCE_LINK_THREE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Customer Experience']/parent::a/parent::div//h4[@class='title'])[3]</td>
	<td></td>
</tr>
<tr>
	<td>DIGITAL_STRATEGY_LINK</td>
	<td>//h3[@class='blog-title' and .='Digital Strategy']</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_DIGITAL_STRATEGY_LINK</td>
	<td>xpath=(//h3[@class='blog-title' and .='Digital Strategy']/parent::a/parent::div//h4[@class='title'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_DIGITAL_STRATEGY_LINK_ONE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Digital Strategy']/parent::a/parent::div//h4[@class='title'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_DIGITAL_STRATEGY_LINK_TWO</td>
	<td>xpath=(//h3[@class='blog-title' and .='Digital Strategy']/parent::a/parent::div//h4[@class='title'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_DIGITAL_STRATEGY_LINK_THREE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Digital Strategy']/parent::a/parent::div//h4[@class='title'])[3]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCTS_AND_TECHNOLOGY_LINK</td>
	<td>//h3[@class='blog-title' and .='Products and Technology']</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_PRODUCTS_AND_TECHNOLOGY_LINK</td>
	<td>xpath=(//h3[@class='blog-title' and .='Products and Technology']/parent::a/parent::div//h4[@class='title'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_PRODUCTS_AND_TECHNOLOGY_LINK_ONE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Products and Technology']/parent::a/parent::div//h4[@class='title'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_PRODUCTS_AND_TECHNOLOGY_LINK_TWO</td>
	<td>xpath=(//h3[@class='blog-title' and .='Products and Technology']/parent::a/parent::div//h4[@class='title'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_PRODUCTS_AND_TECHNOLOGY_LINK_THREE</td>
	<td>xpath=(//h3[@class='blog-title' and .='Products and Technology']/parent::a/parent::div//h4[@class='title'])[3]</td>
	<td></td>
</tr>
<tr>
	<td>SWITCH_LOCALES_SELECT</td>
	<td>//select[@class='blogs-region-select']</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_MORE_BUTTON</td>
	<td>//a[.='View More']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>