<html>
<head>
<title>WWWSearch</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">WWWSearch</td></tr>
</thead>

<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@id='st-search-input']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_LINK</td>
	<td>//div[@class='st-result' and contains(.,'${key_pageTitle}')]/h4[@class='page-title']/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_URL</td>
	<td>//div[@class='st-result' and contains(.,'${key_pageTitle}')]/div[@class='st-result-content']/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_DESCRIPTION</td>
	<td>//div[@class='st-result' and contains(.,'${key_pageTitle}')]/p[@class='page-description']</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_LINK</td>
	<td>//a[@class='st-prev']</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//a[@class='st-next']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>