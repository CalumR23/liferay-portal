<html>
<head>
<title>Marketplace</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Marketplace</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_IMAGE</td>
	<td>xpath=(//div[contains(@class,'image-container')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_LINK</td>
	<td>xpath=(//a[contains(@class,'search-results-card')])[${key_positionValue}]</td>
	<td></td>
</tr>

<!--PAGINATION-->

<tr>
	<td>FIRST_LINK</td>
	<td>xpath=(//ul//a[contains(@class,'page-link')]/span[contains(@class,'sr-only')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//li/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>