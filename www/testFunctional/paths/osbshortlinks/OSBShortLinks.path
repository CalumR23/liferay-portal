<html>
<head>
<title>OSBShortLinks</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBShortLinks</td></tr>
</thead>
<tbody>
<tr>
	<td>SHORT_URL_FIELD</td>
	<td>//input[contains(@id,'osb_www_short_link_web_shortURL')]</td>
	<td></td>
</tr>
<tr>
	<td>ORIGINAL_URL_FIELD</td>
	<td>//input[contains(@id,'osb_www_short_link_web_originalURL')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_URL_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SHORT_LINK-->
<tr>
	<td>SHORT_LINK_ID</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_CREATE_DATE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_MODIFIED_DATE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_SHORT_URL</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_ORIGINAL_URL</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[5]</td>
	<td></td>
</tr>

<tr>
	<td>SHORT_LINK_HTTP_STATUS_CODE</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>SHORT_LINK_ACTIONS</td>
	<td>//tr[contains(.,'${key_shortUrl}') and contains(.,'${key_originalUrl}')]/td[contains(@class,'last')]//a[@title='Actions']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>