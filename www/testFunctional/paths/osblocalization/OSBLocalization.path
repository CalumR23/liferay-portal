<html>
<head>
<title>OSBLocalization</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBLocalization</td></tr>
</thead>
<tbody>
<tr>
	<td>ADD_LOCALIZATION_PLUS_BUTTON</td>
	<td>//a[contains(@aria-label,'add-localization')]</td>
	<td></td>
</tr>
<tr>
	<td>KEY_FIELD</td>
	<td>//input[contains(@id,'osb_www_localization_web_key')]</td>
	<td></td>
</tr>
<tr>
	<td>VALUE_FIELD</td>
	<td>//input[contains(@id,'osb_www_localization_web_value')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_LOCALIZATION_BUTTON</td>
	<td>//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--LOCALIZATION-->
<tr>
	<td>LOCALIZATION_ID</td>
	<td>//tr[contains(.,'${key_key}') and contains(.,'${key_value}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_CREATE_DATE</td>
	<td>//tr[contains(.,'${key_key}') and contains(.,'${key_value}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_MODIFIED_DATE</td>
	<td>//tr[contains(.,'${key_key}') and contains(.,'${key_value}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_KEY</td>
	<td>//tr[${key_positionValue}]/td[contains(@class,'value-column') and contains(.,'${key_key}')]/preceding-sibling::td[contains(@class,'key-column') and contains(.,'${key_value}')]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_VALUE</td>
	<td>//tr[${key_positionValue}]/td[contains(@class,'key-column') and contains(.,'${key_key}')]/following-sibling::td[contains(@class,'value-column') and contains(.,'${key_value}')]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZATION_ACTIONS</td>
	<td>//tr/td[contains(@class,'key-column') and contains(.,'${key_key}')]/following-sibling::td[contains(@class,'value-column') and contains(.,'${key_value}')]/following-sibling::td/div/a[contains(@title,'Actions')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_LINK</td>
	<td>//a[contains(.,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_LINK</td>
	<td>//a[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PAGE_LINK</td>
	<td>//div[contains(@class,'lfr-pagination-page-selector')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>ITEMS_PER_PAGE_LINK</td>
	<td>//div[contains(@class,'lfr-pagination-delta-selector')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>VALUE_LINK</td>
	<td>//span[.='${key_value}']/parent::a</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_LINK</td>
	<td>//li/a[contains(.,'First')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'First')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_LINK</td>
	<td>//li/a[contains(.,'Previous')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Previous')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//li/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_LINK</td>
	<td>//li/a[contains(.,'Last')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Last')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>