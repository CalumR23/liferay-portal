definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I click on the ${linkName} link under the ${sectionText} section on the DXP Page"
	macro clickDXPPageLinks {
		var currentUrl = WWWHomepage.getUrl();

		var key_sectionText = "${sectionText}";
		var key_linkName = "${linkName}";

		WaitForSPARefresh();

		ScrollWebElementIntoView(locator1 = "WWWProducts#DXP_PAGE_SECTION_LINK");

		if (IsElementNotPresent(locator1 = "WWWProducts#DXP_PAGE_SECTION_LINK")) {
			ScrollBy(value1 = "0, 9999");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWProducts#DXP_PAGE_SECTION_LINK");
		}

		Click.pauseMakeVisibleClickAt(locator1 = "WWWProducts#DXP_PAGE_SECTION_LINK");
	}

	@prose = "I request a download of Liferay DXP 30 day free trial with the following values ${table}"
	macro create30DayFreeTrialDownloadRequest {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Work Email") {
				if (IsElementNotPresent(locator1 = "WWWProducts#WORK_EMAIL_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#WORK_EMAIL_FIELD");

					Type(
						locator1 = "WWWProducts#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWProducts#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Country") {
				if (IsElementNotPresent(locator1 = "WWWProducts#COUNTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#COUNTRY_SELECT");

					Select(
						locator1 = "WWWProducts#COUNTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWProducts#COUNTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "State/Territory") {
				if (IsElementNotPresent(locator1 = "WWWProducts#STATE_TERRITORY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#STATE_TERRITORY_SELECT");

					Select(
						locator1 = "WWWProducts#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWProducts#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Download Type") {
				if (IsElementNotPresent(locator1 = "WWWProducts#DOWNLOAD_TYPE_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#DOWNLOAD_TYPE_SELECT");

					Select(
						locator1 = "WWWProducts#DOWNLOAD_TYPE_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWProducts#DOWNLOAD_TYPE_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "First Name") {
				if (IsElementNotPresent(locator1 = "WWWProducts#FIRST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#FIRST_NAME_FIELD");

					Type(
						locator1 = "WWWProducts#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWProducts#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Last Name") {
				if (IsElementNotPresent(locator1 = "WWWProducts#LAST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#LAST_NAME_FIELD");

					Type(
						locator1 = "WWWProducts#LAST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWProducts#LAST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company") {
				if (IsElementNotPresent(locator1 = "WWWProducts#COMPANY_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#COMPANY_NAME_FIELD");

					Type(
						locator1 = "WWWProducts#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWProducts#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Phone") {
				if (IsElementNotPresent(locator1 = "WWWProducts#PHONE_NUMBER_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWProducts#PHONE_NUMBER_FIELD");

					Type(
						locator1 = "WWWProducts#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWProducts#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
			}
			else {
				fail("No such request field ${field}");
			}
		}
		AssertVisible(locator1 = "WWWProducts#DOWNLOAD_BUTTON");

		Click(locator1 = "WWWProducts#DOWNLOAD_BUTTON");

		DownloadTempFile();
	}

    @prose = "I should be able to view the 30 day trial page and form"
	macro view30DayFreeTrialPageAndForm {
		AssertVisible(locator1 = "WWWProducts#30_DAY_TRIAL_HEADER");

		AssertVisible(locator1 = "WWWProducts#WORK_EMAIL_FIELD");
		AssertVisible(locator1 = "WWWProducts#COUNTRY_SELECT");
		AssertVisible(locator1 = "WWWProducts#DOWNLOAD_TYPE_SELECT");
		AssertVisible(locator1 = "WWWProducts#FIRST_NAME_FIELD");
		AssertVisible(locator1 = "WWWProducts#LAST_NAME_FIELD");
		AssertVisible(locator1 = "WWWProducts#COMPANY_NAME_FIELD");
		AssertVisible(locator1 = "WWWProducts#PHONE_NUMBER_FIELD");

		AssertVisible(locator1 = "WWWProducts#DOWNLOAD_BUTTON");
	}

	@prose = "I should be able to watch the section video"
	macro viewSectionVideo {
		if (IsElementPresent(locator1 = "WWWProducts#VIDEO_PLAY_IMAGE")) {
			Click(locator1 = "WWWProducts#VIDEO_PLAY_IMAGE");

			AssertElementPresent(locator1 = "WWWProducts#VIDEO_PAUSE_BUTTON");
		}
		else {
			ScrollWebElementIntoView(locator1 = "WWWProducts#VIDEO_PLAY_IMAGE");

			Click(locator1 = "WWWProducts#VIDEO_PLAY_IMAGE");

			AssertElementPresent(locator1 = "WWWProducts#VIDEO_PAUSE_BUTTON");
		}

		echo("Video playback has started");

		while ((IsElementNotPresent(locator1 = "WWWProducts#VIDEO_PLAY_BUTTON")) && (IsElementPresent(locator1 = "WWWProducts#VIDEO_PAUSE_BUTTON"))) {
			echo("Video is currently playing");

			Pause(locator1 = "10000");
		}

		echo("Video playback has ended");

		AssertElementPresent(locator1 = "WWWProducts#VIDEO_REWATCH_BUTTON");
	}
}