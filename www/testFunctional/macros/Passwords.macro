definition {
    var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
    var wwwAdminPassword = PropsUtil.get("www.admin.password");

    @prose = "I get all test passwords and admin emails"
    macro getPasswords {
        static var staticWWWAdminEmailAddress = "${wwwAdminEmailAddress}";
        static var staticWWWAdminPassword = "${wwwAdminPassword}";

        return "${staticWWWAdminEmailAddress}";
        return "${staticWWWAdminPassword}";
    }
}