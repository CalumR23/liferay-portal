definition {
	@prose = "I add a public page with the name ${pageName}"
	macro addPublicPage {
		SelectFrame(locator1 = "Page#ADD_PAGE_IFRAME");

		Type(
			locator1 = "Page#ADD_PAGE_NAME_FIELD",
			value1 = "${pageName}");

		Click.pauseMakeVisibleClickAt(locator1 = "Page#ADD_PAGE_ADD_BUTTON");

		SelectFrameTop();
	}

	@prose = "I click on the add public page button"
	macro clickAddPublicPageButton {
		Click(locator1 = "Page#ADD_PUBLIC_PAGE");
	}

	@prose = "I click on the ${pageTemplate} page template"
	macro clickPageTemplate {
		var key_entryTitle = "${pageTemplate}";

		Click(locator1 = "Page#ENTRY_CARDS_THUMBNAIL");
	}

	@prose = "I click on the publish public page button"
	macro clickPublishButton {
		Click.pauseMakeVisibleClickAt(locator1 = "PageEdit#PUBLISH_BUTTON");
	}

	@prose = "I should be able to view the public page ${pageName}"
	macro viewPublicPage {
		var key_pageName = "${pageName}";

		AssertTextEquals.assertPartialText(
			locator1 = "Page#PUBLIC_PAGE",
			value1 = "${pageName}");
	}
}