definition {

	macro tearDownCP {
		Type(
			locator1 = "RecycleBin#SEARCH_FIELD",
			value1 = "${entryTitle}");

		KeyPress(
			locator1 = "RecycleBin#SEARCH_FIELD",
			value1 = "\RETURN");

		var key_entryTitle = "${entryTitle}";

		if (IsElementPresent.pauseIsElementPresent(locator1 = "RecycleBin#ENTRY_LIST_CHECKBOX")) {
			Check(locator1 = "RecycleBin#ENTRY_LIST_CHECKBOX");

			ClickNoError(locator1 = "RecycleBin#DELETE_BUTTON");

			Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

			AssertElementPresent(locator1 = "Message#SUCCESS");
		}
	}

}