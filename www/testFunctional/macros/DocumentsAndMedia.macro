definition {

	@prose = "I clear the following existing documents and media fields ${table}"
	macro clearExistingDocumentsAndMediaFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldName = "${row[0]}";
			var fieldType = "${row[1]}";

			if ("${fieldName}" == "File") {
				UploadCommonFile(
					locator1 = "DocumentsAndMediaCreate#FILE_FIELD",
					value1 = "");
			}
			else if (contains("${fieldName}", "Quote")) {
				if ("${fieldType}" == "Input") {
					DocumentsAndMedia.clearViaExactInputField(field = "${fieldName}");
				}
				else if ("${fieldType}" == "Textarea") {
					DocumentsAndMedia.clearViaExactTextareaField(field = "${fieldName}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input or Textarea");
				}
			}
			else {
				if ("${fieldType}" == "Input") {
					DocumentsAndMedia.clearViaApproximateInputField(field = "${fieldName}");
				}
				else if ("${fieldType}" == "Textarea") {
					DocumentsAndMedia.clearViaApproximateTextareaField(field = "${fieldName}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input or Textarea");
				}
			}
		}
	}

	macro clearViaApproximateInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		Type(
			locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "");
	}

	macro clearViaApproximateTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "DocumentsAndMediaCreate#TEXTAREA_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		Type(
			locator1 = "DocumentsAndMediaCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "");
	}

	macro clearViaExactInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		Type(
			locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_EXACT",
			value1 = "");
	}

	macro clearViaExactTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "DocumentsAndMediaCreate#TEXTAREA_FIELD_EXACT", value1 = "")) {
