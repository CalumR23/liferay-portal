	macro uploadFileViaApproximateField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_APPROXIMATE")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "DocumentsAndMediaCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Click(locator1 = "DocumentsAndMediaCreate#SELECT_BUTTON_APPROXIMATE");

		SelectFrame(locator1 = "DocumentsAndMediaCreate#SELECT_FILE_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				AssertElementPresent(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				ScrollWebElementIntoView(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				Click.pauseMakeVisibleClickAt(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				WaitForSPARefresh();
			}
		}
		else {
			UploadCommonFile(
				locator1 = "DocumentsAndMediaCreate#SELECT_FILE_FIELD",
				value1 = "${value}");
		}

		SelectFrameTop();
	}

	macro uploadFileViaExactField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "DocumentsAndMediaCreate#INPUT_FIELD_EXACT")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "DocumentsAndMediaCreate#ADD_DUPLICATE_FIELD_BUTTON_EXACT");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Click(locator1 = "DocumentsAndMediaCreate#SELECT_BUTTON_EXACT");

		SelectFrame(locator1 = "DocumentsAndMediaCreate#SELECT_FILE_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				AssertElementPresent(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				ScrollWebElementIntoView(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				Click(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				WaitForSPARefresh();
