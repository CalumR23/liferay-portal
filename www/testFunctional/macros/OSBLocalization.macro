definition {
	@prose = "I create a localization with the key ${key} and value ${value}"
	macro createLocalization {
		Type(
			locator1 = "OSBLocalization#KEY_FIELD",
			value1 = "${key}");

		Type(
			locator1 = "OSBLocalization#VALUE_FIELD",
			value1 = "${value}");

		Click(locator1 = "OSBLocalization#ADD_LOCALIZATION_BUTTON");
	}

	@prose = "I should be able to view a localization with the key ${key} and value ${value}"
	macro viewLocalization {
		var key_key = "${key}";
		var key_value = "${value}";

		AssertTextEquals(
			locator1 = "OSBLocalization#LOCALIZATION_KEY",
			value1 = "${key}");

		AssertTextEquals(
			locator1 = "OSBLocalization#LOCALIZATION_VALUE",
			value1 = "${value}");
	}
}