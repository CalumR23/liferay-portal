definition {
	@prose = "I create a localization with the key ${key} and value ${value}"
	macro createLocalization {
		
		Click(locator1 = "OSBLocalization#ADD_LOCALIZATION_PLUS_BUTTON");
		
		Type(
			locator1 = "OSBLocalization#KEY_FIELD",
			value1 = "${key}");

		Type(
			locator1 = "OSBLocalization#VALUE_FIELD",
			value1 = "${value}");

		Click(locator1 = "OSBLocalization#ADD_LOCALIZATION_BUTTON");
	}

	@prose = "I tear down the localizations with the folowing keys and values ${table}"
	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Content &amp; Data",
			panel = "Site Administration",
			portlet = "OSB Localization");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var key = "${row[0]}";
			var value = "${row[1]}";

			var key_key = "${key}";
			var key_value = "${value}";
			var notFound = "true";

			if (IsElementPresent.pauseIsElementPresent(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS")) {
				ScrollWebElementIntoView(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS");

				Click(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS");

				ClickNoError(locator1 = "OSBLocalization#DELETE_LINK");

				Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

				AssertElementPresent(locator1 = "Message#SUCCESS");
			}
			else {
				while ((IsElementNotPresent(locator1 = "OSBLocalization#NEXT_LINK_DISABLED")) && ("${notFound}" == "true")) {
					Click.pauseMakeVisibleClickAt(locator1 = "OSBLocalization#NEXT_LINK");

					if (IsElementPresent.pauseIsElementPresent(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS")) {
						ScrollWebElementIntoView(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS");

						Click(locator1 = "OSBLocalization#LOCALIZATION_ACTIONS");

						ClickNoError(locator1 = "OSBLocalization#DELETE_LINK");

						Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

						AssertElementPresent(locator1 = "Message#SUCCESS");

						var notFound = "false";
					}
					else {
						var notFound = "true";
					}
				}
			}
		}
	}

	@prose = "I should be able to view a localization with the key ${key} and value ${value} in the position ${positionValue}"
	macro viewLocalization {
		var key_key = "${key}";
		var key_value = "${value}";
		var key_positionValue = "${positionValue}";

		AssertTextEquals(
			locator1 = "OSBLocalization#LOCALIZATION_KEY",
			value1 = "${key}");

		AssertTextEquals(
			locator1 = "OSBLocalization#LOCALIZATION_VALUE",
			value1 = "${value}");
	}
}