definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I should be able to view the Contact Sales page and form"
	macro viewContactSalesPageAndForm {
		AssertVisible(locator1 = "WWWContactSales#CONTACT_SALES_HEADER");

		AssertVisible(locator1 = "WWWContactSales#FIRST_NAME_FIELD");
		AssertVisible(locator1 = "WWWContactSales#LAST_NAME_FIELD");
		AssertVisible(locator1 = "WWWContactSales#WORK_EMAIL_FIELD");
		AssertVisible(locator1 = "WWWContactSales#COUNTRY_SELECT");
		AssertVisible(locator1 = "WWWContactSales#COMPANY_NAME_FIELD");
		AssertVisible(locator1 = "WWWContactSales#PHONE_NUMBER_FIELD");
		AssertVisible(locator1 = "WWWContactSales#INDUSTRY_SELECT");
		AssertVisible(locator1 = "WWWContactSales#COMMENTS_FIELD");

		AssertVisible(locator1 = "WWWContactSales#DXP_CHECKBOX");
		AssertVisible(locator1 = "WWWContactSales#DXP_CLOUD_CHECKBOX");
		AssertVisible(locator1 = "WWWContactSales#ANALYTICS_CLOUD_CHECKBOX");
		AssertVisible(locator1 = "WWWContactSales#COMMERCE_CHECKBOX");

		AssertVisible(locator1 = "WWWContactSales#SUBMIT_BUTTON");
	}
}