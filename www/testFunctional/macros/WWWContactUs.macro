definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I populate and submit the Contact Us form with the following values ${table}"
	macro createContactRequest {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Work Email") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#WORK_EMAIL_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#WORK_EMAIL_FIELD");

					Type(
						locator1 = "WWWContactUs#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Country") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#COUNTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#COUNTRY_SELECT");

					Select(
						locator1 = "WWWContactUs#COUNTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#COUNTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "State/Territory") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#STATE_TERRITORY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#STATE_TERRITORY_SELECT");

					Select(
						locator1 = "WWWContactUs#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "What would you like to talk about?") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#COMMENTS_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#COMMENTS_FIELD");

					Type(
						locator1 = "WWWContactUs#COMMENTS_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#COMMENTS_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Whats your challenge?") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#WHATS_YOUR_CHALLENGE_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#WHATS_YOUR_CHALLENGE_SELECT");

					Select(
						locator1 = "WWWContactUs#WHATS_YOUR_CHALLENGE_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#WHATS_YOUR_CHALLENGE_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "First Name") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#FIRST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#FIRST_NAME_FIELD");

					Type(
						locator1 = "WWWContactUs#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Last Name") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#LAST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#LAST_NAME_FIELD");

					Type(
						locator1 = "WWWContactUs#LAST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#LAST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#COMPANY_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#COMPANY_NAME_FIELD");

					Type(
						locator1 = "WWWContactUs#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Phone") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#PHONE_NUMBER_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#PHONE_NUMBER_FIELD");

					Type(
						locator1 = "WWWContactUs#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Industry") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#INDUSTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#INDUSTRY_SELECT");

					Select(
						locator1 = "WWWContactUs#INDUSTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#INDUSTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company Revenue") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#COMPANY_REVENUE")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#COMPANY_REVENUE");

					Select(
						locator1 = "WWWContactUs#COMPANY_REVENUE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#COMPANY_REVENUE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Department") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#DEPARTMENT_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#DEPARTMENT_SELECT");

					Select(
						locator1 = "WWWContactUs#DEPARTMENT_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#DEPARTMENT_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Job Role") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#JOB_ROLE")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#JOB_ROLE");

					Select(
						locator1 = "WWWContactUs#JOB_ROLE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#JOB_ROLE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company Size") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#COMPANY_SIZE")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#COMPANY_SIZE");

					Select(
						locator1 = "WWWContactUs#COMPANY_SIZE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWContactUs#COMPANY_SIZE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Job Title") {
				if (IsElementNotPresent(locator1 = "WWWContactUs#JOB_TITLE")) {
					ScrollWebElementIntoView(locator1 = "WWWContactUs#JOB_TITLE");

					Type(
						locator1 = "WWWContactUs#JOB_TITLE",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWContactUs#JOB_TITLE",
						value1 = "${value}");
				}
			}
			else {
				fail("No such request field ${field}");
			}
		}

		AssertVisible(locator1 = "WWWContactUs#SUBMIT_BUTTON");

		Click(locator1 = "WWWContactUs#SUBMIT_BUTTON");
	}

	@prose = "I should be able to view the Contact Us page and form"
	macro viewContactUsPageAndForm {
		AssertVisible(locator1 = "WWWContactUs#CONTACT_US_HEADER");

		AssertVisible(locator1 = "WWWContactUs#WORK_EMAIL_FIELD");

		AssertVisible(locator1 = "WWWContactUs#COUNTRY_SELECT");

		AssertVisible(locator1 = "WWWContactUs#COMMENTS_FIELD");

		AssertVisible(locator1 = "WWWContactUs#WHATS_YOUR_CHALLENGE_SELECT");

		AssertVisible(locator1 = "WWWContactUs#FIRST_NAME_FIELD");

		AssertVisible(locator1 = "WWWContactUs#LAST_NAME_FIELD");

		AssertVisible(locator1 = "WWWContactUs#COMPANY_NAME_FIELD");

		AssertVisible(locator1 = "WWWContactUs#PHONE_NUMBER_FIELD");

		AssertVisible(locator1 = "WWWContactUs#INDUSTRY_SELECT");

		AssertVisible(locator1 = "WWWContactUs#COMPANY_REVENUE");

		AssertVisible(locator1 = "WWWContactUs#DEPARTMENT_SELECT");

		AssertVisible(locator1 = "WWWContactUs#JOB_ROLE");

		AssertVisible(locator1 = "WWWContactUs#COMPANY_SIZE");

		AssertVisible(locator1 = "WWWContactUs#JOB_TITLE");

		AssertVisible(locator1 = "WWWContactUs#SUBMIT_BUTTON");
	}

	@prose = "I should be able to view a message stating that the contact form was sent"
	macro viewMessageAfterSubmitContactForm {
		AssertElementPresent(locator1 = "WWWContactUs#SENT_MESSAGE");
	}

}