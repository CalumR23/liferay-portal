definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

    @prose = "I go to the www Partners homepage" 
    macro goToPartnersHomepage {
        Open(locator1 = "${wwwURL}/partners");

        WaitForSPARefresh();

        var currentUrl = WWWHomepage.getUrl();

        if (!("${currentUrl}" == "https://www-uat.liferay.com/partners")) {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
        }

    }

    @prose = "I click on the ${linkName} card on the partners homepage"
    macro clickCardLink {
        var key_cardName = "${linkName}";

        if ("${linkName}" == "Find a Partner") {
            Click(locator1 = "WWWPartners#FIND_A_PARTNER_CARD_LINK");

        }
        else if ("${linkName}" == "Become a Partner") {
            Click(locator1 = "WWWPartners#BECOME_A_PARTNER_CARD_LINK");

        }
        else if ("${linkName}" == "Partner Portal") {
            Click(locator1 = "WWWPartners#PARTNER_PORTAL_CARD_LINK");

        }

    }

}