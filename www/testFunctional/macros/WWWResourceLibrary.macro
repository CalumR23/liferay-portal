definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I clear all resource filters"
	macro clearAllResourceFilters {
		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#FILTER_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#FILTER_BUTTON");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#CLEAR_ALL_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#CLEAR_ALL_BUTTON");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#APPLY_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#APPLY_BUTTON");
	}

	@prose = "I click on the resource with the title ${resourceTitle}"
	macro clickResourceTypeWithTitle {
		var key_resourceTitle = "${resourceTitle}";

		if (IsElementPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE")) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");

			Click(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");
		}
		else {
			while ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE")) && (IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE_DISABLED")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE"))) {
				ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

				ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");

				Click(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");
			}
		}
	}

	@prose = "I request a download of a resource with the following values ${table}"
	macro createResourceDownloadRequest {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Work Email") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#WORK_EMAIL_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#WORK_EMAIL_FIELD");

					Type(
						locator1 = "WWWResourceLibrary#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWResourceLibrary#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Country") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#COUNTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#COUNTRY_SELECT");

					Select(
						locator1 = "WWWResourceLibrary#COUNTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWResourceLibrary#COUNTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "State/Territory") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#STATE_TERRITORY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#STATE_TERRITORY_SELECT");

					Select(
						locator1 = "WWWResourceLibrary#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWResourceLibrary#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "First Name") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#FIRST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#FIRST_NAME_FIELD");

					Type(
						locator1 = "WWWResourceLibrary#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWResourceLibrary#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Last Name") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#LAST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#LAST_NAME_FIELD");

					Type(
						locator1 = "WWWResourceLibrary#LAST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWResourceLibrary#LAST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company") {
				if (IsElementNotPresent(locator1 = "WWWResourceLibrary#COMPANY_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#COMPANY_NAME_FIELD");

					Type(
						locator1 = "WWWResourceLibrary#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWResourceLibrary#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else {
				fail("No such request field ${field}");
			}
		}
		AssertVisible(locator1 = "WWWResourceLibrary#DOWNLOAD_BUTTON");

		Click(locator1 = "WWWResourceLibrary#DOWNLOAD_BUTTON");

		DownloadTempFile();
	}

	@prose = "I filter the resources in the Resource Library using the following filters and values ${table}"
	macro filterResources {
		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#FILTER_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#FILTER_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var filter = "${row[0]}";
			var value = "${row[1]}";

			var key_value = "${value}";

			if ("${filter}" == "Solutions") {
				if (IsNotChecked(locator1 = "WWWResourceLibrary#SOLUTIONS_FILTER_CHECKBOX")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#SOLUTIONS_FILTER_CHECKBOX");					
				}
			}
			else if ("${filter}" == "Industries") {
				if (IsNotChecked(locator1 = "WWWResourceLibrary#INDUSTRIES_FILTER_CHECKBOX")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#INDUSTRIES_FILTER_CHECKBOX");
				}
			}
			else if ("${filter}" == "Resource Types") {
				if (IsNotChecked(locator1 = "WWWResourceLibrary#RESOURCE_TYPES_FILTER_CHECKBOX")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESOURCE_TYPES_FILTER_CHECKBOX");
				}
			}
			else {
				fail("No such resource filter ${filter}. Please use one of the following filters or update the test if changes are necessary: Solutions, Industries, or Resource Types");
			}
		}

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#APPLY_BUTTON");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#APPLY_BUTTON");	
	}

	@prose = "I reset the search bar"
	macro resetSearchButton {
		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#SEARCH_FIELD");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#SEARCH_FIELD");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESET_SEARCH_BUTTON");	
	}

	@prose = "I type in the resource keyword ${keyword} in the Resource Library search bar and click search"
	macro searchResources {
		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#SEARCH_FIELD");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#SEARCH_FIELD");

		Type(
			locator1 = "WWWResourceLibrary#SEARCH_FIELD",
			value1 = "&quot;${keyword}&quot;");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#SEARCH_BUTTON");	
	}

	@prose = "I toggle the results per page value to ${resultsPerPage} results"
	macro toggleResultsPerPage {
		AssertElementPresent(locator1 = "WWWResourceLibrary#RESULTS_ITEMS_PER_PAGE_BUTTON");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_ITEMS_PER_PAGE_BUTTON");

		var key_resultsPerPage = "${resultsPerPage}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_ITEMS_PER_PAGE_BUTTON");

		ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_ITEMS_PER_PAGE_OPTION");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_ITEMS_PER_PAGE_OPTION");
	}

	@prose = "I should not be able to view the resource with the title ${resourceTitle}"
	macro viewNoResource {
		var key_resourceTitle = "${resourceTitle}";

		if ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE_ACTIVE")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");
		}

		AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");
		AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_TYPE");
		AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_TITLE");
		AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_IMAGE");

		while ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE_DISABLED")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

			AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");
			AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_TYPE");
			AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_TITLE");
			AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_IMAGE");
		}
	}

	@prose = "I should not be able to view a resource with the type ${resourceType}"
	macro viewNoResourceType {
		var key_resourceType = "${resourceType}";
		
		AssertElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TYPE");
	}

	@prose = "I should be able to view the resource with the title ${resourceTitle}"
	macro viewResource {
		var key_resourceTitle = "${resourceTitle}";

		if ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE_ACTIVE")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");
		}

		while ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE")) && (IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE_DISABLED")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");
		}
		
		AssertVisible(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TITLE");
		AssertVisible(locator1 = "WWWResourceLibrary#RESOURCE_TYPE");
		AssertVisible(locator1 = "WWWResourceLibrary#RESOURCE_TITLE");
		AssertElementPresent(locator1 = "WWWResourceLibrary#RESOURCE_IMAGE");
	}

	@prose = "I should be able to view the resources form"
	macro viewResourcesForm {
		AssertVisible(locator1 = "WWWResourceLibrary#RESOURCES_FORM_HEADER");

		AssertVisible(locator1 = "WWWResourceLibrary#WORK_EMAIL_FIELD");
		AssertVisible(locator1 = "WWWResourceLibrary#COUNTRY_SELECT");
		AssertVisible(locator1 = "WWWResourceLibrary#FIRST_NAME_FIELD");
		AssertVisible(locator1 = "WWWResourceLibrary#LAST_NAME_FIELD");
		AssertVisible(locator1 = "WWWResourceLibrary#COMPANY_NAME_FIELD");

		AssertVisible(locator1 = "WWWResourceLibrary#DOWNLOAD_BUTTON");
	}

	@prose = "I should be able to view a resource in the position value ${positionValue} with the title ${resourceTitle}"
	macro viewResourceByPosition {
		var key_positionValue = "${positionValue}";

		if ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE_ACTIVE")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_PAGE_ONE");
		}

		while ((IsElementNotPresent(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_POSITION")) && (IsElementNotPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE_DISABLED")) && (IsElementPresent(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE"))) {
			ScrollWebElementIntoView(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWResourceLibrary#RESULTS_NEXT_PAGE");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_POSITION",
			value1 = "${resourceTitle}");
	}

	@prose = "I should be able to view a resource with the type ${resourceType}"
	macro viewResourceType {
		var key_resourceType = "${resourceType}";

		AssertVisible(locator1 = "WWWResourceLibrary#RESOURCE_LINK_VIA_TYPE");
	}
}