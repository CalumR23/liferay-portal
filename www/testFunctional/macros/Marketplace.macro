definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	macro viewApplicationImages {
		var key_positionValue = "1";
		var imagesRemain = "true";

		var pageElementsFound = ${pageElementsFound} + 1;

		WaitForPageLoad();

		WWWHomepage.viewNoErrors();

		while (("${imagesRemain}" == "true") && (maxIterations = "100")) {
			WaitForElementPresent(locator1 = "Marketplace#CARD_IMAGE");

			while (IsElementPresent(locator1 = "Marketplace#CARD_IMAGE") && (maxIterations = "100")) {
				if (IsNotVisible(locator1 = "Marketplace#CARD_IMAGE")) {

					AssertElementPresent(locator1 = "Marketplace#CARD_IMAGE");

					ScrollWebElementIntoView(locator1 = "Marketplace#CARD_IMAGE");
				}
				else if (IsVisible(locator1 = "Marketplace#CARD_IMAGE")) {
					AssertVisible(locator1 = "Marketplace#CARD_IMAGE");
				}

				var key_positionValue = ${key_positionValue} + 1;
			}
			if (IsElementNotPresent(locator1 = "Marketplace#NEXT_LINK_DISABLED") && (IsElementPresent(locator1 = "Marketplace#NEXT_LINK"))) {
				var key_positionValue = "1";

				Click(locator1 = "Marketplace#NEXT_LINK");
			}
			else {
				var imagesRemain = "false";
			}
		}

		WWWHomepage.gotoRelativeURL(url = "${url}");
	}

	macro viewApplicationLinksAndForms {
		var key_positionValue = "1";
		var linksRemain = "true";

		var pageElementsFound = ${pageElementsFound} + 1;

		WaitForPageLoad();

		WWWHomepage.viewNoErrors();

		while (("${linksRemain}" == "true") && (maxIterations = "100")) {
			WaitForElementPresent(locator1 = "Marketplace#CARD_LINK");

			while (IsElementPresent(locator1 = "Marketplace#CARD_LINK") && (maxIterations = "100")) {
				ScrollWebElementIntoView(locator1 = "Marketplace#CARD_LINK");

				var applicationLink = selenium.getAttribute("xpath=(//a[contains(@class,'search-results-card')])[${key_positionValue}]@href");

				if (IsVisible(locator1 = "Marketplace#CARD_LINK")) {
					AssertVisible(locator1 = "Marketplace#CARD_LINK");

					Click.clickNoMouseOver(locator1 = "Marketplace#CARD_LINK");
				}

				WaitForPageLoad();

				echo("Application url page: ${applicationLink}.");

				WWWHomepage.viewNoErrors();

				WWWPage.populateAndSubmitForm(url = "${url}");

				GoBack();

				var key_positionValue = ${key_positionValue} + 1;
			}
			if (IsElementNotPresent(locator1 = "Marketplace#NEXT_LINK_DISABLED") && (IsElementPresent(locator1 = "Marketplace#NEXT_LINK"))) {
				var key_positionValue = "1";

				Click(locator1 = "Marketplace#NEXT_LINK");
			}
			else {
				var linksRemain = "false";
			}
		}

		WWWHomepage.gotoRelativeURL(url = "${url}");
	}

	macro viewCheckboxFilters {
		var key_positionValue = "1";
		var checkboxFiltersRemain = "true";

		var pageElementsFound = ${pageElementsFound} + 1;

		WaitForPageLoad();

		WWWHomepage.viewNoErrors();

		while (("${checkboxFiltersRemain}" == "true") && (maxIterations = "100")) {
			WaitForElementPresent(locator1 = "Marketplace#CHECKBOX_FILTER");

			while (IsElementPresent(locator1 = "Marketplace#CHECKBOX_FILTER") && (maxIterations = "100")) {
				ScrollWebElementIntoView(locator1 = "Marketplace#CHECKBOX_FILTER");

				Check.checkNotVisible(locator1 = "Marketplace#CHECKBOX_FILTER");

				WWWHomepage.viewNoErrors();

				Marketplace.viewApplicationLinksAndForms();

				Uncheck.uncheckNotVisible(locator1 = "Marketplace#CHECKBOX_FILTER");

				var key_positionValue = ${key_positionValue} + 1;
			}

			var checkboxFiltersRemain = "false";
		}
	}

	@prose = "I should be able to view the marketplace page with the relative url ${url}"
	macro viewMarketplacePage {
		static var pageElementsFound = "0";

		WWWHomepage.gotoRelativeURL(url = "${url}");

		Marketplace.viewApplicationImages(url = "${url}");

		Marketplace.viewApplicationLinksAndForms(url = "${url}");

		Marketplace.viewCheckboxFilters();

		if ("${url}" == "web/marketplace") {
            WWWPage.viewFooterNavigationLinks(url = "${url}");
        }

        if ("${url}" == "web/marketplace") {
            WWWPage.viewSocialMediaFooterNavigationLinks(url = "${url}");
        }

		echo("Total page elements found: ${pageElementsFound}");

		if ("${pageElementsFound}" == "0") {
			fail("No page elements were found on the page with the relative url ${url}. This could mean that the page element paths need to be updated or it could indicate a problem with the site page. Please investigate.");
		}
	}

}