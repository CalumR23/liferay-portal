definition {
	@prose = "I create a short link with the short url ${shortUrl} and original url ${originalUrl}"
	macro createShortLink {
		Type(
			locator1 = "OSBShortLinks#SHORT_URL_FIELD",
			value1 = "${shortUrl}");

		Type(
			locator1 = "OSBShortLinks#ORIGINAL_URL_FIELD",
			value1 = "${originalUrl}");

		Click(locator1 = "OSBShortLinks#ADD_URL_BUTTON");
	}

	@prose = "I tear down the short links with the folowing short url and original url values ${table}"
	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Content &amp; Data",
			panel = "Site Administration",
			portlet = "OSB Short Links");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var shortUrl = "${row[0]}";
			var originalUrl = "${row[1]}";

			Click(locator1 = "OSBShortLinks#ITEMS_PER_PAGE_LINK");

			var key_value = "60";

			Click(locator1 = "OSBShortLinks#VALUE_LINK");

			var key_shortUrl = "${shortUrl}";
			var key_originalUrl = "${originalUrl}";
			var notFound = "true";

			if (IsElementPresent.pauseIsElementPresent(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS")) {
				ScrollWebElementIntoView(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS");

				Click(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS");

				ClickNoError(locator1 = "OSBShortLinks#DELETE_LINK");

				Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

				AssertElementPresent(locator1 = "Message#SUCCESS");
			}
			else {
				while ((IsElementNotPresent(locator1 = "OSBShortLinks#NEXT_LINK_DISABLED")) && ("${notFound}" == "true")) {
					Click.pauseMakeVisibleClickAt(locator1 = "OSBShortLinks#NEXT_LINK");

					if (IsElementPresent.pauseIsElementPresent(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS")) {
						ScrollWebElementIntoView(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS");

						Click(locator1 = "OSBShortLinks#SHORT_LINK_ACTIONS");

						ClickNoError(locator1 = "OSBShortLinks#DELETE_LINK");

						Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

						AssertElementPresent(locator1 = "Message#SUCCESS");

						var notFound = "false";
					}
					else {
						var notFound = "true";
					}
				}
			}

			if (IsElementNotPresent(locator1 = "OSBShortLinks#FIRST_LINK_DISABLED")) {
				Click(locator1 = "OSBShortLinks#FIRST_LINK");
			}
		}
	}

	@prose = "I should be able to view a short link with the short url ${shortUrl} and original url ${originalUrl}"
	macro viewShortLink {
		var key_shortUrl = "${shortUrl}";
		var key_originalUrl = "${originalUrl}";

		AssertTextEquals(
			locator1 = "OSBShortLinks#SHORT_LINK_SHORT_URL",
			value1 = "${shortUrl}");

		AssertTextEquals(
			locator1 = "OSBShortLinks#SHORT_LINK_ORIGINAL_URL",
			value1 = "${originalUrl}");
	}
}