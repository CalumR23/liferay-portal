definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I request a demo with the following values ${table}"
	macro createRequestADemo {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Work Email") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD");

					Type(
						locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Country") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#COUNTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#COUNTRY_SELECT");

					Select(
						locator1 = "WWWRequestADemo#COUNTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#COUNTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "State/Territory") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#STATE_TERRITORY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#STATE_TERRITORY_SELECT");

					Select(
						locator1 = "WWWRequestADemo#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#STATE_TERRITORY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Whats your challenge?") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT");

					Select(
						locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "First Name") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#FIRST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#FIRST_NAME_FIELD");

					Type(
						locator1 = "WWWRequestADemo#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#FIRST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Last Name") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#LAST_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#LAST_NAME_FIELD");

					Type(
						locator1 = "WWWRequestADemo#LAST_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#LAST_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD");

					Type(
						locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Phone") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD");

					Type(
						locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Industry") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#INDUSTRY_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#INDUSTRY_SELECT");

					Select(
						locator1 = "WWWRequestADemo#INDUSTRY_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#INDUSTRY_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company Revenue") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#COMPANY_REVENUE")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#COMPANY_REVENUE");

					Select(
						locator1 = "WWWRequestADemo#COMPANY_REVENUE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#COMPANY_REVENUE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Department") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#DEPARTMENT_SELECT")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#DEPARTMENT_SELECT");

					Select(
						locator1 = "WWWRequestADemo#DEPARTMENT_SELECT",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#DEPARTMENT_SELECT",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Job Role") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#JOB_ROLE")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#JOB_ROLE");

					Select(
						locator1 = "WWWRequestADemo#JOB_ROLE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#JOB_ROLE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Company Size") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#COMPANY_SIZE")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#COMPANY_SIZE");

					Select(
						locator1 = "WWWRequestADemo#COMPANY_SIZE",
						value1 = "${value}");
				}
				else {
					Select(
						locator1 = "WWWRequestADemo#COMPANY_SIZE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Job Title") {
				if (IsElementNotPresent(locator1 = "WWWRequestADemo#JOB_TITLE")) {
					ScrollWebElementIntoView(locator1 = "WWWRequestADemo#JOB_TITLE");

					Type(
						locator1 = "WWWRequestADemo#JOB_TITLE",
						value1 = "${value}");
				}
				else {
					Type(
						locator1 = "WWWRequestADemo#JOB_TITLE",
						value1 = "${value}");
				}
			}
			else {
				fail("No such request field ${field}");
			}
		}

		AssertVisible(locator1 = "WWWRequestADemo#REQUEST_A_DEMO_BUTTON");

		Click(locator1 = "WWWRequestADemo#REQUEST_A_DEMO_BUTTON");
	}

	@prose = "I should be able to view a thanks message stating that they will contact soon and the demo was requested"
	macro viewMessageAfterRequestADemoViaForm {
		AssertElementPresent(locator1 = "WWWRequestADemo#THANKS_MESSAGE");
	}

	@prose = "I should be able to view the Request a Demo page and form"
	macro viewRequestADemoPageAndForm {
		AssertVisible(locator1 = "WWWRequestADemo#REQUEST_A_DEMO_HEADER");

		AssertVisible(locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD");

		AssertVisible(locator1 = "WWWRequestADemo#COUNTRY_SELECT");

		AssertVisible(locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT");

		AssertVisible(locator1 = "WWWRequestADemo#FIRST_NAME_FIELD");

		AssertVisible(locator1 = "WWWRequestADemo#LAST_NAME_FIELD");

		AssertVisible(locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD");

		AssertVisible(locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD");

		AssertElementPresent(locator1 = "WWWRequestADemo#INDUSTRY_SELECT");

		AssertElementPresent(locator1 = "WWWRequestADemo#COMPANY_REVENUE");

		AssertElementPresent(locator1 = "WWWRequestADemo#DEPARTMENT_SELECT");

		AssertElementPresent(locator1 = "WWWRequestADemo#JOB_ROLE");

		AssertElementPresent(locator1 = "WWWRequestADemo#COMPANY_SIZE");

		AssertElementPresent(locator1 = "WWWRequestADemo#JOB_TITLE");

		AssertVisible(locator1 = "WWWRequestADemo#REQUEST_A_DEMO_BUTTON");
	}

}