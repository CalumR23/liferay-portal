definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I should be able to view the Request a Demo page and form"
	macro viewRequestADemoPageAndForm {
		AssertVisible(locator1 = "WWWRequestADemo#REQUEST_A_DEMO_HEADER");

		AssertVisible(locator1 = "WWWRequestADemo#WORK_EMAIL_FIELD");
		AssertVisible(locator1 = "WWWRequestADemo#COUNTRY_SELECT");
		AssertVisible(locator1 = "WWWRequestADemo#WHATS_YOUR_CHALLENGE_SELECT");
		AssertVisible(locator1 = "WWWRequestADemo#FIRST_NAME_FIELD");
		AssertVisible(locator1 = "WWWRequestADemo#LAST_NAME_FIELD");
		AssertVisible(locator1 = "WWWRequestADemo#COMPANY_NAME_FIELD");
		AssertVisible(locator1 = "WWWRequestADemo#PHONE_NUMBER_FIELD");
		
		AssertElementPresent(locator1 = "WWWRequestADemo#INDUSTRY_SELECT");
		AssertElementPresent(locator1 = "WWWRequestADemo#COMPANY_REVENUE");
		AssertElementPresent(locator1 = "WWWRequestADemo#DEPARTMENT_SELECT");
		AssertElementPresent(locator1 = "WWWRequestADemo#JOB_ROLE");
		AssertElementPresent(locator1 = "WWWRequestADemo#COMPANY_SIZE");
		AssertElementPresent(locator1 = "WWWRequestADemo#JOB_TITLE");
		
		AssertVisible(locator1 = "WWWRequestADemo#SUBMIT_BUTTON");
	}
}