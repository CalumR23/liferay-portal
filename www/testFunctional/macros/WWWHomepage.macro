			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the ${linkName} link under the ${categoryName} category on the Sign In tab dropdown"
	macro clickSignInCategoryLinkOnAccountTabDropdown {
		var currentUrl = WWWHomepage.getURL();

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CATEGORY_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CATEGORY_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the account sign in link on the Sign In tab dropdown"
	macro clickSignInLink {
		var currentUrl = WWWHomepage.getURL();

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#ACCOUNT_SIGN_IN_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#ACCOUNT_SIGN_IN_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the ${linkName} link on the top info navigation"
	macro clickTopInfoNavigationLink {
		var key_linkName = "${linkName}";

		Click(locator1 = "WWWHomepage#TOP_INFO_NAVIGATION_LINK_NAME");
	}

	@prose = "I close the pop up window"
	macro closePopUpWindow {
		Close.closeWindow();

		SelectWindow(locator1 = "null");
	}

	@prose = "I close the window titled ${windowTitle}"
	macro closeWindow {
		Close.closeWindow(locator1 = "title=${windowTitle}");

		SelectWindow(locator1 = "null");
	}

	macro getURL {
		WaitForSPARefresh();

		if (IsElementPresent(locator1 = "//meta[@property='og:url'][1]")) {
			var url = selenium.getAttribute("//meta[@property='og:url'][1]@content");
		}
		else if (IsElementPresent(locator1 = "//link[@rel='canonical']")) {
			var url = selenium.getAttribute("//link[@rel='canonical']@href");
		}
		else {
			var url = selenium.getAttribute("//link[contains(@href,'http')][1]@href");
		}

		return "${url}";
	}

	@prose = "I go to the www homepage"
	macro gotoHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if ("${currentUrl}" != "https://www-uat.liferay.com") {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}

		WWWHomepage.acceptAllCookies();
	}

	@prose = "I go to the www page with the relative url ${url}"
	macro gotoRelativeURL {
		Open(locator1 = "${wwwURL}/${url}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if ("${currentUrl}" != "https://www-uat.liferay.com/${url}") {
			Open(locator1 = "${wwwURL}/${url}");

			WaitForSPARefresh();
		}
	}

	@prose = "I go to the translated www homepage"
	macro gotoTranslatedHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "/home"))) {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}
	}

	@prose = "I mouse over the ${tabName} tab"
	macro mouseOverTab {
		var key_tabName = "${tabName}";

		MouseOver(locator1 = "WWWHomepage#TAB");
	}

	@prose = "I wait for ${timeInSeconds} seconds"
	macro pause {
		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I wait for ${timeInMinutes} minutes"
	macro pauseInMinutes {
		var timeInSeconds = ${timeInMinutes} * 60;

		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	macro populateAndSubmitForm {
		var key_inputPositionValue = "1";
		var key_selectPositionValue = "1";

		WaitForSPARefresh();

		Pause(locator1 = "5000");

		if (IsElementPresent(locator1 = "WWWHomepage#MARKETING_FORM")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD")) {
				var key_inputPositionValue = ${key_inputPositionValue} + 1;

				var nonExistentPathPositionValueInput = "${key_inputPositionValue}";
			}

			while (IsElementPresent(locator1 = "WWWHomepage#MARKETING_FORM_SELECT_FIELD")) {
				var key_selectPositionValue = ${key_selectPositionValue} + 1;

				var nonExistentPathPositionValueSelect = "${key_selectPositionValue}";
			}

			var key_inputPositionValue = "1";

			var key_selectPositionValue = "1";

			while ("${key_inputPositionValue}" != "${nonExistentPathPositionValueInput}") {
				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD");

				var inputFieldName = selenium.getAttribute("xpath=(//input[contains(@class,'mktoRequired')])[${key_inputPositionValue}]@name");

				if ("${inputFieldName}" == "Email") {
					Type(
						locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD",
						value1 = "usr.liferay@lrcustomer.com.broken");
				}
				else if ("${inputFieldName}" == "Phone") {
					if (IsNotVisible(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD")) {
						ScrollWebElementIntoView(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD");

						Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD");
					}

					Type(
						locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD",
						value1 = "555-555-5678");
				}
				else {
					if (IsNotVisible(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD")) {
						ScrollWebElementIntoView(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD");

						Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD");
					}

					Type(
						locator1 = "WWWHomepage#MARKETING_FORM_INPUT_FIELD",
						value1 = "Test Form");
				}

				var key_inputPositionValue = ${key_inputPositionValue} + 1;
			}

			while ("${key_selectPositionValue}" != "${nonExistentPathPositionValueSelect}") {
				if (IsNotVisible(locator1 = "WWWHomepage#MARKETING_FORM_SELECT_FIELD")) {
					ScrollWebElementIntoView(locator1= "WWWHomepage#MARKETING_FORM_SELECT_FIELD");
				}

				var selectOptionValue = selenium.getText("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]/option[2]");

				var selectFieldName = selenium.getAttribute("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]@name");

				if ("${selectFieldName}" == "Country") {
					Select(
						locator1 = "WWWHomepage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "Australia");

					var key_selectPositionValue = ${key_selectPositionValue} + 1;

					var nonExistentPathPositionValueSelect = ${nonExistentPathPositionValueSelect} + 1;

					var selectOptionValue = selenium.getText("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]/option[2]");

					Select(
						locator1 = "WWWHomepage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "${selectOptionValue}");
				}
				else {
					Select(
						locator1 = "WWWHomepage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "${selectOptionValue}");
				}

				var key_selectPositionValue = ${key_selectPositionValue} + 1;
			}

			if (IsNotVisible(locator1 = "WWWHomepage#MARKETING_FORM_SUBMIT_BUTTON")) {
				ScrollWebElementIntoView(locator1 = "WWWHomepage#MARKETING_FORM_SUBMIT_BUTTON");
			}

			Click(locator1 = "WWWHomepage#MARKETING_FORM_SUBMIT_BUTTON");

			Pause(locator1 = "30000");

			WWWHomepage.viewNoErrors();

			WWWHomepage.gotoRelativeURL(url = "${url}");
		}
	}

	@prose = "I select the pop up window"
	macro selectPopUpWindow {
		SelectWindow.selectPopUp(locator1 = "null");
	}

	@prose = "I select the window titled ${windowTitle}"
	macro selectWindow {
		SelectWindow(locator1 = "title=${windowTitle}");
	}

	@prose = "I click the expand search icon on the top navigation and type in the keyword ${keyword} and click search"
	macro typeKeywordAndSearch {
		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BAR_EXPAND_BUTTON");

		Type(
			locator1 = "WWWHomepage#SEARCH_FIELD",
			value1 = "${keyword}");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BUTTON");
	}

	macro viewDropdownTab {
		var key_linkPositionValue = "1";
		var key_tabPositionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#TAB_DROPDOWN") && (IsElementPresent(locator1 = "WWWHomepage#DROPDOWN_LINK"))) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#TAB_DROPDOWN") && (maxIterations = "50")) {
				var key_tabPositionValue = ${key_tabPositionValue} + 1;

				var nonExistentPathPositionValueTab = "${key_tabPositionValue}";
			}

			while (IsElementPresent(locator1 = "WWWHomepage#DROPDOWN_LINK") && (maxIterations = "50")) {
				var key_linkPositionValue = ${key_linkPositionValue} + 1;

				var nonExistentPathPositionValueLink = "${key_linkPositionValue}";
			}

			var key_linkPositionValue = "1";

			var key_tabPositionValue = "1";

			while (("${key_tabPositionValue}" != "${nonExistentPathPositionValueTab}") && ("${key_linkPositionValue}" != "${nonExistentPathPositionValueLink}") && (maxIterations = "50")) {
				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWHomepage#TAB_DROPDOWN");

				Click(locator1 = "WWWHomepage#TAB_DROPDOWN");

				AssertElementPresent(locator1 = "WWWHomepage#DROPDOWN_LINK");

				if (IsVisible(locator1 = "WWWHomepage#DROPDOWN_LINK")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_LINK");

					WWWHomepage.viewNoErrors();

					WWWHomepage.gotoRelativeURL(url = "${url}");

					var key_linkPositionValue = ${key_linkPositionValue} + 1;
				}
				else {
					var key_tabPositionValue = ${key_tabPositionValue} + 1;
				}
			}
		}
	}

	macro viewFooterLanguageDropdown {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#FOOTER_LANGUAGE_DROPDOWN")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			ScrollBy(value1 = "0, 9999");

			AssertElementPresent(locator1 = "WWWHomepage#FOOTER_LANGUAGE_DROPDOWN");

			while (IsElementPresent(locator1 = "WWWHomepage#FOOTER_DROPDOWN_LANGUAGE_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {

				if ("${key_positionValue}" == "7") {
					var key_positionValue = ${key_positionValue} + 1;
				}

				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertElementPresent(locator1 = "WWWHomepage#FOOTER_LANGUAGE_DROPDOWN");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LANGUAGE_DROPDOWN");

				AssertElementPresent(locator1 = "WWWHomepage#FOOTER_DROPDOWN_LANGUAGE_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_DROPDOWN_LANGUAGE_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}

			var key_positionValue = "3";

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_LANGUAGE_LINK");
		}
	}

	macro viewFooterNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#FOOTER_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#FOOTER_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertElementPresent(locator1 = "WWWHomepage#FOOTER_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	@prose = "I should be able to view the page with the relative url ${url}"
    macro viewPage {
        static var pageElementsFound = "0";

        WWWHomepage.gotoRelativeURL(url = "${url}");

        if ("${url}" == "") {
            WWWHomepage.viewTopInfoNavigationLinks(url = "${url}");
        }

        if ("${url}" == "") {
            WWWHomepage.viewDropdownTab(url = "${url}");
        }

        WWWHomepage.viewPageImages();

        WWWHomepage.viewPageLinks(url = "${url}");

        WWWHomepage.populateAndSubmitForm(url = "${url}");

        if ("${url}" == "") {
            WWWHomepage.viewFooterNavigationLinks(url = "${url}");
        }

        if ("${url}" == "") {
            WWWHomepage.viewSocialMediaFooterNavigationLinks(url = "${url}");
        }

        WWWHomepage.viewTopLanguageDropdown(url = "${url}");

        WWWHomepage.viewFooterLanguageDropdown(url = "${url}");

		echo("Total page elements found: ${pageElementsFound}");

        if ("${pageElementsFound}" == "0") {
            fail("No page elements were found on the page with the relative url ${url}. This could mean that the page element paths need to be updated or it could indicate a problem with the site page. Please investigate.");
        }
    }

	macro viewPageImages {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#HOMEPAGE_IMAGE")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#HOMEPAGE_IMAGE", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				if (IsElementNotPresent(locator1 = "WWWHomepage#HOMEPAGE_IMAGE")) {
					ScrollWebElementIntoView(locator1 = "WWWHomepage#HOMEPAGE_IMAGE");

					AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_IMAGE");

					AssertVisible(locator1 = "WWWHomepage#HOMEPAGE_IMAGE");
				}
				else {
					AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_IMAGE");

					AssertVisible(locator1 = "WWWHomepage#HOMEPAGE_IMAGE");
				}

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	macro viewPageLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#HOMEPAGE_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#HOMEPAGE_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				WaitForSPARefresh();

				ScrollWebElementIntoView(locator1 = "WWWHomepage#HOMEPAGE_LINK");

				if (IsElementNotPresent(locator1 = "WWWHomepage#HOMEPAGE_LINK")) {
					ScrollBy(value1 = "0, 9999");

					AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_LINK");

					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#HOMEPAGE_LINK");

					WWWHomepage.viewNoErrors();

					WWWHomepage.gotoRelativeURL(url = "${url}");
				}

				AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#HOMEPAGE_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	@prose = "I should be able to view the illustration for the ${sectionText} section on the homepage"
	macro viewHomepageSectionIllustrations {
		var currentUrl = WWWHomepage.getURL();
		var key_sectionText = "${sectionText}";

		WaitForSPARefresh();

		ScrollWebElementIntoView(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");

		if (IsElementNotPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION")) {
			ScrollBy(value1 = "0, 9999");

			AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");
		}

		AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");
	}

	@prose = "there should be no errors on the page"
	macro viewNoErrors {
		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_BLOCK");

		AssertElementNotPresent(locator1 = "WWWHomepage#PAGE_DOES_NOT_EXIST_MESSAGE_1");

		AssertElementNotPresent(locator1 = "WWWHomepage#PAGE_DOES_NOT_EXIST_MESSAGE_2");

		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_1");

		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_2");
	}

	@prose = "the following text should not be visible on the page ${table}"
	macro viewNoText {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var text = "${row[0]}";

			AssertTextNotPresent(value1 = "${text}");
		}
	}

	@prose = "the current url content should not contain the text ${urlText}"
	macro viewNoURLContent {
		var currentUrl = WWWHomepage.getURL();

		if (contains("${currentUrl}", "${urlText}")) {
			fail("Actual URL ${currentUrl} does contain the text ${urlText}");
		}
	}

	macro viewSocialMediaFooterNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertVisible(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	@prose = "the following text should be visible on the page ${table}"
	macro viewText {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var text = "${row[0]}";

			AssertTextPresent(value1 = "${text}");
		}
	}

	macro viewTopInfoNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#TOP_INFO_NAVIGATION_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWHomepage#TOP_INFO_NAVIGATION_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				Click(locator1 = "WWWHomepage#TOP_INFO_NAVIGATION_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.viewURLContent(urlText = "https://www-uat.liferay.com");

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	macro viewTopLanguageDropdown {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			AssertElementPresent(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN");

			while (IsElementPresent(locator1 = "WWWHomepage#DROPDOWN_LANGUAGE_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				if ("${key_positionValue}" == "7") {
					var key_positionValue = ${key_positionValue} + 1;
				}

				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN");

				AssertElementPresent(locator1 = "WWWHomepage#DROPDOWN_LANGUAGE_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_LANGUAGE_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}

			var key_positionValue = "3";

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#LANGUAGE_DROPDOWN");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#DROPDOWN_LANGUAGE_LINK");
		}
	}

	@prose = "the current url content should contain the text ${urlText}"
	macro viewURLContent {
		var currentUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "${urlText}"))) {
			fail("Actual URL ${currentUrl} does not contain the text ${urlText}");
		}
	}

}