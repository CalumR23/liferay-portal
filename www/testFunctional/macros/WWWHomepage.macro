		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_NEW_WINDOW_LINK");
	}

	@prose = "I click on the Contact Sales button"
	macro clickContactSalesButton {
		var currentUrl = WWWHomepage.getURL();

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CONTACT_SALES_BUTTON");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "/contact-sales"))) {
			while (("${newUrl}" == "${currentUrl}")) {
				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CONTACT_SALES_BUTTON");

				WaitForSPARefresh();

				var newUrl = WWWHomepage.getURL();
			}
		}
	}

	@prose = "I click on the footer ${linkName} link under the ${categoryName} footer category"
	macro clickFooterCategoryLink {
		var currentUrl = WWWHomepage.getURL();
		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		if (IsElementPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON")) {
			WWWHomepage.pause(timeInSeconds = "2");

			if (IsElementPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON")) {
				Click(locator1 = "WWWHomepage#ERROR_MESSAGE_CLOSE_BUTTON");
			}
		}

		ScrollBy(value1 = "0, 9999");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_CATEGORY_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_CATEGORY_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the footer ${linkName} link"
	macro clickFooterLink {
		var currentUrl = WWWHomepage.getURL();
		var key_linkName = "${linkName}";

		if ("${linkName}" == "Contact Us") {
			ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_CONTACT_US_LINK");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_CONTACT_US_LINK");
		}
		else {
			ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_LINK_NAME");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LINK_NAME");
		}

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LINK_NAME");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the Sign In Create Account footer link"
	macro clickFooterSignInCreateAccountLink {
		var currentUrl = WWWHomepage.getURL();

		ScrollBy(value1 = "0, 9999");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CREATE_ACCOUNT_FOOTER_LINK");
	}

	@prose = "I click on the footer ${socialMedia} social media link"
	macro clickFooterSocialMediaLink {
		var key_socialMedia = StringUtil.lowerCase("${socialMedia}");

		ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK_NAME");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK_NAME");
	}

	@prose = "I click on the ${linkName} link under the ${sectionText} section on the homepage"
	macro clickHomepageLinks {
		var currentUrl = WWWHomepage.getURL();
		var key_sectionText = "${sectionText}";
		var key_linkName = "${linkName}";

		WaitForSPARefresh();

		ScrollWebElementIntoView(locator1 = "WWWHomepage#HOMEPAGE_SECTION_LINK");

		if (IsElementNotPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_LINK")) {
			ScrollBy(value1 = "0, 9999");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#HOMEPAGE_SECTION_LINK");
		}

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#HOMEPAGE_SECTION_LINK");
	}

	@prose = "I click on the ${featuresLink} link under the ${productName} product link on the Product dropdown"
	macro clickProductFeaturesLink {
		var currentUrl = WWWHomepage.getURL();

		WWWHomepage.mouseOverTab(tabName = "Products");

		var key_featuresLink = "${featuresLink}";
		var key_productName = "${productName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_FEATURES_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "/products/dxp-cloud") && ("${productName}" == "DXP Cloud") && ("${featuresLink}" == "Key Features"))) {
			while (("${newUrl}" == "${currentUrl}")) {
				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_FEATURES_LINK");

				WaitForSPARefresh();

				var newUrl = WWWHomepage.getURL();
			}
		}
	}

	@prose = "I click on the ${productName} product link on the Platform dropdown"
	macro clickProductLink {
		var currentUrl = WWWHomepage.getURL();

		Click(locator1 = "WWWHomepage#PLATFORM_DROPDOWN");

		var key_productName = "${productName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the Request a Live Demo button"
	macro clickRequestALiveDemoButton {
		var currentUrl = WWWHomepage.getURL();

		ScrollBy(value1 = "0, 9999");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#REQUEST_A_LIVE_DEMO_BUTTON");

		WaitForSPARefresh();

