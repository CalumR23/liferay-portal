definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I change the language of the site to ${language}"
	macro changeLanguage {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");

		if ("${language}" == "Chinese") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_CHINESE_LANGUAGE_LINK");	

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/zh"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_CHINESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}		
		}
		else if ("${language}" == "Australian English") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_AUSTRALIA_ENGLISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/en-AU"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_AUSTRALIA_ENGLISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else if ("${language}" == "American English") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_UNITED_STATES_ENGLISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if ((!(contains("${currentUrl}", "/en"))) || (contains("${currentUrl}", "/en-AU"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_UNITED_STATES_ENGLISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}	
		}
		else if ("${language}" == "French") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_FRENCH_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/fr"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_FRENCH_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}	
		}
		else if ("${language}" == "German") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_GERMAN_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/de"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_GERMAN_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else if ("${language}" == "Italian") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_ITALIAN_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/it"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_ITALIAN_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else if ("${language}" == "Japanese") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_JAPANESE_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "co.jp"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_JAPANESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else if ("${language}" == "Portuguese") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_PORTUGUESE_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/pt"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_PORTUGUESE_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else if ("${language}" == "Spanish") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_SPANISH_LANGUAGE_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

			if (!(contains("${currentUrl}", "/es"))) {
				while ("${newUrl}" == "${currentUrl}") {
					Click(locator1 = "WWWHomepage#ACCOUNT_SELECT_LANGUAGE_LINK");
					Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN_SPANISH_LANGUAGE_LINK");

					WaitForSPARefresh();

					AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

					var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
				}
			}
		}
		else {
			fail("Invalid language ${language}. Please use one of the following languages or update the test if changes are necessary: Chinese, Australian English, American English, French, German, Italian, Japanese, Portuguese, Spanish");
		}
	}

	@prose = "I click on the ${buttonName} button under the ${categoryName} category on the ${tabName} tab dropdown"
	macro clickCategoryButton {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		WWWHomepage.mouseOverTab(tabName = "${tabName}");

		var key_buttonName = "${buttonName}";
		var key_categoryName = "${categoryName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_BUTTON");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_BUTTON");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I click on the ${linkName} link under the ${categoryName} category on the ${tabName} tab dropdown"
	macro clickCategoryLink {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		WWWHomepage.mouseOverTab(tabName = "${tabName}");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I click on the ${buttonName} new window button under the ${categoryName} category on the ${tabName} tab dropdown"
	macro clickCategoryNewWindowButton {
		WWWHomepage.mouseOverTab(tabName = "${tabName}");

		var key_buttonName = "${buttonName}";
		var key_categoryName = "${categoryName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_BUTTON");
	}

	@prose = "I click on the ${linkName} new window link under the ${categoryName} category on the ${tabName} tab dropdown"
	macro clickCategoryNewWindowLink {
		WWWHomepage.mouseOverTab(tabName = "${tabName}");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CATEGORY_NEW_WINDOW_LINK");
	}

	@prose = "I click on the Contact Sales button"
	macro clickContactSalesButton {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CONTACT_SALES_BUTTON");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!(contains("${currentUrl}", "/contact-sales"))) {
			while ("${newUrl}" == "${currentUrl}") {
				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#CONTACT_SALES_BUTTON");

				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

				var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
			}
		}
	}

	@prose = "I click on the footer ${linkName} link under the ${categoryName} footer category"
	macro clickFooterCategoryLink {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_CATEGORY_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_CATEGORY_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_CATEGORY_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I click on the footer ${linkName} link"
	macro clickFooterLink {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		var key_linkName = "${linkName}";

		ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I click on the footer ${socialMedia} social media link"
	macro clickFooterSocialMediaLink {
		var key_socialMedia = StringUtil.lowerCase("${socialMedia}");

		ScrollWebElementIntoView(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#FOOTER_SOCIAL_MEDIA_LINK");
	}

	@prose = "I click on the ${featuresLink} link under the ${productName} product link on the Product dropdown"
	macro clickProductFeaturesLink {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		WWWHomepage.mouseOverTab(tabName = "Products");

		var key_featuresLink = "${featuresLink}";
		var key_productName = "${productName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_FEATURES_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!((contains("${currentUrl}", "/products/dxp-cloud")) && ("${productName}" == "DXP Cloud") && ("${featuresLink}" == "Key Features"))) {
			while ("${newUrl}" == "${currentUrl}") {
				Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_FEATURES_LINK");

				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

				var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
			}	
		}
	}

	@prose = "I click on the ${productName} link on the Product dropdown"
	macro clickProductLink {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		WWWHomepage.mouseOverTab(tabName = "Products");

		var key_productName = "${productName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I click on the ${linkName} link under the ${categoryName} category on the Sign In tab dropdown"
	macro clickSignInCategoryLinkOnAccountTabDropdown {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CATEGORY_LINK");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		while ("${newUrl}" == "${currentUrl}") {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#PRODUCT_LINK");

			WaitForSPARefresh();

			AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

			var newUrl = selenium.getAttribute("//link[@rel='canonical']@href");
		}
	}

	@prose = "I close the window titled ${windowTitle}"
	macro closeWindow {
		Close.closeWindow(locator1 = "title=${windowTitle}");

		SelectWindow(locator1 = "null");
	}

	@prose = "I go to the www homepage"
	macro gotoHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!("${currentUrl}" == "https://www-uat.liferay.com/en")) {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}
	}

	@prose = "I go to the translated www homepage"
	macro gotoTranslatedHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!(contains("${currentUrl}", "/home"))) {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}
	}

	@prose = "I go to the www page with the url ${url}"
	macro gotoUrl {
		Open(locator1 = "${wwwURL}/${url}");

		WaitForSPARefresh();

		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!("${currentUrl}" == "https://www-uat.liferay.com/${url}")) {
			Open(locator1 = "${wwwURL}/${url}");

			WaitForSPARefresh();
		}
	}

	@prose = "I mouse over the ${tabName} tab"
	macro mouseOverTab{
		var key_tabName = "${tabName}";

		MouseOver(locator1 = "WWWHomepage#TAB");
	}

	@prose = "I select the window titled ${windowTitle}"
	macro selectWindow {
		SelectWindow(locator1 = "title=${windowTitle}");
	}

	@prose = "I click the expand search icon on the top navigation and type in the keyword ${keyword} and click search"
	macro typeKeywordAndSearch {
		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BAR_EXPAND_BUTTON");

		Type(
			locator1 = "WWWHomepage#SEARCH_FIELD",
			value1 = "${keyword}");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BUTTON");
	}

	@prose = "there should be no errors on the page"
	macro viewNoErrors {
		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_BLOCK");
		AssertElementNotPresent(locator1 = "WWWHomepage#PAGE_DOES_NOT_EXIST_MESSAGE");
		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_1");
		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_2");
	}

	@prose = "the current url content should contain the text ${urlText}"
	macro viewUrlContent {
		AssertElementPresent(locator1 = "WWWHomepage#CURRENT_PAGE_URL");

		var currentUrl = selenium.getAttribute("//link[@rel='canonical']@href");

		if (!(contains("${currentUrl}", "${urlText}"))) {
			fail("Actual URL ${currentUrl} does not contain the text ${urlText}");
		}
	}
}