			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the ${linkName} link under the ${categoryName} category on the Sign In tab dropdown"
	macro clickSignInCategoryLinkOnAccountTabDropdown {
		var currentUrl = WWWHomepage.getURL();

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		var key_categoryName = "${categoryName}";
		var key_linkName = "${linkName}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CATEGORY_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SIGN_IN_CATEGORY_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the account sign in link on the Sign In tab dropdown"
	macro clickSignInLink {
		var currentUrl = WWWHomepage.getURL();

		Click(locator1 = "WWWHomepage#SIGN_IN_DROPDOWN");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#ACCOUNT_SIGN_IN_LINK");

		WaitForSPARefresh();

		var newUrl = WWWHomepage.getURL();

		while (("${newUrl}" == "${currentUrl}")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#ACCOUNT_SIGN_IN_LINK");

			WaitForSPARefresh();

			var newUrl = WWWHomepage.getURL();
		}
	}

	@prose = "I click on the ${linkName} link on the top info navigation"
	macro clickTopInfoNavigationLink {
		var key_linkName = "${linkName}";

		Click(locator1 = "WWWHomepage#TOP_INFO_NAVIGATION_LINK_NAME");
	}

	@prose = "I close the pop up window"
	macro closePopUpWindow {
		Close.closeWindow();

		SelectWindow(locator1 = "null");
	}

	@prose = "I close the window titled ${windowTitle}"
	macro closeWindow {
		Close.closeWindow(locator1 = "title=${windowTitle}");

		SelectWindow(locator1 = "null");
	}

	macro getURL {
		WaitForSPARefresh();

		if (IsElementPresent(locator1 = "//meta[@property='og:url'][1]")) {
			var url = selenium.getAttribute("//meta[@property='og:url'][1]@content");
		}
		else if (IsElementPresent(locator1 = "//link[@rel='canonical']")) {
			var url = selenium.getAttribute("//link[@rel='canonical']@href");
		}
		else {
			var url = selenium.getAttribute("//link[contains(@href,'http')][1]@href");
		}

		return "${url}";
	}

	@prose = "I go to the www homepage"
	macro gotoHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if ("${currentUrl}" != "https://www-uat.liferay.com") {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}

		WWWHomepage.acceptAllCookies();
	}

	@prose = "I go to the www page with the relative url ${url}"
	macro gotoRelativeURL {
		Open(locator1 = "${wwwURL}/${url}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if ("${currentUrl}" != "https://www-uat.liferay.com/${url}") {
			Open(locator1 = "${wwwURL}/${url}");

			WaitForSPARefresh();
		}
	}

	@prose = "I go to the translated www homepage"
	macro gotoTranslatedHomePage {
		Open(locator1 = "${wwwURL}");

		WaitForSPARefresh();

		var currentUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "/home"))) {
			Open(locator1 = "${wwwURL}");

			WaitForSPARefresh();
		}
	}

	@prose = "I mouse over the ${tabName} tab"
	macro mouseOverTab {
		var key_tabName = "${tabName}";

		MouseOver(locator1 = "WWWHomepage#TAB");
	}

	@prose = "I wait for ${timeInSeconds} seconds"
	macro pause {
		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I wait for ${timeInMinutes} minutes"
	macro pauseInMinutes {
		var timeInSeconds = ${timeInMinutes} * 60;

		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I select the pop up window"
	macro selectPopUpWindow {
		SelectWindow.selectPopUp(locator1 = "null");
	}

	@prose = "I select the window titled ${windowTitle}"
	macro selectWindow {
		SelectWindow(locator1 = "title=${windowTitle}");
	}

	@prose = "I click the expand search icon on the top navigation and type in the keyword ${keyword} and click search"
	macro typeKeywordAndSearch {
		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BAR_EXPAND_BUTTON");

		Type(
			locator1 = "WWWHomepage#SEARCH_FIELD",
			value1 = "${keyword}");

		Click.pauseMakeVisibleClickAt(locator1 = "WWWHomepage#SEARCH_BUTTON");
	}

	@prose = "I should be able to view the illustration for the ${sectionText} section on the homepage"
	macro viewHomepageSectionIllustrations {
		var currentUrl = WWWHomepage.getURL();
		var key_sectionText = "${sectionText}";

		WaitForSPARefresh();

		ScrollWebElementIntoView(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");

		if (IsElementNotPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION")) {
			ScrollBy(value1 = "0, 9999");

			AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");
		}

		AssertElementPresent(locator1 = "WWWHomepage#HOMEPAGE_SECTION_ILLUSTRATION");
	}

	@prose = "there should be no errors on the page"
	macro viewNoErrors {
		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_BLOCK");

		AssertElementNotPresent(locator1 = "WWWHomepage#PAGE_DOES_NOT_EXIST_MESSAGE_1");

		AssertElementNotPresent(locator1 = "WWWHomepage#PAGE_DOES_NOT_EXIST_MESSAGE_2");

		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_1");

		AssertElementNotPresent(locator1 = "WWWHomepage#ERROR_MESSAGE_2");
	}

	@prose = "the following text should not be visible on the page ${table}"
	macro viewNoText {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var text = "${row[0]}";

			AssertTextNotPresent(value1 = "${text}");
		}
	}

	@prose = "the current url content should not contain the text ${urlText}"
	macro viewNoURLContent {
		var currentUrl = WWWHomepage.getURL();

		if (contains("${currentUrl}", "${urlText}")) {
			fail("Actual URL ${currentUrl} does contain the text ${urlText}");
		}
	}

	@prose = "the following text should be visible on the page ${table}"
	macro viewText {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var text = "${row[0]}";

			AssertTextPresent(value1 = "${text}");
		}
	}

	@prose = "the current url content should contain the text ${urlText}"
	macro viewURLContent {
		var currentUrl = WWWHomepage.getURL();

		if (!(contains("${currentUrl}", "${urlText}"))) {
			fail("Actual URL ${currentUrl} does not contain the text ${urlText}");
		}
	}

}