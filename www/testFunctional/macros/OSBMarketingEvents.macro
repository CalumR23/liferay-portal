definition {
	@prose = "I click the add event button"
	macro clickAddEventButton {
		Click(locator1 = "OSBMarketingEvents#ADD_EVENT_BUTTON");

		WaitForSPARefresh();
	}

	@prose = "I click the marketing events save button"
	macro clickSave {
		Click(locator1 = "OSBMarketingEventsCreate#SAVE_BUTTON");

		WaitForSPARefresh();
	}

	@prose = "I populate the following marketing events fields and values ${table}"
	macro populateMarketingEventFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Type") {
				Select(
					locator1 = "OSBMarketingEventsCreate#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Title") {
				Type(
					locator1 = "OSBMarketingEventsCreate#TITLE_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Body") {
				Type.typeCKEditorWaitForCKEditor(
					locator1 = "OSBMarketingEventsCreate#BODY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Title URL") {
				Type(
					locator1 = "OSBMarketingEventsCreate#TITLE_URL_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Hosted By") {
				Type(
					locator1 = "OSBMarketingEventsCreate#HOSTED_BY_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Hosted By URL") {
				Type(
					locator1 = "OSBMarketingEventsCreate#HOSTED_BY_URL_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Image") {
				OSBMarketingEvents.uploadImage(value = "${value}");
			}
			else if ("${field}" == "Time Zone") {
				Select(
					locator1 = "OSBMarketingEventsCreate#TIME_ZONE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				Type(
					locator1 = "OSBMarketingEventsCreate#START_DATE_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Time") {
				Type(
					locator1 = "OSBMarketingEventsCreate#START_TIME_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "End Date") {
				Type(
					locator1 = "OSBMarketingEventsCreate#END_DATE_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "End Time") {
				Type(
					locator1 = "OSBMarketingEventsCreate#END_TIME_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Date To Be Announced") {
				if ("${value}" == "true") {
					Check(locator1 = "OSBMarketingEventsCreate#DATE_TO_BE_ANNOUNCED_CHECKBOX");		
				}
				else {
					Uncheck(locator1 = "OSBMarketingEventsCreate#DATE_TO_BE_ANNOUNCED_CHECKBOX");							
				}
			}
			else if ("${field}" == "Street 1") {
				Type(
					locator1 = "OSBMarketingEventsCreate#STREET_1_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Street 2") {
				Type(
					locator1 = "OSBMarketingEventsCreate#STREET_2_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Street 3") {
				Type(
					locator1 = "OSBMarketingEventsCreate#STREET_3_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "City") {
				Type(
					locator1 = "OSBMarketingEventsCreate#CITY_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Zip") {
				Type(
					locator1 = "OSBMarketingEventsCreate#ZIP_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				Select(
					locator1 = "OSBMarketingEventsCreate#COUNTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				Select(
					locator1 = "OSBMarketingEventsCreate#REGION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Global Region") {
				Select(
					locator1 = "OSBMarketingEventsCreate#GLOBAL_REGION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Latitude") {
				Type(
					locator1 = "OSBMarketingEventsCreate#LATITUDE_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Longitude") {
				Type(
					locator1 = "OSBMarketingEventsCreate#LONGITUDE_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Online") {
				if ("${value}" == "true") {
					Check(locator1 = "OSBMarketingEventsCreate#ONLINE_CHECKBOX");		
				}
				else {
					Uncheck(locator1 = "OSBMarketingEventsCreate#ONLINE_CHECKBOX");							
				}
			}
			else if ("${field}" == "Registration Type") {
				Select(
					locator1 = "OSBMarketingEventsCreate#REGISTRATION_TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Registration URL") {
				Type(
					locator1 = "OSBMarketingEventsCreate#REGISTRATION_URL_INPUT",
					value1 = "${value}");
			}
			else if ("${field}" == "Extra Settings") {
				Type(
					locator1 = "OSBMarketingEventsCreate#EXTRA_SETTINGS_TEXTAREA",
					value1 = "${value}");
			}
			else if ("${field}" == "Marketing Event Campaign") {
				OSBMarketingEvents.selectMarketingEventCampaignCategory(value = "${value}");
			}
			else if ("${field}" == "Topic") {
				OSBMarketingEvents.selectTopicCategory(value = "${value}");
			}
			else {
				fail("Invalid field ${field}.");
			}
		}
	}

	macro selectMarketingEventCampaignCategory {
		Click(locator1 = "OSBMarketingEventsCreate#MARKETING_EVENT_CAMPAIGN_CATEGORY_SELECT_BUTTON");

		SelectFrame(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				ScrollWebElementIntoView(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

				Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

				WaitForSPARefresh();
			}
		}
		else {
			var key_entryTitle = "${value}";

			ScrollWebElementIntoView(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			WaitForSPARefresh();
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON")) {
			SelectFrame(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_IFRAME");

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			if (IsElementPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY_SELECTED")) {
				Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY_OTHER");
			}

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");
		}

		AssertElementNotPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "OSBMarketingEventsCreate#MARKETING_EVENT_CAMPAIGN_CATEGORY_ITEM_OTHER_CLOSE_BUTTON")) {
			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#MARKETING_EVENT_CAMPAIGN_CATEGORY_ITEM_OTHER_CLOSE_BUTTON");
		}
	}

	macro selectTopicCategory {
		Click(locator1 = "OSBMarketingEventsCreate#TOPIC_CATEGORY_SELECT_BUTTON");

		SelectFrame(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				ScrollWebElementIntoView(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

				Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

				WaitForSPARefresh();
			}
		}
		else {
			var key_entryTitle = "${value}";

			ScrollWebElementIntoView(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			WaitForSPARefresh();
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON")) {
			SelectFrame(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_IFRAME");

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			if (IsElementPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY_SELECTED")) {
				Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY_OTHER");
			}

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_ENTRY");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");
		}

		AssertElementNotPresent(locator1 = "OSBMarketingEventsCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "OSBMarketingEventsCreate#TOPIC_CATEGORY_ITEM_OTHER_CLOSE_BUTTON")) {
			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#TOPIC_CATEGORY_ITEM_OTHER_CLOSE_BUTTON");
		}
	}

	@prose = "I tear down the following marketing events ${table}"
	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Content &amp; Data",
			panel = "Site Administration",
			portlet = "OSB Marketing Events Admin");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var title = "${row[0]}";

			Type(
				locator1 = "OSBMarketingEvents#SEARCH_FIELD",
				value1 = "&quot;${title}&quot;");

			KeyPress(
				locator1 = "OSBMarketingEvents#SEARCH_FIELD",
				value1 = "\RETURN");

			var key_title = "${title}";

			if (IsElementPresent.pauseIsElementPresent(locator1 = "OSBMarketingEvents#MARKETING_EVENT_ACTIONS")) {
				Click(locator1 = "OSBMarketingEvents#MARKETING_EVENT_ACTIONS");

				ClickNoError(locator1 = "OSBMarketingEvents#DELETE_LINK");

				Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

				AssertElementPresent(locator1 = "Message#SUCCESS");
			}
		}
	}

	macro uploadImage {
		Click(locator1 = "OSBMarketingEventsCreate#IMAGE_SELECT_BUTTON");

		SelectFrame(locator1 = "OSBMarketingEventsCreate#SELECT_FILE_IFRAME");

		for (var individualValue : list "${value}") {
			var key_entryTitle = "${individualValue}";

			AssertElementPresent(locator1 = "OSBMarketingEventsCreate#SELECT_FILE_ENTRY_LIST_THUMBNAIL");

			ScrollWebElementIntoView(locator1 = "OSBMarketingEventsCreate#SELECT_FILE_ENTRY_LIST_THUMBNAIL");

			Click.pauseMakeVisibleClickAt(locator1 = "OSBMarketingEventsCreate#SELECT_FILE_ENTRY_LIST_THUMBNAIL");

			WaitForSPARefresh();
		}

		SelectFrameTop();
	}

	@prose = "I should be able to view the marketing event with the title ${title} and the following values ${table}"
	macro viewEvent {
		var key_title = "${title}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "OSBMarketingEvents#MARKETING_EVENT_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Title") {
				AssertTextEquals(
					locator1 = "OSBMarketingEvents#MARKETING_EVENT_TITLE",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				AssertTextEquals(
					locator1 = "OSBMarketingEvents#MARKETING_EVENT_START_DATE",
					value1 = "${value}");
			}
			else if ("${field}" == "Global Region") {
				AssertTextEquals(
					locator1 = "OSBMarketingEvents#MARKETING_EVENT_GLOBAL_REGION",
					value1 = "${value}");
			}
			else {
				fail("Invalid field ${field}.");
			}
		}
	}
}