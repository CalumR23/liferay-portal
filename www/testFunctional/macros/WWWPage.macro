definition {

	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

    macro viewDropdownTab {
		var key_linkPositionValue = "1";
		var key_tabPositionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#TAB_DROPDOWN") && (IsElementPresent(locator1 = "WWWPage#DROPDOWN_LINK"))) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#TAB_DROPDOWN") && (maxIterations = "50")) {
				var key_tabPositionValue = ${key_tabPositionValue} + 1;

				var nonExistentPathPositionValueTab = "${key_tabPositionValue}";
			}

			while (IsElementPresent(locator1 = "WWWPage#DROPDOWN_LINK") && (maxIterations = "50")) {
				var key_linkPositionValue = ${key_linkPositionValue} + 1;

				var nonExistentPathPositionValueLink = "${key_linkPositionValue}";
			}

			var key_linkPositionValue = "1";

			var key_tabPositionValue = "1";

			while (("${key_tabPositionValue}" != "${nonExistentPathPositionValueTab}") && ("${key_linkPositionValue}" != "${nonExistentPathPositionValueLink}") && (maxIterations = "50")) {
				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWPage#TAB_DROPDOWN");

				Click(locator1 = "WWWPage#TAB_DROPDOWN");

				AssertElementPresent(locator1 = "WWWPage#DROPDOWN_LINK");

				if (IsVisible(locator1 = "WWWPage#DROPDOWN_LINK")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#DROPDOWN_LINK");

					WWWHomepage.viewNoErrors();

					WWWHomepage.gotoRelativeURL(url = "${url}");

					var key_linkPositionValue = ${key_linkPositionValue} + 1;
				}
				else {
					var key_tabPositionValue = ${key_tabPositionValue} + 1;
				}
			}
		}
	}

    macro viewFooterLanguageDropdown {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#FOOTER_LANGUAGE_DROPDOWN")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			ScrollBy(value1 = "0, 9999");

			AssertElementPresent(locator1 = "WWWPage#FOOTER_LANGUAGE_DROPDOWN");

			while (IsElementPresent(locator1 = "WWWPage#FOOTER_DROPDOWN_LANGUAGE_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {

				if ("${key_positionValue}" == "7") {
					var key_positionValue = ${key_positionValue} + 1;
				}

				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertElementPresent(locator1 = "WWWPage#FOOTER_LANGUAGE_DROPDOWN");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#FOOTER_LANGUAGE_DROPDOWN");

				AssertElementPresent(locator1 = "WWWPage#FOOTER_DROPDOWN_LANGUAGE_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#FOOTER_DROPDOWN_LANGUAGE_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}

			var key_positionValue = "3";

			Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#LANGUAGE_DROPDOWN");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#DROPDOWN_LANGUAGE_LINK");
		}
	}

    macro viewFooterNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#FOOTER_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#FOOTER_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertElementPresent(locator1 = "WWWPage#FOOTER_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#FOOTER_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

    @prose = "I should be able to view the page with the relative url ${url}"
	macro viewPage {
		static var pageElementsFound = "0";

		WWWHomepage.gotoRelativeURL(url = "${url}");

		if ("${url}" == "") {
			WWWPage.viewTopInfoNavigationLinks(url = "${url}");
		}

		if ("${url}" == "") {
			WWWPage.viewDropdownTab(url = "${url}");
		}

		WWWPage.viewPageImages();

		WWWPage.viewPageLinks(url = "${url}");

		WWWPage.populateAndSubmitForm(url = "${url}");

		if ("${url}" == "") {
			WWWPage.viewFooterNavigationLinks(url = "${url}");
		}

		if ("${url}" == "") {
			WWWPage.viewSocialMediaFooterNavigationLinks(url = "${url}");
		}

		WWWPage.viewTopLanguageDropdown(url = "${url}");

		WWWPage.viewFooterLanguageDropdown(url = "${url}");

		echo("Total page elements found: ${pageElementsFound}");

		if ("${pageElementsFound}" == "0") {
			fail("No page elements were found on the page with the relative url ${url}. This could mean that the page element paths need to be updated or it could indicate a problem with the site page. Please investigate.");
		}
	}

    macro viewPageImages {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#PAGE_IMAGE")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#PAGE_IMAGE", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				if (IsElementNotPresent(locator1 = "WWWPage#PAGE_IMAGE")) {
					ScrollWebElementIntoView(locator1 = "WWWPage#PAGE_IMAGE");

					AssertElementPresent(locator1 = "WWWPage#PAGE_IMAGE");

					AssertVisible(locator1 = "WWWPage#PAGE_IMAGE");
				}
				else {
					AssertElementPresent(locator1 = "WWWPage#PAGE_IMAGE");

					AssertVisible(locator1 = "WWWPage#PAGE_IMAGE");
				}

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

	macro viewPageLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#PAGE_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#PAGE_LINK", value1 = "") && (maxIterations = "50")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}" && (maxIterations = "50")) {
				WaitForSPARefresh();

				ScrollWebElementIntoView(locator1 = "WWWPage#PAGE_LINK");

				if(IsVisible(locator1 = "WWWPage#PAGE_LINK")) {
					Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#PAGE_LINK");
				}

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");
				
				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

    macro viewSocialMediaFooterNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#FOOTER_SOCIAL_MEDIA_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#FOOTER_SOCIAL_MEDIA_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				WaitForSPARefresh();

				ScrollBy(value1 = "0, 9999");

				AssertVisible(locator1 = "WWWPage#FOOTER_SOCIAL_MEDIA_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#FOOTER_SOCIAL_MEDIA_LINK");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

    macro viewTopInfoNavigationLinks {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#TOP_INFO_NAVIGATION_LINK")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#TOP_INFO_NAVIGATION_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				Click(locator1 = "WWWPage#TOP_INFO_NAVIGATION_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.viewURLContent(urlText = "https://www-uat.liferay.com");

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}
	}

    macro viewTopLanguageDropdown {
		var key_positionValue = "1";

		if (IsElementPresent(locator1 = "WWWPage#LANGUAGE_DROPDOWN")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			AssertElementPresent(locator1 = "WWWPage#LANGUAGE_DROPDOWN");

			while (IsElementPresent(locator1 = "WWWPage#DROPDOWN_LANGUAGE_LINK", value1 = "")) {
				var key_positionValue = ${key_positionValue} + 1;

				var nonExistentPathPositionValue = "${key_positionValue}";
			}

			var key_positionValue = "1";

			while ("${key_positionValue}" != "${nonExistentPathPositionValue}") {
				if ("${key_positionValue}" == "7") {
					var key_positionValue = ${key_positionValue} + 1;
				}

				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWPage#LANGUAGE_DROPDOWN");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#LANGUAGE_DROPDOWN");

				AssertElementPresent(locator1 = "WWWPage#DROPDOWN_LANGUAGE_LINK");

				Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#DROPDOWN_LANGUAGE_LINK");

				WWWHomepage.viewNoErrors();

				WWWHomepage.gotoRelativeURL(url = "${url}");

				var key_positionValue = ${key_positionValue} + 1;
			}

			var key_positionValue = "3";

			Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#LANGUAGE_DROPDOWN");

			Click.pauseMakeVisibleClickAt(locator1 = "WWWPage#DROPDOWN_LANGUAGE_LINK");
		}
	}

    macro populateAndSubmitForm {
		var key_inputPositionValue = "1";
		var key_textAreaPositionValue = "1";
		var key_selectPositionValue = "1";

		WaitForSPARefresh();

		Pause(locator1 = "5000");

		if (IsElementPresent(locator1 = "WWWPage#MARKETING_FORM")) {

			var pageElementsFound = ${pageElementsFound} + 1;

			while (IsElementPresent(locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD")) {
				var key_inputPositionValue = ${key_inputPositionValue} + 1;

				var nonExistentPathPositionValueInput = "${key_inputPositionValue}";
			}

			while (IsElementPresent(locator1 = "WWWPage#MARKETING_FORM_TEXT_AREA")) {
				var key_textAreaPositionValue = ${key_textAreaPositionValue} + 1;

				var nonExistentPathPositionValueTextArea = "${key_textAreaPositionValue}";
			}

			while (IsElementPresent(locator1 = "WWWPage#MARKETING_FORM_SELECT_FIELD")) {
				var key_selectPositionValue = ${key_selectPositionValue} + 1;

				var nonExistentPathPositionValueSelect = "${key_selectPositionValue}";
			}

			var key_inputPositionValue = "1";

			var key_textAreaPositionValue = "1";

			var key_selectPositionValue = "1";

			while ("${key_inputPositionValue}" != "${nonExistentPathPositionValueInput}") {
				WaitForSPARefresh();

				AssertElementPresent(locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD");

				var inputFieldName = selenium.getAttribute("xpath=(//input[contains(@class,'mktoRequired')])[${key_inputPositionValue}]@name");

				if ("${inputFieldName}" == "Email") {
					Type(
						locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD",
						value1 = "usr.liferay@lrcustomer.com.broken");
				}
				else if ("${inputFieldName}" == "Phone") {
					ScrollWebElementIntoView(locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD");

					Type(
						locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD",
						value1 = "555-555-5678");
				}
				else {
					ScrollWebElementIntoView(locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD");

					Type(
						locator1 = "WWWPage#MARKETING_FORM_INPUT_FIELD",
						value1 = "Test Form");
				}

				var key_inputPositionValue = ${key_inputPositionValue} + 1;
			}
			if (IsElementPresent(locator1 = "WWWPage#MARKETING_FORM_TEXT_AREA")) {
				while ("${key_textAreaPositionValue}" != "${nonExistentPathPositionValueTextArea}") {
					AssertElementPresent(locator1 = "WWWPage#MARKETING_FORM_TEXT_AREA");

					ScrollWebElementIntoView(locator1 = "WWWPage#MARKETING_FORM_TEXT_AREA");

					Type(
						locator1 = "WWWPage#MARKETING_FORM_TEXT_AREA",
						value1 = "Test Form");

					var key_textAreaPositionValue = ${key_textAreaPositionValue} + 1;      
				}
			}

			while ("${key_selectPositionValue}" != "${nonExistentPathPositionValueSelect}") {
				ScrollWebElementIntoView(locator1= "WWWPage#MARKETING_FORM_SELECT_FIELD");

				var selectOptionValue = selenium.getText("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]/option[2]");

				var selectFieldName = selenium.getAttribute("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]@name");

				if ("${selectFieldName}" == "Country") {
					Select(
						locator1 = "WWWPage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "Australia");

					var key_selectPositionValue = ${key_selectPositionValue} + 1;

					var nonExistentPathPositionValueSelect = ${nonExistentPathPositionValueSelect} + 1;

					var selectOptionValue = selenium.getText("xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]/option[2]");

					Select(
						locator1 = "WWWPage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "${selectOptionValue}");
				}
				else {
					Select(
						locator1 = "WWWPage#MARKETING_FORM_SELECT_FIELD", 
						value1 = "${selectOptionValue}");
				}

				var key_selectPositionValue = ${key_selectPositionValue} + 1;
			}

			ScrollWebElementIntoView(locator1 = "WWWPage#MARKETING_FORM_SUBMIT_BUTTON");

			Click(locator1 = "WWWPage#MARKETING_FORM_SUBMIT_BUTTON");

			Pause(locator1 = "30000");

			WWWHomepage.viewNoErrors();

			WWWHomepage.gotoRelativeURL(url = "${url}");
		}
	}

}