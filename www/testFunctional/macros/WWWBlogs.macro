definition {
	var wwwAdminEmailAddress = PropsUtil.get("www.admin.email.address");
	var wwwAdminPassword = PropsUtil.get("www.admin.password");
	var wwwURL = PropsUtil.get("www.liferay.url");

	@prose = "I click on the ${blogCategory} category link"
	macro clickBlogCategoryLink {
		var key_blogCategory = "${blogCategory}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_CATEGORY_LINK");
	}

	@prose = "I click on the blog entry with the title ${blogsEntryTitle} in the blog index"
	macro clickBlogEntryLink {
		var key_blogsEntryTitle = "${blogsEntryTitle}";
		
		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");
	}

	@prose = "I click on the blog entry in the position ${positionValue} in the blog index"
	macro clickBlogEntryLinkByPosition {
		var key_positionValue = "${positionValue}";
		
		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");
	}

	@prose = "I click on a featured blog entry link located in position ${positionValue} under the ${blogCategory} category"
	macro clickFeaturedBlogLink {
		var key_blogCategory = "${blogCategory}";
		var key_positionValue = "${positionValue}";

		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#FEATURED_BLOG_CATEGORY_LINK");
	}

	@prose = "I click on the Read Post button"
	macro clickReadPostButton {
		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#READ_POST_BUTTON");
	}

	@prose = "I click on the View More button"
	macro clickViewMoreButton {
		Click.pauseMakeVisibleClickAt(locator1 = "WWWBlogs#VIEW_MORE_BUTTON");
	}

	@prose = "I change the locale to ${locale}"
	macro selectLocale {
		Select(
			locator1 = "WWWBlogs#SWITCH_LOCALES_SELECT",
			value1="${locale}");
	}

	@prose = "I should not be able to view the blog entry with the title ${blogsEntryTitle} in the blog index"
	macro viewNoBlogEntryIndex {
		var key_blogsEntryTitle = "${blogsEntryTitle}";
		
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION");
	}

	@prose = "I should be able to view the blog entry with the title ${blogsEntryTitle} in the blog index"
	macro viewBlogEntryIndex {
		var key_blogsEntryTitle = "${blogsEntryTitle}";
		
		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_LINK");
		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE");
		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY");
		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE");
		AssertVisible(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION");
	}

	@prose = "I should be able to view the blog entry in the position ${positionValue} in the blog index"
	macro viewBlogEntryIndexByPosition {
		var key_positionValue = "${positionValue}";
		
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_LINK_BY_POSITION");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_IMAGE_BY_POSITION");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_CATEGORY_BY_POSITION");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_TITLE_BY_POSITION");
		AssertElementNotPresent(locator1 = "WWWBlogs#BLOG_ENTRY_DESCRIPTION_BY_POSITION");
	}
}