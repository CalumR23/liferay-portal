definition {
	@prose = "I go to the web content folder ${folderName}"
	macro gotoFolder {
		var key_entryTitle = "${folderName}";

		Click(locator1 = "WebContent#ENTRY_LIST_TITLE");

		AssertTextEquals(
			locator1 = "WebContent#ACTIVE_BREADCRUMB",
			value1 = "${folderName}");
	}

	@prose = "I go to a new form for a ${type} web content"
	macro gotoNewWebContentForm {
		Click(locator1 = "WebContent#ADD_BUTTON");
		Click(locator1 = "WebContent#MORE_BUTTON");

		SelectFrame(locator1 = "WebContent#MORE_MENU_IFRAME");

		var key_menuItemName = "${type}";

		Click(locator1 = "WebContent#MORE_MENU_ITEM_NAME");

		SelectFrameTop();
	}

	@prose = "I populate the following main web content fields with the following values ${table}"
	macro populateMainWebContentFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldName = "${row[0]}";
			var fieldType = "${row[1]}";
			var value = "${row[2]}";

			if ("${fieldName}" == "Title") {
				Type(
					locator1 = "WebContentCreate#TITLE_FIELD",
					value1 = "${value}");
			}
			else if (contains("${fieldName}", "Quote")) {
				if ("${fieldType}" == "Input") {
					WebContent.typeViaExactInputField(			
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.typeViaExactTextareaField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "File Upload") {
					WebContent.uploadViaExactField(
						field = "${fieldName}",
						value = "${value}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input, Textarea, or File Upload");
				}
			}
			else {
				if ("${fieldType}" == "Input") {
					WebContent.typeViaApproximateInputField(			
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.typeViaApproximateTextareaField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "File Upload") {
					WebContent.uploadViaApproximateField(
						field = "${fieldName}",
						value = "${value}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input, Textarea, or File Upload");
				}				
			}
		}
	}

	macro typeViaApproximateInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Type(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "${value}");
	}

	macro typeViaApproximateTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Type(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "${value}");
	}

	macro typeViaExactInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_EXACT")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_EXACT");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Type(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "${value}");
	}

	macro typeViaExactTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_EXACT");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Type(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT",
			value1 = "${value}");
	}

	macro uploadViaApproximateField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Click(locator1 = "WebContentCreate#SELECT_BUTTON_APPROXIMATE");

		SelectFrame(locator1 = "WebContentCreate#SELECT_FILE_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				ScrollWebElementIntoView(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");

				Click.pauseMakeVisibleClickAt(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");
			}
		}
		else {
			UploadCommonFile(
				locator1 = "WebContentCreate#SELECT_FILE_FIELD",
				value1 = "${value}");
		}

		SelectFrameTop();

		while (IsElementPresent(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON");
		}

		AssertElementNotPresent(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON");
	}

	macro uploadViaExactField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = MathUtil.sum("${key_positionValue}", "1");

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_EXACT")) {
				var key_positionValue = MathUtil.difference("${key_positionValue}", "1");

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_EXACT");

				var key_positionValue = MathUtil.sum("${key_positionValue}", "1");
			}
		}

		Click(locator1 = "WebContentCreate#SELECT_BUTTON_EXACT");

		SelectFrame(locator1 = "WebContentCreate#SELECT_FILE_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				Click(locator1 = "WebContent#ENTRY_CARDS_THUMBNAIL");
			}
		}
		else {
			UploadCommonFile(
				locator1 = "WebContentCreate#SELECT_FILE_FIELD",
				value1 = "${value}");
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON");

		while (IsElementPresent(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON");
		}

		AssertElementNotPresent(locator1 = "WebContentCreate#SELECT_FILE_ADD_BUTTON");
	}
}