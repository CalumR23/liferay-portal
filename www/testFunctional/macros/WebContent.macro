definition {

	@prose = "I change the current localization to ${localization}"
	macro changeCurrentLocalization {
		var key_localization = StringUtil.replace("${localization}", "-", "_");

		Click(locator1 = "WebContentCreate#LOCALIZATION_BUTTON");

		Click(locator1 = "WebContentCreate#LOCALIZATION_OPTION");
	}

	@prose = "I change the display date to ${timeInMinutes} minutes into the future"
	macro changeDisplayDate {
		var key_field = "Display Date";
		var key_positionValue = "5";
		var currentTime = selenium.getElementValue("WebContentCreate#SIDE_PANEL_INPUT_FIELD_APPROXIMATE");

		var currentHour = StringUtil.extractFirst("${currentTime}", ":");
		var currentAmPm = StringUtil.extractLast("${currentTime}", " ");
		var currentMinute = StringUtil.replace("${currentTime}", "${currentHour}:", "");

		var currentMinute = StringUtil.replace("${currentMinute}", " ${currentAmPm}", "");

		echo("Current time via input field: ${currentTime}");

		var futureHours = "0";
		var futureMinutes = "${timeInMinutes}";

		var futureMinutesOverSixty = MathUtil.isGreaterThanOrEqualTo("${futureMinutes}", "60");

		while (("${futureMinutesOverSixty}" == "true")) {
			var futureHours = ${futureHours} + 1;
			var futureMinutes = ${futureMinutes} - 60;

			var futureMinutesOverSixty = MathUtil.isGreaterThanOrEqualTo("${futureMinutes}", "60");
		}

		var futureMinute = ${currentMinute} + ${futureMinutes};

		var futureMinuteOverSixty = MathUtil.isGreaterThanOrEqualTo("${futureMinute}", "60");

		if ("${futureMinuteOverSixty}" == "true") {
			var futureHours = ${futureHours} + 1;
			var futureMinute = ${futureMinute} - 60;
		}
		else {
			var futureMinute = "${futureMinute}";
		}

		var futureMinuteUnderTen = MathUtil.isLessThan("${futureMinute}", "10");

		if ("${futureMinuteUnderTen}" == "true") {
			var futureMinute = "0${futureMinute}";
		}
		else {
			var futureMinute = "${futureMinute}";
		}

		var futureDays = "0";

		if ("${futureHours}" != "0") {
			if (("${currentAmPm}" == "PM") && ("${currentHour}" != "12")) {
				var futureHour = ${currentHour} + 12;
			}
			else if (("${currentAmPm}" == "AM") && ("${currentHour}" == "12")) {
				var futureHour = "0";
			}
			else {
				var futureHour = "${currentHour}";
			}

			while ("${futureHours}" != "0") {
				var futureHour = ${futureHour} + 1;

				if ("${futureHour}" == "24") {
					var futureHour = "0";
					var futureDays = ${futureDays} + 1;
				}

				var futureHours = ${futureHours} - 1;
			}

			var futureHourOverTwelve = MathUtil.isGreaterThanOrEqualTo("${futureHour}", "12");

			if (("${futureHourOverTwelve}" != "true") && ("${futureHour}" != "0")) {
				var futureHour = "${futureHour}";
				var futureAmPm = "AM";
			}
			else if (("${futureHourOverTwelve}" != "true") && ("${futureHour}" == "0")) {
				var futureHour = "12";
				var futureAmPm = "AM";
			}
			else if (("${futureHourOverTwelve}" == "true") && ("${futureHour}" == "12")) {
				var futureHour = "12";
				var futureAmPm = "PM";
			}
			else {
				var futureHour = ${futureHour} - 12;
				var futureAmPm = "PM";
			}
		}
		else {
			var futureHour = "${currentHour}";
			var futureAmPm = "${currentAmPm}";
		}

		var futureHourUnderTen = MathUtil.isLessThan("${futureHour}", "10");

		if ("${futureHourUnderTen}" == "true") {
			var futureHour = "0${futureHour}";
		}
		else {
			var futureHour = "${futureHour}";
		}

		var futureTime = "${futureHour}:${futureMinute} ${futureAmPm}";

		echo("Future calculated time: ${futureTime}");

		var futureDays = StringUtil.trim("${futureDays}");

		var futureDay = DateUtil.getDate("${futureDays}");
		var futureMonth = DateUtil.getMonth("${futureDays}");
		var futureYear = DateUtil.getYear("${futureDays}");
		var futureDayUnderTen = MathUtil.isLessThan("${futureDay}", "10");

		if ("${futureDayUnderTen}" == "true") {
			var futureDay = "0${futureDay}";
		}
		else {
			var futureDay = "${futureDay}";
		}

		var futureMonthUnderTen = MathUtil.isLessThan("${futureMonth}", "10");

		if ("${futureMonthUnderTen}" == "true") {
			var futureMonth = "0${futureMonth}";
		}
		else {
			var futureMonth = "${futureMonth}";
		}

		var futureDate = "${futureMonth}/${futureDay}/${futureYear}";

		echo("Future calculated date: ${futureDate}");

		var key_field = "Never Expire";
		var key_positionValue = "1";

		ScrollWebElementIntoView(locator1 = "WebContentCreate#SIDE_PANEL_CHECKBOX_APPROXIMATE");

		var key_field = "Display Date";
		var key_positionValue = "1";

		Type.clickAtType(
			locator1 = "WebContentCreate#SIDE_PANEL_INPUT_FIELD_APPROXIMATE",
			value1 = "");

		Type.clickAtSendKeys(
			locator1 = "WebContentCreate#SIDE_PANEL_INPUT_FIELD_APPROXIMATE",
			value1 = "${futureDate}");

		var key_positionValue = "5";

		Type.clickAtType(
			locator1 = "WebContentCreate#SIDE_PANEL_INPUT_FIELD_APPROXIMATE",
			value1 = "");

		Type.clickAtSendKeys(
			locator1 = "WebContentCreate#SIDE_PANEL_INPUT_FIELD_APPROXIMATE",
			value1 = "${futureTime}");

		WebContent.collapseSidePanelHeader(sidePanelCategory = "Schedule");

		WebContent.expandSidePanelHeader(sidePanelCategory = "Schedule");
	}

	@prose = "I clear the following existing web content fields ${table}"
	macro clearExistingWebContentFields {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldName = "${row[0]}";
			var fieldType = "${row[1]}";

			if ("${fieldName}" == "Title") {
				Type(
					locator1 = "WebContentCreate#TITLE_FIELD",
					value1 = "");
			}
			else if (contains("${fieldName}", "Quote")) {
				if ("${fieldType}" == "Input") {
					WebContent.clearViaExactInputField(field = "${fieldName}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.clearViaExactTextareaField(field = "${fieldName}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input or Textarea");
				}
			}
			else {
				if ("${fieldType}" == "Input") {
					WebContent.clearViaApproximateInputField(field = "${fieldName}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.clearViaApproximateTextareaField(field = "${fieldName}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input or Textarea");
				}
			}
		}
	}

	macro clearViaApproximateInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		KeyPress.keyDown(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "a");

		KeyPress(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "\DELETE");

		KeyPress.keyUp(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "\CONTROL");
	}

	macro clearViaApproximateTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		KeyPress.keyDown(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "a");

		KeyPress(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "\DELETE");

		KeyPress.keyUp(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "\CONTROL");
	}

	macro clearViaExactInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "WebContentCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		KeyPress.keyDown(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "a");

		KeyPress(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "\DELETE");

		KeyPress.keyUp(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "\CONTROL");
	}

	macro clearViaExactTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextEqual.isValue(locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;
		}

		KeyPress.keyDown(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT",
			value1 = "\CONTROL");

		KeyPress(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT",
			value1 = "a");

		KeyPress(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT",
			value1 = "\DELETE");

		KeyPress.keyUp(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_EXACT",
			value1 = "\CONTROL");
	}

	@prose = "I click the publish button"
	macro clickPublish {
		Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#PUBLISH_BUTTON");

		WaitForSPARefresh();
	}

	@prose = "I collapse the ${sidePanelCategory} header in the side panel"
	macro collapseSidePanelHeader {
		var sidePanelCategory = StringUtil.replace("${sidePanelCategory}", " ", "");

		var key_sidePanelCategory = StringUtil.lowerCaseFirstLetter("${sidePanelCategory}");

		if (IsElementPresent(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_EXPANDED")) {
			ScrollWebElementIntoView(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_EXPANDED");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_EXPANDED");
		}
	}

	@prose = "I populate the following web content fields and values ${table}"
	macro createWebContent {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var fieldName = "${row[0]}";
			var fieldType = "${row[1]}";
			var value = "${row[2]}";

			if ("${fieldName}" == "Title") {
				Type(
					locator1 = "WebContentCreate#TITLE_FIELD",
					value1 = "${value}");
			}
			else if (contains("${fieldName}", "Quote") || contains("${fieldName}", "Topic")) {
				if ("${fieldType}" == "Input") {
					WebContent.typeViaExactInputField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.typeViaExactTextareaField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Rich Text Editor") {
					WebContent.typeViaExactRichTextEditorField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "File Upload") {
					WebContent.uploadFileViaExactField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Category Select") {
					WebContent.selectCategoryViaExactField(
						field = "${fieldName}",
						value = "${value}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input, Textarea, File Upload, Rich Text Editor, or Category Select");
				}
			}
			else {
				if ("${fieldType}" == "Input") {
					WebContent.typeViaApproximateInputField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Textarea") {
					WebContent.typeViaApproximateTextareaField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Rich Text Editor") {
					WebContent.typeViaApproximateRichTextEditorField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "File Upload") {
					WebContent.uploadFileViaApproximateField(
						field = "${fieldName}",
						value = "${value}");
				}
				else if ("${fieldType}" == "Category Select") {
					WebContent.selectCategoryViaApproximateField(
						field = "${fieldName}",
						value = "${value}");
				}
				else {
					fail("Invalid field type ${fieldType}. Please set second column value to Input, Textarea, File Upload, Rich Text Editor, or Category Select");
				}
			}
		}
	}

	@prose = "I expand the ${sidePanelCategory} header in the side panel"
	macro expandSidePanelHeader {
		var sidePanelCategory = StringUtil.replace("${sidePanelCategory}", " ", "");

		var key_sidePanelCategory = StringUtil.lowerCaseFirstLetter("${sidePanelCategory}");

		if (IsElementPresent(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_COLLAPSED")) {
			ScrollWebElementIntoView(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_COLLAPSED");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SIDE_PANEL_HEADER_COLLAPSED");
		}
	}

	@prose = "I go to the web content folder ${folderName}"
	macro gotoFolder {
		var key_entryTitle = "${folderName}";

		Click(locator1 = "WebContent#ENTRY_LIST_TITLE");

		AssertTextEquals(
			locator1 = "WebContent#ACTIVE_BREADCRUMB",
			value1 = "${folderName}");
	}

	@prose = "I go to a new form for a ${type} web content"
	macro gotoNewWebContentForm {
		Click(locator1 = "WebContent#ADD_BUTTON");

		Click(locator1 = "WebContent#MORE_BUTTON");

		SelectFrame(locator1 = "WebContent#MORE_MENU_IFRAME");

		var key_menuItemName = "${type}";
		var notFound = "true";

		if (IsElementPresent.pauseIsElementPresent(locator1 = "WebContent#MORE_MENU_ITEM_NAME")) {
			ScrollWebElementIntoView(locator1 = "WebContent#MORE_MENU_ITEM_NAME");

			Click(locator1 = "WebContent#MORE_MENU_ITEM_NAME");

			SelectFrameTop();
		}
		else {
			while ((IsElementNotPresent(locator1 = "WebContent#NEXT_LINK_DISABLED")) && ("${notFound}" == "true")) {
				Click.pauseMakeVisibleClickAt(locator1 = "WebContent#NEXT_LINK");

				if (IsElementPresent.pauseIsElementPresent(locator1 = "WebContent#MORE_MENU_ITEM_NAME")) {
					ScrollWebElementIntoView(locator1 = "WebContent#MORE_MENU_ITEM_NAME");

					Click(locator1 = "WebContent#MORE_MENU_ITEM_NAME");

					SelectFrameTop();

					var notFound = "false";
				}
				else {
					var notFound = "true";
				}
			}
		}
	}

	macro selectCategoryViaApproximateField {
		var key_field = "${field}";
		var key_positionValue = "1";

		Click(locator1 = "WebContentCreate#SELECT_BUTTON_APPROXIMATE");

		SelectFrame(locator1 = "WebContentCreate#SELECT_CATEGORY_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				AssertElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				ScrollWebElementIntoView(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				WaitForSPARefresh();
			}
		}
		else {
			var key_entryTitle = "${value}";

			AssertElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			ScrollWebElementIntoView(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			WaitForSPARefresh();
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON")) {
			SelectFrame(locator1 = "WebContentCreate#SELECT_CATEGORY_IFRAME");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			if (IsElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY_SELECTED")) {
				Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY_OTHER");
			}

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");
		}

		AssertElementNotPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "WebContentCreate#CATEGORY_ITEM_OTHER_CLOSE_BUTTON_APPROXIMATE")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#CATEGORY_ITEM_OTHER_CLOSE_BUTTON_APPROXIMATE");
		}
	}

	macro selectCategoryViaExactField {
		var key_field = "${field}";
		var key_positionValue = "1";

		ScrollWebElementIntoView(locator1 = "WebContentCreate#SELECT_BUTTON_EXACT");

		Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_BUTTON_EXACT");

		while (IsElementNotPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_IFRAME")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_BUTTON_EXACT");
		}

		SelectFrame(locator1 = "WebContentCreate#SELECT_CATEGORY_IFRAME");

		if (contains("${value}", ",")) {
			for (var individualValue : list "${value}") {
				var key_entryTitle = "${individualValue}";

				AssertElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				ScrollWebElementIntoView(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

				WaitForSPARefresh();
			}
		}
		else {
			var key_entryTitle = "${value}";

			AssertElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			ScrollWebElementIntoView(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			WaitForSPARefresh();
		}

		SelectFrameTop();

		Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON")) {
			SelectFrame(locator1 = "WebContentCreate#SELECT_CATEGORY_IFRAME");

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			if (IsElementPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY_SELECTED")) {
				Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY_OTHER");
			}

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_ENTRY");

			SelectFrameTop();

			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");
		}

		AssertElementNotPresent(locator1 = "WebContentCreate#SELECT_CATEGORY_DONE_BUTTON");

		while (IsElementPresent(locator1 = "WebContentCreate#CATEGORY_ITEM_OTHER_CLOSE_BUTTON_EXACT")) {
			Click.pauseMakeVisibleClickAt(locator1 = "WebContentCreate#CATEGORY_ITEM_OTHER_CLOSE_BUTTON_EXACT");
		}
	}

	@prose = "I tear down the following web content entries ${table}"
	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Content & Data",
			panel = "Site Administration",
			portlet = "Web Content");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var entryTitle = "${row[0]}";

			Type(
				locator1 = "WebContent#SEARCH_FIELD",
				value1 = "${entryTitle}");

			KeyPress(
				locator1 = "WebContent#SEARCH_FIELD",
				value1 = "\RETURN");

			var key_entryTitle = "${entryTitle}";

			if (IsElementPresent.pauseIsElementPresent(locator1 = "WebContent#ENTRY_LIST_CHECKBOX")) {
				Click(locator1 = "WebContent#ENTRY_LIST_CHECKBOX");

				ClickNoError(locator1 = "WebContent#MOVE_TO_RECYCLE_BIN_BUTTON");

				Confirm(value1 = "Are you sure you want to move the selected entry to the Recycle Bin?");

				AssertElementPresent(locator1 = "Message#SUCCESS");
			}
		}

		ProductMenu.gotoPortlet(
			category = "Recycle Bin",
			panel = "Site Administration",
			portlet = "Recycle Bin");

		for (var row : table "${rawTable}") {
			var entryTitle = "${row[0]}";

			RecycleBin.tearDownCP(entryTitle = "${entryTitle}");
		}
	}

	macro typeViaApproximateInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Type(
			locator1 = "WebContentCreate#INPUT_FIELD_APPROXIMATE",
			value1 = "${value}");
	}

	macro typeViaApproximateRichTextEditorField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#RICH_TEXT_EDITOR_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "WebContentCreate#RICH_TEXT_EDITOR_FIELD_APPROXIMATE")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Type.typeCKEditorWaitForCKEditor(
			locator1 = "WebContentCreate#RICH_TEXT_EDITOR_FIELD_APPROXIMATE",
			value1 = "${value}");
	}

	macro typeViaApproximateTextareaField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_APPROXIMATE");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Type(
			locator1 = "WebContentCreate#TEXTAREA_FIELD_APPROXIMATE",
			value1 = "${value}");
	}

	macro typeViaExactInputField {
		var key_field = "${field}";
		var key_positionValue = "1";

		while (IsTextNotEqual.isNotValue(locator1 = "WebContentCreate#INPUT_FIELD_EXACT", value1 = "")) {
			var key_positionValue = ${key_positionValue} + 1;

			if (IsElementNotPresent(locator1 = "WebContentCreate#INPUT_FIELD_EXACT")) {
				var key_positionValue = ${key_positionValue} - 1;

				Click(locator1 = "WebContentCreate#ADD_DUPLICATE_FIELD_BUTTON_EXACT");

				var key_positionValue = ${key_positionValue} + 1;
			}
		}

		Type(
			locator1 = "WebContentCreate#INPUT_FIELD_EXACT",
			value1 = "${value}");
	}

