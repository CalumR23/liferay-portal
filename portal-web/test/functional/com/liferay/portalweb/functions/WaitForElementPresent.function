@default = "waitForElementPresent"
definition {

	function waitForElementPresent() {
		selenium.waitForElementPresent();
	}

	function waitForElementPresentNoException(locator1) {
		selenium.waitForElementPresent(${locator1}, "false");
	}

	function waitForLastScript() {
		selenium.waitForElementPresent("xpath=(//script)[last()]");
	}

}