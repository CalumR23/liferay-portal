@default = "setElementAttribute"
definition {

	function setElementAttribute(locator1,value2,value1,value3,attribute1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		var javaScript = '''
var element = document.evaluate("${locator1}", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;

element.setAttribute("${attribute1}", "${value1}");
		''';

		selenium.executeJavaScript(${value1}, ${value2}, ${value3});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}