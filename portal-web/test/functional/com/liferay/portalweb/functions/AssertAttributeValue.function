@default = "assertAttributeValue"
definition {

	function assertAttributeNotPresent(locator1,value1,attribute1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.assertAttributeNotPresent(${locator1}, ${attribute1}, ${value1});

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertAttributeValue(locator1,value1,attribute1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.assertAttributeValue(${locator1}, ${attribute1}, ${value1});

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertAttributeValueAtNotVisible(locator1,value1,attribute1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.assertAttributeValue(${locator1}, ${attribute1}, ${value1});

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

}