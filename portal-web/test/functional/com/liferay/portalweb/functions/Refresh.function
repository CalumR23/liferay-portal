@default = "refresh"
definition {

	function pauseRefresh(value1) {
		WaitForSPARefresh();

		selenium.pause(5000);

		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function refresh(value1) {
		WaitForSPARefresh();

		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function refreshNoSPARefresh(value1) {
		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}