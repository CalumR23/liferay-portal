@default = "assertSelectedLabel"
definition {

	function assertSelectedLabel(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.assertSelectedLabel(${locator1}, ${value1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}