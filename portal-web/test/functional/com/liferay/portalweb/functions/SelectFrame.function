@default = "selectFrame"
definition {

	function selectFrame {
		if (contains(${locator1}, "/iframe")) {
			WaitForFrameLoad.WaitForFrameLoad();

			selenium.waitForVisible(${locator1}, ${value1});

			selenium.mouseOver(${locator1});

			selenium.selectFrame(${locator1});

			selenium.assertJavaScriptErrors(${value1});

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameNoLoading {
		if (contains(${locator1}, "/iframe")) {
			selenium.waitForVisible(${locator1}, ${value1});

			selenium.mouseOver(${locator1});

			selenium.selectFrame(${locator1});

			selenium.assertJavaScriptErrors(${value1});

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameTop(value1) {
		selenium.selectFrame("relative=top");

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();

		WaitForSPARefresh();
	}

	function selectSecondFrame {
		if (contains(${locator1}, "/iframe")) {
			selenium.waitForVisible(${locator1}, ${value1});

			selenium.mouseOver(${locator1});

			selenium.selectFrame(${locator1});

			selenium.assertJavaScriptErrors(${value1});

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

}