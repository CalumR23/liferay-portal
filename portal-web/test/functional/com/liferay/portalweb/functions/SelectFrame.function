@default = "selectFrame"
definition {

	function selectFrame(locator1) {
		if (contains(${locator1}, "/iframe")) {
			WaitForFrameLoad();

			selenium.waitForVisible();

			selenium.mouseOver();

			selenium.selectFrame();

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameNoLoading(locator1) {
		if (contains(${locator1}, "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			selenium.selectFrame();

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameTop() {
		selenium.selectFrame("relative=top");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();

		WaitForSPARefresh();
	}

	function selectSecondFrame(locator1) {
		if (contains(${locator1}, "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			selenium.selectFrame();

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

}