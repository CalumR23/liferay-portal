@default = "scrollWebElementIntoView"
definition {

	function scrollWebElementIntoView(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.scrollWebElementIntoView(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}