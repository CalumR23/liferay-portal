@default = "assertChecked"
definition {

	function assertChecked(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.assertChecked(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function assertCheckedHiddenToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertChecked("xpath=(${locator1})/../../input");

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function assertCheckedNotVisible(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertChecked(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}