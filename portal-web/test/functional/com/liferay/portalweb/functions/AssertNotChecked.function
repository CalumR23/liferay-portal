@default = "assertNotChecked"
definition {

	function assertNotChecked(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.assertNotChecked(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function assertNotCheckedHiddenToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertNotChecked("xpath=(${locator1})/../../input");

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function assertNotCheckedNotVisible(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertNotChecked(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}