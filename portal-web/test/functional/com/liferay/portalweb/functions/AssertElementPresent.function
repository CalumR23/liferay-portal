@default = "assertElementPresent"
@summary = "Assert that '${locator1}' is available"
definition {

	function assertElementPresent(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertElementPresent(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function assertElementPresentNoWaitForSPAReFresh(locator1,value1) {
		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.assertElementPresent(${locator1});

		selenium.assertLiferayErrors();
	}

	function assertVisible(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.assertVisible(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function pauseAssertVisible(value1) {
		WaitForSPARefresh();

		selenium.pause(2000);

		AssertElementPresent.assertVisible();

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}