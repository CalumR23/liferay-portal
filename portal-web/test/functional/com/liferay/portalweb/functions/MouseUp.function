@default = "mouseUp"
definition {

	function mouseUp() {
		WaitForSPARefresh();

		selenium.mouseUp();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function mouseUpAt(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseUpAt(${locator1}, ${value1});

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

}