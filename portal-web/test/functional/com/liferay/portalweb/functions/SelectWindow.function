@default = "selectWindow"
definition {

	function selectPopUp(locator1,value1) {
		WaitForSPARefresh();

		selenium.pause(5000);

		selenium.selectPopUp(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function selectWindow(value1) {
		WaitForSPARefresh();

		selenium.pause(5000);

		selenium.selectWindow(${value1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function selectWindowNoSPARefresh(value1) {
		selenium.pause(5000);

		selenium.selectWindow(${value1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function selectWindowTopNoSPARefresh(value1) {
		selenium.pause(5000);

		selenium.selectWindow("null");

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function waitForSelectPopUp(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForPopUp(${locator1}, ${value1});

		selenium.selectPopUp(${value1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}