@default = "mouseOver"
@summary = "Mouse over '${locator1}'"
definition {

	function javaScriptFocus(value2,value1,value3) {
		WaitForSPARefresh();

		var javascript = '''
var event = document.createEvent('FocusEvent');

event.initEvent('focus', true, false);

arguments[0].dispatchEvent(event);
		''';

		ExecuteJavaScript(
			value1 = ${javaScript},
			value2 = ${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function javaScriptMouseOver(locator1,value1) {
		WaitForSPARefresh();

		selenium.javaScriptMouseOver(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function mouseOver(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.mouseOver(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function mouseOverInvisible(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.mouseOver(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function mouseOverNotVisible(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.mouseOver(${locator1});

		selenium.waitForVisible(${locator1}, ${value1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

	function waitForMenuToggleJSMouseOver(locator1,value1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, ${value1});

		selenium.pause(1000);

		selenium.mouseOver(${locator1});

		selenium.assertJavaScriptErrors(${value1});

		selenium.assertLiferayErrors();
	}

}