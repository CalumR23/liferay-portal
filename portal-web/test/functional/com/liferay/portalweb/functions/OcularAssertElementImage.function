@default = "ocularAssertElementImage"
@summary = "Check the screenshot of element matches baseline image"
definition {

	function ocularAssertElementImage {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.ocularAssertElementImage();
	}

	function ocularAssertElementImageWithZoom {
		WaitForSPARefresh();

		selenium.waitForVisible();

		var javascript = '''
			 function zoom() {
                        document.body.style.zoom = "25%"
                    }
             zoom()
            ''';

		selenium.runScript("${javascript}");

		selenium.ocularAssertElementImage();

		var javascript = '''
			 function zoom() {
                        document.body.style.zoom = "100%"
                    }
             zoom()
            ''';

		selenium.runScript("${javascript}");
	}

}