@component-name = "portal-analytics-cloud"
definition {

	property analytics.cloud.release = "true";
	property analytics.cloud.upstream = "true";
	property portal.release = "false";
	property portal.upstream = "true";
	property property.group = "analytics.cloud.profile";
	property testray.main.component.name = "Analytics Cloud";

	setUp {
		ACUtils.launchAC();

		var token = ACSettings.takeTokenFromAnalyticsCloud();

		static var tokenFromSetup = ${token};

		TestCase.setUpPortalInstance();

		ACUtils.launchDXP();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		ACUtils.tearDownAC();

		ACUtils.tearDownDXP();

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Validate Login User can view Sites Report page"
	@priority = 5
	test CanViewSiteReportUponLogin {
		var propertyName = ACDXPSettings.connectDXPtoAnalyticsCloud(key_token = ${tokenFromSetup});

		ACUtils.launchAC();

		ACProperties.switchProperty(propertyName = ${propertyName});

		ACNavigation.assertPageHeader(headerTitle = "Sites");
	}

}