<definition default="mouseDown">
	<command name="javaScriptMouseDown">
		<execute function="WaitForSPARefresh" />

		<execute selenium="javaScriptMouseDown" />
	</command>

	<command name="mouseDown">
		<execute function="WaitForSPARefresh" />

		<execute selenium="mouseDown" />
	</command>

	<command name="mouseDownAt">
		<execute function="WaitForSPARefresh" />

		<execute selenium="mouseDownAt" />
	</command>
</definition>