@default = "assertClick"
@summary = "Click on '${locator1}' that should have a value of '${value1}'"
definition {

	function assertClick {
		WaitForSPARefresh();

		if (contains("${locator1}", "/input")) {
			AssertClick.assertValueClickAt();
		}
		else {
			AssertClick.assertTextClickAt();
		}
	}

	function assertPartialTextClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertPartialText();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function assertPartialTextClickAtCPNavigation {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//script[contains(@src,'/liferay/message.js')]");

		AssertClick.assertPartialTextClickAt();
	}

	function assertTextClick {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.click();
	}

	function assertTextClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function assertTextClickAtAddApplication {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//script[contains(@src,'/liferay/dockbar_add_application.js')] | //script[contains(@src,'/liferay/dockbar_add_page.js')] | //script[contains(@src,'liferay/toggler_interaction.js')]");

		selenium.pause("1000");

		AssertClick.assertTextClickAt();
	}

	function assertTextClickAtAndPause {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.clickAt();

		selenium.pause("1000");
	}

	function assertTextClickAtAndWait {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.clickAtAndWait();
	}

	function assertTextClickAtWaitForLastScript {
		WaitForSPARefresh();

		selenium.waitForVisible();

		AssertClick.assertTextClickAt();

		selenium.waitForElementPresent("xpath=(//script)[last()]");
	}

	function assertTextClickNoMouseOver {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.click();
	}

	function assertTextClickTagSelector {
		WaitForSPARefresh();

		AssertClick.assertTextClick();

		SelectFrameTop();

		selenium.waitForVisible("//div[contains(@class,'lfr-tag-selector-popup')]");
	}

	function assertValueClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertValue();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function assertValueClickAtAndWait {
		WaitForSPARefresh();

		AssertTextEquals.assertValue();

		selenium.mouseOver();

		selenium.clickAtAndWait();
	}

	function pauseAssertPartialTextClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		AssertClick.assertPartialTextClickAt();
	}

	function pauseAssertTextClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		AssertClick.assertTextClickAt();
	}

	function pauseMakeVisibleAssertTextEqualsClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		selenium.makeVisible();

		selenium.waitForVisible();

		selenium.waitForText();

		selenium.mouseDown();

		selenium.pause("1000");

		selenium.mouseUp();
	}

	function waitForDMHomeAssertTextEqualsClick {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//div[contains(@id,'documentLibraryContainer')]");

		selenium.pause("1500");

		AssertClick.assertTextClickAt();
	}

	function waitForNodeScriptAssertTextEqualsClick {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//script[contains(@src,'/liferay/node.js')]");

		AssertClick.assertTextClickAt();
	}

}