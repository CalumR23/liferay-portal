@default = "mouseUp"
definition {

	function javaScriptMouseUp {
		WaitForSPARefresh();

		selenium.javaScriptMouseUp();
	}

	function mouseRelease {
		WaitForSPARefresh();

		selenium.mouseRelease();
	}

	function mouseUp {
		WaitForSPARefresh();

		selenium.mouseUp();
	}

	function mouseUpAt {
		WaitForSPARefresh();

		selenium.mouseUpAt();
	}

}