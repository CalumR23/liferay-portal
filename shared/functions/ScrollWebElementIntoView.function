<definition default="scrollWebElementIntoView">
	<command name="scrollWebElementIntoView">
		<execute function="WaitForSPARefresh" />

		<execute selenium="scrollWebElementIntoView" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

	<command name="andSome">
		<execute function="WaitForSPARefresh" />

		<execute selenium="scrollWebElementIntoView" />

		<execute selenium="scrollBy" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />
	</command>

</definition>
