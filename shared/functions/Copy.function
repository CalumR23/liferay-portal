@default = "copy"
definition {

	function ckEditorCopy {
		WaitForSPARefresh();

		selenium.waitForVisible("//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]");

		selenium.pause("1000");

		selenium.selectFrame();

		selenium.waitForVisible("//html/body");

		selenium.mouseOver("//html/body");

		selenium.copyText("//html/body");

		selenium.selectFrame("relative=parent");
	}

	function copy {
		WaitForSPARefresh();

		if (contains("${locator1}", "/input")) {
			Copy.valueCopy();
		}
		else {
			Copy.textCopy();
		}
	}

	function textCopy {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.copyText();
	}

	function valueCopy {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.copyValue();
	}

}