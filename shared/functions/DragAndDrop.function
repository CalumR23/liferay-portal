@default = "dragAndDropToObject"
definition {

	function dragAndDrop {
		WaitForSPARefresh();

		selenium.dragAndDrop();
	}

	function dragAndDropPortletToObject {
		WaitForSPARefresh();

		selenium.waitForElementPresent("${locator1}");

		selenium.mouseOver("${locator1}");

		selenium.waitForVisible("${locator1}");

		selenium.waitForText("${locator1}", "${value1}");

		selenium.waitForVisible("${locator2}");

		selenium.mouseOver("${locator2}");

		selenium.mouseDown("${locator1}");

		selenium.mouseMoveAt("${locator2}", "0,50");

		selenium.mouseMoveAt("${locator2}", "0,-50");

		selenium.mouseMoveAt("${locator2}", "0,50");

		selenium.mouseMove("${locator2}");

		selenium.mouseRelease("${locator2}");
	}

	function dragAndDropToObject {
		WaitForSPARefresh();

		selenium.waitForVisible("${locator1}");

		selenium.mouseOver("${locator1}");

		selenium.waitForPartialText("${locator1}", "${value1}");

		selenium.waitForVisible("${locator2}");

		selenium.mouseOver("${locator2}");

		selenium.dragAndDropToObject("${locator1}", "${locator2}");
	}

	function dragAndDropToObjectNotVisible {
		WaitForSPARefresh();

		selenium.waitForVisible("${locator1}");

		selenium.mouseOver("${locator1}");

		selenium.waitForText("${locator1}", "${value1}");

		selenium.dragAndDropToObject("${locator1}", "${locator2}");
	}

	function pauseDragAndDropCardToSection {
		WaitForSPARefresh();

		selenium.waitForElementPresent("${locator1}");

		selenium.mouseOver("${locator1}");

		selenium.waitForVisible("${locator1}");

		selenium.waitForText("${locator1}", "${value1}");

		selenium.waitForVisible("${locator2}");

		selenium.mouseOver("${locator2}");

		selenium.mouseDown("${locator1}");

		selenium.mouseMoveAt("${locator2}", "100,25");

		selenium.mouseMoveAt("${locator2}", "200,25");

		selenium.mouseMoveAt("${locator2}", "300,25");

		selenium.mouseMoveAt("${locator2}", "400,25");

		selenium.mouseMoveAt("${locator2}", "500,25");

		selenium.pause("2000");

		selenium.mouseRelease("${locator2}", "500,25");

		selenium.pause("2000");
	}

}