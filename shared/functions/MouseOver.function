@default = "mouseOver"
@summary = "Mouse over '${locator1}'"
definition {

	function mouseOver {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();
	}

	function mouseOverClickNavigation {
		WaitForSPARefresh();

		selenium.clickAt("//nav[@id='navigation']", "");

		selenium.waitForElementPresent("//script[contains(@src,'/frontend-js-web/liferay/sign_in_modal.js')]");

		MouseOver.mouseOver();

		selenium.pause("1000");
	}

	function mouseOverNotVisible {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.waitForVisible();
	}

	function partialTextMouseOver {
		WaitForSPARefresh();

		AssertTextEquals.assertPartialText();

		selenium.mouseOver();
	}

	function textMouseOver {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();
	}

	function textMouseOverClickNavigation {
		WaitForSPARefresh();

		selenium.clickAt("//nav[@id='navigation']", "");

		selenium.waitForElementPresent("//script[contains(@src,'/aui/sortable/sortable')]");

		MouseOver.textMouseOver();
	}

	function valueMouseOver {
		WaitForSPARefresh();

		AssertTextEquals.assertValue();

		selenium.mouseOver();
	}

}