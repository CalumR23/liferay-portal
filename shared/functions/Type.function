@default = "type"
@summary = "Type to '${locator1}' the value '${value1}'"
definition {

	function clickAtSendKeys {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.clickAt();

		selenium.pause("1000");

		selenium.sendKeys();

		selenium.pause("1000");

		selenium.clickAt();

		selenium.pause("1000");
	}

	function clickAtType {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.clickAt();

		selenium.pause("1000");

		selenium.type();

		selenium.pause("1000");

		selenium.clickAt();

		selenium.pause("1000");
	}

	function mouseOverFocusType {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.type("${locator1}", " ");

		selenium.type();
	}

	function sendKeys {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.sendKeys();
	}

	function sendKeysAceEditor {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.sendKeysAceEditor();
	}

	function sendKeysAceEditorNoMouseOver {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.sendKeysAceEditor();
	}

	function sendKeysApplicationSearch {
		WaitForSPARefresh();

		selenium.waitForElementPresent("//script[contains(@src,'/autocomplete-filters/autocomplete-filters')]");

		Type.sendKeys();
	}

	function sendKeysNoWait {
		WaitForSPARefresh();

		selenium.mouseOver();

		selenium.sendKeys();
	}

	function type {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.type();
	}

	function typeAceEditor {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.typeAceEditor();
	}

	function typeAceEditorNoMouseOver {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.typeAceEditor();
	}

	function typeCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.typeCKEditor();
	}

	function typeCKEditorWaitForCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible("//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]");

		selenium.pause("1000");

		Type.typeCKEditor();

		selenium.pause("1000");
	}

	function typeClickAt {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.type();

		selenium.clickAt();
	}

	function typeEditor {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.typeEditor();
	}

	function typePause {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.type();

		selenium.pause("1000");
	}

	function typeWaitForCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible("//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]");

		selenium.pause("1000");

		Type.type();
	}

}