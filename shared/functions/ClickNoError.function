@default = "click"
@summary = "Click on '${locator1}'"
definition {

	function click {
		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.click();
	}

	function makeVisibleClick {
		WaitForSPARefresh();

		selenium.mouseOver();

		selenium.makeVisible();

		selenium.click();
	}

	function pauseClick {
		WaitForSPARefresh();

		selenium.pause("1000");

		ClickNoError.click();
	}

	function waitForMenuToggleJSClick {
		selenium.waitForElementPresent("//script[contains(@src,'/o/frontend-js-web/liferay/menu_toggle.js')]");

		selenium.pause("3000");

		Click();
	}

}