@default = "select"
definition {

	function pauseSelect {
		WaitForSPARefresh();

		selenium.pause("5000");

		Select.select();
	}

	function select {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.select();
	}

	function selectAndWait {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.selectAndWait();
	}

	function selectByClick {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.click("${locator1}");

		selenium.click("//option[contains(.,'${value1}')]");
	}

}