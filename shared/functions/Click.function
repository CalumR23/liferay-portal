@default = "click"
@summary = "Click on '${locator1}'"
definition {
	function click {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.click();
	}

	function clickAt {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function clickAtSidebarClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		selenium.clickAt("//ul[contains(@data-namespace,'ControlMenuPortlet')]");

		selenium.waitForElementPresent("//script[contains(@src,'/classic/js/main.js')]");

		selenium.pause("1000");

		Click.clickAt();
	}

	function clickAtSidebarClickAtWaitForScript {
		WaitForSPARefresh();

		selenium.pause("1000");

		selenium.waitForElementPresent(
			"//*[@data-qa-id='controlMenu']//*[@data-qa-id='add']"
		);

		selenium.mouseOver();

		selenium.waitForElementPresent(
			"//script[contains(@src,'/liferay/node.js')] | //script[contains(@src,'/js/control_menu.js')]"
		);

		selenium.pause("1000");

		Click.clickAt();

		selenium.waitForElementPresent(
			"//script[contains(@src,'/liferay/dockbar_add_application.js')] | //script[contains( @src,'/js/product_navigation_control_menu_add_content.js')] | //script[contains(@src,'js/product_navigation_control_menu_add_application.js')]"
		);
	}

	function clickNoMouseOver {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.click();
	}

	function clickNoWaitForVisible {
		WaitForSPARefresh();

		selenium.mouseOver();

		selenium.click();
	}

	function clickNoSPARefresh {
		selenium.waitForVisible();

		selenium.mouseOver();

		selenium.click();
	}

	function clickWaitForInlineCKEditor {
		WaitForSPARefresh();

		if (selenium.isElementPresent("//div[contains(@class,'cke_editable_inline')]")) {
			selenium.waitForElementPresent(
				"//script[contains(@src,'http://localhost:8080/o/frontend-editors-web/ckeditor/plugins/wsc/lang/en.js')]"
			);
		}

		Click.click();
	}

	function clickWaitForInlineCKEditorNoMouseOver {
		WaitForSPARefresh();

		if (selenium.isElementPresent("//div[contains(@class,'cke_editable_inline')]")) {
			selenium.waitForElementPresent(
				"//script[contains(@src,'http://localhost:8080/o/frontend-editors-web/ckeditor/plugins/wsc/lang/en.js')]"
			);
		}

		selenium.waitForVisible();

		selenium.click();
	}

	function makeVisibleClickAt {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.pause("1000");

		selenium.makeVisible();

		selenium.waitForVisible();

		selenium.clickAt();
	}

	function mouseOverClick {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.waitForVisible();

		selenium.click();
	}

	function partialTextClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertPartialText();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function pauseClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		selenium.mouseOver();

		Click.clickAt();
	}

	function pauseMakeVisibleClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		Click.makeVisibleClickAt();
	}

	function pauseTextClickAt {
		WaitForSPARefresh();

		selenium.pause("1000");

		Click.textClickAt();
	}

	function textClick {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.click();
	}

	function textClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function textClickAtAndWait {
		WaitForSPARefresh();

		AssertTextEquals.assertText();

		selenium.mouseOver();

		selenium.clickAtAndWait();
	}

	function textClickAtAndWaitCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible(
			"//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]"
		);

		Click.textClickAtAndWait();
	}

	function textClickAtClickDockbar {
		WaitForSPARefresh();

		selenium.click("//div[@id='_145_dockbar']");

		selenium.waitForElementPresent("//script[contains(@src,'/liferay/node.js')]");

		Click.textClickAt();
	}

	function valueClickAt {
		WaitForSPARefresh();

		AssertTextEquals.assertValue();

		selenium.mouseOver();

		selenium.clickAt();
	}

	function valueClickAtAndWait {
		WaitForSPARefresh();

		AssertTextEquals.assertValue();

		selenium.mouseOver();

		selenium.clickAtAndWait();
	}

	function valueClickAtAndWaitCKEditor {
		WaitForSPARefresh();

		selenium.waitForVisible(
			"//a[contains(@class,'cke_button__unlink') and contains(@class,'cke_button_disabled')]"
		);

		Click.valueClickAtAndWait();
	}

	function waitForMenuToggleJSClick {
		WaitForSPARefresh();

		selenium.waitForElementPresent(
			"//script[contains(@src,'/o/frontend-js-web/liferay/menu_toggle.js')]"
		);

		selenium.pause("3000");

		Click();
	}

	function waitForNavigationInteractionTouchScriptTap {
		WaitForSPARefresh();

		selenium.waitForElementPresent(
			"//script[contains(@src,'liferay/dockbar_keyboard_interaction.js')]"
		);

		Click.clickAt();
	}

	function clickAtNotVisible {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		selenium.clickAt();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}
}