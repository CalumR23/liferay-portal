@default = "clickAt"
definition {

	function checkAll {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		if (selenium.isNotChecked()) {
			selenium.clickAt();
		}

		selenium.assertChecked("xpath=( //div[@class='checkbox']//input[@title='Select All'])[2]");
	}

	function checkHiddenToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isNotChecked("xpath=(${locator1})/../../input")) {
			selenium.clickAt();
		}

		AssertChecked.assertCheckedHiddenToggleSwitch();
	}

	function checkToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isNotChecked()) {
			selenium.clickAt();
		}

		AssertChecked.assertCheckedToggleSwitch();
	}

	function clickAt {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		if (selenium.isNotChecked()) {
			selenium.clickAt();
		}

		AssertChecked.assertChecked();
	}

	function noAssert {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		if (selenium.isNotChecked()) {
			selenium.clickAt();
		}
	}

	function toggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isNotChecked()) {
			selenium.clickAt();
		}

		AssertElementPresent();
	}

}