@default = "selectWindow"
definition {

	function selectPopUp {
		WaitForSPARefresh();

		selenium.pause("5000");

		selenium.selectPopUp();
	}

	function selectWindow {
		selenium.pause("5000");

		selenium.selectWindow();
	}

	function selectWindowTop {
		WaitForSPARefresh();

		selenium.pause("5000");

		selenium.selectWindow("null");
	}

}