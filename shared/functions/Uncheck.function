@default = "clickAt"
definition {

	function clickAt {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		if (selenium.isChecked()) {
			selenium.clickAt();
		}

		AssertNotChecked.assertNotChecked();
	}

	function uncheckHiddenToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isChecked("xpath=(${locator1})/../../input")) {
			selenium.clickAt();
		}

		AssertNotChecked.assertNotCheckedHiddenToggleSwitch();
	}

	function uncheckNoError {
		WaitForSPARefresh();

		selenium.waitForVisible();

		selenium.mouseOver();

		if (selenium.isChecked()) {
			selenium.clickAt();
		}

		AssertNotChecked.assertNotChecked();
	}

	function uncheckToggleSwitch {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isChecked()) {
			selenium.clickAt();
		}

		AssertNotChecked.assertNotCheckedToggleSwitch();
	}

	function uncheckToggleSwitchNoErrorNoAssert {
		WaitForSPARefresh();

		selenium.waitForElementPresent();

		selenium.mouseOver();

		if (selenium.isChecked()) {
			selenium.clickAt();
		}
	}

}