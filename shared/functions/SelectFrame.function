@default = "selectFrame"
definition {

	function selectFrame {
		if (contains("${locator1}", "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			selenium.selectFrame();

			selenium.waitForElementNotPresent("//div[contains(@class,'overlaymask') and not(contains(@class,'hidden'))]//div[contains(@class,'loadingmask-message')]");
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameTop {
		selenium.selectFrame("relative=top");

		WaitForSPARefresh();
	}

}