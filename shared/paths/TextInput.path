<html>
<head>
<title>TextInput</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">TextInput</td></tr>
</thead>

<tbody>
<tr>
	<td>EMAIL_ADDRESS</td>
	<td>//div//label[contains(.,'Email Address')]/following-sibling::*//input</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD</td>
	<td>//div//label[contains(.,'Password')]/following-sibling::*//input</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH</td>
	<td>//input[contains(@class,'S') or contains(@class,'s')][contains(@class,'earch')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_2</td>
	<td>xpath=(//input[contains(@class,'search')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>