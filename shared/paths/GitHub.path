<html>
<head>
<title>GitHub</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">GitHub</td></tr>
</thead>

<tbody>
<tr>
	<td>GITHUB_VIEW_INVITATION_LINK</td>
	<td>//a[contains(.,'View invitation')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_SIGN_IN_PAGE_LINK</td>
	<td>//a[contains(@href,'/login')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_SIGN_IN_USERNAME_FIELD</td>
	<td>//input[@name='login']</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_SIGN_IN_PASSWORD_FIELD</td>
	<td>//input[@name='password']</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_SIGN_IN_BUTTON</td>
	<td>//input[@value='Sign in']</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_ACCEPT_INVITATION_BUTTON</td>
	<td>//button[contains(.,'Accept invitation')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_IS_SUPPPORT_INTEGRATION_REPOSITORY_HEADER_LINK</td>
	<td>//a[contains(.,'is-support-integration')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_H1</td>
	<td>//article/h1</td>
	<td></td>
</tr>
<tr>
	<td>REPO_PATH_H1</td>
	<td>//div[contains(@class,'repohead-details')]/h1</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>