<html>
<head>
<title>LinkedInLogin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LinkedInLogin</td></tr>
</thead>
<tbody>
<tr>
	<td>SIGN_IN</td>
	<td>//a[contains(.,'Sign in')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//input[contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS</td>
	<td>//input[contains(@class,'email')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD</td>
	<td>//input[contains(@class,'password')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>