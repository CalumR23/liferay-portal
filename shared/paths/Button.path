<html>
<head>
<title>Button</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Button</td></tr>
</thead>
<tbody>
<tr>
	<td>SIGN_IN</td>
	<td>//div[contains(@class,'button')]//input[@*='Sign In' or contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_TOGGLE</td>
	<td>//a[contains(@class,'btn') and contains(@class,'toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT</td>
	<td>//input[contains(@class,'button') and contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_2</td>
	<td>xpath=(//input[contains(@class,'button') and contains(@type,'submit')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>