<html>
<head>
<title>Button</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Button</td></tr>
</thead>
<tbody>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(@class,'btn') and text()='Cancel'] | //button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//button/span[text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//button/span[text()='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button/span[text()='Save'] | //button[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//button[contains(.,'Search')] | //div[contains(@class,'basic-search')]//button[@type='submit']</td>
	<td></td>
</tr>
<tr>
	<td>SEND_BUTTON</td>
	<td>//button/span[text()='Send']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN</td>
	<td>//div[contains(@class,'button')]//input[@*='Sign In' or contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_TOGGLE</td>
	<td>//a[contains(@class,'btn') and contains(@class,'toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT</td>
	<td>//input[(contains(@class,'button') or contains(@class,'btn')) and contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_2</td>
	<td>xpath=(//input[(contains(@class,'button') or contains(@class,'btn')) and contains(@type,'submit')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>