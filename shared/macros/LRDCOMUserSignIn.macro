<definition>
	<command name="agreeToTermsOfUse">
		<execute function="Click" locator1="Checkbox#AGREED_TO_TERMS_OF_USE_CHECKBOX" />

		<execute function="Click" locator1="Button#SUBMIT" />
	</command>

	<command name="signIn">
		<execute function="Type" locator1="TextInput#EMAIL_ADDRESS" value1="${userEmailAddress}" />
		<execute function="Type" locator1="TextInput#PASSWORD" value1="${userPassword}" />

		<execute function="AssertClick" locator1="Button#SIGN_IN" value1="Sign In" />

		<execute function="AssertElementNotPresent" locator1="Button#SIGN_IN" value1="Sign In" />
	</command>

	<command name="signInDXPFreeTrial">
		<execute function="AssertClick" locator1="Button#SIGN_IN_TOGGLE" value1="Sign In" />

		<execute function="Type" locator1="TextInput#EMAIL_ADDRESS" value1="${userEmailAddress}" />
		<execute function="Type" locator1="TextInput#PASSWORD" value1="${userPassword}" />

		<execute function="AssertClick" locator1="Button#SUBMIT_2" value1="Show Me Liferay" />

		<execute macro="LRDCOMUserSignIn#agreeToTermsOfUse" />
	</command>
</definition>