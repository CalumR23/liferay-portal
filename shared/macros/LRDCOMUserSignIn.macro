definition {

	macro agreeToTermsOfUse {
		Click(locator1 = "LRDCOMCheckbox#AGREED_TO_TERMS_OF_USE_CHECKBOX");

		Click(locator1 = "Button#SUBMIT");
	}

	macro signIn {
		Type(
			locator1 = "TextInput#EMAIL_ADDRESS",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "TextInput#PASSWORD",
			value1 = "${userPassword}");

		AssertClick(
			locator1 = "Button#SIGN_IN",
			value1 = "Sign In");

		AssertElementNotPresent(
			locator1 = "Button#SIGN_IN",
			value1 = "Sign In");
	}

	macro signInDXPFreeTrial {
		AssertClick(
			locator1 = "Button#SIGN_IN_TOGGLE",
			value1 = "Sign In");

		Type(
			locator1 = "TextInput#EMAIL_ADDRESS",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "TextInput#PASSWORD",
			value1 = "${userPassword}");

		AssertClick(
			locator1 = "Button#SUBMIT_2",
			value1 = "Show Me Liferay");

		if (IsElementPresent(locator1 = "LRDCOMCheckbox#AGREED_TO_TERMS_OF_USE_CHECKBOX")) {
			LRDCOMUserSignIn.agreeToTermsOfUse();
		}
	}

}