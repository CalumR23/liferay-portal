definition {
    macro goToCalendar {
        Default.Click(
            locator1 = "HomePage#SEE_MORE_BUTTON",
            key_widgetName = "Calendário corporativo",
            key_buttonName = "Calendário completo");
    }

    macro addCalendarEvent {
        Default.Click(locator1 = "Calendar#ADD_EVENT");

        Default.Click(locator1 = "HomePage#BUTTON_SAVE");
    }

    macro assertEvent {
        Default.AssertElementPresent(
            locator1 = "Calendar#EVENT_NAME",
            key_eventName = "${eventName}");
    }

    macro assertCalendarEvent {
        Default.AssertElementPresent(
            locator1 = "Calendar#HOME_PAGE_EVENT_NAME",
            key_eventName = "${eventName}");
    }
}