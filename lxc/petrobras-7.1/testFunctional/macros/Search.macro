definition {

	macro searchEmbedded {
		Default.Type(
			locator1 = "HomePage#SEARCH_BAR",
			value1 = "${searchTerm}");

		Default.KeyPress(
			locator1 = "HomePage#SEARCH_BAR",
			value1 = "\ENTER");
	}

	macro selectDropdownFilters {
		Default.Click(
			key_filterButton = "${filterType}",
			locator1 = "Search#DROPDOWN_FILTER");

		Default.Click(
			key_dropdownItem = "${filterItem}",
			key_filterButton = "${filterType}",
			locator1 = "Search#DROPDOWN_FILTER_ITEM");

		Default.Click(
			key_tabName = "Portal",
			locator1 = "Search#NAV_LINK_TAB");

		Default.AssertElementPresent(
			key_itemName = "${filterItem}",
			locator1 = "Search#DROPDOWN_MENU");
	}

	macro selectNewsFilterTab {
		if (isSet(filterName) && ("${filterName}" == "Todos")) {
			Default.Click(locator1 = "Search#SEARCH_ALL_FILTER");
		}
		else {
			Default.Click(
				key_filterName = "${filterName}",
				locator1 = "Search#FILTER_TAB");

			Default.Click(
				key_tabName = "Portal",
				locator1 = "Search#NAV_LINK_TAB");

			Default.AssertElementPresent(
				key_filterName = "${filterName}",
				locator1 = "Search#FILTER_TAB");
		}
	}

	macro SelectSearchTab {
		Default.Click(
			key_tabName = "${tabName}",
			locator1 = "Search#NAV_LINK_TAB");

		Default.AssertElementPresent(
			key_tabName = "${tabName}",
			locator1 = "Search#NAV_LINK_TAB_ACTIVE");
	}

}