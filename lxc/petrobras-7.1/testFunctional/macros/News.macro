definition {

	@summary = "Add new item in news widget"
	macro addNewNews {
		Default.MouseOver.mouseOverNotVisible(
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#HOME_PAGE_WIDGET");

		Default.Click(
			key_widgetName = "${widgetName}",
			locator1 = "Button#BUTTON_PLUS_WIDGET_BY_NAME");

		Default.Click(
			key_tagLib = "${tagLib}",
			locator1 = "Button#SPAN_BUTTON_TAGLIB");

		IFrame.selectModalFrame();

		Default.Type(
			key_fieldLabel = "Título",
			locator1 = "TextInput#GENERIC_TEXT_INPUT",
			value1 = "${newsTitle}");

		Default.Click(locator1 = "Button#BUTTON_PUBLICAR");
	}

	@summary "Assert item in news widget"
	macro assertNewsIsDisplayed {
		Default.Refresh();

		Default.AssertElementPresent(
			key_newsName = "${newsName}",
			locator1 = "HomePage#NEWS_ON_LIST");
	}

}