definition {

	macro signIn {
		if (!(isSet(userLogin))) {
			var userLogin = "test";
		}

		if (!(isSet(userPassword))) {
			var userPassword = "test";
		}

		Default.Type(
			locator1 = "Login#USERNAME_LOGIN_FIELD",
			value1 = "${userLogin}");

		Default.Type(
			locator1 = "Login#PASSWORD_LOGIN_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "Login#ENTRAR_BUTTON");
	}

	macro signOut {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}/c/portal/logout");
	}

}