definition {

	macro launchPortal {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

	macro getFilePath {
		var dependenciesDir = "testFunctional/tests/dependencies";
		var dependencyFilePath = "${dependenciesDir}/${fileName}";

		return "${dependencyFilePath}";
	}

	macro addUser {
		if (!(isSet(key_userPassword1))) {
			var key_userPassword1 = "test";
		}

		if (!(isSet(key_userPassword2))) {
			var key_userPassword2 = "test";
		}

		Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");

		Default.Click(locator1 = "HomePage#CONTROL_PANEL");

		Default.Click(
			locator1 = "HomePage#CONTROL_PANEL_MENU",
			key_menuOption = "Usuários");

		Default.Click(
			locator1 = "HomePage#CONTROL_PANEL_SUB_MENU",
			key_subMenu = "Usuários e Organizações");

		Default.Click(locator1 = "HomePage#BUTTON_PLUS");

		Default.Type(
			locator1 = "PTBTextInput#ADD_USER_SCREEN_NAME",
			value1 = "${screenName}");

		Default.Type(
			locator1 = "PTBTextInput#ADD_USER_FIRST_NAME",
			value1 = "${firstName}");

		Default.Type(
			locator1 = "PTBTextInput#ADD_USER_LAST_NAME",
			value1 = "${lastName}");

		Default.Click(
			locator1 = "HomePage#BUTTON_SPAN",
			key_buttonName = "Salvar");

		Default.Click(
			locator1 = "HomePage#NAV_LINK2",
			key_navItem = "Senha");

		Default.Type(
			locator1 = "PTBTextInput#SET_USER_PASSWORD1",
			value1 = "${key_userPassword1}");

		Default.Type(
			locator1 = "PTBTextInput#SET_USER_PASSWORD2",
			value1 = "${key_userPassword2}");

		Default.Click(
			locator1 = "HomePage#BUTTON_SPAN",
			key_buttonName = "Salvar");

		if (isSet(userIncription)) {
			Default.Click(
				locator1 = "HomePage#NAV_LINK2",
				key_navItem = "Inscrições");

			Default.Click(
				locator1 = "HomePage#SPAN_BUTTON_TAGLIB",
				key_tagLib = "Selecionar");

			Default.SelectFrame.selectFrameNoLoading(locator1 = "IFrame#MODAL_BODY");

			Default.Click(
				locator1 = "HomePage#BUTTON_SELECTOR",
				key_buttonName = "${userIncription}");

			Default.SelectFrameTop();

			Default.Click(
				locator1 = "HomePage#BUTTON_SPAN",
				key_buttonName = "Salvar");
		}

		if (isSet(userRole)) {
			Default.Click(
			locator1 = "HomePage#NAV_LINK2",
			key_navItem = "Papéis");

			Default.Click(
				locator1 = "HomePage#SPAN_BUTTON_TAGLIB",
				key_tagLib = "Selecionar");

			Default.SelectFrame.selectFrameNoLoading(locator1 = "IFrame#MODAL_BODY");

			Default.Click(
				locator1 = "HomePage#BUTTON_SELECTOR",
				key_buttonName = "${userRole}");

			Default.SelectFrameTop();

			Default.Click(
				locator1 = "HomePage#BUTTON_SPAN",
				key_buttonName = "Salvar");

			Default.SelectFrameTop();
		}
}

}