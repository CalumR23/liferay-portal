definition {

	macro launchPortal {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

	macro getFilePath {
		var dependenciesDir = "testFunctional/tests/dependencies";
		var dependencyFilePath = "${dependenciesDir}/${fileName}";

		return "${dependencyFilePath}";
	}

}