definition {

	macro addUser {
		if (!(isSet(key_userPassword1))) {
			var key_userPassword1 = "test";
		}

		if (!(isSet(key_userPassword2))) {
			var key_userPassword2 = "test";
		}

		Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");

		Default.ClickNoError(locator1 = "HomePage#CONTROL_PANEL");

		Default.Click(
			key_menuOption = "Usuários",
			locator1 = "HomePage#CONTROL_PANEL_MENU");

		Default.Click(
			key_subMenu = "Usuários e Organizações",
			locator1 = "HomePage#CONTROL_PANEL_SUB_MENU");

		Default.Click(locator1 = "Button#BUTTON_PLUS");

		Default.Type(
			locator1 = "TextField#ADD_USER_SCREEN_NAME",
			value1 = "${screenName}");

		Default.Type(
			locator1 = "TextField#ADD_USER_FIRST_NAME",
			value1 = "${firstName}");

		Default.Type(
			locator1 = "TextField#ADD_USER_LAST_NAME",
			value1 = "${lastName}");

		Default.Click(
			key_buttonName = "Salvar",
			locator1 = "Button#BUTTON_SPAN");

		Default.Click(
			key_navItem = "Senha",
			locator1 = "HomePage#NAV_LINK2");

		Default.Type(
			locator1 = "TextField#SET_USER_PASSWORD1",
			value1 = "${key_userPassword1}");

		Default.Type(
			locator1 = "TextField#SET_USER_PASSWORD2",
			value1 = "${key_userPassword2}");

		Default.Click(
			key_buttonName = "Salvar",
			locator1 = "Button#BUTTON_SPAN");

		if (isSet(userIncription)) {
			Default.Click(
				key_navItem = "Inscrições",
				locator1 = "HomePage#NAV_LINK2");

			Default.Click(
				key_tagLib = "Selecionar",
				locator1 = "Button#SPAN_BUTTON_TAGLIB");

			IFrame.selectNoLoadingModalFrame();

			Default.Click(
				key_buttonName = "${userIncription}",
				locator1 = "Button#BUTTON_SELECTOR");

			Default.SelectFrameTop();

			Default.Click(
				key_buttonName = "Salvar",
				locator1 = "Button#BUTTON_SPAN");
		}

		if (isSet(userRole)) {
			Default.Click(
				key_navItem = "Papéis",
				locator1 = "HomePage#NAV_LINK2");

			Default.Click(
				key_tagLib = "Selecionar",
				locator1 = "Button#SPAN_BUTTON_TAGLIB");

			IFrame.selectNoLoadingModalFrame();

			Default.Click(
				key_buttonName = "${userRole}",
				locator1 = "Button#BUTTON_SELECTOR");

			Default.SelectFrameTop();

			Default.Click(
				key_buttonName = "Salvar",
				locator1 = "Button#BUTTON_SPAN");

			Default.SelectFrameTop();
		}
	}

	macro getFilePath {
		var dependenciesDir = "testFunctional/tests/dependencies";
		var dependencyFilePath = "${dependenciesDir}/${fileName}";

		return "${dependencyFilePath}";
	}

	macro launchPortal {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

	macro viewURL {
		Default.WaitForPageLoad();

		Default.AssertLocation.assertPartialLocation(value1 = "${partialUrl}");
	}

}