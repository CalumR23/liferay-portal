definition {

	@summary = "Add new item in news carousel"
	macro addNewNewsOnCarousel {
		Default.MouseOver(locator1 = "HomePage#NEWS_CAROUSEL");

		Default.Click(
			key_widgetClass = "${widgetClass}",
			locator1 = "Button#BUTTON_PLUS_WIDGET");

		Default.Click(
			key_tagLib = "${tagLib}",
			locator1 = "Button#SPAN_BUTTON_TAGLIB");

		IFrame.selectModalFrame();

		Default.Type(
			key_fieldLabel = "Título",
			locator1 = "TextInput#GENERIC_TEXT_INPUT",
			value1 = "${newsTitle}");

		Default.Click(locator1 = "Button#BUTTON_PUBLICAR");
	}

	@summary = "Assert news in carousel home page widget"
	macro assertNewsOnCarousel {
		Default.Refresh();

		Default.AssertElementPresent(
			key_newsName = "${newsName}",
			locator1 = "HomePage#NEWS_ON_CAROUSEL");
	}

	@summary = "Assert post in Social Media wigdet"
	macro assertSocialMediaPostByIndex {
		if (isSet(socialNetwork) && ("${socialNetwork}" == "twitter")) {
			Default.Click(
				key_navItem = "twitter",
				locator1 = "HomePage#NAV_LINK");

			Default.Click(
				key_arrowDirection = "right",
				locator1 = "HomePage#SLICK_ARROW");
		}

		for (var key_newsIndex : list "${newsIndex}") {
			Default.AssertElementPresent(
				key_newsIndex = "${key_newsIndex}",
				key_socialNetwork = "${socialNetwork}",
				locator1 = "HomePage#SOCIAL_NETWORK_WIDGET");
		}
	}

	@summary = "Start/pause youtube video"
	macro clickOnVideo {
		Default.SelectFrame(locator1 = "Video#YOUTUBE_FRAME");

		Default.Click(locator1 = "Video#PLAY_PAUSE_VIDEO");
	}

	@summary = "Select home page widget"
	macro goToHomePageWidgetItem {
		Default.Click(
			key_optionName = "${optionName}",
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#HOME_PAGE_WIDGET_OPTION");
	}

	@summary = "Assert home page widget"
	macro viewHomePageWidget {
		Default.AssertElementPresent(
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#HOME_PAGE_WIDGET");
	}

	@summary = "Assert mega menu item"
	macro viewMegaMenu {
		for (var key_menuItem : list "${menuItem}") {
			Default.AssertElementPresent(
				key_menuItem = "${key_menuItem}",
				locator1 = "HomePage#MEGA_MENU_ITEM");
		}
	}

	@summary = "Assert mega menu sub item"
	macro viewMegaMenuSubItem {
		for (var key_subItem : list "${subItem}") {
			Default.AssertElementPresent(
				key_menuItem = "${menuItem}",
				key_subItem = "${key_subItem}",
				locator1 = "HomePage#MEGA_MENU_SUB_ITEM");
		}
	}

	@summary = "Assert page footer menu"
	macro viewPageFooterNavigation {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				locator1 = "HomePage#HOME_PAGE_FOOTER_WIDGET");
		}
	}

	@summary = "View side bar item"
	macro viewSideBarPortlet {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				locator1 = "HomePage#SIDE_BAR");
		}
	}

	@summary = "Verify if video is paused/playing"
	macro viewVideoStatus {
		Default.AssertElementPresent(
			key_videoStatus = "${videoStatus}",
			locator1 = "Video#VIDEO_STATUS");
	}

}