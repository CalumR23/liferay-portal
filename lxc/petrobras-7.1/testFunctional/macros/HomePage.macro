definition {

	macro addNewNewsOnCarousel {
		Default.MouseOver(locator1 = "HomePage#NEWS_CAROUSEL");

		Default.Click(
			locator1 = "HomePage#BUTTON_PLUSS_WIDGET",
			key_widgetClass = "${widgetClass}");

		Default.Click(
			locator1 = "HomePage#SPAN_BUTTON_TAGLIB",
			key_tagLib = "${tagLib}");

		Default.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Default.Type(
			locator1 = "TextInput#GENERIC_TEXT_INPUT",
			key_fieldLabel = "Título",
			value1 = "${newsTitle}");

		Default.Click(locator1 = "HomePage#BUTTON_PUBLICAR");
	}


	macro assertNewsOnCarousel {
		Default.Refresh();

		Default.AssertElementPresent(
			locator1 = "HomePage#NEWS_ON_CAROUSEL",
			key_newsName = "${newsName}");
	}

	macro clickOnVideo {
		Default.SelectFrame(locator1 = "Video#YOUTUBE_FRAME");

		Default.Click(locator1 = "Video#PLAY_PAUSE_VIDEO");
	}

	macro viewCarouselNews {
		Default.AssertElementPresent(locator1 = "HomePage#NEWS_CAROUSEL");
	}

	macro ViewHighlightedImage {
		if (!(isSet(index))) {
			var index = "1";
		}

		Default.AssertElementPresent(
			key_index = "${index}",
			locator1 = "HomePage#FEATURED_IMAGE");
	}

	macro viewHomePageWidget {
		Default.AssertElementPresent(
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#HOME_PAGE_WIDGET");
	}

	macro viewHomePageWidgetItem {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				key_widgetName = "${widgetName}",
				locator1 = "HomePage#HOME_PAGE_WIDGET_OPTION");
		}
	}

	macro viewMegaMenu {
		for (var key_menuItem : list "${menuItem}") {
			Default.AssertElementPresent(
				key_menuItem = "${key_menuItem}",
				locator1 = "HomePage#MEGA_MENU_ITEM");
		}
	}

	macro viewMegaMenuSubItem {
		for (var key_subItem : list "${subItem}") {
			Default.AssertElementPresent(
				key_menuItem = "${menuItem}",
				key_subItem = "${key_subItem}",
				locator1 = "HomePage#MEGA_MENU_SUB_ITEM");
		}
	}

	macro ViewPageFooterNavigation {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				locator1 = "HomePage#HOME_PAGE_FOOTER_WIDGET");
		}
	}

	macro viewSearchBar {
		Default.AssertElementPresent(locator1 = "HomePage#SEARCH_BAR");
	}

	macro ViewSideBarPortlet {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				locator1 = "HomePage#SIDE_BAR");
		}
	}

	macro viewVideoStatus {
		Default.AssertElementPresent(
			key_videoStatus = "${videoStatus}",
			locator1 = "Video#VIDEO_STATUS");
	}

}