definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

    @description = "Verify that, in the fist tab, the user can see the last 2 posts from Facebook"
	test FacebookPostsAreDisplayed {
		task ("Assert that Nas Redes Sociais widget have 2 posts from facebook") {
			HomePage.assertSocialMediaPostByIndex(
                socialNetwork = "facebook",
                newsIndex = "0,1");
		}
    }


}