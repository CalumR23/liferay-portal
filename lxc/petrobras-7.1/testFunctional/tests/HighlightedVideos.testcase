definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

    @description = "Verify that there is a 'Ver tudo' link"
	test VerTudoLinkIsDisplayed {
        task ("Assert that the link on 'Ver tudo' exists") { 
            Default.AssertElementPresent(
                locator1 = "HomePage#HOME_PAGE_LINK",
                key_widgetName = "vídeos em destaque",
                key_pageLink = "vídeos");
        }
    }

    @description = "Verify that when the user clicks on 'Ver tudo' he can see all available vídeos at the 'Galeria de vídeos' page"
	test VerTudoLinkRedirectToVideoGallery {
        task ("Click on 'Ver tudo' link and assert that now is on the Videos page") {
            Default.Click(
                locator1 = "HomePage#HOME_PAGE_LINK",
                key_widgetName = "vídeos em destaque",
                key_pageLink = "vídeos");

            Default.AssertElementPresent(
                locator1 = "HomePage#PAGE_TITLE",
                key_pageTitle = "Vídeos");
        }

        task ("Assert if there are more videos") {
            HighlightedVideos.findVideoByIndex(index = "1,2,3");
        }
    }

}