definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that the options 'EVA, Petrobras Compliance, Compromisso com a vida,  PE 240 / PNG 2019-2023,  Mobiliza Contínuo, ACT 2019' are displayed on Acesso Rápido"
	test AcessoRapidoWigetIsDisplayed {
		task ("Verify items on Acesso Rápido widget") {
			HomePage.viewHomePageWidgetItem(
				optionName = "EVA,Petrobras em Compliance,Compromisso com a vida,PE 240 / PNG 2019-2023,Mobiliza Contínuo,ACT 2019",
				widgetName = "Acesso rápido");
		}
	}

	@description = "Verify that the carousel news is displayed on page"
	test CarouselNewsIsDisplayedOnHomePage {
		task ("Verify if Search bar is displayed") {
			HomePage.viewCarouselNews();
		}
	}

	@description = "Verify that the widget for highlighted images is displayed"
	test FeaturedImageIsDisplayed {
		task ("Verify highlighted image is displayed") {
			HomePage.ViewHighlightedImage();
		}
	}

	@description = "Verify that the Mega Menu is displayed with the options: Sobre Nós, Nossos negócios, Sustentabilidade e Segurança, RH e Você, Tecnologia e serviços, Normas e procedimentos"
	test MegaMenuItemIsDisplayed {
		task ("Verify items on mega menu") {
			HomePage.viewMegaMenu(menuItem = "Sobre Nós,Nossos negócios,Sustentabilidade e Segurança,RH e Você,Tecnologia e serviços,Normas e procedimentos");
		}
	}

}