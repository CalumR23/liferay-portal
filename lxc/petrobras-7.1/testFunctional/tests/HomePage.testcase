definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that the option 'ACT 2019', displayed on Acesso Rápido, directs the user to home page"
	test ACT19OptionIsDisplayed {
		task ("Given user go to 'ACT 2019' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "ACT 2019",
				widgetName = "Acesso rápido");
		}

		task ("Then the user is redirected to another page") {
			Default.SelectWindow(locator1 = "Google");

			PetrobrasUtils.viewURL(partialUrl = "google.com");
		}
	}

	@description = "Verify that the admin user has access to the 'Control Panel' menu in the side menu"
	test AdminUserHasAccessToControlPanel {
		task ("Given user login an account as admin role") {
			Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");
		}

		task ("Then Control Panel portlet is displayed") {
			Default.AssertElementPresent(locator1 = "HomePage#CONTROL_PANEL");
		}
	}

	@description = "Verify that the user can add a new highlighted image"
	test CanAddHighlightedImage {
		task ("Given user wants to add a featured image") {
			Default.MouseOver(
				key_index = "1",
				locator1 = "HomePage#FEATURED_IMAGE");

			Default.Click(
				key_widgetClass = "ptb-featured-image",
				locator1 = "Button#BUTTON_PLUS_WIDGET");

			Default.Click(
				key_tagLib = "Home - Imagem destaque",
				locator1 = "Button#SPAN_BUTTON_TAGLIB");

			IFrame.selectModalFrame();
		}

		task ("And given that the fields were filled in") {
			Default.Type(
				key_fieldLabel = "Título",
				locator1 = "TextInput#GENERIC_TEXT_INPUT",
				value1 = "Test Image");

			Default.Click(
				key_buttonName = "Selecionar",
				locator1 = "Button#BUTTON_SPAN");

			IFrame.selectFrameTop();

			IFrame.selectNoLoadingModalFrame();

			var filePath = PetrobrasUtils.getFilePath(fileName = "liferay.jpeg");

			Default.UploadFile(
				locator1 = "TextInput#FILE",
				value1 = "${filePath}");

			IFrame.selectFrameTop();

			Default.Click(locator1 = "Button#BUTTON_ADD");
		}

		task ("When the user publish the image") {
			IFrame.selectModalFrame();

			Default.Click(locator1 = "Button#BUTTON_PUBLICAR");
		}

		task ("Then the image is displayed on carousel") {
			IFrame.selectFrameTop();

			Default.AssertElementPresent(
				key_contentName = "test-image",
				locator1 = "HomePage#FEATURED_IMAGE_BY_NAME");
		}
	}

	@description = "Verify that the user can add a new in the Carousel"
	test CanAddNewNewsInCarousel {
		task ("Given user add a new news") {
			HomePage.addNewNewsOnCarousel(
				newsTitle = "Test Carousel News",
				tagLib = "Notícias Corporativas (Carrossel)",
				widgetClass = "carousel");
		}

		task ("Then the news is displayed on home page carousel") {
			Default.Refresh();

			HomePage.assertNewsOnCarousel(newsName = "Test Carousel News");
		}
	}

	@description = "Verify that the carousel news is displayed on page"
	test CarouselNewsIsDisplayed {
		task ("Assert that carousel new is displayed on home page") {
			Default.AssertElementPresent(locator1 = "HomePage#NEWS_CAROUSEL");
		}
	}

	@description = "Verify that the option 'Compromisso com a vida', displayed on Acesso Rápido, directs the user to the page Refino"
	test CompromissoVidaOptionIsDisplayed {
		task ("Given user go to 'ompromisso com a vida' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "Compromisso com a vida",
				widgetName = "Acesso rápido");
		}

		task ("Then the user is redirected to another page") {
			PetrobrasUtils.viewURL(partialUrl = "group/petrobras-intranet/nossos-negocios/refino");
		}
	}

	@description = "Verify that the option 'EVA', displayed on Acesso Rápido, directs the user to the page EVA"
	test EvaOptionIsDisplayed {
		task ("Given user go to 'EVA' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "EVA",
				widgetName = "Acesso rápido");
		}

		task ("Then the user is redirected to another page") {
			PetrobrasUtils.viewURL(partialUrl = "group/petrobras-intranet/sobre-nos/modelo-de-gestao-petrobras/eva");
		}
	}

	@description = "Verify that the widget for highlighted images is displayed"
	test FeaturedImageIsDisplayed {
		task ("Assert that highlited image widget is displayed on home page") {
			Default.AssertElementPresent(
				key_index = "1",
				key_contentName = "google.com",
				locator1 = "HomePage#FEATURED_IMAGE_BY_NAME");
		}
	}

	@description = "Verify that the Mega Menu is displayed with the options: Sobre Nós, Nossos negócios, Sustentabilidade e Segurança, RH e Você, Tecnologia e serviços, Normas e procedimentos"
	test MegaMenuItemIsDisplayed {
		task ("Assert items on mega menu home page") {
			HomePage.viewMegaMenu(menuItem = "Sobre Nós,Nossos negócios,Sustentabilidade e Segurança,RH e Você,Tecnologia e serviços,Normas e procedimentos");
		}
	}

	@description = "Verify that the Submenus, from the Mega Menu, are displayed"
	test MegaMenuSubItemIsDisplayed {
		task ("Verify sub items on Sobre Nós menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "Sobre Nós",
				subItem = "Nossa estratégia,Nossa marca");
		}

		task ("Verify sub items on Nossos negócios menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "Nossos negócios",
				subItem = "Exploração e produção,Oferta de Gás Natural,Logística e Comercialização");
		}

		task ("Verify sub items on Sustentabilidade e Segurança menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "Sustentabilidade e Segurança",
				subItem = "Segurança,Cultura e Esporte");
		}

		task ("Verify sub items on RH e Você menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "RH e Você",
				subItem = "Carreiras,Universidade Petrobras,Atendimento ao Empregado");
		}

		task ("Verify sub items on Tecnologia e serviços menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "Tecnologia e serviços",
				subItem = "Transformação digital,Sistemas e aplicativos,Serviços");
		}

		task ("Verify sub items on Normas e procedimentos menu are displayed") {
			HomePage.viewMegaMenuSubItem(
				menuItem = "Normas e procedimentos",
				subItem = "Contratação,Financeiro");
		}
	}

	@description = "Verify that the option 'Mobiliza Contínuo', displayed on Acesso Rápido, directs the user to gome page"
	test MobilizaContinuoOptionIsDisplayed {
		task ("Given user go to 'Mobiliza Contínuo' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "Mobiliza Contínuo",
				widgetName = "Acesso rápido");
		}

		task ("Then the user is redirected to another page") {
			Default.SelectWindow(locator1 = "LinkedIn: Log In or Sign Up");

			PetrobrasUtils.viewURL(partialUrl = "linkedin.com");
		}
	}

	@description = "Verify that there is a navegation menu (PRETROBRAS, MÍDIA E NOTÍCIA, INFORMAÇÕES E CONTATO) on the page footer"
	test NavigationMenuIsDisplayedOnPageFooter {
		task ("Check options on Page Footer menu") {
			HomePage.viewPageFooterNavigation(optionName = "Petrobras,Mídia e Notícias,Informações e Contato");
		}
	}

	@description = "Verify that non admin user hasn't access to the 'Control Panel' menu in the side menu"
	test NonAdminUserHasNoAccessToControlPanel {
		task ("Given a new user whitout admin role") {
			PetrobrasUtils.addUser(
				firstName = "user",
				lastName = "a",
				screenName = "usera",
				userIncription = "Portal Petrobras",
				userRole = "Petrobras");
		}

		task ("When login in new user") {
			Login.signOut();

			Login.signIn(userLogin = "usera");
		}

		task ("Then the control panel portlet isn't displayed") {
			Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");

			Default.AssertElementNotPresent(locator1 = "HomePage#CONTROL_PANEL");
		}
	}

	@description = "Verify that the option 'PE 240 / PNG 2019-2023', displayed on Acesso Rápido, directs the user to the page Exploração e produção"
	test PE240PNG20192023OptionIsDisplayed {
		task ("Given user go to 'PE 240 / PNG 2019-2023' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "PE 240 / PNG 2019-2023",
				widgetName = "Acesso rápido");
		}

		task ("Then the user is redirected to another page") {
			PetrobrasUtils.viewURL(partialUrl = "group/petrobras-intranet/nossos-negocios/explora%C3%A7ao-e-produ%C3%A7ao");
		}
	}

	@description = "Verify that the option 'Petrobras Compliance', displayed on Acesso Rápido, directs the user to the page Oferta de Gás Natural"
	test PetrobrasComplianceOptionIsDisplayed {
		task ("Given user go to 'Petrobras em Compliance' on 'Acesso rápido' wiget") {
			HomePage.goToHomePageWidgetItem(
				optionName = "Petrobras em Compliance",
				widgetName = "Acesso rápido");
		}

		task ("Then the control panel portlet isn't displayed") {
			PetrobrasUtils.viewURL(partialUrl = "group/petrobras-intranet/nossos-negocios/oferta-e-gas-natural");
		}
	}

	@description = "Verify that the Search bar is displayed"
	test SearchBarIsDisplayed {
		task ("Assert Search bar is displayed in home page") {
			Default.AssertElementPresent(locator1 = "HomePage#SEARCH_BAR");
		}
	}

	@description = "Verify that the side bar is displayed with options 'Aplicativos, Lope, Links'"
	test SideBarOptionsAreDisplayed {
		task ("Assert options 'Apps', 'Lope' and 'Links' are displayed on Side Bar portlet") {
			HomePage.viewSideBarPortlet(optionName = "Apps,Lope,Links");
		}
	}

	@description = "Verify that the user can watch the video through the streaming server"
	test VideoCanBeWatchedOnHomePage {
		task ("Given user play the video") {
			HomePage.clickOnVideo();
		}
		
		task ("Then the video start") {
			HomePage.viewVideoStatus(videoStatus = "playing");
		}
	}

	@description = "Verify that the widget 'Acesso Rápido' is displayed"
	test WidgetAcessoRapidoIsDisplayed {
		task ("Assert Acesso Rápido widget is displayed in home page") {
			HomePage.viewHomePageWidget(widgetName = "Acesso rápido");
		}
	}

	@description = "Verify that the widget for highlighted events 'Calendário corporativo' is displayed"
	test WidgetCalendarioCorporativoIsDisplayed {
		task ("Assert Calendário corporativo widget is displayed in home page") {
			HomePage.viewHomePageWidget(widgetName = "Calendário corporativo");
		}
	}

	@description = "Verify that the widget 'Enquete' is displayed"
	test WidgetEnqueteIsDisplayed {
		task ("Assert Enquete widget is displayed in homepage") {
			HomePage.viewHomePageWidget(widgetName = "Enquete");
		}
	}

	@description = "Verify that the Portlet Social Network (Nas Redes Sociais) is displayed"
	test WidgetNasRedesSociaisIsDisplayed {
		task ("Assert Nas Redes Sociais widget is displayed in home page") {
			HomePage.viewHomePageWidget(widgetName = "Nas Redes Sociais");
		}
	}

	@description = "Verify that widget news is displayed: 'Para você'"
	test WidgetParaVoceIsDisplayed {
		task ("Assert Para você widget is displayed in home page") {
			HomePage.viewHomePageWidget(widgetName = "Para você");
		}
	}

	@description = "Verify that the widget for video display 'Vídeos em Destaque' is displayed"
	test WidgetVideosEmDestaqueIsDisplayed {
		task ("Assert Vídeos em Destaque widget is displayed in home page") {
			HomePage.viewHomePageWidget(widgetName = "vídeos em destaque");
		}
	}

}