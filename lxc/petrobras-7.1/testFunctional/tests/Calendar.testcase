definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that the user can add an event on Calendar"
	test CandAddEvent {
		task ("Given user go to calendar page") {
			Calendar.goToCalendar();
		}

		task ("When add a new calendar event") {
			Calendar.addCalendarEvent();
		}

		task ("Then the new event is displayed") {
			Calendar.assertEvent(eventName = "Jantar na casa do Brian");
		}
	}

	@description = "Verify that an added event is displayed in the homepage Calendar widget"
	test EventIsDisplayedOnCalendarWidget {
		task ("Given user go to calendar page") {
			Calendar.goToCalendar();
		}

		task ("When add a new calendar event") {
			Calendar.addCalendarEvent();
		}

		task ("Then the new event is displayed in home page") {
			PetrobrasUtils.launchPortal();

			Calendar.assertCalendarEvent(eventName = "Jantar na casa do Brian");
		}
	}

}