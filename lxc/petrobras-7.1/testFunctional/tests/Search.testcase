definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that, when the search does not return results, it displays the message '0 resultados para'"
	test NoResultMessage {
		task ("Search 'Liferay'") {
			Search.searchEmbedded(searchTerm = "Liferay");
		}

		task ("Assert no results message") {
			Search.noResults(searchTerm = "Liferay");
		}
	}

	@description = "Verify that when the user search a user key the Resultados da Pesquisa page displays the tab Pessoas with the iframe pointing to 'localizadorpessoas.petrobras.com.br'"
	test PessoasTabPointSpecificFrame {
		task ("Search user") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Assert localizador de pessoas frame is present") {
			Default.Click(locator1 = "Search#SEARCH_PEOPLE_FRAME");
		}
	}

	@description = "Verify that the 'Resultados da Pesquisa' page displays the search result tab 'Portal'"
	test PortalTabIsDisplayed {
		task ("Go to search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Assert Portal tab is displayed") {
			Search.SelectSearchTab(tabName = "Portal");
		}
	}

		task ("Assert portal tab is displayed") {
			Default.AssertElementPresent(
				key_tabName = "Portal",
				locator1 = "Search#NAV_LINK_TAB");
		}

		task ("Assert pessoas tab is displayed") {
			Default.AssertElementPresent(
				key_tabName = "Pessoas",
				locator1 = "Search#NAV_LINK_TAB");
		}

		task ("Assert aplicações petrobras tab is displayed") {
			Default.AssertElementPresent(
				key_tabName = "Aplicações Petrobras",
				locator1 = "Search#NAV_LINK_TAB");
		}

		task ("Assert padrões tab is displayed") {
			Default.AssertElementPresent(
				key_tabName = "Padrões",
				locator1 = "Search#NAV_LINK_TAB");
		}
	}

	@description = "Verify that the user can filter the search results using the filters 'Todos, Notícias, Páginas, Data da Publicação, Editoriais'"
	test UserCanFilterResult {
		task ("Search 'Petrobras'") {
			Default.Type(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "Petrobras");

			Default.KeyPress(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "\ENTER");
		}

		task ("Go to filter and assert that the content filter is active") {
			Default.Click(
				key_filterName = "Todos",
				locator1 = "Search#FILTER_TAB_2");

			Default.AssertElementPresent(
				key_filterName = "Todos",
				locator1 = "Search#FILTER_ACTIVE");

			Default.Click(
				key_filterName = "Notícia",
				locator1 = "Search#FILTER_TAB");

			Default.AssertElementPresent(
				key_filterName = "Notícia",
				locator1 = "Search#FILTER_ACTIVE");

			Default.Click(
				key_filterName = "Páginas",
				locator1 = "Search#FILTER_TAB");

			Default.Click(
				key_tabName = "Portal",
				locator1 = "Search#NAV_LINK_TAB");

			Default.AssertElementPresent(
				key_filterName = "Páginas",
				locator1 = "Search#FILTER_ACTIVE");
		}

		task ("Search 'Petrobras'") {
			Default.Type(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "Petrobras");

			Default.KeyPress(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "\ENTER");
		}

		task ("Select Data da Publicação filter and assert that is active") {
			Default.Click(
				key_filterButton = "publishdate",
				locator1 = "Search#DROPDOWN_FILTER");

			Default.Click(
				key_dropdownItem = "Últimos 365 dias",
				key_filterButton = "publishdate",
				locator1 = "Search#DROPDOWN_FILTER_ITEM");

			Default.Pause(locator1 = "2000");

			Default.Click(
				key_tabName = "Portal",
				locator1 = "Search#NAV_LINK_TAB");

			Default.AssertElementPresent(
				key_itemName = "Últimos 365 dias",
				locator1 = "Search#DROPDOWN_MENU");

			Default.Click(
				key_filterButton = "publishdate",
				locator1 = "Search#DROPDOWN_FILTER");

			Default.Click(
				key_dropdownItem = "Limpar",
				key_filterButton = "publishdate",
				locator1 = "Search#DROPDOWN_FILTER_ITEM");

			Default.Pause(locator1 = "1000");
		}

		task ("Active Editorias filter and assertt that is active") {
			Default.Click(
				key_filterButton = "editorias",
				locator1 = "Search#DROPDOWN_FILTER");

			Default.Click(
				key_dropdownItem = "Gente",
				key_filterButton = "editorias",
				locator1 = "Search#DROPDOWN_FILTER_ITEM");

			Default.AssertElementPresent(
				key_itemName = "Gente",
				locator1 = "Search#DROPDOWN_MENU");
		}
	}

}