definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that the 'Resultados da Pesquisa' page displays the search result tab 'Aplicações Petrobras'"
	test AplicacoesPetrobrasTabIsDisplayed {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the tab 'Aplicações Petrobras' is displayed in search results") {
			Search.SelectSearchTab(tabName = "Aplicações Petrobras");
		}
	}

	@description = "Verify that the user can filter the search results using the filter 'Data da Publicação'"
	test CanFilterByDataPublicacao {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the filter 'Últimos 365 dias' in 'Data da Publicação' dropdown is displayed and can be selected") {
			Search.selectDropdownFilters(
				filterItem = "Últimos 365 dias",
				filterType = "publishdate");
		}
	}

	@description = "Verify that the user can filter the search results using the filter 'Editorias'"
	test CanFilterByEditoriais {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the filter 'Gente' in 'Editorias' dropdown is displayed and can be selected") {
			Search.selectDropdownFilters(
				filterItem = "Gente",
				filterType = "editorias");
		}
	}

	@description = "Verify that the user can filter the search results using the filter 'Notícias'"
	test CanFilterByNoticias {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the filter 'Notícia' is displayed and can be selected") {
			Search.selectNewsFilterTab(filterName = "Notícia");

			Default.AssertElementPresent(
				key_tagName = "Notícia",
				locator1 = "Search#SEARCH_TAG");

		}
	}

	@description = "Verify that the user can filter the search results using the filter 'Páginas'"
	test CanFilterByPaginas {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the filter 'Páginas' is displayed and can be selected") {
			Search.selectNewsFilterTab(filterName = "Páginas");
		}
	}

	@description = "Verify that the user can filter the search results using the filter 'Todos'"
	test CanFilterByTodos {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the tab 'Todos' is displayed in search results") {
			Search.selectNewsFilterTab(filterName = "Todos");
		}
	}

	@description = "Verify that, when the search does not return results, it displays the message '0 resultados para'"
	test NoResultMessage {
		task ("Given that user performs a search without context") {	
			Search.searchEmbedded(searchTerm = "Progresso");
		}

		task ("Then no results will be shown") {
			Default.AssertElementPresent(
				key_searchValue = "Progresso",
				locator1 = "Search#NO_RESULT");
		}
	}

	@description = "Verify that the 'Resultados da Pesquisa' page displays the search result tab 'Padrões'"
	test PadroesTabIsDisplayed {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the tab 'Padrões' is displayed and can be selected") {
			Search.SelectSearchTab(tabName = "Padrões");
		}
	}

	@description = "Verify that the 'Resultados da Pesquisa' page displays the search result tab 'Pessoas'"
	test PessoasTabIsDisplayed {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the tab 'Pessoas' is displayed and can be selected") {
			Search.SelectSearchTab(tabName = "Pessoas");
		}
	}

	@description = "Verify that when the user search a user key the Resultados da Pesquisa page displays the tab Pessoas with the iframe pointing to 'localizadorpessoas.petrobras.com.br'"
	test PessoasTabPointSpecificFrame {
		task ("Given that user search a user key") {
			Search.searchEmbedded(searchTerm = "e3bl");

			Default.Click(
			key_tabName = "Pessoas",
			locator1 = "Search#NAV_LINK_TAB");
		}

		task ("Then the tab 'Pessoas' point 'Localizador de pessoas' frame") {
			Default.Click(locator1 = "Search#SEARCH_PEOPLE_FRAME");
		}
	}

	@description = "Verify that the 'Resultados da Pesquisa' page displays the search result tab 'Portal'"
	test PortalTabIsDisplayed {
		task ("Given that user performs a search") {
			Search.searchEmbedded(searchTerm = "Petrobras");
		}

		task ("Then the tab 'Portal' is displayed and can be selected") {
			Search.SelectSearchTab(tabName = "Portal");
		}
	}

	@description = "Verify that, when the user search a user key, the autocomplete suggestion box displays 'Sem Resultados'"
	test SuggestionBoxDisplaysNoResult {
		task ("Given that user search a user key") {
			Default.Type(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "e3bl");
		}

		task ("Then no suggestion will be displayed") {
			Default.AssertElementPresent(
				locator1 = "Search#NO_SUGGESTION_AUTOCOMPLETE",
				value1 = "Sem Resultados.");
		}
	}

	@description = "Verify that, when the user search any word, the autocomplete suggestion box displays related Web Contents"
	test SuggestionBoxDisplaysWebContents {
		task ("Given that user performs a search") {
			Default.Type(
				locator1 = "HomePage#SEARCH_BAR",
				value1 = "Petrobras");
		}

		task ("Then Web Content suggestions will be displayed") {
			Default.AssertElementPresent(locator1 = "Search#WC_SUGGESTION_AUTOCOMPLETE");
		}
	}

}