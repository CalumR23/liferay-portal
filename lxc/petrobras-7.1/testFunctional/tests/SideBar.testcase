definition {
    setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

    @description = "Verify that the menu Aplicativos displays the tabs 'Seus Favoritos, Recomendados, Todos'"
	test SideBarMenuIsDisplayed {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "App");
			
            SideBar.selectSideBarFrame();
		}

        task ("Assert Seus Favoritos tab is displayed") {
            Default.AssertElementPresent(
                locator1 = "SideBar#NAV_BAR",
                key_navItem = "Seus Favoritos");
        }

        task ("Assert Recomendados tab is displayed") {
            Default.AssertElementPresent(
                locator1 = "SideBar#NAV_BAR",
                key_navItem = "Recomendados");
        }

        task ("Assert Todos tab is displayed") {
            Default.AssertElementPresent(
                locator1 = "SideBar#NAV_BAR",
                key_navItem = "Todos");
        }
    }

    @description = "Verify that, when the user choose an application on Todos tab it is displayed on Seus Favoritos tab"
	test FavoritedItemIsDisplayedOnTodos {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "App");
			
            SideBar.selectSideBarFrame();
		}

        task ("Go to Todos tab and favorite MS OFFICE") {
            SideBar.goToSideBarTab(navItem = "Todos");

            SideBar.favoriteItem(
                itemName = "MS OFFICE",
                itemState = "false");
        }

        task ("Assert MS OFFICE is favorited") {
            Default.AssertElementPresent(
                locator1 = "SideBar#ADD_OR_REMOVE_FAVORITE_ITEM",
                key_itemName = "MS OFFICE",
                key_itemState = "true");
        }

        task ("Go to Seus Favoritos and assert that MS OFFICE is displayed on this tab") {
            SideBar.goToSideBarTab(navItem = "Seus Favoritos");

            SideBar.favoriteItemOnTab(itemName = "MS OFFICE");
        }
    }

    @description = "Verify that the resulting user list from the Lope search will be displayed on the 'Fragmento de Busca Lope Petrobras'"
	test UserSearchDisplayEspecificPortletTest {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "Lope");
			
            SideBar.selectSideBarFrame();
		}
        
        task ("Search user") {
            Default.Type(
			locator1 = "SideBar#SIDE_BAR_SEARCH",
			value1 = "Afonso");

            Default.KeyPress(
                locator1 = "SideBar#SIDE_BAR_SEARCH",
                value1 = "\ENTER");
        }

        task ("Assert search portlet") {
            HomePage.assertPortletName(portletName = "Fragmento de Busca Lope Petrobras");
        }
    }

    @description = "Verify that the user can Lope option to search people"
	test UserCanSerachPeopleOnLope {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "Lope");
			
            SideBar.selectSideBarFrame();
		}
        
        task ("Search user") {
            Default.Type(
			locator1 = "SideBar#SIDE_BAR_SEARCH",
			value1 = "People");

            Default.KeyPress(
                locator1 = "SideBar#SIDE_BAR_SEARCH",
                value1 = "\ENTER");
        }

        task ("Assert localizador de pessoas frame is present") {
            Default.Click(locator1 = "Search#SEARCH_PEOPLE_FRAME");
        }
    }

    @description = "Verify that the user can search Links"
	test UserCanSearchLink {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "Links");
			
            SideBar.selectSideBarFrame();
		}

        task ("Search link") {
            SideBar.searchLink(searchValue = "1");
        }

        task ("Assert link is displayed") {
            SideBar.searchResultsNumber(resultMessage = "Exibindo 1 resultado.");

            SideBar.searchResult(
                itemLink = "1",
                itemName = "google.com");
        }

    }

    @description = "Verify that the user can add Links"
	test UserCanAddLink {
        task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "Links");
			
            SideBar.selectSideBarFrame();
		}

        task ("Add link") {
            Default.Click(locator1 = "SideBar#ADD_LINK_BUTTON");

            Default.Type(
                locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
                fieldName = "Insira um nome",
                value1 = "Test Link");

            Default.Type(
                locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
                fieldName = "Insira o endereço do link",
                value1 = "testlink.com");

            Default.Click(locator1 = "SideBar#CHECK_ICON");
        }

        task ("Search link") {
            SideBar.searchLink(searchValue = "Test Link");
        }

        task ("Assert link is displayed") {
            SideBar.searchResultsNumber(resultMessage = "Exibindo 1 resultado.");

            SideBar.searchResult(
                itemLink = "testlink.com",
                itemName = "Test Link");
        }

    }

    @description = "Verify that the user can remove Links"
	test UserCanRemoveLink {
         task ("Go to side bar") {
            SideBar.goToSideBarItem(optionName = "Links");
			
            SideBar.selectSideBarFrame();
		}

        task ("Add link") {
            Default.Click(locator1 = "SideBar#ADD_LINK_BUTTON");

            Default.Type(
                locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
                fieldName = "Insira um nome",
                value1 = "Test Link");

            Default.Type(
                locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
                fieldName = "Insira o endereço do link",
                value1 = "testlink.com");

            Default.Click(locator1 = "SideBar#CHECK_ICON");
        }

        task ("Search and delete link") {
            SideBar.searchLink(searchValue = "Test Link");

            Default.Click(
                locator1 = "SideBar#REMOVE_ICON",
                key_itenName = "Test Link");
        }

        task ("Search link") {
            SideBar.searchLink(searchValue = "Test Link");
        }

        task ("Assert link is not displayed") {
            SideBar.searchResultsNumber(resultMessage = "Não há resultados.");

            SideBar.searchResult(
                itemLink = "testlink.com",
                temName = "Test Link");
        }

    }

}