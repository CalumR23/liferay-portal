definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that the user can add Links"
	test CanAddLink {
		task ("Given a link is created on sidebar") {
			SideBar.goToSideBarItem(optionName = "Links");

			SideBar.selectSideBarFrame();

			SideBar.addLink(
				linkName = "Test1 Link",
				linkUrl = "test1link.com");
		}

		task ("Then the link is displayed") {
			Portal.Alert.viewSuccessMessage();

			SideBar.assertLink(
				itemLink = "test1link.com",
				itemName = "Test1 Link");
		}
	}

	@description = "Verify that the user can edit Links"
	test CanEditLink {
		task ("Given a link is created on sidebar") {
			SideBar.goToSideBarItem(optionName = "Links");

			SideBar.selectSideBarFrame();

			SideBar.addLink(
				linkName = "Test2 Link",
				linkUrl = "test2link.com");

			Default.Refresh();
		}

		task ("When user edit the created link") {
			SideBar.goToSideBarItem(optionName = "Links");

			SideBar.selectSideBarFrame();

			SideBar.searchLink(searchValue = "Test2 Link");

			Default.Click(
				key_itemName = "Test2 Link",
				locator1 = "SideBar#EDIT_ICON");

			Default.Type(
				key_linkField = "Test2 Link",
				locator1 = "SideBar#INPUT_EDIT_LINK_NAME",
				value1 = "Edited Test2 Link");

			Default.Type(
				key_linkField = "test2link.com",
				locator1 = "SideBar#INPUT_EDIT_LINK_NAME",
				value1 = "editedtest2link.com");

			Default.Click(
				key_itemName = "Test2 Link",
				locator1 = "SideBar#CHECK_ICON_DIV");
		}

		task ("Then the link is updated with the new values") {
			SideBar.searchLink(searchValue = "Edited Test2 Link");

			SideBar.searchResultsNumber(resultMessage = "Exibindo 1 resultado.");

			SideBar.assertLink(
				itemLink = "editedtest2link.com",
				itemName = "Edited Test2 Link");
		}
	}

	@description = "Verify that the user can remove Links"
	test CanRemoveLink {
		task ("Given a link is created on sidebar") {
			SideBar.goToSideBarItem(optionName = "Links");

			SideBar.selectSideBarFrame();

			SideBar.addLink(
				linkName = "Test3 Link",
				linkUrl = "test3link.com");
		}

		task ("When the created link is deleted") {
			SideBar.searchLink(searchValue = "Test3 Link");

			Default.Click(
				key_itemName = "Test3 Link",
				locator1 = "SideBar#REMOVE_ICON");
		}

		task ("Then the link is no longer displayed") {
			SideBar.searchLink(searchValue = "Test3 Link");

			SideBar.searchResultsNumber(resultMessage = "Não há resultados.");
		}
	}

	@description = "Verify that the user can search Links"
	test CanSearchLink {
		task ("Given a link is created on sidebar") {
			SideBar.goToSideBarItem(optionName = "Links");

			SideBar.selectSideBarFrame();

			SideBar.addLink(
				linkName = "Test4 Link",
				linkUrl = "test4link.com");
		}

		task ("Then the link is displayed on search results") {
			SideBar.searchLink(searchValue = "Test4 Link");

			SideBar.searchResultsNumber(resultMessage = "Exibindo 1 resultado.");

			SideBar.assertLink(
				itemLink = "test4link.com",
				itemName = "Test4 Link");
		}
	}

	@description = "Verify that the user can Lope option to search people"
	test CanSerachPeopleOnLope {
		task ("Given a people is searched on 'Lope' side bar option") {
			SideBar.goToSideBarItem(optionName = "Lope");

			SideBar.selectSideBarFrame();

			SideBar.searchUser(userName = "People");
		}

		task ("Then the user is redirected to search results page and 'Pessoas' tab, that point 'Localizador de pessoas' frame") {
			Default.Click(locator1 = "Search#SEARCH_PEOPLE_FRAME");
		}
	}

	@description = "Verify that, when the user choose an application on Todos tab it is displayed on Seus Favoritos tab"
	test FavoritedItemIsDisplayedOnTodos {
		task ("Given user go to 'App' sidebar option and favorite a item") {
			SideBar.goToSideBarItem(optionName = "App");

			SideBar.selectSideBarFrame();
		}

		task ("When the user favorite a item") {
			SideBar.goToSideBarTab(navItem = "Todos");

			SideBar.favoriteItem(
				itemName = "MS OFFICE",
				itemState = "false");

			Default.AssertElementPresent(
				key_itemName = "MS OFFICE",
				key_itemState = "true",
				locator1 = "SideBar#ADD_OR_REMOVE_FAVORITE_ITEM");
		}

		task ("Then the item is displayed in 'Seus Favoritos' tab") {
			SideBar.goToSideBarTab(navItem = "Seus Favoritos");

			SideBar.favoriteItemOnTab(itemName = "MS OFFICE");
		}
	}

	@description = "Verify that the menu Aplicativos displays the tab 'Recomendados'"
	test RecomendadosOptionIsDisplayed {
		task ("Given user go to 'App' sidebar option") {
			SideBar.goToSideBarItem(optionName = "App");

			SideBar.selectSideBarFrame();
		}

		task ("Then 'Recomendados' tab is displayed") {
			Default.AssertElementPresent(
				key_navItem = "Recomendados",
				locator1 = "SideBar#NAV_BAR");
		}
	}

	@description = "Verify that the resulting user list from the Lope search will be displayed on the 'Fragmento de Busca Lope Petrobras'"
	test SearchDisplayEspecificPortletTest {
		task ("Given user go to 'Lope' sidebar option") {
			SideBar.goToSideBarItem(optionName = "Lope");

			SideBar.selectSideBarFrame();
		}

		task ("When the user search any word") {
			SideBar.searchUser(userName = "People");
		}

		task ("Then is redirected to a page with 'Fragmento de Busca Lope Petrobras' portlet") {
			Default.AssertElementPresent(
				key_portletName = "Fragmento de Busca Lope Petrobras",
				locator1 = "HomePage#PORTLET_NAME");
		}
	}

	@description = "Verify that the menu Aplicativos displays the tab 'Seus Favoritos'"
	test SeusFavoritosOptionIsDisplayed {
		task ("Given user go to 'App' sidebar option") {
			SideBar.goToSideBarItem(optionName = "App");

			SideBar.selectSideBarFrame();
		}

		task ("Then 'Seus Favoritos' tab is displayed") {
			Default.AssertElementPresent(
				key_navItem = "Seus Favoritos",
				locator1 = "SideBar#NAV_BAR");
		}
	}

	@description = "Verify that the menu Aplicativos displays the tab 'Todos'"
	test TodosOptionIsDisplayed {
		task ("Given user go to 'App' sidebar option") {
			SideBar.goToSideBarItem(optionName = "App");

			SideBar.selectSideBarFrame();
		}

		task ("Then 'Todos' tab is displayed") {
			Default.AssertElementPresent(
				key_navItem = "Todos",
				locator1 = "SideBar#NAV_BAR");
		}
	}

}