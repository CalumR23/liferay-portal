<html>
<head>
<title>Login</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Login</td></tr>
</thead>

<tbody>

<!-- LOGIN FIELDS -->
<tr>
	<td>USERNAME_LOGIN_FIELD</td>
	<td>//input[contains(@id,'LoginPortlet_login')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_LOGIN_FIELD</td>
	<td>//input[contains(@id,'LoginPortlet_password')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTRAR_BUTTON</td>
	<td>//button[contains(.,'Entrar')] | //input[@value='Entrar']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>