<html>
<head>
<title>Search</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Search</td></tr>
</thead>

<tbody>

<tr>
	<td>SEARCH_PEOPLE_FRAME</td>
	<td>//iframe[contains(@src,'localizadorpessoas.petrobras.com.br')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_LINK_TAB</td>
	<td>//a[contains(@class,'nav-link') and contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_LINK_TAB_ACTIVE</td>
	<td>//a[contains(@class,'nav-link active') and contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_TAB</td>
	<td>//div[contains(@class,'ptb-submenu')]//name[contains(.,'${key_filterName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ALL_FILTER</td>
	<td>//a[contains(@id,'searchAll')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_ACTIVE</td>
	<td>//a[contains(@class,'term-selected') and contains(.,'${key_filterName}')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_RESULT</td>
	<td>//p[contains(@class,'search-total-label') and contains(.,'0 resultados para')]//strong[contains(.,'${key_searchValue}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_FILTER</td>
	<td>//div[contains(@class,'ptb-submenu__${key_filterButton}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_FILTER_ITEM</td>
	<td>//div[contains(@class,'ptb-submenu__${key_filterButton}')]//following::a[contains(.,'${key_dropdownItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_MENU</td>
	<td>//ul[contains(@class,'dropdown-menu')]//span[contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_TAG</td>
	<td>//span[contains(@class,'tag-name') and contains(.,'${key_tagName}')]</td>
	<td></td>
</tr>
<tr>
	<td>NO_SUGGESTION_AUTOCOMPLETE</td>
	<td>//div[contains(@class,'autocomplete-no-suggestion')]</td>
	<td></td>
</tr>
<tr>
	<td>WC_SUGGESTION_AUTOCOMPLETE</td>
	<td>//div//span[contains(@class,'category') and contains(.,'Web Content')]//following::div[contains(@class,'autocomplete-suggestion')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>