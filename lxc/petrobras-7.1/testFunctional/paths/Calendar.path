<html>
<head>
<title>Calendar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Calendar</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_EVENT</td>
	<td>//div[contains(@class,'yui3-widget component scheduler-view scheduler-view-day scheduler-view-week scheduler-week-view')]</td>
	<td></td>
</tr>
<tr>
	<td>EVENT_NAME</td>
	<td>//div[contains(@class,'scheduler-event-content') and contains(.,'${key_eventName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_EVENT_NAME</td>
	<td>//div[contains(@class,'calendar_event') and contains(.,'${key_eventName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>