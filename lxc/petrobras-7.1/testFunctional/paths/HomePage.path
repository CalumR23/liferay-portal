<html>
<head>
<title>HomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">HomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>PAGE_TITLE</td>
	<td>//span[contains(@data-qa-id,'headerTitle') and contains(.,'${key_pageTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_LINK</td>
	<td>//a[contains(@class,'nav-link') and contains(@id,'${key_navItem}')]</td>
	<td></td>
</tr>

<!-- MEGA MENU -->
<tr>
	<td>MEGA_MENU_ITEM</td>
	<td>//div[contains(@class,'ptb-mega-menu__wrapper')]//ul//li//a[contains(.,'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>MEGA_MENU_SUB_ITEM</td>
	<td>//div[contains(@class,'ptb-mega-menu__wrapper')]//ul//li//a[contains(.,'${key_menuItem}')]//following::a[contains(.,'${key_subItem}')]</td>
	<td></td>
</tr>

<!-- SEARCH BAR -->
<tr>
	<td>SEARCH_BAR</td>
	<td>xpath=(//input[contains(@id,'MiniSearchField')])[1]</td>
	<td></td>
</tr>

<!-- NEWS-->
<tr>
	<td>NEWS_ON_LIST</td>
	<td>//div[contains(@class,'ptb-news__title')]//a[contains(@title,'${key_newsName}')]</td>
	<td></td>
</tr>

<!-- NEWS CAROUSEL-->
<tr>
	<td>NEWS_CAROUSEL</td>
	<td>//div[contains(@class,'news-carousel ptb')]</td>
	<td></td>
</tr>
<tr>
	<td>NEWS_ON_CAROUSEL</td>
	<td>//div[contains(@class,'news-carousel')]//h3[contains(@class,'title') and contains(.,'${key_newsName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_IMAGE</td>
	<td>xpath=(//div[contains(@class,'ptb-featured-image')])[${key_index}]</td>
	<td></td>
</tr>

<!-- BUTTON-->
<tr>
	<td>BUTTON_PLUSS_WIDGET</td>
	<td>//div[contains(@class,'${key_widgetClass}')]/../../../..//ancestor::*[contains(@class,'lexicon-icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_PLUSS_WIDGET_BY_NAME</td>
	<td>//div[contains(@class,'portlet-content')]//h2[contains(.,'${key_widgetName}')]/../../../..//ancestor::*[contains(@class,'lexicon-icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>SPAN_BUTTON_TAGLIB</td>
	<td>//span[contains(@class,'taglib-text-icon') and contains(.,'${key_tagLib}')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_PUBLICAR</td>
	<td>//button[span[contains(.,'Publicar')]]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SAVE</td>
	<td>//button[contains(@id,'saveBtn')]</td>
	<td></td>
</tr>

<!-- WIDGETS -->
<tr>
	<td>HOME_PAGE_WIDGET</td>
	<td>//div[contains(@class,'portlet-content')]//h2[contains(.,'${key_widgetName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_WIDGET_OPTION</td>
	<td>//div[contains(@class,'portlet-content')]//h2[contains(.,'${key_widgetName}')]//following::a[contains(.,'${key_optionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_FOOTER_WIDGET</td>
	<td>//div[contains(@class,'ptb-footer')]//h3[contains(.,'${key_optionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_FOOTER_WIDGET_OPTION</td>
	<td>//div[contains(@class,'ptb-footer')]//h3[contains(.,'${key_widgetName}')]//following::a[contains(.,'${key_optionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEE_MORE_BUTTON</td>
	<td>//div//h2[contains(.,'${key_widgetName}')]/../../../../div//a[contains(@class,'btn_link-verde') and contains(.,'${key_buttonName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEGMENTATION_MESSAGE</td>
	<td>//div[contains(@class,'ptb-news__label') and contains(@title,'Notícia segmentada por ${key_segmentationName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEGMENTATION_ICON</td>
	<td>//img[contains(@src,'http://localhost:8080/o/petrobras-intranet-theme/images/noticias/segmentacao/icon-${key_segmentationName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_BAR</td>
	<td>//div[contains(@class,'portlet-content')]//following::a[contains(@data-portlet-name,'Widget_${key_optionName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_LINK</td>
	<td>//div//h2[contains(.,'${key_widgetName}')]/../../../../div//a[contains(@href,'http://localhost:8080/group/petrobras-intranet/${key_pageLink}')]</td>
	<td></td>
</tr>

<!-- SOCIAL NEWTWORK WIDGET -->
<tr>
	<td>SOCIAL_NETWORK_WIDGET</td>
	<td>//div[contains(@class,'${key_socialNetwork}-carousel')]//div//a[contains(@tabindex,'${ket_newsIndex}')]//ancestor::div[contains(@class,'facebook-text')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>