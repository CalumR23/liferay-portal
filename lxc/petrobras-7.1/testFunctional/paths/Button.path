<html>
<head>
<title>Button</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Button</td></tr>
</thead>

<tbody>
<tr>
	<td>BUTTON_PLUS_WIDGET</td>
	<td>//div[contains(@class,'${key_widgetClass}')]/../../../..//ancestor::*[contains(@class,'lexicon-icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_PLUS_WIDGET_BY_NAME</td>
	<td>//div[contains(@class,'portlet-content')]//h2[contains(.,'${key_widgetName}')]/../../../..//ancestor::*[contains(@class,'lexicon-icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SPAN</td>
	<td>//span[contains(@class,'lfr-btn-label') and contains(.,'${key_buttonName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SPAN_BUTTON_TAGLIB</td>
	<td>//span[contains(@class,'taglib-text') and contains(.,'${key_tagLib}')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_PUBLICAR</td>
	<td>//button[span[contains(.,'Publicar')]]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SAVE</td>
	<td>//button[contains(@id,'saveBtn')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_ADD</td>
	<td>//button[@id='addButton']</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_PLUS</td>
	<td>//*[contains(@class,'lexicon-icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SELECTOR</td>
	<td>//*[contains(@class,'selector-button') and contains(@data-entityname,'${key_buttonName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>