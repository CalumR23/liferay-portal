<html>
<head>
<title>General</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>

<tr>
	<td>ACCEPT_CONDITIONS</td>
	<td>//input[@name='packagingConditions']/..//label/sup</td>
	<td></td>
</tr>
<tr>
	<td>ACCEPT_COOKIES</td>
	<td>//div[(@id='onetrust-button-group')]//button[(@id='onetrust-accept-btn-handler')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCEPT_TERMS_CONDITIONS</td>
	<td>//input[@name='termsAndConditions']/..//label/sup</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SUBMIT</td>
	<td>//button[(@type='submit')][contains(text(),'${key_buttonSubmit}')]</td>
	<td></td>
</tr>
<tr>
	<td>CHECKBOX</td>
	<td>//div[contains(@class,'checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER</td>
	<td>//footer[(@class='footer')]</td>
	<td></td>
</tr>
<tr>
	<td>IMAGEM_INITIAL_PAGE</td>
	<td>//div[(@id="fragment-0-ygtq")]//div</td>
	<td></td>
</tr>
<tr>
	<td>PARCEL_OPTION</td>
	<td>//div[contains(@class,'banner__content')]/a[contains(@href,'{$key_parcelOptions}')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_LANGUAGE_BUTTON</td>
	<td>//select[contains(@id,'SiteNavigationLanguage')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>