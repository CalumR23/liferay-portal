<html>
<head>
<title>Maps</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Maps</td></tr>
</thead>

<tbody>

<tr>
	<td>ICON_TYPE_PLACE</td>
	<td>//button[contains(@class,'without-arrow')]//i[contains(@class,'type-place')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_INPUT_MAPS</td>
	<td>//div[contains(@class,'search-form-group')]//input[(@id='mapy-cz-search-input')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_RESULT</td>
	<td>xpath=(//span[contains(@class,'result__item-title')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_RESULT_PLACE</td>
	<td>//button[(@type='button')][(text()='Select this place')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>