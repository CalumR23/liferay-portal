<html>
<head>
<title>ParcelForYou</title>
</head>

<body>

<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ParcelForYou</td></tr>
</thead>

<tbody>
<tr>
	<td>BANNER</td>
	<td>//div[contains(@class,'banner--without-img')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_SEND_A_PARCEL</td>
	<td>//div[(@id='fragment-34-gknv')]//a[(@id='custom-btn-gknv')]</td>
	<td></td>
</tr>
<tr>
	<td>CODE_BANK</td>
	<td>//select[@name='codBankCode']</td>
	<td></td>
</tr>
<tr>
	<td>CODE_BANK_INDEX</td>
	<td>xpath=(//select[@name='codBankCode']//option)[2]</td>
	<td></td>
</tr>
<tr>
	<td>DATE_PICKUP_INPUT</td>
	<td>//div[contains(@class,'input-container')]//input[(@name='pickupDate')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_DATE_PICKUP</td>
	<td>xpath=(//div[contains(@class,'week')]//div[contains(@aria-disabled,'false')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>PACKAGE_SIZE</td>
	<td>//div[contains(@class,'radio-selection')]//*[(text()='${key_packageSize}')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECTION_OVERVIEW</td>
	<td>//div[(@class='selection-overview')]//div[contains(@class,'list')]//div//span[contains(text(),"${key_selectionOverviewList}")]</td>
	<td></td>
</tr>
<tr>
	<td>SELECTION_RADIO_WRAPPER</td>
	<td>xpath=(//div[contains(@class,'radio-selection')]//div[contains(@class,'order-md-1')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SEND_SHIPMENTS</td>
	<td>xpath=(//div[(@class='banner__item')]//a[contains(text(),'Find out more')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SENDER_OR_RECIPIENT</td>
	<td>//div//*[contains(@class,'font-weight-medium')][text()='${key_senderOrRecipient}']</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_SENDER_ADDRESS</td>
	<td>//input[(@name='senderAddress.${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_RECIPIENT_ADDRESS</td>
	<td>//input[(@name='recipientAddress.${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_DATA_BANK</td>
	<td>//input[(@name='cod${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_TYPE</td>
	<td>//a[contains(text(),'${key_userType}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_OVERVIEW_ADDRESS</td>
	<td>//div//*[contains(@class,'font-weight-medium')]/following::div[contains(text(),'${key_Address}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_OVERVIEW_NAME</td>
	<td>//div//*[contains(@class,'font-weight-medium')]/following::div[contains(text(),'${key_Name}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_OVERVIEW_EMAIL</td>
	<td>//div//*[contains(@class,'font-weight-medium')]/following::span[(text()='${key_email}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_OVERVIEW_PHONE</td>
	<td>//div//*[contains(@class,'font-weight-medium')]/following::span[(text()='${key_phone}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_OVERVIEW_ADDRESS_RECIPIENT</td>
	<td>//div//*[contains(@class,'font-weight-medium')]/following::div[contains(text(),'${key_addressStreetRecipient}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>