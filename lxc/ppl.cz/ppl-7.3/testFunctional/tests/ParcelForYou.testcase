definition {

	setUp {
		Utils.launchUatHomePage();
	}

	@description = "Automation ID: PPLUPGD1122-34 | Test Summary: Verify that the user can send a parcel using the the options: Large Parcel, PickUp, Address, Cash on delivery"
	@priority = "5"
	test CanSendLargeParcelPickUpAddressAndCash {
		task ("Given that the shipping method is selected and the language is set to English") {
			var addressCity = "Liferay City";
			var addressEmail = "test@liferay.com";
			var addressName = "Test Test";
			var addressPhone = "123456789";
			var addressStreet = "Liferay Street, 99";
			var addresszipCode = "12345";
			var addressNameRecipient = "Test Test Two";
			var addressCityRecipient = "Liferay City";
			var addressZipCodeRecipient = "12345";
			var addressPhoneRecipient = "123456789";
			var addressEmailRecipient = "test@liferay.com";
			var addressStreetRecipient = "Liferay Street,100";

			Menu.gotoMenuItem(menuItem = "Send a parcel");

			ParcelForYou.chooseShippingMethod(index = "1");

			General.acceptCookies();

			General.selectLanguage(language = "en");
		}

		task ("Given the hand over method is set as 'Pick up by courier' ") {
			ParcelForYou.selectPackageSize(packageSize = "Large");

			General.acceptConditions();

			General.submit(buttonSubmit = "Continue");

			ParcelForYou.selectHandOverShipment(index = "2");

			ParcelForYou.selectPickupDate();
		}

		task ("And the sender form is completed and sent") {
			ParcelForYou.fillFormSendShipment(
				addressCity = "${addressCity}",
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				addresszipCode = "${addresszipCode}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("When 'Cash on delivery' is selected and the forms are filled") {
			ParcelForYou.buttonCashOnDelivery();

			ParcelForYou.selectHandOverShipment(index = "2");

			ParcelForYou.fillFormBankCashOnDelivery(
				codBankAccount = "123",
				codeValue = "123");

			ParcelForYou.fillFormRecipientShipment(
				addressCityRecipient = "${addressCityRecipient}",
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}",
				addressStreetRecipient = "${addressStreetRecipient}",
				addressZipCodeRecipient = "${addressZipCodeRecipient}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("Then the sender and recipient information overview is displayed") {
			ParcelForYou.viewSenderInformation(
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				senderOrRecipient = "Sender");

			ParcelForYou.viewRecipientForms(
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}",
				addressStreetRecipient = "${addressStreetRecipient}",
				senderOrRecipient = "Recipient");
		}

		task ("Then the selected items are displayed") {
			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Large");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Pick up by courier");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "To the recipient's address");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Cash on delivery");
		}

		task ("Then the user can pay for the parcel") {
			General.acceptTermsAndConditions();

			General.submit(buttonSubmit = "Pay");
		}
	}

	@description = "Automation ID: PPLUPGD1122-43 | Test Summary: Verify that the user can send a parcel using the the options: Medium Parcel, Parcelshop, Parcelshop, Cash on delivery"
	@priority = "5"
	test CanSendMediumParcel2ParcelShopAndCash {
		task ("Given that the shipping method is selected and the language is set to English") {
			var addressEmail = "test@liferay.com";
			var addressName = "Test Test";
			var addressCity = "Liferay";
			var addressPhone = "123456789";
			var addressStreet = "Liferay Street, 99";
			var addresszipCode = "12345";
			var addressEmailRecipient = "test@liferay.com";
			var addressNameRecipient = "Test Test Two";
			var addressPhoneRecipient = "123456789";
			var addressStreetRecipient = "Sokolská 0";

			Menu.gotoMenuItem(menuItem = "Send a parcel");

			ParcelForYou.chooseShippingMethod(index = "1");

			General.acceptCookies();

			General.selectLanguage(language = "en");
		}

		task ("Given the hand over method is set as 'Drop off at Parcelshop'") {
			ParcelForYou.selectPackageSize(packageSize = "Medium");

			General.acceptConditions();

			General.submit(buttonSubmit = "Continue");

			ParcelForYou.selectHandOverShipment(index = "2");
		}

		task ("And the sender form is completed and sent") {
			ParcelForYou.fillFormSendShipment(
				addressCity = "${addressCity}",
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				addresszipCode = "${addresszipCode}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("When you select the 'Cash on delivery' option and where you intend to deliver the shipment") {
			ParcelForYou.buttonCashOnDelivery();

			ParcelForYou.selectHandOverShipment(index = "2");
		}

		task ("When I choose which Parcelshop you want to deliver") {
			Maps.findPlaceBoxOrShop(
				deliverShipment = "Find Parcelshop",
				mapInput = "1");
		}

		task ("And I fill in the bank details") {
			ParcelForYou.fillFormBankCashOnDelivery(
				codBankAccount = "123",
				codeValue = "84");
		}

		task ("And the recipient form is completed and sent") {
			ParcelForYou.fillFormRecipientShipment(
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("Then the sender and recipient information overview is displayed") {
			ParcelForYou.viewSenderInformation(
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				senderOrRecipient = "Sender");

			ParcelForYou.viewRecipientForms(
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}",
				addressStreetRecipient = "${addressStreetRecipient}",
				senderOrRecipient = "Recipient");
		}

		task ("Then the selected items are displayed") {
			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Medium");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Drop off at Parcelshop");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "To a Parcelshop");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Cash on delivery");
		}

		task ("Then the user can pay for the parcel") {
			General.acceptTermsAndConditions();

			General.submit(buttonSubmit = "Pay");
		}
	}

	@description = "Automation ID: PPLUPGD1122-42 | Test Summary: Verify that the user can send a parcel using the the options: Small Parcel, Parcelbox, ParcelBox, Cash on delivery"
	@priority = "5"
	test CanSendSmallParcel2ParcelBoxAndCash {
		task ("Given that the shipping method is selected and the language is set to English") {
			var addressEmail = "test@liferay.com";
			var addressName = "Test Test";
			var addressCity = "Liferay";
			var addressPhone = "123456789";
			var addressStreet = "Liferay Street, 99";
			var addresszipCode = "12345";
			var addressEmailRecipient = "test@liferay.com";
			var addressNameRecipient = "Test Test Two";
			var addressPhoneRecipient = "123456789";
			var addressStreetRecipient = "Víta Nejedlého 1216/2";

			Menu.gotoMenuItem(menuItem = "Send a parcel");

			ParcelForYou.chooseShippingMethod(index = "1");

			General.acceptCookies();

			General.selectLanguage(language = "en");
		}

		task ("When I chosse the package size") {
			ParcelForYou.selectPackageSize(packageSize = "Small");

			General.acceptConditions();

			General.submit(buttonSubmit = "Continue");
		}

		task ("And that I select the shipping delivery method being 'Put into Parcelbox'") {
			ParcelForYou.selectHandOverShipment(index = "1");
		}

		task ("And the sender form is completed and sent") {
			ParcelForYou.fillFormSendShipment(
				addressCity = "${addressCity}",
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				addresszipCode = "${addresszipCode}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("When I choose which Parcelbox you want to deliver") {
			Maps.findPlaceBoxOrShop(
				deliverShipment = "Find Parcelbox",
				mapInput = "1");
		}

		task ("And I select the 'Cash on delivery' and fill in the bank details") {
			ParcelForYou.buttonCashOnDelivery();

			ParcelForYou.fillFormBankCashOnDelivery(
				codBankAccount = "123",
				codeValue = "84");
		}

		task ("When the recipient form is completed and sent") {
			ParcelForYou.fillFormRecipientShipment(
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}");

			General.submit(buttonSubmit = "Continue");
		}

		task ("Then the sender and recipient information overview is displayed") {
			ParcelForYou.viewSenderInformation(
				addressEmail = "${addressEmail}",
				addressName = "${addressName}",
				addressPhone = "${addressPhone}",
				addressStreet = "${addressStreet}",
				senderOrRecipient = "Sender");

			ParcelForYou.viewRecipientForms(
				addressEmailRecipient = "${addressEmailRecipient}",
				addressNameRecipient = "${addressNameRecipient}",
				addressPhoneRecipient = "${addressPhoneRecipient}",
				addressStreetRecipient = "${addressStreetRecipient}",
				senderOrRecipient = "Recipient");
		}

		task ("Then the selected items are displayed") {
			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Small");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Put into Parcelbox");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "To a Parcelbox");

			ParcelForYou.viewSelectionOverview(selectionOverviewList = "Cash on delivery");
		}

		task ("Then the user can pay for the parcel") {
			General.acceptTermsAndConditions();

			General.submit(buttonSubmit = "Pay");
		}
	}

}