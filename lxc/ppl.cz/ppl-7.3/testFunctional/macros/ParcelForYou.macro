definition {

	@summary = "Choose the type of shipping method shipments"
	macro chooseShippingMethod {
		Default.WaitForVisible(locator1 = "ParcelForYou#BANNER");

		Default.Click(
			key_index = "${index}",
			locator1 = "ParcelForYou#SEND_SHIPMENT");

		Default.MouseOver(locator1 = "ParcelForYou#SEND_PARCEL_BUTTON");

		Default.Click(locator1 = "ParcelForYou#SEND_PARCEL_BUTTON");
	}

	@summary = "Fill out the bank details when selecting 'Cash on delivery' option on the sender's information"
	macro fillFormBankCashOnDelivery {
		Default.Type(
			key_fieldName = "Value",
			locator1 = "ParcelForYou#DATA_BANK",
			value1 = "${codeValue}");

		Default.Type(
			key_fieldName = "BankAccount",
			locator1 = "ParcelForYou#DATA_BANK",
			value1 = "${codBankAccount}");

		var bankName = selenium.getText("ParcelForYou#BANK_CODE_INDEX");

		Default.Select(
			locator1 = "ParcelForYou#BANK_CODE",
			value1 = "${bankName}");
	}

	@summary = "Fill out the recipient shipment form"
	macro fillRecipientShipmentForm {
		Default.Type(
			key_fieldName = "name",
			locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
			value1 = "${addressNameRecipient}");

		Default.Type(
			key_fieldName = "phone",
			locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
			value1 = "${addressPhoneRecipient}");

		Default.Type(
			key_fieldName = "email",
			locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
			value1 = "${addressEmailRecipient}");

		if (isSet(addressStreetRecipient)) {
			Default.Type(
				key_fieldName = "street",
				locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
				value1 = "${addressStreetRecipient}");
		}

		if (isSet(addressCityRecipient)) {
			Default.Type(
				key_fieldName = "city",
				locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
				value1 = "${addressCityRecipient}");
		}

		if (isSet(addressZipCodeRecipient)) {
			Default.Type(
				key_fieldName = "zipCode",
				locator1 = "ParcelForYou#RECIPIENT_ADDRESS",
				value1 = "${addressZipCodeRecipient}");
		}
	}

	@summary = "Fill out the sender shipment form"
	macro fillSenderShipmentForm {
		Default.Type(
			key_fieldName = "name",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addressName}");

		Default.Type(
			key_fieldName = "city",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addressCity}");

		Default.Type(
			key_fieldName = "street",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addressStreet}");

		Default.Type(
			key_fieldName = "zipCode",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addresszipCode}");

		Default.Type(
			key_fieldName = "phone",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addressPhone}");

		Default.Type(
			key_fieldName = "email",
			locator1 = "ParcelForYou#SENDER_ADDRESS",
			value1 = "${addressEmail}");
	}

	@summary = "Select 'cash on delivery' option"
	macro selectCashOnDelivery {
		Default.Click(locator1 = "General#CHECKBOX");
	}

	@summary = "Select the hand over/delivery option"
	macro selectHandOverShipment {
		Default.Click(
			key_index = "${index}",
			locator1 = "ParcelForYou#SELECTION_RADIO_WRAPPER");
	}

	@summary = "Select package size"
	macro selectPackageSize {
		Default.Click.pauseClickAt(
			key_packageSize = "${packageSize}",
			locator1 = "ParcelForYou#PACKAGE_SIZE");
	}

	@summary = "Select a pick up date"
	macro selectPickupDate {
		Default.Click(locator1 = "ParcelForYou#DATE_PICKUP_INPUT");

		Default.Click(locator1 = "ParcelForYou#SELECT_DATE_PICKUP");
	}

	@summary = "View selected item is show in the overview section"
	macro viewItemInOverview {
		Default.AssertElementPresent(
			key_overviewItem = "${overviewItem}",
			locator1 = "ParcelForYou#OVERVIEW_ITEM");
	}

	@summary = "View all recipient information"
	macro viewRecipientForms {
		Default.AssertElementPresent(
			key_senderOrRecipient = "${senderOrRecipient}",
			locator1 = "ParcelForYou#SENDER_OR_RECIPIENT");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressNameRecipient}",
			locator1 = "ParcelForYou#OVERVIEW_INFO");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressStreetRecipient}",
			locator1 = "ParcelForYou#OVERVIEW_INFO");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressEmailRecipient}",
			locator1 = "ParcelForYou#OVERVIEW_INFO");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressPhoneRecipient}",
			locator1 = "ParcelForYou#OVERVIEW_INFO");
	}

	@summary = "View all sender information"
	macro viewSenderInformation {
		Default.WaitForPageLoad();

		Default.AssertElementPresent(
			key_senderOrRecipient = "${senderOrRecipient}",
			locator1 = "ParcelForYou#SENDER_OR_RECIPIENT",
			value1 = "${senderOrRecipient}");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressName}",
			locator1 = "ParcelForYou#OVERVIEW_INFO",
			value1 = "${addressName}");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressStreet}",
			locator1 = "ParcelForYou#OVERVIEW_INFO",
			value1 = "${addressStreet}");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressEmail}",
			locator1 = "ParcelForYou#OVERVIEW_INFO",
			value1 = "${addressEmail}");

		Default.AssertElementPresent(
			key_overviewInfo = "${addressPhone}",
			locator1 = "ParcelForYou#OVERVIEW_INFO",
			value1 = "${addressPhone}");
	}

}