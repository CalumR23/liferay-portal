definition {

	@summary = "Select a cash on delivery option"
	macro buttonCashOnDelivery {
		Default.Click(locator1 = "General#CHECKBOX");
	}

	@summary = "Select package size"
	macro selectPackageSize {
		Default.Click(
			key_packageSize = "${packageSize}",
			locator1 = "ParcelForYou#PACKAGE_SIZE");
	}

	@summary = "Navigate to the remittance submission form"
	macro sendAParcel {
		Default.MouseOver(locator1 = "ParcelForYou#BUTTON_SEND_A_PARCEL");

		Default.Click(locator1 = "ParcelForYou#BUTTON_SEND_A_PARCEL");
	}

	@summary = "Choose the type of shipping shipments"
	macro sendParcelShipments {
		Default.WaitForVisible(locator1 = "ParcelForYou#BANNER");

		for (var key_index : list "${index}") {
			Default.Click(
				key_index = "${key_index}",
				locator1 = "ParcelForYou#SEND_SHIPMENTS");
		}
	}

	@summary = "Fill in the bank details when I choose the 'Cash on delivery' option the sender's information"
	macro typeFormBankCashOnDelivery {
		Default.Type(
			key_fieldName = "Value",
			locator1 = "ParcelForYou#TYPE_DATA_BANK",
			value1 = "${codValue}");

		Default.Type(
			key_fieldName = "BankAccount",
			locator1 = "ParcelForYou#TYPE_DATA_BANK",
			value1 = "${codBankAccount}");

		var bankName = selenium.getText("ParcelForYou#CODE_BANK_INDEX");

		Default.Select(
			locator1 = "ParcelForYou#CODE_BANK",
			value1 = "${bankName}");
	}

	@summary = "Go to the recipient form and fill in the data"
	macro typeFormRecipientShipment {
		Default.Type(
			key_fieldName = "name",
			locator1 = "ParcelForYou#TYPE_RECIPIENT_ADDRESS",
			value1 = "${addressNameRecipient}");

		Default.Type(
			key_fieldName = "phone",
			locator1 = "ParcelForYou#TYPE_RECIPIENT_ADDRESS",
			value1 = "${addressPhoneRecipient}");

		Default.Type(
			key_fieldName = "email",
			locator1 = "ParcelForYou#TYPE_RECIPIENT_ADDRESS",
			value1 = "${addressEmailRecipient}");
	}

	@summary = "Go to the sender form and fill in the data"
	macro typeFormSendShipment {
		Default.Type(
			key_fieldName = "name",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addressName}");

		Default.Type(
			key_fieldName = "street",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addressStreet}");

		Default.Type(
			key_fieldName = "city",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addressCity}");

		Default.Type(
			key_fieldName = "zipCode",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addresszipCode}");

		Default.Type(
			key_fieldName = "phone",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addressPhone}");

		Default.Type(
			key_fieldName = "email",
			locator1 = "ParcelForYou#TYPE_SENDER_ADDRESS",
			value1 = "${addressEmail}");
	}

	@summary = "View all recipient informations"
	macro viewRecipientForms {
		Default.AssertElementPresent(
			key_senderOrRecipient = "${senderOrRecipient}",
			locator1 = "ParcelForYou#SENDER_OR_RECIPIENT");

		Default.AssertElementPresent(
			key_Name = "${addressNameRecipient}",
			locator1 = "ParcelForYou#VIEW_OVERVIEW_NAME");

		Default.AssertElementPresent(
			key_addressStreetRecipient = "${addressStreetRecipient}",
			locator1 = "ParcelForYou#VIEW_OVERVIEW_ADDRESS_RECIPIENT");

		Default.AssertElementPresent(
			key_email = "${addressEmailRecipient}",
			locator1 = "ParcelForYou#VIEW_OVERVIEW_EMAIL");

		Default.AssertElementPresent(
			key_phone = "${addressPhoneRecipient}",
			locator1 = "ParcelForYou#VIEW_OVERVIEW_PHONE");
	}
}