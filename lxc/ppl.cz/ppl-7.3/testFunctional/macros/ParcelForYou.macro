definition {

	@summary = "Select a cash on delivery option"
	macro buttonCashOnDelivery {
		Default.Click(locator1 = "General#CHECKBOX");
	}

	@summary = "Select package size"
	macro selectPackageSize {
		Default.Click(
			key_packageSize = "${packageSize}",
			locator1 = "ParcelForYou#PACKAGE_SIZE");
	}

	@summary = "Navigate to the remittance submission form"
	macro sendAParcel {
		Default.MouseOver(locator1 = "ParcelForYou#BUTTON_SEND_A_PARCEL");

		Default.Click(locator1 = "ParcelForYou#BUTTON_SEND_A_PARCEL");
	}

	@summary = "Choose the type of shipping shipments"
	macro sendParcelShipments {
		Default.WaitForVisible(locator1 = "ParcelForYou#BANNER");

		for (var key_index : list "${index}") {
			Default.Click(
				key_index = "${key_index}",
				locator1 = "ParcelForYou#SEND_SHIPMENTS");
		}
	}
}