definition {

	@summary = "Select in which Parcelshop you intend to deliver it"
	macro findPlaceParcelBox {
		Default.Click(locator1 = "Maps#ICON_TYPE_PLACE");

		Default.Click(locator1 = "Maps#SEARCH_INPUT_MAPS");

		Default.Type(
			locator1 = "Maps#SEARCH_INPUT_MAPS",
			value1 = "${mapInput}");

		Default.KeyPress(
			locator1 = "Maps#SEARCH_INPUT_MAPS",
			value1 = "\DOWN");

		Default.KeyPress(
			locator1 = "Maps#SEARCH_INPUT_MAPS",
			value1 = "\ENTER");

		Default.Click(locator1 = "Maps#SELECT_RESULT");

		Default.Click(locator1 = "Maps#SELECT_RESULT_PLACE");
	}

}