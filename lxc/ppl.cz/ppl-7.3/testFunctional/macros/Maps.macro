definition {

	@summary = "Select which Parcelshop or Parcelbox you want to deliver it to"
	macro findPlaceBoxOrShop {
		Default.Click(
			key_deliverShipment = "${deliverShipment}",
			locator1 = "Maps#ICON_FIND_PARCELBOX");

		// PPLUPGD1122-45 - We need to have an explicit wait (pause) to wait for the map to be fully loaded

		while ((Default.IsElementPresent(locator1 = "Maps#WAIT_LOAD")) && (maxIterations = "10")) {
			Default.Pause(locator1 = "1000");
		}

		Default.Type(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "${mapInput}");

		Default.KeyPress(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "\DOWN");

		Default.KeyPress(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "\ENTER");

		// PPLUPGD1122-45 - We need to have an explicit wait (pause) to wait for the map to be fully loaded

		Default.Pause(locator1 = "2000");

		Default.Click(locator1 = "Maps#RESULT_LIST");

		Default.Click(locator1 = "Maps#RESULT_PLACE");
	}

}