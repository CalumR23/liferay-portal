definition {

	@summary = "Select in which Parcelshop you intend to deliver it"
	macro findPlaceParcelBox {
		Default.Click(locator1 = "Maps#ICON_FIND_PARCELBOX");

		Default.Click(locator1 = "Maps#INPUT_MAPS");

		Default.Type(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "${mapInput}");

		Default.KeyPress(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "\DOWN");

		Default.KeyPress(
			locator1 = "Maps#INPUT_MAPS",
			value1 = "\ENTER");

		Default.Click(locator1 = "Maps#RESULT_LIST");

		Default.Click(locator1 = "Maps#RESULT_PLACE");
	}

}