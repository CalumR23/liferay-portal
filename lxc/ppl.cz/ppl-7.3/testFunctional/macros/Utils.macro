definition {

	@summary = "Launching Home page"
	macro launchUatHomePage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}");

		Default.WaitForVisible(
			key_userType = "Personal",
			locator1 = "ParcelForYou#USER_TYPE");

		Default.WaitForVisible(locator1 = "General#IMAGEM_INITIAL_PAGE");
	}

}