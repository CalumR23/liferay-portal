<html>
<head>
<title>CP2ActivationKeys</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CP2ActivationKeys</td></tr>
</thead>

<tbody>
<tr>
	<td>MODAL_BUTTON</td>
	<td>//div[contains(@class,'modal-content')]//button[contains(text(),'${key_buttonName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//div[contains(@class,'activation-key-container')]/following-sibling::div//input[@placeholder='Search']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>