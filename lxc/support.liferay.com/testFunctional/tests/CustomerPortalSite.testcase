definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-78901 | Test Summary: Verify if Customer Portal can be created"
	@priority = "5"
	test CanCP20BeCreated {
		task ("Then the 'Customer Portal' page should be loaded") {
			HomePage.viewHeading();
		}
	}

}