definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-78592 | Test Summary: Verify if 'Environment Details' appears in Quick Links panel when DXP is 'Active'"
	@priority = "5"
	test IfDXPActiveShowsEnvironmentDetails {
		task ("Given an active project is open") {
			Portal.CustomerPortal.enterOnProject(title = "Liferay, Inc.");
		}

		task ("When I go to the product activation section and select the DXP product") {
			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");
		}

		task ("Then the 'Environment Details' quick link should be visible") {
			Portal.CustomerPortal.assertQuickLinksPanelInfo(title = "Environment Details");
		}
	}

}