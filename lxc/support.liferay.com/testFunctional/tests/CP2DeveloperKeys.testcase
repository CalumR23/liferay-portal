definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-78902 | Test Summary: Verify XML file can be downloaded by clicking at the 'Download Key' button"
	@priority = "5"
	test CanViewDownloadsXmlFile {
		task ("Given the DXP product is selected into the 'product activation section' of a project") {
			HomePage.searchProject(projectName = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CustomerPortal.enterOnProject(title = "2022 FIFA World Cup Qatar - FAN ID");

			Portal.CP2NavigationMenu.goToProductActivation();

			Portal.CP2NavigationMenu.clickOnProductButton(product = "DXP");
		}

		task ("When I download the activation key from details popup window") {
			CP2ActivationKeys.viewActivationKeyDetails(environmentName = "Redacted");

			CP2ActivationKeys.downloadActivationKeyFromModal();
		}

		task ("Then the activation key file should be properly downloaded") {
			Portal.ImportExport.assertDownloadedFileName(downloadedFile = "activation-key-dxpbackup-7.0-2022fifaworldcupqatar-fanid.xml");
		}
	}

}