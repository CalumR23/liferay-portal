definition {

	property test.env = "uat";
	property testray.main.component.name = "Customer Portal 2.0";

	setUp {
		Utils.launchUatPage();

		Login.loginAsAdminUser();
	}

	@description = "Automation ID: LRQA-78889 | Test Summary: Verify pop-up with detailed terms is shown when clicking at a subscription card"
	@priority = "5"
	test ClickingSubscriptionCardPopUpShows {
		task ("Given an active project is open") {
			Portal.CustomerPortal.enterOnProject(title = "Liferay, Inc.");
		}

		task ("When I open 'Development' card") {
			Default.WaitForVisible(
				cardName = "Development",
				locator1 = "Portal.CustomerPortalSite#CARD_NAME");

			Default.Click(
				cardName = "Development",
				locator1 = "Portal.CustomerPortalSite#CARD_NAME");
		}

		task ("Then the card details should be visible in a pop-up") {
			Default.AssertElementPresent(
				locator1 = "Portal.CustomerPortalSite#MODAL_TITLE",
				modalTitle = "Development");
		}
	}

}