definition {

	@summary = "Performing login process"
	macro _signIn {
		if ("${userRole}" == "admin") {
			var userEmailAddress = PropsUtil.get("test.this.cp.test.account.uat.admin.login");
			var userPassword = PropsUtil.get("test.this.cp.test.account.uat.admin.password");
		}

		Default.WaitForElementPresent(locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD");

		Default.Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Default.Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		Default.WaitForElementNotPresent(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		Default.WaitForVisible(locator1 = "HomePage#SEARCH_BAR");
	}

}