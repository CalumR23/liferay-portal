definition {

	@summary = "Making sure activation key is not available"
	macro assertActivationKeyNotPresent {
		Default.AssertElementNotPresent(
			key_text = "${environmentName}",
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");
	}

	@summary = "Deactivating an existing key by the environment name"
	macro deactivateExistingKey {
		Portal.CP2ActivationKeys.selectKeyCheckboxByEnvironmentName(key_environmentName = "${environmentName}");

		Portal.Button.click(button = "Deactivate");

		Portal.Button.click(button = "Confirm Deactivate Keys");

		Portal.Button.click(button = "Continue");

		Alert.viewSuccessMessage();
	}

	@summary = "Downloading an activation key from the open modal window"
	macro downloadActivationKeyFromModal {
		Default.Click(
			key_buttonName = "Download Key",
			locator1 = "CP2ActivationKeys#MODAL_BUTTON");

		Portal.Alert.viewSuccessMessage();
	}

	@summary = "Searches an activation key"
	macro searchActivationKey {
		Default.WaitForElementPresent(locator1 = "CP2ActivationKeys#SEARCH_FIELD");

		Default.Type(
			locator1 = "CP2ActivationKeys#SEARCH_FIELD",
			value1 = "${searchTerm}");

		Default.KeyPress(
			locator1 = "CP2ActivationKeys#SEARCH_FIELD",
			value1 = "\ENTER");
	}

	@summary = "Checking if activation key details are shown"
	macro viewActivationKeyDetails {
		CP2ActivationKeys.searchActivationKey(searchTerm = "${environmentName}");

		Default.WaitForVisible(
			key_text = "${environmentName}",
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");

		Default.Click(
			key_text = "${environmentName}",
			locator1 = "Portal.CP2ActivationKeys#RESPONSIVE_TABLE");

		Default.AssertElementPresent(
			key_environmentName = "${environmentName}",
			locator1 = "Portal.CP2ActivationKeys#KEY_DETAILS_MODAL");
	}

}