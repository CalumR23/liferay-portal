definition {

	@summary = "Searching for an existing project"
	macro searchProject {
		Default.Type(
			locator1 = "HomePage#SEARCH_BAR",
			value1 = "${projectName}");
	}

	@summary = "Making sure heading fragment is loaded"
	macro viewHeading {
		Default.WaitForVisible(
			key_title = "Welcome,",
			locator1 = "Portal.CustomerPortalSite#FRAGMENT_HEADING");

		Default.AssertElementPresent(
			key_title = "Welcome,",
			locator1 = "Portal.CustomerPortalSite#FRAGMENT_HEADING");
	}

}