definition {

	@summary = "Perform login process"
	macro signIn {
		var loginUserName = PropsUtil.get("test.this.alongsiders.test.account.uat.admin.login");
		var loginUserPassword = PropsUtil.get("test.this.alongsiders.test.account.uat.admin.password");

		Default.Click(locator1 = "Login#SIGN_IN_BUTTON");

		Default.Type(
			key_fieldLabel = "Email Address",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${loginUserName}");

		Default.Type(
			key_fieldLabel = "Password",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${loginUserPassword}");

		Default.Click(locator1 = "Login#CONFIRMATION_SIGN_IN_BUTTON");

		Default.WaitForElementNotPresent(locator1 = "Login#CONFIRMATION_SIGN_IN_BUTTON");
	}

}