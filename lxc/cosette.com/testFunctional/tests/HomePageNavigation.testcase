definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	setUp {
		Utils.launchAzorUat();
	}

	@description = "Automation ID: LRQA-75923 | Test Summary: Verify user is properly redirected when clicking in the navigation bar option: AZOR"
	@priority = "5"
	test CanOpenAzorPageFromNavigationBarInBenicar {
		task ("Given BENICAR page is loaded") {
			Utils.launchBenicarUat();
		}

		task ("When I click at AZOR in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(navigationOption = "Azor");
		}

		task ("Then I should be redirected to AZOR page") {
			CosetteNavigation.viewPage(
				pageName = "azor",
				subHeadingText = "AZOR");
		}
	}

}