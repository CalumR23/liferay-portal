definition {

    /* 
		This file is based on https://github.com/liferay/liferay-portal/blob/master/portal-web/test/functional/com/liferay/portalweb/macros/UserBar.macro
	*/

    @description = "Open the User Personal Menu - user avatar."
	macro gotoUserPersonalMenu {

        Default.Click(locator1 = "UserBar#USER_AVATAR_BUTTON");

	}

	@description = "Navigate to a dropdown item in the User Personal Menu."
	macro gotoUserPersonalOption {
		UserBar.gotoUserPersonalMenu();

        Default.Click(
            locator1 = "UserBar#USER_AVATAR_DROPDOWN_ITEM",
            value1 = "${key_dropdownItem}";)
	}

    @description = "Perform Sing Out through User Personal Menu option."
	macro signOut {

        UserBar.gotoUserPersonalMenu();

        Default.Click(
            locator1 = "UserBar#USER_AVATAR_DROPDOWN_ITEM",
            value1 = "Sign Out");
	}
}