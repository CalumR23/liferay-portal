<html>
<head>
<title>UserMenu</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">UserMenu</td></tr>
</thead>

<!-- This file is based on: https://github.com/liferay/liferay-portal/blob/master/portal-web/test/functional/com/liferay/portalweb/paths/portlet/userbar/UserBar.path -->

<tbody>

    <tr>
        <td>USER_AVATAR_BUTTON</td>
        <td>//button[@aria-label='Personal Menu']</td>
        <td></td>
    </tr>

    <tr>
        <td>USER_AVATAR_DROPDOWN_ITEM</td>
        <td>//div[contains(@class,'dropdown-menu-personal-menu') and contains(@class,'show')]//a[contains(.,'${key_dropdownItem}')]</td>
        <td></td>
    </tr>

</tbody>
</table>
</body>
</html>