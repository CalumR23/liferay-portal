<html>
<head>
<title>OktaLogin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OktaLogin</td></tr>
</thead>
<tbody>

<!-- LOGIN FIELDS -->
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'okta-signin-username')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[contains(@id,'okta-signin-password')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'Sign In')] | //input[@value='Sign In']</td>
	<td></td>
</tr>

<!-- ERROR MESSAGES -->
<tr>
	<td>FIELD_ERROR_MESSAGE</td>
	<td>//span[contains(@class,'${key_field}')]//following-sibling::p[contains(@id,'input-container-error') and contains(text(),'${errorMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td>INFO_BOX_ERROR_MESSAGE</td>
	<td>//div[contains(@class,'${key_field}')]//p[contains(text(),'${errorMessage}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>