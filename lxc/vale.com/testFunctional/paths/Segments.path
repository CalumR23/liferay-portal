<html>
<head>
<title>Segments</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Segments</td></tr>
</thead>

<tbody>
<tr>
	<td>BRAZLIAN_NEWS</td>
	<td>//div[contains(@data-analytics-asset-title,'Vale adere à campanha Natal Sem Fome 2022')]</td>
	<td></td>
</tr>
<tr>
	<td>INDONESIA_SECTION</td>
	<td>//section[contains(@class,'vale-fragmento')]//*[contains(text(),'Become Our Supplier in Indonesia')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BOX</td>
	<td>//div[contains(@class,'list--single')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_COUNTRY_DROPDOWN</td>
	<td>//div[@class='choices__list']/div[@data-value='${key_countryName}']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_COUNTRY_DROPDOWN_ACTIVE</td>
	<td>//select[contains(@class,'choices__input')]/option[@value='${key_countryName}']</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_INDONESIAN_BUTTON</td>
	<td>//div[contains(@class,'structure-item-header')]//div[contains(@class,'block')]//a[@lang='in-ID']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>