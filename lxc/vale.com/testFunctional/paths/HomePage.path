<html>
<head>
<title>HomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">HomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTIVE_NEWS_CARD</td>
	<td>xpath=(//div[contains(@class,'swiper-slide-active')])[2]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVE_NEWS_CARD_TITLE</td>
	<td>xpath=(//div[contains(@class,'swiper-slide-active')]//div[contains(@class,'card-text')]/*)[1]</td>
	<td></td>
</tr>
<tr>
	<td>ACTIVE_VIDEO_CARD</td>
	<td>//div[contains(@class,'video-swiper')]//div[contains(@class,'active')][contains(@aria-label,'${key_indicatorIndex} / ')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_CARD_VIDEO_SECTION</td>
	<td>//div[contains(@class,'card-video-swiper')]//ancestor::div[contains(@class,'structure-item-carrossel')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_CARD_VIDEO_BUTTON_NEXT</td>
	<td>//img[contains(@class,'video-button-next')][@aria-disabled='false']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_CARD_VIDEO_BUTTON_PREVIOUS</td>
	<td>//img[contains(@class,'video-button-prev')][@aria-disabled='false']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_CARD_VIDEO_SWIPER</td>
	<td>//div[contains(@class,'card-video-swiper')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_IMAGE_SECTION</td>
	<td>//div[contains(@class,'carousel-item')]//ancestor::section[not(contains(@id,'content'))]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_IMAGE_SWIPER_ACTIVE_IMAGE</td>
	<td>//div[contains(@class,'carousel-inner')]//img[@data-lfr-editable-id='slide-image-${key_imageNumber}']//ancestor::div[contains(@class,'carousel-item')][contains(@class,'active')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_IMAGE_SWIPER_INDICATOR_ACTIVE</td>
	<td>//div[@id='banner-home']/ol[contains(@class,'carousel-indicators')]/li[@data-slide-to='${key_indicatorIndex}'][contains(@class,'active')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_IMAGE_SWIPER_INDICATOR_INACTIVE</td>
	<td>//div[@id='banner-home']/ol[contains(@class,'carousel-indicators')]/li[@data-slide-to='${key_indicatorIndex}'][not (contains(@class,'active'))]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ALL_NEWS_BUTTON</td>
	<td>//div[contains(@class,'text-break')]/a[@id='fragment-mnuc-link']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_NEWS_SWIPER_BUTTON_NEXT</td>
	<td>//div[contains(@class,'end')]/img[contains(@class,'button-next')][@aria-disabled='${key_boolean}']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_NEWS_SWIPER_BUTTON_PREVIOUS</td>
	<td>//div[contains(@class,'end')]/img[contains(@class,'button-prev')][@aria-disabled='${key_boolean}']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_NEWS_SWIPER_INDICATOR_ACTIVE</td>
	<td>//div[contains(@class,'wrapper-dropzone')]//div[contains(@class,'active')][contains(@aria-label,'${key_indicatorIndex} / ')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_NEWS_SWIPER_INDICATOR_INACTIVE</td>
	<td>//div[contains(@class,'wrapper-dropzone')]//div[not(contains(@class, 'active'))][contains(@aria-label,'${key_indicatorIndex} / ')]</td>
	<td></td>
</tr>
<tr>
	<td>COOKIE_BANNER_BUTTON</td>
	<td>//div[contains(@class,'main-container')]//button[contains(text(),'OK')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER</td>
	<td>//div[contains(@class,'footer')]</td>
	<td></td>
</tr>
<tr>
	<td>KNOW_MORE_AFTER_SCROLL_DOWN</td>
	<td>//a[contains(@id,'link')][contains(text(),'Saiba mais')]</td>
	<td></td>
</tr>
<tr>
	<td>NEWS_SECTION</td>
	<td>//*[contains(text(),'A Vale agora')]//ancestor::div[contains(@class,'structure-item-carrossel')]</td>
	<td></td>
</tr>
<tr>
	<td>NEWS_TITLE</td>
	<td>//div[contains(@class,'basic-component-heading')]//*[contains(text(),'${key_newsTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>SCROLL_DOWN_BUTTON_TEXT</td>
	<td>//div[contains(@class, 'contrast-immune')]/span[text()='${key_text}']</td>
	<td></td>
</tr>
<tr>
	<td>VALE_LOGO</td>
	<td>//img[contains(@src,'vale-logo')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_ANIMATION</td>
	<td>//source[contains(@type,'video')]//ancestor::div[contains(@class,'bg-video')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_SECTION</td>
	<td>//video//ancestor::section[not(contains(@id,'content'))]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>