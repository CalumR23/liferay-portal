<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>CURRENT_LANGUAGE_INDICATOR</td>
	<td>//div[contains(@class,'structure-item-header')]//div[contains(@class,'block')]//a[@class='current-lang'][@lang='${key_currentLanguage}']</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_OPTION</td>
	<td>//div[contains(@class,'footer')]//section[contains(@id,'SiteNavigationMenuPortlet')]//a[normalize-space()='${key_footerOption}']</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA_IMAGE</td>
	<td>//div[contains(@class,'footer')]//img[@data-lfr-editable-id='${key_socialMediaName}-img']</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER</td>
	<td>//div[contains(@class,'footer')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADER_TEXT</td>
	<td>//section[contains(@class,'header')]//*[normalize-space()='${key_headerText}']</td>
	<td></td>
</tr>
<tr>
	<td>LEFT_MENU_BUTTON</td>
	<td>//div[contains(@class,'left-menu')]//div[@class='burguer']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ICON</td>
	<td>//div/img[contains(@class,'search')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_LANGUAGE_BUTTON</td>
	<td>//div[contains(@class,'structure-item-header')]//div[contains(@class,'block')]//a[not(@class='current-lang')][@lang='${key_language}']</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_ANY</td>
	<td>//*[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>