<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>FOOTER_OPTION</td>
	<td>//div[contains(@class,'footer')]//div[contains(@class,'col-4')]//a[normalize-space()='${key_footerOption}']</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA_IMAGE</td>
	<td>//div[contains(@class,'footer')]//img[@data-lfr-editable-id='${key_socialMediaName}-img']</td>
	<td></td>
</tr>
<tr>
	<td>HEADER_TEXT</td>
	<td>//section[contains(@class,'header')]//*[normalize-space()='${key_headerText}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>