<html>
<head>
<title>Search</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Search</td></tr>
</thead>

<tbody>
<tr>
	<td>HIGHLIGHTED_SEARCH_RESULTS</td>
	<td>//span[@class='highlight'][text()='${key_searchTerm}']</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_LIST_ITEM</td>
	<td>xpath=(//div//*[contains(@class,'links-title')][text()='${key_listName}']//following-sibling::*//a[contains(@href,'')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_LIST_TITLE</td>
	<td>//div/*[contains(@class,'links-title')][text()='${key_listName}']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_CENTER_MAIN_INPUT</td>
	<td>//div[contains(@class,'search-bar-wrapper')]//input[@value='${key_searchTerm}']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_INPUT</td>
	<td>//div[contains(@class,'search-bar')]//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_PLACEHOLDER</td>
	<td>//input[contains(@placeholder,'${key_placeholdertText}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUGGESTIONS_LIST_ITEM</td>
	<td>//ul[@class='suggestions-list']//*[text()='${key_searchTerm}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>