<html>
<head>
<title>Menu</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Menu</td></tr>
</thead>

<tbody>
<tr>
	<td>CLOSE</td>
	<td>//div[contains(@class,'content-close')]</td>
	<td></td>
</tr>
<tr>
	<td>MENU_ITEM</td>
	<td>//section[contains(@id,'sideMenuNav')]//*[text()='${key_menuItem}']//ancestor::*[contains(@class,'links-item')]</td>
	<td></td>
</tr>
<tr>
	<td>QUICK_ACCESS_LINK</td>
	<td>//nav[@class='content-quick-access']//a[contains(@href,'${key_quickAccessLinkName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_GO_BACK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuTitle}']/../preceding-sibling::div/div[contains(@class,'submenu-top-go-back')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_COVER_PAGE_LINK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuTitle}']//following-sibling::a</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_LINK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuTitle}']//following-sibling::div/*[normalize-space()='${key_subMenuOption}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_TITLE</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_PAGE_HEADER</td>
	<td>//nav[contains(@id,'defaultScreen')]/*[text()='${key_subMenuTitle}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>