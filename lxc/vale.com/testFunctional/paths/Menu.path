<html>
<head>
<title>Menu</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Menu</td></tr>
</thead>

<tbody>
<tr>
	<td>MENU_ITEM</td>
	<td>//section[contains(@id,'sideMenuNav')]//*[text()='${key_menuItem}']//ancestor::*[contains(@class,'links-item')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_GO_BACK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuText}']/../preceding-sibling::div/div[contains(@class,'submenu-top-go-back')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuText}']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_COVER_PAGE_LINK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuText}']//following-sibling::a</td>
	<td></td>
</tr>
<tr>
	<td>SUBMENU_ITEM_LINK</td>
	<td>//div[@class='submenu-content']/*[text()='${key_subMenuText}']//following-sibling::div/*[normalize-space()='${key_subMenuOption}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>