definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatLoginPage();

		Login.loginAsAdminUser();

		Utils.launchUatHomePage();
	}

	@description = "Automation ID: LRQA-77949 | Test Summary: Verify user is properly redirected when clicking in news card"
	@priority = "5"
	test CanOpenNews {
		task ("When I go to the news card") {
			var newsTitleText = HomePage.getNewsTitle();

			HomePage.openNews();
		}

		task ("Then the news should be displayed") {
			HomePage.viewNewsPage(newsTitle = "${newsTitleText}");
		}
	}

	@description = "Automation ID: LRQA-77552 | Test Summary: Verify the user is properly redirected when clicking in Page Footer Social Media option: Facebook, Youtube, Linkedin, Instagram, Twitter"
	@priority = "5"
	test CanOpenSocialMediaPages {
		task ("Then Go to social media pages through page footer") {
			for (var socialMedia : list "facebook,youtube,linkedin,instagram,twitter") {
				General.gotoFooter();

				HomePage.openSocialMedia(socialMediaName = "${socialMedia}");

				HomePage.viewSocialMedia(socialMediaName = "${socialMedia}");

				Utils.closeWindow();

				Utils.launchUatHomePage();
			}
		}
	}

	@description = "Automation ID: LRQA-77554 | Test Summary: Verify the user is properly redirected when clicking in Page Footer Iniciativas options: Fundação Vale"
	@priority = "5"
	test CanOpenValeIniciativasInFooter {

		// LXC Refactor: The viewPage macro cannot validate the url because the Fundação Vale page is still not implemented
		// LXC Refactor ticket: LRQA-78067

		task ("When I click at the footer option 'Fundação Vale'") {
			General.goToFooterOption(footerOption = "Fundação Vale");
		}

		task ("Then 'Fundação Vale' page should be properly loaded") {
			General.viewPage(
				headerText = "Fundação Vale",
				partialURL = "/fundacao-vale");
		}
	}

	@description = "Automation ID: LRQA-77553 | Test Summary: Verify the user is properly redirected when clicking in Page Footer option 'Our Future'"
	@priority = "5"
	test CanOpenValeItemsInFooter {
		task ("When I click at the footer option 'A Vale agora'") {
			General.goToFooterOption(footerOption = "A Vale agora");
		}

		task ("Then 'Our Future' page should be properly loaded") {
			General.viewPage(
				headerText = "A Vale agora",
				partialURL = "/a-vale-agora");
		}
	}

	@description = "Automation ID: LRQA-77557 | Test Summary: Verify carousel swiper is present in home page: first carousel with images"
	@priority = "5"
	test ShowsCarouselSwiperWithImages {
		task ("Then the carousel swiper should be present and swipe images") {
			HomePage.viewSwipingImagesInCarouselSwiper(slideNumber = "1");

			HomePage.viewSwipingImagesInCarouselSwiper(slideNumber = "2");

			HomePage.viewSwipingImagesInCarouselSwiper(slideNumber = "3");
		}
	}

	@description = "Automation ID: LRQA-77559 | Test Summary: Verify carousel swiper is present in home page: news cards"
	@priority = "5"
	test ShowsCarouselSwiperWithNews {
		task ("When the carousel section is visible") {
			Default.ScrollWebElementIntoView(locator1 = "HomePage#CAROUSEL_ALL_NEWS_BUTTON");
		}

		task ("Then view if the user can swipe through the carousel using next and previous button") {
			HomePage.viewSwipingNewsInCarouselSwiper(
				button = "next",
				indicatorIndex = "1");

			HomePage.viewSwipingNewsInCarouselSwiper(indicatorIndex = "2");
		}
	}

	@description = "Automation ID: LRQA-77558 | Test Summary: Verify carousel swiper is present in home page: video cards"
	@priority = "5"
	test ShowsCarouselSwiperWithVideos {

		// LXC Refactor: The viewVideoCarouselSwiper macro should validate the video presented in the section, but it is not possible to validate a video present as it is not yet implemented
		// LXC Refactor ticket: LRQA-78067

		task ("Then the video carousel swipe must be present with any video") {
			HomePage.viewVideoCarouselSwiper();

			HomePage.viewVideoPresent();
		}
	}

	@description = "Automation ID: LRQA-77556 | Test Summary: Verify main sections are present"
	@priority = "5"
	test ShowsMainSections {
		task ("Then main sections should be present") {
			HomePage.viewMainSections();
		}
	}

	@description = "Automation ID: LRQA-77551 | Test Summary: Verify that social media icons still exists after an upgrade"
	@priority = "5"
	test ShowsSocialMediaItemsInFooter {
		task ("Then social media icons should be present") {
			HomePage.viewSocialMediaIconsInFooter();
		}
	}

	@description = "Automation ID: LRQA-77561 | Test Summary: Verify translation for: scroll-down-to-know-more button"
	@priority = "5"
	test ShowsTranslatedButtonText {
		task ("Then social media icons should be present") {
			HomePage.viewScrollDownButtonText(buttonText = "scroll-down-to-know-more");
		}
	}

	@description = "Automation ID: LRQA-77560 | Test Summary: Verify animation/video is present in home page"
	@priority = "5"
	test ShowsVideo {
		task ("Then the animation/video should be present") {
			Default.AssertElementPresent(locator1 = "HomePage#VIDEO_ANIMATION");
		}
	}

}