definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatLoginPage();

		Login.loginAsAdminUser();

		Utils.launchUatHomePage();

		Utils.acceptCookies();
	}

	// @description = "Automation ID: LRQA-77570 | Test Summary: Verify the user is properly redirected when clicking in one of the options available on: Most Searched"
