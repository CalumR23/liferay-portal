	@description = "Automation ID: LRQA-77571 | Test Summary: Verify the user is properly redirected when clicking in one of the options available on: Quick Links"
	@priority = "5"
	test CanOpenQuickLinks {
		task ("Given the search portlet is open") {
			Default.Click(locator1 = "General#SEARCH_ICON");
		}

		task ("When the user clicks on a quick links link") {
			var itemName = Search.getItemName(listName = "Links rápidos");

			Search.clickListItem(listName = "Links rápidos");
		}

		task ("Then the link page should be properly loaded") {
			General.viewPage(headerText = "${itemName}");
		}
	}

	@description = "Automation ID: LRQA-77569 | Test Summary: Verify the user is properly redirected when clicking in one of the options available on: Recent Searches"
	@priority = "5"
	test CanOpenRecentSearches {
		task ("Given the search portlet is open") {
			Default.Click(locator1 = "General#SEARCH_ICON");
		}

		task ("When the user searches for something") {
			Search.searchContent(searchTerm = "trem");
		}

		task ("Then the searched item should appear in the recent search list") {
			Default.Click(locator1 = "General#SEARCH_ICON");

			Search.viewSearchedItem(
				listName = "Buscas recentes",
				recentSearchedItem = "trem");
		}

		task ("When the user clicks on a recent-searches link") {
			var itemName = Search.getItemName(listName = "Buscas recentes");

			Search.clickListItem(listName = "Buscas recentes");
		}

		task ("Then the link page should be properly loaded") {
			General.viewPage(
				pageText = "${itemName}",
				partialURL = "${itemName}");
		}
	}

	@description = "Automation ID: LRQA-78011 | Test Summary: Verify the user is able to Search"
	@priority = "5"
	test CanSearch {
		task ("Given that the home page is loaded click in search icon") {
			General.gotoSearchPortlet();
		}

		task ("When the Search portlet is open, the user will search for something") {
			Search.searchContent(searchTerm = "Vale");
		}

		task ("Then the search term page should be properly loaded") {
			Search.viewSearchedResults(
				partialURL = "Vale",
				searchTerm = "Vale");
		}
	}

	@description = "Automation ID: LRQA-77568 | Test Summary: Verify the user is able to see the suggestions list after using the search bar"
	@priority = "5"
	test ShowsSearchSuggestions {
		task ("Given the page is loaded go to the search section") {
			General.gotoSearchPortlet();
		}

		task ("When I search something through my typing") {
			Search.typeInSearchField(searchText = "Vale");
		}

		task ("Then Something related to what I typed should Appear") {
			Search.viewSuggestionList(searchTerm = "Vale");
		}
	}

	@description = "Automation ID: LRQA-77572 | Test Summary: Verify translations for: recent-searches, most-searched, quick-links categories"
	@priority = "5"
	test ShowsTranslatedCategories {

		// LXC Refactor: Some parts of the test are commented due to a uncertainty if the most searched section will be present
		// LXC Refactor ticket: LRQA-78642

		task ("Given the language is set as 'pt-BR'") {
			General.selectLanguage(chosenLanguage = "pt-BR");
		}

		task ("When I open the search menu") {
			Default.Click(locator1 = "General#SEARCH_ICON");
		}

		task ("Then the category title should be translated to Portuguese") {
			Search.viewLinksSearch(listName = "Buscas recentes");

			//Search.viewLinksSearch(listName = "Mais pesquisados");

			Search.viewLinksSearch(listName = "Links rápidos");

			Search.viewPlaceholder(placeholderText = "Busque em toda a Vale");
		}

		task ("When I switch the languege from 'pt-BR' to 'en-US' and reopen search menu") {
			General.selectLanguage(chosenLanguage = "en-US");

			Default.Click(locator1 = "General#SEARCH_ICON");
		}

		task ("Then the category title should be translated to English") {
			Search.viewLinksSearch(listName = "Recent searches");

			//Search.viewLinksSearch(listName = "most-searched");

			Search.viewLinksSearch(listName = "Quick Links");

			Search.viewPlaceholder(placeholderText = "Search all over Vale");
		}
	}

}