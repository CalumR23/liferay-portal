definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatLoginPage();

		Login.loginAsAdminUser();

		Utils.launchUatHomePage();
	}

	@description = "Automation ID: LRQA-77562 | Test Summary: Verify the user can mouse over menu items"
	@priority = "5"
	test CanMouseOverMenuItems {
		task ("Given the page language is En-US") {
			General.selectLanguage(chosenLanguage = "en-US");
		}

		task ("When I open the main menu") {
			Menu.openMainMenu();
		}

		task ("Then the submenu items should be visible after I mouse over or click") {
			Menu.mouseOverAndClickAtMenuItem(menuItem = "Who we are");

			Menu.viewSubmenuItem(submenuTitle = "Who we are");

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Our people");

			Menu.viewSubmenuItem(submenuTitle = "Our people");

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Our Future");

			Menu.viewSubmenuItem(submenuTitle = "Our Future");
		}
	}

	@description = "Automation ID: LRQA-77564 | Test Summary: Verify the user can navigate from Sub Menu by clicking Go Back"
	@priority = "5"
	test CanNavigateBackFromSubmenuByGoBackButton {
		task ("When I go to a submenu item") {
			Menu.openMainMenu();

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Our people");

			Menu.goToSubmenuItem(
				subMenuOption = "Proud to be Vale",
				subMenuTitle = "Our people");

			Menu.goBackFromSubmenuItem(subMenuTitle = "Proud to be Vale");

			Menu.goToSubmenuItem(
				subMenuOption = "Opportunities for professionals",
				subMenuTitle = "Our people");

			Menu.goBackFromSubmenuItem(subMenuTitle = "Opportunities for professionals");
		}

		task ("Then the submenu should be visible") {
			Menu.viewSubmenuItem(submenuTitle = "Our people");
		}
	}

	@description = "Automation ID: LRQA-77566 | Test Summary: Verify the user can navigate through Quick Access items"
	@priority = "5"
	test CanNavigateThroughQuickAccessItems {

		// LXC Refactor: This test needs to be updated when the quick links are implemented, it is why Menu.mouseOverAndClickAtMenuItem is failing
		// LXC Refactor ticket: LRQA-78069

		task ("When I click at the menu option 'Fale Conosco'") {
			Menu.openMainMenu();

			Menu.mouseOverAndClickAtMenuItem(quickAccessLink = "fale-conosco");
		}

		task ("Then 'Fale Conosco' page should be properly loaded") {
			General.viewPage(
				pageText = "Fale Conosco",
				partialURL = "/fale-conosco");
		}
	}

	@description = "Automation ID: LRQA-77563 | Test Summary: Verify the user can navigate to submenu items"
	@priority = "5"
	test CanNavigateToSubmenuItems {
		task ("When I go to a submenu item") {
			Menu.openMainMenu();

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Nossa gente");

			Menu.goToSubmenuItem(
				subMenuOption = "Oportunidades para estudantes",
				subMenuTitle = "Nossa gente");
		}

		task ("Then the submenu should be visible") {
			Menu.viewSubmenuItem(submenuTitle = "Oportunidades para estudantes");
		}
	}

	@description = "Automation ID: LRQA-78090 | Test Summary: Verify the user can navigate to submenu items page"
	@priority = "5"
	test CanNavigateToSubmenuItemsPage {
		task ("When I go to a submenu item") {
			Menu.openMainMenu();

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Who we are");

			Menu.goToSubmenuItem(
				subMenuOption = "Purpose",
				subMenuTitle = "Who we are");
		}

		task ("Then the submenu item page should be visible") {
			Menu.viewSubMenuItemPage(
				partialURL = "/purpose",
				subMenuTitle = "Purpose");
		}
	}

	@description = "Automation ID: LRQA-77565 | Test Summary: Verify the user can navigate to a target page"
	@priority = "5"
	test CanNavigateToTargetPage {
		task ("When I go to a submenu item") {
			Menu.openMainMenu();

			Menu.mouseOverAndClickAtMenuItem(menuItem = "Our people");

			Menu.goToPageFromSubmenuItem(subMenuTitle = "Our people");
		}

		task ("Then 'Our people' page should be properly loaded") {
			General.viewPage(
				pageText = "O jeito de ser Vale",
				partialURL = "/our-people");
		}
	}

	@description = "Automation ID: LRQA-77567 | Test Summary: Verify translation for: menu and sub menu"
	@priority = "5"
	test ShowsTranslatedMenuAndSubmenuItems {
		task ("Given the language is set as 'pt-BR'") {
			General.selectLanguage(chosenLanguage = "pt-BR");
		}

		task ("When I open the main menu") {
			Menu.openMainMenu();
		}

		task ("Then menus and submenus should be visible in Portuguese") {
			Menu.viewMenuItem(menuItem = "O que fazemos");

			Menu.mouseOverAndClickAtMenuItem(menuItem = "O que fazemos");

			Menu.viewSubmenuItem(
				submenuOptionLink = "Energia",
				submenuTitle = "O que fazemos");
		}

		task ("When I switch the languege from 'pt-BR' to 'en-US' and reopen main menu") {
			Menu.closeMainMenu();

			General.selectLanguage(chosenLanguage = "en-US");

			Menu.openMainMenu();
		}

		task ("Then menus and submenus should be visible in English") {
			Menu.viewMenuItem(menuItem = "What we do");

			Menu.mouseOverAndClickAtMenuItem(menuItem = "What we do");

			Menu.viewSubmenuItem(
				submenuOptionLink = "Energy",
				submenuTitle = "What we do");
		}
	}

}