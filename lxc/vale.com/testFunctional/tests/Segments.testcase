definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatLoginPage();

		Login.loginAsAdminUser();

		Utils.launchUatHomePage();

		Utils.acceptCookies();
	}

	// LXC Refactor: This test is a workaround due to some changes that will be implemented in the future when the MODL and PROD become equals
	// LXC Refactor ticket: LRQA-78978

	@description = "Automation ID: LRQA-78477 | Test Summary: Verify specific content is not shown to a certain country/region"
	@priority = "5"
	test ShowsExpectedContentInHomePage {
		task ("When the user selected 'Brazil' as his country") {
			Segments.selectCountry(countryName = "BRAZIL");
		}

		task ("Then the page experience should be aligned with brazilian content") {
			Segments.viewCountry(countryName = "BRAZIL");
		}

		task ("When the user selects another country that isn't 'Brazil'") {
			Segments.selectCountry(countryName = "INDONESIA");
		}

		task ("Then the page content will be different from Brazilian content") {
			Segments.viewIndonesiaExperience();
		}
	}

}