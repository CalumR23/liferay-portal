definition {

	property test.env = "uat";
	property testray.main.component.name = "Vale";

	setUp {
		Utils.launchUatLoginPage();

		Login.loginAsAdminUser();

		Utils.launchUatHomePage();

		Utils.acceptCookies();
	}

	// LXC Refactor: This test is a workaround due to some changes that will be implemented in the future when the MODL and PROD become equals
	// LXC Refactor ticket: LRQA-78978

	@description = "Automation ID: LRQA-78477 | Test Summary: Verify specific content is not shown to a certain country/region"
	@priority = "5"
	test ShowsExpectedContentInHomePage {
		task ("When the user selected a country") {
			Segments.selectCountry(countryName = "BRAZIL");
		}

		task ("Then the page experience should be aligned with the country content") {
			Segments.viewCountry(
				countryName = "BRAZIL",
				currentLanguage = "pt-BR");

			var firstExperience = Segments.getExperienceContent();
		}

		task ("When the user selects another country") {
			Segments.selectCountry(countryName = "CANADA");
		}

		task ("Then the page content will be different from the first selected country content") {
			Segments.viewCountry(
				countryName = "CANADA",
				currentLanguage = "en-US");

			var secondExperience = Segments.getExperienceContent();

			Segments.viewExpectedExperienceContent();
		}
	}

}