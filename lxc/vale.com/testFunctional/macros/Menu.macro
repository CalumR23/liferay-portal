definition {

	@summary = "Closing main menu by clicking at 'close' button on top left"
	macro closeMainMenu {
		Default.Click(locator1 = "Menu#CLOSE");
	}

	@summary = "Go back from submenu item into main menu"
	macro goBackFromSubmenuItem {
		Default.Click.pauseClickAt(
			key_subMenuTitle = "${subMenuTitle}",
			locator1 = "Menu#SUBMENU_GO_BACK");
	}

	@summary = "Navigate to a target page from submenu item"
	macro goToPageFromSubmenuItem {
		Default.Click.pauseClickAt(
			key_subMenuTitle = "${subMenuTitle}",
			locator1 = "Menu#SUBMENU_ITEM_COVER_PAGE_LINK");
	}

	@summary = "Navigate to a submenu item into main menu"
	macro goToSubmenuItem {
		Default.Click.pauseClickAt(
			key_subMenuOption = "${subMenuOption}",
			key_subMenuTitle = "${subMenuTitle}",
			locator1 = "Menu#SUBMENU_ITEM_LINK");
	}

	@summary = "Mouse over and click at any menu item"
	macro mouseOverAndClickAtMenuItem {
		if (isSet(quickAccessLink)) {
			Default.Click.pauseClickAt(
				key_quickAccessLinkName = "${quickAccessLink}",
				locator1 = "Menu#QUICK_ACCESS_LINK");
		}
		else {
			Default.Click.pauseClickAt(
				key_menuItem = "${menuItem}",
				locator1 = "Menu#MENU_ITEM");
		}
	}

	@summary = "Opening main menu on the left side"
	macro openMainMenu {
		Default.Click(locator1 = "General#LEFT_MENU_BUTTON");
	}

	@summary = "Making sure menu item is visible"
	macro viewMenuItem {
		Default.AssertVisible(
			key_menuItem = "${menuItem}",
			locator1 = "Menu#MENU_ITEM");
	}

	@summary = "Making sure submenu item is visible"
	macro viewSubmenuItem {
		Default.AssertVisible(
			key_subMenuTitle = "${submenuTitle}",
			locator1 = "Menu#SUBMENU_ITEM_TITLE");

		if (isSet(submenuOptionLink)) {
			Default.AssertVisible(
				key_subMenuOption = "${submenuOptionLink}",
				key_subMenuTitle = "${submenuTitle}",
				locator1 = "Menu#SUBMENU_ITEM_LINK");
		}
	}

}