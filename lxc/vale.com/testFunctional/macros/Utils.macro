definition {

	@summary = "Launching UAT Home page"
	macro launchUatHomePage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}/home");
	}

	@summary = "Launching UAT login page"
	macro launchUatLoginPage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}/c/portal/login");
	}

}