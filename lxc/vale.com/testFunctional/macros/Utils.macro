definition {

	@summary = "Accept Cookies"
	macro acceptCookies {
		if (Default.IsElementPresent(locator1 = "General#COOKIE_BANNER_BUTTON")) {
			Default.Click(locator1 = "General#COOKIE_BANNER_BUTTON");
		}
	}

	@summary = "Closing current window"
	macro closeWindow {
		Default.Close.closeWindow();

		Default.SelectWindow.selectPopUp(locator1 = "null");
	}

	@summary = "Launching UAT Home page"
	macro launchUatHomePage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}/pt/home");

		Default.WaitForVisible(locator1 = "HomePage#VALE_LOGO");
	}

	@summary = "Launching UAT login page"
	macro launchUatLoginPage {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}/pt/admin");
	}

}