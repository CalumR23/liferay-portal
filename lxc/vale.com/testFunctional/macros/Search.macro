definition {

	@summary = "Click in the list link"
	macro clickListItem {
		Default.Click(
			key_listName = "${listName}",
			locator1 = "Search#LINKS_LIST_ITEM");
	}

	@summary = "Get the item name from the links list"
	macro getItemName {
		var key_listName = "${listName}";

		Default.WaitForVisible(locator1 = "Search#LINKS_LIST_ITEM");

		var itemName = selenium.getText("Search#LINKS_LIST_ITEM");

		return "${itemName}";
	}

	@summary = "Search for content"
	macro searchContent {
		Search.typeInSearchField(searchText = "${searchTerm}");

		Default.KeyPress(
			locator1 = "Search#SEARCH_INPUT",
			value1 = "\ENTER");
	}

	@summary = "Type on search input"
	macro typeInSearchField {
		Default.Type(
			locator1 = "Search#SEARCH_INPUT",
			value1 = "${searchText}");
	}

	@summary = "View list of link shortcuts"
	macro viewLinksSearch {
		Default.AssertElementPresent(
			key_listName = "${listName}",
			locator1 = "Search#LINKS_LIST_TITLE");
	}

	@summary = "View placeholder"
	macro viewPlaceholder {
		Default.AssertElementPresent(
			key_placeholdertText = "${placeholderText}",
			locator1 = "Search#SEARCH_PLACEHOLDER");
	}

	@summary = "View if the searched term is in match with the page"
	macro viewSearchedResults {
		Default.AssertVisible(
			key_searchTerm = "${searchTerm}",
			locator1 = "Search#HIGHLIGHTED_SEARCH_RESULTS");

		Default.AssertVisible(
			key_searchTerm = "${searchTerm}",
			locator1 = "Search#SEARCH_CENTER_MAIN_INPUT");

		Default.AssertLocation.assertPartialLocation(value1 = "${partialURL}");
	}

	@summary = "View item in search suggestions"
	macro viewSuggestionList {
		Default.AssertVisible(
			key_searchTerm = "${searchTerm}",
			locator1 = "Search#SUGGESTIONS_LIST_ITEM");
	}

}