definition {

	@summary = "Go to page by clicking at the footer option"
	macro goToFooterOption {
		Default.Click(
			key_footerOption = "${footerOption}",
			locator1 = "General#FOOTER_OPTION");
	}

	@summary = "View page is properly loaded"
	macro viewPage {
		if (isSet(headerText)) {
			Default.WaitForVisible(
				key_headerText = "${headerText}",
				locator1 = "General#HEADER_TEXT");
		}

		Default.AssertLocation.assertPartialLocation(value1 = "${partialURL}");
	}

}