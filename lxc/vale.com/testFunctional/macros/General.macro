definition {

	@summary = "Goes to footer section"
	macro gotoFooter {
		Default.ScrollWebElementIntoView(locator1 = "General#FOOTER");

		Default.WaitForVisible(locator1 = "General#FOOTER");
	}

	@summary = "Go to page by clicking at the footer option"
	macro goToFooterOption {
		Default.ScrollWebElementIntoView(
			key_footerOption = "${footerOption}",
			locator1 = "General#FOOTER_OPTION");

		Default.Click.pauseClickAt(
			key_footerOption = "${footerOption}",
			locator1 = "General#FOOTER_OPTION");
	}

	@summary = "Navigate to search section"
	macro gotoSearchPortlet {
		Default.Click(locator1 = "General#SEARCH_ICON");

		Default.WaitForVisible(locator1 = "Search#SEARCH_INPUT");
	}

	@summary = "Choosing a language for the page"
	macro selectLanguage {
		if (Default.IsElementPresent(key_language = "${chosenLanguage}", locator1 = "General#SELECT_LANGUAGE_BUTTON")) {
			Default.Click.pauseClickAt(
				key_language = "${chosenLanguage}",
				locator1 = "General#SELECT_LANGUAGE_BUTTON");
		}

		Default.WaitForVisible(
			key_currentLanguage = "${chosenLanguage}",
			locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
	}

	@summary = "View page is properly loaded"
	macro viewPage {
		if (isSet(headerText)) {
			Default.WaitForVisible(
				key_headerText = "${headerText}",
				locator1 = "General#HEADER_TEXT");
		}

		if (isSet(pageText)) {
			Default.WaitForVisible(
				key_text = "${pageText}",
				locator1 = "General#TEXT_ANY");
		}

		if (isSet(partialURL)) {
			var lowerCasePartialURL = StringUtil.toLowerCase("${partialURL}");

			Default.AssertLocation.assertPartialLocation(value1 = "${lowerCasePartialURL}");
		}
	}

}