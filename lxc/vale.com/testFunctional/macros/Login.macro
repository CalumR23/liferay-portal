definition {

	@summary = "Perform login process"
	macro _signIn {
		if ("${userRole}" == "admin") {
			var loginUserName = PropsUtil.get("test.this.vale.test.account.uat.admin.login");
			var loginUserPassword = PropsUtil.get("test.this.vale.test.account.uat.admin.password");
		}

		Default.WaitForElementPresent(
			key_fieldLabel = "Email Address",
			locator1 = "Login#INPUT_FIELD");

		Default.Type(
			key_fieldLabel = "Email Address",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${loginUserName}");

		Default.Type(
			key_fieldLabel = "Password",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${loginUserPassword}");

		Default.Click(
			key_text = "Sign In",
			locator1 = "Portal.Button#ANY");

		Default.WaitForElementNotPresent(
			key_text = "Sign In",
			locator1 = "Portal.Button#ANY");
	}

	@summary = "Log in to the website as admin user"
	macro loginAsAdminUser {
		Login._signIn(userRole = "admin");
	}

}