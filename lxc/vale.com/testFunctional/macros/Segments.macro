definition {

	@summary = "Select the country experience"
	macro selectCountry {
		General.gotoFooter();

		Default.Click.pauseClickAt(locator1 = "Segments#SELECT_BOX");

		Default.Click.pauseClickAt(
			key_countryName = "${countryName}",
			locator1 = "Segments#SELECT_COUNTRY_DROPDOWN");
	}

	// LXC Refactor: This macro is the one that will be used in the future to assert all the country's available to the user, but since there are some differences in the PROD and MODL enviroment some parts of this macro will not work properly untill those differences are resolved, due to this part of the macro will be commented
	// LXC Refactor ticket: LRQA-78772

	@summary = "Assert the selected country is active"
	macro viewCountry {
		Default.AssertElementPresent(
			key_countryName = "${countryName}",
			locator1 = "Segments#SELECT_COUNTRY_DROPDOWN_ACTIVE");

		if ("${countryName}" == "BRAZIL") {

			//Default.AssertElementPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "pt-BR",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
		else {

			//Default.AssertElementNotPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "en-US",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
	}

	// LXC Refactor: This macro is a workaround due to a problem that was found when changing the country experience for indonesia, the only country that is possible to assert the experience actually changed, but the dropdown to navigate through experience's doesn't appear in this especific country.
	// LXC Refactor ticket: LRQA-78772

	@summary = "Assert the Indonesia country is active"
	macro viewIndonesiaExperience {
		Default.AssertElementPresent(locator1 = "Segments#INDONESIA_SECTION");

		Default.AssertElementPresent(locator1 = "Segments#VIEW_INDONESIAN_BUTTON");
	}

}