definition {

	@summary = "Select the country experience"
	macro selectCountry {
		General.gotoFooter();

		Default.Click.pauseClickAt(locator1 = "Segments#SELECT_BOX");

		Default.Click.pauseClickAt(
			key_countryName = "${countryName}",
			locator1 = "Segments#SELECT_COUNTRY_DROPDOWN");
	}

	// LXC Refactor: This macro is planned to validate if the experience site is properly loaded when changing the country in the footer page. 3 validations will be performed: 1. country is active in the dropdown, 2. key lang indicator is set in top of the page, 3. the news are displayed in the selected language. Currently the validation 3 (news) is not possible to be made because the news are not displayed when changing the country.
	// LXC Refactor ticket: LRQA-78978

	@summary = "Assert the selected country is active"
	macro viewCountry {
		if ("${countryName}" == "BRAZIL") {
			Default.AssertElementPresent(
				key_countryName = "${countryName}",
				locator1 = "Segments#SELECT_COUNTRY_DROPDOWN_ACTIVE");

			//Default.AssertElementPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "pt-BR",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
		else if ("${countryName}" == "INDONESIA") {
			Default.AssertElementPresent(locator1 = "Segments#INDONESIA_SECTION");

			Default.AssertElementPresent(locator1 = "Segments#VIEW_INDONESIAN_BUTTON");

			General.viewPage(partialURL = "/indonesia");
		}
		else {
			Default.AssertElementPresent(
				key_countryName = "${countryName}",
				locator1 = "Segments#SELECT_COUNTRY_DROPDOWN_ACTIVE");

			//Default.AssertElementNotPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "en-US",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
	}

}