definition {

	@summary = "Select the country experience"
	macro selectCountry {
		General.gotoFooter();

		Default.Click.pauseClickAt(locator1 = "Segments#SELECT_BOX");

		Default.Click.pauseClickAt(
			key_countryName = "${countryName}",
			locator1 = "Segments#SELECT_COUNTRY_DROPDOWN");
	}

	@summary = "Assert the selected country is active"
	macro viewCountry {
		Default.AssertElementPresent(
			key_countryName = "${countryName}",
			locator1 = "Segments#SELECT_COUNTRY_DROPDOWN_ACTIVE");

		if ("${contryName}" == "BRAZIL") {
			Default.AssertElementPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "pt-BR",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
		else {
			Default.AssertElementNotPresent(locator1 = "Segments#BRAZLIAN_NEWS");

			Default.AssertElementPresent(
				key_currentLanguage = "en-US",
				locator1 = "General#CURRENT_LANGUAGE_INDICATOR");
		}
	}

}