definition {

	@summary = "Open portal"
	macro launchInfraJournalPortal {
		var portalURL = PropsUtil.get("test.this.infrajournal.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

	macro tearDown {
		IJUtils.launchInfraJournalPortal();

		if (Default.IsElementPresent(locator1 = "IJHomePage#CAROUSEL_ITEM_NUMBER_8")) {
			var itemName = selenium.getText("IJHomePage#CAROUSEL_ITEM_NUMBER_8");

			IJAdmin.removeCarouselItem(itemName = "${itemName}");
		}
	}

}