definition {

	macro assertSearchResults {
		var resultLowerCase = StringUtil.lowerCase("${resultName}");

		for (var resultQuantity : list "1,2,3,4,5") {
			Default.AssertElementPresent(
				key_index = "${resultQuantity}",
				key_lowerCaseResultName = "${resultLowerCase}",
				key_upperCaseResultName = "${resultName}",
				locator1 = "ATLSearch#SEARCH_RESULTS");
		}
	}

	macro searchTerm {
		Default.Click(locator1 = "ATLSearch#SEARCH_ICON");

		Default.Type(
			locator1 = "ATLSearch#SEARCH_FIELD",
			value1 = "${searchTerm}");

		Default.KeyPress(
			locator1 = "ATLSearch#SEARCH_FIELD",
			value1 = "\ENTER");
	}

}