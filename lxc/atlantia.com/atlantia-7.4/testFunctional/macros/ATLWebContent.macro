definition {

	macro addArticle {
		ATLWebContent.gotoAddWithStructureCP(structureName = "Article");

		Portal.AssetCategorization.addCategory(
			categoryName = "${tagName}",
			vocabularyName = "Categories");

		Portal.WebContent.addWithStructureCP(webContentTitle = "${webContentTitle}");

		Default.Click(
			fieldLabel = "Image - Image Preview",
			key_index = "1",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.Click(
			key_navTab = "Documents and Media",
			locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

		Portal.Search.searchCP(searchTerm = ".jpg");

		Portal.LexiconCard.clickCard(card = ".jpg");

		Default.SelectFrameTop();

		Default.Click(
			key_imageType = "Image",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION");

		Default.Type(
			key_imageType = "Image",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION",
			value1 = "Image Description");

		Portal.PortletEntry.publish();
	}

	macro addCarouselItem {
		Default.Click(locator1 = "ATLWebContent#PLUS_BUTTON");

		Default.Type(
			key_index = "2",
			locator1 = "ATLWebContent#BANNER_NEW_TITLE",
			value1 = "${itemName}");

		Default.Click(
			fieldLabel = "Image Desktop",
			key_index = "2",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.Click(
			key_navTab = "Documents and Media",
			locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

		Portal.Search.searchCP(searchTerm = "carosello.jpg");

		Portal.LexiconCard.clickCard(card = "carosello.jpg");

		Default.SelectFrameTop();

		Default.Click(
			key_imageType = "ImageDesktop",
			key_index = "4",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION");

		Default.Type(
			key_imageType = "ImageDesktop",
			key_index = "4",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION",
			value1 = "${itemName} Description");

		Default.Click(
			fieldLabel = "Image Mobile",
			key_index = "2",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.Click(
			key_navTab = "Documents and Media",
			locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

		Portal.Search.searchCP(searchTerm = "carosello.jpg");

		Portal.LexiconCard.clickCard(card = "carosello.jpg");

		Default.SelectFrameTop();

		Default.Click(
			key_imageType = "ImageMobile",
			key_index = "6",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION");

		Default.Type(
			key_imageType = "ImageMobile",
			key_index = "6",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION",
			value1 = "${itemName} Description");

		Portal.Button.clickPublish();

		Portal.Alert.viewSuccessMessage();
	}

	macro addMember {
		Default.Type(
			key_fieldLabel = "Name",
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT",
			value1 = "${memberName}");

		Default.Type(
			key_fieldLabel = "Position",
			locator1 = "Portal.TextInput#GENERIC_TEXT_INPUT",
			value1 = "${memberName}");

		Default.Click(
			locator1 = "Portal.Radio#ANY",
			radioLabel = "${roleName}");

		Default.Click(
			fieldLabel = "Photo",
			key_index = "1",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.ItemSelector#ITEM_SELECTOR_IFRAME");

		Default.Click(
			key_navTab = "Documents and Media",
			locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

		Portal.Search.searchCP(searchTerm = "Logo_Atlantia.png");

		Portal.LexiconCard.clickCard(card = "Logo_Atlantia.png");

		Default.SelectFrameTop();

		Default.Click(
			fieldLabel = "Bio PDF",
			key_index = "1",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.ItemSelector#ITEM_SELECTOR_IFRAME");

		Portal.Search.searchCP(searchTerm = ".pdf");

		Portal.LexiconCard.clickCard(card = ".pdf");

		Default.SelectFrameTop();

		Default.Click(
			key_imageType = "Photo",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION");

		Default.Type(
			key_imageType = "Photo",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION",
			value1 = "Image Description");

		Portal.Button.clickPublish();
	}

	macro addStorie {
		ATLWebContent.gotoAddWithStructureCP(structureName = "Stories");

		Portal.AssetCategorization.addCategory(
			categoryName = "${tagName}",
			vocabularyName = "Tags Stories");

		Portal.WebContent.addWithStructureCP(webContentTitle = "${webContentTitle}");

		Default.Click(
			fieldLabel = "Image",
			key_index = "1",
			locator1 = "ATLWebContent#BUTTON_LABEL",
			text = "Select");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.Click(
			key_navTab = "Documents and Media",
			locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

		Portal.Search.searchCP(searchTerm = "carosello.jpg");

		Portal.LexiconCard.clickCard(card = "carosello.jpg");

		Default.SelectFrameTop();

		Default.Click(
			key_imageType = "Image",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION");

		Default.Type(
			key_imageType = "Image",
			key_index = "1",
			locator1 = "ATLWebContent#IMAGE_DESCRIPTION",
			value1 = "Image Description");

		Portal.PortletEntry.publish();
	}

	macro gotoAddWithStructureCP {
		Default.WaitForPageLoad();

		while (Default.IsElementNotPresent(key_text = "More", locator1 = "Portal.Button#ANY")) {
			Portal.Click(locator1 = "Portal.Button#PLUS");
		}

		Default.SelectFrameTop();

		if (Default.IsElementPresent(key_menuItem = "${structureName}", locator1 = "Portal.MenuItem#ANY_MENU_ITEM")) {
			Portal.MenuItem.click(menuItem = "${structureName}");
		}
		else {
			Portal.Button.clickMore();

			Portal.IFrame.selectConfigurationFrame();

			Portal.LexiconEntry.gotoEntry(rowEntry = "${structureName}");

			Portal.IFrame.selectTopFrame();
		}
	}

}