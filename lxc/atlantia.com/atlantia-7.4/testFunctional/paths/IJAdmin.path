<html>
<head>
<title>IJAdmin</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">IJAdmin</td></tr>
</thead>

<tbody>

<!--PAGE_EDITOR-->

<tr>
	<td>ASSET_PUBLISHER_FRAME</td>
	<td>//iframe[contains(@title,'Asset Publisher')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_PUBLISHER_REMOVE_ITEM</td>
	<td>//span[contains(.,'${key_itemName}')]//ancestor::tr//td//span//a</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_PUBLISHER_SAVE_BUTTON</td>
	<td>//span[@class='lfr-btn-label' and contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ELLIPSIS</td>
	<td>//menu[contains(@id,'gpgb')]//*[contains(@class,'ellipsis')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_EDITOR</td>
	<td>//span[contains(@class,'tooltip')]//*[contains(@class,'icon-pencil')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>xpath=(//div[contains(@class,'btn-group')]//a[contains(@title,'Select')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>