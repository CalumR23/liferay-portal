<html>
<head>
<title>ATLCategory</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLCategory</td></tr>
</thead>

<tbody>
<tr>
	<td>ARTICLE_CATEGORY</td>
	<td>//h3[contains(.,'${key_articleTitle}')]//ancestor::a//following-sibling::div//span[contains(@class,'tag-item') and contains(.,'${key_articleTag}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_DROPDOWN</td>
	<td>//a[contains(@aria-controls,'panel-categ')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECTED_CATEGORY</td>
	<td>//div[@id='selectedCategory' and contains(.,'${key_categoryName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_ARTICLE</td>
	<td>//div[contains(@class,'story-tag')]//span[contains(@class,'tag-item')]//a[contains(.,'${key_tagName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_ARTICLE_INDEX</td>
	<td>xpath=(//div[contains(@class,'story-tag')]//span[contains(@class,'tag-item')]//a[contains(.,'${key_tagName}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_LIST</td>
	<td>//ul[contains(@class,'tag-list')]//a[contains(.,'${key_categoryName}')]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_NAME</td>
	<td>//span[contains(@class,'tag-items') and contains(.,'${key_tagName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>