<html>
<head>
<title>IJNavigation</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">IJNavigation</td></tr>
</thead>

<tbody>
<tr>
	<td>MENU_BUTTON</td>
	<td>//button[@id='hamNav']</td>
	<td></td>
</tr>
<tr>
	<td>MENU_ITEM</td>
	<td>//li//a[@class='lfr-nav-item open' and contains(.,'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_TITLE</td>
	<td>//div[@class='page-title' and contains(.,'${key_pageTitle}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>