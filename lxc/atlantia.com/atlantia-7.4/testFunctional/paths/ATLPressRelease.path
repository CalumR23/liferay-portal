<html>
<head>
<title>ATLPressRelease</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLPressRelease</td></tr>
</thead>

<tbody>

<tr>
	<td>DAY_SELECT</td>
	<td>xpath=(//div[contains(@class,'flatpickr-days')]//span[not(contains(@class,'prevMonthDay')) and contains(@class,'flatpickr-day')][normalize-space()='${key_day}']//parent::span[not(contains(@class,'nextMonthDay'))])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD_ICON</td>
	<td>//input[contains(@aria-label,'To Date')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_YEAR</td>
	<td>//div[contains(@class,'swiper-wrapper')]//div//a[contains(.,'${key_yearFilter}')]</td>
	<td></td>
</tr>
<tr>
	<td>FROM_DATE_INPUT</td>
	<td>//input[contains(@aria-label,'From Date')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>MONTH_DROPDOWN</td>
	<td>xpath=(//select[contains(@class,'flatpickr-monthDropdown-months')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BAR</td>
	<td>//input[contains(@aria-label,'Search text')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[@id='btnricerca']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_CONTENT</td>
	<td>xpath=(//div[contains(@class,'press-row')]//div//a[contains(.,'${key_tableContent}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_DATE</td>
	<td>xpath=(//div[contains(@class,'press-row')]//following-sibling::strong[contains(.,'${key_tableDate}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>TO_DATE_INPUT</td>
	<td>//input[contains(@aria-label,'To Date')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>YEAR_FIELD</td>
	<td>xpath=(//select//following-sibling::div//input[contains(@class,'cur-year')])[${key_index}]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>