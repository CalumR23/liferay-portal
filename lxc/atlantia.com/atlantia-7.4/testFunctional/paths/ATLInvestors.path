<html>
<head>
<title>ATLInvestors</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLInvestors</td></tr>
</thead>

<tbody>

<!--SHAREHOLDERS-->

<tr>
	<td>ACTIVE_DIAGRAM_ITEM</td>
	<td>//*[contains(@class,'gigarc')]</td>
	<td></td>
</tr>
<tr>
	<td>DIAGRAM_ITEM</td>
	<td>//div[contains(@class,'itmlbl')]//div[contains(@class,'txtlbl') and contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>COLLAPSED_CARD_HEADER</td>
	<td>//div[contains(@class,'collapse show')]//preceding-sibling::div[contains(@class,'card-header')]//div[contains(.,'${key_cardName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_ITEM</td>
	<td>//div[contains(@class,'doculinks')]//a[contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>

<!--SHARE_PERFORMANCE-->

<tr>
	<td>PERFORMANCE_CHART_RANGE</td>
	<td>//*[local-name()='svg']//*[local-name()='text' and contains(.,'${key_chartRange}')]</td>
	<td></td>
</tr>
<tr>
	<td>PERFORMANCE_CHART_FILTER</td>
	<td>//nav[contains(@class,'chartPeriod')]//li[contains(.,'${key_filterName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CHART_FRAME</td>
	<td>//iframe[contains(@id,'stockFrame')]</td>
	<td></td>
</tr>
<tr>
	<td>ATLANTIA_SCORE</td>
	<td>//iframe[contains(@id,'stockFrame')]</td>
	<td></td>
</tr>

<!--RATING-->

<tr>
	<td>RATING_TABLE</td>
	<td>//div[contains(@data-analytics-asset-title,'Rating table')]//table//th[normalize-space()='${key_tableItem}']</td>
	<td></td>
</tr>
<tr>
	<td>PLUS_BUTTON</td>
	<td>//span[contains(@class,'enlarge')]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//th[contains(@class,'addplus')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>