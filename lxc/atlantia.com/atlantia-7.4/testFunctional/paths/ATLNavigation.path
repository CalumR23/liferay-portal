<html>
<head>
<title>ATLNavigation</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLNavigation</td></tr>
</thead>

<tbody>
<tr>
	<td>MAIN_MENU_ITEM</td>
	<td>//nav[contains(@id,'navigation')]//li//a[contains(@class,'sub_nav') and contains(.,'${key_mainMenuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_MENU_SUB_ITEM</td>
	<td>//div[contains(@class,'in_view')]//div[contains(@class,'mainmenu_submenu')]//span[contains(.,'${key_mainMenuSubItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>TOP_MENU_ITEM</td>
	<td>//div[contains(@class,'top_menu')]//a[contains(@class,'top_menu_link') and contains(.,'${key_topMenuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>TOP_MENU_SUB_ITEM</td>
	<td>//div[contains(@class,'top_menu_submenu in_view')]//li//a[contains(.,'${key_topSubMenuItem}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>