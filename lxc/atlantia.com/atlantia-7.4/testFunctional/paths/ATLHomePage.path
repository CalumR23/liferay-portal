<html>
<head>
<title>ATLHomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLHomePage</td></tr>
</thead>

<tbody>

<tr>
	<td>TRANSLATE_PAGE</td>
	<td>//div[contains(@class,'topper_lang')]//a[contains(.,'${key_translateItem}')]</td>
	<td></td>
</tr>

<!--PRESS_RELEASE-->

<tr>
	<td>PRESS_RELEASE_FIRST_DATE</td>
	<td>xpath=(//div[contains(@class,'boxinvest_item')]//div)[1]</td>
	<td></td>
</tr>
<tr>
	<td>PRESS_RELEASE_SECOND_DATE</td>
	<td>xpath=(//div[contains(@class,'boxinvest_item')]//div)[2]</td>
	<td></td>
</tr>

<!--CAROUSEL-->

<tr>
	<td>CAROUSEL_ITEM</td>
	<td>//div[contains(@class,'slide_cont')]//div[contains(@class,'h1') and contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ITEM_ARROW</td>
	<td>//div[contains(@class,'h1') and contains(.,'${key_itemName}')]//following-sibling::a[contains(@class,'icon')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ITEM_NUMBER</td>
	<td>//div[@data-analytics-asset-title='Banner Emotional HP']//div[@aria-label='${key_itemNumber} / ${key_totalNumber}']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ITEM_NUMBER_2</td>
	<td>//div[@data-analytics-asset-title='Banner Emotional HP']//div[@aria-label='2 / 5']</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHT_ITEM</td>
	<td>//div[contains(@class,'highlight')]//div[contains(@class,'mt-2') and contains(.,'${key_highlightItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>STORIE_ITEM_NUMBER</td>
	<td>//div[contains(@class,'swiper-horizontal')]//div[@aria-label='${key_itemNumber} / ${key_totalNumber}']</td>
	<td></td>
</tr>
<tr>
	<td>STORY_ITEM</td>
	<td>//div[contains(@class,'story_slide')]//div[contains(.,'${key_storyTitle}')]//a[contains(@class,'h3')]</td>
	<td></td>
</tr>

<!--GENERAL_MEETINGS-->

<tr>
	<td>GENERAL_MEETINGS_FIRST_DATE</td>
	<td>xpath=(//div[contains(@class,'col-lg-6')]//div[contains(@class,'lbl mb-2')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>GENERAL_MEETINGS_SECOND_DATE</td>
	<td>xpath=(//div[contains(@class,'col-lg-6')]//div[contains(@class,'lbl mb-2')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>