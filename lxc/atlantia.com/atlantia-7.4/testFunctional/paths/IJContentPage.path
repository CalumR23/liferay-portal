<html>
<head>
<title>IJContentPage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">IJContentPage</td></tr>
</thead>

<tbody>
<tr>
	<td>ARTICLE_CATEGORY</td>
	<td>//p[@class='article-categories']//span[@class='cat-item']</td>
	<td></td>
</tr>
<tr>
	<td>SOCIAL_MEDIA_ICON</td>
	<td>//div[contains(@class,'article-social')]//a[@id='${key_socialMedia}']</td>
	<td></td>
</tr>

<!--MORE_LIKE_THIS_ARTICLE_IMAGE_BY_INDEX-->

<tr>
	<td>ARTICLE_BY_INDEX</td>
	<td>xpath=(//div//h4[contains(text(),'More like this')]/..//div[contains(@class,'article-content')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_CATEGORY_BY_INDEX</td>
	<td>xpath=(//div[contains(@class,'article-content')]//div[contains(@class,'article-tag') and contains (normalize-space(.),'${key_categoryName}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_IMAGE_BY_INDEX</td>
	<td>xpath=(//div[@class='article-content']//div[@class='article-image'])[${key_index}]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>