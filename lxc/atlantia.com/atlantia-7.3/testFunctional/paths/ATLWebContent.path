<html>
<head>
<title>ATLWebContent</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLWebContent</td></tr>
</thead>

<tbody>

<tr>
	<td>BANNER_NEW_TITLE</td>
	<td>xpath=(//input[contains(@id,'JournalPortlet_Title')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_LABEL</td>
	<td>xpath=(//div[./label[normalize-space(text())='${fieldLabel}']]//button[normalize-space()='${text}'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>IMAGE_DESCRIPTION</td>
	<td>xpath=(//label[normalize-space(text())='Image Description']//following::input[contains(@id,'${key_imageType}')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PLUS_BUTTON</td>
	<td>//*[contains(@class,'button')]//*[contains(@class,'icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_BUTTON</td>
	<td>//input[contains(@value,'${key_itemName}')]//following::a[contains(@class,'delete-button')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>