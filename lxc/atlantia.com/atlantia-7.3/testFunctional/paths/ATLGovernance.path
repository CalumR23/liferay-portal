<html>
<head>
<title>ATLGovernance</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLGovernance</td></tr>
</thead>

<tbody>

<!--CONTROL_SYSTEM-->

<tr>
	<td>CLOSE_POPUP</td>
	<td>//div[contains(@class,'popup in_view')]//button[contains(@class,'close_menu')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTROL_SYSTEM_IMAGE</td>
	<td>//*[local-name()='svg']//*[local-name()='text' and contains(.,'${key_imageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTROL_SYSTEM_POPUP</td>
	<td>//div[contains(@class,'popup in_view')]//h3[contains(.,'${key_imageName}')]//following-sibling::p[contains(.,'${key_imageContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>POPUP_LINK</td>
	<td>//div[contains(@class,'popup in_view')]//a</td>
	<td></td>
</tr>

<!--BOARD_OF_DIRECTORS-->

<tr>
	<td>BOARD_OF_DIRECTORS_ACTIVE_DROPDOWN</td>
	<td>//div[contains(@class,'members-group') and contains(@id,'${key_filterName}') and not(@style='display: none;')]</td>
	<td></td>
</tr>
<tr>
	<td>BOARD_OF_DIRECTORS_DROPDOWN</td>
	<td>//select[@id='selgruppi']</td>
	<td></td>
</tr>
<tr>
	<td>BOARD_OF_DIRECTORS_MEMBER</td>
	<td>xpath=(//div[contains(@class,'thumb')]/following-sibling::h3[contains(.,'${key_memberName}')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>