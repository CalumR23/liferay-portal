<html>
<head>
<title>IJHomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">IJHomePage</td></tr>
</thead>

<tbody>

<!--CAROUSEL-->

<tr>
	<td>CAROUSEL_ITEM</td>
	<td>//div[(@id='fragment-0-gpgb')]//h3[contains(@class,'article-title') and contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ITEM_NUMBER</td>
	<td>//div[contains(@class,'swiper-slide') and contains(@aria-label,'${key_itemNumber} / ${key_totalNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ITEM_NUMBER_8</td>
	<td>//div[contains(@class,'swiper-slide') and contains(@aria-label,'8 / 8')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_PORLET</td>
	<td>//div[(@id='fragment-0-gpgb')]</td>
	<td></td>
</tr>
<tr>
	<td>MOST_POPULAR_BUTTON</td>
	<td>//div[contains(@class,'most-popular')]</td>
	<td></td>
</tr>
<tr>
	<td>MOST_POPULAR_CARD</td>
	<td>//div[contains(@class,'most-popular')]//div[@style='display: block;']</td>
	<td></td>
</tr>
<tr>
	<td>MOST_POPULAR_CLOSE</td>
	<td>//div[contains(@class,'most-popular')]//span[contains(@class,'buttonClose')]</td>
	<td></td>
</tr>
<tr>
	<td>MOST_SHARED_BUTTON</td>
	<td>//div[contains(@class,'most-shared')]</td>
	<td></td>
</tr>
<tr>
	<td>MOST_SHARED_CARD</td>
	<td>//div[contains(@class,'most-shared')]//div[@style='display: block;']</td>
	<td></td>
</tr>
<tr>
	<td>MOST_SHARED_CLOSE</td>
	<td>//div[contains(@class,'most-shared')]//span[contains(@class,'buttonClose')]</td>
	<td></td>
</tr>

<!--EDITORS_HUB-->

<tr>
	<td>EDITORS_HUB_ARTICLE_BY_INDEX</td>
	<td>xpath=(//section[@id='artEditorHub']//a[@class='linkarticleHub'])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>MEDIA_HUB_ARTICLE</td>
	<td>//div[@id='artMediaHub']//div[@class='article-content']</td>
	<td></td>
</tr>
<tr>
	<td>MEDIA_HUB_ARTICLES_IMAGE</td>
	<td>//div[@id='artMediaHub']//div[@class='article-image']</td>
	<td></td>
</tr>

<!--SLIDES_ARTICLES-->

<tr>
	<td>GREEN_SLIDE_ARTICLE</td>
	<td>//div[@id='swiperCardsuqiq']//div//h3</td>
	<td></td>
</tr>
<tr>
	<td>HOME_PAGE_ARTICLE</td>
	<td>//div[@id='swiperCardsuqiq']//div//h3[normalize-space(text())='${key_articleName}']</td>
	<td></td>
</tr>
<tr>
	<td>SLIDE_ARROW_NAVIGATOR</td>
	<td>//div[@class='leftslide']//a[contains(.,'${key_slideName}')]/../..//p//following-sibling::div[contains(@class,'arrow${key_arrowSlide}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>