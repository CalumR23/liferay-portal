<html>
<head>
<title>ATLSearch</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLSearch</td></tr>
</thead>

<tbody>

<tr>
	<td>NO_RESULTS</td>
	<td>//div[contains(@class,'no-results')]//h2[contains(.,'No search results with keyword ${key_searchTerm}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@placeholder,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_ICON</td>
	<td>//a[contains(@data-menu,'search')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULTS</td>
	<td>xpath=(//div[contains(@id,'results')]//em[contains(.,'${key_lowerCaseResultName}')] | //em[contains(.,'${key_upperCaseResultName}')])[${key_index}] | (//a[contains(@class,'title') and contains(.,'${key_lowerCaseResultName}')] | //a[contains(@class,'title') and contains(.,'${key_upperCaseResultName}')])[${key_index}]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>