<html>
<head>
<title>ATLAboutUs</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ATLAboutUs</td></tr>
</thead>

<tbody>

<!--EXPLORE_ATLANTIA-->

<tr>
	<td>ARTICLE_EXPLORE_ATLANTIA</td>
	<td>//div[contains(@class,'story-content')]//h3[contains(.,'${key_articleName}')]</td>
	<td></td>
</tr>

<!--OUR_MANAGERS-->

<tr>
	<td>DOWNLOAD_BIO</td>
	<td>//a[contains(text(),'Download bio')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER</td>
	<td>//div//a[contains(@class,'stretched-link') and contains(.,'${key_managerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_IMG</td>
	<td>//div//img[contains(@src,'${key_managerLastName}')]//following::div[contains(@class,'h4') and contains(.,'${key_managerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_NAME</td>
	<td>//div[contains(@class,'h4') and contains(.,'${key_managerName}')]//ancestor::div//img[contains(@src,'${key_managerLastName}')]</td>
	<td></td>
</tr>
<tr>
	<td>MANAGER_ROLE</td>
	<td>//div[contains(@class,'h4') and contains(.,'${key_managerName}')]//following-sibling::div[contains(.,'${key_managerRole}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>