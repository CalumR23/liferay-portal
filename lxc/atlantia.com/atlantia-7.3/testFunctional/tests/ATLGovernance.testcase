definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal();
		}
	}

	tearDown {
		ATLUtils.tearDown();
	}

	@description = "Verify that there is a link to another page on the popup"
	@refactor
	test LinkIsAvailableOnPopup {
		
		// ATL Refactor: The link is not complete when running it locally, it is needed to make a change with the macro ATLUtils.formatURL.
		// ATL Refactor ticket: ATU2206-142

		task ("Given user go to Governance System") {
			ATLNavigator.goToTopMenu(
				menuItemName = "Governance",
				subItemName = "Governance system");
		}

		task ("When user click in Popup link") {
			ATLGovernance.viewControlSystemItem(
				imageContent = "The Committee makes proposals and advises the Board on social and environmental sustainability issues.",
				imageName = "Sustainability");

			//Default.Click(locator1 = "ATLGovernance#POPUP_LINK");

		}

		task ("Then will be redirected to link page") {
			ATLUtils.formatURL(passedURL = "//div[contains(@class,'popup in_view')]//a");

			Default.AssertElementPresent(
				key_title = "Sustainability Committee",
				locator1 = "Portal.Header#H1_TITLE");
		}
	}

}