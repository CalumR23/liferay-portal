definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal(infraJournal = "true");
		}

		Default.Click(
			key_itemName = "Mobility as a social inclusion driver in cities",
			locator1 = "IJHomePage#CAROUSEL_ITEM");
	}

	tearDown {
		IJUtils.tearDown();
	}

	@description = "Verify that the 'More like this' section displays 4 items"
	test MoreLinksDisplays4Items {
		task ("Given that article page have only 4 related articles") {
			for (var count : list "1,2,3,4") {
				Default.AssertElementPresent(
					key_index = "${count}",
					locator1 = "IJContentPage#ARTICLE_BY_INDEX");
			}
		}

		task ("Then a fifth article will be not found") {
			Default.AssertElementNotPresent(
				key_index = "5",
				locator1 = "IJContentPage#ARTICLE_BY_INDEX");
		}
	}

	@description = "Verify that the 'More like this' section displayes items from the same category"
	test MoreLinksDisplaysItemsFromSameCategory {
		task ("Get the first article category") {
			Default.WaitForElementPresent(locator1 = "IJContentPage#ARTICLE_CATEGORY");

			var articleCategory = selenium.getText("IJContentPage#ARTICLE_CATEGORY");

			var articleCategory = StringUtil.extractFirst("${articleCategory}", " ");
		}

		task ("Verify that related article has the same category") {
			Default.AssertElementPresent(
				key_categoryName = "${articleCategory}",
				key_index = "1",
				locator1 = "IJContentPage#ARTICLE_CATEGORY_BY_INDEX");
		}
	}


}