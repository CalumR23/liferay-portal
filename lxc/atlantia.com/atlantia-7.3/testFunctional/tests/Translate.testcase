definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal();
		}
	}

	tearDown {
		ATLUtils.tearDown();
	}

    @description = "Verify if when change site language, the site content will be translated"
    test CanTranslateToItalianAndBackToEnglish {
        task ("Given user change site language to Italiano") {
            ATLUtils.changeSiteLanguage(translateItem = "Italiano");
        }

        task ("Then all site is translated") {
            ATLUtils.verifySiteLanguage(
                afterTranslateMenuItem = "Chi siamo,Mobilità,Sostenibilità,Lavora con noi",
                beforeTranslateMenuItem = "About Us,Mobility,Sustainability,Careers",
                afterTranslateSubItem = "Il Gruppo,Business Aeroportuale,Transparenza,Opportunità",
                beforeTranslateCarousel = "Our Climate Action Plan",
                afterTranslateCarousel = "Il nostro Climate Action Plan",
                beforeTranslateStory = "Atlantia4Ukraine: on June 13 starts the Summer Camp dedicated to Ukrainian families arrived in Rome in recent months",
                afterTranslateStory = "Atlantia4Ukraine: al via dal 13 giugno il Summer Camp dedicato alle famiglie urcaine arrivate a Roma negli ultimi mesi",
                beforeTranslateHighlightItem = "concessions in 11 countries",
                afterTranslateHighlightItem = "concessioni in 11 Paesi");
        }

        task ("And given user back site language to English") {
            ATLUtils.changeSiteLanguage(translateItem = "English");

        }
        
        task ("Then the site language backs to English") {
            ATLUtils.verifySiteLanguage(
                beforeTranslateMenuItem = "Chi siamo,Mobilità,Sostenibilità,Lavora con noi",
                afterTranslateMenuItem = "About Us,Mobility,Sustainability,Careers",
                beforeTranslateSubItem = "Il Gruppo,Business Aeroportuale,Transparenza,Opportunità",
                afterTranslateCarousel = "Our Climate Action Plan",
                beforeTranslateCarousel = "Il nostro Climate Action Plan",
                afterTranslateStory = "Atlantia4Ukraine: on June 13 starts the Summer Camp dedicated to Ukrainian families arrived in Rome in recent months",
                beforeTranslateStory = "Atlantia4Ukraine: al via dal 13 giugno il Summer Camp dedicato alle famiglie urcaine arrivate a Roma negli ultimi mesi",
                afterTranslateHighlightItem = "concessions in 11 countries",
                beforeTranslateHighlightItem = "concessioni in 11 Paesi");
            }
    }

    @description = "Verify that Categories are translated when page language is changed"
    @refactor
    test ArticleCategoriesAreTranslated {

        task ("Given user selects an article") {
            Default.WaitForElementPresent(
                key_itemName = "Our Climate Action Plan",
                locator1 = "ATLHomePage#CAROUSEL_ITEM_ARROW");

            //Default.Click(
                //locator1 = "ATLHomePage#CAROUSEL_ITEM_ARROW",
                //key_itemName = "Our Climate Action Plan");

          ATLUtils.formateURL(passedURL = "//div[contains(@class,'h1') and contains(.,'Our Climate Action Plan')]//following-sibling::a[contains(@class,'icon')]");

        }

        task ("And given that the article has a category") {
            ATLUtils.verifyArticleCategory(tagName = "Sustainability");        
        }

        task ("When user change site language"){
            ATLUtils.changeSiteLanguage(translateItem = "Italiano");
        }

        task ("Then the category tag is translated too") {
            ATLUtils.verifyArticleCategory(tagName = "Sostenibilità");

            Default.AssertElementNotPresent(
                locator1 = "ATLCategory#TAG_ARTICLE",
                key_tagName = "Sustainability");
        }
    }

}