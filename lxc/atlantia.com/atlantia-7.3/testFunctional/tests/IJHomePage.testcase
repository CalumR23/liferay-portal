definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal(infraJournal = "true");
		}
	}

	tearDown {
		IJUtils.tearDown();
	}

	@description = "Verify that the user can browse the articles by clicking the arrows"
	test CanBrowseByClickingArrows {
		task ("Given user see the first article from slide") {
			var articleName = selenium.getText("IJHomePage#GREEN_SLIDE_ARTICLE");
		}

		task ("When user clicks on arrow icon to see the next article") {
			Default.Click(
				key_arrowSlide = "Right",
				key_slideName = "Green",
				locator1 = "IJHomePage#SLIDE_ARROW_NAVIGATOR");
		}

		task ("Then the first article from the slide will be not visible anymore") {
			Default.AssertNotVisible(
				key_articleName = "${articleName}",
				locator1 = "IJHomePage#HOME_PAGE_ARTICLE");
		}

		task ("And when user clicks on back arrow icon") {
			Default.Click(
				key_arrowSlide = "Left",
				key_slideName = "Green",
				locator1 = "IJHomePage#SLIDE_ARROW_NAVIGATOR");
		}

		task ("Then the first article will be visible again") {
			Default.AssertVisible(
				key_articleName = "${articleName}",
				locator1 = "IJHomePage#HOME_PAGE_ARTICLE");
		}
	}

	@description = "Verify that the Editor's Hub section displayes 2 (two) articles"
	test CanSeeArticlesOnEditorsHub {
		task ("Given that Editor's Hub section has only two articles") {
			for (var count : list "1,2") {
				Default.AssertElementPresent(
					key_index = "${count}",
					locator1 = "IJHomePage#EDITORS_HUB_ARTICLE_BY_INDEX");
			}
		}

		task ("Then a third article will not be found") {
			Default.AssertElementNotPresent(
				key_index = "3",
				locator1 = "IJHomePage#EDITORS_HUB_ARTICLE_BY_INDEX");
		}
	}

	@description = "Verify that the Most Popular article is displayed when the user clicks on 'Most Popular'"
	test CanSeeMostPopularArticle {
		task ("Given that user clicks in Most Popular button on Carousel") {
			Default.Click(locator1 = "IJHomePage#MOST_POPULAR_BUTTON");
		}

		task ("Then the most popular article will be showed") {
			Default.AssertElementPresent(locator1 = "IJHomePage#MOST_POPULAR_CARD");
		}

		task ("And when user close the card") {
			Default.Click(locator1 = "IJHomePage#MOST_POPULAR_CLOSE");
		}

		task ("Then the card is not displayed anymore") {
			Default.AssertElementNotPresent(locator1 = "IJHomePage#MOST_POPULAR_CARD");
		}
	}

	@description = "Verify that the Most Shared article is displayed when the user clicks on 'Most Shared'"
	test CanSeeMostSharedArticle {
		task ("Given that user clicks in Most Shared button on Carousel") {
			Default.Click(locator1 = "IJHomePage#MOST_SHARED_BUTTON");
		}

		task ("Then the most shared article will be showed") {
			Default.AssertElementPresent(locator1 = "IJHomePage#MOST_SHARED_CARD");
		}

		task ("And when user close the card") {
			Default.Click(locator1 = "IJHomePage#MOST_SHARED_CLOSE");
		}

		task ("Then the card is not displayed anymore") {
			Default.AssertElementNotPresent(locator1 = "IJHomePage#MOST_SHARED_CARD");
		}
	}

	@description = "Verify that the Carousel article can be accessed"
	test CarouselArticlesCanBeAccessed {
		task ("Given carousel article is clicked") {
			Default.WaitForElementPresent(
				key_itemName = "Mobility as a social inclusion driver in cities",
				locator1 = "IJHomePage#CAROUSEL_ITEM");

			Default.Click(
				key_itemName = "Mobility as a social inclusion driver in cities",
				locator1 = "IJHomePage#CAROUSEL_ITEM");
		}

		task ("Then the user is redirected to article page") {
			Default.AssertElementPresent(
				key_title = "Mobility as a social inclusion driver in cities",
				locator1 = "Portal.Header#H1_TITLE");
		}
	}


}