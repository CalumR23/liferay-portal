definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal(infraJournal = "true");
		}
	}

	tearDown {
		IJUtils.tearDown();
	}

	@description = "Verify that the user can browse the articles by clicking the arrows"
	test CanBrowseByClickingArrows {
		task ("Given user see the first article from slide") {
			var articleName = selenium.getText("IJHomePage#GREEN_SLIDE_ARTICLE");
		}

		task ("When user clicks on arrow icon to see the next article") {
			Default.Click(
				key_arrowSlide = "Right",
				key_slideName = "Green",
				locator1 = "IJHomePage#SLIDE_ARROW_NAVIGATOR");
		}

		task ("Then the first article from the slide will be not visible anymore") {
			Default.AssertNotVisible(
				key_articleName = "${articleName}",
				locator1 = "IJHomePage#HOME_PAGE_ARTICLE");
		}

		task ("And when user clicks on back arrow icon") {
			Default.Click(
				key_arrowSlide = "Left",
				key_slideName = "Green",
				locator1 = "IJHomePage#SLIDE_ARROW_NAVIGATOR");
		}

		task ("Then the first article will be visible again") {
			Default.AssertVisible(
				key_articleName = "${articleName}",
				locator1 = "IJHomePage#HOME_PAGE_ARTICLE");
		}
	}



}