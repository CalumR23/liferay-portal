definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal();
		}
	}

	tearDown {
		ATLUtils.tearDown();
	}

    @description = "Verify that articles are filted by category"
    test ArticlesCanBeFilteredByCategory {
        task ("Given user navigate to Explore Atlantia") {
            ATLNavigator.goToMainMenu(
				menuItemName = "About Us",
				subItemName = "Explore Atlantia");
        }

        task ("When user selects a filter") {
            ATLAboutUs.selectCategoryFilter(categoryName = "ADR");
        }

        task ("Then only articles with ADR category will be displayed") {
            ATLAboutUs.viewFilterResults(categoryName = "ADR");
        }
    }

    @description = "Verify that articles can be filtered by clicking on article categorie on articles list"
    @refactor
    test CanFilterByCategoryClickingInArticleTag {
        task ("Given user navigate to Explore Atlantia") {
            ATLNavigator.goToMainMenu(
				menuItemName = "About Us",
				subItemName = "Explore Atlantia");
        }

        task ("When user selects a filter") {
            // Default.Click(
            //     locator1 = "ATLCategory#TAG_ARTICLE",
            //     key_tagName = "Innovation");

            ATLUtils.formateURL(passedURL = "//div[contains(@class,'story-tag')]//span[contains(@class,'tag-item')]//a[contains(.,'Innovation')]");
        }

        task ("Then only articles with ADR category will be displayed") {
            ATLAboutUs.viewFilterResults(categoryName = "Innovation");
        }

    }

    @description = "Verify that a filter can be cleared"
    test CanClearFilter {
        task ("Given user navigate to Explore Atlantia") {
            ATLNavigator.goToMainMenu(
				menuItemName = "About Us",
				subItemName = "Explore Atlantia");
        }

        task ("And given user selects a filter") {
            ATLAboutUs.selectCategoryFilter(categoryName = "ADR");
        }

        task ("When user clear the filter") {
            ATLAboutUs.clearFilter();
        }

        task ("Then the filter is not displayed anymore") {
            Default.AssertElementNotPresent(
                locator1 = "ATLCategory#SELECTED_CATEGORY",
                key_categoryName = "ADR");
        }
    }

    @description = "Verify that articles can be filtered by clicking on categorie on article page"
    @refactor
    test CanFilterArticleByClickingInCategoryOnArticlePage {
        task ("Given user navigate to Explore Atlantia") {
            ATLNavigator.goToMainMenu(
				menuItemName = "About Us",
				subItemName = "Explore Atlantia");
        }

        task ("And given user selects a article") {
            Default.Click(
                locator1 = "ATLAboutUs#ARTICLE_EXPLORE_ATLANTIA",
                key_articleName = "Our Climate Action Plan");
        }

        task ("When user click's on article category") {
            // Default.Click(
            //     locator1 = "ATLCategory#TAG_ARTICLE",
            //     key_tagName = "Sustainability");

            ATLUtils.formateURL(passedURL = "//div[contains(@class,'story-tag')]//span[contains(@class,'tag-item')]//a[contains(.,'Sustainability')]");
        }

        task ("Then the user is redirected to a page with articles that contains the same category") {
            ATLAboutUs.viewFilterResults(categoryName = "Sustainability");
        }
    }
}