definition {

	setUp {
		task ("Open Portal") {
			IJUtils.launchInfraJournalPortal();

			ATLLogin.signIn();
		}
	}

	tearDown {
		IJUtils.launchInfraJournalPortal();

		IJAdmin.removeArticle();
	}

	@description = "Verify that the user can add Categorization to a Web Content Storie"
	test CanAddCategorizationToWebContent {
		task ("Given user add a new Web Content Storie and add a category") {
			Default.WaitForPageLoad();

			Portal.Navigator.openWithAppendToBaseURL(
				baseURL = PropsUtil.get("test.this.atlantia.portal.partial.url"),
				urlAppend = "group/infrajournal/~/control_panel/manage?p_p_id=com_liferay_journal_web_portlet_JournalPortlet");

			ATLWebContent.addArticle(
				tagName = "Green",
				webContentTitle = "Test Article");
		}

		task ("When the user goes to Green section") {
			IJUtils.launchInfraJournalPortal();

			IJNavigator.goToMenu(menuItem = "Green");
		}

		task ("Then the new content is displayed in the selected category") {
			Default.AssertElementPresent(
				key_title = "Test Article",
				locator1 = "Portal.Header#H1_TITLE");
		}
	}

}