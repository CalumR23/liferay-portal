definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal();
		}
	}

	tearDown {
		ATLUtils.tearDown();
	}

    @description = "Verify that Search results are displayed correctly"
	@refactor
    test SearchResultsMatchCorrectly {
        task ("Given user search a term") {
            ATLSearch.searchTerm(searchTerm = "Governance");

			Default.Open(locator1 = "http://192.168.118.10:8080/en/web/guest/search?search=Governance");
        }

		task ("Then the results are displayed correctly on a new page") {
			ATLSearch.assertSearchResults(resultName = "Governance");
		}
    }


}