definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchAtlantiaPortal();
		}
	}

	tearDown {
		ATLUtils.tearDown();
	}

	@description = "Verify that 'No search results' message is displayed"
	@refactor
	test NoSearchResultsMessageIsDisplayed {

		// ATL Refactor: The link is not complete when running it locally, it is needed to make a change with the macro ATLUtils.formatURL.
		// ATL Refactor ticket: ATU2206-142

		task ("Given user search a term that does not exists") {
			ATLSearch.searchTerm(searchTerm = "LXC");

			Default.Open(locator1 = "http://192.168.118.10:8080/en/web/guest/search?search=LXC");
		}

		task ("Then no results message is displayed on a new page") {
			Default.AssertElementPresent(
				key_searchTerm = "LXC",
				locator1 = "ATLSearch#NO_RESULTS");
		}
	}

	@description = "Verify that Search results are displayed correctly"
	@refactor
	test SearchResultsMatchCorrectly {

		// ATL Refactor: The link is not complete when running it locally, it is needed to make a change with the macro ATLUtils.formatURL.
		// ATL Refactor ticket: ATU2206-142

		task ("Given user search a term") {
			ATLSearch.searchTerm(searchTerm = "Governance");

			Default.Open(locator1 = "http://192.168.118.10:8080/en/web/guest/search?search=Governance");
		}

		task ("Then the results are displayed correctly on a new page") {
			ATLSearch.assertSearchResults(resultName = "Governance");
		}
	}

}