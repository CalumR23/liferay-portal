definition {

	setUp {
		task ("Open Portal") {
			ATLUtils.launchPortal();
		}
	}

    tearDown {
        ATLUtils.tearDown();
    }

    @description = "Verify that the Top Menu is displayed with the options: Inverstors, Governance, Media and Download Center"
    test TopMenuIsDisplayed {

        task ("Assert that user can navigate to Investors > Results") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Investors",
                subItemName = "Results");
        }

        task ("Assert that user can navigate to Investors > Rating") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Investors",
                subItemName = "Rating");
        }

        task ("Assert that user can navigate to Investors > Shareholders") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Investors",
                subItemName = "Shareholders");
        }

        task ("Assert that user can navigate to InvestGovernanceors > Board of Directors") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Governance",
                subItemName = "Board of Directors");
        }

        task ("Assert that user can navigate to Governance > Engagement") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Governance",
                subItemName = "Engagement");
        }

        task ("Assert that user can navigate to Governance > Remuneration") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Governance",
                subItemName = "Remuneration");
        }

        task ("Assert that user can navigate to Media > Media Gallery") {
            ATLNavigator.goToTopMenu(
                menuItemName = "Media",
                subItemName = "Media Gallery");
        }
        
    }

    @description = "Verify that the Main Menu is displayed with the options: About Us, Mobility, Sustainability and Careers"
    test MainMenuIsDisplayed {

        task ("Assert that user can navigate to About Us > The Group") {
            ATLNavigator.goToMainMenu(
                menuItemName = "About Us",
                subItemName = "The Group");
        }

        task ("Assert that user can navigate to Mobility > Our partners") {
            ATLNavigator.goToMainMenu(
                menuItemName = "Mobility",
                subItemName = "Our partners");
        }

        task ("Assert that user can navigate to Sustainability > Transparency") {
            ATLNavigator.goToMainMenu(
                menuItemName = "Sustainability",
                subItemName = "Transparency");
        }

        task ("Assert that user can navigate to Careers > Why Atlantia") {
            ATLNavigator.goToMainMenu(
                menuItemName = "Careers",
                subItemName = "Why Atlantia");
        }
        
    }

    @description = "Verify that Search Bar is displayed"
    test SearchBarIsDisplayed {

        task ("Given search icon is clicked") {
            Default.AssertNotVisible(locator1 = "ATLSearch#SEARCH_FIELD");

            Default.Click(locator1 = "ATLSearch#SEARCH_ICON");
        }

        task ("Then search bar will appear") {
            Default.AssertVisible(locator1 = "ATLSearch#SEARCH_FIELD");
        }
        
    }

    @description = "Verify that the Carousel with 4 (four) articles are displayed on page"
    test CarouselIsDisplayed {

        task ("Given that carousel contains only 4 articles") {
            for (var count : list "1,2,3,4") {
                Default.AssertElementPresent(
                    locator1 = "ATLHomePage#CAROUSEL_ITEM_NUMBER",
                    key_itemNumber= "${count}",
                    key_totalNumber = "4");
            }
        }

        task ("Then a fifth article will not be found") {
            Default.AssertElementNotPresent(
                locator1 = "ATLHomePage#CAROUSEL_ITEM_NUMBER",
                key_itemNumber= "1",
                key_totalNumber = "5");
        }
    }

}