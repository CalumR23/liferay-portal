definition {
    macro addCarouselItem {
        Default.Click(locator1 = "ATLWC#PLUS_BUTTON");

        Default.Type(
            locator1 = "ATLWC#BANNER_NEW_TITLE",
            key_index = "2",
            value1 = "${itemName}");

        Default.Click(
            locator1 = "ATLWC#BUTTON_LABEL",
            key_index = "2",
            fieldLabel = "Image Desktop",
            text = "Select");

        Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

        Default.Click(
            key_navTab = "Documents and Media",
            locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

        Portal.Search.searchCP(searchTerm = "carosello.jpg");

        Portal.LexiconCard.clickCard(card = "carosello.jpg");

        Default.SelectFrameTop();

        Default.Click(
            key_index = "4",
            locator1 = "ATLWC#IMAGE_DESCRIPTION",
            key_imageType = "Desktop");

        Default.Type(
            key_index = "4",
            locator1 = "ATLWC#IMAGE_DESCRIPTION",
            key_imageType = "Desktop",
            value1 = "${itemName} Description");

        Default.Click(
            locator1 = "ATLWC#BUTTON_LABEL",
            key_index = "2",
            fieldLabel = "Image Mobile",
            text = "Select");

        Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

        Default.Click(
            key_navTab = "Documents and Media",
            locator1 = "Portal.ItemSelector#NAVIGATION_SPECIFIC_TAB");

        Portal.Search.searchCP(searchTerm = "carosello.jpg");

        Portal.LexiconCard.clickCard(card = "carosello.jpg");

        Default.SelectFrameTop();

        Default.Click(
            key_index = "6",
            locator1 = "ATLWC#IMAGE_DESCRIPTION",
            key_imageType = "Mobile");

        Default.Type(
            key_index = "6",
            locator1 = "ATLWC#IMAGE_DESCRIPTION",
            key_imageType = "Mobile",
            value1 = "${itemName} Description");

        Portal.Button.clickPublish();

        Portal.Alert.viewSuccessMessage();
    }
}