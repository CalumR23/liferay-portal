definition {

	macro goToMainMenu {
		if (isSet(subItemName)) {
			Default.MouseOver(
				key_mainMenuItem = "${menuItemName}",
				locator1 = "ATLNavigation#MAIN_MENU_ITEM");

			if (Default.IsElementNotPresent(key_mainMenuSubItem = "${subItemName}", locator1 = "ATLNavigation#MAIN_MENU_SUB_ITEM")) {
				Default.Refresh();

				Default.MouseOver(
					key_mainMenuItem = "${menuItemName}",
					locator1 = "ATLNavigation#MAIN_MENU_ITEM");
			}

			Default.Click(
				key_mainMenuSubItem = "${subItemName}",
				locator1 = "ATLNavigation#MAIN_MENU_SUB_ITEM");

			Default.WaitForElementPresent(
				key_title = "${subItemName}",
				locator1 = "Portal.Header#H1_TITLE");

			Default.WaitForPageLoad();
		}
		else {
			Default.Click(
				key_mainMenuItem = "${menuItemName}",
				locator1 = "ATLNavigation#MAIN_MENU_ITEM");
		}
	}

	macro goToTopMenu {
		if (isSet(subItemName)) {
			Default.MouseOver(
				key_topMenuItem = "${menuItemName}",
				locator1 = "ATLNavigation#TOP_MENU_ITEM");

			if (Default.IsElementNotPresent(key_mainMenuSubItem = "${subItemName}", locator1 = "ATLNavigation#TOP_MENU_ITEM")) {
				Default.Refresh();

				Default.MouseOver(
					key_topMenuItem = "${menuItemName}",
					locator1 = "ATLNavigation#TOP_MENU_ITEM");
			}

			Default.Click(
				key_topSubMenuItem = "${subItemName}",
				locator1 = "ATLNavigation#TOP_MENU_SUB_ITEM");

			Default.WaitForElementPresent(
				key_title = "${subItemName}",
				locator1 = "Portal.Header#H1_TITLE");
		}
		else {
			Default.Click(
				key_topMenuItem = "${menuItemName}",
				locator1 = "ATLNavigation#TOP_MENU_ITEM");
		}
	}

}