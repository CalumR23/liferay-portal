definition {
    macro goToTopMenu {
        if (isSet(subItemName)) {
            Default.MouseOver(
                locator1 = "ATLNavigation#TOP_MENU_ITEM",
                key_topMenuItem = "${menuItemName}");

            Default.WaitForElementPresent(
                locator1 = "ATLNavigation#TOP_MENU_SUB_ITEM",
                key_topSubMenuItem = "${subItemName}");

            Default.Click(
                locator1 = "ATLNavigation#TOP_MENU_SUB_ITEM",
                key_topSubMenuItem = "${subItemName}");

            Default.WaitForElementPresent(
                locator1 = "Portal.Header#H1_TITLE",
                key_title = "${subItemName}");
        }
        else {
            Default.Click(
                locator1 = "ATLNavigation#TOP_MENU_ITEM",
                key_topMenuItem = "${menuItemName}");
        }
    }

    macro goToMainMenu {
        if (isSet(subItemName)) {
            Default.MouseOver(
                locator1 = "ATLNavigation#MAIN_MENU_ITEM",
                key_mainMenuItem = "${menuItemName}");

            Default.WaitForElementPresent(
                locator1 = "ATLNavigation#MAIN_MENU_SUB_ITEM",
                key_mainMenuSubItem = "${subItemName}");

            Default.Click(
                locator1 = "ATLNavigation#MAIN_MENU_SUB_ITEM",
                key_mainMenuSubItem = "${subItemName}");

            Default.WaitForElementPresent(
                locator1 = "Portal.Header#H1_TITLE",
                key_title = "${subItemName}");

            Default.WaitForPageLoad();
        }
        else {
            Default.Click(
                locator1 = "ATLNavigation#MAIN_MENU_ITEM",
                key_mainMenuItem = "${menuItemName}");
        }
    }
}