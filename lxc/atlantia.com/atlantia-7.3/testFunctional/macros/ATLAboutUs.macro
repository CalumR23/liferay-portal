definition {

	macro clearFilter {
		Default.Click(
			key_text = "CLEAR ALL",
			locator1 = "Portal.Button#ANY_WITH_SPAN");
	}

	macro selectCategoryFilter {
		Default.Click(locator1 = "ATLCategory#FILTER_DROPDOWN");

		Default.Click(
			key_categoryName = "${categoryName}",
			locator1 = "ATLCategory#TAG_LIST");

		Default.AssertElementPresent(
			key_categoryName = "${categoryName}",
			locator1 = "ATLCategory#SELECTED_CATEGORY");
	}

	macro viewFilterResults {
		for (var numberList : list "1, 2, 3") {
			Default.AssertElementPresent(
				key_tagName = "${categoryName}",
				locator1 = "ATLCategory#TAG_ARTICLE");
		}
	}

	macro viewManagerInfo {
		var managerLastName = StringUtil.extractLast("${managerName}", " ");

		Default.AssertElementPresent(
			key_managerLastName = "${managerLastName}",
			key_managerName = "${managerName}",
			locator1 = "ATLAboutUs#MANAGER_NAME");

		Default.AssertElementPresent(
			key_managerLastName = "${managerLastName}",
			key_managerName = "${managerName}",
			locator1 = "ATLAboutUs#MANAGER_IMG");

		Default.AssertElementPresent(
			key_managerName = "${managerName}",
			key_managerRole = "${managerRole}",
			locator1 = "ATLAboutUs#MANAGER_ROLE");
	}

}