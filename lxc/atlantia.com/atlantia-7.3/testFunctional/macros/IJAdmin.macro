definition {

	@summary = "Add a new content on Carousel"
	macro addCarouselItem {
		Default.Click(locator1 = "IJAdmin#PAGE_EDITOR");

		Default.MouseOver(locator1 = "IJHomePage#CAROUSEL_PORLET");

		Default.Click(locator1 = "IJAdmin#CAROUSEL_ELLIPSIS");

		Portal.MenuItem.click(menuItem = "Configuration");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.Click(locator1 = "IJAdmin#SELECT_BUTTON");

		Default.Click(
			key_assetType = "Basic Web Content",
			locator1 = "Portal.AssetLists#ASSET_TYPE_DROPDOWN_ITEM");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Portal.LexiconEntry.selectEntry(rowEntry = "${entryName}");

		Default.SelectFrameTop();

		Default.SelectFrame(locator1 = "IJAdmin#ASSET_PUBLISHER_FRAME");

		Portal.Button.clickAdd();

		Default.Click(locator1 = "IJAdmin#ASSET_PUBLISHER_SAVE_BUTTON");

		Portal.Alert.viewSuccessMessage();

		Portal.Button.clickSave();

		Portal.SelectFrameTop();

		Default.Click(locator1 = "Portal.Modal#CLOSE_BUTTON");

		Portal.Button.clickPublish();
	}

}