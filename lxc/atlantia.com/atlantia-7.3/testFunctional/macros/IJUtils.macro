definition {

	macro tearDown {
		ATLUtils.launchPortal(infraJournal = "true");

		if (Default.IsElementPresent(locator1 = "IJHomePage#CAROUSEL_ITEM_NUMBER_8")) {
			var itemName = selenium.getText("IJHomePage#CAROUSEL_ITEM_NUMBER_8");

			IJAdmin.removeCarouselItem(itemName = "${itemName}");
		}
	}

}