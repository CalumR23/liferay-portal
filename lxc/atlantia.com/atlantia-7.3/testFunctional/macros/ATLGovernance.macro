definition {

	macro viewControlSystemItem {
		Default.Click(
			key_imageName = "${imageName}",
			locator1 = "ATLGovernance#CONTROL_SYSTEM_IMAGE");

		Default.AssertElementPresent(
			key_imageContent = "${imageContent}",
			key_imageName = "${imageName}",
			locator1 = "ATLGovernance#CONTROL_SYSTEM_POPUP");
	}

}