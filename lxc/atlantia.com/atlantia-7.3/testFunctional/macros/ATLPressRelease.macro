definition {

	macro selectDate {
		if (isSet(fromDay)) {
			Default.Click(locator1 = "ATLPressRelease#FROM_DATE_INPUT");

			Default.Type(
				key_index = "1",
				locator1 = "ATLPressRelease#YEAR_FIELD",
				value1 = "${fromYear}");

			Default.Select(
				key_index = "1",
				locator1 = "ATLPressRelease#MONTH_DROPDOWN",
				value1 = "${fromMonth}");

			Default.Click(
				key_day = "${fromDay}",
				key_index = "1",
				locator1 = "ATLPressRelease#DAY_SELECT");

			Default.Click(locator1 = "ATLPressRelease#SEARCH_BUTTON");
		}

		if (isSet(toDay)) {
			Default.Click(locator1 = "ATLPressRelease#TO_DATE_INPUT");

			Default.Type(
				key_index = "2",
				locator1 = "ATLPressRelease#YEAR_FIELD",
				value1 = "${toYear}");

			Default.Select(
				key_index = "2",
				locator1 = "ATLPressRelease#MONTH_DROPDOWN",
				value1 = "${toMonth}");

			Default.Click(
				key_day = "${toDay}",
				key_index = "2",
				locator1 = "ATLPressRelease#DAY_SELECT");

			Default.Click(locator1 = "ATLPressRelease#SEARCH_BUTTON");
		}
	}

	macro viewTableItemYear {
		for (var listNumber : list "1,2,3,4,5") {
			Default.AssertElementPresent(
				key_index = "${listNumber}",
				key_tableDate = "${tableDate}",
				locator1 = "ATLPressRelease#TABLE_DATE");
		}
	}

	macro viewTableResultsTerm {
		for (var listNumber : list "1,2,3,4,5") {
			Default.AssertElementPresent(
				key_index = "${listNumber}",
				key_tableContent = "${searchedTerm}",
				locator1 = "ATLPressRelease#TABLE_CONTENT");
		}
	}

}