definition {

	@summary = "Login portal"
	macro signIn {
		var portalAdminURL = PropsUtil.get("test.this.atlantia.portal.login.admin.url");
		var portalAdminLogin = PropsUtil.get("test.this.atlantia.portal.admin.login");
		var portalAdminPassword = PropsUtil.get("test.this.atlantia.portal.admin.password");

		Default.Open(locator1 = "${portalAdminURL}");

		Default.Type(
			locator1 = "Portal.TextInput#EMAIL_ADDRESS",
			value1 = "${portalAdminLogin}");

		Default.Type(
			locator1 = "Portal.TextInput#PASSWORD",
			value1 = "${portalAdminPassword}");

		Portal.Button.click(button = "Sign In");
	}

	// @summary = "Logout portal"

	//macro signOut {
	//	Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");
	//	Default.Click(locator1 = "HomePage#USER_MENU");
	//	Default.Click(locator1 = "Button#LOGOUT_BUTTON");
	//}


}