definition {
    @summary = "Open portal"
	macro launchPortal {
		var portalURL = PropsUtil.get("test.this.atlantia.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

    macro tearDown {
        ATLUtils.launchPortal();

        ATLUtils.removeBannerItem();
    }

    macro removeBannerItem {        
        if (Default.IsElementPresent(locator1 = "ATLHomePage#CAROUSEL_ITEM_NUMBER_2")) {
            var itemName = selenium.getText("ATLHomePage#CAROUSEL_ITEM_NUMBER_2");

            Portal.ProductMenuHelper.openProductMenu();

            Portal.ProductMenuHelper.expandCategory(category = "Content & Data");

            Portal.ProductMenuHelper.gotoPortlet(portlet = "Web Content");

            Portal.WebContent.searchCP(webContentTitle = "Banner Emotional HP");

            Portal.WebContentNavigator.gotoEntryMenuItem(
                entry = "Banner Emotional HP",
                menuItem = "Edit");

            Default.Click(
                locator1 = "ATLWC#REMOVE_BUTTON",
                key_itemName = "${itemName}");

            Portal.Button.clickPublish();
        }
    }

    macro formateURL {
        var passedURL = selenium.getAttribute("${passedURL}@href");

        var passedURL = StringUtil.extractLast("${passedURL}", "/en");

        var portalURL = PropsUtil.get("test.this.atlantia.portal.url");

        var formatedURL = "${portalURL}${passedURL}";

        Default.WaitForPageLoad();

        Default.Open(locator1 = "${formatedURL}");
    }

    macro changeSiteLanguage {
        Default.Click(
            locator1 = "ATLHomePage#TRANSLATE_PAGE",
            key_translateItem = "${translateItem}");
    }

    macro verifySiteLanguage {
        for (var afterTranslateMenuItem : list "${afterTranslateMenuItem}") {
            Default.AssertElementPresent(
                locator1 = "ATLNavigation#MAIN_MENU_ITEM",
                key_mainMenuItem = "${afterTranslateMenuItem}");
        }

       for (var beforeTranslateMenuItem : list "${beforeTranslateMenuItem}") {
            Default.AssertElementNotPresent(
                locator1 = "ATLNavigation#MAIN_MENU_ITEM",
                key_mainMenuItem = "${beforeTranslateMenuItem}");
        }

        for (var afterTranslateMenuItem : list "${afterTranslateMenuItem}") {
            Default.MouseOver(
                locator1 = "ATLNavigation#MAIN_MENU_ITEM",
                key_mainMenuItem = "${afterTranslateMenuItem}");
        }

        Default.AssertElementPresent(
            locator1 = "ATLHomePage#CAROUSEL_ITEM",
            key_itemName = "${afterTranslateCarousel}");

        Default.AssertElementNotPresent(
            locator1 = "ATLHomePage#CAROUSEL_ITEM",
            key_itemName = "${beforeTranslateCarousel}");

        Default.AssertElementPresent(
            locator1 = "ATLHomePage#STORY_ITEM",
            key_storyTitle = "${afterTranslateStory}");

        Default.AssertElementNotPresent(
            locator1 = "ATLHomePage#STORY_ITEM",
            key_storyTitle = "${beforeTranslateStory}");

        Default.AssertElementPresent(
            locator1 = "ATLHomePage#MIDDLE_BAR",
            key_itemTitle = "${afterTranslateMiddleItem}");

        Default.AssertElementNotPresent(
            locator1 = "ATLHomePage#MIDDLE_BAR",
            key_itemTitle = "${beforeTranslateMiddleItem}");

        Default.AssertElementPresent(
            locator1 = "ATLHomePage#HIGHLIGHT_ITEM",
            key_highlightItem = "${afterTranslateHighlightItem}");

        Default.AssertElementNotPresent(
            locator1 = "ATLHomePage#HIGHLIGHT_ITEM",
            key_highlightItem = "${beforeTranslateHighlightItem}");
    }

    macro formateDate {
        if ("${format}" == "m dd, yyyy") {
            var monthName = StringUtil.extractFirst("${oldDate}", " ");
            var dayYear = StringUtil.extractLast("${oldDate}", "${monthName} ");
            var day = StringUtil.extractFirst("${dayYear}", ",");
            var year = StringUtil.extractLast("${dayYear}", ", ");
        }

        if ("${format}" == "dd m yyyy") {
            var oldDate = StringUtil.replace("${oldDate}", " ", "/");
            var day = StringUtil.extractFirst("${oldDate}", "/");
            var monthYear = StringUtil.extractLast("${oldDate}", "${day}/");
            var monthName = StringUtil.extractFirst("${monthYear}", "/");
            var year = StringUtil.extractLast("${monthYear}", "/");
        }

        var monthName = StringUtil.lowerCase("${monthName}");

        if ("${monthName}" == "january") {
            var monthNumber = "1";
        }

        if ("${monthName}" == "february") {
            var monthNumber = "2";
        }

        if ("${monthName}" == "march") {
            var monthNumber = "3";
        }

        if ("${monthName}" == "april") {
            var monthNumber = "5";
        }

        if ("${monthName}" == "may") {
            var monthNumber = "5";
        }

        if ("${monthName}" == "june") {
            var monthNumber = "6";
        }

        if ("${monthName}" == "july") {
            var monthNumber = "7";
        }

        if ("${monthName}" == "august") {
            var monthNumber = "8";
        }
        
        if ("${monthName}" == "september") {
            var monthNumber = "9";
        }

        if ("${monthName}" == "october") {
            var monthNumber = "10";
        }

        if ("${monthName}" == "november") {
            var monthNumber = "11";
        }

        if ("${monthName}" == "december") {
            var monthNumber = "12";
        }

        var formatedDate = "${monthNumber}/${day}/${year}";

        echo("${formatedDate}");

        return "${formatedDate}";
    }

    macro compareDate {
        var firstDate = "${firstDate}";
        var secondDate = "${secondDate}";

        var firstMonth = StringUtil.extractFirst("${firstDate}", "/");
        var firstDateDY = StringUtil.extractLast("${firstDate}", "${firstMonth}/");
        var firstDay = StringUtil.extractFirst("${firstDateDY}", "/");
        var firstYear = StringUtil.extractLast("${firstDateDY}", "/");
         
        var secondMonth = StringUtil.extractFirst("${secondDate}", "/");
        var secondDateDY = StringUtil.extractLast("${secondDate}", "${secondMonth}/");
        var secondDay = StringUtil.extractFirst("${secondDateDY}", "/");
        var secondYear = StringUtil.extractLast("${secondDateDY}", "/");

        if ("${firstYear}" == "${secondYear}") {
            if ("${firstMonth}" == "${secondMonth}") {
                var dayValue = MathUtil.isGreaterThan("${firstDay}", "${secondDay}");

                if ("${dayValue}" == "true") {
                    echo("PASSED");
                }
                else {
                    fail("the second day '${secondDay}' is greather than the first day '${firstDay}'");
                }
            }
            else {
                var monthValue = MathUtil.isGreaterThan("${firstMonth}", "${secondMonth}");

                if ("${monthValue}" == "true") {
                    echo("PASSED");
                }
                else {
                    fail("the second month '${secondMonth}' is greather than the first month '${firstMonth}'");
                }
        
            }
        }
        else {
            var yearValue = MathUtil.isGreaterThan("${firstYear}", "${secondYear}");

            if ("${yearValue}" == "true") {
                echo("PASSED");
            }
            else {
                fail("the second year '${secondYear}' is greather than the first year '${firstYear}'");
            }
        }
    }
}