definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74490 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Facebook"
	@priority = "4"
	test CanOpenFacebookFromPageFooter {
		task ("Go to Facebook page through page footer") {
			LDHome.clickFooterOption(footerOption = "Facebook");
		}

		task ("Check user is redirected to Facebook page") {
			Default.SelectWindow(locator1 = "title=Liferay - Home | Facebook");

			Default.AssertLocation(value1 = "https://www.facebook.com/liferay/");
		}
	}

	@description = "Automation ID: LRQA-74490 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: GitHub"
	@priority = "4"
	test CanOpenGithubFromPageFooter {
		task ("Go to GitHub page through page footer") {
			LDHome.clickFooterOption(footerOption = "GitHub");
		}

		task ("Check user is redirected to GitHub page") {
			Default.SelectWindow(locator1 = "title=Liferay Inc. · GitHub");

			Default.AssertLocation(value1 = "https://github.com/liferay");
		}
	}

	@description = "Automation ID: LRQA-74490 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Instagram"
	@priority = "4"
	test CanOpenInstagramFromPageFooter {
		task ("Go to Instagram page through page footer") {
			LDHome.clickFooterOption(footerOption = "Instagram");
		}

		task ("Check user is redirected to Instagram page") {
			Default.SelectWindow(locator1 = "title=Login • Instagram");

			Default.AssertLocation(value1 = "https://www.instagram.com/accounts/login/?next=/liferayinc/");
		}
	}

	@description = "Automation ID: LRQA-74490 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: LinkedIn"
	@priority = "4"
	test CanOpenLinkedinFromPageFooter {
		task ("Go to LinkedIn page through page footer") {
			LDHome.clickFooterOption(footerOption = "LinkedIn");
		}

		task ("Check user is redirected to LinkedIn page") {
			Default.SelectWindow(locator1 = "title=Sign In | LinkedIn");

			Default.AssertLocation.assertPartialLocation(value1 = "https://www.linkedin.com/");
		}
	}

	@description = "Automation ID: LRQA-74490 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Twitter"
	@priority = "4"
	test CanOpenTwitterFromPageFooter {
		task ("Go to Twitter page through page footer") {
			LDHome.clickFooterOption(footerOption = "Twitter");
		}

		task ("Check user is redirected to Twitter page") {
			Default.SelectWindow(locator1 = "title=Liferay (@Liferay) / Twitter");

			Default.AssertLocation(value1 = "https://twitter.com/liferay");
		}
	}

}