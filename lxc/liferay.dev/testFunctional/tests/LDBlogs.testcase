definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToBlogs();
	}

	tearDown {
		LDBlogs.tearDownBlogs();
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to Add a comment to blog"
	@priority = "4"
	test CanAddComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Assert comment is added") {
			LDBlogs.viewComment(entryComment = "Blog Comment");
		}
	}

	@description = "Automation ID: LRQA-74794 | Test Summary: Verify user is able to Delete a blog (Move to Recycle Bin)"
	@priority = "5"
	test CanDeleteBlog {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");
		}

		task ("Delete a blog entry") {
			LDBlogs.deleteEntry(entryTitle = "Blogs Title");
		}

		task ("Assert the blog entry is deleted") {
			LDBlogs.viewEntryNotPresent(entryTitle = "Blogs Title");
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to delete a comment from a blog"
	@priority = "4"
	test CanDeleteComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Refresh();
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Delete a comment") {
			LDBlogs.deleteComment(entryComment = "Blog Comment");
		}

		task ("Assert comment is deleted") {
			Default.AssertElementNotPresent(
				key_entryComment = "Blog Comment",
				locator1 = "LDBlogs#ENTRY_COMMENT");
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to delete a comment reply from a blog"
	@priority = "4"
	test CanDeleteReplyComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Refresh();
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Reply a comment") {
			LDBlogs.replyComment(
				commentReply = "Comment Reply",
				entryComment = "Blog Comment");
		}

		task ("Delete a comment reply") {
			LDBlogs.deleteCommentReply(commentReply = "Comment Reply");
		}

		task ("Assert comment is replied") {
			Default.AssertElementNotPresent(
				key_entryComment = "Comment Reply",
				locator1 = "LDBlogs#ENTRY_COMMENT");
		}
	}

	@description = "Automation ID: LRQA-74793 | Test Summary: Verify user is able to Edit a blog"
	@priority = "5"
	test CanEditBlog {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");
		}

		task ("Edit a blog entry") {
			LDBlogs.editEntry(
				entryTitle = "Blogs Title",
				newEntryContent = "Edited Blogs Content",
				newEntryTitle = "Edited Blogs Title");
		}

		task ("Assert the blog entry is edited") {
			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");

			LDBlogs.viewEntry(entryTitle = "Edited Blogs Title");
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to edit a comment from a blog"
	@priority = "4"
	test CanEditComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Refresh();
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Edit a comment") {
			LDBlogs.editComment(
				editedEntryComment = "Edited Blog Comment",
				entryComment = "Blog Comment");
		}

		task ("Assert comment is edited") {
			LDBlogs.viewComment(entryComment = "Edited Blog Comment");
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to edit a comment reply from a blog"
	@priority = "4"
	test CanEditReplyComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Refresh();
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Reply a comment") {
			LDBlogs.replyComment(
				commentReply = "Comment Reply",
				entryComment = "Blog Comment");
		}

		task ("Edit a comment reply") {
			LDBlogs.editCommentReply(
				commentReply = "Comment Reply",
				editedCommentReply = "Edited Comment Reply");
		}

		task ("Assert comment is replied") {
			LDBlogs.viewComment(entryComment = "Edited Comment Reply");
		}
	}

	@description = "Non-admin User is able to create a new blog entry and submit it for Publication"
	@priority = "4"
	test CanNonAdminAddNewBlogEntryAndSubmitForPublication {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");
		}

		task ("Assert the new blog entry is published") {
			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");

			LDBlogs.viewEntry(entryTitle = "Blogs Title");
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is unable to Report Inappropriate Content in a blog without captcha text confirmation"
	@priority = "4"
	test CanNotReportInappropriateContentWithoutCaptcha {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");
		}

		task ("View Report is not possible without captcha") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOG_REPORT_BUTTON");

			Default.Click(locator1 = "LDBlogs#MODAL_REPORT_BUTTON");

			LDBlogs.viewContentNotReported();
		}
	}

	@description = "Automation ID: LRQA-75016 | Test Summary: Verify user is able to reply a comment from a blog"
	@priority = "4"
	test CanReplyComment {
		task ("Add a new blog entry") {
			LDBlogs.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Title");

			Default.Click(locator1 = "LDBlogs#BLOGS_PAGE_PUBLISHED_TAB");
		}

		task ("Add a comment") {
			LDBlogs.openBlog(entryTitle = "Blogs Title");

			LDBlogs.addComment(entryComment = "Blog Comment");
		}

		task ("Reply a comment") {
			LDBlogs.replyComment(
				commentReply = "Comment Reply",
				entryComment = "Blog Comment");
		}

		task ("Assert comment is replied") {
			LDBlogs.viewComment(entryComment = "Comment Reply");
		}
	}

	@description = "Automation ID: LRQA-74795 | Test Summary: Verify ALL, NEWS and FEATURED tabs are properly loaded"
	@priority = "5"
	test ShowsMainTabs {
		task ("Assert tabs ALL, NEWS and FEATURED are loaded") {
			LDBlogs.viewTabs(tabName = "All,News,Featured");
		}
	}

}