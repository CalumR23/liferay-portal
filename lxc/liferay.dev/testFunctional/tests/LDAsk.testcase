definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToAsk();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-75015 | Test Summary: Verify user is automatically subscribed for his questions"
	@priority = "4"
	test AutomaticallySubscribeForQuestions {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert subscription for a question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_BELL_ON");
		}
	}

	@description = "Automation ID: LRQA-74606 | Test Summary: Verify user is able to Answer a question"
	@priority = "5"
	test CanAnswerQuestion {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			Default.Refresh();

			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Answer published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.answerQuestion(
				questionAnswer = "Test Question Answer",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert question is edited") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			Default.AssertElementPresent(
				key_answerText = "Test Question Answer",
				locator1 = "LDAsk#ANSWER");
		}
	}

	@description = "Automation ID: LRQA-75015 | Test Summary: Verify user is able to choose an answer"
	@priority = "4"
	test CanChooseAnswer {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Answer published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.answerQuestion(
				questionAnswer = "Test Question Answer",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Choose answer") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			LDAsk.markAsAnswer(answerText = "Test Question Answer");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert answer is chosen") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");

			Default.AssertElementPresent(locator1 = "LDAsk#CHOSEN_ANSWER_LABEL");
		}
	}

	@description = "Automation ID: LRQA-75015 | Test Summary: Verify user is able to delete an answer"
	@priority = "4"
	test CanDeleteAnswer {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Answer published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.answerQuestion(
				questionAnswer = "Test Question Answer",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Delete answer") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			LDAsk.deleteAnswer(answerText = "Test Question Answer");
		}

		task ("Assert answer is deleted") {
			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");

			Default.AssertElementNotPresent(
				key_answerText = "Test Question Answer",
				locator1 = "LDAsk#ANSWER");
		}
	}

	@description = "Automation ID: LRQA-74602 | Test Summary: Verify user is able to Delete a question"
	@priority = "5"
	test CanDeleteQuestion {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Delete published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.deleteQuestion(questionTitle = "Test Question Title");
		}

		task ("Assert question is deleted") {
			Default.AssertElementNotPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@description = "Automation ID: LRQA-75015 | Test Summary: Verify user is able to edit an answer"
	@priority = "4"
	test CanEditAnswer {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Answer published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.answerQuestion(
				questionAnswer = "Test Question Answer",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Edit answer") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			LDAsk.editAnswer(
				answerText = "Test Question Answer",
				editedAnswerText = "Edited Test Question Answer");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert answer is edited") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");

			Default.AssertElementPresent(
				key_answerText = "Edited Test Question Answer",
				locator1 = "LDAsk#ANSWER");
		}
	}

	@description = "Automation ID: LRQA-74605 | Test Summary: Verify user is able to Edit a question"
	@priority = "5"
	test CanEditQuestion {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			Default.Refresh();

			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Edit published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.editQuestion(
				newQuestionTitle = "Edited Test Question Title",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Edited Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert question is edited") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "Edited Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@description = "New Post correctly enters pending state with DB partition enabled"
	@priority = "5"
	test CanNonAdminAddNewPostInPedingState {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Assert the new post is pending") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_PENDING_LABEL");
		}
	}

	@description = "Non-admin user is able to create a new post in Ask"
	@priority = "5"
	test CanNonAdminMakeNewPost {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Assert the new post is created") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@description = "Automation ID: LRQA-75015 | Test Summary: Verify user is able to reply an answer"
	@priority = "4"
	test CanReplyAnswer {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Answer published question") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.answerQuestion(
				questionAnswer = "Test Question Answer",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Reply Answer") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			LDAsk.replyAnswer(
				answerText = "Test Question Answer",
				replyText = "Test Answer Reply");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve changes") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "RE: RE: Test Question Title");
		}

		task ("Switch to non-admin user") {
			LDLogin.signOut();

			LDLogin.signInWithNonAdminUser();
		}

		task ("Assert answer is replied") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.openQuestion(questionTitle = "Test Question Title");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");

			Default.AssertElementPresent(
				key_replyText = "Test Answer Reply",
				locator1 = "LDAsk#REPLY");
		}
	}

	@description = "Automation ID: LRQA-74601 | Test Summary: Verify user is able to Search for a question"
	@ignore = "Test Stub"
	@priority = "5"
	test CanSearch {

		// TODO LRQA-74601 CanSearch pending implementation

	}

	@priority = "5"
	test HasFourMainQuestionCards {
		LDAsk.viewCardTitlesOnQuestionSections(cardTitleList = "Commerce,Development,General,Portal");
	}

	@description = "Post in Pending state does not appear to Guest User"
	@priority = "5"
	test NewPostInPedingStateDoesNotAppearToGuestOrOtherUser {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("SignOut as user to navigate as guest") {
			LDLogin.signOut();
		}

		task ("Assert the new post is not visible to Guest User") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementNotPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@description = "New post is able to complete workflow and enters approved state"
	@priority = "5"
	test NewPostIsApproved {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Test Question Body",
				questionTitle = "Test Question Title");
		}

		task ("Switch to admin user") {
			LDLogin.signOut();

			LDLogin.signInWithAdminUser();
		}

		task ("Approve post") {
			LDMyWorkflowTasks.approveWorkflowAsset(itemTitle = "Test Question Title");
		}

		task ("Assert new post is approved") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_TITLE");

			Default.AssertElementNotPresent(
				key_questionTitle = "Test Question Title",
				locator1 = "LDAsk#QUESTION_PENDING_LABEL");
		}
	}

}