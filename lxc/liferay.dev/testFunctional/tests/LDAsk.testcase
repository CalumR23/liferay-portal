definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToAsk();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "New Post correctly enters pending state with DB partition enabled"
	@priority = "4"
	test CanNonAdminAddNewPostInPedingState {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Running this test you can ask a new one.",
				questionTitle = "How to ask a question?");
		}

		task ("Assert the new post is pending") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "How to ask a question?",
				locator1 = "LDAsk#QUESTION_PENDING_LABEL");
		}
	}

	@description = "Non-admin user is able to create a new post in Ask"
	@priority = "4"
	test CanNonAdminMakeNewPost {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Running this test you can ask a new one.",
				questionTitle = "How to ask a question?");
		}

		task ("Assert the new post is created") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "How to ask a question?",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@priority = "5"
	test HasFourMainQuestionCards {
		LDAsk.viewCardTitlesOnQuestionSections(cardTitleList = "Commerce,Development,General,Portal");
	}

	@description = "Post in Pending state does not appear to Guest User"
	@priority = "4"
	test NewPostInPedingStateDoesNotAppearToGuestOrOtherUser {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Running this test you can ask a new one.",
				questionTitle = "How to ask a question?");

			Default.Pause(locator1 = "2000");
		}

		task ("SignOut as user to navigate as guest") {
			LDLogin.signOut();
		}

		task ("Assert the new post is not visible to Guest User") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementNotPresent(
				key_questionTitle = "How to ask a question?",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

}