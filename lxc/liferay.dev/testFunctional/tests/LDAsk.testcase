@component-name = "liferay-dev"
definition {

	property testray.main.component.name = "liferay-dev";

	setUp {
		LDUtils.launchLDWithAuthentication();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToAsk();
	}

	@description = "Non-admin user is able to create a new post in Ask"
	@priority = "4"
	test CanNonAdminMakeNewPost {
		task ("Ask a new question") {
			LDAsk.openCard(cardTitle = "Commerce");

			LDAsk.askQuestion(
				questionBody = "Running this test you can ask a new one.",
				questionTitle = "How to ask a question?");
		}

		task ("Assert the new post is created") {
			LDNavigation.goToAsk();

			LDAsk.openCard(cardTitle = "Commerce");

			Default.AssertElementPresent(
				key_questionTitle = "How to ask a question?",
				locator1 = "LDAsk#QUESTION_TITLE");
		}
	}

	@priority = "5"
	test HasFourMainQuestionCards {
		LDAsk.viewCardTitlesOnQuestionSections(cardTitleList = "Commerce,Development,General,Portal");
	}

	@description = "New Post correctly enters pending state with DB partition enabled and is displayed only to user and it does not appear to Guest Users or other Users"
	@ignore = "Test Stub"
	@priority = "4"
	test NewPostInPedingStateDontAppearToGuestOrOtherUser {

		// TODO LRQA-73937 NewPostInPedingStateDontAppearToGuestOrOtherUser

	}

}