definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74226 | Test Summary: Canonical url html tags for /home and /blogs correctly generated"
	@priority = "5"
	test CanonicalURLMatchs {
		task ("Check canonical url is present at blogs page") {
			LDNavigation.goToBlogs();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}

		task ("Check canonical url is present at home page") {
			LDNavigation.goToHome();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Ask"
	@ignore = "true"
	@priority = "5"
	test WebGuestDontAppearInAskURL {
		task ("Check /web/guest is not in URL for an asked question") {
			LDHome.clickPage(pageName = "Ask");

			LDAsk.openCard();

			LDAsk.openQuestion();

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Blogs"
	@ignore = "true"
	@priority = "5"
	test WebGuestDontAppearInBlogsURL {
		task ("Check /web/guest is not in URL for a blog") {
			LDHome.clickPage(pageName = "Blogs");

			LDBlogs.openBlog();

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}
	}

