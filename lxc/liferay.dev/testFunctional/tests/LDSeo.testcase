definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74226 | Test Summary: Canonical url html tags for /home and /blogs correctly generated"
	@priority = "5"
	test CanonicalURLMatchs {
		task ("Check canonical url is present at blogs page") {
			LDNavigation.goToBlogs();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}

		task ("Check canonical url is present at home page") {
			LDNavigation.goToHome();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Ask"
	@priority = "5"
	test WebGuestDontAppearInAskURL {
		task ("Check /web/guest is not in URL for an asked question") {
			LDHome.clickPage(pageName = "Ask");

			LDAsk.openCard();

			LDAsk.openQuestion();

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/ask/questions");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Blogs"
	@priority = "5"
	test WebGuestDontAppearInBlogsURL {
		task ("Check /web/guest is not in URL for a blog") {
			LDHome.clickPage(pageName = "Blogs");

			LDBlogs.openBlog();

			// Default.WaitForElementPresent(locator1 = "//div[contains(@class,'autofit-row')]//h3[contains(@class,'title')]");

			// TODO: LRQA-74824 - Investigate how to remove Pause of LDSeo tests
			// Refactor: WaitForElementPresent was not able to make the test execution wait and get the new URL immediately after opening a blog/project
			Default.Pause(locator1 = "1000");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/blogs/-/blogs");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Chat"
	@priority = "5"
	test WebGuestDontAppearInChatURL {
		task ("Check /web/guest is not in URL for Chat page") {
			LDHome.clickPage(pageName = "Chat");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/chat");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: /dev/24"
	@priority = "5"
	test WebGuestDontAppearInDev24URL {
		task ("Check /web/guest is not in URL for /dev/24 page") {
			LDHome.clickPage(pageName = "/dev/24");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/twentyfour");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Meet"
	@priority = "5"
	test WebGuestDontAppearInMeetURL {
		task ("Check /web/guest is not in URL for Meet page") {
			LDHome.clickPage(pageName = "Meet");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/meet");
		}
	}

	@description = "Bug: LPS-136518 | Automation ID: LRQA-74227 | Test Summary: No urls should contain /web/guest: Projects"
	@priority = "5"
	test WebGuestDontAppearInProjectsURL {
		task ("Check /web/guest is not in URL for a project") {
			LDHome.clickPage(pageName = "Projects");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone
			// Refactor: Improve it to validate "/web/guest" is not present in the URL, so the test will be more generic and less fragile

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/projects");

			LDProjects.openProject();

			// TODO: LRQA-74824 - Investigate how to remove Pause of LDSeo tests
			// Refactor: WaitForElementPresent was not able to make the test execution wait and get the new URL immediately after opening a blog/project
			Default.Pause(locator1 = "1000");

			Default.AssertLocation.assertPartialLocation(value1 = "https://uat.liferay.dev/-/");
		}
	}

}