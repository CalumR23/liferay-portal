definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Canonical url html tags for /home and /blogs correctly generated"
	@priority = "4"
	test CanonicalURLMatchs {
		task ("Check canonical url is present at blogs page") {
			LDNavigation.goToBlogs();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}

		task ("Check canonical url is present at home page") {
			LDNavigation.goToHome();

			Default.AssertElementPresent(locator1 = "LDGeneral#CANONICAL_URL");
		}
	}

	@description = "No urls should contain /web/guest"
	@ignore = "true"
	@priority = "4"
	test WebGuestDontAppearInURL {
		task ("Check /web/guest is not in URL for Ask page") {
			LDHome.clickPage(pageName = "Ask");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}

		task ("Check /web/guest is not in URL for Blogs page") {
			LDNavigation.goToHome();

			LDHome.clickPage(pageName = "Blogs");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}

		task ("Check /web/guest is not in URL for Chat page") {
			LDNavigation.goToHome();

			LDHome.clickPage(pageName = "Chat");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}

		task ("Check /web/guest is not in URL for Meet page") {
			LDNavigation.goToHome();

			LDHome.clickPage(pageName = "Meet");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}

		task ("Check /web/guest is not in URL for Projects page") {
			LDNavigation.goToHome();

			LDHome.clickPage(pageName = "Projects");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}

		task ("Check /web/guest is not in URL for /dev/24 page") {
			LDNavigation.goToHome();

			LDHome.clickPage(pageName = "/dev/24");

			// TODO: Test Fix POSHI-326 - Missing functions in Poshi standalone

			//Default.AssertNotLocation(value1 = "/web/guest");

		}
	}

}