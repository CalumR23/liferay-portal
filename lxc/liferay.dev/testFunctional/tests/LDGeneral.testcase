definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Guest can view profile pages"
	@priority = "2"
	test CanBrowseToProfilePageAsGuest {
		task ("Sign out with current user and go to profile page as guest") {
			LDLogin.signOut();

			LDNavigation.goToUserProfilePage(userName = "liferaydev-user-uat");
		}

		task ("Assert the user name is properly displayed in profile page's header") {
			Default.AssertElementPresent(
				key_user = "Liferay Dev UAT User",
				locator1 = "LDUserProfile#HEADER_USER_NAME");
		}
	}

}