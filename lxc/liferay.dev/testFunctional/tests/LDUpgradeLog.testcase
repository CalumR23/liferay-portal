definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	test ValidateUpgradeLog {
		property test.assert.warning.exceptions = "true";

		var logsFolder = PropsUtil.get("test.this.liferaydev.upgrade.log.dir");
		var fileContent = FileUtil.read("${logsFolder}/fake-upgrade.log");
		var FAIL_KEYWORKD = "FAIL";
		var WARNING_KEYWORD = "WARNING";
		var EXCEPTION_KEYWORD = "EXCEPTION";

		if (contains("${fileContent}", "${FAIL_KEYWORKD}")) {
			fail("FAILED KEYWORD FOUND!");
		}
		else if (contains("${fileContent}", "${WARNING_KEYWORD}")) {
			echo("WARNING KEYWORD FOUND!");
		}
		else if (contains("${fileContent}", "${EXCEPTION_KEYWORD}")) {
			fail("EXCEPTION KEYWORD FOUND!");
		}
		else {
			echo("THE UPGRADE LOG IS SAFE, NO ERRORS FOUND!");
		}
	}

}