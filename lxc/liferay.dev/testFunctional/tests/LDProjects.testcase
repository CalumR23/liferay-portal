definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToProjects();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-75017 | Test Summary: Verify there are project cards when clicking at 'ALL' tab"
	@priority = "4"
	test ShowsAllProjectCards {
		task ("Check the expected project cards are shown by clicking at 'All' tab") {
			Default.Click(
				key_tabName = "All",
				locator1 = "LDProjects#TAB");

			LDProjects.viewProjectCards(cardTitleList = "AlloyEditor,Clay,Commerce,Faces,IDE,Lexicon,Marketplace,Portal,Portlet MVC 4 Spring");
		}
	}

	@description = "Automation ID: LRQA-75017 | Test Summary: Verify there are project cards when clicking at 'CLOUD' tab"
	@priority = "4"
	test ShowsCloudProjectCards {
		task ("Check the expected project cards are shown by clicking at 'Cloud' tab") {
			Default.Click(
				key_tabName = "Cloud",
				locator1 = "LDProjects#TAB");

			LDProjects.viewProjectCards(cardTitleList = "Marketplace");
		}
	}

	@description = "Automation ID: LRQA-75017 | Test Summary: Verify there are project cards when clicking at 'FRAMEWORKS' tab"
	@priority = "4"
	test ShowsFrameworksProjectCards {
		task ("Check the expected project cards are shown by clicking at 'Frameworks' tab") {
			Default.Click(
				key_tabName = "Frameworks",
				locator1 = "LDProjects#TAB");

			LDProjects.viewProjectCards(cardTitleList = "AlloyEditor,Clay,Faces,Lexicon,Portlet MVC 4 Spring");
		}
	}

	@description = "Automation ID: LRQA-75017 | Test Summary: Verify there are project cards when clicking at 'PLATFORM' tab"
	@priority = "4"
	test ShowsPlatformProjectCards {
		task ("Check the expected project cards are shown by clicking at 'Platform' tab") {
			Default.Click(
				key_tabName = "Platform",
				locator1 = "LDProjects#TAB");

			LDProjects.viewProjectCards(cardTitleList = "Commerce,IDE,Marketplace,Portal");
		}
	}

}