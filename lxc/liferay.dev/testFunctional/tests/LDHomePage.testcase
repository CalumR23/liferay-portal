definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74464 | Test Summary: Verify that the Navigation bar is displayed with the option: Ask"
	@priority = "5"
	test CanProperlyShowAskInNavigationBar {
		task ("Check Ask is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Ask");
		}
	}

	@description = "Automation ID: LRQA-74515 | Test Summary: Verify that the Navigation bar is displayed with the option: Blogs"
	@priority = "5"
	test CanProperlyShowBlogsInNavigationBar {
		task ("Check Blogs is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Blogs");
		}
	}

	@description = "Automation ID: LRQA-74516 | Test Summary: Verify that the Navigation bar is displayed with the option: Chat"
	@priority = "5"
	test CanProperlyShowChatInNavigationBar {
		task ("Check Chat is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Chat");
		}
	}

	@description = "Automation ID: LRQA-74517 | Test Summary: Verify that the Navigation bar is displayed with the option: Download"
	@priority = "5"
	test CanProperlyShowDownloadInNavigationBar {
		task ("Check Download is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Download");
		}
	}

	@description = "Automation ID: LRQA-74518 | Test Summary: Verify that the Navigation bar is displayed with the option: Learn"
	@priority = "5"
	test CanProperlyShowLearnInNavigationBar {
		task ("Check Learn is visible in navigation menu") {
