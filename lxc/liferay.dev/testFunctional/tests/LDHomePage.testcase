definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74465 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Ask"
	@priority = "5"
	test CanProperlyOpenAsk {
		task ("Go to Ask page through navigation menu") {
			LDHome.clickPage(pageName = "Ask");
		}

		task ("Check elements to make sure user is redirected to Ask page") {
			Default.AssertElementPresent(locator1 = "LDAsk#SEARCH_FIELD");

			Default.AssertElementPresent(locator1 = "LDAsk#CARD");
		}
	}

	@description = "Automation ID: LRQA-74466 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Blogs"
	@priority = "5"
	test CanProperlyOpenBlogs {
		task ("Go to Ask page through navigation menu") {
			LDHome.clickPage(pageName = "Blogs");
		}

		task ("Check elements to make sure user is redirected to Blogs page") {
			Default.AssertElementPresent(locator1 = "LDBlogs#BLOGS_PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LDBlogs#ENTRY");
		}
	}

	@description = "Automation ID: LRQA-74464 | Test Summary: Verify that the Navigation bar is displayed with the option: Ask"
	@priority = "5"
	test CanProperlyShowAskInNavigationBar {
		task ("Check Ask is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Ask");
		}
	}

	@description = "Automation ID: LRQA-74515 | Test Summary: Verify that the Navigation bar is displayed with the option: Blogs"
	@priority = "5"
	test CanProperlyShowBlogsInNavigationBar {
		task ("Check Blogs is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Blogs");
		}
	}

	@description = "Automation ID: LRQA-74516 | Test Summary: Verify that the Navigation bar is displayed with the option: Chat"
	@priority = "5"
	test CanProperlyShowChatInNavigationBar {
		task ("Check Chat is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Chat");
		}
	}

	@description = "Automation ID: LRQA-74521 | Test Summary: Verify that the Navigation bar is displayed with the option: /dev/24"
	@priority = "5"
	test CanProperlyShowDev24InNavigationBar {
		task ("Check /dev/24 is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "/dev/24");
		}
	}

	@description = "Automation ID: LRQA-74517 | Test Summary: Verify that the Navigation bar is displayed with the option: Download"
	@priority = "5"
	test CanProperlyShowDownloadInNavigationBar {
		task ("Check Download is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Download");
		}
	}

	@description = "Automation ID: LRQA-74518 | Test Summary: Verify that the Navigation bar is displayed with the option: Learn"
	@priority = "5"
	test CanProperlyShowLearnInNavigationBar {
		task ("Check Learn is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Learn");
		}
	}

	@description = "Automation ID: LRQA-74519 | Test Summary: Verify that the Navigation bar is displayed with the option: Meet"
	@priority = "5"
	test CanProperlyShowMeetInNavigationBar {
		task ("Check Meet is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Meet");
		}
	}

	@description = "Automation ID: LRQA-74520 | Test Summary: Verify that the Navigation bar is displayed with the option: Projects"
	@priority = "5"
	test CanProperlyShowProjectsInNavigationBar {
		task ("Check Projects is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Projects");
		}
	}

}