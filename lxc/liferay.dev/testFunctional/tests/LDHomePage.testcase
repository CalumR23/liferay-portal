definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();
	}

	tearDown {
		LDLogin.signOut();
	}

	@description = "Automation ID: LRQA-74465 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Ask"
	@priority = "5"
	test CanOpenAsk {
		task ("Go to Ask page through navigation menu") {
			LDHome.clickPage(pageName = "Ask");
		}

		task ("Check elements to make sure user is redirected to Ask page") {
			Default.AssertElementPresent(locator1 = "LDAsk#SEARCH_FIELD");

			Default.WaitForElementPresent(locator1 = "LDAsk#CARD");

			Default.AssertElementPresent(locator1 = "LDAsk#CARD");
		}
	}

	@description = "Automation ID: LRQA-74466 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Blogs"
	@priority = "5"
	test CanOpenBlogs {
		task ("Go to Blogs page through navigation menu") {
			LDHome.clickPage(pageName = "Blogs");
		}

		task ("Check elements to make sure user is redirected to Blogs page") {
			Default.AssertElementPresent(locator1 = "LDBlogs#BLOGS_PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LDBlogs#ENTRY");
		}
	}

	@description = "Automation ID: LRQA-74487 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Careers"
	@priority = "4"
	test CanOpenCareersFromPageFooter {
		task ("Go to Careers page through page footer") {
			LDHome.clickFooterOption(footerOption = "Careers");
		}

		task ("Check user is redirected to Careers page") {
			Default.SelectWindow(locator1 = "title=Liferay Jobs & Careers");

			Default.AssertLocation(value1 = "https://www.liferay.com/careers");
		}
	}

	@description = "Automation ID: LRQA-74467 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Chat"
	@priority = "5"
	test CanOpenChat {
		task ("Go to Chat page through navigation menu") {
			LDHome.clickPage(pageName = "Chat");
		}

		task ("Check elements to make sure user is redirected to Chat page") {
			Default.SelectWindow.selectPopUp(locator1 = "null");

			LDChat.viewChatMainPageElements();
		}
	}

	@description = "Automation ID: LRQA-74473 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: /dev/24"
	@priority = "5"
	test CanOpenDev24 {
		task ("Go to /dev/24 page through navigation menu") {
			LDHome.clickPage(pageName = "/dev/24");
		}

		task ("Check elements to make sure user is redirected to /dev/24 page") {
			Default.SelectFrame(locator1 = "LDDev24#DEV24_PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LDDev24#AGENDA_HEADER");
		}
	}

	@description = "Automation ID: LRQA-74469 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Download"
	@priority = "5"
	test CanOpenDownload {
		task ("Go to Download page through navigation menu") {
			LDHome.clickPage(pageName = "Download");
		}

		task ("Check elements to make sure user is redirected to Download page") {
			Default.SelectWindow(locator1 = "title=Download Liferay Portal CE or Commerce");

			LFRCommunityDownloads.acceptCookies();

			Default.AssertElementPresent(locator1 = "LFRCommunityDownloads#PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LFRCommunityDownloads#LIFERAY_LOGO");
		}
	}

	@description = "Automation ID: LRQA-74482 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Events"
	@priority = "4"
	test CanOpenEventsFromPageFooter {
		task ("Go to Events page through page footer") {
			LDHome.clickFooterOption(footerOption = "Events");
		}

		task ("Check user is redirected to Events page") {
			Default.SelectWindow(locator1 = "title=Liferay Events, Conferences, Meetups and Webinars");

			Default.AssertLocation(value1 = "https://www.liferay.com/events");
		}
	}

	@description = "Automation ID: LRQA-74470 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Learn"
	@priority = "5"
	test CanOpenLearn {
		task ("Go to Learn page through navigation menu") {
			LDHome.clickPage(pageName = "Learn");
		}

		task ("Check elements to make sure user is redirected to Learn page") {
			Default.SelectWindow(locator1 = "title=Liferay Learn — Liferay Learn");

			Default.AssertElementPresent(locator1 = "LFRLearn#PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LFRLearn#SEARCH_DOCS_INPUT_FIELD");
		}
	}

	@description = "Automation ID: LRQA-74471 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Meet"
	@priority = "5"
	test CanOpenMeet {
		task ("Go to Meet page through navigation menu") {
			LDHome.clickPage(pageName = "Meet");
		}

		task ("Check elements to make sure user is redirected to Meet page") {
			Default.AssertElementPresent(locator1 = "LDMeet#MEET_PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LDMeet#GO_TO_MEETUP_BUTTON");
		}
	}

	@description = "Automation ID: LRQA-74489 | Test Summary: Verify the user is properly redirected when clicking in the Page Footer option: Open Source"
	@priority = "4"
	test CanOpenOpenSourceFromPageFooter {
		task ("Go to Open Source page through page footer") {
			LDHome.clickFooterOption(footerOption = "Open Source");
		}

		task ("Check user is redirected to Open Source page") {
			Default.AssertLocation.assertPartialLocation(value1 = "/open-source");
		}
	}

	@description = "Automation ID: LRQA-74472 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: Projects"
	@priority = "5"
	test CanOpenProjects {
		task ("Go to Projects page through navigation menu") {
			LDHome.clickPage(pageName = "Projects");
		}

		task ("Check elements to make sure user is redirected to Projects page") {
			Default.AssertElementPresent(locator1 = "LDProjects#PROJECTS_PAGE_HEADER");

			Default.AssertElementPresent(locator1 = "LDProjects#PROJECT_CARD");
		}
	}

	@description = "Automation ID: LRQA-74464 | Test Summary: Verify that the Navigation bar is displayed with the option: Ask"
	@priority = "5"
	test CanShowAskInNavigationBar {
		task ("Check Ask is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Ask");
		}
	}

	@description = "Automation ID: LRQA-74515 | Test Summary: Verify that the Navigation bar is displayed with the option: Blogs"
	@priority = "5"
	test CanShowBlogsInNavigationBar {
		task ("Check Blogs is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Blogs");
		}
	}

	@description = "Automation ID: LRQA-74516 | Test Summary: Verify that the Navigation bar is displayed with the option: Chat"
	@priority = "5"
	test CanShowChatInNavigationBar {
		task ("Check Chat is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Chat");
		}
	}

	@description = "Automation ID: LRQA-74521 | Test Summary: Verify that the Navigation bar is displayed with the option: /dev/24"
	@priority = "5"
	test CanShowDev24InNavigationBar {
		task ("Check /dev/24 is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "/dev/24");
		}
	}

	@description = "Automation ID: LRQA-74474 | Test Summary: Verify that in 'Discover' section there is a button 'View all projects'"
	@priority = "4"
	test CanShowDiscoverSection {
		task ("View section and button in home page") {
			LDHome.viewSection(
				buttonName = "View all projects",
				sectionName = "Discover");
		}
	}

	@description = "Automation ID: LRQA-74517 | Test Summary: Verify that the Navigation bar is displayed with the option: Download"
	@priority = "5"
	test CanShowDownloadInNavigationBar {
		task ("Check Download is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Download");
		}
	}

	@description = "Automation ID: LRQA-74518 | Test Summary: Verify that the Navigation bar is displayed with the option: Learn"
	@priority = "5"
	test CanShowLearnInNavigationBar {
		task ("Check Learn is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Learn");
		}
	}

	@description = "Automation ID: LRQA-74519 | Test Summary: Verify that the Navigation bar is displayed with the option: Meet"
	@priority = "5"
	test CanShowMeetInNavigationBar {
		task ("Check Meet is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Meet");
		}
	}

	@description = "Automation ID: LRQA-74476 | Test Summary: Verify that in 'Meet us' section there is a button 'Check all user groups'"
	@priority = "4"
	test CanShowMeetUsSection {
		task ("View section and button in home page") {
			LDHome.viewSection(
				buttonName = "Check all user groups",
				sectionName = "Meet us");
		}
	}

	@description = "Automation ID: LRQA-74520 | Test Summary: Verify that the Navigation bar is displayed with the option: Projects"
	@priority = "5"
	test CanShowProjectsInNavigationBar {
		task ("Check Projects is visible in navigation menu") {
			LDHome.assertNavigationMenuItem(itemName = "Projects");
		}
	}

	@description = "Automation ID: LRQA-74475 | Test Summary: Verify that in 'Stay up to date' section there is a button 'View all posts'"
	@priority = "4"
	test CanShowStayUpToDateSection {
		task ("View section and button in home page") {
			LDHome.viewSection(
				buttonName = "View all posts",
				sectionName = "Stay up to date");
		}
	}

	@description = "Automation ID: LRQA-74477 | Test Summary: Verify that there is a YouTube video in the home page"
	@priority = "4"
	test CanShowYouTubeVideo {
		task ("View YouTube video in home page") {
			Default.AssertElementPresent(locator1 = "LDHome#YOUTUBE_VIDEO_IFRAME");
		}
	}

}