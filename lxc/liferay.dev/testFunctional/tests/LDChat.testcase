definition {

	property test.env = "uat";
	property testray.main.component.name = "Liferay Dev";

	setUp {
		LDUtils.launchLDUat();

		LDUtils.acceptCookies();

		LDLogin.signInWithNonAdminUser();

		LDNavigation.goToChat();
	}

	@description = "Automation ID: LRQA-74795 | Test Summary: Verify user is redirected to https://liferay-community.slack.com/ when clicking in 'sign in' option"
	@priority = "5"
	test CanOpenLiferayCommunitySlackConnectionPage {
		task ("Go to log in page") {
			LDChat.goToSlackSignIn();
		}

		task ("View slack login page is loaded") {
			LDChat.viewLiferayCommunitySlackPage();
		}
	}

}