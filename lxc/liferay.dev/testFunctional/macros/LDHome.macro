definition {

	macro assertNavigationMenuItem {
		Default.AssertVisible(
			key_pageName = "${itemName}",
			locator1 = "LDHome#NAVIGATION_MENU_ANY_PAGE");
	}

	macro clickFooterOption {
		Default.Click(
			key_footerOption = "${footerOption}",
			locator1 = "LDHome#FOOTER_OPTION");
	}

	macro clickLogin {
		Default.Click(locator1 = "LDHome#LOGIN_BUTTON");
	}

	macro clickPage {
		Default.Click(
			key_pageName = "${pageName}",
			locator1 = "LDHome#NAVIGATION_MENU_ANY_PAGE");
	}

	macro viewSection {
		Default.AssertElementPresent(
			key_sectionName = "${sectionName}",
			locator1 = "LDHome#SECTION");

		if (isSet(buttonName)) {
			Default.AssertElementPresent(
				key_buttonName = "${buttonName}",
				key_sectionName = "${sectionName}",
				locator1 = "LDHome#SECTION_BUTTON");
		}
	}

}