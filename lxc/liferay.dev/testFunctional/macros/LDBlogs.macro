definition {

	macro addComment {
		Default.WaitForElementPresent(locator1 = "Portal.Button#REPLY");

		Default.Refresh();

		Default.SelectFrame(locator1 = "Portal.CKEditor#BODY_FIELD_IFRAME");

		Default.Type(
			locator1 = "Portal.CKEditor#BODY",
			value1 = "${entryComment}");

		Default.SelectFrameTop();

		Default.Click(locator1 = "Portal.Button#REPLY");

		Alert.viewSuccessMessage();

		Default.Refresh();
	}

	macro addEntry {
		Default.Click(locator1 = "LDBlogs#NEW_ENTRY_BUTTON");

		Default.Click(locator1 = "LDBlogs#ENTRY_TITLE_FIELD");

		Default.Type(
			locator1 = "LDBlogs#ENTRY_TITLE_FIELD",
			value1 = "${entryTitle}");

		Default.Type(
			locator1 = "LDBlogs#ENTRY_CONTENT_FIELD",
			value1 = "${entryContent}");

		Default.KeyPress(
			locator1 = "LDBlogs#ENTRY_CONTENT_FIELD",
			value1 = "\TAB");

		Default.Click(locator1 = "LDBlogs#SUBMIT_FOR_PUBLICATION_BUTTON");

		Alert.viewSuccessMessage();
	}

	macro deleteAllEntries {
		while (Default.IsElementPresent(locator1 = "LDBlogs#ENTRY_AUTHOR")) {
			LDBlogs.deleteEntry();

			Default.Refresh();
		}
	}

	macro deleteComment {
		Default.MouseOver(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#ENTRY_COMMENT");

		Default.Click(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#COMMENT_ELLIPSIS_ICON");

		Default.Click(
			key_menuOption = "delete",
			locator1 = "LDBlogs#ELLIPSIS_MENU_ITEM");

		Default.Confirm.acceptAlert();

		Alert.viewSuccessMessage();
	}

	macro deleteCommentReply {
		Default.MouseOver(
			key_entryComment = "${commentReply}",
			locator1 = "LDBlogs#ENTRY_COMMENT");

		Default.Click(
			key_entryComment = "${commentReply}",
			locator1 = "LDBlogs#COMMENT_ELLIPSIS_ICON_2");

		Default.Click(
			key_menuOption = "delete",
			locator1 = "LDBlogs#ELLIPSIS_MENU_ITEM");

		Default.Confirm.acceptAlert();

		Alert.viewSuccessMessage();
	}

	macro deleteEntry {
		Default.MouseOver.mouseOverInvisible(locator1 = "LDBlogs#ENTRY_AUTHOR");

		if (isSet(entryTitle)) {
			Default.Click(
				key_text = "${entryTitle}",
				locator1 = "Icon#ANY_VERTICAL_ELLIPSIS");
		}
		else {
			Default.Click(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS");
		}

		MenuItem.clickNoError(menuItem = "Delete");

		Alert.viewSuccessMessage();
	}

	macro editComment {
		Default.MouseOver(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#ENTRY_COMMENT");

		Default.Click(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#COMMENT_ELLIPSIS_ICON");

		Default.Click(
			key_menuOption = "edit",
			locator1 = "LDBlogs#ELLIPSIS_MENU_ITEM");

		Default.SelectFrame(locator1 = "Portal.CKEditor#BODY_FIELD_IFRAME_2");

		Default.Type(
			locator1 = "Portal.CKEditor#BODY",
			value1 = "${editedEntryComment}");

		Default.SelectFrameTop();

		Default.Click(locator1 = "LDBlogs#SUBMIT_FOR_PUBLICATION_BUTTON");

		Alert.viewSuccessMessage();
	}

	macro editCommentReply {
		Default.MouseOver(
			key_entryComment = "${commentReply}",
			locator1 = "LDBlogs#ENTRY_COMMENT");

		Default.Click(
			key_entryComment = "${commentReply}",
			locator1 = "LDBlogs#COMMENT_ELLIPSIS_ICON_2");

		Default.Click(
			key_menuOption = "edit",
			locator1 = "LDBlogs#ELLIPSIS_MENU_ITEM");

		Default.SelectFrame(locator1 = "Portal.CKEditor#BODY_FIELD_IFRAME_2");

		Default.Type(
			locator1 = "Portal.CKEditor#BODY",
			value1 = "${editedCommentReply}");

		Default.SelectFrameTop();

		Default.Click(locator1 = "LDBlogs#SUBMIT_FOR_PUBLICATION_BUTTON_2");

		Alert.viewSuccessMessage();
	}

	macro editEntry {
		Default.Click(
			key_text = "${entryTitle}",
			locator1 = "Icon#ANY_VERTICAL_ELLIPSIS");

		MenuItem.clickNoError(menuItem = "Edit");

		if (isSet(newEntryTitle)) {
			Default.Click(locator1 = "LDBlogs#ENTRY_TITLE_FIELD");

			Default.Type(
				locator1 = "LDBlogs#ENTRY_TITLE_FIELD",
				value1 = "${newEntryTitle}");
		}

		if (isSet(newEntryContent)) {
			Default.Click(locator1 = "LDBlogs#ENTRY_CONTENT_FIELD");

			Default.Type(
				locator1 = "LDBlogs#ENTRY_CONTENT_FIELD",
				value1 = "${newEntryContent}");
		}

		Default.Click(locator1 = "LDBlogs#SUBMIT_FOR_PUBLICATION_BUTTON");
	}

	macro openBlog {
		if (isSet(entryTitle)) {
			var key_title = "${entryTitle}";

			Default.Click(locator1 = "LDBlogs#ENTRY_TITLE");
		}
		else {
			Default.Click(locator1 = "LDBlogs#ENTRY");
		}
	}

	macro replyComment {
		Default.Click.pauseClickAt(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#REPLY_BUTTON");

		Default.WaitForElementPresent(locator1 = "Portal.CKEditor#BODY_FIELD_IFRAME_2");

		Default.SelectFrame(locator1 = "Portal.CKEditor#BODY_FIELD_IFRAME_2");

		Default.Type(
			locator1 = "Portal.CKEditor#BODY",
			value1 = "${commentReply}");

		Default.SelectFrameTop();

		Default.Click(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#COMMENT_REPLY_BUTTON");

		Alert.viewSuccessMessage();
	}

	macro tearDownBlogs {
		LDNavigation.goToBlogs();

		LDBlogs.deleteAllEntries();
	}

	macro viewComment {
		Default.AssertElementPresent(
			key_entryComment = "${entryComment}",
			locator1 = "LDBlogs#ENTRY_COMMENT");
	}

	macro viewContentNotReported {
		Default.AssertElementPresent(locator1 = "LDBlogs#REPORT_MODAL_TITLE");

		Portal.Alert.viewErrorMessage(errorMessage = "Text verification failed.");
	}

	macro viewEntry {
		Default.AssertElementPresent(
			key_title = "${entryTitle}",
			locator1 = "LDBlogs#ENTRY_TITLE");
	}

	macro viewEntryNotPresent {
		Default.AssertElementNotPresent(
			key_title = "${entryTitle}",
			locator1 = "LDBlogs#ENTRY_TITLE");
	}

	macro viewTabs {
		for (var tabName : list "${tabName}") {
			Default.Click(
				key_tabName = "${tabName}",
				locator1 = "LDBlogs#ANY_TAB");

			Default.WaitForPageLoad();

			Default.AssertElementPresent(locator1 = "LDBlogs#ENTRY");

			Default.AssertElementPresent(locator1 = "LDBlogs#NEW_ENTRY_BUTTON");
		}
	}

}