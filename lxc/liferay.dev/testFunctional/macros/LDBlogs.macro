definition {

	macro addEntry {
		Default.Click(locator1 = "LDBlogs#NEW_ENTRY_BUTTON");

		Default.Click(locator1 = "LDBlogs#ENTRY_TITLE_FIELD");

		Default.Type(
			locator1 = "LDBlogs#ENTRY_TITLE_FIELD",
			value1 = "${entryTitle}");

		Default.Type(
			locator1 = "LDBlogs#ENTRY_CONTENT_FIELD",
			value1 = "${entryContent}");

		Default.Click(locator1 = "LDBlogs#SUBMIT_FOR_PUBLICATION_BUTTON");
	}

	macro deleteAllEntries {
		while (Default.IsElementPresent(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS")) {
			Default.Click(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS");

			MenuItem.clickNoError(menuItem = "Move to Recycle Bin");

			Alert.viewSuccessMessage();

			Default.Refresh();
		}
	}

	macro deleteEntry {
		Default.Click(
			key_text = "${entryTitle}",
			locator1 = "Icon#ANY_VERTICAL_ELLIPSIS");

		MenuItem.clickNoError(menuItem = "Move to Recycle Bin");

		Alert.viewSuccessMessage();
	}

	macro tearDownBlogs {
		LDBlogs.deleteAllEntries();
	}

	macro viewEntry {
		Default.AssertElementPresent(
			key_title = "${entryTitle}",
			locator1 = "LDBlogs#ENTRY_TITLE");
	}

}