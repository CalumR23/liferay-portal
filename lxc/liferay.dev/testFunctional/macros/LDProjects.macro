definition {

	macro openProject {
		Default.Click(locator1 = "LDProjects#PROJECT_CARD");
	}

	macro viewProjectCards {
		for (var cardTitle : list "${cardTitleList}") {
			var key_projectCardTitle = "${cardTitle}";

			Default.AssertElementPresent(locator1 = "LDProjects#ANY_PROJECT_CARD");
		}
	}

}