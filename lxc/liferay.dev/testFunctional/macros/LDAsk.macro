definition {

	macro _answerAction {
		Default.Click(
			key_answerText = "${answerText}",
			key_buttonName = "${buttonName}",
			locator1 = "LDAsk#ANSWER_BUTTON");
	}

	macro answerQuestion {
		LDAsk.openQuestion(questionTitle = "${questionTitle}");

		Default.SelectFrame(locator1 = "LDAsk#ANSWER_IFRAME");

		Default.Type(
			locator1 = "LDAsk#INPUT_BODY",
			value1 = "${questionAnswer}");

		Default.SelectFrame(value1 = "relative=top");

		Default.Click(
			key_buttonName = "Submit for Publication",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.WaitForElementPresent(
			key_answerText = "${questionAnswer}",
			locator1 = "LDAsk#ANSWER");
	}

	macro askQuestion {
		Default.Click(
			key_buttonName = "Ask Question",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.Type(
			locator1 = "LDAsk#INPUT_TITLE",
			value1 = "${questionTitle}");

		Default.SelectFrame(locator1 = "LDAsk#BODY_FIELD_IFRAME");

		Default.Type(
			locator1 = "LDAsk#INPUT_BODY",
			value1 = "${questionBody}");

		Default.SelectFrame(value1 = "relative=top");

		Default.Click(
			key_buttonName = "Submit for Publication",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.WaitForElementPresent(locator1 = "LDAsk#QUESTION");
	}

	macro deleteAnswer {
		LDAsk._answerAction(
			answerText = "${answerText}",
			buttonName = "Delete");

		Default.Click(locator1 = "LDAsk#CONFIRMATION_DELETE_BUTTON");

		Default.Refresh();
	}

	macro deleteQuestion {
		LDAsk.openQuestion(questionTitle = "${questionTitle}");

		Default.Click.clickNoMouseOver(
			key_buttonName = "Delete",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.Click(locator1 = "LDAsk#CONFIRMATION_DELETE_BUTTON");

		Default.WaitForElementPresent(locator1 = "LDAsk#QUESTION");
	}

	macro editAnswer {
		LDAsk._answerAction(
			answerText = "${answerText}",
			buttonName = "Edit");

		Default.SelectFrame(locator1 = "LDAsk#ANSWER_IFRAME");

		Default.Type(
			locator1 = "LDAsk#INPUT_BODY",
			value1 = "${editedAnswerText}");

		Default.SelectFrame(value1 = "relative=top");

		Default.Click(
			key_buttonName = "Submit for Publication",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.WaitForElementPresent(
			key_answerText = "${editedAnswerText}",
			locator1 = "LDAsk#ANSWER");
	}

	macro editQuestion {
		LDAsk.openQuestion(questionTitle = "${questionTitle}");

		Default.Click.clickNoMouseOver(locator1 = "LDAsk#EDIT_QUESTION_BUTTON");

		Default.Type(
			locator1 = "LDAsk#INPUT_TITLE",
			value1 = "${newQuestionTitle}");

		Default.Click(
			key_buttonName = "Submit for Publication",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.WaitForElementPresent(
			key_questionTitle = "${newQuestionTitle}",
			locator1 = "LDAsk#QUESTION_TITLE");
	}

	macro markAsAnswer {
		LDAsk._answerAction(
			answerText = "${answerText}",
			buttonName = "Mark as answer");
	}

	macro openCard {
		if (isSet(cardTitle)) {
			var key_cardTitle = "${cardTitle}";

			Default.Click(locator1 = "LDAsk#CARD_TITLE");
		}
		else {
			Default.WaitForElementPresent(locator1 = "LDAsk#CARD");

			Default.Click(locator1 = "LDAsk#CARD");
		}
	}

	macro openQuestion {
		if (isSet(questionTitle)) {
			var key_questionTitle = "${questionTitle}";

			Default.Click(locator1 = "LDAsk#QUESTION_TITLE");
		}
		else {
			Default.Click(locator1 = "LDAsk#QUESTION");
		}
	}

	macro replyAnswer {
		LDAsk._answerAction(
			answerText = "${answerText}",
			buttonName = "Reply");

		Default.SelectFrame(locator1 = "LDAsk#ANSWER_IFRAME");

		Default.Type(
			locator1 = "LDAsk#INPUT_BODY",
			value1 = "${replyText}");

		Default.SelectFrame(value1 = "relative=top");

		Default.Click(
			key_buttonName = "Submit for Publication",
			locator1 = "LDAsk#ANY_BUTTON");

		Default.WaitForElementPresent(
			key_replyText = "${replyText}",
			locator1 = "LDAsk#REPLY");
	}

	macro search {
		Default.Type(
			locator1 = "LDAsk#SEARCH_FIELD",
			value1 = "${searchTerm}");

		Default.KeyPress(
			locator1 = "LDAsk#SEARCH_FIELD",
			value1 = "\ENTER");
	}

	macro setQuestionsFilter {
		Default.WaitForElementPresent(locator1 = "LDAsk#QUESTION_FILTER");

		Default.Select(
			locator1 = "LDAsk#QUESTION_FILTER",
			value1 = "${filterOption}");
	}

	macro viewCardTitlesOnQuestionSections {
		for (var cardTitle : list "${cardTitleList}") {
			var key_cardTitle = "${cardTitle}";

			Default.AssertElementPresent(locator1 = "LDAsk#CARD_TITLE");
		}
	}

	macro viewSearch {
		Default.AssertElementPresent(locator1 = "LDAsk#SEARCH_FIELD");
	}

}