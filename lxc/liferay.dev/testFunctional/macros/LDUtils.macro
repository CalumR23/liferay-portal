definition {

	macro acceptCookies {
		if (Default.IsElementPresent(locator1 = "LDHome#COOKIE_BANNER_BUTTON")) {
			Default.Click(locator1 = "LDHome#COOKIE_BANNER_BUTTON");
		}
	}

	macro launchLDProd {
		var portalURL = PropsUtil.get("test.this.liferaydev.portal.url.prod");

		Default.Open(locator1 = "${portalURL}");

		Default.Pause(locator1 = "1000");
	}

	macro launchLDUat {
		LDUtils.launchLDWithAuthentication();
	}

	macro launchLDWithAuthentication {
		var user = PropsUtil.get("test.this.liferaydev.test.account.webserver.user.login");
		var password = PropsUtil.get("test.this.liferaydev.test.account.webserver.user.password");

		Default.Open(locator1 = "https://${user}:${password}@uat.liferay.dev");
	}

	macro validateCurrentURL {
		var currentURL = "${currentURL}";
		var notExpectedContent = "${notExpectedContent}";

		if (!(isSet(currentURL))) {
			var currentURL = selenium.getCurrentUrl();
		}

		if (!(isSet(notExpectedContent))) {
			var notExpectedContent = "/web/guest";
		}

		if (contains("${currentURL}", "${notExpectedContent}")) {
			Portal.TestUtils.fail(message = "FAILED: Not expected content: &quot;${notExpectedContent}&quot; is present.");
		}
		else {
			Portal.TestUtils.pass(message = "PASSED: Not expected content: &quot;${notExpectedContent}&quot; is not present.");
		}
	}

}