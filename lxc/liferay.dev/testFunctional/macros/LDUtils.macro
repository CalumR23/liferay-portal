definition {

	macro launchLD {
		var portalURL = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portalURL}");

		Default.Pause(locator1 = "3000");
	}

	macro launchLDWithAuthentication {
		var user = PropsUtil.get("webserver.user");
		var password = PropsUtil.get("webserver.user.password");

		Default.Open(locator1 = "https://${user}:${password}@uat.liferay.dev");

		Default.Pause(locator1 = "5000");
	}

}