definition {

	macro launchLD {
		var portalURL = PropsUtil.get("liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalURL}");

		Default.Pause(locator1 = "3000");
	}

	macro launchLDWithAuthentication {
		var user = PropsUtil.get("liferaydev.test.account.webserver.user.login");
		var password = PropsUtil.get("liferaydev.test.account.webserver.user.password");

		Default.Open(locator1 = "https://${user}:${password}@uat.liferay.dev");

		Default.Pause(locator1 = "5000");
	}

}