definition {

	macro goToSlackSignIn {
		Default.SelectFrame(locator1 = "LDChat#CHAT_MAIN_PAGE_IFRAME");

		Default.Click(locator1 = "LDChat#SIGN_IN_OPTION");
	}

	@summary = "Making sure the 'Chat' main page elements are present"
	macro viewChatMainPageElements {
		task ("View header is present in main page") {
			Default.AssertElementPresent(locator1 = "LDChat#CHAT_MAIN_PAGE_HEADER");
		}

		task ("Checking three buttons to access Liferay Community") {
			Default.AssertElementPresent(
				key_text = "google",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");

			Default.AssertElementPresent(
				key_text = "Apple",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");

			Default.AssertElementPresent(
				key_text = "email",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");
		}
	}

	macro viewLiferayCommunitySlackPage {
		Default.AssertLocation(value1 = "https://liferay-community.slack.com/");

		Default.AssertElementPresent(locator1 = "LDChat#LIFERAY_COMMUNITY_HEADING");

		Default.AssertElementPresent(locator1 = "LDChat#LIFERAY_COMMUNITY_SUB_HEADING");

		Default.AssertElementPresent(locator1 = "LDChat#LIFERAY_COMMUNITY_SIGN_IN_BUTTON");
	}

}