definition {

	macro goToSlackSignInByEmail {
		Default.Click(
			key_text = "email",
			locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");
	}

	@summary = "Making sure the 'Chat' main page elements are present"
	macro viewChatMainPageElements {
		task ("View header is present in main page") {
			Default.AssertElementPresent(locator1 = "LDChat#CHAT_MAIN_PAGE_HEADER");
		}

		task ("Checking three buttons to access Liferay Community") {
			Default.AssertElementPresent(
				key_text = "google",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");

			Default.AssertElementPresent(
				key_text = "Apple",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");

			Default.AssertElementPresent(
				key_text = "email",
				locator1 = "LDChat#CHAT_MAIN_PAGE_CONTINUE_BUTTON");
		}
	}

	macro viewLiferayCommunityAccessToSlackPage {
		task ("Making sure URL contains the 'liferay-community.slack.com'") {
			Default.AssertLocation.assertPartialLocation(value1 = "https://liferay-community.slack.com/");
		}

		task ("Assert input fields for email and full name are present in the page") {
			Default.AssertElementPresent(locator1 = "LDChat#EMAIL_INPUT");

			Default.AssertElementPresent(locator1 = "LDChat#FULL_NAME_INPUT");
		}
	}

}