definition {

	macro goToAsk {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalUatURL}/ask");
	}

	macro goToBlogs {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalUatURL}/blogs");
	}

	macro goToChat {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalUatURL}/chat");
	}

	macro goToDev24 {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalUatURL}/twentyfour");
	}

	macro goToHome {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

		Default.Open(locator1 = "${portalUatURL}/home");
	}

	macro goToLogin {
		var portalUatURL = PropsUtil.get("test.this.liferaydev.portal.url.uat");

