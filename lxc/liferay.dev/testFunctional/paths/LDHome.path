<html>
<head>
<title>LDHome</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDHome</td></tr>
</thead>

<tbody>

<!-- COOKIE BANNER BUTTON -->

<tr>
	<td>COOKIE_BANNER_BUTTON</td>
	<td>//a[contains(@class,'cookie-banner-button')]</td>
	<td></td>
</tr>

<!-- FOOTER -->

<tr>
	<td>FOOTER_OPTION</td>
	<td>//footer//a[normalize-space()='${key_footerOption}'] | //footer//a[@title='${key_footerOption}']</td>
	<td></td>
</tr>

<!-- LOGIN BUTTON -->

<tr>
	<td>LOGIN_BUTTON</td>
	<td>//a[contains(@id,'sign-in')]</td>
	<td></td>
</tr>

<!-- SECTIONS -->

<tr>
	<td>SECTION</td>
	<td>//*[normalize-space(text())='${key_sectionName}']//ancestor::div[contains(@id,'fragment')]/..</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_BUTTON</td>
	<td>//*[normalize-space(text())='${key_sectionName}']//ancestor::div[contains(@id,'fragment')]/..//a[normalize-space()='${key_buttonName}']</td>
	<td></td>
</tr>

<!-- SITE PAGES -->

<tr>
	<td>NAVIGATION_MENU_ANY_PAGE</td>
	<td>//ul[@aria-label='Site Pages']//span[normalize-space(text())='${key_pageName}']/ancestor::a</td>
	<td></td>
</tr>

<!-- YOUTUBE VIDEO -->

<tr>
	<td>YOUTUBE_VIDEO_IFRAME</td>
	<td>//iframe[contains(@src,'youtube')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>