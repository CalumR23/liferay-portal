<html>
<head>
<title>LDChat</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDChat</td></tr>
</thead>

<tbody>
<tr>
	<td>CHAT_MAIN_PAGE_IFRAME</td>
	<td>//iframe[contains(@id,'liferay')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_INPUT</td>
	<td>//input[@type='email']</td>
	<td></td>
</tr>
<tr>
	<td>GET_MY_INVITE_BUTTON</td>
	<td>//button[normalize-space(text())='Get my Invite']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_OPTION</td>
	<td>//a[normalize-space()='sign in']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>