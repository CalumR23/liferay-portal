<html>
<head>
<title>LDChat</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDChat</td></tr>
</thead>

<tbody>
<tr>
	<td>CHAT_MAIN_PAGE_HEADER</td>
	<td>//header/following-sibling::*//span[contains(text(),'Liferay Community')]</td>
	<td></td>
</tr>
<tr>
	<td>CHAT_MAIN_PAGE_CONTINUE_BUTTON</td>
	<td>//button[contains(@*,'${key_text}')] | //span[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>

<!-- LIFERAY-COMMUNITY SLACK LOGIN -->

<tr>
	<td>LIFERAY_COMMUNITY_HEADING</td>
	<td>//h1[text()='Sign in to ']/span[text()='Liferay Community']</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_COMMUNITY_SIGN_IN_BUTTON</td>
	<td>//button[contains(@id,'signin')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_COMMUNITY_SUB_HEADING</td>
	<td>//div[contains(@class,'sub_heading')][text()='liferay-community.slack.com']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>