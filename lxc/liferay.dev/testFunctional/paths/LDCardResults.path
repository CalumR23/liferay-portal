<html>
<head>
<title>LDCardResults</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDCardResults</td></tr>
</thead>

<tbody>
<!-- CARD TITLE ON BREADCRUMB -->
<tr>
	<td>BREADCRUMB_TITLE</td>
	<td>//section[contains(@class,'questions-breadcrumb')]//a[contains(.,'${key_cardTitle}')]</td>
	<td></td>
</tr>

<!-- CARD TITLE ON QUESTION TITLE -->
<tr>
	<td>QUESTION_TITLE</td>
	<td>//div[contains(@class,'question-row')]//h2[contains(.,'${key_cardTitle}')]</td>
	<td></td>
</tr>

<!-- CARD TITLE ON QUESTION TITLE -->
<tr>
	<td>QUESTION_CONTENT</td>
	<td>//div[contains(@class,'question-row')]//div[contains(@class,'question-row-article-body')]//div[contains(@class,'questions-article-body') and contains (.,'${key_cardTitle}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>