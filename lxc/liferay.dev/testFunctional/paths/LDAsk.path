<html>
<head>
<title>LDAsk</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDAsk</td></tr>
</thead>

<tbody>

<!-- SEARCH -->

<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>

<!-- CARDS SECTION -->

<tr>
	<td>CARD</td>
	<td>//div[contains(@class,'card-type')]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_TITLE</td>
	<td>//div[contains(@class,'card-body')]//span[normalize-space(text())='${key_cardTitle}']</td>
	<td></td>
</tr>

<!-- BUTTON -->

<tr>
	<td>ANY_BUTTON</td>
	<td>//*[contains(@class,'btn')][normalize-space(text())='${key_buttonName}'] | //*[contains(@class,'btn')][@title='${key_buttonName}']</td>
	<td></td>
</tr>
<tr>
	<td>CONFIRMATION_DELETE_BUTTON</td>
	<td>//div[normalize-space(text())='Do you want to delete this question?']/following-sibling::div//button[normalize-space(text())='Delete'] | //div[normalize-space(text())='Do you want to delete this answer?']/following-sibling::div//button[normalize-space(text())='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_QUESTION_BUTTON</td>
	<td>//button[normalize-space(text())='Edit']</td>
	<td></td>
</tr>

<!-- NEW QUESTION -->

<tr>
	<td>INPUT_TITLE</td>
	<td>//input[@placeholder='What is your question?']</td>
	<td></td>
</tr>
<tr>
	<td>BODY_FIELD_IFRAME</td>
	<td>//*[contains(@id,'cke')]/iframe</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_BODY</td>
	<td>//body[contains(@class,'cke_editable')]</td>
	<td></td>
</tr>

<!-- QUESTIONS PAGE -->

<tr>
	<td>ANSWER</td>
	<td>//div[contains(@class,'questions-answer')]//p[normalize-space(text())='${key_answerText}']</td>
	<td></td>
</tr>
<tr>
	<td>ANSWER_BUTTON</td>
	<td>//p[normalize-space(text())='${key_answerText}']//ancestor::div[contains(@class,'questions-answer')]//button[normalize-space()='${key_buttonName}']</td>
	<td></td>
</tr>
<tr>
	<td>ANSWER_IFRAME</td>
	<td>//iframe[contains(@class,'wysiwyg')]</td>
	<td></td>
</tr>
<tr>
	<td>CHOSEN_ANSWER_LABEL</td>
	<td>//p[@data-testid='mark-as-answer-check']</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION</td>
	<td>//div[contains(@class,'questions-container')]/div[contains(@class,'c-mx-auto')]/div[contains(@class,'question-row')]</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_BELL_ON</td>
	<td>//h1[normalize-space()='${key_questionTitle}']/../following-sibling::div//button[*[name()='svg'][contains(@class,'bell-on')]][@class='btn btn-primary']</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_FILTER</td>
	<td>//select[@id='questionsFilter']</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_PENDING_LABEL</td>
	<td>//div[contains(@class,'question-row')]/a[contains(@class,'questions-title')]/h2[normalize-space(text())='${key_questionTitle}']//span[contains(@class,'')][normalize-space(text())='pending']</td>
	<td></td>
</tr>
<tr>
	<td>QUESTION_TITLE</td>
	<td>//div[contains(@class,'question-row')]/a[contains(@class,'questions-title')]/h2[normalize-space(text())='${key_questionTitle}'] | //h1[normalize-space(text())='${key_questionTitle}']</td>
	<td></td>
</tr>
<tr>
	<td>REPLY</td>
	<td>//div[contains(@class,'cke_readonly questions-article-body')]//p[normalize-space(text())='${key_replyText}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>