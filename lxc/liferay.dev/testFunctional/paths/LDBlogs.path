<html>
<head>
<title>LDBlogs</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDBlogs</td></tr>
</thead>

<tbody>

<!-- BLOGS PAGE -->

<tr>
	<td>ANY_TAB</td>
	<td>//a[contains(@class,'subnav-item')][normalize-space(text())='${key_tabName}']</td>
	<td></td>
</tr>
<tr>
	<td>BLOGS_PAGE_HEADER</td>
	<td>//div[@class='section-header-title']//h1[normalize-space(text())='Blogs']</td>
	<td></td>
</tr>

<!-- BLOGS PAGE PUBLISHED TAB -->

<tr>
	<td>BLOGS_PAGE_PUBLISHED_TAB</td>
	<td>//div[contains(@class,'navbar')]//*[(text()='Published')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_REPLY_BUTTON</td>
	<td>//div[@class='lfr-discussion-message-body'][normalize-space()='${key_entryComment}']/../following-sibling::div//button[normalize-space()='Reply']//ancestor::div[@class="comment-container"]/following-sibling::div//button[normalize-space()='Reply']</td>
	<td></td>
</tr>
<tr>
	<td>BLOG_REPORT_BUTTON</td>
	<td>//span[text()='Report']//ancestor::button</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_REPORT_BUTTON</td>
	<td>//button[text()='Report']</td>
	<td></td>
</tr>
<tr>
	<td>REPORT_MODAL_TITLE</td>
	<td>//div[text()='Report Inappropriate Content']</td>
	<td></td>
</tr>

<!-- ENTRY CONTENT FIELD -->

<tr>
	<td>ENTRY_CONTENT_FIELD</td>
	<td>//div[contains(@data-placeholder,'Content')]</td>
	<td></td>
</tr>

<!-- ENTRY SUBTITLE FIELD -->

<tr>
	<td>ENTRY_SUBTITLE_FIELD</td>
	<td>//textarea[@id='_com_liferay_blogs_web_portlet_BlogsAdminPortlet_subtitle']</td>
	<td></td>
</tr>

<!-- ENTRY TITLE -->

<tr>
	<td>ENTRY</td>
	<td>//div[@class='widget-mode-simple-entry']//a[contains(@class,'title-link')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_TITLE</td>
	<td>//div[@class='widget-mode-simple-entry']//a[text()='${key_title}']</td>
	<td></td>
</tr>

<!-- ENTRY TITLE FIELD -->

<tr>
	<td>ENTRY_TITLE_FIELD</td>
	<td>//textarea[@id='_com_liferay_blogs_web_portlet_BlogsAdminPortlet_title'] | //textarea[@id='_com_liferay_blogs_web_portlet_BlogsPortlet_title']</td>
	<td></td>
</tr>

<!-- NEW ENTRY BUTTON -->

<tr>
	<td>NEW_ENTRY_BUTTON</td>
	<td>//div[contains(@class,'portlet-body')]//a[contains(@class,'btn-primary') and contains(text(),'New Entry')]</td>
	<td></td>
</tr>

<!-- SUBMIT FOR PUBLICATION BUTTON -->

<tr>
	<td>SUBMIT_FOR_PUBLICATION_BUTTON</td>
	<td>//button[contains(@name,'publish')] | //button[normalize-space()='Submit for Publication']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_FOR_PUBLICATION_BUTTON_2</td>
	<td>xpath=(//button[contains(@name,'publish')] | //button[normalize-space()='Submit for Publication'])[2]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_ELLIPSIS_ICON</td>
	<td>//div[@class='lfr-discussion-message-body'][normalize-space()='${key_entryComment}']//ancestor::article//span[*[name()='svg'][contains(@class,'icon-ellipsis')]]/ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_ELLIPSIS_ICON_2</td>
	<td>xpath=(//div[@class='lfr-discussion-message-body'][normalize-space()='${key_entryComment}']//ancestor::article//span[*[name()='svg'][contains(@class,'icon-ellipsis')]]/ancestor::a)[2]</td>
	<td></td>
</tr>
<tr>
	<td>ELLIPSIS_MENU_ITEM</td>
	<td>//div[contains(@class,'icon-menu-open')]//a[contains(@id,'${key_menuOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_AUTHOR</td>
	<td>//*[normalize-space()='Liferay Dev UAT User']</td>
	<td></td>
</tr>
<tr>
	<td>ENTRY_COMMENT</td>
	<td>//div[@class='lfr-discussion-message-body'][normalize-space()='${key_entryComment}']</td>
	<td></td>
</tr>
<tr>
	<td>REPLY_BUTTON</td>
	<td>//div[@class='lfr-discussion-message-body'][normalize-space()='${key_entryComment}']/../following-sibling::div//button[normalize-space()='Reply']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>