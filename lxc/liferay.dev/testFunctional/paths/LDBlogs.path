<html>
<head>
<title>LDBlogs</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDBlogs</td></tr>
</thead>

<tbody>
<!-- BLOGS PAGE PUBLISHED TAB -->
<tr>
	<td>BLOGS_PAGE_PUBLISHED_TAB</td>
	<td>//div[contains(@class,'navbar')]//a[(text()='Published')]</td>
	<td></td>
</tr>
<!-- ENTRY CONTENT FIELD -->
<tr>
	<td>ENTRY_CONTENT_FIELD</td>
	<td>//div[contains(@data-placeholder,'Content')]</td>
	<td></td>
</tr>
<!-- ENTRY SUBTITLE FIELD -->
<tr>
	<td>ENTRY_SUBTITLE_FIELD</td>
	<td>//textarea[@id='_com_liferay_blogs_web_portlet_BlogsAdminPortlet_subtitle']</td>
	<td></td>
</tr>
<!-- ENTRY TITLE -->
<tr>
	<td>ENTRY_TITLE</td>
	<td>//div[@class='widget-mode-simple-entry']//a[text()='${key_title}']</td>
	<td></td>
</tr>
<!-- ENTRY TITLE FIELD -->
<tr>
	<td>ENTRY_TITLE_FIELD</td>
	<td>//textarea[@id='_com_liferay_blogs_web_portlet_BlogsAdminPortlet_title']</td>
	<td></td>
</tr>
<!-- NEW ENTRY BUTTON -->
<tr>
	<td>NEW_ENTRY_BUTTON</td>
	<td>//div[contains(@class,'portlet-body')]//a[contains(@class,'btn-primary') and contains(text(),'New Entry')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>