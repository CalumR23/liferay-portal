<html>
<head>
<title>LDProjects</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDProjects</td></tr>
</thead>

<tbody>

<!-- PROJECTS PAGE -->

<tr>
	<td>ANY_PROJECT_CARD</td>
	<td>//h3[text()='${key_projectCardTitle}']//ancestor::div/a[@class='project-item']</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CARD</td>
	<td>//a[contains(@class,'project-item')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_PAGE_HEADER</td>
	<td>//div[@class='section-header-title']//h1[normalize-space(text())='Our Projects']</td>
	<td></td>
</tr>
<tr>
	<td>TAB</td>
	<td>//a[text()='${key_tabName}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>