definition {

	macro goToNavigationBarOption {
		if (isSet(navigationSubmenuItem)) {
			Default.MouseOver(
				key_menuItem = "${navigationMenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");

			Default.Click(
				key_menuItem = "${navigationSubmenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");
		}
		else {
			Default.Click(
				key_menuItem = "${navigationMenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");
		}
	}

	macro viewPage {
		Default.AssertElementPresent(
			key_text = "${subHeadingText}",
			locator1 = "PageElements#SUBHEADING");

		var baseURL = PropsUtil.get("test.this.cosette.${pageName}.portal.url.uat");

		if (Default.IsElementPresent(key_text = "on your prescription", locator1 = "PageElements#SUBHEADING")) {
			Default.AssertLocation(value1 = "${baseURL}/savings");
		}
		else {
			Default.AssertLocation(value1 = "${baseURL}");
		}
	}

	macro viewProdPage {
		Default.AssertElementPresent(
			key_text = "${subHeadingText}",
			locator1 = "PageElements#SUBHEADING");

		if (Default.IsElementPresent(key_text = "on your prescription", locator1 = "PageElements#SUBHEADING")) {
			Default.AssertLocation(value1 = "https://${pageName}.com/savings");
		}
		else {
			Default.AssertLocation.assertPartialLocation(value1 = "${pageName}.com");
		}
	}

	macro viewSubHeading {
		Default.AssertElementPresent(
			key_text = "${subHeadingText}",
			locator1 = "PageElements#SUBHEADING");
	}

	macro viewURL {
		if (isSet(headingText)) {
			Default.WaitForElementPresent(
				key_text = "${headingText}",
				locator1 = "PageElements#HEADING");

			Default.AssertLocation(value1 = "${url}");
		}
		else {
			Default.AssertLocation(value1 = "${url}");
		}
	}

}