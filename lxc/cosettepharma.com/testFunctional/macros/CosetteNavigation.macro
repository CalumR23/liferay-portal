definition {

	macro goToNavigationBarOption {
		if (isSet(navigationSubmenuItem)) {
			Default.MouseOver(
				key_menuItem = "${navigationMenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");

			Default.Click(
				key_menuItem = "${navigationSubmenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");
		}
		else {
			Default.Click(
				key_menuItem = "${navigationMenuItem}",
				locator1 = "CosetteNavigation#NAVIGATION_MENU_ITEM");
		}
	}

	macro viewPage {
		Default.AssertElementPresent(
			key_text = "${subHeadingText}",
			locator1 = "PageElements#SUBHEADING");

		if (Default.IsElementPresent(key_text = "on your prescription", locator1 = "PageElements#SUBHEADING")) {
			Default.AssertLocation(value1 = "https://test.${pageName}.com/savings");
		}
		else {
			Default.AssertLocation(value1 = "https://test.${pageName}.com/");
		}
	}

}