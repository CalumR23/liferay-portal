definition {

	@summary = "Launches the Azor portal with user authentication"
	macro launchAzorUat {
		var portalUatURL = PropsUtil.get("test.this.cosette.azor.portal.url.uat");

		Utils.launchPortalWithAuthentication(uatURL = "${portalUatURL}");

		Default.Open(locator1 = "${portalUatURL}");
	}

	@summary = "Launches the Benicar portal with user authentication"
	macro launchBenicarUat {
		var portalUatURL = PropsUtil.get("test.this.cosette.benicar.portal.url.uat");

		Utils.launchPortalWithAuthentication(uatURL = "${portalUatURL}");

		Default.Open(locator1 = "${portalUatURL}");
	}

	@summary = "Launches the portal with user authentication"
	macro launchPortalWithAuthentication {
		var userLogin = PropsUtil.get("test.this.cosette.test.account.webserver.user.login");
		var userPassword = PropsUtil.get("test.this.cosette.test.account.webserver.user.password");
		var extractedUatURL = StringUtil.extractLast("${uatURL}", "https://");

		Default.Open(locator1 = "https://${userLogin}:${userPassword}@${extractedUatURL}");
	}

	@summary = "Launches the Tribenzor portal with user authentication"
	macro launchTribenzorUat {
		var portalUatURL = PropsUtil.get("test.this.cosette.tribenzor.portal.url.uat");

		Utils.launchPortalWithAuthentication(uatURL = "${portalUatURL}");

		Default.Open(locator1 = "${portalUatURL}");
	}

	@summary = "Launches the Welcholhcp portal with user authentication"
	macro launchWelcholhcpUat {
		var portalUatURL = PropsUtil.get("test.this.cosette.welcholhcp.portal.url.uat");

		Utils.launchPortalWithAuthentication(uatURL = "${portalUatURL}");

		Default.Open(locator1 = "${portalUatURL}");
	}

	@summary = "Launches the Welchol portal with user authentication"
	macro launchWelcholUat {
		var portalUatURL = PropsUtil.get("test.this.cosette.welchol.portal.url.uat");

		Utils.launchPortalWithAuthentication(uatURL = "${portalUatURL}");

		Default.Open(locator1 = "${portalUatURL}");
	}

}