definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	@description = "Automation ID: LRQA-77387 | Test Summary: Verify XML file is properly returned by API for AZOR"
	@priority = "5"
	test CanLoadXMLFile {
		task ("When azor API URL is launched") {
			Utils.launchUatAPI(pageName = "azor");
		}

		task ("Then the XML is properly returned") {
			API.viewReturnedXML();
		}
	}

}