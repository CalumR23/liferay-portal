definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	@description = "Automation ID: LRQA-77387 | Test Summary: Verify XML file is properly returned when triggering the Coupon API for AZOR site"
	@priority = "5"
	test CanLoadXMLFile {
		task ("When Coupon API URL is accessed for AZOR site") {
			Utils.launchUatAPI(pageName = "azor");
		}

		task ("Then the XML is properly returned") {
			API.viewReturnedXML();
		}
	}

}