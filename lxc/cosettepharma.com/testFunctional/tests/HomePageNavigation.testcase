definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	setUp {
		Utils.launchAzorUat();
	}

	@description = "Automation ID: LRQA-76095 | Test Summary: Verify the user is properly redirected to https://test.benicar.com/hypertension-treatment when clicking in the Navigation bar option: About Your Medication"
	@priority = "5"
	test CanOpenAboutYourMedicationPageFromNavigationBar {
		task ("Given BENICAR page is loaded") {
			Utils.launchBenicarUat();
		}

		task ("When I click at 'About Your Medication' in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(
				navigationMenuItem = "Benicar",
				navigationSubmenuItem = "About Your Medication");
		}

		task ("Then I should be redirected to 'About' page") {
			CosetteNavigation.viewURL(
				headingText = "About",
				url = "https://test.benicar.com/hypertension-treatment");

			CosetteNavigation.viewSubHeading(subHeadingText = "BENICAR");
		}
	}

	@description = "Automation ID: LRQA-75923 | Test Summary: Verify user is properly redirected when clicking in the navigation bar option: AZOR"
	@priority = "5"
	test CanOpenAzorPageFromNavigationBarInBenicar {
		task ("Given BENICAR page is loaded") {
			Utils.launchBenicarUat();
		}

		task ("When I click at AZOR in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(navigationMenuItem = "Azor");
		}

		task ("Then I should be redirected to AZOR page") {
			CosetteNavigation.viewPage(
				pageName = "azor",
				subHeadingText = "AZOR");
		}
	}

	@description = "Automation ID: LRQA-75923 | Test Summary: Verify user is properly redirected when clicking in the navigation bar option: AZOR"
	@priority = "5"
	test CanOpenAzorPageFromNavigationBarInTribenzor {
		task ("Given TRIBENZOR page is loaded") {
			Utils.launchTribenzorUat();
		}

		task ("When I click at AZOR in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(navigationMenuItem = "Azor");
		}

		task ("Then I should be redirected to AZOR page") {
			CosetteNavigation.viewPage(
				pageName = "azor",
				subHeadingText = "AZOR");
		}
	}

