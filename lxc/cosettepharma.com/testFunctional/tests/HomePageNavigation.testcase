		}

		task ("Then I should be redirected to 'Understanding' page") {
			CosetteNavigation.viewURL(
				headingText = "Understanding",
				url = "https://test.tribenzor.com/how-tribenzor-works");

			CosetteNavigation.viewSubHeading(subHeadingText = "TRIBENZOR");
		}
	}

	@description = "Automation ID: LRQA-76125 | Test Summary: Verify the user is properly redirected to https://test.azor.com/dosage when clicking in the Navigation bar option: Taking AZOR"
