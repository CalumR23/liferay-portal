definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	setUp {
		Utils.launchAzorUat();
	}

	@description = "Automation ID: LRQA-76162 | Test Summary: Verify the user is properly redirected when clicking at LEARN MORE button"
	@priority = "5"
	test CanOpenAboutAzorPageFromLearnMore {
		task ("Given AZOR page is loaded") {
			Utils.launchAzorUat();
		}

		task ("When I click at 'LEARN MORE' button") {
			Default.Click(
				key_buttonName = "LEARN MORE",
				locator1 = "PageElements#BUTTON_ANY");
		}

		task ("Then I should be redirected to 'About' page") {
			CosetteNavigation.viewURL(
				headingText = "About",
				partialURL = "/high-blood-pressure-medication");
		}
	}

	@description = "Automation ID: LRQA-76141 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: ABOUT WELCHOL"
	@priority = "5"
	test CanOpenAboutPageFromNavigationBarInWelchol {
		task ("Given Welchol page is loaded") {
			Utils.launchWelcholUat();
		}

		task ("When I click at 'About Welchol' in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(navigationMenuItem = "About Welchol");
		}

		task ("Then I should be redirected to 'About' page") {
			CosetteNavigation.viewURL(
				headingText = "About Welchol",
				partialURL = "/about-welchol");
		}
	}

