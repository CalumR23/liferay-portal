	@description = "Automation ID: LRQA-76157 | Test Summary: Verify the user is properly redirected when clicking in the Navigation bar option: HOME"
	@priority = "5"
	test CanOpenHomePageFromNavigationBar {
		task ("Given Welcholhcp Dosing page is loaded") {
			Utils.launchWelcholhcpUat();

			CosetteNavigation.goToNavigationBarOption(navigationMenuItem = "Dosing");

			Default.WaitForElementPresent(
				key_text = "Dosing",
				locator1 = "PageElements#HEADING");
		}

		task ("When I click at 'HOME' in the navigation bar") {
			CosetteNavigation.goToNavigationBarOption(navigationMenuItem = "Home");
		}

		task ("Then I should be redirected to the home page") {
			CosetteNavigation.viewURL(
				headingText = "Add Welchol. Help Appropriate Patients Meet the Challenge.",
				partialURL = "/home");
		}
	}

