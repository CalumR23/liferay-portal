definition {

	property test.env = "uat";
	property testray.main.component.name = "Cosette";

	setUp {
		Utils.launchAzorUat();
	}

	@description = "Automation ID: LRQA-76188 | Test Summary: Verify header item is present: Important Safety Information"
	@priority = "5"
	test ShowsContentHeaderImportantSafetyInformationAzor {
		task ("When I go to the AZOR page") {
			Utils.launchAzorUat();
		}

		task ("Then I should see the option 'Important Safety Information' in header toplink") {
			Default.AssertVisible(
				key_toplink = "Important Safety Information",
				locator1 = "CosetteNavigation#TOPLINK");
		}
	}

	@description = "Automation ID: LRQA-76188 | Test Summary: Verify header item is present: Important Safety Information"
	@priority = "5"
	test ShowsContentHeaderImportantSafetyInformationBenicar {
		task ("When I go to the BENICAR page") {
			Utils.launchBenicarUat();
		}

		task ("Then I should see the option 'Important Safety Information' in header toplink") {
			Default.AssertVisible(
				key_toplink = "Important Safety Information",
				locator1 = "CosetteNavigation#TOPLINK");
		}
	}

