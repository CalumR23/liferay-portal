<html>
<head>
<title>PageElements</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PageElements</td></tr>
</thead>

<tbody>
<tr>
	<td>BUTTON_ANY</td>
	<td>//a[contains(@class,'btn')][text()='${key_buttonName}'] | //*[text()='${key_buttonName}']/ancestor::a[contains(@class,'btn')]</td>
	<td></td>
</tr>
<tr>
	<td>COUPON_CONTAINER</td>
	<td>//img[contains(@src,'SavingsCard') or contains(@src,'savingscard')]//ancestor::div[contains(@class,'calloutcontainer')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING</td>
	<td>//div[@class='heading']/h1[contains(text(),'${key_text}')] | //*[contains(@class,'text')][normalize-space()='${key_text}']</td>
	<td></td>
</tr>
<tr>
	<td>PRE_ACTIVATED_SAVINGS_CARD_CONTAINER</td>
	<td>//div[@class='preActiveTxt']//*[contains(text(),'Pre-activated Savings Card')]//ancestor::div[contains(@class,'Container')]</td>
	<td></td>
</tr>
<tr>
	<td>PRINT_SAVINGS_CARD_NOW_BUTTON</td>
	<td>//a[contains(@class,'visibleDeskTab btn')][normalize-space()='PRINT SAVINGS CARD NOW'] | //p[@class='visibleDeskTab']/a[normalize-space()='PRINT SAVINGS CARD NOW']</td>
	<td></td>
</tr>
<tr>
	<td>START_SAVING_BUTTON</td>
	<td>//div[contains(@class,'leftContent')]//a[contains(@class,'btn')][text()='START SAVING']</td>
	<td></td>
</tr>
<tr>
	<td>PRINT_SAVINGS_CARD_BUTTON</td>
	<td>//button[normalize-space(text())='PRINT SAVINGS'] | //button[normalize-space(text())='PRINT SAVINGS CARD NOW']</td>
	<td></td>
</tr>
<tr>
	<td>SUBHEADING</td>
	<td>//div[@class='subheading']/h2[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>