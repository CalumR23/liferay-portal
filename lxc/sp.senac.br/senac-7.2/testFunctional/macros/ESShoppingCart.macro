definition {

	@summary = "Add item to mini cart"
	macro addItemToCart {
		Default.Click(locator1 = "ESShoppingCart#BUY_BUTTON");
	}

	@summary = "Remove item from mini cart"
	macro removeItemFromCart {
		Default.Click(locator1 = "ESShoppingCart#DELETE_ITEM");
	}

	@summary = "View if the item was removed from the bag"
	macro viewItemIsRemovedFromBag {
		Default.AssertElementNotPresent(locator1 = "ESShoppingCart#MY_BAG_ITEM");
	}

	@summary = "View if the item was removed from the mini cart"
	macro viewItemIsRemovedFromMiniCart {
		Default.AssertElementNotPresent(locator1 = "ESShoppingCart#MINI_CART_ITEM");
	}

	@summary = "View if the mini cart appears after adding a item"
	macro viewMiniCart {
		Default.AssertVisible(locator1 = "ESShoppingCart#MINI_CART");

		Default.AssertVisible(locator1 = "ESShoppingCart#MINI_CART_ITEM");
	}

	@summary = "View if My Bag has the items that were added"
	macro viewMyBag {
		Default.AssertElementPresent(locator1 = "ESShoppingCart#MY_BAG");

		Default.AssertElementPresent(locator1 = "ESShoppingCart#MY_BAG_ITEM");
	}

}