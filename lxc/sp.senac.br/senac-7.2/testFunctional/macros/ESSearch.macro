definition {

	@summary = "Compare the price of the two first cards"
	macro compareLowToHighPrice {
		var key_index = "1";
		var firstCard = selenium.getText("ESSearch#CONTAINER_CARD_PRICE");

		var firstCardPrice = StringUtil.extractDigits("${firstCard}");
		var key_index = "2";
		var secondCard = selenium.getText("ESSearch#CONTAINER_CARD_PRICE");

		var secondCardPrice = StringUtil.extractDigits("${secondCard}");

		Portal.TestUtils.isLessThan(
			actual = "${firstCardPrice}",
			expected = "${secondCardPrice}");
	}

	@summary = "Get the number of results found"
	macro getNumberOfResults {
		var text = selenium.getText("ESSearch#SEARCH_RESULT");

		var totalCourses = StringUtil.extractDigits("${text}");

		return "${totalCourses}";
	}

	@summary = "Peform a search in the search field"
	macro searchForContent {
		Default.Type(
			locator1 = "ESSearch#SEARCH_INPUT)",
			value1 = "${searchText}");

		Default.KeyPress(
			locator1 = "ESSearch#SEARCH_INPUT",
			value1 = "\ENTER");
	}

	@summary = "Set a filter area"
	macro selectFiltersArea {
		Default.Click(locator1 = "ESSearch#FILTERS_AREA");
	}

	@summary = "Select a price filter in the search page"
	macro selectPriceFilter {
		Default.Click(locator1 = "ESSearch#DROPDOWN_FILTER");

		Default.Click(
			key_dropdownFilter = "${dropdownFilter}",
			locator1 = "ESSearch#CHECKBOX_DROPDOWN_FILTER");

		Default.WaitForPageLoad();
	}

	@summary = "View if the cards are present after searching"
	macro viewCards {
		Default.AssertElementPresent(locator1 = "ESSearch#CONTAINER_CARD");
	}

	@summary = "View if the filters area are present"
	macro viewFiltersArea {
		Default.AssertElementPresent(locator1 = "ESSearch#FILTERS_AREA");
	}

}