definition {

	setUp {
		ESLogin.gotoSignIn();

		ESLogin.loginAsAdminUser();

		Utils.launchEditoraSenacHomePage();
	}

	@description = "Automation ID: SSPU-185 | Test Summary: Verify the user is able to add an item to the cart"
	@priority = "5"
	test CanAddItemToCart {
		task ("When the user adds an item to the cart") {
			ESShoppingCart.addItemToCart();
		}

		task ("Then the item should be displayed in the mini cart") {
			ESShoppingCart.viewMiniCart();
		}

		task ("When going to my bag section") {
			ESNavigator.gotoMyBag();
		}

		task ("Then the item should be displayed in the bag") {
			ESShoppingCart.viewMyBag();
		}
	}

	@description = "Automation ID: SSPU-185 | Test Summary: Verify the user is able to remove an item from the cart"
	@priority = "5"
	test CanRemoveItemFromCart {
		task ("Given an item is added to the minicart") {
			ESShoppingCart.addItemToCart();

			ESShoppingCart.viewMiniCart();
		}

		task ("When the user removes an item from the cart") {
			ESShoppingCart.removeItemFromCart();
		}

		task ("Then the mini cart and bag should be empty") {
			ESShoppingCart.viewItemIsRemovedFromMiniCart();

			ESNavigator.gotoMyBag();

			ESShoppingCart.viewItemIsRemovedFromBag();
		}
	}

}