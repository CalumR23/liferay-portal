<html>
<head>
<title>ESHomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ESHomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>LANCAMENTOS_CAROUSEL</td>
	<td>//div[contains(@data-analytics-asset-title,'LANÇAMENTOS')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]</td>
	<td></td>
</tr>
<tr>
	<td>LANCAMENTOS_CAROUSEL_ACTIVE_ITEM_BY_INDEX</td>
	<td>//div[contains(@data-analytics-asset-title,'LANÇAMENTOS')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]//div[contains(@class,'active')][@data-slick-index='${key_index}']</td>
	<td></td>
</tr>
<tr>
	<td>LANCAMENTOS_CAROUSEL_NEXT_BUTTON</td>
	<td>//div[contains(@data-analytics-asset-title,'LANÇAMENTOS')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]//a[contains(@class,'next')]</td>
	<td></td>
</tr>
<tr>
	<td>LANCAMENTOS_CAROUSEL_PREVIOUS_BUTTON</td>
	<td>//div[contains(@data-analytics-asset-title,'LANÇAMENTOS')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]//a[contains(@class,'prev')]</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_CAROUSEL</td>
	<td>//div[@class='banner-home']/div[contains(@class,'carrossel-principal')]</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_CAROUSEL_ACTIVE_SLIDE_BY_INDEX</td>
	<td>//div[@class='banner-home']/div[contains(@class,'carrossel-principal')]//div[contains(@class,'active')][@data-slick-index='${key_index}']</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_CAROUSEL_NEXT_BUTTON</td>
	<td>//div[@class='banner-home']/div[contains(@class,'carrossel-principal')]/a[contains(@class,'next')]</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_CAROUSEL_PREVIOUS_BUTTON</td>
	<td>//div[@class='banner-home']/div[contains(@class,'carrossel-principal')]/a[contains(@class,'prev')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_ITEM</td>
	<td>//a[@class='opcaoMenu'][normalize-space()='${key_navigationMenuItem}']</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_SUBMENU_ITEM</td>
	<td>//a[@class='opcaoMenu'][normalize-space()='${key_navigationMenuItem}']/..//*[@class='itemMenu']//a[text()='${key_navigationSubmenuItem}']</td>
	<td></td>
</tr>
<tr>
	<td>NOSSO_CATALOGO_CAROUSEL</td>
	<td>//div[contains(@data-analytics-asset-title,'NOSSO CATALOGO')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]</td>
	<td></td>
</tr>
<tr>
	<td>NOSSO_CATALOGO_CAROUSEL_ACTIVE_ITEM_BY_INDEX</td>
	<td>//div[contains(@data-analytics-asset-title,'NOSSO CATALOGO')]//ancestor::div[contains(@class,'portlet-static-end')]/following-sibling::div[1]//a[contains(@class,'active')][@data-slick-index='${key_index}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>