<html>
<head>
<title>SSPHomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SSPHomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_EXPLORE</td>
	<td>xpath=(//div[contains(@class,'slick-area-explore-senac')]//div[contains(@id,'slick-slide')][1])</td>
	<td></td>
</tr>
<tr>
	<td>CARD_EXPLORE_NEXT</td>
	<td>//a[contains(@class,'slick-next')]//i[contains(@class,'right')]</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_VIDEO</td>
	<td>//section[contains(@class,'ssp-main-box')]//video[contains(@class,'video-desktop')]</td>
	<td></td>
</tr>
<tr>
	<td>LINKS_URL</td>
	<td>//div[contains(@class,'ssp-btns-horizontal-area')]//*[text()='${key_discoverCourses}']</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_CAROUSEL</td>
	<td>//section[contains(@class,'ssp-main-box')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU</td>
	<td>//div[contains(@class,'ssp-mega-menu')]//*[contains(text(),'${key_navigationMenu}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_SUBMENU</td>
	<td>//div[contains(@class,'ssp-mega-menu')]//*[contains(text(),'${key_navigationSubmenu}')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_TITLE</td>
	<td>//*[contains(@class,'ssp-section') and contains (.,'${key_sectionTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_PAGE</td>
	<td>//*[contains(@class,'ssp-header')]//*[contains(text(),'${key_titlePage}')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER</td>
	<td>//footer[contains(@class,'ssp-footer')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_OPTION</td>
	<td>//div[contains(@id,'mainnavigationsspfooter')]//a[contains(text(),'${key_footerOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_PAGE_OPTION</td>
	<td>//span[contains(@class,'breadcrumb-text-truncate')][contains(text(),'${key_titlePage}')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA</td>
	<td>//div[contains(@class,'redes-sociais__icons')]</td>
	<td></td>
</tr>
<tr>
	<td>SOCIAL_MEDIA</td>
	<td>//div[contains(@class,'icons')]//*[contains(@class,'${key_socialMedia}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>