<html>
<head>
<title>SSPOffers</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SSPOffers</td></tr>
</thead>

<tbody>
<tr>
	<td>BUTTON_LOCATE</td>
	<td>//a[@id='btnLocalRealizacao_0']</td>
	<td></td>
</tr>
<tr>
	<td>CARD_DESCONT</td>
	<td>//div[contains(@class,'tag-label-desconto')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCONT_VALUE</td>
	<td>//div[@class='block-valor-desconto']/div[@class='ssp-card-oferta-curso__desconto-content']/p[2]</td>
	<td></td>
</tr>
<tr>
	<td>DESCONT_PAYMENT</td>
	<td>//a[@id='myBtn_0'][contains(text(),'Descontos e pagamento')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCONT_VALUE_TOTAL</td>
	<td>//div[@class='block-valor-total']/*[@class='ssp-card-oferta-curso__title-item']</td>
	<td></td>
</tr>
<tr>
	<td>ENROLLMENT_COURSES_LABEL</td>
	<td>//label[contains(@id,'inscricao-aberta')]</td>
	<td></td>
</tr>
<tr>
	<td>ENROLLMENT_COURSES_UNIDADES_LABEL</td>
	<td>//div//label[(text()='Inscrições abertas')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_UNIDADES</td>
	<td>//select[contains(@id,'unidades-ofertas')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_COURSES</td>
	<td>xpath=(//section//div[@class='slick-track']//div//div[1])</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>