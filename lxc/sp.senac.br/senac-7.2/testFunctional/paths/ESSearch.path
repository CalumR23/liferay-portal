<html>
<head>
<title>ESSearch</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ESSearch</td></tr>
</thead>

<tbody>
<tr>
	<td>CHECKBOX_DROPDOWN_FILTER</td>
	<td>//*[contains(@id,'${key_dropdownFilter}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTAINER_CARD</td>
	<td>//div[contains(@class,'itemContainerResultado')]//div[contains(@class,'itemContainerResultado')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_FILTER</td>
	<td>//button[@data-toggle='dropdown']</td>
	<td></td>
</tr>
<tr>
	<td>FILTERS_AREA</td>
	<td>xpath=(//div[@class='slick-track']/div[contains(@class,'active')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>CONTAINER_CARD_PRICE</td>
	<td>xpath=(//div[contains(@class,'itemContainerResultado')]//span[@class='product-price'][contains(text(),'')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_INPUT</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT</td>
	<td>//div[@class='tituloResultado']/span[contains(@class,'quantidade')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>