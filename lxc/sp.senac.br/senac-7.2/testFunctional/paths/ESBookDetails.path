<html>
<head>
<title>ESBookDetails</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ESBookDetails</td></tr>
</thead>

<tbody>
<tr>
	<td>BOOK_PAGE_LINK</td>
	<td>xpath=(//div[@class='portlet-body']//div[contains(@class,'slick-active')]/a)[1]</td>
	<td></td>
</tr>
<tr>
	<td>BOOK_PAGE_INFO_CONTAINER</td>
	<td>//div[contains(@class,'imgProdutoPrincipal')]//div[contains(@class,'informacoesContainer')]</td>
	<td></td>
</tr>
<tr>
	<td>BOOK_PAGE_INFO_TITLE</td>
	<td>//div[contains(@class,'informacoesContainer')]//*[@class='tituloDetalheLivro']</td>
	<td></td>
</tr>
<tr>
	<td>BOOK_PAGE_INFO_SUB_TITLE</td>
	<td>//div[contains(@class,'informacoesContainer')]//span[@class='subtituloLivro']</td>
	<td></td>
</tr>
<tr>
	<td>BOOK_PAGE_INFO_DESCRIPTION</td>
	<td>//div[contains(@class,'informacoesContainer')]//*[contains(@class,'descricaoCurtaDetalheLivro')]</td>
	<td></td>
</tr>
<tr>
	<td>SIMILAR_BOOK_SECTION</td>
	<td>//div[@class='slick-track']</td>
	<td></td>
</tr>
<tr>
	<td>SIMILAR_BOOK_LINK</td>
	<td>//div[@class='slick-track']//a</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>