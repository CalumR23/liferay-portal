definition {

	@summary = "Perform login process"
	macro _signIn {
		Default.WaitForElementPresent(
			key_fieldLabel = "login",
			locator1 = "ESLogin#INPUT_FIELD");

		Default.Type(
			key_fieldLabel = "login",
			locator1 = "ESLogin#INPUT_FIELD",
			value1 = "${loginUserName}");

		Default.Type(
			key_fieldLabel = "password",
			locator1 = "ESLogin#INPUT_FIELD",
			value1 = "${loginUserPassword}");

		Default.Click(locator1 = "ESLogin#SIGN_IN_BUTTON");

		Default.WaitForElementNotPresent(locator1 = "ESLogin#SIGN_IN_BUTTON");
	}

	@summary = "Navigate to the login page"
	macro gotoSignIn {

		// SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to login issues we are facing) but we can remove on 7.4

		var loginPage = PropsUtil.get("test.this.editora.senac.portal.login.url");

		Default.Open(locator1 = "${loginPage}");
	}

	@summary = "Perform Login as admin user"
	macro loginAsAdminUser {
		var adminUserName = PropsUtil.get("test.this.senac.test.account.uat.admin.login");
		var adminPassword = PropsUtil.get("test.this.senac.test.account.uat.admin.password");

		ESLogin._signIn(
			loginUserName = "${adminUserName}",
			loginUserPassword = "${adminPassword}");
	}

}