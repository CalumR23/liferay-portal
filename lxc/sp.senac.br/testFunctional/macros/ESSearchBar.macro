definition {

	@summary = "Get the number of results found"
	macro getNumberOfResults {
		var text = selenium.getText("ESSearchBar#SEARCH_RESULT");

		var totalCourses = StringUtil.extractDigits("${text}");

		return "${totalCourses}";
	}

	@summary = "Peform a search in the search field"
	macro searchForContent {
		Default.Type(
			locator1 = "ESSearchBar#SEARCH_INPUT)",
			value1 = "${searchText}");

		Default.KeyPress(
			locator1 = "ESSearchBar#SEARCH_INPUT",
			value1 = "\ENTER");
	}

	@summary = "Set a filter area"
	macro selectFiltersArea {
		Default.Click(locator1 = "ESSearchBar#FILTERS_AREA");
	}

	@summary = "Select a price filter in the search page"
	macro selectPriceFilter {
		Default.Click(locator1 = "ESSearchBar#DROPDOWN_FILTER");

		Default.Click(
			key_dropdownFilter = "${dropdownFilter}",
			locator1 = "ESSearchBar#CHECKBOX_DROPDOWN_FILTER");

		Default.WaitForPageLoad();
	}

	@summary = "View if the cards are present after searching"
	macro viewCards {
		Default.AssertElementPresent(locator1 = "ESSearchBar#CONTAINER_CARD");
	}

}