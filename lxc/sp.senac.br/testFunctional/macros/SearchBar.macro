definition {

	@summary = "Get the number of courses founded"
	macro getNumberOfResults {
		var text = selenium.getText("SearchBar#FILTER_RESULT");

		var totalCourses = StringUtil.extractDigits("${text}");

		return "${totalCourses}";
	}


	@summary = "Lauching search page"
	macro openSearchPage {

		// SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to search issues we are facing) but we can remove on 7.4

		var portalURL = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portalURL}/busca?q=${searchText}");
	}

	@summary = "Remove a selected filter in the 'cursos' section"
	macro removeFilter {
		Default.Click(
			key_checkBox = "${checkBox}",
			key_secondFilterData = "${secondFilterData}",
			locator1 = "SearchBar#SECOND_LEVEL_FILTERS");

		Default.Click.pauseClickAt(locator1 = "SearchBar#APPLY_FILTER");
	}

	@summary = "Select 'Bolsa de Estudos' Filter"
	macro scholarshipFilter {
		Default.Click(locator1 = "SearchBar#FILTER_DROPDOWN");

		Default.Click(locator1 = "SearchBar#FILTER_SCHOLARSHIP");

		Default.Click(locator1 = "SearchBar#APPLY_FILTER");
	}

	@summary = "Search for content in the modal search field"
	macro searchInModalSearchField {
		SearchBar.typeInSearchFieldPortlet(searchText = "${searchText}");

		Default.KeyPress(
			locator1 = "SearchBar#MODAL_SEARCH_INPUT",
			value1 = "\ENTER");
	}

	@summary = "Select a filter in the 'cursos' section"
	macro selectFilter {
		Default.Click(locator1 = "SearchBar#FILTER_DROPDOWN");

		Default.Click(
			key_filterData = "${filterData}",
			locator1 = "SearchBar#FIRST_LEVEL_FILTERS");

		Default.Click(
			key_checkBox = "${checkBox}",
			key_secondFilterData = "${secondFilterData}",
			locator1 = "SearchBar#SECOND_LEVEL_FILTERS");

		Default.Click(locator1 = "SearchBar#APPLY_FILTER");
	}

	@summary = "Type on main search input"
	macro typeInMainSearchField {
		Default.Type(
			locator1 = "SearchBar#PORTLET_SEARCH_INPUT)",
			value1 = "${searchText}");
	}

	@summary = "Type on search input in portlet"
	macro typeInSearchFieldPortlet {
		Default.Click(locator1 = "SearchBar#SEARCH_BUTTON");

		Default.Type(
			locator1 = "SearchBar#MODAL_SEARCH_INPUT)",
			value1 = "${searchText}");
	}

	@summary = "View searched results"
	macro viewSearchedResult {
		Default.AssertElementPresent(
			key_searchTerm = "${searchTerm}",
			locator1 = "SearchBar#SEARCHED_COURSES");
	}

	@summary = "Go to search results section"
	macro gotoSearchSection {
		Default.Click(
			key_pageType = "${pageType}",
			locator1 = "SearchBar#TAB_SEARCH_PAGE");

		Default.AssertElementPresent(
			key_pageType = "${pageType}",
			locator1 = "SearchBar#TAB_SEARCH_PAGE_ACTIVE");
	}

	@summary = "View item in search suggestions"
	macro viewSuggestionList {
		Default.AssertElementPresent(
			key_contentType = "${contentType}",
			locator1 = "SearchBar#SUGGESTIONS_LIST_ITEM");
	}

}