definition {

	@summary = "Lauching search page"
	macro openSearchPage {

		// SSP Refactor: After do a search, the URL is not redirecting to the right location, so it is needed to format the URL.

		var portalURL = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portalURL}/busca?q=${searchText}");
	}

	@summary = "Search for content in main search field"
	macro searchInPortletSearchField {
		SearchBar.typeInSearchFieldPortlet(searchText = "${searchText}");

		Default.KeyPress(
			locator1 = "SearchBar#MAIN_SEARCH_INPUT",
			value1 = "\ENTER");
	}

	@summary = "Select a filter in the 'cursos' section"
	macro selectFilter {
		Default.Click(locator1 = "SearchBar#FILTER_DROPDOWN");

		Default.Click(
			key_filterData = "${filterData}",
			locator1 = "SearchBar#FIRST_LEVEL_FILTERS");

		Default.Click(
			key_checkBox = "${checkBox}",
			key_secondFilterData = "${secondFilterData}",
			locator1 = "SearchBar#SECOND_LEVEL_FILTERS");

		Default.Click(locator1 = "SearchBar#APPLY_FILTER");
	}

	@summary = "Type on main search input"
	macro typeInMainSearchField {
		Default.Type(
			locator1 = "SearchBar#PORTLET_SEARCH_INPUT)",
			value1 = "${searchText}");
	}

	@summary = "Type on search input in portlet"
	macro typeInSearchFieldPortlet {
		Default.Click(locator1 = "SearchBar#SEARCH_BUTTON");

		Default.Type(
			locator1 = "SearchBar#MAIN_SEARCH_INPUT)",
			value1 = "${searchText}");
	}

	@summary = "View search results section"
	macro viewSearchSection {
		Default.Click(
			key_pageType = "${pageType}",
			locator1 = "SearchBar#TAB_SEARCH_PAGE");

		Default.AssertElementPresent(
			key_pageType = "${pageType}",
			locator1 = "SearchBar#TAB_SEARCH_PAGE_ACTIVE");
	}

	@summary = "View item in search suggestions"
	macro viewSuggestionList {
		Default.AssertElementPresent(
			key_contentType = "${contentType}",
			locator1 = "SearchBar#SUGGESTIONS_LIST_ITEM");
	}

}