definition {

	@summary = "Navigating to social media from page footer"
	macro goToSocialMediaPage {
		Default.ScrollWebElementIntoView(locator1 = "ESGeneral#PAGE_FOOTER");

		Default.WaitForVisible(locator1 = "ESGeneral#PAGE_FOOTER");

		Default.Click(
			key_socialMediaName = "${socialMediaName}",
			locator1 = "ESGeneral#SOCIAL_MEDIA_LINK");
	}

	@summary = "Making sure the correct page is loaded"
	macro viewPage {
		if (isSet(breadcrumbItem)) {
			Default.AssertElementPresent.pauseAssertVisible(
				key_breadcrumbItem = "${breadcrumbItem}",
				locator1 = "ESGeneral#BREADCRUMB");
		}

		if (isSet(relatedText)) {
			Default.AssertElementPresent(
				key_text = "${relatedText}",
				locator1 = "ESGeneral#ANY_TEXT");
		}

		Default.AssertLocation.assertPartialLocation(value1 = "${partialURL}");
	}

}