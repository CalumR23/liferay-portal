definition {

	@summary = "Navigating to any option from top navigation menu"
	macro goToNavigationMenu {
		Default.MouseOver(
			key_navigationMenu = "${navigationMenu}",
			locator1 = "HomePage#NAVIGATION_MENU");

		Default.Click(
			key_navigationMenu = "${navigationMenu}",
			key_navigationSubmenu = "${navigationSubmenu}",
			locator1 = "HomePage#NAVIGATION_SUBMENU");
	}

	@summary = "Select the course unit"
	macro openCardUnidades {

		// SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4

		Default.Click(locator1 = "Offers#ENROLLMENT_COURSES_UNIDADES_LABEL");

		var selecUnidadeText = selenium.getText("//select[(@id='unidades-ofertas')]//*[2]");

		Default.Select(
			locator1 = "Offers#UNIDADES_DROPDOWN",
			value1 = "${selecUnidadeText}");
	}

	@summary = "Open a course with open enrollment"
	macro openCourseCard {

		// SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4

		Default.WaitForVisible(locator1 = "Offers#ENROLLMENT_COURSES_LABEL");

		Default.Click(locator1 = "Offers#ENROLLMENT_COURSES_LABEL");

		var portalURL = PropsUtil.get("portal.url");

		Default.WaitForVisible(locator1 = "Offers#SECTION_COURSES");

		var openCourseCard = selenium.getAttribute("xpath=(//div[contains(@class,'slick-track')]//div//a[contains(@class,'ssp-absolute-link ck-curso')])[1]@href");

		var cardCourseURL = StringUtil.extractLast("${openCourseCard}", "8080/");

		Default.Open(locator1 = "${portalURL}/${openCourseCard}");
	}

	@summary = "View course offer card details"
	macro viewCardOffers {
		Default.AssertVisible(locator1 = "Offers#CARD_DESCONT");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Offers#DESCONT_VALUE",
			text = "R$",
			value1 = "Por:");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Offers#DESCONT_VALUE_TOTAL",
			text = "R$",
			value1 = "Valor sem desconto:");

		Default.AssertVisible(locator1 = "Offers#DESCONT_PAYMENT");

		Default.AssertVisible(locator1 = "Offers#BUTTON_LOCATE");
	}

}