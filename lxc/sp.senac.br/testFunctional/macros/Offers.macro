definition {

	@summary = "Navigating to any option from top navigation menu"
	macro goToNavigationMenu {
		Default.MouseOver(
			key_navigationMenu = "${navigationMenu}",
			locator1 = "HomePage#NAVIGATION_MENU");

		Default.Click(
			key_navigationMenu = "${navigationMenu}",
			key_navigationSubmenu = "${navigationSubmenu}",
			locator1 = "HomePage#NAVIGATION_SUBMENU");
	}

	@summary = "Select the course unit"
	macro openCardUnidades {
		Default.ScrollWebElementIntoView(locator1 = "Offers#OPEN_UNIDADES");

		Default.Select(
			locator1 = "Offers#OPEN_UNIDADES",
			value1 = "Nações Unidas");
	}

	@summary = "Navigate to the courses page and open a language course"
	macro openCourse {
		Default.SelectWindow.selectPopUp(locator1 = "null");

		for (var index : list "${openCouseIndex}") {
			Default.ScrollWebElementIntoView(
				key_openCourse = "${index}",
				locator1 = "Offers#OPEN_COURSE");

			Default.Click(
				key_openCourse = "${index}",
				locator1 = "Offers#OPEN_COURSE");
		}
	}

	@summary = "Open a course with open enrollment"
	macro openCourseCard {
		for (var index : list "${openCourseCardIndex}") {
			Default.Click(locator1 = "Offers#LABEL_INSCRIPTION");

			Default.ScrollWebElementIntoView(
				key_courseCard = "${index}",
				locator1 = "Offers#OPTION_COURSE_LANGUAGE");

			Default.Click(
				key_courseCard = "${index}",
				locator1 = "Of fers#OPEN_COURSE_OPTION");
		}
	}

	@summary = "View course offer card details"
	macro viewCardOffers {
		Default.SelectWindow.selectPopUp(locator1 = "Curso Livre - Inglês - Básico 1 - Senac São Paulo");

		Default.AssertVisible(locator1 = "Offers#CARD_DESCONT");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Offers#DESCONT_VALUE",
			text = "R$",
			value1 = "Por:");

		Default.AssertTextEquals.assertPartialText(
			locator1 = "Offers#DESCONT_VALUE_TOTAL",
			text = "R$",
			value1 = "Valor sem desconto:");

		Default.AssertVisible(locator1 = "Offers#DESCONT_PAYMENT");

		Default.AssertVisible(locator1 = "Offers#BUTTON_LOCATE");
	}

}