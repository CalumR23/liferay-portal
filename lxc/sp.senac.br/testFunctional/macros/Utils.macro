definition {

	@summary = "Launching editora senac home page"
	macro launchEditoraSenacHomePage {
		var editoraSenacURL = PropsUtil.get("test.this.editora.senac.portal.url");

		Default.Open(locator1 = "${editoraSenacURL}");
	}

	@summary = "Launching home page"
	macro launchSenacHomePage {
		var portalURL = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

}