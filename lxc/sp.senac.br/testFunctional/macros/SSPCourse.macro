definition {

    @summary = "Navigate to a category on 'Cursos' submenu"
    macro gotoCourseCategory {
        var portalURL = PropsUtil.get("portal.url");

        Default.MouseOver(
            locator1 = "SSPHomePage#NAVIGATION_MENU",
            key_navigationMenu = "Cursos");

        Default.WaitForVisible(
            locator1 = "SSPHomePage#NAVIGATION_SUBMENU",
            key_navigationSubmenu = "${navigationSubmenu}");  

        // SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4  

        // Default.pauseClickAt(
        //     locator1 = "SSPHomePage#NAVIGATION_SUBMENU",
        //     key_navigationSubmenu = "${navigationSubmenu}");

        if ("${navigationSubmenu}" == "Graduação") {
            Default.Open(locator1 = "${portalURL}/${pageURL}"); 

            Default.Click(locator1 = "SSPCourse#GRADUATION_TYPE");       
        } 
        else {
            Default.Open(locator1 = "${portalURL}/${pageURL}");
        }
    }

}