definition {

    @summary = "Navigate to a category on 'Cursos' submenu"
    macro gotoCourseCategory {
        var portalURL = PropsUtil.get("portal.url");

        Default.MouseOver(
            locator1 = "SSPHomePage#NAVIGATION_MENU",
            key_navigationMenu = "Cursos");

        Default.WaitForVisible(
            locator1 = "SSPHomePage#NAVIGATION_SUBMENU",
            key_navigationSubmenu = "${navigationSubmenu}");  

        // SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4  

        // Default.pauseClickAt(
        //     locator1 = "SSPHomePage#NAVIGATION_SUBMENU",
        //     key_navigationSubmenu = "${navigationSubmenu}");

        if ("${navigationSubmenu}" == "Graduação") {
            Default.Open(locator1 = "${portalURL}/${pageURL}"); 

            Default.Click(locator1 = "SSPCourse#GRADUATION_TYPE");       
        } 
        else {
            Default.Open(locator1 = "${portalURL}/${pageURL}");
        }
    }

    @summary = "Check if the course page structure follows a pattern"
    macro viewPageStructure {
		Default.AssertElementPresent(locator1 = "SSPCourse#COURSE_TITLE");

		Default.AssertElementPresent(locator1 = "SSPCourse#COURSE_DESCRIPTION");

		Default.AssertElementPresent(locator1 = "SSPCourse#COURSE_KNOW_MORE");

		Default.AssertElementPresent(locator1 = "SSPCourse#COURSE_NEW_CLASSES");
    }

    @summary = "Enter on the course page"
    macro gotoCourse {
        var portalURL = PropsUtil.get("portal.url");

        Default.ScrollWebElementIntoView(locator1 = "SSPCourse#COURSE_CARD");

        // SSP Refactor: This macro is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4

		// Default.Click.clickAtNotVisible(locator1 = "SSPCourse#COURSE_CARD");

		var cursoURL = selenium.getAttribute("//div[contains(@class,'slick-active')]//div[contains(@class,'card-curso')]//a[contains(@class,'ck-curso')]@href");

		var cursoURL = StringUtil.extractLast("${cursoURL}", "8080/");
		
		Default.Open(locator1 = "${portalURL}/${cursoURL}");

    }

    @summary = "Change the course unity"
    macro changeUnity {
        Default.Refresh();

        Default.ScrollWebElementIntoView(locator1 = "SSPOffers#OPEN_UNIDADES");

		Default.Click(locator1 = "SSPOffers#OPEN_UNIDADES");

		Default.KeyPress(
			locator1 = "SSPOffers#OPEN_UNIDADES",
			value1 = "\DOWN");

		Default.KeyPress(
			locator1 = "SSPOffers#OPEN_UNIDADES",
			value1 = "\ENTER");
    }
}