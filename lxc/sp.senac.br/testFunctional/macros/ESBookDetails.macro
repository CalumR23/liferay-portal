definition {

	@summary = "Go to the book info page"
	macro openBookPage {
		Default.Click(locator1 = "ESBookDetails#BOOK_PAGE_LINK");

		Default.WaitForVisible(locator1 = "ESBookDetails#BOOK_PAGE_INFO_CONTAINER");
	}

	@summary = "View if the book details is shown, title, sub-title, description etc"
	macro viewBookDetails {
		Default.AssertElementPresent(locator1 = "ESBookDetails#BOOK_PAGE_INFO_CONTAINER");

		Default.AssertElementPresent(locator1 = "ESBookDetails#BOOK_PAGE_INFO_TITLE");

		Default.AssertElementPresent(locator1 = "ESBookDetails#BOOK_PAGE_INFO_SUB_TITLE");

		Default.AssertElementPresent(locator1 = "ESBookDetails#BOOK_PAGE_INFO_DESCRIPTION");
	}

	@summary = "View if the similar book section and books are present"
	macro viewSimilarBooks {
		Default.AssertElementPresent(locator1 = "ESBookDetails#SIMILAR_BOOK_SECTION");

		Default.AssertElementPresent(locator1 = "ESBookDetails#SIMILAR_BOOK_LINK");
	}

}