<html>
<head>
<title>SearchBar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SearchBar</td></tr>
</thead>

<tbody>
<tr>
	<td>APPLY_FILTER</td>
	<td>//*[@id='aplicar-filtro']</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_DROPDOWN</td>
	<td>//div[@id='filtrar-resultados-title']/*[text()='Filtrar resultados']</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_LEVEL_FILTERS</td>
	<td>//div[@id='filtro-nivel1']/*[@data-filtro='${key_filterData}']</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_SEARCH_INPUT</td>
	<td>//section[@id='modal-search']//input[contains(@class,'busca')]</td>
	<td></td>
</tr>
<tr>
	<td>PORTLET_SEARCH_INPUT</td>
	<td>//*[@id='mainBusca']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//*[text()='Buscar']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCHED_COURSES</td>
	<td>//*[@class='ssp-card-curso']/a[@href]</td>
	<td></td>
</tr>
<tr>
	<td>SECOND_LEVEL_FILTERS</td>
	<td>//div[@id='filtros-n2']/*[@id='filtro-${key_secondFilterData}']//label[text()='${key_checkBox}']</td>
	<td></td>
</tr>
<tr>
	<td>SUGGESTIONS_LIST_ITEM</td>
	<td>//*[@id='resultados-busca-${key_contentType}']//*[contains(@href,'/')]</td>
	<td></td>
</tr>
<tr>
	<td>TAB_SEARCH_PAGE</td>
	<td>//*[@id='tab-${key_pageType}']</td>
	<td></td>
</tr>
<tr>
	<td>TAB_SEARCH_PAGE_ACTIVE</td>
	<td>//*[@id='tab-${key_pageType}'][contains(@class,'ativa')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>