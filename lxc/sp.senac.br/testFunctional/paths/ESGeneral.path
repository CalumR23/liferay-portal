<html>
<head>
<title>ESGeneral</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ESGeneral</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_TEXT</td>
	<td>//*[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>
<tr>
	<td>BREADCRUMB</td>
	<td>//span[contains(@class,'breadcrumb')][text()='${key_breadcrumbItem}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_FOOTER</td>
	<td>//div[@id='footer']</td>
	<td></td>
</tr>
<tr>
	<td>SOCIAL_MEDIA_LINK</td>
	<td>//div[contains(@class,'midiasSociaisDesktop')]//a[contains(@href,'${key_socialMediaName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>