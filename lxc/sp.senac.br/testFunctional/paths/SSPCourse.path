<html>
<head>
<title>SSPCourse</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SSPCourse</td></tr>
</thead>

<tbody>
<tr>
	<td>CARD_TITLE</td>
	<td>//div[contains(@class,'slick-active')]//div[contains(@class,'card-curso')]//*[contains(@class,'ck-curso')]/parent::div//*[contains(.,'${key_cursoName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_TITLE_INDEX</td>
	<td>xpath=(//div[contains(@class,'slick-active')]//div[contains(@class,'card-curso')]//*[contains(@class,'ck-curso')]/parent::div//*[contains(@class,'curso__title')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>COURSE_CARD</td>
	<td>xpath=(//div[contains(@class,'slick-slide')]//*[contains(@class,'ck-curso')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>COURSE_DESCRIPTION</td>
	<td>//section[contains(@id,'curso-info')]//div[contains(@class,'curso__description')]</td>
	<td></td>
</tr>
<tr>
	<td>COURSE_KNOW_MORE</td>
	<td>//section[contains(@id,'curso-info')]//div[contains(@class,'saiba-mais-curso')]</td>
	<td></td>
</tr>
<tr>
	<td>COURSE_NEW_CLASSES</td>
	<td>//section[contains(@id,'novas-turmas') or contains (@class,'novas-turmas')]</td>
	<td></td>
</tr>
<tr>
	<td>COURSE_TITLE</td>
	<td>//section[contains(@id,'curso-info')]//*[contains(@class,'curso__title')]</td>
	<td></td>
</tr>
<tr>
	<td>GRADUATION_TYPE</td>
	<td>xpath=(//button[@class='button-tipo-curso'])[1]</td>
	<td></td>
</tr>
<tr>
	<td>UNITY_ADDRESS</td>
	<td>//div[contains(@class,'endereco-unidade')]//*[contains(@class,'endereco-unidade')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>