<html>
<head>
<title>ESShoppingCart</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ESShoppingCart</td></tr>
</thead>

<tbody>
<tr>
	<td>BUY_BUTTON</td>
	<td>//button[contains(@class,'btn-add-to-cart')]</td>
	<td></td>
</tr>
<tr>
	<td>MINI_CART</td>
	<td>//div[contains(@class,'items-list')]</td>
	<td></td>
</tr>
<tr>
	<td>MINI_CART_ITEM</td>
	<td>//div[contains(@class,'cart-cart-items')]/div</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_ITEM</td>
	<td>//div[contains(@class,'item-delete')]/button</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_MINI_CART</td>
	<td>//button[contains(@class,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>MY_BAG</td>
	<td>//div[contains(@class,'template-container')]</td>
	<td></td>
</tr>
<tr>
	<td>MY_BAG_ITEM</td>
	<td>//div[contains(@class,'template-container')]/div[contains(@class,'template-items')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>