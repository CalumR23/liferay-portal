definition {

	setUp {
		Utils.launchSenacHomePage();
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that there is a 'Conheça nossos cursos' section with some categories"
	test CanNavigateToDifferentCourseCategories {
		task ("When I go to 'Conheça nossos cursos' section") {
			HomePage.gotoSectionTitle(sectionTitle = "Conheça nossos cursos");
		}

		task ("Then view if you have categories") {
			HomePage.viewListCourses(coursesList = "Idiomas,Livre,Técnico,Extensão");
		}
	}

}