definition {

	setUp {
		Utils.launchSenacHomePage();
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that there is a 'Conheça nossos cursos' section with some categories"
	@priority = "5"
	@refactor
	test CanNavigateToDifferentCourseCategories {
		task ("When I go to 'Conheça nossos cursos' section") {
			HomePage.gotoSectionTitle(sectionTitle = "Conheça nossos cursos");
		}

		task ("Then view if is possible to navigate into different categories") {
			HomePage.gotoCourseCategory(courseIndex = "1,2,3");
		}
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that there is a page footer and user can navigate by them"
	@refactor
	test CanNavigateToPageFooterOptions {
		task ("When I go to the footer option") {
			HomePage.goToFooter();
		}

		task ("Then see is it possible to navigate different footer options") {
			HomePage.gotoFooterOptionPages(footerOptionList = "Sobre o Senac,Fale com a gente");
		}
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that page footer has some social media links"
	test CanNavigateToSocialMediaLinks {
		task ("Then Go to social media pages through page footer") {
			for (var socialMedia : list "facebook,twitter,linkedin,youtube,instagram") {
				HomePage.gotoFooterSocialMedia();

				HomePage.openSocialMedia(socialMedia = "${socialMedia}");

				HomePage.viewSocialMedia(socialMedia = "${socialMedia}");

				Utils.launchSenacHomePage();
			}
		}
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that 'Explore Senac' carousel can be navigated by clicking on arrows "
	test CanSwipeOnExploreSenacCarousel {
		task ("Given that I go to 'Explore Senac' section") {
			HomePage.gotoSectionTitle(sectionTitle = "Explore Senac");
		}

		task ("Then the first card is visible") {
			Default.AssertVisible(locator1 = "HomePage#CARD_EXPLORE");
		}

		task ("Then click the next button page") {
			Default.Click.pauseClickAt(locator1 = "HomePage#CARD_EXPLORE_NEXT");
		}

		task ("Then the first card is not visible") {
			Default.AssertNotVisible(locator1 = "HomePage#CARD_EXPLORE");
		}
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that the main carousel is present and has a video"
	test MainCaroulselIsDisplayedWithTitleAndVideo {
		task ("View that the main carousel is present") {
			Default.AssertElementPresent(locator1 = "HomePage#MAIN_CAROUSEL");
		}

		task ("View that the main carousel contains a video") {
			Default.AssertElementPresent(locator1 = "HomePage#CAROUSEL_VIDEO");
		}
	}

	@description = "Automation ID: SSPU-179 | Test Summary: Verify that the Main Menu is displayed with the options 'Cursos', 'Bolsas e Descontos', 'Eventos', 'Unidades', 'Para empresas', 'O Senac' and 'Serviço' and there is some submenus"
	@priority = "5"
	test MenuCanBeNavigated {
		task ("The given navigation bar is visible with 'Cursos,Eventos,Unidades,Bolsas e Descontos,Para empresas,O Senac,Serviços'") {
			HomePage.viewNavigationMenu();
		}

		task ("When I click on 'Cursos' and 'Idiomas' in the navigation submenu") {
			HomePage.goToNavigationMenu(
				navigationMenu = "Cursos",
				navigationSubmenu = "Idiomas");

			Default.SelectWindow.selectPopUp(locator1 = "null");
		}

		task ("Then I should be redirected to the 'Idiomas' page") {
			General.viewPage(
				breadcrumb = "Idiomas",
				partialURL = "/idiomas");
		}

		task ("When I close the page") {
			Utils.closeWindow();
		}

		task ("When I click on 'Unidades' and 'Itaquera' in the navigation submenu") {
			HomePage.goToNavigationMenu(
				navigationMenu = "Unidades",
				navigationSubmenu = "Itaquera");

			Default.SelectWindow.selectPopUp(locator1 = "null");
		}

		task ("Then I should be redirected to the 'Itaquera' page") {
			General.viewPage(
				breadcrumb = "Itaquera",
				partialURL = "/senac-itaquera");
		}
	}

}