definition {

	setUp {
		ESLogin.gotoSignIn();

		ESLogin.loginAsAdminUser();

		Utils.launchEditoraSenacHomePage();
	}

	@description = "Automation ID: SSPU-214 | Test Summary: Verify that there is a book details page and that the user can navigate to it"
	@priority = "5"
	test CanSeeDetailsPage {
		task ("When the user clicks on a book") {
			ESBookDetails.openBookPage();
		}

		task ("Then the book details page should be loaded showing the book information") {
			ESBookDetails.viewBookDetails();

			ESGeneral.viewPage(partialURL = "/livro");
		}
	}

}