definition {

	setUp {
		Utils.launchSenacHomePage();
	}

	@description = "Verify that is possible to change the campus and see different courses"
	@priority = "5"
	test CanSeeDifferentCoursesOnDifferentCampus {
		task ("Given that I go to a campus page") {
			SSPHomePage.gotoNavigationMenuAndSubmenu(
				navigationMenu = "Unidades",
				submenuIndex = "3");
		}

		task ("And I get the first course name") {
			Default.ScrollWebElementIntoView(locator1 = "SSPCourse#COURSE_CARD");

			var cursoName = selenium.getText("SSPCourse#CARD_TITLE_INDEX");
		}

		task ("When I go to a different Campus") {
			SSPHomePage.gotoNavigationMenuAndSubmenu(
				navigationMenu = "Unidades",
				submenuIndex = "4");
		}

		task ("Then the course of previous campus is not displayed") {
			Default.AssertElementNotPresent(
				key_cursoName = "${cursoName}",
				locator1 = "SSPCourse#CARD_TITLE");
		}
	}


}