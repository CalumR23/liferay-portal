definition {

	setUp {
		Utils.launchSenacHomePage();
	}

	@description = "Automation ID: SSPU-213 | Test Summary: Check the options available on the offers card"
	@priority = "5"
	@refactor
	test VerifyCardStructure {
		task ("Given 'language courses' page is open") {

			//SSPOffers.goToNavigationMenu(
			//	navigationMenu = "Cursos",
			//	navigationSubmenu = "Livres");

			var portalURL = PropsUtil.get("portal.url");

			Default.Open(locator1 = "${portalURL}/cursos-livres");

			// SSP Refactor: This is a workaround, it is needed for 7.2 (due to redirect issues we are facing) but we can remove on 7.4

		}

		task ("When I choose a language course and campus") {
			SSPOffers.openCourseCard(openCourseCard = "1");

			SSPOffers.openCardUnidades(index = "2");
		}

		task ("Then see if the card is visible and see if it appears as options 'desconto e valor sem desconto', 'Descontos e pagamento', 'Onde as aulas vão acontecer?'") {
			SSPOffers.viewCardOffers();
		}
	}

}