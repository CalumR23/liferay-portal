definition {

	setUp {
		Utils.launchEditoraSenacHomePage();
	}

	@description = "Automation ID: SSPU-190 | Test Summary: Verify that is possible to filter the search results by area"
	@priority = "5"
	test CanFilterResultsByArea {
		task ("When I search for a content in the search field") {
			ESSearchBar.searchForContent(searchText = "livro");
		}

		task ("Then I see the cards are present and I get the number of results (before select a area filter)") {
			ESSearchBar.viewCards();

			var beforeFilter = ESSearchBar.getNumberOfResults();
		}

		task ("When I set the area filter") {
			ESSearchBar.selectFiltersArea();
		}

		task ("Then I see the cards are shown and the number of items after selecting an area filter is less than before") {
			ESSearchBar.viewCards();

			var afterFilter = ESSearchBar.getNumberOfResults();

			Portal.TestUtils.isLessThan(
				actual = "${afterFilter}",
				expected = "${beforeFilter}");
		}
	}

}