definition {

	property test.env = "uat";
	property testray.main.component.name = "Sapphire";

	setUp {
		Utils.launchSapphireUat();
	}

	@description = "Automation ID: LRQA-75732 | Test Summary: Verify user Admin can active the warehouse"
	@priority = "5"
	test AdminCanActivateWarehouse {
		task ("Given an admin user logs in to the website") {
			Login.signInWithAdminUser();
		}

		task ("When the user goes to warehouses portlet") {
			Portal.ApplicationsMenu.gotoSite(site = "Australia");

			Portal.ApplicationsMenu.gotoPortlet(
				category = "Inventory Management",
				panel = "Commerce",
				portlet = "Warehouses");

			Default.WaitForVisible(locator1 = "Portal.Icon#BODY_VERTICAL_ELLIPSIS");
		}

		task ("Then a warehouse can be activated") {
			Warehouses.activateItem();
		}
	}

	@description = "Automation ID: LRQA-75732 | Test Summary: Verify all components of table product are properly shown"
	@priority = "5"
	test ShowsAllTableComponents {
		task ("Given a non-admin user logs in to the website") {
			Login.signInWithPrepayUser();
		}

		task ("When the user goes to the catalogue's page") {
			Default.Click(
				key_menuItem = "Order Now",
				locator1 = "HomePage#NAVIGATION_MENU_ITEM");
		}

		task ("Then the table components are properly shown") {
			Catalogue.viewLayout();
		}
	}

}