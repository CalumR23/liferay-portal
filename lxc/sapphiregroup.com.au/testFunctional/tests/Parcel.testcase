definition {

	property test.env = "uat";
	property testray.main.component.name = "Sapphire";

	setUp {
		Utils.launchSapphireUat();

		Login.signInWithAdminUser();

		task ("Setting up the new parcel order form name") {
			Parcel.generateParcelOrderName();
		}
	}

	tearDown {
		Utils.changeBackParcelsGridLayout();

		Utils.deleteUploadedImagesByName(partialName = "liferay_logo");

		Utils.deleteParcelOrderFormsByName(partialFormName = "Test Parcel Order Form Name");
	}

	@description = "Automation ID: LRQA-76384 | Test Summary: Verify Admin user can place a new Parcel Order"
	@priority = "5"
	test CanPlaceParcelOrder {
		task ("Given an admin user adds a linked Parcel Order Form to the home page") {
			Parcel.addParcelOrderForm(parcelOrderFormName = "${staticParcelOrderFormName}");

			Navigator.openAustraliaHomePage();

			PageEditor.addParcelFragmentToHomePage(parcelOrderFormName = "${staticParcelOrderFormName}");
		}

		task ("When a new Parcel Order is placed") {
			Navigator.goToParcelOrderByIndex(index = "3");

			Checkout.placeParcelOrder();
		}

		task ("Then the details of the new placed order should be visible in Placed Orders page and into the order") {
			Checkout.goToOrdersDetailsFromCheckout();

			var orderIdFromDetails = Orders.getOrderIdFromOderDetails();
			var orderTotalValueFromDetails = Orders.getOrderTotalValueFromOderDetails();

			Navigator.openAustraliaPlacedOrders();

			Orders.viewOrder(
				orderId = "${orderIdFromDetails}",
				orderTotalValue = "${orderTotalValueFromDetails}");
		}
	}

}