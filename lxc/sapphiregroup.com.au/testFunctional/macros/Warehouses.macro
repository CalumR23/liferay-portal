definition {

	macro activateItem {
		if (Default.IsElementNotPresent(locator1 = "Warehouses#DEACTIVATED_ITEM_VERTICAL_ELLIPSIS")) {
			Warehouses.deactivateItem();

			Default.Refresh();
		}

		Default.Click(locator1 = "Warehouses#DEACTIVATED_ITEM_VERTICAL_ELLIPSIS");

		Portal.MenuItem.clickNoError(menuItem = "Activate");

		Alert.viewSuccessMessage();
	}

	macro deactivateItem {
		Default.Click(locator1 = "Warehouses#ACTIVATED_ITEM_VERTICAL_ELLIPSIS");

		Portal.MenuItem.clickNoError(menuItem = "Deactivate");

		Alert.viewSuccessMessage();
	}

}