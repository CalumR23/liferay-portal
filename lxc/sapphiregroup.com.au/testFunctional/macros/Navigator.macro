definition {

	@summary = "Go to Parcel Order from home page"
	macro goToParcelOrderByIndex {
		Default.Click(
			key_index = "${index}",
			locator1 = "HomePage#PARCEL_FORM_IMAGE_LINK");
	}

	@summary = "Open page to add a new Parcel Order Form"
	macro openAddParcelOrderFormPage {
		Portal.Navigator.openWithAppendToBaseURL(
			baseURL = PropsUtil.get("test.this.sapphire.portal.url.uat"),
			urlAppend = "group/australia/~/control_panel/manage?p_p_id=com_liferay_object_web_internal_object_definitions_portlet_ObjectDefinitionsPortlet_1308526&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_object_web_internal_object_definitions_portlet_ObjectDefinitionsPortlet_1308526_mvcRenderCommandName=%2Fobject_entries%2Fedit_object_entry");
	}

	@summary = "Open home page for Australia group"
	macro openAustraliaHomePage {
		Portal.Navigator.openWithAppendToBaseURL(
			baseURL = PropsUtil.get("test.this.sapphire.portal.url.uat"),
			urlAppend = "group/australia");
	}

	@summary = "Open Placed Orders for Australia group"
	macro openAustraliaPlacedOrders {
		Portal.Navigator.openWithAppendToBaseURL(
			baseURL = PropsUtil.get("test.this.sapphire.portal.url.uat"),
			urlAppend = "group/australia/placed-orders");
	}

	@summary = "Open page to add a new Parcel Order Form"
	macro openParcelOrderFormsPage {
		Portal.Navigator.openWithAppendToBaseURL(
			baseURL = PropsUtil.get("test.this.sapphire.portal.url.uat"),
			urlAppend = "group/australia/~/control_panel/manage?p_p_id=com_liferay_object_web_internal_object_definitions_portlet_ObjectDefinitionsPortlet_1308526&p_p_lifecycle=0&p_p_state=maximized&p_v_l_s_g_id=40342&_com_liferay_object_web_internal_object_definitions_portlet_ObjectDefinitionsPortlet_1308526_objectDefinitionId=1308526");
	}

}