definition {

	@summary = "Set the quantity of a product and add it to cart"
	macro addProductToCart {
		Default.Type(
			key_productName = "${productName}",
			locator1 = "Catalogue#PRODUCT_QUANTITY_SELECTOR",
			value1 = "${productQuantity}");

		Default.Click(
			key_productName = "${productName}",
			locator1 = "Catalogue#PRODUCT_ADD_TO_CART_BUTTON");
	}

	macro viewLayout {
		Default.AssertElementPresent(locator1 = "Catalogue#PRODUCT_SKU");

		Default.AssertElementPresent(locator1 = "Catalogue#PRODUCT_NAME");

		Default.AssertElementPresent(locator1 = "Catalogue#QUANTITY_SELECTOR");

		Default.AssertElementPresent(locator1 = "Catalogue#PRODUCT_PRICE");

		Default.AssertElementPresent(locator1 = "Catalogue#QUANTITY_LEVEL");

		Default.AssertElementPresent(locator1 = "Catalogue#ADD_TO_CART_BUTTON");
	}

	macro viewNumberOfProductsAvailable {
		Default.WaitForVisible(locator1 = "Catalogue#PRODUCT_SKU");

		var text = selenium.getText("Catalogue#PRODUCTS_AVAILABLE");

		var numberOfProductsAvailable = StringUtil.extractDigits("${text}");

		Portal.TestUtils.isGreaterThan(
			actual = "${numberOfProductsAvailable}",
			expected = "0");

		var text = selenium.getText("Catalogue#PAGINATION_RESULTS");

		var paginationResult = StringUtil.extractLast("${text}", "of");

		var paginationResult = StringUtil.extractDigits("${paginationResult}");

		Portal.TestUtils.assertEquals(
			actual = "${numberOfProductsAvailable}",
			expected = "${paginationResult}");
	}

}