definition {

	@summary = "Add a new parcel fragment to the home page"
	macro addParcelFragmentToHomePage {
		Navigator.openAustraliaHomePage();

		Default.Click.clickNoMouseOver(locator1 = "HomePage#EDIT_BUTTON");

		Portal.PageEditor.assertFragmentSidebarLoaded();

		PageEditor.editLayoutGrid(
			columnCount = "3",
			panel = "General",
			position = "2");

		Portal.PageEditor.expandFragmentCollection(collectionName = "Parcel-Fragments");

		Default.DragAndDrop.javaScriptDragAndDropToObject(
			key_collectionName = "Parcel-Fragments",
			key_columnNumber = "3",
			key_fragmentName = "Parcel Form Image",
			key_position = "2",
			locator1 = "Parcel#FRAGMENT",
			locator2 = "Portal.PageEditor#GRID_COLUMN");

		PageEditor.editFragmentImage(
			fileName = "liferay_logo.png",
			fragmentIndex = "3",
			fragmentName = "Parcel Form Image",
			parcelOrderFormName = "${parcelOrderFormName}");

		Default.Click(
			key_text = "Publish",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();
	}

	@summary = "Edit fragment image"
	macro editFragmentImage {
		Default.Click(
			key_position = "3",
			locator1 = "Parcel#PARCEL_FRAGMENT_POSITION");

		Default.Click(
			key_fragmentName = "${fragmentName}",
			key_itemName = "image-square",
			locator1 = "Parcel#FRAGMENT_ITEM");

		Default.Click(
			key_fieldLabel = "Image",
			locator1 = "Portal.PageEditor#ITEM_SELECTOR_CONTENT_INPUT");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Parcel.uploadFile(fileName = "${fileName}");

		Default.SelectFrameTop();

		Default.SelectFrame.selectFrameNoLoading(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.DoubleClick(
			key_text = "Add",
			locator1 = "Portal.Button#ANY");

		Default.SelectFrameTop();

		Default.Click(
			key_position = "3",
			locator1 = "Parcel#PARCEL_FRAGMENT_POSITION");

		Default.Click(
			key_fragmentName = "${fragmentName}",
			key_itemName = "image-square",
			locator1 = "Parcel#FRAGMENT_ITEM");

		Portal.Navigator.gotoNavTab(navTab = "Link");

		Default.Select(
			key_fieldLabel = "Link",
			locator1 = "Parcel#TABPANEL_SELECT_FIELD",
			value1 = "Mapped URL");

		Default.Click(
			key_fieldLabel = "Item",
			locator1 = "Portal.PageEditor#ITEM_SELECTOR_CONTENT_INPUT");

		Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

		Default.WaitForElementPresent(
			key_option = "Parcel Order Forms",
			locator1 = "Parcel#FRAME_TOP_MENU_ITEM");

		Default.Click(
			key_option = "Parcel Order Forms",
			locator1 = "Parcel#FRAME_TOP_MENU_ITEM");

		Default.Click(
			key_parcelOrderFormName = "${parcelOrderFormName}",
			locator1 = "Parcel#LISTED_PARCEL_ORDER_FORM_BY_NAME");

		Default.SelectFrameTop();

		Default.WaitForElementPresent(
			key_fieldLabel = "Field",
			locator1 = "Parcel#TABPANEL_SELECT_FIELD");

		Default.DoubleClick(
			key_fieldLabel = "Field",
			locator1 = "Parcel#TABPANEL_SELECT_FIELD");

		Default.WaitForElementPresent(
			key_fieldLabel = "Field",
			key_option = "Parcel Form Id",
			locator1 = "Parcel#TABPANEL_SELECT_OPTION");

		Default.Select(
			key_fieldLabel = "Field",
			locator1 = "Parcel#TABPANEL_SELECT_FIELD",
			value1 = "Parcel Form Id");

		Portal.PageEditor.waitForAutoSave();
	}

	@summary = "Edit the layout for a grid"
	macro editLayoutGrid {
		if (isSet(position)) {
			var index = "${position}";
		}
		else {
			var index = "1";
		}

		Portal.PageEditor.clickConfigurableField(
			fragmentName = "Grid",
			index = "${index}");

		if ("${panel}" == "General") {
			Portal.Navigator.gotoNavTab(navTab = "General");
		}

		Default.Select(
			key_fieldLabel = "Number of Modules",
			locator1 = "Parcel#SELECT_FIELD",
			value1 = "${columnCount}");

		Portal.PageEditor.waitForAutoSave();
	}

}