definition {

	@summary = "Add a new parcel fragment to the home page"
	macro addParcelFragmentToHomePage {
		Navigator.openAustraliaHomePage();

		Default.Click.clickNoMouseOver(locator1 = "HomePage#EDIT_BUTTON");

		Portal.PageEditor.assertFragmentSidebarLoaded();

		PageEditor.editLayoutGrid(
			columnCount = "3",
			panel = "General",
			position = "2");

		Portal.PageEditor.expandFragmentCollection(collectionName = "Parcel-Fragments");

		Default.DragAndDrop.javaScriptDragAndDropToObject(
			key_collectionName = "Parcel-Fragments",
			key_columnNumber = "3",
			key_fragmentName = "Parcel Form Image",
			key_position = "2",
			locator1 = "Parcel#FRAGMENT",
			locator2 = "Portal.PageEditor#GRID_COLUMN");

		PageEditor.editFragmentImage(
			fileName = "Liferay-logo.png",
			fragmentIndex = "3",
			fragmentName = "Parcel Form Image",
			parcelOrderFormName = "${parcelOrderFormName}");

		Default.Click(
			key_text = "Publish",
			locator1 = "Portal.Button#ANY");

		Portal.Alert.viewSuccessMessage();
	}

}