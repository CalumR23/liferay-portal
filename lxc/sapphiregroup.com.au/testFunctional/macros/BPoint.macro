definition {

	@summary = "Get the ID of a placed order at BPoint payment page"
	macro getOrderId {
		task ("Saving the order id into the variable 'orderId' to be reused later") {
			var orderIdText = selenium.getText("BPoint#ORDER_ID");

			var orderId = StringUtil.extractDigits("${orderIdText}");

			return "${orderId}";
		}
	}

}