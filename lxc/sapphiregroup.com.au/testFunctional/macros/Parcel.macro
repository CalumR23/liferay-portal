definition {

	@summary = "Add a new Parcel Order Form"
	macro addParcelOrderForm {
		var brandNameOption = "GLASSHOUSE";
		var maxOrderQuantity = "200";

		Navigator.openAddParcelOrderFormPage();

		Default.Type(
			key_fieldLabel = "Parcel Order Form Name",
			locator1 = "Parcel#INPUT_FIELD",
			value1 = "${parcelOrderFormName}");

		Default.Click(
			index = "2",
			key_fieldLabel = "Brand Name",
			locator1 = "Parcel#SELECT_FIELD_WITH_INDEX");

		Default.Click(
			key_dropdownMenuItem = "${brandNameOption}",
			locator1 = "Parcel#DROPDOUWN_MENU_ITEM");

		Default.Click(
			index = "2",
			key_fieldLabel = "Parcel Total",
			locator1 = "Parcel#SELECT_FIELD_WITH_INDEX");

		Default.Click(
			key_dropdownMenuItem = "5",
			locator1 = "Parcel#DROPDOUWN_MENU_ITEM");

		Default.Type(
			key_fieldLabel = "Max Order Quantity",
			locator1 = "Parcel#INPUT_FIELD",
			value1 = "${maxOrderQuantity}");

		Parcel.uploadFile(
			fileName = "parcel_products.csv",
			label = "Parcel Products Import File");

		Default.Click(locator1 = "Parcel#SAVE_BUTTON");

		Portal.Alert.viewSuccessMessage();

		Default.Refresh();

		Parcel.uploadFile(
			fileName = "drop_dates.csv",
			label = "Drop Dates Import File");

		Default.Click(locator1 = "Parcel#SAVE_BUTTON");

		Portal.Alert.viewSuccessMessage();
	}

	@summary = "Generate the new parcel order form name using system timestamp to make it unique"
	macro generateParcelOrderName {
		var displayDateAndTime = DateUtil.getFormattedCurrentDate("MMM dd, yyyy HH:mm");

		static var staticParcelOrderFormName = "Test Parcel Order Form Name - ${displayDateAndTime}";

		return "${staticParcelOrderFormName}";
	}

	@summary = "Setting up a split shipment for any product listed in the drop"
	macro setProductSplit {
		var totalText = selenium.getText("//*[text()='Drop ${dropNumber}']/following-sibling::div//span[text()='${productName}']/..//following-sibling::div/span");

		var totalRequiredQuantity = StringUtil.extractLast("${totalText}", "/");

		var numberOfProducts = StringUtil.extractDigits("${totalRequiredQuantity}");

		Default.Select(
			key_dropNumber = "${dropNumber}",
			key_productName = "${productName}",
			key_splitNumber = "1",
			locator1 = "ParcelDropSplit#ANY_SPLIT_QUANTITY_SELECTOR",
			value1 = "0");

		Default.Select(
			key_dropNumber = "${dropNumber}",
			key_productName = "${productName}",
			key_splitNumber = "${splitNumber}",
			locator1 = "ParcelDropSplit#ANY_SPLIT_QUANTITY_SELECTOR",
			value1 = "${numberOfProducts}");
	}

	@summary = "Split shipments for the parcel order"
	macro splitShipment {
		task ("Select the Parcel Drop Split option by clicking at it") {
			Default.Click(
				key_text = "Split this shipment",
				locator1 = "ParcelDropSplit#DROP_SPLIT_SHIPPING_OPTION");
		}

		task ("Moving 3 different products from split 1 to 3 different splits") {
			Parcel.setProductSplit(
				dropNumber = "1",
				productName = "GF 380g Candle - Christmas - Gingerbread House - X22",
				splitNumber = "2");

			Parcel.setProductSplit(
				dropNumber = "1",
				productName = "GF 380g Candle - Christmas - Under The Mistletoe - X22",
				splitNumber = "3");

			Parcel.setProductSplit(
				dropNumber = "1",
				productName = "GF 380g Candle - Christmas - Night Before Christmas - X22",
				splitNumber = "4");
		}
	}

	@summary = "Upload a file to the Parcel Order Form"
	macro uploadFile {
		var filePath = Utils.getFilePath(fileName = "${fileName}");

		if (isSet(label)) {
			Default.UploadFile(
				key_label = "${label}",
				locator1 = "Parcel#INPUT_FILE",
				value1 = "${filePath}");
		}
		else {
			Default.UploadFile(
				locator1 = "Portal.TextInput#FILE",
				value1 = "${filePath}");
		}
	}

}