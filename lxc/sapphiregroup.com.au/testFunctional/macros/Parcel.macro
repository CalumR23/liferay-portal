definition {

	@summary = "Add a new Parcel Order Form"
	macro addParcelOrderForm {
		var brandNameOption = "GLASSHOUSE";
		var maxOrderQuantity = "200";

		Navigator.openAddParcelOrderFormPage();

		Default.Type(
			key_fieldLabel = "Parcel Order Form Name",
			locator1 = "Parcel#INPUT_FIELD",
			value1 = "${parcelOrderFormName}");

		Default.Click(
			index = "2",
			key_fieldLabel = "Brand Name",
			locator1 = "Parcel#SELECT_FIELD_WITH_INDEX");

		Default.Click(
			key_dropdownMenuItem = "${brandNameOption}",
			locator1 = "Parcel#DROPDOUWN_MENU_ITEM");

		Default.Click(
			index = "2",
			key_fieldLabel = "Parcel Total",
			locator1 = "Parcel#SELECT_FIELD_WITH_INDEX");

		Default.Click(
			key_dropdownMenuItem = "5",
			locator1 = "Parcel#DROPDOUWN_MENU_ITEM");

		Default.Type(
			key_fieldLabel = "Max Order Quantity",
			locator1 = "Parcel#INPUT_FIELD",
			value1 = "${maxOrderQuantity}");

		Parcel.uploadFile(
			fileName = "Parcel Products.csv",
			label = "Parcel Products Import File");

		Default.Click(locator1 = "Parcel#SAVE_BUTTON");

		Alert.viewSuccessMessage();

		Default.Refresh();

		Parcel.uploadFile(
			fileName = "Drop Dates.csv",
			label = "Drop Dates Import File");

		Default.Click(locator1 = "Parcel#SAVE_BUTTON");

		Alert.viewSuccessMessage();
	}

	@summary = "Generate the new parcel order form name using system timestamp to make it unique"
	macro generateParcelOrderName {
		var displayDateAndTime = DateUtil.getFormattedCurrentDate("MMM dd, yyyy HH:mm");

		static var staticParcelOrderFormName = "Test Parcel Order Form Name - ${displayDateAndTime}";

		return "${staticParcelOrderFormName}";
	}

	@summary = "Upload a file to the Parcel Order Form"
	macro uploadFile {
		var filePath = Utils.getFilePath(fileName = "${fileName}");

		if (isSet(label)) {
			Default.UploadFile(
				key_label = "${label}",
				locator1 = "Parcel#INPUT_FILE",
				value1 = "${filePath}");
		}
		else {
			Default.UploadFile(
				locator1 = "Portal.TextInput#FILE",
				value1 = "${filePath}");
		}
	}

}