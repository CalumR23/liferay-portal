definition {

	@summary = "Get the total value of a placed order from checkout page"
	macro getTotalValueFromCheckout {
		task ("Saving the order total value into the variable 'orderTotalValue' to be reused later") {
			var orderTotalValue = selenium.getText("Checkout#ORDER_TOTAL_VALUE");

			return "${orderTotalValue}";
		}
	}

	@summary = "Go to order details after performing checkout process"
	macro goToOrdersDetailsFromCheckout {
		Default.Click(
			key_text = "Go to Order Details",
			locator1 = "Portal.Button#ANY");

		Default.WaitForVisible(
			key_fieldName = "Order Id",
			locator1 = "Orders#GENERIC_FIELD_VALUE");
	}

	@summary = "Place a new Parcel Order"
	macro placeParcelOrder {
		if ("${parcelDropSplit}" == "true") {
			Default.Click(
				key_indexNumber = "5",
				key_text = "BUY NOW",
				locator1 = "Portal.Button#ANY_N");

			Parcel.splitShipment();
		}
		else {
			Default.Click(
				key_text = "BUY NOW",
				locator1 = "Portal.Button#ANY");
		}

		Default.Click(
			key_text = "CHECKOUT",
			locator1 = "Portal.Button#ANY");

		Default.Click(
			key_text = "Continue",
			locator1 = "Portal.Button#ANY");

		Default.WaitForElementPresent(locator1 = "Checkout#ORDER_REFERENCE_INPUT_FIELD");

		Default.Click(
			key_text = "Continue",
			locator1 = "Portal.Button#ANY");

		Default.Click(
			key_text = "payment",
			locator1 = "Checkout#PAYMENT_METHOD_RADIO_BUTTON");

		Default.Click(
			key_text = "Continue",
			locator1 = "Portal.Button#ANY");

		Default.Click(
			key_text = "Submit Order",
			locator1 = "Portal.Button#ANY");

		Default.WaitForElementPresent(locator1 = "Checkout#FINISHED_CHECKOUT_BODY");
	}

}