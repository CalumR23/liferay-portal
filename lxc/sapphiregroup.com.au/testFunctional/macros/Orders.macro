definition {

	@summary = "Get the ID from last placed order"
	macro _getLastPlacedOrderId {
		Navigator.openAustraliaPlacedOrders();

		Default.WaitForVisible(locator1 = "Orders#PLACED_ORDER_ID");

		var text = selenium.getText("Orders#PLACED_ORDER_ID");

		var orderId = StringUtil.extractDigits("${text}");

		return "${orderId}";
	}

	@summary = "Get the ID from last placed order after purchasing"
	macro getLastPlacedOrderIdAfterPurchase {
		var latestOrderId = Orders._getLastPlacedOrderId();

		return "${latestOrderId}";
	}

	@summary = "Get the ID from last placed order before purchasing"
	macro getLastPlacedOrderIdBeforePurchase {
		var previousOrderId = Orders._getLastPlacedOrderId();

		static var staticPreviousOrderId = "${previousOrderId}";

		return "${staticPreviousOrderId}";
	}

}