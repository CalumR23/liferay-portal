definition {

	@summary = "Assert the order is placed by order ID, Type and Amount/Total Value"
	macro assertOrderDetails {
		Default.AssertElementPresent(
			key_fieldName = "Order Id",
			key_fieldValue = "${orderId}",
			locator1 = "Orders#FIELD_VALUE");

		Default.AssertElementPresent(
			key_fieldName = "Order Type",
			key_fieldValue = "Parcel",
			locator1 = "Orders#FIELD_VALUE");

		Default.AssertElementPresent(
			key_fieldName = "Total",
			key_fieldValue = "${orderTotalValue}",
			locator1 = "Orders#FIELD_VALUE");
	}

	@summary = "Assert the order is placed by order ID, Type and Amount/Total Value"
	macro assertOrderIsPlaced {
		Default.AssertElementPresent(
			key_orderId = "${orderId}",
			locator1 = "PlacedOrders#SPECIFIC_PLACED_ORDER_ID");

		Default.AssertElementPresent(
			key_orderId = "${orderId}",
			key_orderType = "Parcel",
			locator1 = "PlacedOrders#ORDER_TYPE");

		Default.AssertElementPresent(
			key_amountValue = "${orderTotalValue}",
			key_orderId = "${orderId}",
			locator1 = "PlacedOrders#AMOUNT");
	}

	@summary = "Assert the order details 'order ID' and 'Total Value' in Order Details page"
	macro assertPrepaidOrderDetails {
		Default.AssertElementPresent(
			key_fieldName = "Order Id",
			key_fieldValue = "${orderId}",
			locator1 = "Orders#FIELD_VALUE");

		Default.AssertElementPresent(
			key_fieldName = "Total",
			key_fieldValue = "${orderTotalValue}",
			locator1 = "Orders#FIELD_VALUE");
	}

	@summary = "Assert the order is placed by 'order ID' and 'Total Value' in Placed Orders page"
	macro assertPrepaidOrderIsPlaced {
		Default.AssertElementPresent(
			key_orderId = "${orderId}",
			locator1 = "PlacedOrders#SPECIFIC_PLACED_ORDER_ID");

		Default.AssertElementPresent(
			key_amountValue = "${orderTotalValue}",
			key_orderId = "${orderId}",
			locator1 = "PlacedOrders#AMOUNT");
	}

	@summary = "Assert the split order is properly placed by order type, product name and product quantity"
	macro assertSplitOrderDetails {

		// LXC Refactor: This macro needs to be improved to assert product name and quantity
		// LXC Refactor ticket: LRQA-76799

		Default.AssertElementPresent(
			key_fieldName = "Order Type",
			key_fieldValue = "Parcel",
			locator1 = "Orders#FIELD_VALUE");
	}

	@summary = "Get the ID from a placed order"
	macro getOrderIdFromOderDetails {
		task ("Saving the order id into the variable 'orderId' to be reused later") {
			var orderIdText = selenium.getText("Orders#ORDER_ID");

			var orderId = StringUtil.extractDigits("${orderIdText}");

			return "${orderId}";
		}
	}

	@summary = "Get the Total Value from a placed order"
	macro getOrderTotalValueFromOderDetails {
		task ("Saving the order total value into the variable 'orderTotalValue' to be reused later") {
			var orderTotalValue = selenium.getText("Orders#ORDER_TOTAL_VALUE");

			return "${orderTotalValue}";
		}
	}

	@summary = "Open placed order by its id"
	macro openPlacedOrderById {
		Orders.waitForPlacedOrderPresent(orderId = "${orderId}");

		Default.Click(
			key_orderId = "${orderId}",
			locator1 = "PlacedOrders#SPECIFIC_PLACED_ORDER_ID");

		Default.WaitForElementPresent(
			key_fieldName = "Order Id",
			locator1 = "Orders#GENERIC_FIELD_VALUE");
	}

	@summary = "Open placed order by the split number position"
	macro openPlacedOrderBySplitNumber {
		Default.Click(
			key_position = "${splitNumber}",
			locator1 = "PlacedOrders#PLACED_ORDER_POSITION");

		Default.WaitForElementPresent(
			key_fieldName = "Order Id",
			locator1 = "Orders#GENERIC_FIELD_VALUE");
	}

	@summary = "View order is properly placed and matches the order datails"
	macro viewOrder {
		task ("Checking order information from the Placed Orders page") {
			Orders.waitForPlacedOrderPresent(orderId = "${orderId}");

			Orders.assertOrderIsPlaced(
				orderId = "${orderId}",
				orderTotalValue = "${orderTotalValue}");
		}

		task ("Checking order information from the Order Details page") {
			Orders.openPlacedOrderById(orderId = "${orderId}");

			Orders.assertOrderDetails(
				orderId = "${orderId}",
				orderTotalValue = "${orderTotalValue}");
		}
	}

	@summary = "View prepaid order is properly placed and matches the order datails"
	macro viewPrepaidOrder {
		task ("Checking order information from the Placed Orders page") {
			Orders.waitForPlacedOrderPresent(orderId = "${orderId}");

			Orders.assertPrepaidOrderIsPlaced(
				orderId = "${orderId}",
				orderTotalValue = "${orderTotalValue}");
		}

		task ("Checking order information from the Order Details page") {
			Orders.openPlacedOrderById(orderId = "${orderId}");

			Orders.assertPrepaidOrderDetails(
				orderId = "${orderId}",
				orderTotalValue = "${orderTotalValue}");
		}
	}

	@summary = "Assert the orders are properly placed"
	macro viewSplitOrder {
		task ("Checking order information from the main order in Placed Orders page") {
			Orders.waitForAllSplitOrdersPresent(
				mainOrderId = "${mainOrderId}",
				mainOrderPosition = "${mainOrderPosition}");

			Orders.assertOrderIsPlaced(
				orderId = "${mainOrderId}",
				orderTotalValue = "${mainOrderTotalValue}");
		}

		task ("Checking order information from Split 2 in the Order Details page") {
			Orders.openPlacedOrderBySplitNumber(splitNumber = "${splitOrderPosition}");

			// LXC Refactor: The macro Orders.assertSplitOrderDetails needs to be improved to assert product name and quantity
			// LXC Refactor ticket: LRQA-76799

			Orders.assertSplitOrderDetails();
		}
	}

	@summary = "Load all split orders in Placed Orders page"
	macro waitForAllSplitOrdersPresent {
		task ("Wait until all needed orders are shown in the placed orders table") {
			while ((Default.IsTextNotEqual(key_position = "${mainOrderPosition}", locator1 = "PlacedOrders#PLACED_ORDER_POSITION", value1 = "${mainOrderId}")) && (maxIterations = "30")) {
				Default.Refresh();

				Default.WaitForVisible(locator1 = "PlacedOrders#PLACED_ORDER_ID");
			}
		}
	}

	@summary = "Load latest placed order"
	macro waitForPlacedOrderPresent {
		task ("Wait until the needed order is shown in the placed orders table") {
			while ((Default.IsElementNotPresent(key_orderId = "${orderId}", locator1 = "PlacedOrders#SPECIFIC_PLACED_ORDER_ID")) && (maxIterations = "20")) {
				Default.Refresh();

				Default.WaitForVisible(locator1 = "PlacedOrders#PLACED_ORDER_ID");
			}
		}
	}

}