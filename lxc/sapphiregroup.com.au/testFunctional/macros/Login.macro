definition {

	macro signIn {
		Default.Type(
			key_inputLabelName = "Email Address",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${userEmailAddress}");

		Default.Type(
			key_inputLabelName = "Password",
			locator1 = "Login#INPUT_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "Login#SIGN_IN_BUTTON");

		Default.WaitForElementPresent(locator1 = "HomePage#CAROUSEL");
	}

	macro signInWithAdminUser {
		var userEmailAddress = PropsUtil.get("test.this.sapphire.test.account.uat.admin.login");
		var userPassword = PropsUtil.get("test.this.sapphire.test.account.uat.admin.password");

		Login.signIn(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	macro signInWithPrepayUser {
		var userEmailAddress = PropsUtil.get("test.this.sapphire.test.account.uat.prepay.user.login");
		var userPassword = PropsUtil.get("test.this.sapphire.test.account.uat.prepay.user.password");

		Login.signIn(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

}