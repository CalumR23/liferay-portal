<html>
<head>
<title>Orders</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Orders</td></tr>
</thead>

<tbody>
<tr>
	<td>DISPATCH_DATE_N</td>
	<td>xpath=((//div[@class='dnd-tbody']//div[@class='dnd-tr'])[${key_indexNumber}]//div[@class='dnd-td'])[4]</td>
	<td></td>
</tr>
<tr>
	<td>FIELD_VALUE</td>
	<td>//*[@class='commerce-list']//*[text()='${key_fieldName}']//following-sibling::*[text()='${key_fieldValue}']</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_FIELD_VALUE</td>
	<td>//*[@class='commerce-list']//*[text()='${key_fieldName}']//following-sibling::*</td>
	<td></td>
</tr>
<tr>
	<td>PLACED_ORDER_PRODUCT_NAME</td>
	<td>//a[text()='${key_productName}']</td>
	<td></td>
</tr>
<tr>
	<td>PLACED_ORDER_PRODUCT_QUANTITY</td>
	<td>xpath=(//a[text()='${key_productName}']//ancestor::div[contains(@class,'dnd-td')]//following-sibling::div)[6]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>