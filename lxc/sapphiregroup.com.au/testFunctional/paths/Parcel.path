<html>
<head>
<title>Parcel</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Parcel</td></tr>
</thead>

<tbody>
<tr>
	<td>DROPDOUWN_MENU_ITEM</td>
	<td>//div[contains(@class,'dropdown-menu')]//button[@class='dropdown-item'][text()='${key_dropdownMenuItem}']</td>
	<td></td>
</tr>
<tr>
	<td>FRAGMENT</td>
	<td>//button[normalize-space()='${key_collectionName}']/following-sibling::div/ul/li[contains(@class,'page-editor__fragments-widgets__tab')][normalize-space()='${key_fragmentName}']</td>
	<td></td>
</tr>
<tr>
	<td>FRAGMENT_ITEM</td>
	<td>//div[contains(@class,'page-structure__tree-node') and contains(.,'${key_fragmentName}')]//ancestor::div[@role='treeitem']/following-sibling::div//div[contains(@aria-label,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FRAME_TOP_MENU_ITEM</td>
	<td>//span[text()='${key_option}']//ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//label[text()='${key_fieldLabel}']/following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FILE</td>
	<td>//label[text()='${key_label}']/..//input[@type='file']</td>
	<td></td>
</tr>
<tr>
	<td>LISTED_PARCEL_ORDER_FORM_BY_NAME</td>
	<td>//p[normalize-space()='${key_parcelOrderFormName}']//ancestor::dd[contains(@class,'item-selector-list-row')]</td>
	<td></td>
</tr>
<tr>
	<td>PARCEL_FRAGMENT_POSITION</td>
	<td>xpath=(//div//*[contains(@class,'parcel-form')])[${key_position}]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//span[text()='Save']/ancestor::button</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//label[text()='${key_fieldLabel}']/following-sibling::div[contains(@class,'select-field')] | //div[label[normalize-space(text())='${key_fieldLabel}']]/select</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD_WITH_INDEX</td>
	<td>xpath=(//label[text()='${key_fieldLabel}']/following-sibling::div[contains(@class,'select-field')] | //div[label[normalize-space(text())='${key_fieldLabel}']]/select)[${index}]</td>
	<td></td>
</tr>
<tr>
	<td>TABPANEL_SELECT_FIELD</td>
	<td>//div[@role='tabpanel']//label[text()='${key_fieldLabel}']//following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>TABPANEL_SELECT_OPTION</td>
	<td>//div[@role='tabpanel']//label[text()='${key_fieldLabel}']//following-sibling::select//option[text()='${key_option}']</td>
	<td></td>
</tr>
<tr>
	<td>UPLOADED_FILE</td>
	<td>//label[text()='${key_fileLabel}']/..//button[contains(text(),'${key_fileName}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>