<html>
<head>
<title>Catalogue</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Catalogue</td></tr>
</thead>

<tbody>
<tr>
	<td>ADD_TO_CART_BUTTON</td>
	<td>//table[contains(@class,'products-table')]/tbody//td[@class='sapphire-add-to-card']//button</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_RESULTS</td>
	<td>//div[@class='pagination-bar']/p[contains(@class,'pagination-results')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>xpath=(//table[contains(@class,'products-table')]/tbody//td/a)[2]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_PRICE</td>
	<td>//table[contains(@class,'products-table')]/tbody//span[@class='price-value']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_QUANTITY_SELECTOR</td>
	<td>//a[text()='${key_productName}']//ancestor::tr//input[contains(@class,'quantity-selector')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_ADD_TO_CART_BUTTON</td>
	<td>//a[text()='${key_productName}']//ancestor::tr//td[@class='sapphire-add-to-card']//button</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SKU</td>
	<td>xpath=(//table[contains(@class,'products-table')]/tbody//td/a)[1]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCTS_AVAILABLE</td>
	<td>//p[contains(text(),'Products Available')]</td>
	<td></td>
</tr>
<tr>
	<td>QUANTITY_LEVEL</td>
	<td>//table[contains(@class,'products-table')]/tbody//span[contains(@class,'available') or contains(@class,'danger')]</td>
	<td></td>
</tr>
<tr>
	<td>QUANTITY_SELECTOR</td>
	<td>//table[contains(@class,'products-table')]/tbody//td[@class='sapphire-add-to-card']//input</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>