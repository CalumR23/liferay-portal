<html>
<head>
<title>ParcelDropSplit</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ParcelDropSplit</td></tr>
</thead>

<tbody>
<tr>
	<td>ANY_SPLIT_QUANTITY_SELECTOR</td>
	<td>xpath=(//*[text()='Drop ${key_dropNumber}']/following-sibling::div//span[text()='${key_productName}']/..//following-sibling::div/select)[${key_splitNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>DROP_SPLIT_SHIPPING_OPTION</td>
	<td>//span[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_NAME</td>
	<td>//*[text()='Drop ${key_dropNumber}']/following-sibling::div//span[text()='${key_productName}']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_REQUIRED_QUANTITY</td>
	<td>//*[text()='Drop ${key_dropNumber}']/following-sibling::div//span[text()='${key_productName}']/..//following-sibling::div/span</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>