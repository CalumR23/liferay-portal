<html>
<head>
<title>Checkout</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Checkout</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTENT_FRAME</td>
	<td>//main[contains(@class,'minium-frame')]/div[contains(@class,'content')]</td>
	<td></td>
</tr>
<tr>
	<td>FINISHED_CHECKOUT_BODY</td>
	<td>//*[contains(@class,'form ')]//fieldset[not(@disabled)]</td>
	<td></td>
</tr>
<tr>
	<td>LOADING_CHECKOUT_BODY</td>
	<td>//*[contains(@class,'form ')]//fieldset[@disabled]</td>
	<td></td>
</tr>
<tr>
	<td>MINI_CART_HAS_BADGE</td>
	<td>//button[contains(@class,'has-badge mini-cart-opener')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_REFERENCE_INPUT_FIELD</td>
	<td>//*[contains(@class,'form ')]//fieldset[not(@disabled)]//input[@title='order-reference']</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_TOTAL_VALUE</td>
	<td>//div[contains(@class,'checkout-summary')]//*[contains(@class,'commerce-total')]//div[@class='commerce-value']</td>
	<td></td>
</tr>
<tr>
	<td>PAYMENT_METHOD_RADIO_BUTTON</td>
	<td>//input[contains(@id,'commercePaymentMethod') and contains(@value,'${key_text}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>