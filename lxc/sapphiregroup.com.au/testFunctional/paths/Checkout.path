<html>
<head>
<title>Checkout</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Checkout</td></tr>
</thead>

<tbody>
<tr>
	<td>FINISHED_CHECKOUT_BODY</td>
	<td>//div[@class='lfr-tooltip-scope']</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_REFERENCE_INPUT_FIELD</td>
	<td>//fieldset[@class='input-container']//input[@title='order-reference']</td>
	<td></td>
</tr>
<tr>
	<td>PAYMENT_METHOD_RADIO_BUTTON</td>
	<td>//input[contains(@id,'commercePaymentMethod') and contains(@value,'${key_text}')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>