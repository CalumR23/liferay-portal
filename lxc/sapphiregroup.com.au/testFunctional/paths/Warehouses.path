<html>
<head>
<title>Warehouses</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Warehouses</td></tr>
</thead>

<tbody>
<tr>
	<td>ACTIVATED_ITEM_VERTICAL_ELLIPSIS</td>
	<td>//span[@class='c-inner']/*[name()='svg'][contains(@class,'check')]//ancestor::tr//a[span/*[name()='svg'][contains(@class,'icon-ellipsis')]]</td>
	<td></td>
</tr>
<tr>
	<td>DEACTIVATED_ITEM_VERTICAL_ELLIPSIS</td>
	<td>//span[@class='c-inner']/*[name()='svg'][contains(@class,'times')]//ancestor::tr//a[span/*[name()='svg'][contains(@class,'icon-ellipsis')]]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>