<html>
<head>
<title>PlacedOrders</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PlacedOrders</td></tr>
</thead>

<tbody>
<tr>
	<td>AMOUNT</td>
	<td>xpath=(//div[@class='dnd-tbody']//a[@data-senna-off][text()='${key_orderId}']//ancestor::div[@class='dnd-td']//following-sibling::div)[7][text()='${key_amountValue}']</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_TYPE</td>
	<td>xpath=(//div[@class='dnd-tbody']//a[@data-senna-off][text()='${key_orderId}']//ancestor::div[@class='dnd-td']//following-sibling::div)[1][text()='${key_orderType}']</td>
	<td></td>
</tr>
<tr>
	<td>PLACED_ORDER_ID</td>
	<td>//div[@class='dnd-tbody']//a[@data-senna-off]</td>
	<td></td>
</tr>
<tr>
	<td>PLACED_ORDER_POSITION</td>
	<td>xpath=(//div[@class='dnd-tbody']//a[@data-senna-off])[${key_position}]</td>
	<td></td>
</tr>
<tr>
	<td>SPECIFIC_PLACED_ORDER_ID</td>
	<td>//div[@class='dnd-tbody']//a[@data-senna-off][text()='${key_orderId}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>