<html>
<head>
<title>HomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">HomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>CAROUSEL</td>
	<td>//div[@class='carousel']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//ul[@class='control-menu-nav']//span[@title='Edit']/a</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_DROPDOWN_MENU_ITEM</td>
	<td>//div[@class='minium-frame__secondary']//*[contains(text(),'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_ITEM</td>
	<td>//div[@class='minium-frame__secondary']//*[contains(text(),'${key_menuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARCEL_FORM_IMAGE_LINK</td>
	<td>xpath=(//img[contains(@class,'parcel-form-image')])[${key_index}]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>