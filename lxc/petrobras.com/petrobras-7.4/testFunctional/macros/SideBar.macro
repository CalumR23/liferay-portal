definition {

	@summary = "Add new link in Links sidebar option"
	macro addLink {
		Default.Click(locator1 = "SideBar#ADD_LINK_BUTTON");

		Default.Type(
			fieldName = "Insira um nome",
			locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
			value1 = "${linkName}");

		Default.Type(
			fieldName = "Insira o endereço do link",
			locator1 = "SideBar#INPUT_ADD_LINK_FIELD",
			value1 = "${linkUrl}");

		Default.Click(locator1 = "SideBar#CHECK_ICON");
	}

	@summary = "Assert link in sidebar"
	macro assertLink {
		Default.AssertElementPresent(
			key_itemLink = "${itemLink}",
			key_itemName = "${itemName}",
			locator1 = "SideBar#LINK_ON_LIST");
	}

	macro editLink {
		var itemLink = StringUtil.replace("${itemName}", " ", "");

		var itemLink = StringUtil.lowerCase("${itemLink}");

		Default.Click(
			key_itemName = "${itemName}",
			locator1 = "SideBar#EDIT_ICON");

		Default.Type(
			key_linkField = "${itemName}",
			locator1 = "SideBar#INPUT_EDIT_LINK_NAME",
			value1 = "${newName}");

		Default.Type(
			key_linkField = "${itemLink}.com",
			locator1 = "SideBar#INPUT_EDIT_LINK_NAME",
			value1 = "${newLink}");

		Default.Click(
			key_itemName = "${itemName}",
			locator1 = "SideBar#CHECK_ICON_DIV");
	}

	@summary = "Verify item is favorited"
	macro favoriteItemOnTab {
		Default.AssertElementPresent(
			key_itemName = "${itemName}",
			locator1 = "SideBar#ITEM_FAVORITE_LIST");
	}

	@summary = "Select sidebar option"
	macro goToSideBarItem {
		Default.Click(
			key_optionName = "${optionName}",
			locator1 = "HomePage#SIDE_BAR");
	}

	@summary = "Select sidebar tab"
	macro goToSideBarTab {
		Default.Click(
			key_navItem = "${navItem}",
			locator1 = "SideBar#NAV_BAR");
	}

	@summary = "Search link in sidebar"
	macro searchLink {
		Default.Type(
			locator1 = "SideBar#SEARCH",
			value1 = "${searchValue}");
	}

	@summary = "Assert number of results in search results"
	macro searchResultsNumber {
		Default.AssertElementPresent(
			key_resultMessage = "${resultMessage}",
			locator1 = "SideBar#SEARCH_RESULT_NUMBER");
	}

	@summary = "Search user in Lope sidebar option"
	macro searchUser {
		Default.Type(
			locator1 = "SideBar#SEARCH",
			value1 = "${userName}");

		Default.KeyPress(
			locator1 = "SideBar#SEARCH",
			value1 = "\ENTER");
	}

	macro selectSideBarFrame {
		Default.SelectFrame(locator1 = "SideBar#NAV_BAR_FRAME");
	}

}