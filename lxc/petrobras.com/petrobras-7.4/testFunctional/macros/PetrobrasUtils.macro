definition {

	@summary = "Add new user"
	macro addUser {
		if (!(isSet(key_userPassword1))) {
			var key_userPassword1 = "test";
		}

		if (!(isSet(key_userPassword2))) {
			var key_userPassword2 = "test";
		}

		Portal.LexiconEntry.gotoAdd();

		Default.Type(
			locator1 = "Portal.UsersAndOrganizationsEditUser#DETAILS_SCREEN_NAME_FIELD",
			value1 = "${userScreenName}");

		Default.Type(
			locator1 = "Portal.UsersAndOrganizationsEditUser#DETAILS_EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Default.Type(
			locator1 = "Portal.UsersAndOrganizationsEditUser#DETAILS_FIRST_NAME_FIELD",
			value1 = "${userFirstName}");

		Default.Type(
			locator1 = "Portal.UsersAndOrganizationsEditUser#DETAILS_LAST_NAME_FIELD",
			value1 = "${userLastName}");

		Default.AssertClick(
			locator1 = "Portal.Button#SUBMIT",
			value1 = "Salvar");

		Default.Click(
			key_navItem = "Senha",
			locator1 = "HomePage#NAV_LINK2");

		Default.Type(
			locator1 = "TextField#SET_USER_PASSWORD1",
			value1 = "${key_userPassword1}");

		Default.Type(
			locator1 = "TextField#SET_USER_PASSWORD2",
			value1 = "${key_userPassword2}");

		Default.AssertClick(
			locator1 = "Portal.Button#SUBMIT",
			value1 = "Salvar");
	}

	@summary = "Get directory to upload/import files"
	macro getFilePath {
		var dependenciesDir = "testFunctional/tests/dependencies";

		var dependencyFilePath = "${dependenciesDir}/${fileName}";

		return "${dependencyFilePath}";
	}

	@summary = "Open portal"
	macro launchPortal {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}");
	}

	@summary = "Assert current URL partially"
	macro viewURL {
		Default.WaitForPageLoad();

		Default.AssertLocation.assertPartialLocation(value1 = "${partialUrl}");
	}

}