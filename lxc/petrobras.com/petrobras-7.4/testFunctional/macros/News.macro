definition {

	@summary = "Add new item in news widget"
	macro addNewNews {
		task ("Hover 'News' widget to see the ellipsis and click on it") {
			while (Default.IsElementNotPresent(key_widgetName = "${widgetName}", locator1 = "Button#PLUS_WIDGET_BY_NAME")) {
				Default.MouseOver.mouseOverInvisible(
					key_widgetName = "${widgetName}",
					locator1 = "HomePage#WIDGET_NAME");

				Default.WaitForElementPresent(
					key_widgetName = "${widgetName}",
					locator1 = "HomePage#WIDGET_NAME");
			}

			Default.Click(
				key_widgetName = "${widgetName}",
				locator1 = "Button#PLUS_WIDGET_BY_NAME");

			Default.Click(
				key_tagLib = "${tagLib}",
				locator1 = "Button#SPAN_TAGLIB");
		}

		task ("Fill in necessary fields") {
			Portal.PortletEntry.inputTitle(title = "Test Carousel News");

			Default.Click(
				key_indexNumber = "10",
				key_text = "Selecionar",
				locator1 = "Portal.Button#ANY_N");

			var filePath = PetrobrasUtils.getFilePath(fileName = "liferay.jpeg");

			Default.SelectFrame(locator1 = "Portal.IFrame#MODAL_BODY");

			Default.UploadFile(
				locator1 = "Portal.TextInput#FILE",
				value1 = "${filePath}");

			Default.Click(
				key_text = "Adicionar",
				locator1 = "Portal.Button#ANY");
		}

		task ("Publish the news") {
			Default.SelectFrameTop();

			Default.Click(locator1 = "Button#PUBLICAR");
		}

	}

	@summary = "Verify if a news is displayed on 'News' widget"
	macro assertNewsIsDisplayed {
		Default.Refresh();

		Default.AssertElementPresent(
			key_newsName = "${newsName}",
			locator1 = "HomePage#NEWS_ON_LIST");
	}

}