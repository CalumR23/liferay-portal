definition {

	@summary = "Add new item in news carousel"
	macro addNewNewsOnCarousel {
		Default.MouseOver(locator1 = "HomePage#NEWS_CAROUSEL");

		Default.Click(
			key_widgetClass = "${widgetClass}",
			locator1 = "Button#PLUS_WIDGET");

		Default.Click(
			key_tagLib = "${tagLib}",
			locator1 = "Button#SPAN_TAGLIB");

		Portal.PortletEntry.inputTitle(title = "${newsTitle}");

		Default.Click(
			key_indexNumber = "10",
			key_text = "Selecionar",
			locator1 = "Portal.Button#ANY_N");

		IFrame.selectFrameTop();

		IFrame.selectNoLoadingModalFrame();

		var filePath = PetrobrasUtils.getFilePath(fileName = "liferay.jpeg");

		Default.UploadFile(
			locator1 = "Portal.TextInput#FILE",
			value1 = "${filePath}");

		Default.Click(
			key_text = "Adicionar",
			locator1 = "Portal.Button#ANY");

		IFrame.selectFrameTop();

		Default.Click(locator1 = "Button#PUBLICAR");

		Default.WaitForElementPresent(
			key_newsName = "${newsTitle}",
			locator1 = "HomePage#NEWS_ON_CAROUSEL");
	}

	macro addNewHighlightedImage {
		Default.MouseOver(
			key_index = "1",
			locator1 = "HomePage#FEATURED_IMAGE");

		Default.Click(locator1 = "HomePage#HIGHLIGHTED_IMAGE_BUTTON");

		Default.Click(
			key_tagLib = "Home - Imagem destaque",
			locator1 = "Button#SPAN_TAGLIB");
	
		Portal.PortletEntry.inputTitle(title = "${newsName}");

		Default.Click(
			key_indexNumber = "8",
			key_text = "Selecionar",
			locator1 = "Portal.Button#ANY_N");

		IFrame.selectFrameTop();

		IFrame.selectNoLoadingModalFrame();

		var filePath = PetrobrasUtils.getFilePath(fileName = "liferay.jpeg");

		Default.UploadFile(
			locator1 = "Portal.TextInput#FILE",
			value1 = "${filePath}");

		Default.Click(
			key_text = "Adicionar",
			locator1 = "Portal.Button#ANY");

		IFrame.selectFrameTop();

		Default.Click(locator1 = "Button#PUBLICAR");
	}

	@summary = "Assert news in carousel home page widget"
	macro assertNewsOnCarousel {
		Default.Refresh();

		Default.AssertElementPresent(
			key_newsName = "${newsName}",
			locator1 = "HomePage#NEWS_ON_CAROUSEL");
	}

	@summary = "Assert post in Social Media wigdet"
	macro assertSocialMediaPostByIndex {
		if (isSet(socialNetwork) && ("${socialNetwork}" == "twitter")) {
			Default.Click(
				key_navItem = "twitter",
				locator1 = "HomePage#NAV_LINK");

			Default.Click(
				key_arrowDirection = "right",
				locator1 = "HomePage#SLICK_ARROW");
		}

		Default.AssertElementPresent(
			key_socialNetwork = "${socialNetwork}",
			locator1 = "HomePage#SOCIAL_NETWORK_WIDGET");
	}

	@summary = "Select home page widget"
	macro goToHomePageWidgetItem {
		Default.Click(
			key_optionName = "${optionName}",
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#WIDGET_NAME");
	}

	@summary = "Assert home page widget"
	macro viewHomePageWidget {
		Default.AssertElementPresent(
			key_widgetName = "${widgetName}",
			locator1 = "HomePage#WIDGET_NAME");
	}

	@summary = "Verify mega menu sub item"
	macro viewMegaMenuItems {
		for (var key_subItem : list "${subItem}") {
			Default.AssertElementPresent(
				key_menuItem = "${menuItem}",
				key_subItem = "${key_subItem}",
				locator1 = "HomePage#MEGA_MENU_SUB_ITEM");
		}
	}

	@summary = "Assert page footer menu"
	macro viewPageFooterNavigation {
		for (var key_optionName : list "${optionName}") {
			Default.AssertElementPresent(
				key_optionName = "${key_optionName}",
				locator1 = "HomePage#FOOTER_WIDGET");
		}
	}

}