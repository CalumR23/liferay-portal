definition {

	@summary = "Login portal"
	macro signIn {
		Default.Click(locator1 = "//span[contains(.,'Entrar')]/a/span");

		if (!(isSet(userLogin))) {
			var userLogin = "test";
		}

		if (!(isSet(userPassword))) {
			var userPassword = "test";
		}

		Default.Type(
			locator1 = "Login#USERNAME_FIELD",
			value1 = "${userLogin}");

		Default.Type(
			locator1 = "Login#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "Login#ENTRAR_BUTTON");
	}

	@summary = "Logout portal"
	macro signOut {
		var portalURL = PropsUtil.get("test.this.petrobras.portal.url");

		Default.Open(locator1 = "${portalURL}/c/portal/logout");
	}

}