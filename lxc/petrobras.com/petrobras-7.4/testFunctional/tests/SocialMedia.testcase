definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that, in the fist tab, the user can see the last 2 posts from Facebook"
	test FacebookPostsAreDisplayed {
		task ("Assert Nas Redes Sociais widget have 2 posts from facebook") {
			HomePage.assertSocialMediaPostByIndex(
				newsIndex = "0,1",
				socialNetwork = "facebook");
		}
	}

	@description = "Verify that, in the second tab, the user can see the last 2 posts from Twitter"
	test TwitterPostsAreDisplayed {
		task ("Assert Nas Redes Sociais widget have 2 posts from twitter") {
			HomePage.assertSocialMediaPostByIndex(
				newsIndex = "0,1",
				socialNetwork = "twitter");
		}
	}

}