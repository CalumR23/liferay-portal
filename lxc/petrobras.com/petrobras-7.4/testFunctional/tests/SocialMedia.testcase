@ignore = "true"
definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();

			Default.Refresh();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that, in the fist tab, the user can see the last 2 posts from Facebook"
	test FacebookPostsAreDisplayed {

		// PTB Refactor: The widget need a lot of refreshes on page to be displayed correctly
		// PTB Refactor ticket: SMEPTINT2204-240

		task ("Assert Nas Redes Sociais widget is displayed") {
			HomePage.assertSocialMediaPostByIndex(socialNetwork = "facebook");
		}
	}

	@description = "Verify that, in the second tab, the user can see the last 2 posts from Twitter"
	test TwitterPostsAreDisplayed {

		// PTB Refactor: The widget need a lot of refreshes on page to be displayed correctly
		// PTB Refactor ticket: SMEPTINT2204-240

		task ("Assert Nas Redes Sociais widget is displayed") {
			HomePage.assertSocialMediaPostByIndex(socialNetwork = "twitter");
		}
	}

}