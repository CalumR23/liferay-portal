definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that it is possible to add News and see it in News widget"
	test CanAddAndSeeNews {
		task ("Given user want to add new news on widget") {
			News.addNewNews(
				newsTitle = "Test News",
				tagLib = "Notícias Corporativas",
				widgetName = "Notícias");
		}

		task ("Then the news is displayed") {
			Default.Refresh();

			News.assertNewsIsDisplayed(newsName = "Test News");
		}
	}

	@description = "Verify that the user can see related news next to the original new"
	test CanSeeRelatedNewsOnOriginalNew {
		task ("Given user click in some news") {
			Default.Click(
				key_newsName = "VIDEO VIDEO VIDEO",
				locator1 = "HomePage#NEWS_ON_LIST");
		}

		task ("Then the user go to new page and can see related news widget") {
			HomePage.viewHomePageWidget(widgetName = "Notícias recomendadas");
		}
	}

	@description = "Verify that the titles and images from the related news are displayed"
	test RelatedNewsImageIsDisplayed {
		task ("Given user select a news") {
			Default.Click(
				key_newsName = "VIDEO VIDEO VIDEO",
				locator1 = "HomePage#NEWS_ON_LIST");
		}

		task ("Then the news image is displayed") {
			Default.AssertElementPresent(
				key_infoKeyword = "iniciativa",
				key_noticeInfo = "image",
				locator1 = "RelatedNews#RELATED_NEWS_TITLE_OR_IMAGE");
		}
	}

	@description = "Verify that the title from the related news is displayed"
	test RelatedNewsTitleIsDisplayed {
		task ("Given user select a news") {
			Default.Click(
				key_newsName = "VIDEO VIDEO VIDEO",
				locator1 = "HomePage#NEWS_ON_LIST");
		}

		task ("Then the news title is displayed") {
			Default.AssertElementPresent(
				key_infoKeyword = "iniciativa",
				key_noticeInfo = "title",
				locator1 = "RelatedNews#RELATED_NEWS_TITLE_OR_IMAGE");
		}
	}

}