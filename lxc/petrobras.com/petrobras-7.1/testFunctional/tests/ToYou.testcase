definition {

	setUp {
		task ("Open Portal") {
			PetrobrasUtils.launchPortal();
		}

		task ("Login") {
			Login.signIn();
		}
	}

	@description = "Verify that there is a hint displaying the segmentation information."
	test CanSeeSegmentationTypeMessageOverIcon {
		task ("Given user over a Função segmentation icon") {
			Default.MouseOver(
				key_segmentationName = "funcao",
				locator1 = "HomePage#SEGMENTATION_ICON");
		}

		task ("Then the segmentation explanation is displayed") {
			Default.AssertElementPresent(
				key_segmentationName = "Função",
				locator1 = "HomePage#SEGMENTATION_MESSAGE");
		}

		task ("And given user over an Orgão segmentation icon") {
			Default.MouseOver(
				key_segmentationName = "lotacao",
				locator1 = "HomePage#SEGMENTATION_ICON");
		}

		task ("Then the segmentation explanation is displayed") {
			Default.AssertElementPresent(
				key_segmentationName = "Orgão",
				locator1 = "HomePage#SEGMENTATION_MESSAGE");
		}
	}

	@description = "Verify that the user is able to identify, through an icon, what segment is being used to display the content."
	test CanSeeSegmentationTypeOnIcon {
		task ("Given user over a Função segmentation icon") {
			Default.MouseOver(
				key_segmentationName = "funcao",
				locator1 = "HomePage#SEGMENTATION_ICON");

			Default.AssertVisible(
				key_segmentationName = "Notícia segmentada por Função (Gerente Geral)",
				locator1 = "HomePage#SEGMENTATION_MESSAGE");
		}

		task ("Then is displayed what segments is used in content") {
			Default.AssertVisible(
				key_segmentationName = "Função (Gerente Geral)",
				locator1 = "HomePage#SEGMENTATION_MESSAGE");
		}
	}

}