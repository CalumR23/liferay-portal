definition {

	@summary = "Login portal"
	macro signIn {
		Default.AssertClick(
			locator1 = "Portal.UserBar#USER_SIGN_IN",
			value1 = "${localizedSignIn}");

		if (!(isSet(userLogin))) {
			var userLogin = "test";
		}

		if (!(isSet(userPassword))) {
			var userPassword = "test";
		}

		Default.Type(
			locator1 = "Login#USERNAME_LOGIN_FIELD",
			value1 = "${userLogin}");

		Default.Type(
			locator1 = "Login#PASSWORD_LOGIN_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "Login#ENTRAR_BUTTON");
	}

	@summary = "Logout portal"
	macro signOut {
		Default.Click(locator1 = "HomePage#MENU_SIDE_BAR");

		Default.Click(locator1 = "HomePage#USER_MENU");

		Default.Click(locator1 = "Button#LOGOUT_BUTTON");
	}

}