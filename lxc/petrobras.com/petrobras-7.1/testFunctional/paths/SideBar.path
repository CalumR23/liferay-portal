<html>
<head>
<title>SideBar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SideBar</td></tr>
</thead>

<tbody>
<tr>
	<td>NAV_BAR</td>
	<td>//a[contains(@class,'nav-link') and contains(.,'${key_navItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_BAR_FRAME</td>
	<td>//iframe[contains(@class,'ptb-toolbar__panel__iframe')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_OR_REMOVE_FAVORITE_ITEM</td>
	<td>//div//a[contains(@class,'ptb-link') and contains(@name,'${key_itemName}')]/../..//button[contains(@onclick,'${key_itemState}')]</td>
	<td></td>
</tr>
<tr>
	<td>ITEM_FAVORITE_LIST</td>
	<td>//div//a[contains(@class,'ptb-link') and contains(@name,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>SIDE_BAR_SEARCH</td>
	<td>//input[contains(@type,'search')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_NUMBER</td>
	<td>//div[contains(@id,'data-search-filter') and contains(.,'${key_resultMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_ON_LIST</td>
	<td>//div//p//a[contains(@href,'http://${key_itemLink}') and contains(.,'${key_itemName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_LINK_BUTTON</td>
	<td>//a[contains(@onclick,'addLink')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_ADD_LINK_FIELD</td>
	<td>//input[contains(@placeholder,'${fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_ICON</td>
	<td>//div//p[contains(@class,'ptb-widget-link') and contains(.,'${key_itemName}')]/../../..//a//div[contains(@class,'edit-action icon')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_ICON</td>
	<td>//div//p[contains(@class,'ptb-widget-link') and contains(.,'${key_itemName}')]/../../..//button//div[contains(@class,'icon-trash')]</td>
	<td></td>
</tr>
<tr>
	<td>CHECK_ICON_DIV</td>
	<td>//div//p[contains(@class,'ptb-widget-link') and contains(.,'${key_itemName}')]/../../..//button//div[contains(@class,'icon-ok')]</td>
	<td></td>
</tr>
<tr>
	<td>CHECK_ICON</td>
	<td>//button//i[contains(@class,'icon-ok text-secondary')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_EDIT_LINK_NAME</td>
	<td>//div//input[contains(@id,'Widget_Links') and contains(@value,'${key_linkField}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>