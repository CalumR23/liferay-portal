<html>
<head>
<title>Video</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Video</td></tr>
</thead>

<tbody>
<tr>
	<td>VIDEO_BY_INDEX</td>
	<td>xpath=(//div[contains(@class,'ptb-video__wrapper')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>PLAY_PAUSE_VIDEO</td>
	<td>//button[contains(@class,'ytp-large-play-button ytp-button')]</td>
	<td></td>
</tr>
<tr>
	<td>VIDEO_STATUS</td>
	<td>//div[contains(@class,'video-player') and contains(@class,'${key_videoStatus}-mode')]</td>
	<td></td>
</tr>
<tr>
	<td>YOUTUBE_FRAME</td>
	<td>//iframe[contains(@src,'youtube')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>