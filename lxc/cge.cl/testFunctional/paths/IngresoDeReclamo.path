<html>
<head>
<title>IngresoDeReclamo</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">IngresoDeReclamo</td></tr>
</thead>

<tbody>
<tr>
	<td>CLAIM_REASON</td>
	<td>//span[contains(text(),'${key_text}')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//*[contains(@class,'label') and contains(text(),'${key_inputLabelName}')]//ancestor::div[contains(@class,'label')]//following-sibling::div//input</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_TITLE</td>
	<td>//div[@class='cge-panel-title']//*[text()='Formulario de Reclamo Oficina Virtual']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_FIELD</td>
	<td>//*[contains(@class,'label') and contains(normalize-space(),'${key_selectLabelName}')]//ancestor::div[contains(@class,'label')]//following-sibling::div//select</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[contains(@class,'modal-success')]</td>
	<td></td>
</tr>
<tr>
	<td>TEXT_AREA</td>
	<td>//*[contains(@class,'label') and contains(text(),'${key_labelName}')]//ancestor::div[contains(@class,'label')]//following-sibling::div//textarea</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>