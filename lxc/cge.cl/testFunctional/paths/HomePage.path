<html>
<head>
<title>HomePage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">HomePage</td></tr>
</thead>

<tbody>
<tr>
	<td>BACKGROUND_IMAGE</td>
	<td>//*[contains(@style,'background-image')]</td>
	<td></td>
</tr>
<tr>
	<td>INPUT_FIELD</td>
	<td>//div[contains(@class,'agrupacciones')][contains(normalize-space(),'Búsqueda')]//input</td>
	<td></td>
</tr>
<tr>
	<td>CARD</td>
	<td>//fieldset[@class='cge-panel']//*[text()='${key_cardName}']//ancestor::a[contains(@class,'generic-card')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_DESCRIPTION</td>
	<td>//*[contains(@class,'heading__description')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_TITLE</td>
	<td>//*[contains(@class,'heading__title')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_TITLE_TEXT</td>
	<td>//*[contains(@class,'heading__title')][div[normalize-space()='${key_headingTitleText}']]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_ITEM</td>
	<td>//div[contains(@class,'cge-navbar') or contains(@class,'nav-item')]//a[normalize-space()='${key_navigationMenuItem}']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_DROPDOWN_ITEM</td>
	<td>//div[contains(@class,'agrupacciones')][contains(normalize-space(),'Búsquedas por Servicios')]//*[contains(text(),'${key_searchText}')]//ancestor::a</td>
	<td></td>
</tr>
<tr>
	<td>USER_AVATAR</td>
	<td>//div[contains(@class,'user-personal-bar')]//div[contains(@class,'cge-responsive-user')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>