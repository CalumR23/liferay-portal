<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>BREADCRUMB</td>
	<td>//span[text()='${key_breadcrumbText}']//ancestor::nav[contains(@aria-label,'Ruta de navegación')]/*[@class='breadcrumb']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_ACTIVE_IMAGE</td>
	<td>//div[contains(@style,'background-image') and contains(@class,'swiper-slide-duplicate-active') and @data-swiper-slide-index='${key_imageNumber}']//ancestor::div[@id='cge-main-carousel']</td>
	<td></td>
</tr>
<tr>
	<td>CAROUSEL_SWIPER</td>
	<td>//div[contains(@style,'background-image') and contains(@class,'swiper-slide-duplicate-active')]//ancestor::div[@id='cge-main-carousel']</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_INFO_BUTTON_PAGO_EN_LINEA</td>
	<td>//div[contains(@class,'cge-content-info')]//button[normalize-space()='Pago en línea']</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_INFO_PHONE_NUMBER</td>
	<td>//div[contains(@class,'cge-content-info')]//*[contains(text(),'800 800 767')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA_IMAGE</td>
	<td>//footer//div[contains(@class,'row-center')]//a[contains(@href,'${key_socialMediaName}')]//img</td>
	<td></td>
</tr>
<tr>
	<td>FORM_SELECT_FIELD</td>
	<td>//*[contains(@class,'label') and contains(normalize-space(),'${key_selectLabelName}')]//ancestor::div[contains(@class,'label')]//following-sibling::div//select</td>
	<td></td>
</tr>
<tr>
	<td>FORM_SELECT_OPTION_N</td>
	<td>xpath=(//*[contains(@class,'label') and contains(normalize-space(),'${key_selectLabelName}')]//ancestor::div[contains(@class,'label')]//following-sibling::div//select/option)[${key_indexNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_LOADING</td>
	<td>//div[@id='loading']</td>
	<td></td>
</tr>
<tr>
	<td>SWIPER_PAGINATION_BULLET_ACTIVE</td>
	<td>//span[contains(@aria-label,'${key_bulletNumber}')][contains(@class,'swiper-pagination-bullet-active')]</td>
	<td></td>
</tr>
<tr>
	<td>SWIPER_PAGINATION_BULLET_INACTIVE</td>
	<td>//span[contains(@aria-label,'${key_bulletNumber}')][not(contains(@class,'swiper-pagination-bullet-active'))]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>