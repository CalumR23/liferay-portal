<html>
<head>
<title>General</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">General</td></tr>
</thead>

<tbody>
<tr>
	<td>BREADCRUMB</td>
	<td>//span[text()='${key_breadcrumbText}']//ancestor::nav[contains(@aria-label,'Ruta de navegación')]/*[@class='breadcrumb']</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_INFO_BUTTON_PAGO_EN_LINEA</td>
	<td>//div[contains(@class,'cge-content-info')]//button[normalize-space()='Pago en línea']</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_INFO_PHONE_NUMBER</td>
	<td>//div[contains(@class,'cge-content-info')]//*[contains(text(),'800 800 767')]</td>
	<td></td>
</tr>
<tr>
	<td>PANEL_LOADING</td>
	<td>//div[@id='loading']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>