definition {

	@summary = "View table is properly loaded in Saldo Actual page"
	macro viewSaldoActualTableIsLoaded {
		Default.AssertElementPresent(locator1 = "SaldoActual#TABLE_ROW");

		task ("Making sure the client number is not null") {
			var clientNumber = selenium.getText("SaldoActual#CLIENT_NUMBER");

			Portal.TestUtils.assertNotEquals(
				actual = "${clientNumber}",
				expected = "");
		}
	}

}