definition {

	@summary = "Making sure carousel swiper is properly loaded"
	macro assertCarouselSwiperIsPresent {
		Default.AssertElementPresent(locator1 = "General#CAROUSEL_SWIPER");
	}

	@summary = "View breadcrumb is present"
	macro viewBreadCrumb {
		Default.AssertElementPresent(
			key_breadcrumbText = "${breadcrumbText}",
			locator1 = "General#BREADCRUMB");
	}

	@summary = "View content info is shown"
	macro viewContentInfo {
		Default.AssertVisible(locator1 = "General#CONTENT_INFO_BUTTON_PAGO_EN_LINEA");

		Default.AssertVisible(locator1 = "General#CONTENT_INFO_PHONE_NUMBER");
	}

	@summary = "Assert option is present into a select field"
	macro viewOption {
		Default.AssertElementPresent(
			key_selectLabelName = "${fieldLabel}",
			locator1 = "General#FORM_SELECT_FIELD");

		Default.AssertElementPresent(
			key_indexNumber = "${optionIndexNumber}",
			key_selectLabelName = "${fieldLabel}",
			locator1 = "General#FORM_SELECT_OPTION_N");
	}

	@summary = "View social media icons in page footer"
	macro viewSocialMediaIconsInFooter {
		for (var socialMediaName : list "instagram,facebook,twitter,linkedin,youtube") {
			Default.AssertElementPresent(
				key_socialMediaName = "${socialMediaName}",
				locator1 = "General#FOOTER_SOCIAL_MEDIA_IMAGE");
		}
	}

	@summary = "View carousel swiper works swiping active images"
	macro viewSwipingImagesInCarouselSwiper {
		task ("Making sure the current image loaded in carousel swiper is the image '0'") {
			if (Default.IsElementPresent(key_bulletNumber = "1", locator1 = "General#SWIPER_PAGINATION_BULLET_INACTIVE")) {
				Default.Click(
					key_bulletNumber = "1",
					locator1 = "General#SWIPER_PAGINATION_BULLET_INACTIVE");
			}

			Default.AssertElementPresent(
				key_bulletNumber = "1",
				locator1 = "General#SWIPER_PAGINATION_BULLET_ACTIVE");

			Default.AssertVisible(
				key_imageNumber = "0",
				locator1 = "General#CAROUSEL_ACTIVE_IMAGE");
		}

		task ("Making sure the current image loaded in carousel swiper is the image '1'") {
			if (Default.IsElementPresent(key_bulletNumber = "2", locator1 = "General#SWIPER_PAGINATION_BULLET_INACTIVE")) {
				Default.Click(
					key_bulletNumber = "2",
					locator1 = "General#SWIPER_PAGINATION_BULLET_INACTIVE");
			}

			Default.AssertElementPresent(
				key_bulletNumber = "2",
				locator1 = "General#SWIPER_PAGINATION_BULLET_ACTIVE");

			Default.AssertVisible(
				key_imageNumber = "1",
				locator1 = "General#CAROUSEL_ACTIVE_IMAGE");
		}
	}

}