definition {

	@summary = "Collapse an expanded question"
	macro collapseQuestion {
		task ("Waiting for 'Preguntas Frecuentes' page to be loaded") {
			Default.WaitForVisible(
				key_breadcrumbText = "Preguntas Frecuentes",
				locator1 = "General#BREADCRUMB");
		}

		task ("Collapsing a question based on its title") {
			if (Default.IsElementPresent(key_questionTitle = "${questionTitle}", locator1 = "PreguntasFrecuentes#EXPANDED_QUESTION")) {
				Default.Click(
					key_questionTitle = "${questionTitle}",
					locator1 = "PreguntasFrecuentes#EXPANDED_QUESTION");

				Default.WaitForVisible(
					key_questionTitle = "${questionTitle}",
					locator1 = "PreguntasFrecuentes#COLLAPSED_QUESTION");
			}
		}
	}

	@summary = "Expand a collapsed question"
	macro expandQuestion {
		task ("Waiting for 'Preguntas Frecuentes' page to be loaded") {
			Default.WaitForVisible(
				key_breadcrumbText = "Preguntas Frecuentes",
				locator1 = "General#BREADCRUMB");
		}

		task ("Expanding a question based on its title") {
			if (Default.IsElementPresent(key_questionTitle = "${questionTitle}", locator1 = "PreguntasFrecuentes#COLLAPSED_QUESTION")) {
				Default.Click(
					key_questionTitle = "${questionTitle}",
					locator1 = "PreguntasFrecuentes#COLLAPSED_QUESTION");

				Default.WaitForVisible(
					key_questionTitle = "${questionTitle}",
					locator1 = "PreguntasFrecuentes#EXPANDED_QUESTION");
			}
		}
	}

	@summary = "Assert a collapsed question is visible"
	macro viewCollapsedQuestion {
		Default.AssertVisible(
			key_questionTitle = "${questionTitle}",
			locator1 = "PreguntasFrecuentes#COLLAPSED_QUESTION");
	}

	@summary = "Assert an expanded question is visible"
	macro viewExpandedQuestion {
		Default.AssertVisible(
			key_questionTitle = "${questionTitle}",
			locator1 = "PreguntasFrecuentes#EXPANDED_QUESTION");
	}

}