definition {

	@summary = "Launching UAT with user authentication"
	macro launchCGEUatWithAuthentication {
		var portal = PropsUtil.get("portal.url");

		Default.Open(locator1 = "${portal}");
	}

	@summary = "View page is properly loaded"
	macro viewPage {
		Default.AssertLocation.assertPartialLocation(value1 = "${partialURL}");

		if (isSet(headingTitleText)) {
			Default.AssertElementPresent(
				key_headingTitleText = "${headingTitleText}",
				locator1 = "HomePage#HEADING_TITLE_TEXT");
		}
	}

}