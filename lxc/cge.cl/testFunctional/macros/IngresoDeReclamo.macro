definition {

	@summary = "Submit a form by clicking at 'Enviar' button"
	macro clickEnviar {
		Default.Click(locator1 = "Portal.Button#SUBMIT");
	}

	@summary = "Fill out required form fields"
	macro fillForm {
		Default.WaitForVisible(locator1 = "IngresoDeReclamo#PANEL_TITLE");

		Default.Click(
			key_text = "Ingresa tu emergencia eléctrica",
			locator1 = "IngresoDeReclamo#CLAIM_REASON");

		Default.Type(
			key_selectLabelName = "Número de Cliente",
			locator1 = "IngresoDeReclamo#SELECT_FIELD",
			value1 = "9");

		Default.Type(
			key_inputLabelName = "Rut",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "000000000");

		Default.Type(
			key_inputLabelName = "Nombre",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "Test");

		Default.Type(
			key_inputLabelName = "Apellido Paterno",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "Test");

		Default.Type(
			key_inputLabelName = "Apellido Materno",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "Test");

		Default.Type(
			key_selectLabelName = "Comuna",
			locator1 = "IngresoDeReclamo#SELECT_FIELD",
			value1 = "iquique");

		Default.Type(
			key_inputLabelName = "Calle",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "Test");

		Default.Type(
			key_inputLabelName = "N°",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "90");

		Default.Type(
			key_inputLabelName = "Email",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "test@liferay.com");

		Default.Type(
			key_inputLabelName = "Teléfono",
			locator1 = "IngresoDeReclamo#INPUT_FIELD",
			value1 = "000000000");

		Default.Type(
			key_selectLabelName = "Tipo de Reclamo",
			locator1 = "IngresoDeReclamo#SELECT_FIELD",
			value1 = "Variaciones de voltaje");

		Default.Type(
			key_labelName = "Descripción",
			locator1 = "IngresoDeReclamo#TEXT_AREA",
			value1 = "Test Description");
	}

	@summary = "Submit a new claim entry"
	macro submitClaim {
		IngresoDeReclamo.fillForm();

		IngresoDeReclamo.clickEnviar();
	}

	@summary = "View the success message is shown after an specific action"
	macro viewSuccessMessage {
		Default.AssertVisible(locator1 = "IngresoDeReclamo#SUCCESS_MESSAGE");
	}

}