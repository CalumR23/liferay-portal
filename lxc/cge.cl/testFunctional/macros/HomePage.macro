definition {

	@summary = "Click at a card in 'Destacados' to be redirected"
	macro clickCard {
		Default.Click(
			key_cardName = "${cardName}",
			locator1 = "HomePage#CARD");
	}

	@summary = "Search and go to an item in home page"
	macro goToDropdownItemFromSearchBar {
		Default.Type(
			locator1 = "HomePage#INPUT_FIELD",
			value1 = "${itemName}");

		Default.Click(
			key_searchText = "${itemName}",
			locator1 = "HomePage#SEARCH_DROPDOWN_ITEM");
	}

	@summary = "Click at any item from navigation menu top bar"
	macro goToNavigationBarOption {
		if (isSet(navigationSubmenuItem)) {
			Default.MouseOver(
				key_navigationMenuItem = "${navigationMenuItem}",
				locator1 = "HomePage#NAVIGATION_MENU_ITEM");

			Default.WaitForVisible(
				key_navigationMenuItem = "${navigationSubmenuItem}",
				locator1 = "HomePage#NAVIGATION_MENU_ITEM");

			Default.Click.pauseClickAt(
				key_navigationMenuItem = "${navigationSubmenuItem}",
				locator1 = "HomePage#NAVIGATION_MENU_ITEM");
		}
		else {
			Default.Click(
				key_navigationMenuItem = "${navigationMenuItem}",
				locator1 = "HomePage#NAVIGATION_MENU_ITEM");
		}
	}

	@summary = "View cards are present into 'Destacados' section"
	macro viewCardsOnDestacadosSection {
		for (var cardName : list "${cardNameList}") {
			var key_cardName = "${cardName}";

			Default.AssertElementPresent(locator1 = "HomePage#CARD");
		}
	}

}