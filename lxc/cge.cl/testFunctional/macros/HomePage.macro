definition {

	@summary = "Click at a card in 'Destacados' to be redirected"
	macro clickCard {
		Default.Click(
			key_cardName = "${cardName}",
			locator1 = "HomePage#CARD");
	}

	@summary = "View cards are present into 'Destacados' section"
	macro viewCardsOnDestacadosSection {
		for (var cardName : list "${cardNameList}") {
			var key_cardName = "${cardName}";

			Default.AssertElementPresent(locator1 = "HomePage#CARD");
		}
	}

}