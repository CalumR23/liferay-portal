definition {

	@summary = "View object is properly loaded into the table at Acciones page"
	macro viewObject {
		Default.AssertElementPresent(locator1 = "Acciones#OBJECT_ID");

		task ("Making sure the id value is not null") {
			var idValue = selenium.getText("Acciones#OBJECT_ID");

			Portal.TestUtils.assertNotEquals(
				actual = "${idValue}",
				expected = "");
		}
	}

}