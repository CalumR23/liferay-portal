definition {

	@summary = "Login to 'Oficina Virtual' with the admin user"
	macro loginAsAdminUser {
		var loginUserName = PropsUtil.get("test.this.cge.test.account.uat.admin.login");
		var loginUserPassword = PropsUtil.get("test.this.cge.test.account.uat.admin.password");

		Default.WaitForElementPresent(
			key_fieldLabel = "Nombre de usuario",
			locator1 = "OficinaVirtual#INPUT_FIELD");

		Default.Type(
			key_fieldLabel = "Nombre de usuario",
			locator1 = "OficinaVirtual#INPUT_FIELD",
			value1 = "${loginUserName}");

		Default.Type(
			key_fieldLabel = "Contraseña",
			locator1 = "OficinaVirtual#INPUT_FIELD",
			value1 = "${loginUserPassword}");

		Default.Click(
			key_text = "Acceder",
			locator1 = "Portal.Button#ANY");

		Default.WaitForVisible(
			key_navigationMenuItem = "Mi Cuenta",
			locator1 = "HomePage#NAVIGATION_MENU_ITEM");
	}

}