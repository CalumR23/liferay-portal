definition {

	@summary = "View 'Oficina Virtual' page is properly loaded"
	macro viewPage {
		Default.AssertElementPresent(
			key_headingTitleText = "Oficina Virtual",
			locator1 = "HomePage#HEADING_TITLE_TEXT");

		Default.AssertLocation.assertPartialLocation(value1 = "/web/guest/oficina-virtual");
	}

}