definition {

	@summary = "View 'Pago en Línea' page is properly loaded"
	macro viewPage {
		Default.AssertElementPresent(
			key_headingTitleText = "Pago en Línea",
			locator1 = "HomePage#HEADING_TITLE_TEXT");

		Default.AssertLocation.assertPartialLocation(value1 = "/web/guest/pago-en-linea");
	}

}