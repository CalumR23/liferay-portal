definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();

		task ("Login process") {
			HomePage.goToNavigationBarOption(navigationMenuItem = "Oficina Virtual");

			OficinaVirtual.loginAsAdminUser();

			Utils.waitForLoadingNotPresent();
		}
	}

	@description = "Automation ID: LRQA-77375 | Test Summary: Verify admin user can access object details"
	@priority = "5"
	test ShowsObjectDetailsInAcciones {
		task ("When the admin user goes to 'Acciones' portlet by applications menu") {
			Portal.ApplicationsMenu.gotoPortlet(
				category = "Contenido",
				panel = "Aplicaciones",
				portlet = "Acciones");
		}

		task ("Then the objects details should be properly shown in the table") {
			Acciones.viewObject();
		}
	}

	@description = "Automation ID: LRQA-77376 | Test Summary: Verify remote app still exists after an upgrade"
	@priority = "5"
	test ShowsTableContentInSaldoActualPage {
		task ("When 'Saldo Actual' page is loaded") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Mi Cuenta",
				navigationSubmenuItem = "Saldo Actual");

			Utils.waitForLoadingNotPresent();
		}

		task ("Then the objects details should be properly shown in the table") {
			SaldoActual.viewSaldoActualTableIsLoaded();
		}
	}

}