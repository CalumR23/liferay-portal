definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();
	}

	@description = "Automation ID: LRQA-75258 | Test Summary: Verify background image is present"
	@priority = "5"
	test ShowsBackgroundImage {
		Default.AssertElementPresent(locator1 = "HomePage#BACKGROUND_IMAGE");
	}

	@description = "Automation ID: LRQA-75258 | Test Summary: Verify main cards are present"
	@priority = "5"
	test ShowsMainCards {
		HomePage.viewCardsOnDestacadosSection(cardNameList = "Oficina Virtual,Pago en línea,¿Estás sin luz?");
	}

	@description = "Automation ID: LRQA-75258 | Test Summary: Verify Page heading description is present"
	@priority = "5"
	test ShowsPageHeadingDescription {
		Default.AssertElementPresent(locator1 = "HomePage#HEADING_DESCRIPTION");
	}

}