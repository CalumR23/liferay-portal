definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();

		HomePage.goToNavigationBarOption(navigationMenuItem = "Oficina Virtual");

		OficinaVirtual.loginAsAdminUser();

		Utils.waitForLoadingNotPresent();
	}

	@description = "Automation ID: LRQA-77093 | Test Summary: Verify some pages have a container in the bottom with two content info: Pago en linea and phone number"
	@priority = "5"
	test PagesShowsContainerWithTwoContentInfo {
		task ("When 'Pagar la Cuenta' page is loaded") {
			General.viewContentInfo();

			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Pago de Cuenta",
				navigationSubmenuItem = "Pagar la Cuenta");

			Default.WaitForVisible(
				key_breadcrumbText = "Pagar la Cuenta",
				locator1 = "General#BREADCRUMB");
		}

		task ("Then the content info should also be visible in this page") {
			General.viewContentInfo();
		}
	}

	@description = "Automation ID: LRQA-77376 | Test Summary: Verify remote app still exists after an upgrade"
	@priority = "5"
	test RemoteAppShowsTableContentInSaldoActualPage {
		task ("When 'Saldo Actual' page is loaded") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Mi Cuenta",
				navigationSubmenuItem = "Saldo Actual");

			Utils.waitForLoadingNotPresent();
		}

		task ("Then the objects details should be properly shown in the table") {
			SaldoActual.viewSaldoActualTableIsLoaded();
		}
	}

	@description = "Automation ID: LRQA-77091 | Test Summary: Verify breadcrumb is present on 'Boleta y Anexo Netbilling' page"
	@priority = "5"
	test ShowsBreadcrumbBoletayAnexoNetbilling {
		task ("When 'Boleta y Anexo Netbilling' page is loaded") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Mi Cuenta",
				navigationSubmenuItem = "Boleta y Anexo Netbilling");

			Utils.waitForLoadingNotPresent();
		}

		task ("Then the breadcrumb should be visible") {
			General.viewBreadCrumb(breadcrumbText = "Boleta y Anexo Netbilling");
		}
	}

	@description = "Automation ID: LRQA-77074 | Test Summary: Verify breadcrumb is present on 'Saldo Actual' page"
	@priority = "5"
	test ShowsBreadcrumbSaldoActual {
		task ("When 'Saldo Actual' page is loaded") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Mi Cuenta",
				navigationSubmenuItem = "Saldo Actual");

			Utils.waitForLoadingNotPresent();
		}

		task ("Then the breadcrumb should be visible") {
			General.viewBreadCrumb(breadcrumbText = "Saldo Actual");
		}
	}

	@description = "Automation ID: LRQA-77092 | Test Summary: Verify main carousel swiper is present with images"
	@priority = "5"
	test ShowsMainCarouselSwiperImages {
		task ("When carousel image is loaded") {
			General.assertCarouselSwiperIsPresent();
		}

		task ("Then the carousel swiper should be visible and swipe images") {
			General.viewSwipingImagesInCarouselSwiper();
		}
	}

}