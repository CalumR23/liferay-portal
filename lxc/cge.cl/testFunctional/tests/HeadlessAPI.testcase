definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();
	}

	@description = "Automation ID: LRQA-77374 | Test Summary: Verify Headless API shows some dropdown option for 'Región' field into 'Electrodependientes' form"
	@priority = "5"
	test ShowsOptionsInRegionField {
		task ("When 'Electrodependientes' page is open from search bar") {
			HomePage.goToDropdownItemFromSearchBar(itemName = "Electrodependientes");

			General.viewBreadCrumb(breadcrumbText = "Electrodependientes");
		}

		task ("Then the 'Región' field has a valid option") {
			General.viewOption(
				fieldLabel = "Región",
				optionIndexNumber = "2");
		}
	}

}