definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();

		task ("Login process") {
			HomePage.goToNavigationBarOption(navigationMenuItem = "Oficina Virtual");

			OficinaVirtual.loginAsAdminUser();

			Utils.waitForLoadingNotPresent();
		}
	}

	@description = "Automation ID: LRQA-77020 | Test Summary: Verify new claim can be submitted"
	@priority = "5"
	test AddClaimEntry {
		task ("Given 'Ingresso de Reclamo' page is loaded") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Solicitudes y Reclamos",
				navigationSubmenuItem = "Ingreso de Reclamo");
		}

		task ("When a new claim is submitted") {
			IngresoDeReclamo.submitClaim();
		}

		task ("Then a success message should be visible") {
			IngresoDeReclamo.viewSuccessMessage();
		}
	}

}