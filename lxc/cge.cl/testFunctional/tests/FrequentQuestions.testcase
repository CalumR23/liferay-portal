definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();
	}

	@description = "Automation ID: LRQA-77070 | Test Summary: Verify a question can be expanded or collapsed"
	@priority = "5"
	test CanExpandAndCollapseQuestion {
		task ("Given I perform the login process with a valid account") {
			HomePage.goToNavigationBarOption(navigationMenuItem = "Oficina Virtual");

			OficinaVirtual.loginAsAdminUser();

			Utils.waitForLoadingNotPresent();
		}

		task ("When I expand a frequent asqued question") {
			HomePage.goToNavigationBarOption(
				navigationMenuItem = "Información General",
				navigationSubmenuItem = "Preguntas Frecuentes");

			PreguntasFrecuentes.expandQuestion(questionTitle = "¿Cómo la empresa registra el consumo de cada cliente?");
		}

		task ("Then the question content should be visible") {
			PreguntasFrecuentes.viewExpandedQuestion(questionTitle = "¿Cómo la empresa registra el consumo de cada cliente?");
		}

		task ("When I collapse a frequent asqued question") {
			PreguntasFrecuentes.collapseQuestion(questionTitle = "¿Cómo la empresa registra el consumo de cada cliente?");
		}

		task ("Then the question content should not be visible anymore") {
			PreguntasFrecuentes.viewCollapsedQuestion(questionTitle = "¿Cómo la empresa registra el consumo de cada cliente?");
		}
	}

}