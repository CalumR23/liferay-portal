definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();
	}

	@description = "Automation ID: LRQA-77071 | Test Summary: Verify user can log in with a valid account"
	@priority = "5"
	test CanLoginWithValidAccount {
		task ("When I perform the login process with a valid account") {
			HomePage.goToNavigationBarOption(navigationMenuItem = "Oficina Virtual");

			OficinaVirtual.loginAsAdminUser();
		}

		task ("Then I should be able to see the user avatar icon in header menu") {
			Default.AssertElementPresent(locator1 = "HomePage#USER_AVATAR");
		}
	}

}