definition {

	property test.env = "uat";
	property testray.main.component.name = "CGE";

	setUp {
		Utils.launchCGEUatWithAuthentication();
	}

	@description = "Automation ID: LRQA-76482 | Test Summary: Verify the user is properly redirected when clicking in the card 'Oficina Virtual'"
	@priority = "5"
	test CanOpenOficinaVirtual {
		task ("When I click at 'Oficina Virtual' card in the home page") {
			HomePage.clickCard(cardName = "Oficina Virtual");
		}

		task ("Then the Oficina Virtual page should be properly loaded in a new tab") {
			Default.SelectWindow(locator1 = "Oficina Virtual - CGE");

			Utils.viewPage(
				headingTitleText = "Oficina Virtual",
				partialURL = "/web/guest/oficina-virtual");
		}
	}

	@description = "Automation ID: LRQA-77018 | Test Summary: Verify the user is properly redirected when clicking in the card 'Oficina Virtual'"
	@priority = "5"
	test CanOpenPagoEnLinea {
		task ("When I click at 'Pago en línea' card in the home page") {
			HomePage.clickCard(cardName = "Pago en línea");
		}

		task ("Then the Oficina Virtual page should be properly loaded in a new tab") {
			Default.SelectWindow(locator1 = "Pago en línea - CGE");

			Utils.viewPage(
				headingTitleText = "Pago en Línea",
				partialURL = "/web/guest/pago-en-linea");
		}
	}

}