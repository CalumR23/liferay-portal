<html>
<head>
<title>PatcherFixPackUpdate</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PatcherFixPackUpdate</td></tr>
</thead>
<tbody>
<tr>
	<td>GIT_HASH</td>
	<td>//div[contains(.,'Git Hash')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_VERSION_SELECT_DISABLED</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherProjectVersionId') and contains(@disabled,'')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPONENT_SELECT_DISABLED</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherFixComponentId') and contains(@disabled,'')]</td>
	<td></td>
</tr>
<tr>
	<td>VERSION</td>
	<td>xpath=(//div[contains(@class,'control-group')])[4]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_status')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUIREMENTS_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_requirements')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_BUTTON</td>
	<td>//button[contains(.,'Update')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>MERGE_BUTTON</td>
	<td>//button[contains(.,'Merge')]</td>
	<td></td>
</tr>
<tr>
	<td>BUILD_BUTTON</td>
	<td>//button[contains(.,'Build')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_PARAMETERS-->
<tr>
	<td>JENKINS_PARAMETERS_PATCHER_BUILD_NAME</td>
	<td>//div[contains(.,'patcher.build.name')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_FIXED_ISSUES</td>
	<td>//div[contains(.,'fix.pack.fixed.issues')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_CUSTOMER_TICKET</td>
	<td>//div[contains(.,'fix.pack.customer.ticket')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_BUILT_FOR</td>
	<td>//div[contains(.,'fix.pack.built.for')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_RUN_DIST</td>
	<td>//div[contains(.,'run.dist')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_ID</td>
	<td>//div[contains(.,'fix.pack.id')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_GIT_REVISION</td>
	<td>//div[contains(.,'git.revision')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_PATCHER_BUILD_ID</td>
	<td>//div[contains(.,'patcher.build.id')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_REQUIREMENTS</td>
	<td>//div[contains(.,'fix.pack.requirements')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_PARAMETERS_FIX_PACK_COMPONENT</td>
	<td>//div[contains(.,'fix.pack.component')]/div[contains(@class,'w80')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ERROR-->
<tr>
	<td>ERROR_HEADER</td>
	<td>//span[contains(.,'Error')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>