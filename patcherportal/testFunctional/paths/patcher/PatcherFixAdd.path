<html>
<head>
<title>PatcherFixAdd</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PatcherFixAdd</td></tr>
</thead>

<tbody>
<tr>
	<td>PRODUCT_VERSION_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherProductVersionId')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_VERSION_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherProjectVersionId')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_FIELD</td>
	<td>//textarea[contains(@id,'osbpatcherportlet_patcherFixName')]</td>
	<td></td>
</tr>
<tr>
	<td>BRANCH_NAME_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_committish')]</td>
	<td></td>
</tr>
<tr>
	<td>GITHUB_URL_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_gitRemoteURL')]</td>
	<td></td>
</tr>
<tr>
	<td>TAG_NAME_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_projectVersionCommittish')]</td>
	<td></td>
</tr>
<tr>
	<td>WORKAROUND_CHECKBOX</td>
	<td>//input[contains(@id,'osbpatcherportlet_workaroundCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//button[contains(.,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ERROR-->

<tr>
	<td>ERROR_HEADER</td>
	<td>//span[contains(.,'Error')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>