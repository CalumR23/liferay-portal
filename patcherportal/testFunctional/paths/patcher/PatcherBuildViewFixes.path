</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>Patcher</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>VIEW_FIXES_IFRAME</td>
