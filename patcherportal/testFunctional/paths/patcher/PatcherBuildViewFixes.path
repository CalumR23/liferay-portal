	<td></td>
</tr>
<tr>
	<td>VIEW_FIXES_FIX_NAME</td>
	<td>//tr[contains(.,'${key_fixName}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_FIXES_FIX_VERSION</td>
	<td>//tr[contains(.,'${key_fixName}')]/td[4]</td>
