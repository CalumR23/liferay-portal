<html>
<head>
<title>PatcherBuildAdd</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PatcherBuildAdd</td></tr>
</thead>

<tbody>
<tr>
	<td>PRODUCT_VERSION_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherProductVersionId')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_VERSION_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_patcherProjectVersionId')]</td>
	<td></td>
</tr>
<tr>
	<td>TICKETS_LIST_FIELD</td>
	<td>//textarea[contains(@id,'osbpatcherportlet_patcherBuildName')]</td>
	<td></td>
</tr>
<tr>
	<td>TROUBLESHOOTING_TICKET_SUGGESTIONS</td>
	<td>//textarea[contains(@id,'osbpatcherportlet_troubleshootingTicketList')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_TROUBLESHOOTING_TICKET_SUGGESTIONS</td>
	<td>//textarea[contains(@id,'osbpatcherportlet_troubleshootingTicketList')]/../div//button</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_CODE_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_patcherBuildAccountEntryCode')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_TICKET_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_supportTicket')]</td>
	<td></td>
</tr>
<tr>
	<td>TYPE_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_type')]</td>
	<td></td>
</tr>
<tr>
	<td>PATCHING_TOOL_SUPPORT_INFO_FILE_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_file')]</td>
	<td></td>
</tr>
<tr>
	<td>MERGE_ONLY_CHECKBOX</td>
	<td>//input[contains(@id,'osbpatcherportlet_mergeOnlyCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>SMOKE_TEST_CHECKBOX</td>
	<td>//input[contains(@id,'osbpatcherportlet_smokeTestOnlyCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//button[contains(.,'Add')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ERROR-->

<tr>
	<td>ERROR_HEADER</td>
	<td>//span[contains(.,'Error')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>