<html>
<head>
<title>PatcherBuildViewChildBuilds</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PatcherBuildViewChildBuilds</td></tr>
</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>Patcher</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_IFRAME</td>
	<td>//iframe[contains(@class,'dialog-iframe-node')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_BUILD_ID</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[1]//a</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_VERSION_NUMBER</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_NAME</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_PROJECT_VERSION</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_PATCHER_STATUS</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_JENKINS</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_JENKINS_SPECIFIC</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[6]/a[contains(.,'${key_jenkinsValue}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CHILD_BUILDS_VIEW_FIXES_LINK</td>
	<td>//tr[contains(.,'${key_childBuildName}')]/td[7]//a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>