<html>
<head>
<title>PatcherFixEditFixPacks</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PatcherFixEditFixPacks</td></tr>
</thead>

<tbody>
<tr>
	<td>EDIT_FIX_PACKS_IFRAME</td>
	<td>//iframe[contains(@class,'dialog-iframe-node')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTENT_FIELD</td>
	<td>//textarea[contains(@id,'osbpatcherportlet_patcherFixName')]</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_STATUS_SELECT</td>
	<td>//select[contains(@id,'osbpatcherportlet_fixPackStatus')]</td>
	<td></td>
</tr>
<tr>
	<td>DEPENDENCIES_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_dependencies')]</td>
	<td></td>
</tr>
<tr>
	<td>RELOAD_AVAILABLE_FIX_PACKS_BUTTON</td>
	<td>//button[contains(.,'Reload Available Fix Packs')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_FIX_PACK</td>
	<td>//select[contains(@id,'osbpatcherportlet_currentPatcherFixPackFields')]/option[contains(.,'${key_fixPackName}')]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_CURRENT_TO_AVAILABLE_BUTTON</td>
	<td>//button[contains(@class,'move-left')]</td>
	<td></td>
</tr>
<tr>
	<td>MOVE_AVAILABLE_TO_CURRENT_BUTTON</td>
	<td>//button[contains(@class,'move-right')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_FIX_PACK</td>
	<td>//select[contains(@id,'osbpatcherportlet_availablePatcherFixPackFields')]/option[contains(.,'${key_fixPackName}')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUIREMENTS_FIELD</td>
	<td>//input[contains(@id,'osbpatcherportlet_requirements')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_BUTTON</td>
	<td>//button[contains(.,'Update')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>