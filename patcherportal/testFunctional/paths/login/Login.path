<html>
<head>
<title>Login</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Login</td></tr>
</thead>

<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[@id='_58_login']</td>
	<td>Email Address Field</td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[@id='_58_password']</td>
	<td>Password Field</td>
</tr>
<tr>
	<td>REMEMBER_ME_CHECKBOX</td>
	<td>//input[@id='_58_rememberMeCheckbox']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//form[contains(@class,'sign-in-form')]//div/button</td>
	<td>Sign In Button</td>
</tr>
<tr>
	<td>ERROR_MESSAGE_1</td>
	<td>xpath=(//div[contains(@class,'alert') and contains(@class,'alert-error')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_2</td>
	<td>xpath=(//div[contains(@class,'alert') and contains(@class,'alert-error')])[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>