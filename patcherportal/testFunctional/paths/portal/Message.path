<html>
<head>
<title>Message</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Message</td></tr>
</thead>

<tbody>
<tr>
	<td>ERROR_MESSAGE_1</td>
	<td>//*[contains(@class,'alert-danger') and contains(.,'${key_errorMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_2</td>
	<td>//*[contains(@class,'portlet-msg-error') and contains(.,'${key_errorMessage}')]</td>
	<td></td>
</tr>
<tr>
	<td>INFO_MESSAGE</td>
	<td>//div[contains(@class,'portlet-msg-info') and contains(.,'${key_message}')] | //div[contains(@class,'alert-info') and contains(.,'${key_message}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[contains(@class,'alert-success')] | //div[contains(@class,'portlet-msg-success')]</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE_CLOSE_BUTTON</td>
	<td>//div[contains(@class,'alert-success')]//button[@class='close']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>