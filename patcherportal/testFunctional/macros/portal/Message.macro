definition {

	macro error {
		var key_errorMessage = "${errorMessage}";

		AssertTextEquals.assertPartialText(
			locator1 = "Message#ERROR_MESSAGE_1",
			value1 = "${errorMessage}");
	}

	macro success {
		if (isSet(message)) {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#SUCCESS_MESSAGE",
				value1 = "${message}");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully.");
		}
	}

}