definition {

	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getTicketId {
		var curl = '''
			${zendeskURL}/api/v2/search.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			-G --data-urlencode "query=type:ticket subject:${subject}"
			''';

		var ticketId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${ticketId}";
	}

	@prose = "I teardown the tickets with ticketIds ${ticketIdList} from zendesk.liferay.com"
	macro _tearDownTicketByIds {
		if (isSet(ticketIdList)) {
			var curl = '''
			${zendeskURL}/api/v2/tickets/destroy_many.json?ids=${ticketIdList} --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "the ticket with the ticketId ${ticketId} should have the comment containing the text ${commentContent}"
	macro _verifyRecentTicketComment {
		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}/comments.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var commentCount = JSONCurlUtil.get("${curl}", "$.count");

		var commentArrayValue = ${commentCount} - 1;

		var commentFromAPI = JSONCurlUtil.get("${curl}", "$.comments[${commentArrayValue}].body");

		var commentFromAPI = StringUtil.replace("${commentFromAPI}", "\"", "");

		if (!(contains("${commentFromAPI}", "${commentContent}"))) {
			fail("Actual comment ${commentFromAPI} as the most recent comment body does not contain the expected comment body content ${commentContent}.");
		}
	}

	@prose = "the ticket with the ticketId ${ticketId} should not have the comment containing the text ${commentContent}"
	macro _verifyNoRecentTicketComment {
		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}/comments.json --tlsv1.2
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var commentCount = JSONCurlUtil.get("${curl}", "$.count");

		var commentsFromAPI = JSONCurlUtil.get("${curl}", "$.comments");

		var commentsFromAPI = StringUtil.replace("${commentsFromAPI}", "\"", "");

		if (contains("${commentsFromAPI}", "${commentContent}")) {
			fail("Actual comment ${commentFromAPI} as the most recent comment body contains the comment body content ${commentContent}.");
		}
	}

}