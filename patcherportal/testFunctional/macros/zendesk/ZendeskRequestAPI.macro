definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	@prose = "I create a request as a user with the email address ${requesterEmail} with the following values ${table}"
	macro _createRequest {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Subject") {
				var subject = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Organization Name") {
				var organizationId = ZendeskOrganizationAPI._getOrganizationId(organizationName = "${value}");
			}
			else if ("${field}" == "Tags") {
				var tags = "${value}";
			}
			else if ("${field}" == "Product") {
				var product = "${value}";
			}
			else if ("${field}" == "Component") {
				var component = "${value}";
			}
			else if ("${field}" == "System Status") {
				var systemStatus = "${value}";
			}
			else {
				fail("No such request field ${field}");
			}
		}

		if (!(isSet(subject))) {
			var subject = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(organizationId))) {
			var organizationId = "";
		}
		if (!(isSet(tags))) {
			var tags = "";
		}
		if (!(isSet(product))) {
			var product = "";
		}
		if (!(isSet(component))) {
			var component = "";
		}
		if (!(isSet(systemStatus))) {
			var systemStatus = "";
		}

		var curl = '''
			${zendeskURL}/api/v2/requests.json --tlsv1.2
			-u ${requesterEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"request":
				{
					"subject": "${subject}",
					"organization_id": "${organizationId}",
					"tags": "${tags}",
					"comment":
					{
						"body": "${description}"
					},
					"custom_fields":
					[
						{
							"id": "360006041192",
							"value": "${product}"
						},
						{
							"id": "360011314571",
							"value": "${component}"
						},
						{
							"id": "360009385592",
							"value": "${systemStatus}"
						}
					]
				}
			}
			''';

		static var requestId = JSONCurlUtil.post("${curl}", "$.request.id");

		echo("Request ID: ${requestId}");

		if (contains("${staticRequestIdList}", "{staticRequestIdList}")) {
			static var staticRequestIdList = "${requestId}";
		}
		else {
			static var staticRequestIdList = "${staticRequestIdList},${requestId}";
		}
		echo("Request ID List: ${staticRequestIdList}");

		return "${staticRequestIdList}";
	}
}