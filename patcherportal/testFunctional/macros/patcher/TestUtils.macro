definition {

	macro assertEquals {
		echo("${expected}");

		echo("${actual}");

		if ("${expected}" == "${actual}") {
			echo("PASSED");
		}
		else {
			TestUtils.fail(message = "FAILED: expected '${expected}', actual was '${actual}'");
		}
	}

	macro assertNotEquals {
		echo("${expected}");

		echo("${actual}");

		if ("${expected}" != "${actual}") {
			echo("PASSED");
		}
		else {
			TestUtils.fail(message = "FAILED: '${expected}' equals '${actual}'");
		}
	}

	macro fail {
		if (!(isSet(message))) {
			var message = "FAIL";
		}

		echo("${message}");

		fail("${message}");
	}

	macro isGreaterThan {
		echo("${expected}");

		echo("${actual}");

		var result = MathUtil.isGreaterThan("${actual}", "${expected}");

		if ("${result}" == "true") {
			echo("PASSED");
		}
		else {
			TestUtils.fail(message = "FAILED: actual '${actual}' is less than or equals to expected '${expected}'");
		}
	}

	macro pass {
		if (!(isSet(message))) {
			var message = "PASS";
		}

		echo("${message}");
	}

}