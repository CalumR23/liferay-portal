definition {

	macro searchAdvanced {
		Click(locator1 = "Patcher#ADVANCED_SEARCH_TOGGLE");

		Patcher.pause(timeInSeconds = "1");

		if ("${match}" == "Any") {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_MATCH_SELECT",
				value1 = "Any");

			Patcher.pause(timeInSeconds = "1");
		}
		else {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_MATCH_SELECT",
				value1 = "All");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(idKeyword) && isSet(idKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_ID_FIELD",
				value1 = "${idKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(fixContentKeyword) && isSet(fixContentKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_FIX_CONTENT_FIELD",
				value1 = "${fixContentKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(buildContentKeyword) && isSet(buildContentKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_BUILD_CONTENT_FIELD",
				value1 = "${buildContentKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(accountCodeKeyword) && isSet(accountCodeKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_BUILD_ACCOUNT_CODE_FIELD",
				value1 = "${accountCodeKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(supportTicketKeyword) && isSet(supportTicketKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_SUPPORT_TICKET_FIELD",
				value1 = "${supportTicketKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(fixPackNameKeyword) && isSet(fixPackNameKeyword)) {
			Type(
				locator1 = "Patcher#ADVANCED_SEARCH_FIX_PACK_NAME_FIELD",
				value1 = "${fixPackNameKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (IsElementPresent(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_FIX_VERSIONS_CHECKBOX")) {
			if ("${hideOldFixVersions}" == "false") {
				Uncheck(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_FIX_VERSIONS_CHECKBOX");

				Patcher.pause(timeInSeconds = "1");
			}
			else {
				Check(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_FIX_VERSIONS_CHECKBOX");

				Patcher.pause(timeInSeconds = "1");
			}
		}

		if (IsElementPresent(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_BUILD_VERSIONS_CHECKBOX")) {
			if ("${hideOldBuildVersions}" == "false") {
				Uncheck(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_BUILD_VERSIONS_CHECKBOX");

				Patcher.pause(timeInSeconds = "1");
			}
			else {
				Check(locator1 = "Patcher#ADVANCED_SEARCH_HIDE_OLD_BUILD_VERSIONS_CHECKBOX");

				Patcher.pause(timeInSeconds = "1");
			}
		}

		if (isSet(statusKeyword) && isSet(statusKeyword)) {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_PATCHER_STATUS_SELECT",
				value1 = "${statusKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(componentKeyword) && isSet(componentKeyword)) {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_COMPONENT_SELECT",
				value1 = "${componentKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(typeKeyword) && isSet(typeKeyword)) {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_TYPE_SELECT",
				value1 = "${typeKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		if (isSet(projectVersionNameKeyword) && isSet(projectVersionNameKeyword)) {
			Select(
				locator1 = "Patcher#ADVANCED_SEARCH_PROJECT_VERSION_SELECT",
				value1 = "${projectVersionNameKeyword}");

			Patcher.pause(timeInSeconds = "1");
		}

		AssertClick(
			locator1 = "Patcher#SEARCH_BUTTON",
			value1 = "Search");
	}

	macro typeKeywordsAndClickSearch {
		Type(
			locator1 = "Patcher#SEARCH_FIELD",
			value1 = "${keyword}");

		Patcher.pause(timeInSeconds = "1");

		AssertClick(
			locator1 = "Patcher#SEARCH_BUTTON",
			value1 = "Search");
	}

}