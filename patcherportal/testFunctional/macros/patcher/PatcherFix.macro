	@prose = "I generate random fix content for the twelfth fix"
	macro generateRandomFixContentForFix12 {
		var randomNumber = MathUtil.randomNumber("100000");

		static var staticFixContent12 = "LPQAL-${randomNumber}";

		return "${staticFixContent12}";
	}

	macro getFirstConflictFixId {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(typeKeyword = "${fixType}");

		var key_fixType = "${fixType}";
		var key_projectVersion = "${projectVersion}";

		if (IsElementPresent(locator1 = "Patcher#PATCHER_CONFLICT_FIX_ID")) {
			var fixId = selenium.getText("Patcher#PATCHER_CONFLICT_FIX_ID");

			return "${fixId}";
		}
		else {
			var fixId = "";

			return "${fixId}";
		}
	}

	macro getFirstUATFixId {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(typeKeyword = "${fixType}");

		var key_fixType = "${fixType}";

		if (IsElementPresent(locator1 = "Patcher#PATCHER_UAT_FIX_ID")) {
			var fixId = selenium.getText("Patcher#PATCHER_UAT_FIX_ID");

			return "${fixId}";
		}
		else {
			var fixId = "";

			return "${fixId}";
		}
	}

	macro getFixId {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(
			fixContentKeyword = "${fixContent}",
			typeKeyword = "${fixType}");

		var key_fixContent = "${fixContent}";

		if (IsElementPresent(locator1 = "Patcher#FIX_ID")) {
			var fixId = selenium.getText("Patcher#FIX_ID");

			return "${fixId}";
		}
		else {
			var fixId = "";

			return "${fixId}";
		}
	}

	@prose = "I incorporate the fix pack ${fixPackName} to the fix ${fixContent}"
	macro incorporateFixPackToFix {
		Patcher.gotoFixes();

		PatcherFix.clickActions(fixContent = "${fixContent}");

		AssertClick(
			locator1 = "Patcher#MENULIST_EDIT_FIX_PACKS",
			value1 = "Edit Fix Packs");

		var key_fixPackName = "${fixPackName}";

		SelectFrame(locator1 = "PatcherFixEditFixPacks#EDIT_FIX_PACKS_IFRAME");

		AssertSelectedLabel(
			locator1 = "PatcherFixEditFixPacks#FIX_PACK_STATUS_SELECT",
			value1 = "Fix Pack Ready");

		AssertClick(
			locator1 = "PatcherFixEditFixPacks#AVAILABLE_FIX_PACK",
			value1 = "${fixPackName}");

		Click(locator1 = "PatcherFixEditFixPacks#MOVE_AVAILABLE_TO_CURRENT_BUTTON");

		AssertTextEquals(
			locator1 = "PatcherFixEditFixPacks#CURRENT_FIX_PACK",
			value1 = "${fixPackName}");

		AssertClick(
			locator1 = "PatcherFixEditFixPacks#UPDATE_BUTTON",
			value1 = "Update");

		SelectFrameTop();

		Message.success();
	}

	@prose = "I tear down all Patcher conflict fixes with the type ${fixType} under the version ${projectVersion}"
	macro tearDownAllConflictFixesForType {
		var conflictFixesForTypeExists1 = "true";
		var conflictFixesForTypeExists2 = "true";

		while (("${conflictFixesForTypeExists1}" == "true") && ("${conflictFixesForTypeExists2}" == "true") && (maxIterations = "200")) {
			var fixId = PatcherFix.getFirstConflictFixId(
				fixType = "${fixType}",
				projectVersion = "${projectVersion}");

			if (isSet(fixId) && ("${fixId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/fixes/${fixId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
			else {
				var conflictFixesForTypeExists1 = "false";
				var conflictFixesForTypeExists2 = "false";
			}
		}
	}

	@prose = "I tear down all Patcher UAT fixes with the type ${fixType}"
	macro tearDownAllUATFixesForType {
		var uatFixesForTypeExists1 = "true";
		var uatFixesForTypeExists2 = "true";

		while (("${uatFixesForTypeExists1}" == "true") && ("${uatFixesForTypeExists2}" == "true") && (maxIterations = "200")) {
			var fixId = PatcherFix.getFirstUATFixId(fixType = "${fixType}");

			if (isSet(fixId) && ("${fixId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/fixes/${fixId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
			else {
				var uatFixesForTypeExists1 = "false";
				var uatFixesForTypeExists2 = "false";
			}
		}
	}

	@prose = "I tear down the Patcher fix containing the content ${fixContent} and type ${fixType}"
	macro tearDownFix {
		if (!(contains("${fixContent}", "{")) && !(contains("${fixContent}", "}")) && ("${fixContent}" != "")) {
			var fixId = PatcherFix.getFixId(
				fixContent = "${fixContent}",
				fixType = "${fixType}");

			if (isSet(fixId) && ("${fixId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/fixes/${fixId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
		}
	}

	@prose = "I update a Patcher fix containing the content ${fixContent} and type ${fixType} with the following values ${table}"
	macro update {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(
			fixContentKeyword = "${fixContent}",
			typeKeyword = "${fixType}");

		var key_fixContent = "${fixContent}";

		while (IsElementNotPresent(locator1 = "Patcher#FIX_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				fixContentKeyword = "${fixContent}",
				typeKeyword = "${fixType}");
		}

		PatcherFix.clickActions(fixContent = "${fixContent}");

		AssertClick(
			locator1 = "Patcher#MENULIST_EDIT",
			value1 = "Edit");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				Select(
					locator1 = "PatcherFixUpdate#PRODUCT_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Version") {
				Select(
					locator1 = "PatcherFixUpdate#PROJECT_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				Type(
					locator1 = "PatcherFixUpdate#CONTENT_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Branch Name") {
				Type(
					locator1 = "PatcherFixUpdate#BRANCH_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Github URL") {
				Type(
					locator1 = "PatcherFixUpdate#GITHUB_URL_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Workaround") {
				if ("${value}" == "true") {
					Check(locator1 = "PatcherFixUpdate#WORKAROUND_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "PatcherFixUpdate#WORKAROUND_CHECKBOX");
				}
			}
			else {
				fail("No such Patcher fix field ${field}");
			}
		}

		AssertClick(
			locator1 = "PatcherFixUpdate#UPDATE_BUTTON",
			value1 = "Update");

		Message.success();
	}

	@prose = "I should be able to view a Patcher fix containing the content ${fixContent} and type ${fixType} with the following values ${table}"
	macro view {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(
			fixContentKeyword = "${fixContent}",
			typeKeyword = "${fixType}");

		var key_fixContent = "${fixContent}";

		while (IsElementNotPresent(locator1 = "Patcher#FIX_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				fixContentKeyword = "${fixContent}",
				typeKeyword = "${fixType}");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Fix ID") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_CONTENT",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_PRODUCT_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Version") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_PROJECT_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Git Hash") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_GIT_HASH",
					value1 = "${value}");
			}
			else if ("${field}" == "Patcher Status") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_PATCHER_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Engineer Comments") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_ENGINEER_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Jenkins") {
				AssertTextEquals.assertPartialText(
					locator1 = "Patcher#FIX_JENKINS",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "Patcher#FIX_TYPE",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher fix field ${field}");
			}
		}
	}

}