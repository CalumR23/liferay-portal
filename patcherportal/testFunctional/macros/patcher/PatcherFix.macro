definition {

	var fixCompletionPollIntervalInSeconds = PropsUtil.get("fix.completion.poll.interval.in.seconds");
	var fixCompletionPollMaximumIterations = PropsUtil.get("fix.completion.poll.maximum.iterations");
	var patcherAdminEmailAddress = PropsUtil.get("patcher.admin.email.address");
	var patcherAdminPassword = PropsUtil.get("patcher.admin.password");
	var portalURL = PropsUtil.get("portal.url");

	@prose = "I check the Patcher fix containing the content ${fixContent} and type ${fixType} for add completion"
	macro checkForAddCompletion {
		Patcher.gotoFixes();

		PatcherSearch.searchAdvanced(
			fixContentKeyword = "${fixContent}",
			typeKeyword = "${fixType}");

		var key_fixContent = "${fixContent}";

		while (IsElementNotPresent(locator1 = "Patcher#FIX_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				fixContentKeyword = "${fixContent}",
				typeKeyword = "${fixType}");
		}

		if (IsElementPresent(locator1 = "Patcher#FIX_PATCHER_STATUS")) {
			var fixPatcherStatus = selenium.getText("Patcher#FIX_PATCHER_STATUS");
		}
		else {
			echo("The fix search result did not show up. The search will be attempted again.");

			var fixPatcherStatus = "";
		}

		var currentIteration = "0";

		while (("${currentIteration}" != "${fixCompletionPollMaximumIterations}") && (("${fixPatcherStatus}" == "Adding") || ("${fixPatcherStatus}" == "")) && (maxIterations = "30")) {
			var currentIteration = ${currentIteration} + 1;

			Patcher.pause(timeInSeconds = "${fixCompletionPollIntervalInSeconds}");

			Patcher.gotoFixes();

			PatcherSearch.searchAdvanced(
				fixContentKeyword = "${fixContent}",
				typeKeyword = "${fixType}");

			var key_fixContent = "${fixContent}";

			while (("${currentIteration}" != "${fixCompletionPollMaximumIterations}") && (IsElementNotPresent(locator1 = "Patcher#FIX_ID")) && (maxIterations = "30")) {
				Refresh();

				PatcherSearch.searchAdvanced(
					fixContentKeyword = "${fixContent}",
					typeKeyword = "${fixType}");
			}

			if (IsElementPresent(locator1 = "Patcher#FIX_PATCHER_STATUS")) {
				var fixPatcherStatus = selenium.getText("Patcher#FIX_PATCHER_STATUS");
			}
			else {
				echo("The fix search result did not show up. If below the maximum iterations, the search will be attempted again.");

				var fixPatcherStatus = "";
			}
		}

		if ("${fixPatcherStatus}" == "Adding") {
			fail("After ${currentIteration} attempts while waiting at ${fixCompletionPollIntervalInSeconds} seconds in between each attempt, the Patcher fix is still in Adding status.");
		}
		else if ("${fixPatcherStatus}" == "Failed") {
			fail("The fix returned a Failed status. Please investigate.");
		}
		else if ("${fixPatcherStatus}" == "") {
			fail("The fix search result did not show up in the final search attempt. The fix may either not be present, it may have completed, or there may be an issue with the search. Please investigate.");
		}
		else {
			echo("Fix status: ${fixPatcherStatus}");
		}
	}

	macro clickActions {
		var key_fixContent = "${fixContent}";

		AssertClick(
			locator1 = "Patcher#FIX_ACTIONS_MENU",
			value1 = "Actions");
	}

	@prose = "I create a Patcher fix with the following values ${table}"
	macro create {
		Patcher.gotoFixes();

		AssertClick(
			locator1 = "Patcher#CREATE_BUTTON",
			value1 = "Create Fix");

		Patcher.pause(timeInSeconds = "1");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				Select(
					locator1 = "PatcherFixAdd#PRODUCT_VERSION_SELECT",
					value1 = "${value}");

				Patcher.pause(timeInSeconds = "1");
			}
			else if ("${field}" == "Project Version") {
				Select(
					locator1 = "PatcherFixAdd#PROJECT_VERSION_SELECT",
					value1 = "${value}");

				Patcher.pause(timeInSeconds = "1");
			}
			else if ("${field}" == "Content") {
				Type(
					locator1 = "PatcherFixAdd#CONTENT_FIELD",
					value1 = "${value}");

				Patcher.pause(timeInSeconds = "1");
			}
			else if ("${field}" == "Branch Name") {
				Type(
					locator1 = "PatcherFixAdd#BRANCH_NAME_FIELD",
					value1 = "${value}");

				Patcher.pause(timeInSeconds = "1");
			}
			else if ("${field}" == "Github URL") {
				Type(
					locator1 = "PatcherFixAdd#GITHUB_URL_FIELD",
					value1 = "${value}");

				Patcher.pause(timeInSeconds = "1");
			}
			else if ("${field}" == "Workaround") {
				if ("${value}" == "true") {
					Check(locator1 = "PatcherFixAdd#WORKAROUND_CHECKBOX");

					Patcher.pause(timeInSeconds = "1");
				}
				else {
					Uncheck(locator1 = "PatcherFixAdd#WORKAROUND_CHECKBOX");

					Patcher.pause(timeInSeconds = "1");
				}
			}
			else {
				fail("No such Patcher fix field ${field}");
			}
		}

		AssertClick(
			locator1 = "PatcherFixAdd#ADD_BUTTON",
			value1 = "Add");

		Message.success();
	}

	@prose = "I generate random fix content"
	macro generateRandomFixContent {
		var randomNumber = MathUtil.randomNumber("100000");

		static var staticFixContent = "LPQA-${randomNumber}";

		return "${staticFixContent}";
	}

	@prose = "I generate random fix content for the first fix"
	macro generateRandomFixContentForFix1 {
		var randomNumber = MathUtil.randomNumber("100000");

		static var staticFixContent1 = "LPQAA-${randomNumber}";

		return "${staticFixContent1}";
	}

	@prose = "I generate random fix content for the second fix"
	macro generateRandomFixContentForFix2 {
