definition {

	macro gotoAccount {
		Patcher.gotoAccounts();

		PatcherAccount.selectAccountFromDropdown(accountCode = "${accountCode}");

		var key_accountCode = "${accountCode}";

		AssertClick(
			locator1 = "Patcher#ACCOUNT_CODE",
			value1 = "${accountCode}");
	}

	macro selectAccountFromDropdown {
		var key_accountCode = "${accountCode}";

		Type(
			locator1 = "Patcher#FIND_ACCOUNT_FIELD",
			value1 = "${accountCode}");

		Click(locator1 = "Patcher#ACCOUNT_CODE_DROPDOWN");
	}

}