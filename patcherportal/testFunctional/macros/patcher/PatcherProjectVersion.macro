definition {
	macro getProjectVersionNameById {
		var curl = '''
			${portalURL}/group/guest/patching/-/osb_patcher/project_versions/${projectVersionId}/view.json
			-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
			''';

		var projectVersionName = JSONCurlUtil.post("${curl}", "$.data.name");

		return "${projectVersionName}";
	}
}