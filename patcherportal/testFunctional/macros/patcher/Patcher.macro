definition {

	var adminEmailAddress = PropsUtil.get("patcher.admin.email.address");
	var adminPassword = PropsUtil.get("patcher.admin.password");
	var portalURL = PropsUtil.get("portal.url");

	@prose = "I generate a random ticket number"
	macro generateRandomTicketNumber {
		static var staticTicketNumber = MathUtil.randomNumber("10000");

		return "${staticTicketNumber}";
	}

	@prose = "I go to Accounts"
	macro gotoAccounts {
		Click(locator1 = "Patcher#ACCOUNTS_TAB");
	}

	@prose = "I go to Fix Components"
	macro gotoFixComponents {
		Click(locator1 = "Patcher#FIX_COMPONENTS_TAB");
	}

	@prose = "I go to Fixes"
	macro gotoFixes {
		Click(locator1 = "Patcher#FIXES_TAB");
	}

	@prose = "I go to Fix Packs"
	macro gotoFixPacks {
		Click(locator1 = "Patcher#FIX_PACKS_TAB");
	}

	@prose = "I log into the Patcher homepage as ${userEmailAddress} with password ${userPassword}"
	macro login {
		Patcher.openURL();

		while (IsElementPresent(locator1 = "Login#SIGN_IN_BUTTON")) {
			Type(
				locator1 = "Login#EMAIL_ADDRESS_FIELD",
				value1 = "${userEmailAddress}");

			Type(
				locator1 = "Login#PASSWORD_FIELD",
				value1 = "${userPassword}");

			Check(locator1 = "Login#REMEMBER_ME_CHECKBOX");

			Click.clickAt(locator1 = "Login#SIGN_IN_BUTTON");
		}
	}

	@prose = "I log into the Patcher homepage as the admin user"
	macro loginAsAdmin {
		Patcher.login(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");
	}

	@prose = "I log out of the Patcher homepage"
	macro logout {
		Open(locator1 = "${portalURL}/c/portal/logout");
	}

	@prose = "I log out and log into the Patcher homepage as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLogin {
		Patcher.logout();

		Patcher.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out and log into the Patcher homepage as the admin user"
	macro logoutAndLoginAsAdmin {
		Patcher.logoutAndLogin(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");
	}

	@prose = "I go to the Patcher homepage"
	macro openURL {
		Open(locator1 = "${portalURL}/group/guest/patching");
	}

	@prose = "I wait for ${timeInSeconds} seconds"
	macro pause {
		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I wait for ${timeInMinutes} minutes"
	macro pauseInMinutes {
		var timeInSeconds = ${timeInMinutes} * 60;

		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I select ${productVersionName} from the product version dropdown"
	macro selectProductVersion {
		Select(
			locator1 = "Patcher#PRODUCT_VERSION_SELECT",
			value1 = "${productVersionName}");
	}

}