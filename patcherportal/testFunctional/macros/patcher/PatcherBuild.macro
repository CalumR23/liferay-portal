	@prose = "I get the security hotfix counter value for a build for the ticket ${supportTicket} on the account ${accountCode} that is built on the version ${projectVersion} on the root ${rootProjectVersion}"
	macro getSecurityHotfixCounterValue {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";
		var hotfixValue = selenium.getText("Patcher#BUILD_HOTFIX");

		var hotfixValue = StringUtil.replace("${hotfixValue}", "liferay-security-${projectVersion}-${supportTicket}-", "");

		var hotfixCounterValue = StringUtil.replace("${hotfixValue}", "-${rootProjectVersion}.zip", "");

		echo("Hotfix Counter Value: ${hotfixCounterValue}");

		static var staticHotfixCounterValue = "${hotfixCounterValue}";

		return "${staticHotfixCounterValue}";
	}

	@prose = "I increase the security hotfix counter value ${hotfixCounterValue} by one"
	macro increaseSecurityHotfixCounterValueByOne {
		var updatedHotfixCounterValue = ${hotfixCounterValue} + 1;

		echo("Updated Hotfix Counter Value: ${updatedHotfixCounterValue}");

		static var staticUpdatedHotfixCounterValue = "${updatedHotfixCounterValue}";

		return "${staticUpdatedHotfixCounterValue}";
	}

