definition {
	var buildCompileCompletionPollIntervalInMinutes = PropsUtil.get("build.compile.completion.poll.interval.in.minutes");
	var buildMergeCompletionPollIntervalInSeconds = PropsUtil.get("build.merge.completion.poll.interval.in.seconds");
	var buildRebaseCompletionPollIntervalInSeconds = PropsUtil.get("build.rebase.completion.poll.interval.in.seconds");
	var buildCompletionPollMaximumIterations = PropsUtil.get("build.completion.poll.maximum.iterations");
	var patcherAdminEmailAddress = PropsUtil.get("patcher.admin.email.address");
	var patcherAdminPassword = PropsUtil.get("patcher.admin.password");
	var portalURL = PropsUtil.get("portal.url");

	@prose = "I check the Patcher build for the ticket ${supportTicket} on the account ${accountCode} for compile completion using the ${jenkinsValue} Jenkins job"
	macro checkForCompileCompletion {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

		var currentIteration = "0";

		var jenkinsJobStatus = "In Progress";

		while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling") && (("${jenkinsJobStatus}" == "In Progress") || ("${jenkinsJobStatus}" == "Jenkins page not loaded") || ("${jenkinsJobStatus}" == "Jenkins link not present"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

			PatcherAccount.gotoAccount(accountCode = "${accountCode}");

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");

			var key_supportTicket = "${supportTicket}";

			while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
				Refresh();

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");
			}

			var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

			var key_jenkinsValue = "${jenkinsValue}";

			if (IsElementPresent(locator1 = "Patcher#BUILD_JENKINS_SPECIFIC")) {
				Click(locator1 = "Patcher#BUILD_JENKINS_SPECIFIC");

				SelectWindow.selectPopUp(locator1 = "null");

				var jenkinsWindowTitle = selenium.getTitle();

				echo("Jenkins Window Title: ${jenkinsWindowTitle}");

				if ("${jenkinsWindowTitle}" == "Problem loading page") {
					var jenkinsJobStatus = "Jenkins page not loaded";
				}
				else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_FAILED")) {
					var jenkinsJobStatus = "Failed";
				}
				else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_SUCCESS")) {
					var jenkinsJobStatus = "Success";
				}
				else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_IN_PROGRESS")) {
					var jenkinsJobStatus = "In Progress";
				}
				else {
					var jenkinsJobStatus = "Other";
				}

				Close.closeWindow(locator1 = "${jenkinsWindowTitle}");

				SelectWindow(locator1 = "null");

				echo("Jenkins Job Status: ${jenkinsJobStatus}");
			}
			else {
				var jenkinsJobStatus = "Jenkins link not present";

				echo("Jenkins Job Status: ${jenkinsJobStatus}");
			}

			echo("Builder Patcher Status: ${buildPatcherStatus}");
		}

		if (("${buildPatcherStatus}" == "Compiling") && (("${jenkinsJobStatus}" == "Failed") || ("${jenkinsJobStatus}" == "Jenkins page not loaded") || ("${jenkinsJobStatus}" == "Jenkins link not present"))) {
			echo("The Patcher build failed to compile after one attempt. Will restart the compile process to assert the failure is not a fluke.");

			PatcherBuild.clickActions(
				accountCode = "${accountCode}",
				supportTicket = "${supportTicket}");

			AssertClick(
				locator1 = "Patcher#MENULIST_BUILD",
				value1 = "Build");

			Message.success();

			PatcherAccount.gotoAccount(accountCode = "${accountCode}");

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");

			var key_supportTicket = "${supportTicket}";

			while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
				Refresh();

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");
			}

			var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

			var currentIteration = "0";

			var jenkinsJobStatus = "In Progress";

			while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling") && (("${jenkinsJobStatus}" == "In Progress") || ("${jenkinsJobStatus}" == "Jenkins page not loaded") || ("${jenkinsJobStatus}" == "Jenkins link not present"))) {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

				PatcherAccount.gotoAccount(accountCode = "${accountCode}");

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");

				var key_supportTicket = "${supportTicket}";

				while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
					Refresh();

					PatcherSearch.searchAdvanced(
						accountCodeKeyword = "${accountCode}",
						supportTicketKeyword = "${supportTicket}");
				}

				var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

				var key_jenkinsValue = "${jenkinsValue}";

				if (IsElementPresent(locator1 = "Patcher#BUILD_JENKINS_SPECIFIC")) {
					Click(locator1 = "Patcher#BUILD_JENKINS_SPECIFIC");

					SelectWindow.selectPopUp(locator1 = "null");

					var jenkinsWindowTitle = selenium.getTitle();

					echo("Jenkins Window Title: ${jenkinsWindowTitle}");

					if ("${jenkinsWindowTitle}" == "Problem loading page") {
						var jenkinsJobStatus = "Jenkins page not loaded";
					}
					else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_FAILED")) {
						var jenkinsJobStatus = "Failed";
					}
					else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_SUCCESS")) {
						var jenkinsJobStatus = "Success";
					}
					else if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_STATUS_IN_PROGRESS")) {
						var jenkinsJobStatus = "In Progress";
					}
					else {
						var jenkinsJobStatus = "Other";
					}

					Close.closeWindow(locator1 = "${jenkinsWindowTitle}");

					SelectWindow(locator1 = "null");

					echo("Jenkins Job Status: ${jenkinsJobStatus}");
				}
				else {
					var jenkinsJobStatus = "Jenkins link not present";

					echo("Jenkins Job Status: ${jenkinsJobStatus}");
				}

				echo("Builder Patcher Status: ${buildPatcherStatus}");
			}

			if (("${buildPatcherStatus}" == "Compiling") && (("${jenkinsJobStatus}" == "Failed") || ("${jenkinsJobStatus}" == "Jenkins page not loaded") || ("${jenkinsJobStatus}" == "Jenkins link not present"))) {
				fail("The Patcher build failed to compile after two attempts. Please investigate.");
			}
			else if (("${buildPatcherStatus}" == "Compiling") && ("${jenkinsJobStatus}" == "Success")) {
				echo("The Patcher build has completed and is currently sending the status file");

				while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling")) {
					var currentIteration = MathUtil.sum("${currentIteration}", "1");

					Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

					PatcherAccount.gotoAccount(accountCode = "${accountCode}");

					PatcherSearch.searchAdvanced(
						accountCodeKeyword = "${accountCode}",
						supportTicketKeyword = "${supportTicket}");

					var key_supportTicket = "${supportTicket}";

					while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
						Refresh();

						PatcherSearch.searchAdvanced(
							accountCodeKeyword = "${accountCode}",
							supportTicketKeyword = "${supportTicket}");
					}

					var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

					echo("Builder Patcher Status: ${buildPatcherStatus}");
				}

				if ("${buildPatcherStatus}" == "Compiling") {
					fail("After ${currentIteration} attempts while waiting at ${buildCompileCompletionPollIntervalInMinutes} minutes in between each attempt, the Patcher build is still in Compiling status despite a successful build completion from Jenkins. This could mean that the Jenkins status file was not sent correctly. Please investigate.");
				}
			}
			else if (("${buildPatcherStatus}" == "Complete") && ("${jenkinsJobStatus}" == "In Progress")) {
				echo("The Patcher Build is returning a complete status but the Jenkins job may still need to finish");

				while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling")) {
					var currentIteration = MathUtil.sum("${currentIteration}", "1");

					Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

					PatcherAccount.gotoAccount(accountCode = "${accountCode}");

					PatcherSearch.searchAdvanced(
						accountCodeKeyword = "${accountCode}",
						supportTicketKeyword = "${supportTicket}");

					var key_supportTicket = "${supportTicket}";

					while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
						Refresh();

						PatcherSearch.searchAdvanced(
							accountCodeKeyword = "${accountCode}",
							supportTicketKeyword = "${supportTicket}");
					}

					var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

					echo("Builder Patcher Status: ${buildPatcherStatus}");
				}
			}
			else if ("${buildPatcherStatus}" == "Compiling") {
				fail("After ${currentIteration} attempts while waiting at ${buildCompileCompletionPollIntervalInMinutes} minutes in between each attempt for the second compile attempt, the Patcher build is still in Compiling status. The Jenkins status is ${jenkinsJobStatus}");
			}
		}
		else if (("${buildPatcherStatus}" == "Compiling") && ("${jenkinsJobStatus}" == "Success")) {
			echo("The Patcher build has completed and is currently sending the status file");

			while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling")) {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

				PatcherAccount.gotoAccount(accountCode = "${accountCode}");

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");

				var key_supportTicket = "${supportTicket}";

				while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
					Refresh();

					PatcherSearch.searchAdvanced(
						accountCodeKeyword = "${accountCode}",
						supportTicketKeyword = "${supportTicket}");
				}

				var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

				echo("Builder Patcher Status: ${buildPatcherStatus}");
			}

			if ("${buildPatcherStatus}" == "Compiling") {
				fail("After ${currentIteration} attempts while waiting at ${buildCompileCompletionPollIntervalInMinutes} minutes in between each attempt, the Patcher build is still in Compiling status despite a successful build completion from Jenkins. This could mean that the Jenkins status file was not sent correctly. Please investigate.");
			}
		}
		else if (("${buildPatcherStatus}" == "Complete") && ("${jenkinsJobStatus}" == "In Progress")) {
			echo("The Patcher Build is returning a complete status but the Jenkins job may still need to finish");

			while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Compiling")) {
				var currentIteration = MathUtil.sum("${currentIteration}", "1");

				Patcher.pauseInMinutes(timeInMinutes = "${buildCompileCompletionPollIntervalInMinutes}");

				PatcherAccount.gotoAccount(accountCode = "${accountCode}");

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");

				var key_supportTicket = "${supportTicket}";

				while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
					Refresh();

					PatcherSearch.searchAdvanced(
						accountCodeKeyword = "${accountCode}",
						supportTicketKeyword = "${supportTicket}");
				}

				var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

				echo("Builder Patcher Status: ${buildPatcherStatus}");
			}
		}
		else if ("${buildPatcherStatus}" == "Compiling") {
			fail("After ${currentIteration} attempts while waiting at ${buildCompileCompletionPollIntervalInMinutes} minutes in between each attempt for the first compile attempt, the Patcher build is still in Compiling status. The Jenkins status is ${jenkinsJobStatus}");
		}
	}

	@prose = "I check the Patcher build for the ticket ${supportTicket} on the account ${accountCode} for merge completion"
	macro checkForMergeCompletion {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Merging")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			Patcher.pause(timeInSeconds = "${buildMergeCompletionPollIntervalInSeconds}");

			PatcherAccount.gotoAccount(accountCode = "${accountCode}");

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");

			var key_supportTicket = "${supportTicket}";

			while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
				Refresh();

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");
			}

			var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");
		}

		if ("${buildPatcherStatus}" == "Merging") {
			fail("After ${currentIteration} attempts while waiting at ${buildMergeCompletionPollIntervalInSeconds} seconds in between each attempt, the Patcher build is still in Merging status.");
		}
	}

	@prose = "I check the Patcher build for the ticket ${supportTicket} on the account ${accountCode} for rebase completion"
	macro checkForRebaseCompletion {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${buildCompletionPollMaximumIterations}")) && ("${buildPatcherStatus}" == "Rebasing")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			Patcher.pause(timeInSeconds = "${buildRebaseCompletionPollIntervalInSeconds}");

			PatcherAccount.gotoAccount(accountCode = "${accountCode}");

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");

			var key_supportTicket = "${supportTicket}";

			while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
				Refresh();

				PatcherSearch.searchAdvanced(
					accountCodeKeyword = "${accountCode}",
					supportTicketKeyword = "${supportTicket}");
			}

			var buildPatcherStatus = selenium.getText("Patcher#BUILD_PATCHER_STATUS");
		}

		if ("${buildPatcherStatus}" == "Rebasing") {
			fail("After ${currentIteration} attempts while waiting at ${buildRebaseCompletionPollIntervalInSeconds} seconds in between each attempt, the Patcher build is still in Rebasing status.");
		}
	}

	macro clickActions {
		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		AssertClick(
			locator1 = "Patcher#BUILD_ACTIONS_MENU",
			value1 = "Actions");
	}

	@prose = "I create a Patcher build for a new account with the following values ${table}"
	macro createForNewAccount {
		Patcher.gotoAccounts();

		AssertClick(
			locator1 = "Patcher#CREATE_BUTTON",
			value1 = "Create Build for New Account");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				Select(
					locator1 = "PatcherBuildAdd#PRODUCT_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Version") {
				Select(
					locator1 = "PatcherBuildAdd#PROJECT_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Tickets List") {
				Type(
					locator1 = "PatcherBuildAdd#TICKETS_LIST_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Account Code") {
				Type(
					locator1 = "PatcherBuildAdd#ACCOUNT_CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Ticket") {
				Type(
					locator1 = "PatcherBuildAdd#SUPPORT_TICKET_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "PatcherBuildAdd#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Merge Only") {
				if ("${value}" == "true") {
					Check(locator1 = "PatcherBuildAdd#MERGE_ONLY_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "PatcherBuildAdd#MERGE_ONLY_CHECKBOX");			
				}
			}
			else if ("${field}" == "Smoke Test Only") {
				if ("${value}" == "true") {
					Check(locator1 = "PatcherBuildAdd#SMOKE_TEST_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "PatcherBuildAdd#SMOKE_TEST_CHECKBOX");			
				}
			}
			else {
				fail("No such Patcher build field ${field}");
			}
		}

		AssertClick(
			locator1 = "PatcherBuildAdd#ADD_BUTTON",
			value1 = "Add");

		Message.success();
	}

	macro editFix {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherBuild.clickActions(
			accountCode = "${accountCode}",
			supportTicket = "${supportTicket}");

		AssertClick(
			locator1 = "Patcher#MENULIST_VIEW_FIXES",
			value1 = "View Fixes");

		SelectFrame(locator1 = "PatcherBuildViewFixes#VIEW_FIXES_IFRAME");

		var key_fixContent = "${fixContent}";

		AssertClick(
			locator1 = "Patcher#FIX_EDIT_LINK",
			value1 = "Edit");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Branch Name") {
				Type(
					locator1 = "PatcherFixUpdate#BRANCH_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Github URL") {
				Type(
					locator1 = "PatcherFixUpdate#GITHUB_URL_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher build edit fix field ${field}");
			}
		}

		AssertClick(
			locator1 = "PatcherFixUpdate#UPDATE_BUTTON",
			value1 = "Update");

		SelectFrameTop();

		Message.success();
	}

	@prose = "I edit a Patcher child build fix with the name ${fixName} for the child build with the name ${childBuildName} for the ticket ${supportTicket} on the account ${accountCode} to have the following values ${table}"
	macro editFixForChildBuild {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherBuild.clickActions(
			accountCode = "${accountCode}",
			supportTicket = "${supportTicket}");

		AssertClick(
			locator1 = "Patcher#MENULIST_VIEW_CHILD_BUILDS",
			value1 = "View Child Builds");

		SelectFrame(locator1 = "PatcherBuildViewChildBuilds#VIEW_CHILD_BUILDS_IFRAME");

		var key_childBuildName = "${childBuildName}";

		AssertClick(
			locator1 = "PatcherBuildViewChildBuilds#VIEW_CHILD_BUILDS_VIEW_FIXES_LINK",
			value1 = "View Fixes");

		var key_fixContent = "${fixName}";

		AssertClick(
			locator1 = "Patcher#FIX_EDIT_LINK",
			value1 = "Edit");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Branch Name") {
				Type(
					locator1 = "PatcherFixUpdate#BRANCH_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Github URL") {
				Type(
					locator1 = "PatcherFixUpdate#GITHUB_URL_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher child build edit fix field ${field}");
			}
		}

		AssertClick(
			locator1 = "PatcherFixUpdate#UPDATE_BUTTON",
			value1 = "Update");

		SelectFrameTop();

		Message.success();
	}

	macro getBuildId {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		if (IsElementPresent(locator1 = "Patcher#BUILD_ID")) {
			var buildId = selenium.getText("Patcher#BUILD_ID");

			return "${buildId}";
		}
		else {
			var buildId = "";

			return "${buildId}";
		}
	}

	@prose = "I release a Patcher build for the ticket ${supportTicket} on the account ${accountCode}"
	macro releaseBuild {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherBuild.clickActions(
			accountCode = "${accountCode}",
			supportTicket = "${supportTicket}");

		AssertClick(
			locator1 = "Patcher#MENULIST_RELEASE",
			value1 = "Release");

		Confirm.assertPartialConfirmation(value1 = "Are you sure you want to release this patch to the customer?");

		Message.success();
	}

	@prose = "I set the account code ${accountCode} as a static variable"
	macro setAccountCodeAsStaticVariable {
		static var staticAccountCode = "${accountCode}";

		return "${staticAccountCode}";
	}

	@prose = "I tear down the Patcher build for the ticket ${supportTicket} on the account ${accountCode}"
	macro tearDownBuild {
		if ((!(contains("${supportTicket}", "{"))) && (!(contains("${supportTicket}", "}"))) && (!("${supportTicket}" == "")) && (!(contains("${accountCode}", "{"))) && (!(contains("${accountCode}", "}"))) && (!("${accountCode}" == ""))) {
			var buildId = PatcherBuild.getBuildId(
				accountCode = "${accountCode}",
				supportTicket = "${supportTicket}");

			if ((!(contains("${buildId}", "{buildId}"))) && (!("${buildId}" == ""))) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/builds/${buildId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
		}
	}

	@prose = "I should be able to view a Patcher build for the ticket ${supportTicket} on the account ${accountCode} with the following values ${table}"
	macro view {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Obsolete") {
				if ("${value}" == "true") {
					AssertElementPresent(locator1 = "Patcher#BUILD_OBSOLETE_ICON");
				}
				else {
					AssertElementNotPresent(locator1 = "Patcher#BUILD_OBSOLETE_ICON");			
				}
			}
			else if ("${field}" == "Build ID") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Ticket") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_SUPPORT_TICKET",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Version") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_PROJECT_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_CONTENT",
					value1 = "${value}");
			}
			else if ("${field}" == "Patcher Status") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_PATCHER_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Jenkins") {
				var key_jenkinsValue = "${value}";

				AssertTextEquals.assertPartialText(
					locator1 = "Patcher#BUILD_JENKINS_SPECIFIC",
					value1 = "${value}");
			}
			else if ("${field}" == "Engineer Comments") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_ENGINEER_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "QA Status") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_QA_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "QA Comments") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_QA_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Hotfix") {
				AssertTextEquals.assertPartialText(
					locator1 = "Patcher#BUILD_HOTFIX",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher build field ${field}");
			}
		}
	}

	@prose = "I should be able to view a Patcher build fix with the name ${fixName} for the ticket ${supportTicket} on the account ${accountCode} with the following values ${table}"
	macro viewBuildFix {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherBuild.clickActions(
			accountCode = "${accountCode}",
			supportTicket = "${supportTicket}");

		AssertClick(
			locator1 = "Patcher#MENULIST_VIEW_FIXES",
			value1 = "View Fixes");

		SelectFrame(locator1 = "PatcherBuildViewFixes#VIEW_FIXES_IFRAME");

		var key_fixName = "${fixName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Fix ID") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Git Hash") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_GIT_HASH",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Engineer Comments") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_ENGINEER_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "PatcherBuildViewFixes#VIEW_FIXES_FIX_TYPE",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher build fix field ${field}");
