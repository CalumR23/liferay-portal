	@prose = "I set the account code ${accountCode} as a static variable"
	macro setAccountCodeAsStaticVariable {
		static var staticAccountCode = "${accountCode}";

		return "${staticAccountCode}";
	}

	@prose = "I tear down all Patcher UAT builds and zendesk tickets on the account ${accountCode}"
	macro tearDownAllUATBuildsAndZendeskTicketsForAccount {
		var uatBuildsForAccountExists = "true";
		var uatTicketsForAccountExists = "true";

		while (("${uatBuildsForAccountExists}" != "false") || ("${uatTicketsForAccountExists}" != "false")) {
			var buildSupportTicket = PatcherBuild.getFirstUATBuildSupportTicket(accountCode = "${accountCode}");

			if (isSet(buildSupportTicket) && ("${buildSupportTicket}" != "")) {
				var curl = '''
					${zendeskURL}/api/v2/tickets/destroy_many.json?ids=${buildSupportTicket} --tlsv1.2
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
			}
			else {
				var uatTicketsForAccountExists = "false";
			}

			var buildId = PatcherBuild.getFirstUATBuildId(accountCode = "${accountCode}");

			if (isSet(buildId) && ("${buildId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/builds/${buildId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
			else {
				var uatBuildsForAccountExists = "false";
			}
		}
	}

	@prose = "I tear down all Patcher UAT builds on the account ${accountCode}"
	macro tearDownAllUATBuildsForAccount {
		var uatBuildsForAccountExists = "true";

		while (("${uatBuildsForAccountExists}" == "true")) {
			var buildId = PatcherBuild.getFirstUATBuildId(accountCode = "${accountCode}");

			if (isSet(buildId) && ("${buildId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/builds/${buildId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
			else {
				var uatBuildsForAccountExists = "false";
			}
		}
	}

	@prose = "I tear down all Patcher UAT conflict builds on the account ${accountCode} under the version ${projectVersion}"
	macro tearDownAllUATConflictBuildsForAccount {
		var uatConflictBuildsForAccountExists = "true";

		while (("${uatConflictBuildsForAccountExists}" == "true")) {
			var buildProjectVersion = PatcherBuild.getFirstUATConflictBuildProjectVersion(accountCode = "${accountCode}");

			if (isSet(buildProjectVersion) && ("${buildProjectVersion}" != "")) {
				if ("${buildProjectVersion}" == "${projectVersion}") {
					var buildId = PatcherBuild.getFirstUATConflictBuildId(accountCode = "${accountCode}");

					var curl = '''
						${portalURL}/group/guest/patching/-/osb_patcher/builds/${buildId}/delete.json
						-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
						''';

					com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
				}
				else {
					var uatConflictBuildsForAccountExists = "false";
				}
			}
			else {
				var uatConflictBuildsForAccountExists = "false";
			}
		}
	}

	@prose = "I tear down the Patcher build for the ticket ${supportTicket} on the account ${accountCode}"
	macro tearDownBuild {
		if (!(contains("${supportTicket}", "{")) && !(contains("${supportTicket}", "}")) && ("${supportTicket}" != "") && !(contains("${accountCode}", "{")) && !(contains("${accountCode}", "}")) && ("${accountCode}" != "")) {
			var buildId = PatcherBuild.getBuildId(
				accountCode = "${accountCode}",
				supportTicket = "${supportTicket}");

			if (isSet(buildId) && ("${buildId}" != "")) {
				var curl = '''
					${portalURL}/group/guest/patching/-/osb_patcher/builds/${buildId}/delete.json
					-u ${patcherAdminEmailAddress}:${patcherAdminPassword}
					''';

				com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
			}
		}
	}

	@prose = "the security hotfix counter value for a build for the ticket ${supportTicket} on the account ${accountCode} that is built on the version ${projectVersion} on the root ${rootProjectVersion} should be ${hotfixCounterValue}"
	macro verifySecurityHotfixCounterValue {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";
		var hotfixValue = selenium.getText("Patcher#BUILD_HOTFIX");

		var hotfixValue = StringUtil.replace("${hotfixValue}", "liferay-security-${projectVersion}-${supportTicket}-", "");

		var hotfixCounterValueFromBuild = StringUtil.replace("${hotfixValue}", "-${rootProjectVersion}.zip", "");

		echo("Expected Hotfix Counter Value: ${hotfixCounterValue}");

		echo("Actual Hotfix Counter Value: ${hotfixCounterValueFromBuild}");

		if ("${hotfixCounterValue}" != "${hotfixCounterValueFromBuild}") {
			fail("Actual hotfix counter value ${hotfixCounterValueFromBuild} obtained from the web site and the expected hotfix counter value ${hotfixCounterValue} do not match");
		}
	}

	@prose = "I should be able to view a Patcher build for the ticket ${supportTicket} on the account ${accountCode} with the following values ${table}"
	macro view {
		PatcherAccount.gotoAccount(accountCode = "${accountCode}");

		PatcherSearch.searchAdvanced(
			accountCodeKeyword = "${accountCode}",
			supportTicketKeyword = "${supportTicket}");

		var key_supportTicket = "${supportTicket}";

		while (IsElementNotPresent(locator1 = "Patcher#BUILD_ID")) {
			Refresh();

			PatcherSearch.searchAdvanced(
				accountCodeKeyword = "${accountCode}",
				supportTicketKeyword = "${supportTicket}");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Obsolete") {
				if ("${value}" == "true") {
					AssertElementPresent(locator1 = "Patcher#BUILD_OBSOLETE_ICON");
				}
				else {
					AssertElementNotPresent(locator1 = "Patcher#BUILD_OBSOLETE_ICON");
				}
			}
			else if ("${field}" == "Build ID") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_ID",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_TYPE",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Ticket") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_SUPPORT_TICKET",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Project Version") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_PROJECT_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Content") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_CONTENT",
					value1 = "${value}");
			}
			else if ("${field}" == "Patcher Status") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_PATCHER_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Jenkins") {
				var key_jenkinsValue = "${value}";

				AssertTextEquals.assertPartialText(
					locator1 = "Patcher#BUILD_JENKINS_SPECIFIC",
					value1 = "${value}");
			}
			else if ("${field}" == "Engineer Comments") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_ENGINEER_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "QA Status") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_QA_STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "QA Comments") {
				AssertTextEquals(
					locator1 = "Patcher#BUILD_QA_COMMENTS",
					value1 = "${value}");
			}
			else if ("${field}" == "Hotfix") {
				AssertTextEquals.assertPartialText(
					locator1 = "Patcher#BUILD_HOTFIX",
					value1 = "${value}");
			}
			else {
				fail("No such Patcher build field ${field}");
			}
		}
	}

