<html>
<head>
<title>ZendeskRequestView</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ZendeskRequestView</td></tr>
</thead>
<tbody>
<tr>
	<td>REQUEST_SUBJECT</td>
	<td>//h2[@class='request-subject']</td>
	<td></td>
</tr>
<tr>
	<td>MARK_AS_SOLVED_BUTTON</td>
	<td>//a[@data-solve-translation='Mark as solved']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--REQUEST_COMMENT-->
<tr>
	<td>REQUEST_COMMENT_AVATAR</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//img[@alt='Avatar']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_AUTHOR</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//div[@class='comment-author']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_TIMESTAMP</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//time</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_CONTENT</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//div[@class='comment-body']//p</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_ATTACHMENT</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//ul[@class='attachments']/li[contains(.,'${key_attachmentName}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_LARGE_FILE_COMMENT_CONTENT</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//div[@class='comment-body']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_LARGE_FILE_COMMENT_ATTACHMENT</td>
	<td>//ul[@class='comment-list']/li[contains(.,'${key_commentContent}')]//div[@class='comment-body']//a[contains(.,'${key_fileName}')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_FIELD</td>
	<td>//input[@class='comment-show-container']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_COMMENT_FIELD_EXPANDED</td>
	<td>//textarea[@id='request_comment_body']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_CLOSED_COMMENT_MESSAGE</td>
	<td>//div[@class='request-follow-up']</td>
	<td></td>
</tr>
<tr>
	<td>CREATE_FOLLOW_UP_LINK</td>
	<td>//div[@class='request-follow-up']/a</td>
	<td></td>
</tr>
<tr>
	<td>ATTACHMENTS_FIELD</td>
	<td>//input[@type='file']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//input[@value='Submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--REQUEST_DETAILS-->
<tr>
	<td>REQUEST_DETAILS_ID</td>
	<td>//dt[contains(.,'Id')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_STATUS</td>
	<td>//dt[contains(.,'Status')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_REQUESTER</td>
	<td>//dt[contains(.,'Requester')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_CREATED</td>
	<td>//dt[contains(.,'Created')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_LAST_ACTIVITY</td>
	<td>//dt[contains(.,'Last activity')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_ASSIGNED_TO</td>
	<td>//dt[contains(.,'Assigned to')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_ORGANIZATION</td>
	<td>//dt[contains(.,'Organization')]/following-sibling::dd/div[@id='orgNamePlaceholder']</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_PRIORITY</td>
	<td>//dt[contains(.,'Priority')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_PRODUCT</td>
	<td>//dt[contains(.,'Product')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_SUB_STATUS</td>
	<td>//dt[contains(.,'Sub-Status')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_COMPONENT</td>
	<td>//dt[contains(.,'Component')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_SYSTEM_STATUS</td>
	<td>//dt[contains(.,'System Status')]/following-sibling::dd[1]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_DETAILS_ATTACHMENT</td>
	<td>//dt[contains(.,'Attachments')]/following-sibling::dd/ul/li[contains(.,'${key_attachmentName}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LARGE_ATTACHMENT_LINK</td>
	<td>//a[contains(.,'Add large files')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>