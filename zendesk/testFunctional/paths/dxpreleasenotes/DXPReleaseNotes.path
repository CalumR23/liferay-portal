<html>
<head>
<title>DXPReleaseNotes</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">DXPReleaseNotes</td></tr>
</thead>
<tbody>
<tr>
	<td>DXP_RELEASE_NOTES_HEADER</td>
	<td>//h1[contains(.,'Liferay DXP Release Notes')]</td>
	<td></td>
</tr>
<tr>
	<td>DXP_RELEASE_NOTES_SUBTITLE</td>
	<td>//h5[@class='section-subtitle']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_SELECT</td>
	<td>//select[contains(@id,'ReleaseToolPortlet_productVersion')]</td>
	<td></td>
</tr>
<tr>
	<td>FROM_SELECT</td>
	<td>//select[contains(@id,'ReleaseToolPortlet_fromFixPackVersion')]</td>
	<td></td>
</tr>
<tr>
	<td>FROM_SELECT_DISABLED</td>
	<td>//select[contains(@id,'ReleaseToolPortlet_fromFixPackVersion') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>TO_SELECT</td>
	<td>//select[contains(@id,'ReleaseToolPortlet_toFixPackVersion')]</td>
	<td></td>
</tr>
<tr>
	<td>TO_SELECT_DISABLED</td>
	<td>//select[contains(@id,'ReleaseToolPortlet_toFixPackVersion') and @disabled]</td>
	<td></td>
</tr>
<tr>
	<td>GET_LATEST_FIX_PACK_LINK</td>
	<td>//a[contains(.,'Get ${key_fixPackName}')]</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHTS_TAB</td>
	<td>//li[contains(@class,'tab') and @data-tab-name='highlights']/a</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHTS_TAB_ACTIVE</td>
	<td>//li[contains(@class,'tab active') and @data-tab-name='highlights']/a</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_TAB</td>
	<td>//li[contains(@class,'tab') and @data-tab-name='changelog']/a</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_TAB_ACTIVE</td>
	<td>//li[contains(@class,'tab active') and @data-tab-name='changelog']/a</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGES_TAB</td>
	<td>//li[contains(@class,'tab') and @data-tab-name='module-changes']/a</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGES_TAB_ACTIVE</td>
	<td>//li[contains(@class,'tab active') and @data-tab-name='module-changes']/a</td>
	<td></td>
</tr>
<tr>
	<td>RESULTS_COUNT</td>
	<td>//div[contains(@class,'results-count')]</td>
	<td></td>
</tr>
<tr>
	<td>REFINE_BY_TEXT_FIELD</td>
	<td>//input[@class='input-small text-filter']</td>
	<td></td>
</tr>
<tr>
	<td>REFINE_BY_CHECKBOX</td>
	<td>//input[@name='${key_filterName}']</td>
	<td></td>
</tr>
<tr>
	<td>REFINE_BY_SEE_MORE_LINK</td>
	<td>//div[@class='more-options']/button</td>
	<td></td>
</tr>
<tr>
	<td>REFINE_BY_TOGGLE_SWITCH</td>
	<td>//span[@class='toggle-switch-bar']</td>
	<td></td>
</tr>
<tr>
	<td>REFINE_BY_CLEAR_ALL_LINK</td>
	<td>//button[contains(.,'Clear All')]</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHTS_HEADER</td>
	<td>//h2[@id='highlights']</td>
	<td></td>
</tr>
<tr>
	<td>HIGHLIGHTS_SUBTITLE</td>
	<td>//h5[@class='secondary-text-color section-subtitle']</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_HEADER</td>
	<td>//h2[@id='changelog']</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGES_HEADER</td>
	<td>//h2[@id='module-version-changes']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--HIGHLIGHTS_RESULTS-->
<tr>
	<td>RELEASED_COLUMN_LABEL</td>
	<td>//th[@class='lfr-released-column']</td>
	<td></td>
</tr>
<tr>
	<td>RELEASED_COLUMN_ASCENDING_ORDER_ARROW</td>
	<td>//th[@class='lfr-released-column']/*[local-name()='svg' and contains(@class,'asc')]</td>
	<td></td>
</tr>
<tr>
	<td>RELEASED_COLUMN_DESCENDING_ORDER_ARROW</td>
	<td>//th[@class='lfr-released-column']/*[local-name()='svg' and contains(@class,'desc')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_COLUMN_LABEL</td>
	<td>//th[@class='lfr-details-column']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_DATE</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/parent::td/parent::tr/td[contains(@class,'lfr-released-column')]</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_HEADER</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_HEADER_POSITION</td>
	<td>xpath=(//div[@class='fix-pack-details']/h3[@class='fix-pack-version'])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_PRODUCT_NAME</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='fix-pack-details']/span[contains(@class,'secondary-text')]</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KEY_HIGHLIGHTS</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='key-highlights']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KEY_HIGHLIGHTS_HEADER</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='key-highlights']/h4[@class='detail-title']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KEY_HIGHLIGHTS_DETAILS</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='key-highlights']/div[@class='detail-body']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_IMPORTANT_CHANGES</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='important-changes']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_IMPORTANT_CHANGES_HEADER</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='important-changes']/h4[@class='detail-title']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_IMPORTANT_CHANGES_DETAILS</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='important-changes']/div[@class='detail-body']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KNOWN_ISSUES</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='known-issues']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KNOWN_ISSUES_HEADER</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='known-issues']/h4[@class='detail-title']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_KNOWN_ISSUES_DETAILS</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='known-issues']/div[@class='detail-body']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_SECURITY</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='security']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_SECURITY_HEADER</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='security']/h4[@class='detail-title']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_SECURITY_DETAILS</td>
	<td>//div[@class='fix-pack-details']/h3[@class='fix-pack-version' and contains(.,'${key_fixPackName}')]/parent::div/parent::div/div[@class='security']/div[@class='detail-body']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CHANGELOG_RESULTS-->
<tr>
	<td>SUMMARY_COLUMN_LABEL</td>
	<td>//th[@class='lfr-summary-column']</td>
	<td></td>
</tr>
<tr>
	<td>RELEASE_COLUMN_LABEL</td>
	<td>//th[@class='lfr-release-column']</td>
	<td></td>
</tr>
<tr>
	<td>RELEASE_COLUMN_ASCENDING_ORDER_ARROW</td>
	<td>//th[@class='lfr-release-column']/*[local-name()='svg' and contains(@class,'asc')]</td>
	<td></td>
</tr>
<tr>
	<td>RELEASE_COLUMN_DESCENDING_ORDER_ARROW</td>
	<td>//th[@class='lfr-release-column']/*[local-name()='svg' and contains(@class,'desc')]</td>
	<td></td>
</tr>
<tr>
	<td>KEY_COLUMN_LABEL</td>
	<td>//th[@class='lfr-key-column']</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_SUMMARY</td>
	<td>//tr[contains(.,'${key_summary}')]/td[contains(@class,'lfr-summary-column')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_SUMMARY_POSITION</td>
	<td>xpath=(//tr/td[contains(@class,'lfr-summary-column')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_COMPONENT</td>
	<td>//tr[contains(.,'${key_summary}')]/td[contains(@class,'lfr-component-column')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_RELEASE</td>
	<td>//tr[contains(.,'${key_summary}')]/td[contains(@class,'lfr-release-column')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_KEY</td>
	<td>//tr[contains(.,'${key_summary}')]/td[contains(@class,'lfr-key-column')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MODULE_VERSION_CHANGES_RESULTS-->
<tr>
	<td>NAME_COLUMN_LABEL</td>
	<td>//th[contains(@class,'lfr-name-column')]</td>
	<td></td>
</tr>
<tr>
	<td>GROUP_COLUMN_LABEL</td>
	<td>//th[@class='lfr-group-column']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_FROM_COLUMN_LABEL</td>
	<td>//th[@class='lfr-from-version-column']</td>
	<td></td>
</tr>
<tr>
	<td>FIX_PACK_TO_COLUMN_LABEL</td>
	<td>//th[@class='lfr-to-version-column']</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_UNCHANGED_ROW</td>
	<td>//tr[@class='journal-article-row ']</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_CHANGE_LABEL</td>
	<td>//tr[contains(@class,'module-changed') and contains(.,'${key_name}')]</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_NAME</td>
	<td>//tr[contains(.,'${key_name}')]/td[contains(@class,'lfr-name-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_GROUP</td>
	<td>//tr[contains(.,'${key_name}')]/td[contains(@class,'lfr-group-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_FIX_PACK_FROM</td>
	<td>//tr[contains(.,'${key_name}')]/td[contains(@class,'lfr-from-version-column')]</td>
	<td></td>
</tr>
<tr>
	<td>MODULE_CHANGE_FIX_PACK_TO</td>
	<td>//tr[contains(.,'${key_name}')]/td[contains(@class,'lfr-to-version-column')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PAGINATION-->
<tr>
	<td>GO_TO_FIRST_PAGE_LINK</td>
	<td>//button[@aria-label='go to page «']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_PREVIOUS_PAGE_LINK</td>
	<td>//button[@aria-label='go to page ‹']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_PAGE_NUMBER_LINK</td>
	<td>//button[@aria-label='go to page ${key_pageNumber}']</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_PAGE_NUMBER</td>
	<td>//li[@class='pagination-current']/span[@aria-label='current page, page ${key_pageNumber}']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_NEXT_PAGE_LINK</td>
	<td>//button[@aria-label='go to page ›']</td>
	<td></td>
</tr>
<tr>
	<td>GO_TO_LAST_PAGE_LINK</td>
	<td>//button[@aria-label='go to page »']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CHANGELOG_DETAILS-->
<tr>
	<td>CHANGELOG_DETAILS_HEADER</td>
	<td>//div[@class='modal-content']/div[@class='modal-header']/div[@class='modal-title']</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_SUMMARY</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/div[@class='small-title']</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_DESCRIPTION_HEADER</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Description')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_DESCRIPTION_CONTENT</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Description')]/following-sibling::div</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_COMPONENTS_HEADER</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Components')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_RELEASE_HEADER</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Release')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_KEY_HEADER</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Key')]</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_KEY_CONTENT</td>
	<td>//div[@class='modal-body']/div[@class='ticket-detail']/h3[contains(.,'Key')]/following-sibling::a</td>
	<td></td>
</tr>
<tr>
	<td>CHANGELOG_DETAILS_CLOSE_BUTTON</td>
	<td>//div[@class='modal-content']/div[@class='modal-header']/button[@class='close']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>