<html>
<head>
<title>MyWorkflowTasksAsset</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MyWorkflowTasksAsset</td></tr>
</thead>
<tbody>
<tr>
	<td>DROPDOWN_TOGGLE</td>
	<td>//a[contains(@class,'dropdown-toggle')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGN_TO_ME_LINK</td>
	<td>//a[contains(.,'Assign to Me')]</td>
	<td></td>
</tr>
<tr>
	<td>APPROVE_LINK</td>
	<td>//a[contains(.,'Approve')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PROJECT_DIFFERENCE-->
<tr>
	<td>PROJECT_DIFFERENCE_FIELD</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DIFFERENCE_OLD_VALUE</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DIFFERENCE_NEW_VALUE</td>
	<td>//h3[contains(.,'Project Differences')]/following-sibling::table//tr[contains(.,'${key_projectDifferenceField}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>