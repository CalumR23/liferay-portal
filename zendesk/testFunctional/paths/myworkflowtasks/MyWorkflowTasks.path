<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MyWorkflowTasks</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@name,'MyWorkflowTaskPortlet_keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_TO_MY_ROLES_TAB</td>
	<td>//a[@title='Assigned to My Roles']</td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_TO_ME_TAB</td>
	<td>//a[@title='Assigned to Me']</td>
	<td></td>
</tr>
<tr>
	<td>OTHER_ASSIGNEES_TAB</td>
	<td>//a[@title='Other Assignees']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--WORKFLOW_INDEX-->
<tr>
	<td>ASSET_TITLE</td>
	<td>//tr[contains(.,'${key_assetTitle}')]/td[contains(@class,'asset-title')]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>