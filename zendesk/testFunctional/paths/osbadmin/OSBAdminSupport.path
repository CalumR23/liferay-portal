<html>
<head>
<title>OSBAdminSupport</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">OSBAdminSupport</td></tr>
</thead>
<tbody>
<tr>
	<td>SUPPORT_TEAMS_TAB</td>
	<td>//li[contains(@class,'tab')]//a[contains(.,'Teams')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REGIONS_TAB</td>
	<td>//li[contains(@class,'tab')]//a[contains(.,'Support Regions')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_SUPPORT_REGION_BUTTON</td>
	<td>//a[contains(@class,'btn') and text()='Add Support Region']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_ROW_DESCRIPTION</td>
	<td>//tr[contains(.,'${key_name}')]//td[contains(@class,'description') and contains(.,'${key_description}')]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_ROW_TIME_ZONE</td>
	<td>//tr[contains(.,'${key_name}')]//td[contains(@class,'time-zone') and contains(.,'${key_timeZone}')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REGION_NAME_FIELD</td>
	<td>//input[contains(@id,'name')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REGION_DESCRIPTION_FIELD</td>
	<td>//input[contains(@id,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_REGION_TIME_ZONE_SELECT</td>
	<td>//select[contains(@id,'timeZoneId')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>