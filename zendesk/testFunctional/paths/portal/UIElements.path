<html>
<head>
<title>UIElements</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">UIElements</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_BUTTON</td>
	<td>//a[@data-qa-id='descriptiveButton']</td>
	<td></td>
</tr>
<tr>
	<td>ROW_ELLIPSIS</td>
	<td>//*[@data-qa-id='row' and contains(.,'${key_title}')]//a[contains(@id,'menu')]</td>
	<td></td>
</tr>
<tr>
	<td>ELLIPSIS_MENU_ITEM</td>
	<td>//li/a/span[text()='${key_menu_item}']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//*[@data-qa-id='addButton']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_MENU_ITEM</td>
	<td>//li/a[text()='${key_menu_item}']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_CELL</td>
	<td>//td[contains(.,'${key_text}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>