<html>
<head>
<title>UserMenu</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">UserMenu</td></tr>
</thead>
<tbody>
<tr>
	<td>USER_AVATAR_IMAGE</td>
	<td>//div[contains(@class,'nav-user')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_USER_MENU</td>
	<td>//div[contains(@class,'nav-user')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_USER_MENU_OPEN</td>
	<td>//div[contains(@class,'nav-user toggle-menu open')]</td>
	<td></td>
</tr>
<tr>
	<td>MY_PLACES_MENU_ITEM</td>
	<td>//li[@class='my-places']//a[text()='${key_item}']</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_TOGGLE</td>
	<td>//li[contains(@class,'language-toggle')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_LIST_ITEM</td>
	<td>//section[contains(@id,'SiteNavigationLanguagePortlet')]//a[text()='${key_language}']</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_LIST_ITEM_SELECTED</td>
	<td>//section[contains(@id,'SiteNavigationLanguagePortlet')]//span[text()='${key_language}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>