<html>
<head>
<title>Button</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Button</td></tr>
</thead>
<tbody>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//a[contains(@class,'btn') and text()='Cancel']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//button/span[text()='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//button/span[text()='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//button/span[text()='Save']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//button[contains(.,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>SEND_BUTTON</td>
	<td>//button/span[text()='Send']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>