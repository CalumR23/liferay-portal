definition {
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	@prose = "I go to My activities"
	macro gotoMyActivities {
		Click(locator1 = "ZendeskHomepage#USER_MENU_BUTTON");
		Click(locator1 = "ZendeskHomepage#USER_MENU_MY_ACTIVITIES_LINK");
	}

	@prose = "I go to the Submit a ticket form"
	macro gotoSubmitATicket {
		Click(locator1 = "ZendeskHomepage#SUBMIT_A_TICKET_BUTTON");
	}

	@prose = "I go to the zendesk homepage"
	macro gotoHomePage {
		Open(locator1 = "${zendeskURL}");
	}

	@prose = "I log into zendesk as ${userEmailAddress} with password ${userPassword}"
	macro login {
		ZendeskHomepage.gotoHomePage();

		Click(locator1 = "ZendeskHomepage#SIGN_IN_BUTTON");

		SelectFrame(locator1 = "ZendeskSignIn#SIGN_IN_IFRAME");

		Type(
			locator1 = "ZendeskSignIn#EMAIL_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "ZendeskSignIn#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Check(locator1 = "ZendeskSignIn#REMEMBER_ME_CHECKBOX");

		Click(locator1 = "ZendeskSignIn#SIGN_IN_BUTTON");

		SelectFrameTop();
	}

	@prose = "I log out and log into zendesk as ${userEmailAddress} with password ${userPassword}"
	macro logoutAndLogin {
		ZendeskHomepage.logout();

		ZendeskHomepage.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	@prose = "I log out of zendesk"
	macro logout {
		Click(locator1 = "ZendeskHomepage#USER_MENU_BUTTON");
		Click(locator1 = "ZendeskHomepage#USER_MENU_SIGN_OUT_LINK");
	}

	@prose = "the current language should be listed as ${currentLanguage}"
	macro viewCurrentLanguage {
		Click(locator1 = "ZendeskHomepage#PRODUCTS_TAB");
		AssertTextEquals(
			locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_PRODUCTS",
			value1 = "${currentLanguage}");

		Click(locator1 = "ZendeskHomepage#RESOURCES_TAB");
		AssertTextEquals(
			locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_RESOURCES",
			value1 = "${currentLanguage}");

		Click(locator1 = "ZendeskHomepage#SECURITY_TAB");
		AssertTextEquals(
			locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_SECURITY",
			value1 = "${currentLanguage}");

		Click(locator1 = "ZendeskHomepage#SUPPORT_TAB");
		AssertTextEquals(
			locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_SUPPORT",
			value1 = "${currentLanguage}");
	}

	@prose = "I should see the homepage as a customer"
	macro viewHomepageAsCustomer {
		ZendeskHomepage.viewHomepageWithMegaMenuPermissions();
	}

	@prose = "I should see the homepage as a kb user"
	macro viewHomepageAsKBUser {
		ZendeskHomepage.viewHomepageWithoutMegaMenuPermissions();
	}

	@prose = "I should see the homepage as a partner"
	macro viewHomepageAsPartner {
		ZendeskHomepage.viewHomepageWithMegaMenuPermissions();
	}

	@prose = "I should see the homepage as a regular user"
	macro viewHomepageAsRegularUser {
		ZendeskHomepage.viewHomepageWithoutMegaMenuPermissions();
	}

	macro viewHomepageWithMegaMenuPermissions {
		AssertVisible(locator1 = "ZendeskHomepage#HELP_CENTER_LINK");
		AssertVisible(locator1 = "ZendeskHomepage#PRODUCTS_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#RESOURCES_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#SECURITY_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#SUPPORT_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#SEARCH_FIELD");
		AssertVisible(locator1 = "ZendeskHomepage#HOW_CAN_WE_HELP_IMAGE");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_71_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#ANALYTICS_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#COMMERCE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_70_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_62_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_61_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_60_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_52_CARD");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SYSTEM_UPDATE_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SECURITY_ALERT_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#FIX_PACK_UPDATE_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#PRODUCT_RELEASE_HEADER");
		AssertVisible(locator1 = "ZendeskHomepage#SUBSCRIBE_BUTTON");
		AssertVisible(locator1 = "ZendeskHomepage#SUBMIT_A_TICKET_BUTTON");
		AssertVisible(locator1 = "ZendeskHomepage#CONTACT_US_BUTTON");
		AssertVisible(locator1 = "ZendeskHomepage#ASK_THE_COMMNUITY_BUTTON");
		AssertVisible(locator1 = "ZendeskHomepage#LIFERAY_UNIVERSITY_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#LIFERAY_GLOBAL_SERVICES_CARD");

		Click(locator1 = "ZendeskHomepage#PRODUCTS_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_DXP_71_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_DXP_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_DXP_70_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_COMMERCE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_ANALYTICS_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PORTAL_62_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PORTAL_61_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PORTAL_60_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUBMIT_A_TICKET_BUTTON_VIA_PRODUCTS");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_CONTACT_US_BUTTON_VIA_PRODUCTS");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_MY_REQUESTS_BUTTON_VIA_PRODUCTS");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PROJECT_DETAILS_BUTTON_VIA_PRODUCTS");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_PRODUCTS");

		Click(locator1 = "ZendeskHomepage#RESOURCES_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_DOWNLOADS_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_KNOWLEDGE_BASE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_DOCUMENTATION_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_ANNOUNCEMENTS_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_ACTIVATION_KEYS_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUBMIT_A_TICKET_BUTTON_VIA_RESOURCES");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_CONTACT_US_BUTTON_VIA_RESOURCES");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_MY_REQUESTS_BUTTON_VIA_RESOURCES");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PROJECT_DETAILS_BUTTON_VIA_RESOURCES");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_RESOURCES");

		Click(locator1 = "ZendeskHomepage#SECURITY_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SECURITY_OVERVIEW_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SECURITY_ADVISORIES_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_REPORTING_SECURITY_ISSUES_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SECURITY_POLICIES_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUBMIT_A_TICKET_BUTTON_VIA_SECURITY");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_CONTACT_US_BUTTON_VIA_SECURITY");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_MY_REQUESTS_BUTTON_VIA_SECURITY");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PROJECT_DETAILS_BUTTON_VIA_SECURITY");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_SECURITY");

		Click(locator1 = "ZendeskHomepage#SUPPORT_TAB");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_COMPATIBILITY_MATRIX_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUPPORT_COVERAGE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SERVICE_LIFE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUPPORT_FAQ_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_FIX_DELIVERY_METHOD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SERVICE_LEVELS_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_SUBMIT_A_TICKET_BUTTON_VIA_SUPPORT");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_CONTACT_US_BUTTON_VIA_SUPPORT");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_MY_REQUESTS_BUTTON_VIA_SUPPORT");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_PROJECT_DETAILS_BUTTON_VIA_SUPPORT");
		AssertVisible(locator1 = "ZendeskHomepage#MEGA_MENU_LANGUAGE_VIA_SUPPORT");
	}

	macro viewHomepageWithoutMegaMenuPermissions {
		AssertVisible(locator1 = "ZendeskHomepage#HELP_CENTER_LINK");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#PRODUCTS_TAB");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#RESOURCES_TAB");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SECURITY_TAB");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SUPPORT_TAB");
		AssertElementPresent(locator1 = "ZendeskHomepage#PRODUCTS_TAB_INVISIBLE");
		AssertElementPresent(locator1 = "ZendeskHomepage#RESOURCES_TAB_INVISIBLE");
		AssertElementPresent(locator1 = "ZendeskHomepage#SECURITY_TAB_INVISIBLE");
		AssertElementPresent(locator1 = "ZendeskHomepage#SUPPORT_TAB_INVISIBLE");
		AssertVisible(locator1 = "ZendeskHomepage#SEARCH_FIELD");
		AssertVisible(locator1 = "ZendeskHomepage#HOW_CAN_WE_HELP_IMAGE");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_71_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#ANALYTICS_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#COMMERCE_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_CLOUD_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#DXP_70_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_62_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_61_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_60_CARD");
		AssertVisible(locator1 = "ZendeskHomepage#PORTAL_52_CARD");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SYSTEM_UPDATE_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SECURITY_ALERT_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#FIX_PACK_UPDATE_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#PRODUCT_RELEASE_HEADER");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SUBSCRIBE_BUTTON");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SUBMIT_A_TICKET_BUTTON");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#CONTACT_US_BUTTON");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#ASK_THE_COMMNUITY_BUTTON");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#LIFERAY_UNIVERSITY_CARD");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#LIFERAY_GLOBAL_SERVICES_CARD");
	}

	@prose = "I should not see the Submit a ticket link"
	macro viewNoSubmitATicketLink {
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SUBMIT_A_TICKET_BUTTON");
	}

	@prose = "I should see the user dropdown button"
	macro viewLoggedIn {
		AssertElementPresent(locator1 = "ZendeskHomepage#USER_MENU_BUTTON");
		AssertElementNotPresent(locator1 = "ZendeskHomepage#SIGN_IN_BUTTON");
	}
}