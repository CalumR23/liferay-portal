definition {
	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I add an order with the product ${product} and support level ${support} to the project code ${projectCode}"
	macro addOrder {
		OSBAdmin.gotoOSBAdminSalesOrders();

		Click(locator1 = "OSBAdminSalesOrders#ADD_ORDER_BUTTON");

		Click(locator1 = "OSBAdminSalesOrderAdd#PROJECT_SELECT_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");

		var key_code = "${projectCode}";

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");

		SelectWindow(locator1 = "null");

		Click(locator1 = "OSBAdminSalesOrderAdd#ADD_OFFERING_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		Select(
			locator1 = "OSBAdminSalesOfferings#PRODUCT_SELECT",
			value1 = "${product}");

		Select(
			locator1 = "OSBAdminSalesOfferings#SUPPORT_SELECT",
			value1 = "${support}");

		Button.search();

		ClickNoError(locator1 = "OSBAdminSalesOfferings#SEARCH_RESULT_FIRST_ROW_PRODUCT");

		SelectWindow(locator1 = "null");

		Button.save();

		Message.success();
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have a support lifetime of ${supportLifetime} starting ${numDays} days from now for the product ${product}"
	macro editSupportLifetimeToFutureStartDate {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var day = DateUtil.getDate("${numDays}");
		var month = DateUtil.getMonth("${numDays}");
		var year = DateUtil.getYear("${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have a support lifetime of ${supportLifetime} starting ${numDays} days ago for the product ${product}"
	macro editSupportLifetimeToPastStartDate {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var day = DateUtil.getDate("-${numDays}");
		var month = DateUtil.getMonth("-${numDays}");
		var year = DateUtil.getYear("-${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} to have a support lifetime of ${supportLifetime} starting ${numDays} days ago for the product ${product}"
	macro editSupportLifetimeToPastStartDateViaProjectNameOnly {
		OSBAdminSales.gotoOrderDetailsViaProjectName(
			project = "${project}",
			projectName = "${project}");

		var day = DateUtil.getDate("-${numDays}");
		var month = DateUtil.getMonth("-${numDays}");
		var year = DateUtil.getYear("-${numDays}");

		var startDate = "${month}/${day}/${year}";

		Type(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "${startDate}");

		KeyPress(
			locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD",
			value1 = "\TAB");

		Click(locator1 = "OSBAdminSalesOrderDetail#START_DATE_FIELD");

		Click(locator1 = "OSBAdminSalesOrderDetail#RENEWED_COUNT");

		var key_product = "${product}";

		Select(
			locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_LIFETIME_SELECT",
			value1 = "${supportLifetime}");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to have support tickets for the product ${product}"
	macro editSupportTicketsFlagged {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var key_product = "${product}";

		Check(locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_TICKETS_CHECKBOX");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	@prose = "I edit a project with the name ${project} and code ${projectCode} to not have support tickets for the product ${product}"
	macro editSupportTicketsUnflagged {
		OSBAdminSales.gotoOrderDetails(
			project = "${project}",
			projectCode = "${projectCode}");

		var key_product = "${product}";

		Uncheck(locator1 = "OSBAdminSalesOrderDetail#RESULT_ROW_SUPPORT_TICKETS_CHECKBOX");

		Button.save();

		Message.success();

		OSBAdmin.pause(timeInSeconds = "10");
	}

	macro gotoOrderDetails {
		OSBAdminSearch.searchAdvancedOrders(projectCode = "${projectCode}");

		var key_project = "${project}";

		Click(locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT");
	}

	macro gotoOrderDetailsViaProjectName {
		OSBAdminSearch.searchAdvancedOrdersViaProjectName(projectName = "${projectName}");

		var key_project = "${project}";

		Click(locator1 = "OSBAdminSalesOrders#SEARCH_RESULT_PROJECT");
	}
}