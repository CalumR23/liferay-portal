definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	macro createDXPProjectMessage {
		var message = '''
		{
			"_account": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_industry": "${industry}",
				"_name": "${accountName}"
			},
			"_billingAddress": {
				"_city": "Diamond Bar",
				"_country": "United States",
				"_dossieraAddressKey": "${dossieraAddressKey1}",
				"_postalCode": "91765",
				"_region": "California",
				"_street": "456 Fake Street",
				"_type": "Shipping"
			},
			"_bundledProducts": [
				{
					"_currencyIsoCode": "USD",
					"_endDay": ${endDay},
					"_endMonth": ${endMonth},
					"_endYear": ${endYear},
					"_name": "Liferay DXP Subscription - Platinum Prod Sizing 1",
					"_purchasedProducts": [
						{
							"_dossieraPurchasedProductKey": "25115912",
							"_endDay": ${endDay},
							"_endMonth": ${endMonth},
							"_endYear": ${endYear},
							"_environment": "Production",
							"_name": "Liferay Digital Enterprise - Prod Sizing 1",
							"_productType": "New",
							"_quantity": 1,
							"_sizing": "Sizing 1",
							"_startDay": ${startDay},
							"_startMonth": ${startMonth},
							"_startYear": ${startYear}
						},
						{
							"_dossieraPurchasedProductKey": "25116158",
							"_endDay": ${endDay},
							"_endMonth": ${endMonth},
							"_endYear": ${endYear},
							"_name": "Platinum Support",
							"_productType": "New",
							"_startDay": ${startDay},
							"_startMonth": ${startMonth},
							"_startYear": ${startYear}
						}
					],
					"_quantity": 1,
					"_salesforceOpportunityLineItemKey": "${salesforceOpportunityLineItemKey1}",
					"_startDay": ${startDay},
					"_startMonth": ${startMonth},
					"_startYear": ${startYear},
					"_totalPrice": 33000.0
				}
			],
			"_contacts": [
				{
					"_dossieraContactKey": "${dossieraContactKey}",
					"_emailAddress": "amos.fong@liferay.com.broken",
					"_firstName": "Amos",
					"_lastName": "Fong",
					"_role": "Support Contact Manager"
				}
			],
			"_owner": {
				"_emailAddress": "amos.fong@liferay.com.broken",
				"_firstName": "Amos",
				"_lastName": "Fong"
			},
			"_partnerAccount": {
				"_industry": "Professional Services (Technical/Web/IT)",
				"_name": "Zen OSB Partner",
				"_partnerships":[
					{
						"_level": "Platinum",
						"_type": "Service Partner",
						"_territory": "United States"
					}
				],
				"_dossieraAccountKey": "abcdefgh1234567890",
				"_description": "First Line Support"
			},
			"_partnerFirstLineSupport": ${partnerFirstLineSupport},
			"_project": {
				"_dossieraAccountKey": "${dossieraAccountKey}",
				"_dossieraProjectKey": "${dossieraProjectKey}",
				"_liferayVersion": "DXP ${versionNumber}",
				"_name": "${projectName}"
			},
			"_renewal": false,
			"_salesforceAccountKey": "${dossieraAccountKey}",
			"_salesforceOpportunityKey": "${salesforceOpportunityKey}",
			"_salesforceOpportunityProductFamily": "S",
			"_salesforceOpportunitySoldBy": "Liferay US",
			"_salesforceOpportunityStageName": "Closed Won",
			"_salesforceOpportunityTerritory": "United States",
			"_salesforceOpportunityType": "New Business",
			"_salesforceOwnerUserKey": "${salesforceOwnerUserKey}",
			"_salesforceProjectKey": "${salesforceProjectKey}",
			"_shippingAddress": {
				"_city": "Diamond Bar",
				"_country": "United States",
				"_dossieraAddressKey": "${dossieraAddressKey2}",
				"_postalCode": "91765",
				"_region": "California",
				"_street": "456 Fake Street",
				"_type": "Billing"
			}
		}
		''';

		echo("${message}");

		return "${message}";
	}

	@prose = "I generate several static variables for Provisioning"
	macro generateStaticVariables {
		static var staticDossieraAccountKey = StringUtil.randomString("18");
		static var staticDossieraAddressKey1 = MathUtil.randomNumber("30000000");
		static var staticDossieraAddressKey2 = MathUtil.randomNumber("30000000");
		static var staticDossieraContactKey = MathUtil.randomNumber("30000000");
		static var staticDossieraProjectKey = MathUtil.randomNumber("30000000");
		static var staticSalesforceOpportunityKey = StringUtil.randomString("18");
		static var staticSalesforceOpportunityLineItemKey1 = StringUtil.randomString("18");
		static var staticSalesforceOpportunityLineItemKey2 = StringUtil.randomString("18");
		static var staticSalesforceOwnerUserKey = StringUtil.randomString("18");
		static var staticSalesforceProjectKey = StringUtil.randomString("18");

		static var staticStartDay = DateUtil.getDate("0");
		static var staticStartMonth = DateUtil.getMonth("0");
		static var staticStartYear = DateUtil.getYear("0");

		static var staticEndDay = DateUtil.getDate("335");
		static var staticEndMonth = DateUtil.getMonth("335");
		static var staticEndYear = DateUtil.getYear("335");

		return "${staticDossieraAccountKey}";
		return "${staticDossieraAddressKey1}";
		return "${staticDossieraAddressKey2}";
		return "${staticDossieraContactKey}";
		return "${staticDossieraProjectKey}";
		return "${staticSalesforceOpportunityKey}";
		return "${staticSalesforceOpportunityLineItemKey1}";
		return "${staticSalesforceOpportunityLineItemKey2}";
		return "${staticSalesforceOwnerUserKey}";
		return "${staticSalesforceProjectKey}";

		return "${staticStartDay}";
		return "${staticStartMonth}";
		return "${staticStartYear}";

		return "${staticEndDay}";
		return "${staticEndMonth}";
		return "${staticEndYear}";
	}

	@prose = "I go to the RabbitMQ section of OSB Admin"
	macro gotoRabbitMQ {
		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=1_WAR_osbportlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_1_WAR_osbportlet_mvcPath=%2Fadmin%2Fview.jsp&_1_WAR_osbportlet_tabs1=tools&_1_WAR_osbportlet_tabs3=rabbitmq");
	}

	@prose = "I publish a RabbitMQ message with routing key ${routingKey} that creates a DXP project with the following values ${table}"
	macro publishCreateDXPProjectMessage {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Account Name") {
				var accountName = "${value}";
			}
			else if ("${field}" == "Dossiera Account Key") {
				var dossieraAccountKey = "${value}";
			}
			else if ("${field}" == "Dossiera Address Key 1") {
				var dossieraAddressKey1 = "${value}";
			}
			else if ("${field}" == "Dossiera Address Key 2") {
				var dossieraAddressKey2 = "${value}";
			}
			else if ("${field}" == "Dossiera Contact Key") {
				var dossieraContactKey = "${value}";
			}
			else if ("${field}" == "Dossiera Project Key") {
				var dossieraProjectKey = "${value}";
			}
			else if ("${field}" == "End Day") {
				var endDay = "${value}";
			}
			else if ("${field}" == "End Month") {
				var endMonth = "${value}";
			}
			else if ("${field}" == "End Year") {
				var endYear = "${value}";
			}
			else if ("${field}" == "Industry") {
				var industry = "${value}";
			}
			else if ("${field}" == "Partner First Line Support") {
				var partnerFirstLineSupport = "${value}";
			}
			else if ("${field}" == "Project Name") {
				var projectName = "${value}";
			}
			else if ("${field}" == "Salesforce Opportunity Key") {
				var salesforceOpportunityKey = "${value}";
			}
			else if ("${field}" == "Salesforce Opportunity Line Item Key 1") {
				var salesforceOpportunityLineItemKey1 = "${value}";
			}
			else if ("${field}" == "Salesforce Opportunity Line Item Key 2") {
				var salesforceOpportunityLineItemKey2 = "${value}";
			}
			else if ("${field}" == "Salesforce Owner User Key") {
				var salesforceOwnerUserKey = "${value}";
			}
			else if ("${field}" == "Salesforce Project Key") {
				var salesforceProjectKey = "${value}";
			}
			else if ("${field}" == "Start Day") {
				var startDay = "${value}";
			}
			else if ("${field}" == "Start Month") {
				var startMonth = "${value}";
			}
			else if ("${field}" == "Start Year") {
				var startYear = "${value}";
			}
			else if ("${field}" == "Version Number") {
				var versionNumber = "${value}";
			}
			else {
				fail("No such project field ${field}");
			}
		}

		if (!(isSet(industry))) {
			var industry = "";
		}
		if (!(isSet(accountName))) {
			var accountName = "";
		}
		if (!(isSet(dossieraAccountKey))) {
			var dossieraAccountKey = "";
		}
		if (!(isSet(dossieraAddressKey1))) {
			var dossieraAddressKey1 = "";
		}
		if (!(isSet(dossieraAddressKey2))) {
			var dossieraAddressKey2 = "";
		}
		if (!(isSet(dossieraContactKey))) {
			var dossieraContactKey = "";
		}
		if (!(isSet(dossieraProjectKey))) {
			var dossieraProjectKey = "";
		}
		if (!(isSet(endDay))) {
			var endDay = "";
		}
		if (!(isSet(endMonth))) {
			var endMonth = "";
		}
		if (!(isSet(endYear))) {
			var endYear = "";
		}
		if (!(isSet(partnerFirstLineSupport))) {
			var partnerFirstLineSupport = "false";
		}
		if (!(isSet(projectName))) {
			var projectName = "";
		}
		if (!(isSet(salesforceOpportunityKey))) {
			var salesforceOpportunityKey = "";
		}
		if (!(isSet(salesforceOpportunityLineItemKey1))) {
			var salesforceOpportunityLineItemKey1 = "";
		}
		if (!(isSet(salesforceOpportunityLineItemKey2))) {
			var salesforceOpportunityLineItemKey2 = "";
		}
		if (!(isSet(salesforceOwnerUserKey))) {
			var salesforceOwnerUserKey = "";
		}
		if (!(isSet(salesforceProjectKey))) {
			var salesforceProjectKey = "";
		}
		if (!(isSet(startDay))) {
			var startDay = "";
		}
		if (!(isSet(startMonth))) {
			var startMonth = "";
		}
		if (!(isSet(startYear))) {
			var startYear = "";
		}
		if (!(isSet(versionNumber))) {
			var versionNumber = "";
		}

		var message = OSBAdminRabbitMQ.createDXPProjectMessage(
			accountName = "${accountName}",
			dossieraAccountKey = "${dossieraAccountKey}",
			dossieraAddressKey1 = "${dossieraAddressKey1}",
			dossieraAddressKey2 = "${dossieraAddressKey2}",
			dossieraContactKey = "${dossieraContactKey}",
			dossieraProjectKey = "${dossieraProjectKey}",
			endDay = "${endDay}",
			endMonth = "${endMonth}",
			endYear = "${endYear}",
			industry = "${industry}",
			partnerFirstLineSupport = "${partnerFirstLineSupport}",
			projectName = "${projectName}",
			salesforceOpportunityKey = "${salesforceOpportunityKey}",
			salesforceOpportunityLineItemKey1 = "${salesforceOpportunityLineItemKey1}",
			salesforceOpportunityLineItemKey2 = "${salesforceOpportunityLineItemKey2}",
			salesforceOwnerUserKey = "${salesforceOwnerUserKey}",
			salesforceProjectKey = "${salesforceProjectKey}",
			startDay = "${startDay}",
			startMonth = "${startMonth}",
			startYear = "${startYear}",
			versionNumber = "${versionNumber}");

		Type(
			locator1 = "OSBAdminRabbitMQ#ROUTING_KEY_FIELD",
			value1 = "${routingKey}");

		Type(
			locator1 = "OSBAdminRabbitMQ#MESSAGE_FIELD",
			value1 = "${message}");

		Click(locator1 = "OSBAdminRabbitMQ#SUBMIT_BUTTON");

		Message.success();
	}
}