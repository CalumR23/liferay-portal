definition {
	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("customer.liferay.url");

	macro searchBasic {
		OSBAdminSearch.toggleSearch(searchType = "Basic");

		Type(
			locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
			value1 = "${keyword}");

		if (IsVisible(locator1 = "Button#SEARCH_BUTTON")) {
			Button.search();
		}
		else {
			KeyPress(
				locator1 = "OSBAdmin#BASIC_SEARCH_KEYWORD_FIELD",
				value1 = "\RETURN");
		}
	}

	macro searchBasicProject {
		OSBAdmin.gotoOSBAdmin();

		Click(locator1 = "OSBAdmin#PROJECTS_TAB");

		OSBAdminSearch.searchBasic(keyword = "${projectCode}");
	}

	macro toggleSearch {
		if ("${searchType}" == "Basic") {
			if (IsElementPresent(locator1 = "OSBAdmin#ADVANCED_SEARCH_EXPANDED")) {
				Click(locator1 = "OSBAdmin#SEARCH_TOGGLE_CARET");
			}
		}
		else {
			if (IsElementNotPresent(locator1 = "OSBAdmin#ADVANCED_SEARCH_EXPANDED")) {
				Click(locator1 = "OSBAdmin#SEARCH_TOGGLE_CARET");
			}
		}
	}
}