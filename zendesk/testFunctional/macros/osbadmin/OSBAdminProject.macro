definition {
	var popupTitle = PropsUtil.get("osb.admin.popup.title");
	var supportURL = PropsUtil.get("support.liferay.url");

	macro addSupportLanguage {
		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_LANGUAGES_TAB");
		Click(locator1 = "OSBAdminProjectAdd#ADD_SUPPORT_LANGUAGE_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		var key_item = "${language}";

		ClickNoError(locator1 = "OSBAdminProjectAddSupport#TABLE_ROW");

		SelectWindow(locator1 = "null");
	}

	macro addSupportRegion {
		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_REGIONS_TAB");
		Click(locator1 = "OSBAdminProjectAdd#ADD_SUPPORT_REGION_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		var key_item = "${region}";

		ClickNoError(locator1 = "OSBAdminProjectAddSupport#TABLE_ROW");

		SelectWindow(locator1 = "null");
	}

	@prose = "I assign a user the email address ${emailAddress} as a customer with the role ${role} to the project with the code ${projectCode}"
	macro assignCustomer {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		Type(
			locator1 = "OSBAdminProjectAssignCustomer#EMAIL_ADDRESS_FIELD",
			value1 = "${emailAddress}");

		OSBAdmin.pause(timeInSeconds = "2");

		Select(
			locator1 = "OSBAdminProjectAssignCustomer#ROLE_SELECT",
			value1 = "${role}");

		OSBAdmin.pause(timeInSeconds = "2");

		ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#ADD_BUTTON");

		OSBAdmin.pause(timeInSeconds = "2");

		var key_email = "${emailAddress}";

		if (IsElementNotPresent(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_EMAIL")) {
			OSBAdminProject.gotoProject(projectCode = "${projectCode}");

			Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

			if (IsElementNotPresent(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_EMAIL")) {
				Type(
					locator1 = "OSBAdminProjectAssignCustomer#EMAIL_ADDRESS_FIELD",
					value1 = "${emailAddress}");

				Select(
					locator1 = "OSBAdminProjectAssignCustomer#ROLE_SELECT",
					value1 = "${role}");

				ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#ADD_BUTTON");
			}
		}
		else {
			Message.success();
		}

		AssertElementPresent(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_EMAIL");
	}

	macro assignUser {
		Click(locator1 = "OSBAdminProjectUsers#AVAILABLE_TAB");

		OSBAdminSearch.searchBasic(keyword = "${emailAddress}");

		var key_emailAddress = "${emailAddress}";

		Check(locator1 = "OSBAdminProjectUsers#SEARCH_RESULT_CHECKBOX");

		Select(
			locator1 = "OSBAdminProjectUsers#SEARCH_RESULT_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "OSBAdminProjectUsers#UPDATE_ASSOCIATIONS_BUTTON");

		Message.success();
	}

	@prose = "I assign a user the email address ${emailAddress} as a worker with the role ${role} to the project with the code ${projectCode}"
	macro assignWorker {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_WORKERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		Type(
			locator1 = "OSBAdminProjectAssignWorker#EMAIL_ADDRESS_FIELD",
			value1 = "${emailAddress}");

		Select(
			locator1 = "OSBAdminProjectAssignWorker#ROLE_SELECT",
			value1 = "${role}");

		ClickNoError(locator1 = "OSBAdminProjectAssignWorker#ADD_BUTTON");

		var key_email = "${emailAddress}";

		if (IsElementNotPresent(locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_EMAIL")) {
			Refresh();
		}
		else {
			Message.success();
		}

		AssertElementPresent(locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_EMAIL");
	}

	@prose = "I create a project with the following values ${table}"
	macro create {
		Click(locator1 = "OSBAdmin#PROJECTS_TAB");
		Click(locator1 = "OSBAdmin#ADD_PROJECT_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "OSBAdminProjectAdd#PROJECT_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				Type(
					locator1 = "OSBAdminProjectAdd#CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "OSBAdminProjectAdd#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Industry") {
				Select(
					locator1 = "OSBAdminProjectAdd#INDUSTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner Code") {
				OSBAdmin.pause(timeInSeconds = "5");

				OSBAdminProject.editPartner(partnerCode = "${value}");
			}
			else if ("${field}" == "Partner First Line Support") {
				if ("${value}" == "true") {
					Check(locator1 = "OSBAdminProjectAdd#PARTNER_MANAGED_SUPPORT_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "OSBAdminProjectAdd#PARTNER_MANAGED_SUPPORT_CHECKBOX");			
				}
			}
			else if ("${field}" == "Tier") {
				Select(
					locator1 = "OSBAdminProjectAdd#TIER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Max Contacts") {
				Type(
					locator1 = "OSBAdminProjectAdd#MAXIMUM_CONTACTS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Special Instructions") {
				Type(
					locator1 = "OSBAdminProjectAdd#SPECIAL_INSTRUCTIONS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Additional Notes") {
				Type(
					locator1 = "OSBAdminProjectAdd#SPECIAL_INSTRUCTIONS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Address Line") {
				Type(
					locator1 = "OSBAdminProjectAdd#ADDRESS_LINE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				Select(
					locator1 = "OSBAdminProjectAdd#COUNTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				OSBAdmin.pause(timeInSeconds = "5");			

				Select(
					locator1 = "OSBAdminProjectAdd#STATE_PROVINCE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "City") {
				Type(
					locator1 = "OSBAdminProjectAdd#CITY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Zip") {
				Type(
					locator1 = "OSBAdminProjectAdd#POSTAL_CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				OSBAdminProject.addSupportRegion(region = "${value}");
			}
			else if ("${field}" == "Language") {
				OSBAdminProject.addSupportLanguage(language = "${value}");
			}
			else {
				fail("No such request field ${field}");
			}
		}
		Button.save();

		Message.success();
	}

	@prose = "I remove a user the email address ${emailAddress} as a customer from the project with the code ${projectCode}"
	macro deleteCustomer {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		var key_emailAddress = "${emailAddress}";

		Click(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_ACTION_BUTTON");
		ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#REMOVE_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		if (IsElementPresent(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_EMAIL")) {
			Refresh();
		}
		else {
			Message.success();
		}
	}

	macro deleteCustomers {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		while (IsElementPresent(locator1 = "OSBAdminProjectAssignCustomer#ACTION_BUTTON")) {
			Click(locator1 = "OSBAdminProjectAssignCustomer#ACTION_BUTTON");
			ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#REMOVE_MENU_ITEM");

			Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

			OSBAdmin.pause(timeInSeconds = "5");

			Refresh();
		}
	}

	@prose = "I attempt to remove a user with the email address ${emailAddress} as a customer from the project with the code ${projectCode} who still has an open Zendesk ticket"
	macro deleteCustomerWithOpenZendeskTicket {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		var key_emailAddress = "${emailAddress}";

		Click(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_ACTION_BUTTON");
		ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#REMOVE_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		Message.error(errorMessage = "Your request failed to complete.");
		// Update when LRIS-34692 is resolved
		// Message.error(errorMessage = "AccountCustomerRemovalException");
	}

	macro deleteUsers {
		Click(locator1 = "OSBAdminProjectUsers#CURRENT_TAB");

		if (IsElementPresent(locator1 = "OSBAdminProjectUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX")) {
			Uncheck(locator1 = "OSBAdminProjectUsers#SEARCH_RESULT_ALL_ROWS_CHECKBOX");

			Click(locator1 = "OSBAdminProjectUsers#UPDATE_ASSOCIATIONS_BUTTON");

			Message.success();
		}
	}

	@prose = "I remove a user the email address ${emailAddress} as a worker from the project with the code ${projectCode}"
	macro deleteWorker {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_WORKERS_BUTTON");

		var key_emailAddress = "${emailAddress}";

		Click(locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_ACTION_BUTTON");
		ClickNoError(locator1 = "OSBAdminProjectAssignWorker#REMOVE_MENU_ITEM");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		if (IsElementPresent(locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_EMAIL")) {
			Refresh();
		}
		else {
			Message.success();
		}
	}

	macro deleteWorkers {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_WORKERS_BUTTON");

		OSBAdmin.pause(timeInSeconds = "5");

		while (IsElementPresent(locator1 = "OSBAdminProjectAssignWorker#ACTION_BUTTON")) {
			Click(locator1 = "OSBAdminProjectAssignWorker#ACTION_BUTTON");
			ClickNoError(locator1 = "OSBAdminProjectAssignWorker#REMOVE_MENU_ITEM");

			Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

			OSBAdmin.pause(timeInSeconds = "5");

			Refresh();
		}
	}

	macro editPartner {
		Click(locator1 = "OSBAdminProject#PARTNER_SELECT_BUTTON");

		SelectWindow(locator1 = "title=${popupTitle}");

		OSBAdminSearch.searchBasic(keyword = "${partnerCode}");

		var key_code = "${partnerCode}";

		ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");

		SelectWindow(locator1 = "null");
	}

	@prose = "I edit the product ${product} offering status from ${previousStatus} to ${newStatus} for the project with the code ${projectCode}"
	macro editOfferingStatus {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		var key_product = "${product}";

		if ("${previousStatus}" == "Active") {
			Click(locator1 = "OSBAdminProjectAdd#ACTIVE_OFFERINGS_TAB");
		}
		else {
			Click(locator1 = "OSBAdminProjectAdd#ALL_OFFERINGS_TAB");
		}

		Select(
			locator1 = "OSBAdminProjectAdd#OFFERING_STATUS",
			value1 = "${newStatus}");

		Confirm(value1 = "Are you sure you want to modify the status from (${previousStatus}) to (${newStatus})?");

		OSBAdmin.pause(timeInSeconds = "5");

		if ("${newStatus}" == "Active") {
			Click(locator1 = "OSBAdminProjectAdd#ACTIVE_OFFERINGS_TAB");
		}
		else {
			Click(locator1 = "OSBAdminProjectAdd#ALL_OFFERINGS_TAB");
		}

		Click(locator1 = "OSBAdminProjectAdd#OFFERING_STATUS");

		Button.save();

		Message.success();
	}

	@prose = "I automatically have all expired projects moved to on hold status"
	macro expireProjects {
		var script = '''
			OfferingEntryLocalServiceUtil = com.liferay.portal.kernel.bean.PortletBeanLocatorUtil.locate("osb-portlet", "com.liferay.osb.service.OfferingEntryLocalService");

			OfferingEntryLocalServiceUtil.checkOfferingEntries();
			''';

		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=com_liferay_server_admin_web_portlet_ServerAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_mvcRenderCommandName=%2Fserver_admin%2Fview&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs1=script&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs2=");

		OSBAdmin.pause(timeInSeconds = "3");

		if (IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click(locator1 = "ProductMenu#TOGGLE");
		}

		Select(
			locator1 = "ServerAdministrationScript#LANGUAGE_SELECT",
			value1 = "Groovy");

		Type(
			locator1 = "ServerAdministrationScript#SCRIPT_FIELD",
			value1 = "${script}");

		Click(locator1 = "ServerAdministrationScript#EXECUTE_BUTTON");

		Message.success();
	}

	macro gotoProject {
		OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

		var key_code = "${projectCode}";

		Click(locator1 = "OSBAdmin#SEARCH_RESULT_CODE");
	}

	@prose = "the support account ID of the project with the code ${projectCode} should match the organization external ID on zendesk.liferay.com"
	macro _matchOsbProjectIdWithZendeskOrganizationId {
		var accountEntryId = JSONOSBAccount.getOSBAccountEntryId(accountCode = "${projectCode}");

		var accountEntryName = JSONOSBAccount.getOSBAccountEntryName(accountCode = "${projectCode}");

		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${accountEntryName}");

		echo("Account ID from Support: ${accountEntryId}");
		echo("Organization External ID from Zendesk: ${organizationExternalId}");

		if (!("${accountEntryId}" == "${organizationExternalId}")) {
			fail("Actual value ${accountEntryId} obtained from the support site and ${organizationExternalId} obtained from zendesk.liferay.com do not match");
		}
	}

	@prose = "I remove the partner for the project with the code ${projectCode}"
	macro removePartner {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#PARTNER_REMOVE_BUTTON");

		Button.save();

		Message.success();
	}

	@prose = "I remove partner first line support for the project with the code ${projectCode}"
	macro removePartnerFirstLineSupport {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Uncheck(locator1 = "OSBAdminProjectAdd#PARTNER_MANAGED_SUPPORT_CHECKBOX");			

		Button.save();

		Message.success();
	}

	@prose = "I remove the support language ${language} from the project with the code ${projectCode}"
	macro removeSupportLanguage {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_LANGUAGES_TAB");

		var key_item = "${language}";

		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_REMOVE_BUTTON");

		Button.save();

		Message.success();
	}

	@prose = "I remove the support region ${region} from the project with the code ${projectCode}"
	macro removeSupportRegion {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_REGIONS_TAB");

		var key_item = "${region}";

		Click(locator1 = "OSBAdminProjectAdd#SUPPORT_REMOVE_BUTTON");

		Button.save();

		Message.success();
	}

	@prose = "I sync the project with the code ${projectCode} to zendesk"
	macro syncToZendesk {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#SYNC_TO_ZENDESK_BUTTON");

		Message.success();
	}

	@prose = "I tear down the projects with the following project codes ${table}"
	macro tearDownProjects {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var projectCode = "${row[0]}";

			var key_code = "${projectCode}";

			OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

			if (IsElementPresent.isElementPresentAfterWait(locator1 = "OSBAdmin#SEARCH_RESULT_CODE")) {
				OSBAdminProject.deleteCustomers(projectCode = "${projectCode}");

				OSBAdminProject.deleteWorkers(projectCode = "${projectCode}");

				OSBAdminSearch.searchBasicProject(projectCode = "${projectCode}");

				Click(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_BUTTON");
				ClickNoError(locator1 = "OSBAdmin#SEARCH_RESULT_ACTION_MENU_DELETE");

				Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

				Message.success();
			}
		}
	}

	macro unlinkProject {
		var script = '''
			import com.liferay.portal.kernel.dao.db.DB;
			import com.liferay.portal.kernel.dao.db.DBManagerUtil;
			import com.liferay.portal.kernel.cache.CacheRegistryUtil;

			long accounEntryId = ${accountEntryId};

			DB db = DBManagerUtil.getDB();

			db.runSQL("delete from OSB_ExternalIdMapper where classPK = " + accounEntryId);

			CacheRegistryUtil.clear();
			''';

		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=com_liferay_server_admin_web_portlet_ServerAdminPortlet&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_mvcRenderCommandName=%2Fserver_admin%2Fview&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs1=script&_com_liferay_server_admin_web_portlet_ServerAdminPortlet_tabs2=");

		OSBAdmin.pause(timeInSeconds = "3");

		if (IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click(locator1 = "ProductMenu#TOGGLE");
		}

		Select(
			locator1 = "ServerAdministrationScript#LANGUAGE_SELECT",
			value1 = "Groovy");

		Type(
			locator1 = "ServerAdministrationScript#SCRIPT_FIELD",
			value1 = "${script}");

		Click(locator1 = "ServerAdministrationScript#EXECUTE_BUTTON");

		Message.success();
	}

	@prose = "I update a project with the code ${projectCode} using the following values ${table}"
	macro update {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "OSBAdminProjectAdd#PROJECT_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Code") {
				Type(
					locator1 = "OSBAdminProjectAdd#CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Type") {
				Select(
					locator1 = "OSBAdminProjectAdd#TYPE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Industry") {
				Select(
					locator1 = "OSBAdminProjectAdd#INDUSTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner Code") {
				OSBAdminProject.editPartner(partnerCode = "${value}");
			}
			else if ("${field}" == "Partner First Line Support") {
				if ("${value}" == "true") {
					Check(locator1 = "OSBAdminProjectAdd#PARTNER_MANAGED_SUPPORT_CHECKBOX");
				}
				else {
					Uncheck(locator1 = "OSBAdminProjectAdd#PARTNER_MANAGED_SUPPORT_CHECKBOX");			
				}
			}
			else if ("${field}" == "Tier") {
				Select(
					locator1 = "OSBAdminProjectAdd#TIER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Max Contacts") {
				Type(
					locator1 = "OSBAdminProjectAdd#MAXIMUM_CONTACTS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Special Instructions") {
				Type(
					locator1 = "OSBAdminProjectAdd#SPECIAL_INSTRUCTIONS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Additional Notes") {
				Type(
					locator1 = "OSBAdminProjectAdd#SPECIAL_INSTRUCTIONS_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Address Line") {
				Type(
					locator1 = "OSBAdminProjectAdd#ADDRESS_LINE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				Select(
					locator1 = "OSBAdminProjectAdd#COUNTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "State") {
				OSBAdmin.pause(timeInSeconds = "2");			

				Select(
					locator1 = "OSBAdminProjectAdd#STATE_PROVINCE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "City") {
				Type(
					locator1 = "OSBAdminProjectAdd#CITY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Zip") {
				Type(
					locator1 = "OSBAdminProjectAdd#POSTAL_CODE_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				OSBAdminProject.addSupportRegion(region = "${value}");
			}
			else if ("${field}" == "Language") {
				OSBAdminProject.addSupportLanguage(language = "${value}");
			}
			else {
				fail("No such request field ${field}");
			}
		}
		Button.save();

		Message.success();
	}

	@prose = "I update a customer on the project with the code ${projectCode} with the email address ${emailAddress} to the role of ${role}"
	macro updateCustomerRole {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_CUSTOMERS_BUTTON");

		var key_emailAddress = "${emailAddress}";

		Select(
			locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "OSBAdminProjectAssignCustomer#ASSIGNED_CUSTOMER_ACTION_BUTTON");
		ClickNoError(locator1 = "OSBAdminProjectAssignCustomer#UPDATE_MENU_ITEM");

		Message.success();
	}

	@prose = "I update a worker on the project with the code ${projectCode} with the email address ${emailAddress} to the role of ${role}"
	macro updateWorkerRole {
		OSBAdminProject.gotoProject(projectCode = "${projectCode}");

		Click(locator1 = "OSBAdminProject#ASSIGN_WORKERS_BUTTON");

		var key_emailAddress = "${emailAddress}";

		Select(
			locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_ROLE_SELECT",
			value1 = "${role}");

		Click(locator1 = "OSBAdminProjectAssignWorker#ASSIGNED_WORKER_ACTION_BUTTON");
		ClickNoError(locator1 = "OSBAdminProjectAssignWorker#UPDATE_MENU_ITEM");

		Message.success();
	}
}