definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I assign the Workflow asset titled ${assetTitle} to myself"
	macro assignWorkflowAssetToMe {
		MyWorkflowTasks.gotoOtherAssignees();

		MyWorkflowTasks.gotoWorkflowAsset(assetTitle = "${assetTitle}");

		Click(locator1 = "MyWorkflowTasksAsset#DROPDOWN_TOGGLE");

		Click(locator1 = "MyWorkflowTasksAsset#ASSIGN_TO_ME_LINK");

		SelectFrame(locator1 = "MyWorkflowTasksAssetCommentAdd#WORKFLOW_COMMENT_IFRAME");

		Type(
			locator1 = "MyWorkflowTasksAssetCommentAdd#COMMENT_FIELD",
			value1 = "Assigning ${assetTitle} to myself");

		Click(locator1 = "MyWorkflowTasksAssetCommentAdd#DONE_BUTTON");

		SelectFrameTop();

		Message.success();
	}

	@prose = "I approve the Workflow asset titled ${assetTitle}"
	macro approveWorkflowAsset {
		MyWorkflowTasks.gotoOtherAssignees();

		MyWorkflowTasks.gotoWorkflowAsset(assetTitle = "${assetTitle}");

		Click(locator1 = "MyWorkflowTasksAsset#DROPDOWN_TOGGLE");

		Click(locator1 = "MyWorkflowTasksAsset#APPROVE_LINK");

		Type(
			locator1 = "MyWorkflowTasksAssetCommentAdd#COMMENT_FIELD",
			value1 = "Approving ${assetTitle}");

		Click(locator1 = "MyWorkflowTasksAssetCommentAdd#DONE_BUTTON");

		Message.success();
	}

	@prose = "I go to My Workflow Tasks"
	macro gotoMyWorkFlowTasks {
		Open(locator1 = "${supportURL}/group/control_panel/manage?p_p_id=com_liferay_portal_workflow_task_web_portlet_MyWorkflowTaskPortlet&p_p_lifecycle=0&p_p_state=maximized");
	}

	@prose = "I go to the Other Assignees tab"
	macro gotoOtherAssignees {
		Click(locator1 = "MyWorkflowTasks#OTHER_ASSIGNEES_TAB");
	}

	@prose = "I go to the Workflow Asset titled ${assetTitle}"
	macro gotoWorkflowAsset {
		Type(
			locator1 = "MyWorkflowTasks#SEARCH_FIELD",
			value1 = "&quot;${assetTitle}&quot;");

		KeyPress(
			locator1 = "MyWorkflowTasks#SEARCH_FIELD",
			value1 = "\RETURN");

		var key_assetTitle = "${assetTitle}";

		while ((IsElementNotPresent(locator1 = "MyWorkflowTasks#ASSET_TITLE")) && (IsElementNotPresent(locator1 = "MyWorkflowTasks#GO_TO_NEXT_PAGE_LINK_DISABLED"))) {
			Click(locator1 = "MyWorkflowTasks#GO_TO_NEXT_PAGE_LINK");
		}

		Click(locator1 = "MyWorkflowTasks#ASSET_TITLE");
	}
}