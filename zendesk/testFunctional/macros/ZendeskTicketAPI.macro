definition {
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var apiToken = PropsUtil.get("zendesk.api.token");

	macro _getTicketGroupAssigneeIdById {
		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var groupAssigneeId = JSONCurlUtil.get("${curl}", "$.ticket.group_id");

		return "${groupAssigneeId}";
	}

	macro _getTicketPriorityById {
		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var priority = JSONCurlUtil.get("${curl}", "$.ticket.priority");

		return "${priority}";
	}

	@prose = "I teardown the tickets with ticketIds ${ticketIdList} from zendesk.liferay.com"
	macro _tearDownTicketByIds {
		if (!(contains("${ticketIdList}", "{ticketIdList}"))) {
		var curl = '''
			${zendeskURL}/api/v2/tickets/destroy_many.json?ids=${ticketIdList}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should be assigned to the group ${groupAssignee}"
	macro _viewMultipleTicketGroupAssignees {
		for (var ticketId : list "${ticketIdList}") {
			var groupAssigneeId = ZendeskTicketAPI._getTicketGroupAssigneeIdById(ticketId = "${ticketId}");

			var groupName = ZendeskGroupAPI._getGroupNameById(groupId = "${groupAssigneeId}");

			var groupAssigneeFromAPI = "${groupName}";

			echo("Expected Assignee Name: ${groupAssignee}");
			echo("Actual Assignee Name: ${groupAssigneeFromAPI}");

			if (!("${groupAssigneeFromAPI}" == "${groupAssignee}")) {
				fail("Actual value ${groupAssigneeFromAPI} assigned to ticket ID ${ticketId} does not match expected value ${groupAssignee}");
			}
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should be given the priority level ${priority}"
	macro _viewMultipleTicketPriorities {
		for (var ticketId : list "${ticketIdList}") {
			var priorityFromAPI = ZendeskTicketAPI._getTicketPriorityById(ticketId = "${ticketId}");

			echo("Expected Priority Level: ${priority}");
			echo("Actual Priority Level: ${priorityFromAPI}");

			if (!("${priorityFromAPI}" == "${priority}")) {
				fail("Actual value ${priorityFromAPI} given to ticket ID ${ticketId} does not match expected value ${priority}");
			}
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the environment ${environment}"
	macro _viewTicketEnvironment {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var environmentFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[10].value");

		echo("Expected Environment Name: ${environment}");
		echo("Actual Environment Name: ${environmentFromAPI}");

		if (!("${environmentFromAPI}" == "${environment}")) {
			fail("Actual value ${environmentFromAPI} does not match expected value ${environment}");
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should be assigned to the group ${assignee}"
	macro _viewTicketGroupAssignee {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var assigneeIdFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.assignee_id");

		var curl = '''
			${zendeskURL}/api/v2/groups/${assigneeIdFromAPI}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var assigneeFromAPI = JSONCurlUtil.get("${curl}", "$.group.name");

		echo("Expected Assignee Name: ${assignee}");
		echo("Actual Assignee Name: ${assigneeFromAPI}");

		if (!("${assigneeFromAPI}" == "${assignee}")) {
			fail("Actual value ${assigneeFromAPI} does not match expected value ${assignee}");
		}
	}

	macro _viewTicketIdByTicketSubject {
		var curl = '''
			${zendeskURL}/api/v2/search.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-G --data-urlencode "query=type:ticket subject:${ticketSubject}"
			''';

		var ticketId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${ticketId}";
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the organization ${organizationName}"
	macro _viewTicketOrganization {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationId = JSONCurlUtil.get("${curl}", "$.ticket.organization_id");

		var curl = '''
			${zendeskURL}/api/v2/organizations/${organizationId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var organizationNameFromAPI = JSONCurlUtil.get("${curl}", "$.organization.name");

		echo("Expected Organization Name: ${organizationName}");
		echo("Actual Organization Name: ${organizationNameFromAPI}");

		if (!("${organizationNameFromAPI}" == "${organizationName}")) {
			fail("Actual value ${organizationNameFromAPI} does not match expected value ${organizationName}");
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the priority level ${priority}"
	macro _viewTicketPriority {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var curl = '''
			${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var priorityFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.priority");

		echo("Expected Priority Name: ${priority}");
		echo("Actual Priority Name: ${priorityFromAPI}");

		if (!("${priorityFromAPI}" == "${priority}")) {
			fail("Actual value ${priorityFromAPI} does not match expected value ${priority}");
		}
	}
}