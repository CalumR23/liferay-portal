					''';

				var subjectFromAPI = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.field_name=='assignee_id')])].events[?(@.via.source.from.title=='Notify assignee of assignment')].subject");

				if (!(contains("${subjectFromAPI}", "${value}"))) {
