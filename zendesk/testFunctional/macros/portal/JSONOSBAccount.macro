definition {
	var adminEmailAddress = PropsUtil.get("osb.admin.email.address");
	var adminPassword = PropsUtil.get("osb.admin.password");
	var supportURL = PropsUtil.get("customer.liferay.url");
	var supportWebId = PropsUtil.get("customer.liferay.web.id");
	var webWebId = PropsUtil.get("web.liferay.web.id");
	var webURL = PropsUtil.get("web.liferay.url");

	macro getOSBAccountEntryId {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${adminEmailAddress}:${adminPassword}
			-d code=${accountCode}
			''';

		var accountEntryId = JSONCurlUtil.post("${curl}", "$.accountEntryId");

		echo("OSB Account Entry ID: ${accountEntryId}");

		return "${accountEntryId}";
	}

	macro getOSBAccountEntryName {
		var curl = '''
			${supportURL}/api/jsonws/osb-portlet.accountentry/get-account-entry-by-code
			-u ${adminEmailAddress}:${adminPassword}
			-d code=${accountCode}
			''';

		var accountEntryName = JSONCurlUtil.post("${curl}", "$.name");

		echo("OSB Account Entry Name: ${accountEntryName}");

		return "${accountEntryName}";
	}
}