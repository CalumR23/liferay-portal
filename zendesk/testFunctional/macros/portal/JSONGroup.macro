definition {
	var adminEmailAddress = PropsUtil.get("osb.admin.email.address");
	var adminPassword = PropsUtil.get("osb.admin.password");
	var supportURL = PropsUtil.get("customer.liferay.url");
	var supportWebId = PropsUtil.get("customer.liferay.web.id");
	var webWebId = PropsUtil.get("web.liferay.web.id");
	var webURL = PropsUtil.get("web.liferay.url");

	macro getWebGroupId {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/group/get-group
			-u ${adminEmailAddress}:${adminPassword}
			-d companyId=${companyId}
			-d name=${groupName}
			''';

		var groupId = JSONCurlUtil.post("${curl}", "$.groupId");

		echo("Group ID: ${groupId}");

		return "${groupId}";
	}
}