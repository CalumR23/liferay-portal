	@prose = "I update a user with the email address ${userEmailAddress} using following parameters ${table}"
	macro update {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Screen Name") {
				var userScreenName = "${value}";
			}
			else if ("${field}" == "Email Address") {
				var userEmailAddress = "${value}";
			}
			else if ("${field}" == "First Name") {
				var userFirstName = "${value}";
			}
			else if ("${field}" == "Last Name") {
				var userLastName = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		var openId = StringUtil.randomString("5");

		var curl = '''
			${webURL}/api/secure/jsonws/user/update-user
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			-d oldPassword=osbadminqauser
			-d newPassword1=resuaqnimdabso
			-d newPassword2=resuaqnimdabso
			-d passwordReset=false
			-d reminderQueryQuestion=Test
			-d reminderQueryAnswer=Test
			-d screenName=${userScreenName}
			-d emailAddress=${userEmailAddress}
			-d facebookId=0
			-d openId=1a23d
			-d languageId=0
			-d timeZoneId=0
			-d greeting=Hello
			-d comments=Comment
			-d firstName=${userFirstName}
			-d middleName=Test
			-d lastName=${userLastName}
			-d prefixId=0
			-d suffixId=0
			-d male=true
			-d birthdayMonth=4
			-d birthdayDay=30
			-d birthdayYear=1986
			-d smsSn=
			-d aimSn=
			-d facebookSn=
			-d icqSn=
			-d jabberSn=
			-d msnSn=
			-d mySpaceSn=
			-d skypeSn=
			-d twitterSn=
			-d ymSn=
			-d jobTitle=
			-d groupIds=
			-d organizationIds=
			-d roleIds=
			-d userGroupRoles=
			-d userGroupIds=
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I update the support password for user with the email address ${userEmailAddress} to ${userPassword}"
	macro updateSupportPassword {
		var companyId = JSONCompany.getSupportCompanyId();

		var curl = '''
			${supportURL}/api/jsonws/user/get-user-by-email-address
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var supportUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Support User ID: ${supportUserId}");

		var curl = '''
			${supportURL}/api/jsonws/user/update-password
			-u ${supportAdminEmailAddress}:${supportAdminPassword}
			-d userId=${supportUserId}
			-d password1=${userPassword}
			-d password2=${userPassword}
			-d passwordReset=false
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I update the web password for user with the email address ${userEmailAddress} to ${userPassword}"
	macro updateWebPassword {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		echo("Web User ID: ${webUserId}");

		var curl = '''
			${webURL}/api/secure/jsonws/user/update-password
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			-d password1=${userPassword}
			-d password2=${userPassword}
			-d passwordReset=false
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}
}