				-d userId=${webUserId}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
		}
	}

	@prose = "I tear down the users with the following email addresses from customer.liferay.com ${table}"
	macro tearDownUsersViaSupport {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
