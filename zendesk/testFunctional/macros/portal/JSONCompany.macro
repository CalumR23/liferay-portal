definition {
	var adminEmailAddress = PropsUtil.get("osb.admin.email.address");
	var adminPassword = PropsUtil.get("osb.admin.password");
	var supportURL = PropsUtil.get("customer.liferay.url");
	var supportWebId = PropsUtil.get("customer.liferay.web.id");
	var webWebId = PropsUtil.get("web.liferay.web.id");
	var webURL = PropsUtil.get("web.liferay.url");

	macro getSupportCompanyId {
		var curl = '''
			${supportURL}/api/jsonws/company/get-company-by-web-id
			-u ${adminEmailAddress}:${adminPassword}
			-d webId=${supportWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Support Company ID: ${companyId}");

		return "${companyId}";
	}

	macro getWebCompanyId {
		var curl = '''
			${webURL}/api/secure/jsonws/company/get-company-by-web-id
			-u ${adminEmailAddress}:${adminPassword}
			-d webId=${webWebId}
			''';

		static var companyId = JSONCurlUtil.post("${curl}", "$.companyId");

		echo("Web Company ID: ${companyId}");

		return "${companyId}";
	}
}