definition {
	var supportURL = PropsUtil.get("support.liferay.url");
	var webAdminEmailAddress = PropsUtil.get("web.admin.email.address");
	var webAdminPassword = PropsUtil.get("web.admin.password");
	var webWebId = PropsUtil.get("web.liferay.web.id");
	var webURL = PropsUtil.get("web.liferay.url");

	@prose = "I go to the DXP Trial Sign In page"
	macro gotoDXPTrialSignInPage {
		Open(locator1 = "${webURL}/sign-in?p_p_id=58&p_p_lifecycle=0&p_p_state=maximized&p_p_mode=view&_58_struts_action=%2Flogin%2Fcreate_account_trial&_58_redirect=%2Fc%2Fportal%2Fregister_trial_license%3Fredirect%3D%2Fdigital-experience-platform%2F30-day-trial");

		AssertVisible(locator1 = "DXPTrialSignIn#DXP_TRIAL_HEADER");
		AssertVisible(locator1 = "DXPTrialSignIn#DXP_TRIAL_SUBHEADER");
	}

	@prose = "I create a DXP trial account with a randomly generated email address and company name with the following additional values ${table}"
	macro createAccount {
		if (IsVisible(locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_BUTTON")) {
			Click(locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_BUTTON");
		}

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Email") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_EMAIL_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Password") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_PASSWORD_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "First Name") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_FIRST_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Last Name") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_LAST_NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Phone Number") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_PHONE_NUMBER_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Company") {
				Type(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_COMPANY_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Industry") {
				Select(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_INDUSTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Country") {
				Select(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_COUNTRY_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Region") {
				OSBAdmin.pause(timeInSeconds = "5");

				Select(
					locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_REGION_SELECT",
					value1 = "${value}");
			}
			else {
				fail("No such create account field ${field}");
			}
		}

		Check(locator1 = "DXPTrialSignIn#CREATE_ACCOUNT_AGREE_TO_TERMS_OF_USE_CHECKBOX");

		Click(locator1 = "DXPTrialSignIn#START_FREE_TRIAL_BUTTON");
	}

	@prose = "I generate a web company name"
	macro generateWebCompanyName {
		var companyRandomNumber = MathUtil.randomNumber("1000000");

		static var staticCompanyName = "Company Number ${companyRandomNumber}";

		echo("Trial Company Name: ${staticCompanyName}");

		return "${staticCompanyName}";
	}

	@prose = "I generate a web user email address"
	macro generateWebEmailAddress {
		var emailRandomNumber = MathUtil.randomNumber("10000000");

		static var staticEmailAddress = "user.${emailRandomNumber}@lrcustomer.com.broken";

		echo("Trial User Email Address: ${staticEmailAddress}");

		return "${staticEmailAddress}";
	}

	@prose = "I get the web corporate trial organziation id value with the name ${companyName} belonging to the user with the email address ${userEmailAddress}"
	macro getWebCorporateTrialOrganizationId {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		var curl = '''
			${webURL}/api/secure/jsonws/organization/get-user-organizations
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			''';

		var trialOrganizationNameValue = JSONCurlUtil.post("${curl}", "$[0].name");

		echo("Trial User Organization Name Value: ${trialOrganizationNameValue}");

		if (contains("${trialOrganizationNameValue}", "${companyName}")) {
			static var staticTrialOrganizationIdValue = JSONCurlUtil.post("${curl}", "$[0].organizationId");

			echo("Trial User Organization ID Value: ${staticTrialOrganizationIdValue}");

			return "${staticTrialOrganizationIdValue}";
		}
		else {
			static var staticTrialOrganizationIdValue = "";

			echo("Trial User Organization ID Value: ${staticTrialOrganizationIdValue}");

			return "${staticTrialOrganizationIdValue}";
		}
	}

	@prose = "I tear down the web corporate trial organization with the ID value ${trialOrganizationId}"
	macro tearDownWebCorporateTrialOrganization {
		if ((!(contains("${trialOrganizationId}", "{trialOrganizationId}"))) && (!("${trialOrganizationId}" == ""))) {
			var curl = '''
				${webURL}/api/secure/jsonws/organization/delete-organization
				-u ${webAdminEmailAddress}:${webAdminPassword}
				-d organizationId=${trialOrganizationId}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
		}
	}

	@prose = "I should be able to the view the DXP Trial Homepage"
	macro viewDXPTrialHomepage {
		AssertVisible(locator1 = "DXPTrialHomepage#HELLO_HEADER");
		AssertVisible(locator1 = "DXPTrialHomepage#HELLO_SUBTITLE");

		AssertVisible(locator1 = "DXPTrialHomepage#DOWNLOAD_SECTION_HEADER");
		AssertVisible(locator1 = "DXPTrialHomepage#DOWNLOAD_SECTION_PRODUCT_NAME");
		AssertVisible(locator1 = "DXPTrialHomepage#DOWNLOAD_SECTION_DOWNLOAD_SELECT");
		AssertVisible(locator1 = "DXPTrialHomepage#DOWNLOAD_SECTION_DOWNLOAD_BUTTON");
		AssertVisible(locator1 = "DXPTrialHomepage#DOWNLOAD_SECTION_DOWNLOAD_INSTRUCTIONS");

		AssertVisible(locator1 = "DXPTrialHomepage#EMAIL_SECTION_HEADER");
		AssertVisible(locator1 = "DXPTrialHomepage#EMAIL_SECTION_EMAIL_INSTRUCTION");
		AssertVisible(locator1 = "DXPTrialHomepage#EMAIL_SECTION_EMAIL_INSTRUCTION_LICENSE_LINK");
		AssertVisible(locator1 = "DXPTrialHomepage#EMAIL_SECTION_TRIAL_KEY_BUTTON");

		AssertVisible(locator1 = "DXPTrialHomepage#DEPLOY_SECTION_HEADER");
		AssertVisible(locator1 = "DXPTrialHomepage#DEPLOY_SECTION_VIDEO_LINK");

		AssertVisible(locator1 = "DXPTrialHomepage#DEVELOPER_TOOLS_SECTION_HEADER");
		AssertVisible(locator1 = "DXPTrialHomepage#DEVELOPER_TOOLS_LEARN_MORE_BUTTON");
	}

	@prose = "the user with the email address ${userEmailAddress} should be part of the web corporate trial organization for the company ${companyName}"
	macro viewUserWebCorporateTrialOrganization {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		var curl = '''
			${webURL}/api/secure/jsonws/organization/get-user-organizations
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			''';

		var trialOrganizationNameValue = JSONCurlUtil.post("${curl}", "$[0].name");

		if (!(contains("${trialOrganizationNameValue}", "${companyName}"))) {
			fail("The trial appears to not be in the trial organization for ${companyName}");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should be part of the web Trial organization"
	macro viewUserWebTrialOrganization {
		var companyId = JSONCompany.getWebCompanyId();

		var curl = '''
			${webURL}/api/secure/jsonws/user/get-user-by-email-address
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d companyId=${companyId}
			-d emailAddress=${userEmailAddress}
			''';

		var webUserId = JSONCurlUtil.post("${curl}", "$.userId");

		var curl = '''
			${webURL}/api/secure/jsonws/organization/get-user-organizations
			-u ${webAdminEmailAddress}:${webAdminPassword}
			-d userId=${webUserId}
			''';

		var trialOrganizationNameValue = JSONCurlUtil.post("${curl}", "$[1].name");

		if (!("${trialOrganizationNameValue}" == "Trial")) {
			fail("The trial appears to not be in the Trial organization");
		}
	}
}