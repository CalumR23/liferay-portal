	@prose = "I create a request as a user with the email address ${requesterEmail} with the following values ${table}"
	macro _createRequest {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Subject") {
				var subject = "${value}";
			}
			else if ("${field}" == "Description") {
				var description = "${value}";
			}
			else if ("${field}" == "Organization External ID") {
				var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${value}");
			}
			else if ("${field}" == "Product") {
				var product = "${value}";
			}
			else if ("${field}" == "Component") {
				var component = "${value}";
			}
			else if ("${field}" == "System Status") {
				var systemStatus = "${value}";
			}
			else {
				fail("No such request field ${field}");
			}
		}

		if (!(isSet(subject))) {
			var subject = "";
		}
		if (!(isSet(description))) {
			var description = "";
		}
		if (!(isSet(organizationId))) {
			var organizationId = "";
		}
		if (!(isSet(product))) {
			var product = "";
		}
		if (!(isSet(component))) {
			var component = "";
		}
		if (!(isSet(systemStatus))) {
			var systemStatus = "";
		}

		var curl = '''
			${zendeskURL}/api/v2/requests.json
			-u ${requesterEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"request":
				{
					"subject": "${subject}",
					"organization_id": "${organizationId}",
					"comment":
					{
						"body": "${description}"
					},
					"custom_fields":
					[
						{
							"id": "360006041192",
							"value": "${product}"
						},
						{
							"id": "360011314571",
							"value": "${component}"
						},
						{
							"id": "360009385592",
							"value": "${systemStatus}"
						}
					]
				}
			}
			''';

		static var requestId = JSONCurlUtil.post("${curl}", "$.request.id");

		echo("Request ID: ${requestId}");

		if (contains("${staticRequestIdList}", "{staticRequestIdList}")) {
			static var staticRequestIdList = "${requestId}";
		}
		else {
			static var staticRequestIdList = "${staticRequestIdList},${requestId}";
		}
		echo("Request ID List: ${staticRequestIdList}");

		return "${staticRequestIdList}";
	}

	@prose = "I create a comment with the content ${commentBody} on a request with the ID ${ticketId} as a user with the email address ${commentAuthorEmail}"
	macro _createRequestComment {
		var curl = '''
			${zendeskURL}/api/v2/requests/${ticketId}.json
			-u ${commentAuthorEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"request":
				{
					"comment":
					{
						"body": "${commentBody}"
					}
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}
}