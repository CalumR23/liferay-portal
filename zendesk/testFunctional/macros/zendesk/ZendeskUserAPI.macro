definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	@prose = "I assign the user with the email address ${userEmailAddress} to the group ${groupName}"
	macro _assignUserToGroup {
		var groupId = ZendeskGroupAPI._getGroupIdByName(groupName = "${groupName}");
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			${zendeskURL}/api/v2/group_memberships.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"group_membership":
				{
					"default": true,
					"user_id": "${userId}",
					"group_id": "${groupId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I assign a user with the email address ${userEmailAddress} to an organization with organizationExternalId ${organizationExternalId}"
	macro _assignUserToOrganization {
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			${zendeskURL}/api/v2/organization_memberships.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"organization_membership":
				{
					"user_id": "${userId}",
					"organization_id": "${organizationId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I assign a user with the email address ${userEmailAddress} as a watcher on an organization with organizationExternalId ${organizationExternalId}"
	macro _assignWatcherRole {
		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var tag = "osb_${organizationId}_watcher";

		var curl = '''
			${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");
		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"user":
				{
					"tags": "${tag},${existingTags}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I create a user with the following values ${table}"
	macro _createUser {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				var userName = "${value}";
			}
			else if ("${field}" == "Role") {
				var role = "${value}";
			}
			else if ("${field}" == "Access") {
				var access = "${value}";
			}
			else if ("${field}" == "Email") {
				var email = "${value}";
			}
			else if ("${field}" == "Phone Number") {
				var phoneNumber = "${value}";
			}
			else if ("${field}" == "Tags") {
				var tags = "${value}";
			}
			else if ("${field}" == "Organization") {
				var organization = "${value}";
			}
			else if ("${field}" == "Language") {
				if("${value}" == "English") {
					var localeId = "1";
				}
				else if("${value}" == "Japanese") {
					var localeId = "67";
				}
				else if("${value}" == "Portuguese") {
					var localeId = "1011";
				}
				else if("${value}" == "Simplified Chinese") {
					var localeId = "10";
				}
				else if("${value}" == "Spanish") {
					var localeId = "2";
				}
				else {
					var localeId = "1";
				}
			}
			else if ("${field}" == "Time Zone") {
				var timeZone = "${value}";
			}
			else if ("${field}" == "Details") {
				var details = "${value}";
			}
			else if ("${field}" == "Notes") {
				var notes = "${value}";
			}
			else if ("${field}" == "External ID") {
				var externalId = "${value}";
			}
			else if ("${field}" == "Password") {
				var password = "${value}";
			}
			else {
				fail("No such user field ${field}");
			}
		}

		if (!(isSet(userName))) {
			var userName = "";
		}
		if (!(isSet(role))) {
			var role = "";
		}
		if (!(isSet(access))) {
			var access = "";
		}
		if (!(isSet(email))) {
			var email = "";
		}
		if (!(isSet(phoneNumber))) {
			var phoneNumber = "";
		}
		if (!(isSet(tags))) {
			var tags = "";
		}
		if (!(isSet(organization))) {
			var organization = "";
		}
		if (!(isSet(localeId))) {
			var localeId = "";
		}
		if (!(isSet(timeZone))) {
			var timeZone = "";
		}
		if (!(isSet(details))) {
			var details = "";
		}
		if (!(isSet(notes))) {
			var notes = "";
		}
		if (!(isSet(externalId))) {
			var externalId = "";
		}

		var curl = '''
			${zendeskURL}/api/v2/users/create_or_update.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"user":
				{
					"verified": true,
					"name": "${userName}",
					"role": "${role}",
					"ticket_restriction": "${access}",
					"email": "${email}",
					"phone": "${phoneNumber}",
					"tags": "${tags}",
					"locale_id": "${localeId}",
					"time_zone": "${timeZone}",
					"details": "${details}",
					"notes": "${notes}",
					"external_id": "${externalId}",
					"organization":
					{
						"name": "${organization}"
					}
				}
			}
			''';

		static var staticUserID = JSONCurlUtil.post("${curl}", "$.user.id");

		echo("User ID: ${staticUserID}");

		return "${staticUserID}";

		var curl = '''
			${zendeskURL}/api/v2/users/${staticUserID}/password.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"password":"${password}"
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I obtain the external IDs of the following user email addresses from zendesk.liferay.com ${table}"
	macro _getMultipleUserExternalIdsByEmailAddress {
		var userCount = "0";
		var userExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userEmailAddress = "${row[0]}";

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

			if (!("${users}" == "[]")) {
				var userExternalId = ZendeskUserAPI._viewUserExternalIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

				if("${userCount}" == "0") {
					var userExternalIds = "${userExternalIds}${userExternalId}";
				}
				else {
					var userExternalIds = "${userExternalIds},${userExternalId}";
				}

				var userCount = MathUtil.sum("${userCount}", "1");
			}
		}

		static var staticUserExternalIdList = "${userExternalIds}";

		echo("User External IDs: ${staticUserExternalIdList}");

		return "${staticUserExternalIdList}";
	}

	macro _getUserNameById {
		var curl = '''
			${zendeskURL}/api/v2/users/${userId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userName = JSONCurlUtil.get("${curl}", "$.user.name");

		return "${userName}";
	}

	@prose = "I teardown the user with userId ${staticUserID} from zendesk.liferay.com"
	macro _tearDownUserById {
		var curl = '''
			${zendeskURL}/api/v2/users/${staticUserID}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
	}

	@prose = "I teardown users with the following userExternalIds ${userExternalIds} from zendesk.liferay.com"
	macro _tearDownUsersByExternalIdList {
		if (!(contains("${userExternalIds}", "{userExternalIds}"))) {
			var curl = '''
				${zendeskURL}/api/v2/users/destroy_many.json?external_ids=${userExternalIds}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I teardown users with the following userExternalIds from zendesk.liferay.com ${table}"
	macro _tearDownUsersByExternalIdTable {
		var userCount = "0";
		var userExternalIds = "";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var userExternalId = "${row[0]}";

			if("${userCount}" == "0") {
				var userExternalIds = "${userExternalIds}${userExternalId}";
			}
			else {
				var userExternalIds = "${userExternalIds},${userExternalId}";
			}

			var userCount = MathUtil.sum("${userCount}", "1");
		}

		ZendeskUserAPI._tearDownUsersByExternalIdList(userExternalIds = "${userExternalIds}");
	}

	@prose = "the user with the email address ${userEmailAddress} should not have the ${tag} tag"
	macro _viewNoUserTag {
		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		echo("Non-expected User Tag: ${tag}");
		echo("Actual User Tags: ${existingTags}");

		if (contains("${existingTags}", "${tag}")) {
			fail("Actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} has the non-expected tag ${tag}");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should not be a watcher on an organization with the name ${organizationName}"
	macro _viewNoUserWatcherTag {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var watcherTag = "osb_${organizationId}_watcher";

		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		echo("Non-expected User Watcher Tag: ${watcherTag}");
		echo("Actual User Tags: ${existingTags}");

		if (contains("${existingTags}", "${watcherTag}")) {
			fail("Actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} has the non-expected watcher tag ${watcherTag}");
		}
	}

	macro _viewUserExistingTagsByEmailAddress {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.users[0].tags");

		var existingTags = StringUtil.replace("${existingTags}", "[", "");

		var existingTags = StringUtil.replace("${existingTags}", "]", "");

		var existingTags = StringUtil.replace("${existingTags}", "&quot;", "");

		return "${existingTags}";
	}

	macro _viewUserExistingTagsByExternalId {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.users[0].tags");

		return "${existingTags}";
	}

	macro _viewUserExternalIdByEmailAddress {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userExternalId = JSONCurlUtil.get("${curl}", "$.users[0].external_id");

		return "${userExternalId}";
	}

	macro _viewUserIdByEmailAddress {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userID = JSONCurlUtil.get("${curl}", "$.users[0].id");

		return "${userID}";
	}

	macro _viewUserIdByExternalId {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userID = JSONCurlUtil.get("${curl}", "$.users[0].id");

		return "${userID}";
	}

	@prose = "the user with userExternalId ${userExternalId} on zendesk.liferay.com should have the name ${userName}"
	macro _viewUserNameByExternalId {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?external_id=${userExternalId}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var userNameFromAPI = JSONCurlUtil.get("${curl}", "$.users[0].name");

		echo("Expected User Name: ${userName}");
		echo("Actual User Name: ${userNameFromAPI}");

		if (!("${userNameFromAPI}" == "${userName}")) {
			fail("Actual value ${userNameFromAPI} does not match expected value ${userName}");
		}
	}

	macro _viewUserSearchResultsByEmailAddress {
		var curl = '''
			${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var users = JSONCurlUtil.get("${curl}", "$.users");

		return "${users}";
	} 

	@prose = "the user with the email address ${userEmailAddress} should be present on zendesk.liferay.com"
	macro _viewUserSyncFromOsb {
		var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && ("${users}" == "[]")) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var users = ZendeskUserAPI._viewUserSearchResultsByEmailAddress(userEmailAddress = "${userEmailAddress}");
		}

		if (!("${users}" == "[]")) {
			var curl = '''
				${zendeskURL}/api/v2/users/search.json?query=${userEmailAddress}
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var userEmailAddressFromAPI = JSONCurlUtil.get("${curl}", "$.users[0].email");
		}
		else {
			fail("After ${currentIteration} attempts while waiting at ${pollIntervalInSeconds} in between each attempt, the OSB to Zendesk sync for the user with the email ${userEmailAddress} appears to have been unsuccessful");
		}

		echo("Expected User Email Address: ${userEmailAddress}");
		echo("Actual User Email Address: ${userEmailAddressFromAPI}");

		if (!("${userEmailAddressFromAPI}" == "${userEmailAddress}")) {
			fail("Actual value ${userEmailAddressFromAPI} does not match expected value ${userEmailAddress}.  There may be something wrong with Zendesk search or there may be similar data or the sync may have unsuccessful");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should have the ${tag} tag"
	macro _viewUserTag {
		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		echo("Expected User Tag: ${tag}");
		echo("Actual User Tags: ${existingTags}");

		if (!(contains("${existingTags}", "${tag}"))) {
			fail("Actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} does not have the expected tag ${tag}");
		}
	}

	@prose = "the user with the email address ${userEmailAddress} should be a watcher on an organization with the name ${organizationName}"
	macro _viewUserWatcherTag {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var watcherTag = "osb_${organizationId}_watcher";

		var existingTags = ZendeskUserAPI._viewUserExistingTagsByEmailAddress(userEmailAddress = "${userEmailAddress}");

		echo("Expected User Watcher Tag: ${watcherTag}");
		echo("Actual User Tags: ${existingTags}");

		if (!(contains("${existingTags}", "${watcherTag}"))) {
			fail("Actual user tags ${existingTags} shows that the user with the email ${userEmailAddress} does not have the expected watcher tag ${watcherTag}");
		}
	}
}