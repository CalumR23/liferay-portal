definition {
	var apiToken = PropsUtil.get("zendesk.api.token");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");

	macro _getTriggerIdByName {
		var triggerNameEditNoSpace = StringUtil.replace("${triggerName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/search.json?query=${triggerNameEditNoSpace}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var triggerId = JSONCurlUtil.get("${curl}", "$.triggers[0].id");

		var triggerNameFromAPI = JSONCurlUtil.get("${curl}", "$.triggers[0].title");

		var triggerId = StringUtil.replace("${triggerId}", "[", "");

		var triggerId = StringUtil.replace("${triggerId}", "]", "");

		var triggerId = StringUtil.replace("${triggerId}", "&quot;", "");

		var triggerNameFromAPI = StringUtil.replace("${triggerNameFromAPI}", "[", "");

		var triggerNameFromAPI = StringUtil.replace("${triggerNameFromAPI}", "]", "");

		var triggerNameFromAPI = StringUtil.replace("${triggerNameFromAPI}", "&quot;", "");

		if (!("${triggerName}" == "${triggerNameFromAPI}")) {
			fail("Actual trigger name ${triggerNameFromAPI} obtained from search does not match the expected trigger name ${triggerName}");
		}

		return "${triggerId}";
	}

	macro _getTriggerIdByNameWithoutNameVerification {
		var triggerNameEditNoSpace = StringUtil.replace("${triggerName}", " ", "+");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/search.json?query=${triggerNameEditNoSpace}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var triggerId = JSONCurlUtil.get("${curl}", "$.triggers[0].id");

		var triggerId = StringUtil.replace("${triggerId}", "[", "");

		var triggerId = StringUtil.replace("${triggerId}", "]", "");

		var triggerId = StringUtil.replace("${triggerId}", "&quot;", "");

		return "${triggerId}";
	}

	@prose = "the trigger ${triggerName} should have ${numberOfConditions} conditions"
	macro _viewNumberOfTriggerProperties {
		var triggerId = ZendeskTriggerAPI._getTriggerIdByName(triggerName = "${triggerName}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var numberOfAllConditionsFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all");

		var numberOfAllConditionsFromAPI = StringUtil.count("${numberOfAllConditionsFromAPI}", "&quot;field&quot;");

		var numberOfAnyConditionsFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any");

		var numberOfAnyConditionsFromAPI = StringUtil.count("${numberOfAnyConditionsFromAPI}", "&quot;field&quot;");

		var numberOfConditionsFromAPI = MathUtil.sum("${numberOfAllConditionsFromAPI}","${numberOfAnyConditionsFromAPI}");

		if (!("${numberOfConditionsFromAPI}" == "${numberOfConditions}")) {
			fail("Actual number of conditions ${numberOfConditionsFromAPI} does not match expected number of conditions ${numberOfConditions}");
		}
	}

	@prose = "there should be ${numberOfActiveTriggers} active triggers in zendesk"
	macro _viewActiveTriggerCount {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/active.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var numberOfActiveTriggersFromAPI = JSONCurlUtil.get("${curl}", "$.count");

		if (!("${numberOfActiveTriggersFromAPI}" == "${numberOfActiveTriggers}")) {
			fail("There are now ${numberOfActiveTriggersFromAPI} active triggers instead of ${numberOfActiveTriggers}.  New triggers may have been added or removed.  Please check and follow up.");
		}
	}

	@prose = "the trigger ${triggerName} should assign the ticket to the ${entityType} ${entityName}"
	macro _viewTriggerAssignmentAction {
		var triggerId = ZendeskTriggerAPI._getTriggerIdByName(triggerName = "${triggerName}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		if ("${entityType}" == "group") {
			var entityTypeFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.actions[0].field");

			var entityTypeFromAPI = StringUtil.replace("${entityTypeFromAPI}", "[", "");

			var entityTypeFromAPI = StringUtil.replace("${entityTypeFromAPI}", "]", "");

			var entityTypeFromAPI = StringUtil.replace("${entityTypeFromAPI}", "&quot;", "");

			if (!("${entityTypeFromAPI}" == "group_id")) {
				fail("The trigger is currently not assigning the ticket to a group");
			}

			var groupIdFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.actions[0].value");

			var groupNameFromAPI = ZendeskGroupAPI._getGroupNameById(groupId = "${groupIdFromAPI}");

			var groupNameFromAPI = StringUtil.replace("${groupNameFromAPI}", "[", "");

			var groupNameFromAPI = StringUtil.replace("${groupNameFromAPI}", "]", "");

			var groupNameFromAPI = StringUtil.replace("${groupNameFromAPI}", "&quot;", "");

			if (!("${groupNameFromAPI}" == "${entityName}")) {
				fail("The trigger is currently not assigning the ticket to the group ${entityName}");
			}
		}
	}

	@prose = "the trigger ${triggerName} should have the following properties under the all conditions ${table}"
	macro _viewTriggerPropertiesUnderAllConditions {
		var triggerId = ZendeskTriggerAPI._getTriggerIdByName(triggerName = "${triggerName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var operator = "${row[1]}";
			var value = "${row[2]}";

			if ("${field}" == "Update Type") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='update_type')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='update_type')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Update Type value from API: ${valueFromAPI}");

				echo("Expected Update Type: ${value}");
				echo("Actual Update Type: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Update Type value ${valueFromAPI} for ${field} field does not match expected Update Type value ${value}");
				}
			}
			else if ("${field}" == "SLA") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.sla')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.sla')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskOrganizationFieldsAPI._getSLANameById(slaId = "${valueFromAPI}");

				echo("SLA value from API: ${valueFromAPI}");

				echo("Expected SLA: ${value}");
				echo("Actual SLA: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual SLA value ${valueFromAPI} for ${field} field does not match expected SLA value ${value}");
				}
			}
			else if ("${field}" == "Priority") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='priority')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='priority')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = StringUtil.upperCaseFirstLetter("${valueFromAPI}");

				echo("Priority value from API: ${valueFromAPI}");

				echo("Expected Priority: ${value}");
				echo("Actual Priority: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Priority value ${valueFromAPI} for ${field} field does not match expected Priority value ${value}");
				}
			}
			else if ("${field}" == "Within (schedule)") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='within_schedule')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='within_schedule')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskScheduleAPI._getScheduleNameById(scheduleId = "${valueFromAPI}");

				echo("Support Region value from API: ${valueFromAPI}");

				echo("Expected Support Region: ${value}");
				echo("Actual Support Region: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Within (schedule) value ${valueFromAPI} for ${field} field does not match expected Within (schedule) value ${value}");
				}
			}
			else if ("${field}" == "Support Region") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var supportRegionId = ZendeskOrganizationFieldsAPI._getSupportRegionIdByName(supportRegionName = "${value}");

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.support_region' && @.value=='${supportRegionId}')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.support_region' && @.value=='${supportRegionId}')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskOrganizationFieldsAPI._getSupportRegionNameById(supportRegionId = "${valueFromAPI}");

				echo("Support Region value from API: ${valueFromAPI}");

				echo("Expected Support Region: ${value}");
				echo("Actual Support Region: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Support Region value ${valueFromAPI} for ${field} field does not match expected Support Region value ${value}");
				}
			}
			else if ("${field}" == "Partner First Line Support") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.partner_first_line_support')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='organization.custom_fields.partner_first_line_support')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Partner First Line Support value from API: ${valueFromAPI}");

				echo("Expected Partner First Line Support: ${value}");
				echo("Actual Partner First Line Support ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Partner First Line Support value ${valueFromAPI} for ${field} field does not match expected Partner First Line Support value ${value}");
				}
			}
			else if ("${field}" == "Product") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "${field}");

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='custom_fields_${fieldId}' && @.value=='${value}')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='custom_fields_${fieldId}' && @.value=='${value}')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Product value from API: ${valueFromAPI}");

				echo("Expected Product: ${value}");
				echo("Actual Product: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Product value ${valueFromAPI} for ${field} field does not match expected Product value ${value}");
				}
			}
			else if ("${field}" == "Group") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='group_id')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.all[?(@.field=='group_id')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				if (!("${valueFromAPI}" == "")) {
					var valueFromAPI = ZendeskGroupAPI._getGroupNameById(valueFromAPI = "${valueFromAPI}");
				}
				else {
					var valueFromAPI = "";
				}

				echo("Group from API: ${valueFromAPI}");

				echo("Expected Group: ${value}");
				echo("Actual Group ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Group value ${valueFromAPI} for ${field} field does not match expected Group value ${value}");
				}
			}
			else {
				fail("No such trigger field ${field}");
			}
		}
	}

	@prose = "the trigger ${triggerName} should have the following properties under the any conditions ${table}"
	macro _viewTriggerPropertiesUnderAnyConditions {
		var triggerId = ZendeskTriggerAPI._getTriggerIdByName(triggerName = "${triggerName}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var operator = "${row[1]}";
			var value = "${row[2]}";

			if ("${field}" == "Update Type") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='update_type')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='update_type')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Update Type value from API: ${valueFromAPI}");

				echo("Expected Update Type: ${value}");
				echo("Actual Update Type: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Update Type value ${valueFromAPI} for ${field} field does not match expected Update Type value ${value}");
				}
			}
			else if ("${field}" == "SLA") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.sla')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.sla')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskOrganizationFieldsAPI._getSLANameById(slaId = "${valueFromAPI}");

				echo("SLA value from API: ${valueFromAPI}");

				echo("Expected SLA: ${value}");
				echo("Actual SLA: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual SLA value ${valueFromAPI} for ${field} field does not match expected SLA value ${value}");
				}
			}
			else if ("${field}" == "Priority") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='priority')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='priority')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = StringUtil.upperCaseFirstLetter("${valueFromAPI}");

				echo("Priority value from API: ${valueFromAPI}");

				echo("Expected Priority: ${value}");
				echo("Actual Priority: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Priority value ${valueFromAPI} for ${field} field does not match expected Priority value ${value}");
				}
			}
			else if ("${field}" == "Within (schedule)") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var scheduleId = ZendeskScheduleAPI._getScheduleIdByName(scheduleName = "${value}");

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='within_schedule' && @.value=='${scheduleId}')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='within_schedule' && @.value=='${scheduleId}')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskScheduleAPI._getScheduleNameById(scheduleId = "${valueFromAPI}");

				echo("Support Region value from API: ${valueFromAPI}");

				echo("Expected Support Region: ${value}");
				echo("Actual Support Region: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Within (schedule) value ${valueFromAPI} for ${field} field does not match expected Within (schedule) value ${value}");
				}
			}
			else if ("${field}" == "Support Region") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var supportRegionId = ZendeskOrganizationFieldsAPI._getSupportRegionIdByName(supportRegionName = "${value}");

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.support_region' && @.value=='${supportRegionId}')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.support_region' && @.value=='${supportRegionId}')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				var valueFromAPI = ZendeskOrganizationFieldsAPI._getSupportRegionNameById(supportRegionId = "${valueFromAPI}");

				echo("Support Region value from API: ${valueFromAPI}");

				echo("Expected Support Region: ${value}");
				echo("Actual Support Region: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Support Region value ${valueFromAPI} for ${field} field does not match expected Support Region value ${value}");
				}
			}
			else if ("${field}" == "Partner First Line Support") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.partner_first_line_support')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='organization.custom_fields.partner_first_line_support')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Partner First Line Support value from API: ${valueFromAPI}");

				echo("Expected Partner First Line Support: ${value}");
				echo("Actual Partner First Line Support ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Partner First Line Support value ${valueFromAPI} for ${field} field does not match expected Partner First Line Support value ${value}");
				}
			}
			else if ("${field}" == "Product") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "${field}");

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='custom_fields_${fieldId}' && @.value=='${value}')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field with the ${value} value does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='custom_fields_${fieldId}' && @.value=='${value}')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				echo("Product value from API: ${valueFromAPI}");

				echo("Expected Product: ${value}");
				echo("Actual Product: ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Product value ${valueFromAPI} for ${field} field does not match expected Product value ${value}");
				}
			}
			else if ("${field}" == "Group") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var operator = StringUtil.lowerCaseFirstLetter("${operator}");

				var operator = StringUtil.replace("${operator}", " ", "_");

				var operatorFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='group_id')].operator");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "[", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "]", "");

				var operatorFromAPI = StringUtil.replace("${operatorFromAPI}", "&quot;", "");

				if (!("${operatorFromAPI}" == "${operator}")) {
					fail("Actual operator value ${operatorFromAPI} for ${field} field does not match expected operator ${operator}");
				}

				var valueFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.conditions.any[?(@.field=='group_id')].value");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "[", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "]", "");

				var valueFromAPI = StringUtil.replace("${valueFromAPI}", "&quot;", "");

				if (!("${valueFromAPI}" == "")) {
					var valueFromAPI = ZendeskGroupAPI._getGroupNameById(valueFromAPI = "${valueFromAPI}");
				}
				else {
					var valueFromAPI = "";
				}

				echo("Group from API: ${valueFromAPI}");

				echo("Expected Group: ${value}");
				echo("Actual Group ${valueFromAPI}");

				if (!("${valueFromAPI}" == "${value}")) {
					fail("Actual Group value ${valueFromAPI} for ${field} field does not match expected Group value ${value}");
				}
			}
			else {
				fail("No such trigger field ${field}");
			}
		}
	}

	@prose = "the trigger ${triggerName} should have ${updateDate} as its update date"
	macro _viewTriggerUpdateDate {
		var triggerId = ZendeskTriggerAPI._getTriggerIdByNameWithoutNameVerification(triggerName = "${triggerName}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/triggers/${triggerId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var updateDateFromAPI = JSONCurlUtil.get("${curl}", "$.trigger.updated_at");

		if (!("${updateDateFromAPI}" == "${updateDate}")) {
			fail("Actual update date ${updateDateFromAPI} for ${triggerName} does not match expected update date ${updateDate}. This trigger may have been changed. Please check the trigger ${triggerName} and update test after verifying trigger changes.");
		}
	}
}