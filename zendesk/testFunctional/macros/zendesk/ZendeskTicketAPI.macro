				for (var recipientId : list "${recipientIds}") {
					var recipientFromAPI = ZendeskUserAPI._getUserNameById(userId = "${recipientId}");

					if ("${recipientsFromAPI}" == "") {
						var recipientsFromAPI = "${recipientFromAPI}";
					}
					else {
						var recipientsFromAPI = "${recipientsFromAPI},${recipientFromAPI}";
					}
				}
				echo("Expected Recipients: ${value}");
				echo("Actual Recipients: ${recipientsFromAPI}");

				if (!(contains("${recipientsFromAPI}", "${value}"))) {
					fail("Actual recipients ${recipientsFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not contain the expected recipients ${value}");
				}
			}

			if ("${field}" == "Subject") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var subjectFromAPI = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.plain_body=='${commentBody}')])].events[?(@.via.source.from.title=='Notify Leads-US of comment update (${supportLanguage})')].subject");

				if (!(contains("${subjectFromAPI}", "${value}"))) {
					fail("Actual subject ${subjectFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not contain the text ${value}");
				}
			}

			if ("${field}" == "Body") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var bodyFromAPI = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.plain_body=='${commentBody}')])].events[?(@.via.source.from.title=='Notify Leads-US of comment update (${supportLanguage})')].body");

				if (!(contains("${bodyFromAPI}", "${value}"))) {
					fail("Actual body ${bodyFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not contain the text ${value}");
				}
			}
		}
	}

	@prose = "an email regarding the comment with the body ${commentBody} added to a ticket with the ticketId ${ticketId} for the support language ${supportLanguage} containing the following parameters should be sent out to the ticket requester ${table}"
	macro _viewTicketCommentEmailToRequester {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Recipients") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var recipientIds = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.plain_body=='${commentBody}')])].events[?(@.via.source.from.title=='Notify requester of comment update (${supportLanguage})')].recipients");

				var recipientIds = StringUtil.replace("${recipientIds}", "[", "");

				var recipientIds = StringUtil.replace("${recipientIds}", "]", "");

				echo("Recipient IDs from API: ${recipientIds}");

				var recipientsFromAPI = "";

				for (var recipientId : list "${recipientIds}") {
					var recipientFromAPI = ZendeskUserAPI._getUserNameById(userId = "${recipientId}");

					if ("${recipientsFromAPI}" == "") {
						var recipientsFromAPI = "${recipientFromAPI}";
					}
					else {
						var recipientsFromAPI = "${recipientsFromAPI},${recipientFromAPI}";
					}
				}
				echo("Expected Recipients: ${value}");
				echo("Actual Recipients: ${recipientsFromAPI}");

				if (!("${recipientsFromAPI}" == "${value}")) {
					fail("Actual recipients ${recipientsFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not match expected recipients ${value}");
				}
			}

			if ("${field}" == "Subject") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var subjectFromAPI = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.plain_body=='${commentBody}')])].events[?(@.via.source.from.title=='Notify requester of comment update (${supportLanguage})')].subject");

				if (!(contains("${subjectFromAPI}", "${value}"))) {
					fail("Actual subject ${subjectFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not contain the text ${value}");
				}
			}

			if ("${field}" == "Body") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var bodyFromAPI = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.plain_body=='${commentBody}')])].events[?(@.via.source.from.title=='Notify requester of comment update (${supportLanguage})')].body");

				if (!(contains("${bodyFromAPI}", "${value}"))) {
					fail("Actual body ${bodyFromAPI} in the email regarding the comment for ticket ID ${ticketId} does not contain the text ${value}");
				}
			}
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the environment ${environment}"
	macro _viewTicketEnvironment {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Environment");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var environmentFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "[", "");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "]", "");

		var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "&quot;", "");

		echo("Expected Environment Name: ${environment}");
		echo("Actual Environment Name: ${environmentFromAPI}");

		if (!("${environmentFromAPI}" == "${environment}")) {
			fail("Actual value ${environmentFromAPI} does not match expected value ${environment}");
		}
	}

	macro _viewTicketExistingTagsById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var existingTags = JSONCurlUtil.get("${curl}", "$.ticket.tags");

		var existingTags = StringUtil.replace("${existingTags}", "[", "");

		var existingTags = StringUtil.replace("${existingTags}", "]", "");

		var existingTags = StringUtil.replace("${existingTags}", "&quot;", "");

		return "${existingTags}";
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should be assigned to the group ${assignee}"
	macro _viewTicketGroupAssignee {
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var assigneeIdFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.assignee_id");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/groups/${assigneeIdFromAPI}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var assigneeFromAPI = JSONCurlUtil.get("${curl}", "$.group.name");

		echo("Expected Assignee Name: ${assignee}");
		echo("Actual Assignee Name: ${assigneeFromAPI}");

		if (!("${assigneeFromAPI}" == "${assignee}")) {
			fail("Actual value ${assigneeFromAPI} does not match expected value ${assignee}");
		}
	}

	macro _viewTicketIdByTicketSubject {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/search.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-G --data-urlencode "query=type:ticket subject:${ticketSubject}"
			''';

		var ticketId = JSONCurlUtil.get("${curl}", "$.results[0].id");

		return "${ticketId}";
	}

