	@prose = "the ticket with ticketId ${ticketId} should have the requester with the email address ${requesterEmailAddress}"
	macro _viewTicketRequesterSync {
		var requesterId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${requesterEmailAddress}");

		var requesterIdFromAPI = ZendeskTicketAPI._getTicketRequesterIdById(ticketId = "${ticketId}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${requesterId}" == "${requesterIdFromAPI}"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var requesterIdFromAPI = ZendeskTicketAPI._getTicketRequesterIdById(ticketId = "${ticketId}");
		}

		echo("Expected Requester ID: ${requesterId}");
		echo("Actual Requester ID: ${requesterIdFromAPI}");

		if (!("${requesterIdFromAPI}" == "${requesterId}")) {
			fail("After ${currentIteration} checks, actual requester ID ${requesterIdFromAPI} for ticket ID ${ticketId} does not match expected requester ID ${requesterId}");
		}
	}

	@prose = "the ticket with ticketId ${ticketId} should have the status ${status}"
	macro _viewTicketStatusSync {
		var statusFromAPI = ZendeskTicketAPI._getTicketStatusById(ticketId = "${ticketId}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${statusFromAPI}" == "${status}"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var statusFromAPI = ZendeskTicketAPI._getTicketStatusById(ticketId = "${ticketId}");
		}

		echo("Expected Status: ${status}");
		echo("Actual Status: ${statusFromAPI}");

		if (!("${statusFromAPI}" == "${status}")) {
			fail("After ${currentIteration} checks, actual value ${statusFromAPI} status for ticket ID ${ticketId} does not match expected status value ${status}");
		}
	}

	@prose = "the ticket with ticket subject ${ticketSubject} should have the sub-status ${subStatus}"
	macro _viewTicketSubStatus{
		var ticketId = ZendeskTicketAPI._viewTicketIdByTicketSubject(ticketSubject = "${ticketSubject}");

		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Sub-Status");

		var curl = '''
