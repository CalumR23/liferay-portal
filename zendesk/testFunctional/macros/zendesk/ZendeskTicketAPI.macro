	@prose = "the tickets with the ticketIds ${ticketIdList} should contain the tag ${tagName}"
	macro _viewSpecificTagForMultipleTickets {
		for (var ticketId : list "${ticketIdList}") {
			var existingTags = ZendeskTicketAPI._viewTicketExistingTagsById(ticketId = "${ticketId}");

			echo("Expected Tag Value: ${tagName}");
			echo("Actual Existing Tags: ${existingTags}");

			if (!(contains("${existingTags}", "${tagName}"))) {
				fail("Actual tag values ${existingTags} in the ticket with ID value ${ticketId} does not contain the expected tag ${tagName}");
			}
		}
	}

