			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var subStatusFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

		var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "[", "");

		var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "]", "");

		var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "&quot;", "");

		echo("Expected Environment Name: ${subStatus}");
		echo("Actual Environment Name: ${subStatusFromAPI}");

		if (!("${subStatusFromAPI}" == "${subStatus}")) {
			fail("Actual value ${subStatusFromAPI} does not match expected value ${subStatus}");
		}
	}

	@prose = "the ticket with the ticketId ${ticketId} should be set to the ${supportRegionAbbreviation} support schedule"
	macro _viewTicketSupportSchedule {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var supportSchedule = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.type=='ScheduleAssignment')].via.source.from.title");

		var supportSchedule = StringUtil.replace("${supportSchedule}", "[", "");

		var supportSchedule = StringUtil.replace("${supportSchedule}", "]", "");

		var supportSchedule = StringUtil.replace("${supportSchedule}", "&quot;", "");

		var supportRegionAbbreviationFromAPI = StringUtil.replace("${supportSchedule}", "Set schedule to ", "");

		echo("Expected Support Schedule: ${supportRegionAbbreviation}");
		echo("Actual Support Schedule: ${supportRegionAbbreviationFromAPI}");

		if (!("${supportRegionAbbreviation}" == "${supportRegionAbbreviationFromAPI}")) {
			fail("Actual support schedule ${supportRegionAbbreviationFromAPI} does not match the expected support schedule ${supportRegionAbbreviation}");
		}

		var supportScheduleId = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.type=='ScheduleAssignment')].new_schedule_id");

		var supportScheduleId = StringUtil.replace("${supportScheduleId}", "[", "");

		var supportScheduleId = StringUtil.replace("${supportScheduleId}", "]", "");

		var supportScheduleId = StringUtil.replace("${supportScheduleId}", "&quot;", "");

		var supportScheduleName = ZendeskScheduleAPI._getScheduleNameById(scheduleId = "${supportScheduleId}");

		var supportScheduleName = StringUtil.replace("${supportScheduleName}", "[", "");

		var supportSchedule = StringUtil.replace("${supportScheduleName}", "]", "");

		var supportSchedule = StringUtil.replace("${supportScheduleName}", "&quot;", "");

		var supportRegionAbbreviationFromAPI = StringUtil.replace("${supportScheduleName}", " - Schedule", "");

		echo("Expected Support Schedule in Trigger: ${supportRegionAbbreviation}");
		echo("Actual Support Schedule in Trigger: ${supportRegionAbbreviationFromAPI}");

		if (!("${supportRegionAbbreviation}" == "${supportRegionAbbreviationFromAPI}")) {
			fail("The schedule trigger may be incorrect as it is setting ${supportRegionAbbreviationFromAPI} schedule to the ${supportRegionAbbreviation} trigger.");
		}
	}
}