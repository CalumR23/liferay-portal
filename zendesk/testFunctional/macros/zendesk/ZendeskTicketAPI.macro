definition {
	var zendeskURL = PropsUtil.get("zendesk.liferay.url");
	var pollIntervalInSeconds = PropsUtil.get("osb.to.zendesk.sync.poll.interval.in.seconds");
	var pollMaximumIterations = PropsUtil.get("osb.to.zendesk.sync.poll.maximum.iterations");
	var zendeskAdminEmail = PropsUtil.get("zendesk.admin.email.address");
	var apiToken = PropsUtil.get("zendesk.api.token");

	@prose = "I assign a ticket with the ID ${ticketId} with the following tags ${table}"
	macro _assignTagsToTicket {
		var existingTags = ZendeskTicketAPI._viewTicketExistingTagsById(ticketId = "${ticketId}");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var tag = "${row[0]}";

			if (contains("${tagList}", "{tagList}")) {
				var tagList = "${tag}";
			}
			else {
				var tagList = "${tagList},${tag}";
			}
		}

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"tags": "${tagList},${existingTags}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I assign the tickets with the ticketIds ${ticketIdList} with the following tags ${table}"
	macro _assignTagsToTickets {
		for (var ticketId : list "${ticketIdList}") {
			var existingTags = ZendeskTicketAPI._viewTicketExistingTagsById(ticketId = "${ticketId}");

			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var tag = "${row[0]}";

				if (contains("${tagList}", "{tagList}")) {
					var tagList = "${tag}";
				}
				else {
					var tagList = "${tagList},${tag}";
				}
			}

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				-H "Content-Type: application/json"
				-d
				{
					"ticket":
					{
						"tags": "${tagList},${existingTags}"
					}
				}
				''';

			com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
		}
	}

	@prose = "I assign the ticket with the ID ${ticketId} to a user with the email address ${userEmailAddress}"
	macro _assignTicket {
		var userId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"assignee_id": "${userId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I change the status of the ticket with the ID ${ticketId} to ${ticketStatus}"
	macro _changeTicketStatus {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"status": "${ticketStatus}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I change the status and sub-status of the ticket with the ID ${ticketId} to ${ticketStatus} and ${ticketSubStatus} respectively"
	macro _changeTicketStatusAndSubStatus {
		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Sub-Status");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"status": "${ticketStatus}",
					"custom_fields": [
						{
							"id": "${fieldId}",
							"value": "${ticketSubStatus}"
						}
					]
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "I change the sub-status of the ticket with the ID ${ticketId} to ${ticketSubStatus}"
	macro _changeTicketSubStatus {
		var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Sub-Status");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"custom_fields": [
						{
							"id": "${fieldId}",
							"value": "${ticketSubStatus}"
						}
					]
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	macro _getTicketGroupAssigneeIdById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var groupAssigneeId = JSONCurlUtil.get("${curl}", "$.ticket.group_id");

		return "${groupAssigneeId}";
	}

	macro _getTicketPriorityById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var priority = JSONCurlUtil.get("${curl}", "$.ticket.priority");

		return "${priority}";
	}

	macro _getTicketStatusById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var status = JSONCurlUtil.get("${curl}", "$.ticket.status");

		return "${status}";
	}

	macro _getTicketRequesterIdById {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		var requesterId = JSONCurlUtil.get("${curl}", "$.ticket.requester_id");

		return "${requesterId}";
	}

	@prose = "I teardown the tickets with ticketIds ${ticketIdList} from zendesk.liferay.com"
	macro _tearDownTicketByIds {
		if (!(contains("${ticketIdList}", "{ticketIdList}"))) {
		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/destroy_many.json?ids=${ticketIdList}
			-u ${zendeskAdminEmail}/token:${apiToken}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.delete("${curl}");
		}
	}

	@prose = "I update the ticket with ticketId ${ticketId} to have the organization ${organizationName}"
	macro _updateTicketOrganization {
		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

		var organizationId = ZendeskOrganizationAPI._viewOrganizationIdByExternalId(organizationExternalId = "${organizationExternalId}");

		var curl = '''
			--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
			-u ${zendeskAdminEmail}/token:${apiToken}
			-H "Content-Type: application/json"
			-d
			{
				"ticket":
				{
					"organization_id": "${organizationId}"
				}
			}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.put("${curl}");
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should have the proper account code and externalId value of the organization ${organizationName}"
	macro _viewAccountCodeAndExternalId {
		for (var ticketId : list "${ticketIdList}") {
			var organizationAccountCode = ZendeskOrganizationAPI._getOrganizationAccountCodeByOrganizationName(organizationName = "${organizationName}");

			var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${organizationName}");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var organizationExternalIdFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==360013377532)].value");

			var organizationExternalIdFromAPI = StringUtil.replace("${organizationExternalIdFromAPI}", "[", "");

			var organizationExternalIdFromAPI = StringUtil.replace("${organizationExternalIdFromAPI}", "]", "");

			var organizationExternalIdFromAPI = StringUtil.replace("${organizationExternalIdFromAPI}", "&quot;", "");

			var organizationAccountCodeFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==360013425231)].value");

			var organizationAccountCodeFromAPI = StringUtil.replace("${organizationAccountCodeFromAPI}", "[", "");

			var organizationAccountCodeFromAPI = StringUtil.replace("${organizationAccountCodeFromAPI}", "]", "");

			var organizationAccountCodeFromAPI = StringUtil.replace("${organizationAccountCodeFromAPI}", "&quot;", "");

			echo("Expected Organization External ID: ${organizationExternalId}");
			echo("Actual Organization External ID: ${organizationExternalIdFromAPI}");

			if (!("${organizationExternalIdFromAPI}" == "${organizationExternalId}")) {
				fail("Actual value ${organizationExternalIdFromAPI} does not match the expected value of ${organizationExternalId}");
			}

			echo("Expected Account Code: ${organizationAccountCode}");
			echo("Actual Account Code: ${organizationAccountCodeFromAPI}");

			if (!("${organizationAccountCodeFromAPI}" == "${organizationAccountCode}")) {
				fail("Actual value ${organizationAccountCodeFromAPI} does not match the expected value of ${organizationAccountCode}");
			}
		}
	}

	@prose = "the ticket with ticketId ${ticketId} should have the default user from the organization with the project code ${projectCode} as the requester"
	macro _viewDefaultUserTicketRequester {
		var accountEntryName = JSONOSBAccount.getOSBAccountEntryName(accountCode = "${projectCode}");

		var organizationExternalId = ZendeskOrganizationAPI._getOrganizationExternalIdByOrganizationName(organizationName = "${accountEntryName}");

		var requesterEmailAddress = "no-reply@${organizationExternalId}.com.broken";

		var requesterId = ZendeskUserAPI._viewUserIdByEmailAddress(userEmailAddress = "${requesterEmailAddress}");

		var requesterIdFromAPI = ZendeskTicketAPI._getTicketRequesterIdById(ticketId = "${ticketId}");

		var currentIteration = "0";

		while ((!("${currentIteration}" == "${pollMaximumIterations}")) && (!("${requesterId}" == "${requesterIdFromAPI}"))) {
			var currentIteration = MathUtil.sum("${currentIteration}", "1");

			ZendeskHomepage.pause(timeInSeconds = "${pollIntervalInSeconds}");

			var requesterIdFromAPI = ZendeskTicketAPI._getTicketRequesterIdById(ticketId = "${ticketId}");
		}

		echo("Expected Requester ID: ${requesterId}");
		echo("Actual Requester ID: ${requesterIdFromAPI}");

		if (!("${requesterIdFromAPI}" == "${requesterId}")) {
			fail("After ${currentIteration} checks, actual requester ID ${requesterIdFromAPI} for ticket ID ${ticketId} does not match expected requester ID ${requesterId}");
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should have the environment ${environment}"
	macro _viewMultipleTicketEnvironments {
		for (var ticketId : list "${ticketIdList}") {
			var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Environment");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var environmentFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

			var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "[", "");

			var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "]", "");

			var environmentFromAPI = StringUtil.replace("${environmentFromAPI}", "&quot;", "");

			echo("Expected Environment Name: ${environment}");
			echo("Actual Environment Name: ${environmentFromAPI}");

			if (!("${environmentFromAPI}" == "${environment}")) {
				fail("Actual value ${environmentFromAPI} does not match expected value ${environment}");
			}
		}
	}

	@prose = "emails regarding the reception of the following ${portalLegacyVersion} ticketIds ${ticketIdList} for the support language ${supportLanguage} with the following parameters should be sent out ${table}"
	macro _viewMultipleLegacyVersionTicketReceptionEmails {
		for (var ticketId : list "${ticketIdList}") {
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var field = "${row[0]}";
				var value = "${row[1]}";

				if ("${field}" == "Recipients") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var recipientIds = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request and ${portalLegacyVersion} EOSL Policy (${supportLanguage})')].recipients");

					var recipientIds = StringUtil.replace("${recipientIds}", "[", "");

					var recipientIds = StringUtil.replace("${recipientIds}", "]", "");

					echo("Recipient IDs from API: ${recipientIds}");

					var recipientsFromAPI = "";

					for (var recipientId : list "${recipientIds}") {
						var recipientFromAPI = ZendeskUserAPI._getUserNameById(userId = "${recipientId}");

						if ("${recipientsFromAPI}" == "") {
							var recipientsFromAPI = "${recipientFromAPI}";
						}
						else {
							var recipientsFromAPI = "${recipientsFromAPI},${recipientFromAPI}";
						}
					}
					echo("Expected Recipients: ${value}");
					echo("Actual Recipients: ${recipientsFromAPI}");

					if (!("${recipientsFromAPI}" == "${value}")) {
						fail("Actual recipients ${recipientsFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not match expected recipients ${value}");
					}
				}

				if ("${field}" == "Subject") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var subjectFromAPI = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request and ${portalLegacyVersion} EOSL Policy (${supportLanguage})')].subject");

					if (!(contains("${subjectFromAPI}", "${value}"))) {
						fail("Actual subject ${subjectFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not contain the text ${value}");
					}
				}

				if ("${field}" == "Body") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var bodyFromAPI = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request and ${portalLegacyVersion} EOSL Policy (${supportLanguage})')].body");

					if (!(contains("${bodyFromAPI}", "${value}"))) {
						fail("Actual body ${bodyFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not contain the text ${value}");
					}
				}
			}
		}
	}

	@prose = "emails regarding the reception of the following ticketIds ${ticketIdList} for the support language ${supportLanguage} with the following parameters should be sent out ${table}"
	macro _viewMultipleTicketReceptionEmails {
		for (var ticketId : list "${ticketIdList}") {
			var RawTable rawTable = new RawTable("${table}");

			for (var row : table "${rawTable}") {
				var field = "${row[0]}";
				var value = "${row[1]}";

				if ("${field}" == "Recipients") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var recipientIds = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request (${supportLanguage})')].recipients");

					var recipientIds = StringUtil.replace("${recipientIds}", "[", "");

					var recipientIds = StringUtil.replace("${recipientIds}", "]", "");

					echo("Recipient IDs from API: ${recipientIds}");

					var recipientsFromAPI = "";

					for (var recipientId : list "${recipientIds}") {
						var recipientFromAPI = ZendeskUserAPI._getUserNameById(userId = "${recipientId}");

						if ("${recipientsFromAPI}" == "") {
							var recipientsFromAPI = "${recipientFromAPI}";
						}
						else {
							var recipientsFromAPI = "${recipientsFromAPI},${recipientFromAPI}";
						}
					}
					echo("Expected Recipients: ${value}");
					echo("Actual Recipients: ${recipientsFromAPI}");

					if (!("${recipientsFromAPI}" == "${value}")) {
						fail("Actual recipients ${recipientsFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not match expected recipients ${value}");
					}
				}

				if ("${field}" == "Subject") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var subjectFromAPI = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request (${supportLanguage})')].subject");

					if (!(contains("${subjectFromAPI}", "${value}"))) {
						fail("Actual subject ${subjectFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not contain the text ${value}");
					}
				}

				if ("${field}" == "Body") {
					var curl = '''
						--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
						-u ${zendeskAdminEmail}/token:${apiToken}
						''';

					var bodyFromAPI = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request (${supportLanguage})')].body");

					if (!(contains("${bodyFromAPI}", "${value}"))) {
						fail("Actual body ${bodyFromAPI} in the email regarding the creation of ticket ID ${ticketId} does not contain the text ${value}");
					}
				}
			}
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should be assigned to the group ${groupAssignee}"
	macro _viewMultipleTicketGroupAssignees {
		for (var ticketId : list "${ticketIdList}") {
			var groupAssigneeId = ZendeskTicketAPI._getTicketGroupAssigneeIdById(ticketId = "${ticketId}");

			var groupName = ZendeskGroupAPI._getGroupNameById(groupId = "${groupAssigneeId}");

			var groupAssigneeFromAPI = "${groupName}";

			echo("Expected Assignee Name: ${groupAssignee}");
			echo("Actual Assignee Name: ${groupAssigneeFromAPI}");

			if (!("${groupAssigneeFromAPI}" == "${groupAssignee}")) {
				fail("Actual value ${groupAssigneeFromAPI} assigned to ticket ID ${ticketId} does not match expected value ${groupAssignee}");
			}
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should be given the priority level ${priority}"
	macro _viewMultipleTicketPriorities {
		for (var ticketId : list "${ticketIdList}") {
			var priorityFromAPI = ZendeskTicketAPI._getTicketPriorityById(ticketId = "${ticketId}");

			echo("Expected Priority Level: ${priority}");
			echo("Actual Priority Level: ${priorityFromAPI}");

			if (!("${priorityFromAPI}" == "${priority}")) {
				fail("Actual value ${priorityFromAPI} given to ticket ID ${ticketId} does not match expected value ${priority}");
			}
		}
	}

	@prose = "the tickets with ticketIds ${ticketIdList} should have the sub-status ${subStatus}"
	macro _viewMultipleTicketSubStatuses {
		for (var ticketId : list "${ticketIdList}") {
			var fieldId = ZendeskTicketFieldsAPI._getTicketFieldIdByName(fieldName = "Sub-Status");

			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var subStatusFromAPI = JSONCurlUtil.get("${curl}", "$.ticket.custom_fields[?(@.id==${fieldId})].value");

			var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "[", "");

			var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "]", "");

			var subStatusFromAPI = StringUtil.replace("${subStatusFromAPI}", "&quot;", "");

			echo("Expected Sub-Status: ${subStatus}");
			echo("Actual Sub-Status: ${subStatusFromAPI}");

			if (!("${subStatusFromAPI}" == "${subStatus}")) {
				fail("Actual value ${subStatusFromAPI} does not match expected value ${subStatus}");
			}
		}
	}

	@prose = "${portalLegacyVersion} legacy ticket emails related to the following ticketIds ${ticketIdList} for the support language ${supportLanguage} should not be sent out"
	macro _viewNoMultipleLegacyVersionTicketReceptionEmails {
		for (var ticketId : list "${ticketIdList}") {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var legacyTicketEmailEvent = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request and ${portalLegacyVersion} EOSL Policy (${supportLanguage})')]");

			var legacyTicketEmailEvent = StringUtil.replace("${legacyTicketEmailEvent}", "[", "");

			var legacyTicketEmailEvent = StringUtil.replace("${legacyTicketEmailEvent}", "]", "");

			echo("Legacy ticket email event: ${legacyTicketEmailEvent}");

			if (!("${legacyTicketEmailEvent}" == "")) {
				fail("A ${portalLegacyVersion} legacy ticket email may have been sent out.");
			}
		}
	}

	@prose = "non-legacy ticket emails related to the following ticketIds ${ticketIdList} for the support language ${supportLanguage} should not be sent out"
	macro _viewNoMultipleTicketReceptionEmails {
		for (var ticketId : list "${ticketIdList}") {
			var curl = '''
				--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
				-u ${zendeskAdminEmail}/token:${apiToken}
				''';

			var nonLegacyTicketEmailEvent = JSONCurlUtil.get("${curl}", "$.audits[0].events[?(@.via.source.from.title=='Notify requester of received request (${supportLanguage})')]");

			var nonLegacyTicketEmailEvent = StringUtil.replace("${nonLegacyTicketEmailEvent}", "[", "");

			var nonLegacyTicketEmailEvent = StringUtil.replace("${nonLegacyTicketEmailEvent}", "]", "");

			echo("Non-legacy ticket email event: ${nonLegacyTicketEmailEvent}");

			if (!("${nonLegacyTicketEmailEvent}" == "")) {
				fail("A non-legacy ticket email may have been sent out.");
			}
		}
	}

	@prose = "the tickets with the ticketIds ${ticketIdList} should not contain the tag ${tagName}"
	macro _viewNoSpecificTagForMultipleTickets {
		for (var ticketId : list "${ticketIdList}") {
			var existingTags = ZendeskTicketAPI._viewTicketExistingTagsById(ticketId = "${ticketId}");

			echo("Expected Tag Value: ${tagName}");
			echo("Actual Existing Tags: ${existingTags}");

			if (contains("${existingTags}", "${tagName}")) {
				fail("Actual tag values ${existingTags} in the ticket with ID value ${ticketId} contains the unexpected tag ${tagName}");
			}
		}
	}

	@prose = "an email regarding the reopening of ticketId ${ticketId} for the support language ${supportLanguage} containing the following parameters should be sent out to the ticket assignee ${table}"
	macro _viewReopenedTicketEmailToAssignee {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Recipients") {
				var curl = '''
					--tlsv1.2 ${zendeskURL}/api/v2/tickets/${ticketId}/audits.json
					-u ${zendeskAdminEmail}/token:${apiToken}
					''';

				var recipientIds = JSONCurlUtil.get("${curl}", "$.audits[?(@.events[?(@.previous_value=='solved')])].events[?(@.via.source.from.title=='Notify assignee of reopened ticket (${supportLanguage})')].recipients");

				var recipientIds = StringUtil.replace("${recipientIds}", "[", "");

				var recipientIds = StringUtil.replace("${recipientIds}", "]", "");

				echo("Recipient IDs from API: ${recipientIds}");

				var recipientsFromAPI = "";

				for (var recipientId : list "${recipientIds}") {
					var recipientFromAPI = ZendeskUserAPI._getUserNameById(userId = "${recipientId}");

					if ("${recipientsFromAPI}" == "") {
						var recipientsFromAPI = "${recipientFromAPI}";
					}
