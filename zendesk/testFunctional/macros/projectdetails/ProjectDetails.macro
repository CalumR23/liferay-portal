	@prose = "I go to the History tab"
	macro gotoHistory {
		AssertClick(
			locator1 = "ProjectDetailsProject#HISTORY_TAB",
			value1 = "History");
	}

	@prose = "I go to the Liferay Contacts tab"
	macro gotoLiferayContacts {
		AssertClick(
			locator1 = "ProjectDetailsProject#LIFERAY_CONTACTS_TAB",
			value1 = "Liferay Contacts");
	}

	@prose = "I go to the Offerings tab"
	macro gotoOfferings {
		AssertClick(
			locator1 = "ProjectDetailsProject#OFFERINGS_TAB",
			value1 = "Offerings");
	}

	@prose = "I go to the Overview tab"
	macro gotoOverview {
		AssertClick(
			locator1 = "ProjectDetailsProject#OVERVIEW_TAB",
			value1 = "Overview");
	}

	@prose = "I go to the project with the name ${projectName}"
	macro gotoProject {
		var key_projectName = "${projectName}";

		Click(locator1 = "ProjectDetails#PROJECT_NAME");

		AssertVisible(locator1 = "ProjectDetailsProject#PROJECT_HEADER");
	}

	@prose = "I go to the Project Details page"
	macro gotoProjectDetailsPage {
		Open(locator1 = "${supportURL}/project-details");

		AssertVisible(locator1 = "ProjectDetails#PROJECT_DETAILS_HEADER");
	}

	@prose = "I go to the Team Members tab"
	macro gotoTeamMembers {
		AssertClick(
			locator1 = "ProjectDetailsProject#TEAM_MEMBERS_TAB",
			value1 = "Team Members");
	}

	@prose = "I search for the project with the name ${projectName}"
	macro searchProject {
		Type(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = "&quot;${projectName}&quot;");

		KeyPress(
			locator1 = "ProjectDetails#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	@prose = "the project details with the following values should be visible ${table}"
	macro viewDetails {
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Project Code") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_CODE",
					value1 = "${value}");
			}
			else if ("${field}" == "Dossiera Account") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#DOSSIERA_ACCOUNT",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#STATUS",
					value1 = "${value}");
			}
			else if ("${field}" == "Level") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#LEVEL",
					value1 = "${value}");
			}
			else if ("${field}" == "Support Region") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#SUPPORT_REGION",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PARTNER",
					value1 = "${value}");
			}
			else if ("${field}" == "Partner Support") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PARTNER_SUPPORT",
					value1 = "${value}");
			}
			else if ("${field}" == "Tier") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TIER",
					value1 = "${value}");
			}
			else if ("${field}" == "Industry") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#INDUSTRY",
					value1 = "${value}");
			}
			else if ("${field}" == "Last Modified") {
				if ("${value}" == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonth();
					var year = DateUtil.getCurrentYear();

					var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

					var startDate = "${month}/${day}/${yearEdit}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#LAST_MODIFIED", value1 = "${startDate}")) {
						var day = DateUtil.getDate("1");
						var month = DateUtil.getMonth("1");
						var year = DateUtil.getYear("1");

						var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

						var startDate = "${month}/${day}/${yearEdit}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#LAST_MODIFIED",
							value1 = "${startDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#LAST_MODIFIED",
							value1 = "${startDate}");
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#LAST_MODIFIED",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Modified By") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#MODIFIED_BY",
					value1 = "${value}");
			}
			else {
				fail("No such project details field ${field}");
			}
		}
	}

	@prose = "the environment configuration with the name ${environmentName} should be visible with the following values ${table}"
	macro viewEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "Liferay Version") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_LIFERAY_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Commerce Version") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_COMMERCE_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Operating System") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_OPERATING_SYSTEM",
					value1 = "${value}");
			}
			else if ("${field}" == "Application Server") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_APPLICATION_SERVER",
					value1 = "${value}");
			}
			else if ("${field}" == "Search") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_SEARCH",
					value1 = "${value}");
			}
			else if ("${field}" == "Portal EXT") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_PORTAL_EXT",
					value1 = "${value}");
			}
			else if ("${field}" == "Java Version") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_JAVA_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Database") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_DATABASE",
					value1 = "${value}");
			}
			else if ("${field}" == "Cloud Services") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_CLOUD_SERVICES",
					value1 = "${value}");
			}
			else if ("${field}" == "Browser") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_BROWSER",
					value1 = "${value}");
			}
			else if ("${field}" == "Patch Info") {
				if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
					Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
				}

				AssertTextEquals(
					locator1 = "ProjectDetailsProject#ENVIRONMENT_PATCH_INFO",
					value1 = "${value}");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}
	}

	@prose = "the history entry in position number ${positionValue} with the field value ${fieldName} should be visible with the following values ${table}"
	macro viewHistoryEntry {
		var key_positionValue = "${positionValue}";
		var key_fieldName = "${fieldName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Updater Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Summary") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_SUMMARY",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Date") {
				if ("${value}" == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonth();
					var year = DateUtil.getCurrentYear();

					var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

					var startDate = "${month}/${day}/${yearEdit}";

					if (IsTextNotEqual.isNotPartialText(locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE", value1 = "${startDate}")) {
						var day = DateUtil.getDate("1");
						var month = DateUtil.getMonth("1");
						var year = DateUtil.getYear("1");

						var yearEdit = StringUtil.replaceFirst("${year}", "20", "");

						var startDate = "${month}/${day}/${yearEdit}";

						AssertTextEquals.assertPartialText(
							locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
							value1 = "${startDate}");
					}
					else {
						AssertTextEquals.assertPartialText(
							locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
							value1 = "${startDate}");						
					}
				}
				else {
					AssertTextEquals.assertPartialText(
						locator1 = "ProjectDetailsProject#HISTORY_UPDATE_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Update Field Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Field Original Value") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_ORIGINAL_VALUE",
					value1 = "${value}");
			}
			else if ("${field}" == "Update Field New Value") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#HISTORY_UPDATE_FIELD_NEW_VALUE",
					value1 = "${value}");
			}
			else {
				fail("No such history entry field ${field}");
			}
		}
	}

