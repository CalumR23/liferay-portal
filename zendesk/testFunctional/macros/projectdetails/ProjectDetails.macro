	@prose = "the environment configuration with the name ${environmentName} should not be visible"
	macro viewNoEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		AssertElementNotPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_NAME");
		AssertElementNotPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_PRODUCT");
		AssertElementNotPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_LIFERAY_VERSION");
	}

	@prose = "the offering with the product name ${productName} should not be visible"
	macro viewNoOffering {
		var key_productName = "${productName}";

		AssertElementNotPresent(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_PRODUCT");
	}

	@prose = "the offering with the product name ${productName} should be visible with the following values ${table}"
	macro viewOffering {
		var key_productName = "${productName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Product") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_PRODUCT",
					value1 = "${value}");
			}
			else if ("${field}" == "SLA") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SLA",
					value1 = "${value}");
			}
			else if ("${field}" == "Start Date") {
				if ("${value}" == "Today") {
					var day = DateUtil.getCurrentDate();
					var month = DateUtil.getCurrentMonthName();
					var year = DateUtil.getCurrentYear();

					var startDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE", value1 = "${startDate}")) {
						var day = DateUtil.getDate("1");
						var month = DateUtil.getMonthName("1");
						var year = DateUtil.getYear("1");	

						var startDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
							value1 = "${startDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
							value1 = "${startDate}");
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#PROJECT_OFFERING_START_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Support End Date") {
				if (contains("${value}", "years from now")) {
					var numberOfYearsFromNow = StringUtil.replace("${value}", " years from now", "");

					var year = DateUtil.getYear("-1");

					var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

					var day = DateUtil.getDate("-1");
					var month = DateUtil.getMonthName("-1");

					var supportEndDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE", value1 = "${supportEndDate}")) {
						var year = DateUtil.getYear("0");

						var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

						var day = DateUtil.getDate("0");
						var month = DateUtil.getMonthName("0");

						var supportEndDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
				}
				else if (contains("${value}", "year from now")) {
					var numberOfYearsFromNow = StringUtil.replace("${value}", " year from now", "");

					var year = DateUtil.getYear("-1");

					var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

					var day = DateUtil.getDate("-1");
					var month = DateUtil.getMonthName("-1");

					var supportEndDate = "${month} ${day}, ${year}";

					if (IsTextNotEqual(locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE", value1 = "${supportEndDate}")) {
						var year = DateUtil.getYear("0");

						var year = MathUtil.sum("${year}", "${numberOfYearsFromNow}");

						var day = DateUtil.getDate("0");
						var month = DateUtil.getMonthName("0");

						var supportEndDate = "${month} ${day}, ${year}";

						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
					else {
						AssertTextEquals(
							locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
							value1 = "${supportEndDate}");
					}
				}
				else {
					AssertTextEquals(
						locator1 = "ProjectDetailsProject#PROJECT_OFFERING_SUPPORT_END_DATE",
						value1 = "${value}");
				}
			}
			else if ("${field}" == "Licenses") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_LICENSES",
					value1 = "${value}");
			}
			else if ("${field}" == "Tickets") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_TICKETS",
					value1 = "${value}");
			}
			else if ("${field}" == "Version") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_VERSION",
					value1 = "${value}");
			}
			else if ("${field}" == "Instance Size") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_INSTANCE_SIZE",
					value1 = "${value}");
			}
			else if ("${field}" == "Status") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#PROJECT_OFFERING_STATUS",
					value1 = "${value}");
			}
			else {
				fail("No such offering field ${field}");
			}
		}
	}

	@prose = "I should be able to view the project in the Project Details index with the name ${projectName} and status ${projectStatus}"
	macro viewProjectViaIndex {
		var key_projectName = "${projectName}";

		AssertTextEquals(
			locator1 = "ProjectDetails#PROJECT_NAME",
			value1 = "${projectName}");

		AssertTextEquals(
			locator1 = "ProjectDetails#PROJECT_STATUS",
			value1 = "${projectStatus}");
	}

	@prose = "the support instructions with the content ${supportInstructionsContent} should be visible"
	macro viewSupportInstructions {
		AssertTextEquals(
			locator1 = "ProjectDetailsProject#SUPPORT_INSTRUCTIONS_CONTENT",
			value1 = "${supportInstructionsContent}");
	}

	@prose = "the team member with the name ${teamMemberName} should be visible with the following values ${table}"
	macro viewTeamMember {
		var key_teamMemberName = "${teamMemberName}";

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TEAM_MEMBER_NAME",
					value1 = "${value}");
			}
			else if ("${field}" == "Role") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TEAM_MEMBER_ROLE",
					value1 = "${value}");
			}
			else if ("${field}" == "Email") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TEAM_MEMBER_EMAIL",
					value1 = "${value}");
			}
			else if ("${field}" == "Contact Number") {
				AssertTextEquals(
					locator1 = "ProjectDetailsProject#TEAM_MEMBER_CONTACT_NUMBER",
					value1 = "${value}");
			}
			else {
				fail("No such team member field ${field}");
			}
		}
	}
}