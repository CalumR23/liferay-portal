definition {
	var supportURL = PropsUtil.get("support.liferay.url");

	@prose = "I add an environment configuration with the following values ${table}"
	macro addEnvironmentConfiguration {
		Click(locator1 = "ProjectDetailsProject#ADD_ENVIRONMENT_CONFIGURATION_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Commerce Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#COMMERCE_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Liferay Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#LIFERAY_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Operating System") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#OPERATING_SYSTEM_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Java Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#JAVA_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Application Server") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#APPLICATION_SERVER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Database") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#DATABASE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Cloud Services") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#CLOUD_SERVICES_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Browser") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#BROWSER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Search") {
				var key_option= "${value}";

				Click(locator1 = "ProjectDetailsEnvironmentForm#SEARCH_SELECT_OPTION");
			}
			else if ("${field}" == "Portal EXT") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Patch Info") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

	@prose = "I add support instructions with the content ${supportInstructionsContent}"
	macro addSupportInstructions {
		Click(locator1 = "ProjectDetailsProject#ADD_SUPPORT_INSTRUCTIONS_BUTTON");

		SelectFrame(locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_IFRAME");

		Click(locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_BODY");

		Type.sendKeys(
			locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_BODY",
			value1 = "${supportInstructionsContent}");

		SelectFrameTop();		

		Button.save();

		Message.success();
	}

	@prose = "I delete the environment configuration with the name ${environmentName}"
	macro deleteEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DELETE_BUTTON");

		Confirm(value1 = "Are you sure you want to delete this?");

		Message.success();
	}

	@prose = "I edit the environment configuration with the name ${environmentName} with the following values ${table}"
	macro editEnvironmentConfiguration {
		var key_environmentName = "${environmentName}";

		if (IsElementPresent(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON")) {
			Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_DETAILS_EXPAND_BUTTON");
		}

		Click(locator1 = "ProjectDetailsProject#ENVIRONMENT_EDIT_BUTTON");

		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "Name") {
				Type(
					locator1 = "ProjectDetailsEnvironmentForm#NAME_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Product") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#PRODUCT_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Commerce Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#COMMERCE_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Liferay Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#LIFERAY_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Operating System") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#OPERATING_SYSTEM_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Java Version") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#JAVA_VERSION_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Application Server") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#APPLICATION_SERVER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Database") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#DATABASE_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Cloud Services") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#CLOUD_SERVICES_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Browser") {
				Select(
					locator1 = "ProjectDetailsEnvironmentForm#BROWSER_SELECT",
					value1 = "${value}");
			}
			else if ("${field}" == "Search") {
				var key_option= "${value}";

				Click(locator1 = "ProjectDetailsEnvironmentForm#SEARCH_SELECT_OPTION");
			}
			else if ("${field}" == "Portal EXT") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PORTAL_EXT_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else if ("${field}" == "Patch Info") {
				MakeVisible(locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD");

				UploadCommonFile(
					locator1 = "ProjectDetailsEnvironmentForm#PATCH_LEVEL_UPLOAD_FIELD",
					value1 = "${value}");
			}
			else {
				fail("No such environment configuration field ${field}");
			}
		}

		Button.save();

		Message.success();
	}

	@prose = "I edit support instructions with the content ${supportInstructionsContent}"
	macro editSupportInstructions {
		Click(locator1 = "ProjectDetailsProject#EDIT_SUPPORT_INSTRUCTIONS_BUTTON");

		SelectFrame(locator1 = "ProjectDetailsSupportInstructionsForm#SUPPORT_INSTRUCTIONS_TEXT_IFRAME");

