definition {

	macro gotoKBCategories {
		ProductMenu.expandPanelSites();

		ProductMenu.gotoSitesContent(portlet = "Categories");
	}

	macro gotoKBSearch {
		Click(locator1 = "KBHome#SUPPORT_KBASE_LINK");
	}

	macro gotoKBSearchViaURL {
		var customerPortalURL = PropsUtil.get("customer.liferay.url");

		Open(locator1 = "${customerPortalURL}/documentation/search");
	}

	macro gotoKBWebContent {
		ProductMenu.expandPanelSites();

		ProductMenu.gotoSitesContent(portlet = "Web Content");
	}

	macro gotoKBWebContentViaArticle {
		KBNavigation.gotoKBSearch();

		Click(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_TITLE");

		Click(locator1 = "KBArticle#SUGGEST_AN_EDIT_LINK");

		KBNavigation.gotoKBWebContent();
	}

}