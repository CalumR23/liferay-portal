<definition>
	<command name="gotoKBCategories">
		<execute macro="ProductMenu#expandPanelSites" />

		<execute macro="ProductMenu#gotoSitesContent">
			<var name="portlet" value="Categories" />
		</execute>
	</command>

	<command name="gotoKBSearch">
		<execute function="Click" locator1="KBHome#SUPPORT_KBASE_LINK" />
	</command>

	<command name="gotoKBSearchViaURL">
		<var method="TestPropsUtil#get('customer.liferay.url')" name="customerPortalURL" />

		<execute function="Open" locator1="${customerPortalURL}/documentation/search" />
	</command>

	<command name="gotoKBWebContent">
		<execute macro="ProductMenu#expandPanelSites" />

		<execute macro="ProductMenu#gotoSitesContent">
			<var name="portlet" value="Web Content" />
		</execute>
	</command>

	<command name="gotoKBWebContentViaArticle">
		<execute macro="KBNavigation#gotoKBSearch" />

		<execute function="Click" locator1="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" />

		<execute function="Click" locator1="KBArticle#ARTICLE_SIDE_BAR_SUGGEST_AN_EDIT_LINK" />

		<execute macro="KBNavigation#gotoKBWebContent" />
	</command>
</definition>