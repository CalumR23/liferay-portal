definition {

	var supportURL = PropsUtil.get("customer.liferay.url");

	macro login {
		Open(locator1 = "${supportURL}");

		Type(
			locator1 = "KBLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "KBLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "KBLogin#SIGN_IN_BUTTON");

		AssertElementPresent(locator1 = "KBHome#BROWSE_BY_PRODUCT_HEADING");
	}

	macro logout {
		Open(locator1 = "${supportURL}/c/portal/logout");
	}

	macro logoutAndLogin {
		KBUser.logout();

		KBUser.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	macro setLocale {
		Click(locator1 = "KBUser#USER_AVATAR_IMAGE");

		Click(locator1 = "KBUser#LANGUAGE_TOGGLE");

		var key_language = "${language}";

		if (IsElementNotPresent(locator1 = "KBUser#LANGUAGE_LIST_ITEM_SELECTED")) {
			Click(locator1 = "KBUser#LANGUAGE_LIST_ITEM");
		}
	}

}