<definition>
	<var method="TestPropsUtil#get('customer.liferay.url')" name="supportURL" />

	<command name="login">
		<execute function="Open" locator1="${supportURL}" />

		<execute function="Type" locator1="KBLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="KBLogin#PASSWORD_FIELD" value1="${userPassword}" />
		<execute function="Click" locator1="KBLogin#SIGN_IN_BUTTON" />
	</command>

	<command name="logout">
		<execute function="Open" locator1="${supportURL}/c/portal/logout" />
	</command>

	<command name="logoutAndLogin">
		<execute macro="KBUser#logout" />

		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>
	</command>

	<command name="setLocale">
		<execute function="Click" locator1="KBUser#USER_AVATAR_IMAGE" />
		<execute function="Click" locator1="KBUser#LANGUAGE_TOGGLE" />

		<var name="key_language" value="${language}" />

		<if>
			<condition function="IsElementPresent" locator1="KBUser#LANGUAGE_LIST_ITEM" />
			<then>
				<execute function="Click" locator1="KBUser#LANGUAGE_LIST_ITEM" />
			</then>
		</if>
	</command>
</definition>