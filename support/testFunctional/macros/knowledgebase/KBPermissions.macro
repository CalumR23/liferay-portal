<definition>
	<command name="viewNoRSMSiteAccess">
		<while>
			<condition function="IsElementNotPresent" locator1="KBHome#NAV_USER_MENU_OPEN" />
			<then>
				<execute function="Click" locator1="KBHome#NAV_USER_MENU" />
			</then>
		</while>

		<var name="key_item" value="Regional Support Management - Knowledge Base" />

		<execute function="AssertElementNotPresent" locator1="KBHome#MY_PLACES_MENU_ITEM" />
	</command>

	<command name="viewOfficialDocumentation">
		<execute macro="KBNavigation#gotoKBSearch" />

		<execute macro="KBSearch#uncheckFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Official Documentation" />
		</execute>

		<execute macro="KBSearch#viewSearchResultNotEmpty" />

		<execute macro="KBSearch#viewSearchResultOfficialDocumentation" />
	</command>
</definition>