definition {

	macro viewNoRSMSiteAccess {
		while (IsElementNotPresent(locator1 = "KBHome#NAV_USER_MENU_OPEN")) {
			Click(locator1 = "KBHome#NAV_USER_MENU");
		}

		var key_item = "Regional Support Management - Knowledge Base";

		AssertElementNotPresent(locator1 = "KBHome#MY_PLACES_MENU_ITEM");
	}

	macro viewOfficialDocumentation {
		KBNavigation.gotoKBSearch();

		KBSearch.uncheckFilter(filter = "Knowledge Base");

		KBSearch.checkFilter(filter = "Official Documentation");

		KBSearch.viewSearchResultNotEmpty();

		KBSearch.viewSearchResultOfficialDocumentation();
	}

	macro viewSupportKBaseLinkNotPresent {
		AssertElementNotPresent(locator1 = "KBHome#SUPPORT_KBASE_LINK");
	}

}