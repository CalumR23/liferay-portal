<definition>
	<command name="viewNoRSMSiteAccess">
		<while>
			<condition function="IsElementNotPresent" locator1="KBHome#NAV_USER_MENU_OPEN" />
			<then>
				<execute function="Click" locator1="KBHome#NAV_USER_MENU" />
			</then>
		</while>

		<var name="key_item" value="Regional Support Management - Knowledge Base" />

		<execute function="AssertElementNotPresent" locator1="KBHome#MY_PLACES_MENU_ITEM" />
	</command>
</definition>