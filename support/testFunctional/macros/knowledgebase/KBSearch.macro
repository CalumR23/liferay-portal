definition {

	macro checkFilter {
		var key_filter = "${filter}";

		Check(locator1 = "KBSearch#FILTER_CHECKBOX");
	}

	macro checkLanguageFilter {
		var key_filter = "${filter}";

		Check(locator1 = "KBSearch#LANGUAGE_FILTER_CHECKBOX");
	}

	macro checkPermissionFilter {
		var key_filter = "${filter}";

		Check(locator1 = "KBSearch#PERMISSION_FILTER_CHECKBOX");
	}

	macro expandFilterGroup {
		var key_group = "${group}";

		if (IsElementNotPresent(locator1 = "KBSearch#FILTER_GROUP_MINUS_ICON")) {
			Click(locator1 = "KBSearch#FILTER_GROUP_PLUS_ICON");
		}
	}

	macro filterExternalArticle {
		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.expandFilterGroup(group = "Permission");

		KBSearch.checkPermissionFilter(filter = "External");

		KBSearch.uncheckPermissionFilter(filter = "Internal");
	}

	macro filterInternalArticle {
		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.expandFilterGroup(group = "Permission");

		KBSearch.checkPermissionFilter(filter = "Internal");

		KBSearch.uncheckPermissionFilter(filter = "External");
	}

	macro getFirstArticleTitle {
		var title = selenium.getText("KBSearch#SEARCH_RESULT_ARTICLE_TITLE");

		return "${title}";
	}

	macro getSearchResultCount {
		var count = selenium.getText("KBSearch#SEARCH_RESULT_DISPLAY");

		var count = StringUtil.extractLast("${count}", "-");

		var count = StringUtil.extractFirst("${count}", "of");

		var count = StringUtil.trim("${count}");

		return "${count}";
	}

	macro searchByKeyword {
		Type(
			locator1 = "KBSearch#SEARCH_KEYWORD_INPUT",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "KBSearch#SEARCH_KEYWORD_INPUT",
			value1 = "\RETURN");
	}

	macro uncheckFilter {
		var key_filter = "${filter}";

		Uncheck(locator1 = "KBSearch#FILTER_CHECKBOX");
	}

	macro uncheckLanguageFilter {
		var key_filter = "${filter}";

		Uncheck(locator1 = "KBSearch#LANGUAGE_FILTER_CHECKBOX");
	}

	macro uncheckPermissionFilter {
		var key_filter = "${filter}";

		Uncheck(locator1 = "KBSearch#PERMISSION_FILTER_CHECKBOX");
	}

	macro viewFilter {
		var key_filter = "${filter}";
		var key_group = "${group}";

		AssertElementPresent(locator1 = "KBSearch#FILTER_CATEGORY");
	}

	macro viewFilterGroup {
		var key_group = "${group}";

		AssertElementPresent(locator1 = "KBSearch#FILTER_GROUP");
	}

	macro viewFilterNotPresent {
		var key_filter = "${key_filter}";

		AssertElementNotPresent(locator1 = "KBSearch#FILTER_LABEL");
	}

	macro viewFirstNResultsJapanese {
		var key_n = "1";
		var count = ${count} + 1;

		while ("${key_n}" != "${count}" && (maxIterations = "20")) {
			AssertElementPresent(locator1 = "KBSearch#NTH_SEARCH_RESULT_JAPANESE");

			var key_n = ${key_n} + 1;
		}
	}

	macro viewFirstPageSearchResultCategory {
		var key_n = "1";

		while (IsElementPresent(locator1 = "KBSearch#NTH_SEARCH_RESULT_ARTICLE_CATEGORY") && (maxIterations = "30")) {
			AssertTextEquals.assertPartialText(
				locator1 = "KBSearch#NTH_SEARCH_RESULT_ARTICLE_CATEGORY",
				value1 = "${category}");

			var key_n = ${key_n} + 1;
		}
	}

	macro viewFirstSearchResultCategory {
		AssertTextEquals.assertPartialText(
			locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_CATEGORY",
			value1 = "${category}");

		AssertTextNotEquals(
			locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_CATEGORY",
			value1 = "Web Content");
	}

	macro viewFirstSearchResultTitle {
		AssertTextEquals(
			locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_TITLE",
			value1 = "${title}");
	}

	macro viewKBArticleOnFirstPageResults {
		AssertTextEquals.assertPartialText(
			locator1 = "KBSearch#SEARCH_RESULT_KB_ARTICLE",
			value1 = "Knowledge Base");
	}

	macro viewOfficialDocOnFirstPageResults {
		AssertTextEquals.assertPartialText(
			locator1 = "KBSearch#SEARCH_RESULT_OFFICIAL_DOC",
			value1 = "Official Documentation");
	}

	macro viewSearchResultEmpty {
		AssertElementNotPresent(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE");
	}

	macro viewSearchResultKBArticle {
		KBSearch.viewFirstSearchResultCategory(category = "Knowledge Base");

		var title = KBSearch.getFirstArticleTitle();

		Click(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_TITLE");

		AssertTextEquals(
			locator1 = "KBArticle#DOCUMENT_TITLE",
			value1 = "${title}");
	}

	macro viewSearchResultNotEmpty {
		AssertElementPresent(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE");
	}

	macro viewSearchResultOfficialDocumentation {
		var title = KBSearch.getFirstArticleTitle();

		Click(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_TITLE");

		AssertTextEquals(
			locator1 = "KBOfficialDocument#DOCUMENT_TITLE",
			value1 = "${title}");
	}

	macro viewSuggestAnEditLinkNotPresent {
		Click(locator1 = "KBSearch#SEARCH_RESULT_ARTICLE_TITLE");

		AssertElementNotPresent(locator1 = "SUGGEST_AN_EDIT_LINK");
	}

}