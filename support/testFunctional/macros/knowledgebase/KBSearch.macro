<definition>
	<command name="checkFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Check" locator1="KBSearch#FILTER_CHECKBOX" />
	</command>

	<command name="uncheckFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Uncheck" locator1="KBSearch#FILTER_CHECKBOX" />
	</command>

	<command name="viewSearchResultNotEmpty">
		<execute function="AssertElementPresent" locator1="KBSearch#SEARCH_RESULT_ARTICLE" />
	</command>

	<command name="viewSearchResultOfficialDocumentation">
		<var locator="KBSearch#SEARCH_RESULT_OFFICIAL_DOCUMENTATION" name="docTitle" />

		<execute function="Click" locator1="KBSearch#SEARCH_RESULT_OFFICIAL_DOCUMENTATION" />

		<execute function="AssertTextEquals" locator1="KBDocument#DOCUMENT_TITLE" value1="${docTitle}" />
	</command>
</definition>