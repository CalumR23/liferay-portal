<definition>
	<command name="checkFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Check" locator1="KBSearch#FILTER_CHECKBOX" />
	</command>

	<command name="checkLanguageFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Check" locator1="KBSearch#LANGUAGE_FILTER_CHECKBOX" />
	</command>

	<command name="checkPermissionFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Check" locator1="KBSearch#PERMISSION_FILTER_CHECKBOX" />
	</command>

	<command name="expandFilterGroup">
		<var name="key_group" value="${group}" />

		<if>
			<condition function="IsElementNotPresent" locator1="KBSearch#FILTER_GROUP_MINUS_ICON" />
			<then>
				<execute function="Click" locator1="KBSearch#FILTER_GROUP_PLUS_ICON" />
			</then>
		</if>
	</command>

	<command name="filterExternalArticle">
		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#expandFilterGroup">
			<var name="group" value="Permission" />
		</execute>

		<execute macro="KBSearch#checkPermissionFilter">
			<var name="filter" value="External" />
		</execute>

		<execute macro="KBSearch#uncheckPermissionFilter">
			<var name="filter" value="Internal" />
		</execute>
	</command>

	<command name="filterInternalArticle">
		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#expandFilterGroup">
			<var name="group" value="Permission" />
		</execute>

		<execute macro="KBSearch#checkPermissionFilter">
			<var name="filter" value="Internal" />
		</execute>

		<execute macro="KBSearch#uncheckPermissionFilter">
			<var name="filter" value="External" />
		</execute>
	</command>

	<command name="getFirstArticleTitle" returns="title">
		<var locator="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" name="title" />

		<return name="title" value="${title}" />
	</command>

	<command name="getSearchResultCount" returns="count">
		<var locator="KBSearch#SEARCH_RESULT_DISPLAY" name="count" />

		<var method="StringUtil#extractLast('${count}','-')" name="count" />

		<var method="StringUtil#extractFirst('${count}','of')" name="count" />

		<var method="StringUtil#trim('${count}')" name="count" />

		<return name="count" value="${count}" />
	</command>

	<command name="searchByKeyword">
		<execute function="Type" locator1="KBSearch#SEARCH_KEYWORD_INPUT" value1="${keyword}" />
		<execute function="KeyPress" locator1="KBSearch#SEARCH_KEYWORD_INPUT" value1="\RETURN"  />
	</command>

	<command name="uncheckFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Uncheck" locator1="KBSearch#FILTER_CHECKBOX" />
	</command>

	<command name="uncheckLanguageFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Uncheck" locator1="KBSearch#LANGUAGE_FILTER_CHECKBOX" />
	</command>

	<command name="uncheckPermissionFilter">
		<var name="key_filter" value="${filter}" />

		<execute function="Uncheck" locator1="KBSearch#PERMISSION_FILTER_CHECKBOX" />
	</command>

	<command name="viewFilter">
		<var name="key_filter" value="${filter}" />
		<var name="key_group" value="${group}" />

		<execute function="AssertElementPresent" locator1="KBSearch#FILTER_CATEGORY" />
	</command>

	<command name="viewFilterGroup">
		<var name="key_group" value="${group}" />

		<execute function="AssertElementPresent" locator1="KBSearch#FILTER_GROUP" />
	</command>

	<command name="viewFilterNotPresent">
		<var name="key_filter" value="${key_filter}" />

		<execute function="AssertElementNotPresent" locator1="KBSearch#FILTER_LABEL" />
	</command>

	<command name="viewFirstNResultsJapanese">
		<var name="key_n" value="1" />

		<var method="MathUtil#sum('${count}','1')" name="count" />

		<while max-iterations="20">
			<not>
				<equals arg1="${key_n}" arg2="${count}" />
			</not>
			<then>
				<execute function="AssertElementPresent" locator1="KBSearch#NTH_SEARCH_RESULT_JAPANESE" />

				<var method="MathUtil#sum('${key_n}','1')" name="key_n" />
			</then>
		</while>
	</command>

	<command name="viewFirstPageSearchResultCategory">
		<var name="key_n" value="1" />

		<while max-iterations="30">
			<condition function="IsElementPresent" locator1="KBSearch#NTH_SEARCH_RESULT_ARTICLE_CATEGORY" />
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="KBSearch#NTH_SEARCH_RESULT_ARTICLE_CATEGORY" value1="${category}" />

				<var method="MathUtil#sum('${key_n}','1')" name="key_n" />
			</then>
		</while>
	</command>

	<command name="viewFirstSearchResultCategory">
		<execute function="AssertTextEquals#assertPartialText" locator1="KBSearch#SEARCH_RESULT_ARTICLE_CATEGORY" value1="${category}" />
		<execute function="AssertTextNotEquals" locator1="KBSearch#SEARCH_RESULT_ARTICLE_CATEGORY" value1="Web Content" />
	</command>

	<command name="viewFirstSearchResultTitle">
		<execute function="AssertTextEquals" locator1="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" value1="${title}" />
	</command>

	<command name="viewKBArticleOnFirstPageResults">
		<execute function="AssertTextEquals#assertPartialText" locator1="KBSearch#SEARCH_RESULT_KB_ARTICLE" value1="Knowledge Base" />
	</command>

	<command name="viewOfficialDocOnFirstPageResults">
		<execute function="AssertTextEquals#assertPartialText" locator1="KBSearch#SEARCH_RESULT_OFFICIAL_DOC" value1="Official Documentation" />
	</command>

	<command name="viewSearchResultEmpty">
		<execute function="AssertElementNotPresent" locator1="KBSearch#SEARCH_RESULT_ARTICLE" />
	</command>

	<command name="viewSearchResultKBArticle">
		<execute macro="KBSearch#viewFirstSearchResultCategory">
			<var name="category" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#getFirstArticleTitle">
			<return from="title" name="title" />
		</execute>

		<execute function="Click" locator1="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" />

		<execute function="AssertTextEquals" locator1="KBArticle#DOCUMENT_TITLE" value1="${title}" />

		<if>
			<isset var="permission" />
			<then>
				<if>
					<equals arg1="${permission}" arg2="Internal" />
					<then>
						<execute function="AssertElementPresent" locator1="KBArticle#ARTICLE_SIDE_BAR_PERMISSIONS_INTERNAL" />
					</then>
					<elseif>
						<equals arg1="${permission}" arg2="External" />
						<then>
							<execute function="AssertElementPresent" locator1="KBArticle#ARTICLE_SIDE_BAR_PERMISSIONS_EXTERNAL" />
						</then>
					</elseif>
					<else>
						<fail message="Wrong permission type." />
					</else>
				</if>
			</then>
		</if>
	</command>

	<command name="viewSearchResultNotEmpty">
		<execute function="AssertElementPresent" locator1="KBSearch#SEARCH_RESULT_ARTICLE" />
	</command>

	<command name="viewSearchResultOfficialDocumentation">
		<execute macro="KBSearch#getFirstArticleTitle">
			<return from="title" name="title" />
		</execute>

		<execute function="Click" locator1="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" />

		<execute function="AssertTextEquals" locator1="KBOfficialDocument#DOCUMENT_TITLE" value1="${title}" />
	</command>

	<command name="viewSuggestAnEditLinkNotPresent">
		<execute function="Click" locator1="KBSearch#SEARCH_RESULT_ARTICLE_TITLE" />

		<execute function="AssertElementNotPresent" locator1="ARTICLE_SIDE_BAR_SUGGEST_AN_EDIT_LINK" />
	</command>
</definition>