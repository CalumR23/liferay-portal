<definition>
	<command name="clickPaginationButton">
		<var name="key_button" value="${button}" />

		<execute function="Click" locator1="KBSearch#PAGINATION_BUTTON_ENABLED" />
	</command>

	<command name="selectPage">
		<var name="key_item" value="${page}" />

		<execute function="Click" locator1="KBSearch#CURRENT_PAGE_DROPDOWN" />
		<execute function="Click" locator1="KBSearch#PAGINATION_DROPDOWN_LIST_ITEM" />
	</command>

	<command name="viewPaginationButtonsDisabled">
		<for list="${buttons}" param="key_button">
			<execute function="AssertElementPresent" locator1="KBSearch#PAGINATION_BUTTON_DISABLED" />
		</for>
	</command>

	<command name="viewPaginationButtonsEnabled">
		<for list="${buttons}" param="key_button">
			<execute function="AssertElementPresent" locator1="KBSearch#PAGINATION_BUTTON_ENABLED" />
		</for>
	</command>

	<command name="viewPaginationDropdownLabel">
		<execute function="AssertTextEquals" locator1="KBSearch#PAGINATION_DROPDOWN" value1="${numItems} Items per Page" />
	</command>

	<command name="viewPaginationDropdownList">
		<execute function="Click" locator1="KBSearch#PAGINATION_DROPDOWN" />

		<for list="${list}" param="key_item">
			<execute function="AssertElementPresent" locator1="KBSearch#PAGINATION_DROPDOWN_LIST_ITEM" />
		</for>

		<var method="StringUtil#count('${list}',',')" name="numItems" />

		<var method="MathUtil#sum('${numItems}','2')" name="key_n" />

		<execute function="AssertNotVisible" locator1="KBSearch#PAGINATION_DROPDOWN_NTH_LIST_ITEM" />
		<execute function="Click" locator1="KBSearch#PAGINATION_DROPDOWN" />
	</command>
</definition>