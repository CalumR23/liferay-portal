definition {

	macro clickPaginationButton {
		var key_button = "${button}";

		Click(locator1 = "KBSearch#PAGINATION_BUTTON_ENABLED");
	}

	macro selectItemsPerPage {
		var key_item = "${numItems}";

		Click(locator1 = "KBSearch#PAGINATION_DROPDOWN");

		Click(locator1 = "KBSearch#PAGINATION_DROPDOWN_LIST_ITEM");
	}

	macro selectPage {
		var key_item = "${page}";

		Click(locator1 = "KBSearch#CURRENT_PAGE_DROPDOWN");

		Click(locator1 = "KBSearch#PAGINATION_DROPDOWN_LIST_ITEM");
	}

	macro viewPaginationButtonsDisabled {
		for (var key_button : list "${buttons}") {
			AssertElementPresent(locator1 = "KBSearch#PAGINATION_BUTTON_DISABLED");
		}
	}

	macro viewPaginationButtonsEnabled {
		for (var key_button : list "${buttons}") {
			AssertElementPresent(locator1 = "KBSearch#PAGINATION_BUTTON_ENABLED");
		}
	}

	macro viewPaginationDropdownLabel {
		AssertTextEquals(
			locator1 = "KBSearch#PAGINATION_DROPDOWN",
			value1 = "${numItems} Items per Page");
	}

	macro viewPaginationDropdownList {
		Click(locator1 = "KBSearch#PAGINATION_DROPDOWN");

		for (var key_item : list "${list}") {
			AssertElementPresent(locator1 = "KBSearch#PAGINATION_DROPDOWN_LIST_ITEM");
		}

		var numItems = StringUtil.count("${list}", ",");

		var key_n = ${numItems} + 2;

		AssertNotVisible(locator1 = "KBSearch#PAGINATION_DROPDOWN_NTH_LIST_ITEM");

		Click(locator1 = "KBSearch#PAGINATION_DROPDOWN");
	}

}