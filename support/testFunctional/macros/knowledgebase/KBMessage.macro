definition {

	macro closeSuccessMessage {
		Click(locator1 = "KBMessage#SUCCESS_MESSAGE_CLOSE_BUTTON");
	}

	macro success {
		if (isSet(message)) {
			AssertTextEquals(
				locator1 = "KBMessage#SUCCESS_MESSAGE",
				value1 = "${message}");
		}
		else {
			AssertTextEquals(
				locator1 = "KBMessage#SUCCESS_MESSAGE",
				value1 = "Your request completed successfully.");
		}
	}

}