<definition>
	<command name="closeSuccessMessage">
		<execute function="Click" locator1="KBMessage#SUCCESS_MESSAGE_CLOSE_BUTTON" />
	</command>

	<command name="success">
		<if>
			<isset var="message" />
			<then>
				<execute function="AssertTextEquals" locator1="KBMessage#SUCCESS_MESSAGE" value1="${message}" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="KBMessage#SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</else>
		</if>
	</command>
</definition>