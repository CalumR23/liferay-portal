definition {

	macro expandCategory {
		var key_category = "${category}";

		if (IsElementPresent(locator1 = "ProductMenu#CATEGORY_COLLAPSED")) {
			Click(locator1 = "ProductMenu#CATEGORY_COLLAPSED");
		}

		AssertElementPresent(locator1 = "ProductMenu#CATEGORY_EXPANDED");
	}

	macro expandPanelSites {
		ProductMenu.openProductMenu();

		if (IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_TABS_SITES_COLLAPSED")) {
			Click(locator1 = "ProductMenu#PRODUCT_MENU_TABS_SITES_COLLAPSED");
		}

		AssertElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_TABS_SITES_EXPANDED");

		var key_panelId = "site";

		AssertVisible(locator1 = "ProductMenu#PRODUCT_MENU_TABS_EXPANDED_PANEL");
	}

	macro gotoPortlet {
		AssertClick.assertPartialTextClickAt(
			key_portlet = "${portlet}",
			locator1 = "ProductMenu#PORTLET",
			value1 = "${portlet}");
	}

	@summary = "Navigate to Product Menu > Sites > Content > ${portlet}"
	macro gotoSitesContent {
		ProductMenu.expandPanelSites();

		ProductMenu.expandCategory(category = "Content");

		ProductMenu.gotoPortlet(portlet = "${portlet}");
	}

	macro openProductMenu {
		if (IsElementNotPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click(locator1 = "ProductMenu#TOGGLE");
		}

		AssertElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED");
	}

}