<definition>
	<command name="addArticleTypeCategory">
		<var name="key_name" value="Article Type" />

		<execute function="AssertClick" locator1="KBCategories#CATEGORY_NAME_LINK" value1="Article Type" />
		<execute function="Click" locator1="KBCategories#ADD_BUTTON" />
		<execute function="Type" locator1="KBCategories#NAME_FIELD" value1="${name}" />
		<execute function="Click" locator1="KBCategories#SAVE_BUTTON" />

		<execute macro="KBMessage#success" />
	</command>

	<command name="deleteArticleTypeCategory">
		<var name="key_name" value="Article Type" />

		<execute function="Click" locator1="KBCategories#CATEGORY_NAME_LINK" />

		<execute macro="KBSiteAdminHelper#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Delete" />
			<var name="title" value="${title}" />
		</execute>

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="KBMessage#success" />
	</command>
</definition>