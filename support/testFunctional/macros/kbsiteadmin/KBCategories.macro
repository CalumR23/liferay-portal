definition {

	macro addCategory {
		var key_name = "${vocabulary}";

		Click(locator1 = "KBCategories#DESCRIPTIVE_BUTTON");

		AssertClick(
			locator1 = "KBCategories#CATEGORY_NAME_LINK",
			value1 = "${vocabulary}");

		Click(locator1 = "KBCategories#ADD_BUTTON");

		Type(
			locator1 = "KBCategories#NAME_FIELD",
			value1 = "${name}");

		Click(locator1 = "KBCategories#SAVE_BUTTON");

		KBMessage.success();
	}

	macro addVocabulary {
		var key_name = "${name}";

		Click(locator1 = "KBCategories#ADD_BUTTON");

		Type(
			locator1 = "KBCategories#NAME_FIELD",
			value1 = "${name}");

		Click(locator1 = "KBCategories#SAVE_BUTTON");

		KBMessage.success();
	}

	macro deleteCategory {
		var key_name = "${vocabulary}";

		Click(locator1 = "KBCategories#CATEGORY_NAME_LINK");

		KBSiteAdminHelper.deleteRowWithSearch(title = "${title}");
	}

}