<definition>
	<command name="addCategory">
		<var name="key_name" value="${vocabulary}" />

		<execute function="AssertClick" locator1="KBCategories#CATEGORY_NAME_LINK" value1="${vocabulary}" />
		<execute function="Click" locator1="KBCategories#ADD_BUTTON" />
		<execute function="Type" locator1="KBCategories#NAME_FIELD" value1="${name}" />
		<execute function="Click" locator1="KBCategories#SAVE_BUTTON" />

		<execute macro="KBMessage#success" />
	</command>

	<command name="addVocabulary">
		<var name="key_name" value="${name}" />

		<execute function="Click" locator1="KBCategories#ADD_BUTTON" />
		<execute function="Type" locator1="KBCategories#NAME_FIELD" value1="${name}" />
		<execute function="Click" locator1="KBCategories#SAVE_BUTTON" />

		<execute macro="KBMessage#success" />
	</command>

	<command name="deleteCategory">
		<var name="key_name" value="${vocabulary}" />

		<execute function="Click" locator1="KBCategories#CATEGORY_NAME_LINK" />

		<execute macro="KBSiteAdminHelper#deleteRow">
			<var name="title" value="${title}" />
		</execute>
	</command>
</definition>