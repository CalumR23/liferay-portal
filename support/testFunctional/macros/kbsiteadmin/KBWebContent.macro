<definition>
	<command name="addArticleDisplay">
		<execute function="Click" locator1="KBWebContent#ADD_BUTTON" />

		<var name="key_menu_item" value="Article Display" />

		<execute function="Click" locator1="KBWebContent#ADD_MENU_ITEM" />
		<execute function="Type" locator1="KBWebContent#TITLE_FIELD" value1="${title}" />

		<if>
			<isset var="permissions" />
			<then>
				<execute function="Select" locator1="KBWebContent#PERMISSIONS_SELECT" value1="${permissions}" />
			</then>
		</if>

		<execute function="Click" locator1="KBWebContent#PUBLISH_BUTTON" />

		<execute macro="KBMessage#success" />
	</command>

	<command name="closePermissionsIFrame">
		<if>
			<condition function="IsElementPresent" locator1="KBWebContentPermissions#CANCEL_BUTTON" />
			<then>
				<execute function="Click" locator1="KBWebContentPermissions#CANCEL_BUTTON" />
				<execute function="SelectWindow" locator1="null" />
			</then>
		</if>
	</command>

	<command name="editArticle">
		<execute macro="KBSiteAdminHelper#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Edit" />
			<var name="title" value="${title}" />
		</execute>

		<execute function="Type" locator1="KBWebContent#TITLE_FIELD" value1="${newTitle}" />
		<execute function="Click" locator1="KBWebContent#PUBLISH_BUTTON" />

		<execute macro="KBMessage#success" />
	</command>

	<command name="expireAndDelete">
		<execute macro="KBSiteAdminHelper#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Expire" />
			<var name="title" value="${title}" />
		</execute>

		<execute macro="KBMessage#success" />

		<execute macro="KBMessage#closeSuccessMessage" />

		<execute function="Click" locator1="KBWebContent#STATUS_DROPDOWN" />

		<var name="key_status" value="Expired" />

		<execute function="Click" locator1="KBWebContent#STATUS_DROPDOWN_ITEM" />

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Delete" />
			<var name="title" value="${title}" />
		</execute>

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="KBMessage#success" />
	</command>

	<command name="gotoArticlePermissions">
		<execute macro="KBMessage#closeSuccessMessage" />

		<execute macro="KBSiteAdminHelper#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Permissions" />
			<var name="title" value="${title}" />
		</execute>

		<execute function="SelectFrame" locator1="KBWebContentPermissions#PERMISSIONS_IFRAME" />
	</command>

	<command name="viewCheckedPermissions">
		<var name="key_role" value="${role}" />

		<for list="${checkedColumns}" param="column">
			<var name="key_column" value="${column}" />

			<execute function="AssertChecked" locator1="KBWebContentPermissions#PERMISSION_CHECKBOX" />
		</for>
	</command>

	<command name="viewUncheckedPermissions">
		<var name="key_role" value="${role}" />

		<for list="${uncheckedColumns}" param="column">
			<var name="key_column" value="${column}" />

			<execute function="AssertNotChecked" locator1="KBWebContentPermissions#PERMISSION_CHECKBOX" />
		</for>
	</command>
</definition>