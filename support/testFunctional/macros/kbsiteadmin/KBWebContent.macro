definition {

	macro addArticleDisplay {
		Click(locator1 = "KBWebContent#ADD_BUTTON");

		var key_menu_item = "Article Display";

		Click(locator1 = "KBWebContent#ADD_MENU_ITEM");

		AssertElementPresent(locator1 = "KBWebContent#TITLE_FIELD");

		Type(
			locator1 = "KBWebContent#TITLE_FIELD",
			value1 = "${title}");

		if (isSet(permissions)) {
			Select(
				locator1 = "KBWebContent#PERMISSIONS_SELECT",
				value1 = "${permissions}");
		}

		Click(locator1 = "KBWebContent#PUBLISH_BUTTON");

		KBMessage.success();
	}

	macro closePermissionsIFrame {
		if (IsElementPresent(locator1 = "KBWebContentPermissions#CANCEL_BUTTON")) {
			Click(locator1 = "KBWebContentPermissions#CANCEL_BUTTON");

			SelectWindow(locator1 = "null");
		}
	}

	macro delete {
		KBSiteAdminHelper.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSiteAdminHelper.selectEllipsisMenuItem(
			item = "Move to the Recycle Bin",
			title = "${title}");

		AssertClick(
			locator1 = "KBWebContent#RECYCLE_BIN_LINK",
			value1 = "the Recycle Bin");

		KBSiteAdminHelper.deleteRow(title = "${title}");
	}

	macro editArticle {
		KBSiteAdminHelper.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSiteAdminHelper.selectEllipsisMenuItem(
			item = "Edit",
			title = "${title}");

		Type(
			locator1 = "KBWebContent#TITLE_FIELD",
			value1 = "${newTitle}");

		Click(locator1 = "KBWebContent#PUBLISH_BUTTON");

		KBMessage.success();
	}

	macro gotoArticlePermissions {
		KBMessage.closeSuccessMessage();

		KBSiteAdminHelper.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSiteAdminHelper.selectEllipsisMenuItem(
			item = "Permissions",
			title = "${title}");

		SelectFrame(locator1 = "KBWebContentPermissions#PERMISSIONS_IFRAME");
	}

	macro viewCheckedPermissions {
		var key_role = "${role}";
		var roleFound = "false";

		while (("${roleFound}" == "false")) {
			if (IsElementPresent(locator1 = "KBWebContentPermissions#PERMISSION_ROLE")) {
				var roleFound = "true";

				for (var column : list "${checkedColumns}") {
					var key_column = "${column}";

					AssertChecked(locator1 = "KBWebContentPermissions#PERMISSION_CHECKBOX");
				}
			}
			else {
				Click(locator1 = "KBWebContentPermissions#NEXT_PAGE_ICON_ENABLED");
			}
		}
	}

	macro viewUncheckedPermissions {
		var key_role = "${role}";
		var roleFound = "false";

		while (("${roleFound}" == "false")) {
			if (IsElementPresent(locator1 = "KBWebContentPermissions#PERMISSION_ROLE")) {
				var roleFound = "true";

				for (var column : list "${uncheckedColumns}") {
					var key_column = "${column}";

					AssertNotChecked(locator1 = "KBWebContentPermissions#PERMISSION_CHECKBOX");
				}
			}
			else {
				Click(locator1 = "KBWebContentPermissions#NEXT_PAGE_ICON_ENABLED");
			}
		}
	}

}