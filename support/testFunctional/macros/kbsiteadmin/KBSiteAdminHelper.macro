<definition>
	<command name="deleteRow">
		<execute macro="KBSiteAdminHelper#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSiteAdminHelper#selectEllipsisMenuItem">
			<var name="item" value="Delete" />
			<var name="title" value="${title}" />
		</execute>

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="KBMessage#success" />
	</command>

	<command name="searchByKeyword">
		<execute function="Type" locator1="KBWebContent#SEARCH_FIELD" value1="${keyword}" />
		<execute function="KeyPress" locator1="KBWebContent#SEARCH_FIELD" value1="\RETURN"  />
	</command>

	<command name="selectEllipsisMenuItem">
		<var name="key_menu_item" value="${item}" />
		<var name="key_title" value="${title}" />

		<execute function="Click" locator1="KBWebContent#DESCRIPTIVE_BUTTON" />
		<execute function="Click" locator1="KBWebContent#ROW_ELLIPSIS" />
		<execute function="ClickNoError" locator1="KBWebContent#ELLIPSIS_MENU_ITEM" />
	</command>
</definition>