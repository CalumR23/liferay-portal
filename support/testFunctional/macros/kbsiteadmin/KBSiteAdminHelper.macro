definition {

	macro deleteRow {
		KBSiteAdminHelper.selectEllipsisMenuItem(
			item = "Delete",
			title = "${title}");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		KBMessage.success();
	}

	macro deleteRowWithSearch {
		KBSiteAdminHelper.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSiteAdminHelper.deleteRow(title = "${title}");
	}

	macro searchByKeyword {
		Type(
			locator1 = "KBWebContent#SEARCH_FIELD",
			value1 = "${keyword}");

		KeyPress(
			locator1 = "KBWebContent#SEARCH_FIELD",
			value1 = "\RETURN");
	}

	macro selectEllipsisMenuItem {
		var key_menu_item = "${item}";
		var key_title = "${title}";

		Click(locator1 = "KBWebContent#DESCRIPTIVE_BUTTON");

		Click(locator1 = "KBWebContent#ROW_ELLIPSIS");

		ClickNoError(locator1 = "KBWebContent#ELLIPSIS_MENU_ITEM");
	}

}