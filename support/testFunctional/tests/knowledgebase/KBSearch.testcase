@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var kbAdminEmailAddress = PropsUtil.get("kb.email.address.6");
	var kbAdminPassword = PropsUtil.get("kb.email.password.6");
	var liferayEmailAddress = PropsUtil.get("kb.email.address.1");
	var liferayPassword = PropsUtil.get("kb.email.password.1");

	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		if ("${testCaseName}" == "SearchInJapaneseLocale") {
			KBUser.setLocale(language = "English");
		}

		KBUser.logout();
	}

	@priority = "5"
	test AddAndRemoveFilterCategory {
		var category = "QA Test Article Type Filter";
		var group = "Article Type";

		KBUser.login(
			userEmailAddress = "${kbAdminEmailAddress}",
			userPassword = "${kbAdminPassword}");

		KBNavigation.gotoKBCategories();

		KBCategories.addCategory(
			name = "${category}",
			vocabulary = "${group}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.viewFilter(
			filter = "${category}",
			group = "${group}");

		KBNavigation.gotoKBCategories();

		KBCategories.deleteCategory(
			title = "${category}",
			vocabulary = "${group}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.viewFilterNotPresent(key_filter = "${category}");
	}

	@priority = "5"
	test AddAndRemoveFilterVocabulary {
		var category = "QA Test Category";
		var vocabulary = "QA Test Vocabulary";

		KBUser.login(
			userEmailAddress = "${kbAdminEmailAddress}",
			userPassword = "${kbAdminPassword}");

		KBNavigation.gotoKBCategories();

		KBCategories.addVocabulary(name = "${vocabulary}");

		KBNavigation.gotoKBCategories();

		KBCategories.addCategory(
			name = "${category}",
			vocabulary = "${vocabulary}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.viewFilter(
			filter = "${category}",
			group = "${vocabulary}");

		KBNavigation.gotoKBCategories();

		KBCategories.deleteCategory(
			title = "${category}",
			vocabulary = "${vocabulary}");

		KBNavigation.gotoKBCategories();

		KBSiteAdminHelper.deleteRowWithSearch(title = "${vocabulary}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.viewFilterNotPresent(key_filter = "${vocabulary}");
	}

	@priority = "5"
	test SearchInJapaneseLocale {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.expandFilterGroup(group = "Language");

		KBSearch.checkLanguageFilter(filter = "日本語");

		var count = KBSearch.getSearchResultCount();

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBUser.setLocale(language = "日本語");

		KBSearch.viewFirstNResultsJapanese(count = "${count}");
	}

	@priority = "5"
	test ViewOfficialDocumentationNotRankedAtBottom {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.checkFilter(filter = "Official Documentation");

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.searchByKeyword(keyword = "Clustering");

		KBSearch.viewOfficialDocOnFirstPageResults();

		KBSearch.viewKBArticleOnFirstPageResults();
	}

	@priority = "4"
	test ViewPagination {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearchViaURL();

		KBSearch.viewSearchResultEmpty();

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearchPagination.viewPaginationDropdownLabel(numItems = "20");

		KBSearchPagination.viewPaginationDropdownList(list = "5,10,20,30,50,75");

		KBSearchPagination.viewPaginationButtonsDisabled(buttons = "First,Previous");

		KBSearchPagination.viewPaginationButtonsEnabled(buttons = "Next,Last");

		KBSearchPagination.selectPage(page = "10");

		KBSearchPagination.viewPaginationButtonsEnabled(buttons = "First,Previous,Next,Last");

		KBSearchPagination.clickPaginationButton(button = "Last");

		KBSearchPagination.viewPaginationButtonsDisabled(buttons = "Next,Last");

		KBSearchPagination.viewPaginationButtonsEnabled(buttons = "First,Previous");

		KBSearch.checkFilter(filter = "Internal Training");

		KBSearchPagination.selectItemsPerPage(numItems = "50");

		KBSearchPagination.viewPaginationButtonsDisabled(buttons = "First,Previous,Next,Last");
	}

}