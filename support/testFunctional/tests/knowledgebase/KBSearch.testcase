<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('kb.email.address.1')" name="liferayEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.1')" name="liferayPassword" />

	<set-up>
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${liferayEmailAddress}" />
			<var name="userPassword" value="${liferayPassword}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="KBUser#logout" />
	</tear-down>

	<command name="ViewOfficialDocumentationRankedFirst">
		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Official Documentation" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#viewFirstPageSearchResultCategory">
			<var name="category" value="Official Documentation" />
		</execute>
	</command>

	<command name="ViewPagination">
		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewSearchResultEmpty" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationDropdownLabel">
			<var name="numItems" value="20" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationDropdownList">
			<var name="list" value="5,10,20,30,50,75" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="First,Previous" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#selectPage">
			<var name="page" value="10" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="First,Previous,Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#clickPaginationButton">
			<var name="button" value="Last" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="First,Previous" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Internal Training" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="First,Previous,Next,Last" />
		</execute>
	</command>
</definition>