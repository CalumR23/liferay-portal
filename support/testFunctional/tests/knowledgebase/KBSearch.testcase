<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('kb.email.address.6')" name="kbAdminEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.6')" name="kbAdminPassword" />
	<var method="TestPropsUtil#get('kb.email.address.1')" name="liferayEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.1')" name="liferayPassword" />

	<tear-down>
		<execute class="com.liferay.poshi.runner.PoshiRunnerContext" method="getTestCaseNamespacedClassCommandName">
			<return name="testCaseCommandName" />
		</execute>

		<var method="StringUtil#extractLast('${testCaseCommandName}', '#')" name="testCaseName" />

		<if>
			<equals arg1="${testCaseName}" arg2="SearchInJapaneseLocale" />
			<then>
				<execute macro="KBUser#setLocale">
					<var name="language" value="English" />
				</execute>
			</then>
		</if>

		<execute macro="KBUser#logout" />
	</tear-down>

	<command name="AddAndRemoveFilterCategory" priority="5">
		<var name="category" value="QA Test Article Type Filter" />
		<var name="group" value="Article Type" />

		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${kbAdminEmailAddress}" />
			<var name="userPassword" value="${kbAdminPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBCategories#addCategory">
			<var name="name" value="${category}" />
			<var name="vocabulary" value="${group}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewFilter">
			<var name="filter" value="${category}" />
			<var name="group" value="${group}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBCategories#deleteCategory">
			<var name="title" value="${category}" />
			<var name="vocabulary" value="${group}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewFilterNotPresent">
			<var name="key_filter" value="${category}" />
		</execute>
	</command>

	<command name="AddAndRemoveFilterVocabulary" priority="5">
		<var name="category" value="QA Test Category" />
		<var name="vocabulary" value="QA Test Vocabulary" />

		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${kbAdminEmailAddress}" />
			<var name="userPassword" value="${kbAdminPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBCategories#addVocabulary">
			<var name="name" value="${vocabulary}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBCategories#addCategory">
			<var name="name" value="${category}" />
			<var name="vocabulary" value="${vocabulary}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewFilter">
			<var name="filter" value="${category}" />
			<var name="group" value="${vocabulary}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBCategories#deleteCategory">
			<var name="title" value="${category}" />
			<var name="vocabulary" value="${vocabulary}" />
		</execute>

		<execute macro="KBNavigation#gotoKBCategories" />

		<execute macro="KBSiteAdminHelper#deleteRowWithSearch">
			<var name="title" value="${vocabulary}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewFilterNotPresent">
			<var name="key_filter" value="${vocabulary}" />
		</execute>
	</command>

	<command name="SearchInJapaneseLocale" priority="5">
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${liferayEmailAddress}" />
			<var name="userPassword" value="${liferayPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#expandFilterGroup">
			<var name="group" value="Language" />
		</execute>

		<execute macro="KBSearch#checkLanguageFilter">
			<var name="filter" value="日本語" />
		</execute>

		<execute macro="KBSearch#getSearchResultCount">
			<return from="count" name="count" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBUser#setLocale">
			<var name="language" value="日本語" />
		</execute>

		<execute macro="KBSearch#viewFirstNResultsJapanese">
			<var name="count" value="${count}" />
		</execute>
	</command>

	<command name="ViewOfficialDocumentationNotRankedAtBottom" priority="5">
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${liferayEmailAddress}" />
			<var name="userPassword" value="${liferayPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Official Documentation" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#searchByKeyword">
			<var name="keyword" value="Clustering" />
		</execute>

		<execute macro="KBSearch#viewOfficialDocOnFirstPageResults" />

		<execute macro="KBSearch#viewKBArticleOnFirstPageResults" />
	</command>

	<command name="ViewPagination" priority="4">
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${liferayEmailAddress}" />
			<var name="userPassword" value="${liferayPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearchViaURL" />

		<execute macro="KBSearch#viewSearchResultEmpty" />

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationDropdownLabel">
			<var name="numItems" value="20" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationDropdownList">
			<var name="list" value="5,10,20,30,50,75" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="First,Previous" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#selectPage">
			<var name="page" value="10" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="First,Previous,Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#clickPaginationButton">
			<var name="button" value="Last" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="Next,Last" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsEnabled">
			<var name="buttons" value="First,Previous" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Internal Training" />
		</execute>

		<execute macro="KBSearchPagination#selectItemsPerPage">
			<var name="numItems" value="50" />
		</execute>

		<execute macro="KBSearchPagination#viewPaginationButtonsDisabled">
			<var name="buttons" value="First,Previous,Next,Last" />
		</execute>
	</command>
</definition>