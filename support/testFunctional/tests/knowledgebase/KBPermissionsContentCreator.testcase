@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var contentCreatorEmailAddress = PropsUtil.get("kb.email.address.5");
	var contentCreatorPassword = PropsUtil.get("kb.email.password.5");
	var kbAdminEmailAddress = PropsUtil.get("kb.email.address.6");
	var kbAdminPassword = PropsUtil.get("kb.email.password.6");
	static var staticTearDownWebContent = "";

	setUp {
		KBUser.login(
			userEmailAddress = "${contentCreatorEmailAddress}",
			userPassword = "${contentCreatorPassword}");
	}

	tearDown {
		if ("${staticTearDownWebContent}" != "") {
			KBUser.logoutAndLogin(
				userEmailAddress = "${kbAdminEmailAddress}",
				userPassword = "${kbAdminPassword}");

			KBNavigation.gotoKBWebContent();

			KBWebContent.delete(title = "${staticTearDownWebContent}");
		}

		KBUser.logout();
	}

	@priority = "5"
	test CreateAndEditKBaseArticle {
		KBNavigation.gotoKBWebContentViaArticle();

		KBWebContent.addArticleDisplay(title = "QA Test KB Article 1");

		var staticTearDownWebContent = "QA Test KB Article 1";

		KBWebContent.editArticle(
			newTitle = "QA Test KB Article 1 Updated",
			title = "QA Test KB Article 1");

		var staticTearDownWebContent = "QA Test KB Article 1 Updated";
	}

}