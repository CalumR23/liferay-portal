<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('kb.email.address.5')" name="contentCreatorEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.5')" name="contentCreatorPassword" />
	<var method="TestPropsUtil#get('kb.email.address.6')" name="kbAdminEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.6')" name="kbAdminPassword" />

	<var name="staticTearDownWebContent" static="true" value="" />

	<set-up>
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${contentCreatorEmailAddress}" />
			<var name="userPassword" value="${contentCreatorPassword}" />
		</execute>
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownWebContent}" arg2="" />
			</not>
			<then>
				<execute macro="KBUser#logoutAndLogin">
					<var name="userEmailAddress" value="${kbAdminEmailAddress}" />
					<var name="userPassword" value="${kbAdminPassword}" />
				</execute>

				<execute macro="KBNavigation#gotoKBWebContent" />

				<execute macro="KBWebContent#delete">
					<var name="title" value="${staticTearDownWebContent}" />
				</execute>
			</then>
		</if>

		<execute macro="KBUser#logout" />
	</tear-down>

	<command name="CreateAndEditKBaseArticle" priority="5">
		<execute macro="KBNavigation#gotoKBWebContentViaArticle" />

		<execute macro="KBWebContent#addArticleDisplay">
			<var name="title" value="QA Test KB Article 1" />
		</execute>

		<var name="staticTearDownWebContent" value="QA Test KB Article 1" />

		<execute macro="KBWebContent#editArticle">
			<var name="newTitle" value="QA Test KB Article 1 Updated" />
			<var name="title" value="QA Test KB Article 1" />
		</execute>

		<var name="staticTearDownWebContent" value="QA Test KB Article 1 Updated" />
	</command>
</definition>