@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var customerEmailAddress = PropsUtil.get("kb.email.address.2");
	var customerPassword = PropsUtil.get("kb.email.password.2");
	var liferayEmailAddress = PropsUtil.get("kb.email.address.1");
	var liferayPassword = PropsUtil.get("kb.email.password.1");

	tearDown {
		KBUser.logout();
	}

	@priority = "5"
	test CannotCreateOrEditArticle {
		KBUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.viewSuggestAnEditLinkNotPresent();
	}

	@priority = "5"
	test CannotViewInternalArticle {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.filterInternalArticle();

		var title = KBSearch.getFirstArticleTitle();

		KBUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSearch.viewSearchResultEmpty();
	}

	@priority = "5"
	test ViewExternalArticle {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.filterExternalArticle();

		var title = KBSearch.getFirstArticleTitle();

		KBUser.logoutAndLogin(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.checkFilter(filter = "Knowledge Base");

		KBSearch.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSearch.viewFirstSearchResultTitle(title = "${title}");
	}

	@priority = "5"
	test ViewOfficialDocumentation {
		KBUser.login(
			userEmailAddress = "${customerEmailAddress}",
			userPassword = "${customerPassword}");

		KBPermissions.viewOfficialDocumentation();
	}

}