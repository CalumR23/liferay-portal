@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var liferayEmailAddress = PropsUtil.get("kb.email.address.1");
	var liferayPassword = PropsUtil.get("kb.email.password.1");
	var trialUserEmailAddress = PropsUtil.get("kb.email.address.4");
	var trialUserPassword = PropsUtil.get("kb.email.password.4");

	tearDown {
		KBUser.logout();
	}

	@priority = "5"
	test CannotSearchKBaseArticle {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.filterExternalArticle();

		var externalArticleTitle = KBSearch.getFirstArticleTitle();

		KBSearch.filterInternalArticle();

		var internalArticleTitle = KBSearch.getFirstArticleTitle();

		KBUser.logoutAndLogin(
			userEmailAddress = "${trialUserEmailAddress}",
			userPassword = "${trialUserPassword}");

		KBSearch.searchByKeyword(keyword = "&quot;${externalArticleTitle}&quot;");

		KBSearch.viewSearchResultEmpty();

		KBSearch.searchByKeyword(keyword = "&quot;${internalArticleTitle}&quot;");

		KBSearch.viewSearchResultEmpty();

		KBSearch.viewFilterNotPresent(filter = "Article Type");

		KBSearch.viewFilterNotPresent(filter = "Knowledge Base");
	}

	@priority = "5"
	test CannotViewKBaseArticle {
		KBUser.login(
			userEmailAddress = "${trialUserEmailAddress}",
			userPassword = "${trialUserPassword}");

		KBPermissions.viewSupportKBaseLinkNotPresent();
	}

	@priority = "5"
	test ViewOfficialDocumentation {
		KBUser.login(
			userEmailAddress = "${liferayEmailAddress}",
			userPassword = "${liferayPassword}");

		KBNavigation.gotoKBSearch();

		KBSearch.uncheckFilter(filter = "Knowledge Base");

		KBSearch.checkFilter(filter = "Official Documentation");

		var title = KBSearch.getFirstArticleTitle();

		KBUser.logoutAndLogin(
			userEmailAddress = "${trialUserEmailAddress}",
			userPassword = "${trialUserPassword}");

		KBSearch.searchByKeyword(keyword = "&quot;${title}&quot;");

		KBSearch.viewFirstSearchResultTitle(title = "${title}");

		KBSearch.viewSearchResultOfficialDocumentation();
	}

}