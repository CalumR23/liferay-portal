<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('kb.email.address.1')" name="liferayEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.1')" name="liferayPassword" />
	<var method="TestPropsUtil#get('kb.email.address.4')" name="trialUserEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.4')" name="trialUserPassword" />

	<tear-down>
		<execute macro="KBUser#logout" />
	</tear-down>

	<command name="ViewOfficialDocumentation" priority="5">
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${liferayEmailAddress}" />
			<var name="userPassword" value="${liferayPassword}" />
		</execute>

		<execute macro="KBNavigation#gotoKBSearch" />

		<execute macro="KBSearch#uncheckFilter">
			<var name="filter" value="Knowledge Base" />
		</execute>

		<execute macro="KBSearch#checkFilter">
			<var name="filter" value="Official Documentation" />
		</execute>

		<execute macro="KBSearch#getFirstArticleTitle">
			<return from="title" name="title" />
		</execute>

		<execute macro="KBUser#logoutAndLogin">
			<var name="userEmailAddress" value="${trialUserEmailAddress}" />
			<var name="userPassword" value="${trialUserPassword}" />
		</execute>

		<execute macro="KBSearch#searchByKeyword">
			<var name="keyword" value="&quot;${title}&quot;" />
		</execute>

		<execute macro="KBSearch#viewFirstSearchResultTitle">
			<var name="title" value="${title}" />
		</execute>

		<execute macro="KBSearch#viewSearchResultOfficialDocumentation" />
	</command>
</definition>