@component-name = "support-qa"
definition {

	property testray.main.component.name = "Support QA";

	var kbAdminEmailAddress = PropsUtil.get("kb.email.address.6");
	var kbAdminPassword = PropsUtil.get("kb.email.password.6");
	static var staticTearDownWebContent = "";

	setUp {
		KBUser.login(
			userEmailAddress = "${kbAdminEmailAddress}",
			userPassword = "${kbAdminPassword}");
	}

	tearDown {
		if ("${staticTearDownWebContent}" != "") {
			KBWebContent.closePermissionsIFrame();

			KBWebContent.delete(title = "${staticTearDownWebContent}");
		}

		KBUser.logout();
	}

	@priority = "5"
	test NewExternalArticle {
		KBNavigation.gotoKBWebContent();

		KBWebContent.addArticleDisplay(
			permissions = "External",
			title = "QA Test KB Article 2");

		var staticTearDownWebContent = "QA Test KB Article 2";

		KBWebContent.gotoArticlePermissions(title = "QA Test KB Article 2");

		KBWebContent.viewCheckedPermissions(
			checkedColumns = "view",
			role = "Customer");

		KBWebContent.viewUncheckedPermissions(
			role = "Customer",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion");

		KBWebContent.viewCheckedPermissions(
			checkedColumns = "view",
			role = "Liferay Employee");

		KBWebContent.viewUncheckedPermissions(
			role = "Liferay Employee",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion");

		KBWebContent.viewUncheckedPermissions(
			role = "Guest",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion");

		KBWebContent.viewCheckedPermissions(
			checkedColumns = "view",
			role = "Partner");

		KBWebContent.viewUncheckedPermissions(
			role = "Partner",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion");
	}

	@priority = "5"
	test NewInternalArticle {
		KBNavigation.gotoKBWebContent();

		KBWebContent.addArticleDisplay(
			permissions = "Internal",
			title = "QA Test KB Article 3");

		var staticTearDownWebContent = "QA Test KB Article 3";

		KBWebContent.gotoArticlePermissions(title = "QA Test KB Article 3");

		KBWebContent.viewUncheckedPermissions(
			role = "Customer",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion");

		KBWebContent.viewCheckedPermissions(
			checkedColumns = "view",
			role = "Liferay Employee");

		KBWebContent.viewUncheckedPermissions(
			role = "Liferay Employee",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion");

		KBWebContent.viewUncheckedPermissions(
			role = "Guest",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion");

		KBWebContent.viewUncheckedPermissions(
			role = "Partner",
			uncheckedColumns = "update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion");
	}

}