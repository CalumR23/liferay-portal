<definition component-name="support-qa">
	<property name="testray.main.component.name" value="Support QA" />

	<var method="TestPropsUtil#get('kb.email.address.6')" name="kbAdminEmailAddress" />
	<var method="TestPropsUtil#get('kb.email.password.6')" name="kbAdminPassword" />

	<var name="staticTearDownWebContent" static="true" value="" />

	<set-up>
		<execute macro="KBUser#login">
			<var name="userEmailAddress" value="${kbAdminEmailAddress}" />
			<var name="userPassword" value="${kbAdminPassword}" />
		</execute>
	</set-up>

	<tear-down>
		<if>
			<not>
				<equals arg1="${staticTearDownWebContent}" arg2="" />
			</not>
			<then>
				<execute macro="KBWebContent#closePermissionsIFrame" />

				<execute macro="KBWebContent#delete">
					<var name="title" value="${staticTearDownWebContent}" />
				</execute>
			</then>
		</if>

		<execute macro="KBUser#logout" />
	</tear-down>

	<command name="NewExternalArticle" priority="5">
		<execute macro="KBNavigation#gotoKBWebContent" />

		<execute macro="KBWebContent#addArticleDisplay">
			<var name="permissions" value="External" />
			<var name="title" value="QA Test KB Article 2" />
		</execute>

		<var name="staticTearDownWebContent" value="QA Test KB Article 2" />

		<execute macro="KBWebContent#gotoArticlePermissions">
			<var name="title" value="QA Test KB Article 2" />
		</execute>

		<execute macro="KBWebContent#viewCheckedPermissions">
			<var name="checkedColumns" value="view" />
			<var name="role" value="Customer" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Customer" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewCheckedPermissions">
			<var name="checkedColumns" value="view" />
			<var name="role" value="Liferay Employee" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Liferay Employee" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Guest" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewCheckedPermissions">
			<var name="checkedColumns" value="view" />
			<var name="role" value="Partner" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Partner" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion" />
		</execute>
	</command>

	<command name="NewInternalArticle" priority="5">
		<execute macro="KBNavigation#gotoKBWebContent" />

		<execute macro="KBWebContent#addArticleDisplay">
			<var name="permissions" value="Internal" />
			<var name="title" value="QA Test KB Article 3" />
		</execute>

		<var name="staticTearDownWebContent" value="QA Test KB Article 3" />

		<execute macro="KBWebContent#gotoArticlePermissions">
			<var name="title" value="QA Test KB Article 3" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Customer" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewCheckedPermissions">
			<var name="checkedColumns" value="view" />
			<var name="role" value="Liferay Employee" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Liferay Employee" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Guest" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion" />
		</execute>

		<execute macro="KBWebContent#viewUncheckedPermissions">
			<var name="role" value="Partner" />
			<var name="uncheckedColumns" value="update-discussion,delete,permissions,expire,delete-discussion,update,view,add-discussion" />
		</execute>
	</command>
</definition>