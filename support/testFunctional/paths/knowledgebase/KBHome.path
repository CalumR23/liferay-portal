<html>
<head>
<title>KBHome</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">KBHome</td></tr>
</thead>
<tbody>
<tr>
	<td>NAV_USER_MENU</td>
	<td>//div[contains(@class,'nav-user')]</td>
	<td></td>
</tr>
<tr>
	<td>NAV_USER_MENU_OPEN</td>
	<td>//div[contains(@class,'nav-user toggle-menu open')]</td>
	<td></td>
</tr>
<tr>
	<td>MY_PLACES_MENU_ITEM</td>
	<td>//li[@class='my-places']//a[text()='${key_item}']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_KBASE_LINK</td>
	<td>//h2/a[text()=' Support KBase ']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>