<html>
<head>
<title>KBSearch</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">KBSearch</td></tr>
</thead>
<tbody>
<tr>
	<td>FILTER_LABEL</td>
	<td>//div[contains(@class,'navigation-pane') and contains(.,'${key_filter}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_GROUP_MINUS_ICON</td>
	<td>//h3[text()=' ${key_group} ']/i[contains(@class,'icon-minus')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_GROUP_PLUS_ICON</td>
	<td>//h3[text()=' ${key_group} ']/i[contains(@class,'icon-plus')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_CHECKBOX</td>
	<td>//span[text()=' ${key_filter} ']/../input[@class='filter-input']</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSION_FILTER_CHECKBOX</td>
	<td>//span[text()=' ${key_filter} ']/../input[@class='filter-permission-input']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_KEYWORD_INPUT</td>
	<td>//input[contains(@class,'search-keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ARTICLE</td>
	<td>//div[@class='article-display']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ARTICLE_TITLE</td>
	<td>//div[@class='article-title']/a</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_OFFICIAL_DOCUMENTATION</td>
	<td>//div[@class='article-category' and contains(.,'Official Documentation')]/../div[@class='article-title']/a</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_PAGE_DROPDOWN</td>
	<td>//div[contains(@class,'current-page-menu')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_DROPDOWN</td>
	<td>//div[contains(@class,'pagination-delta-selector')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_DROPDOWN_LIST_ITEM</td>
	<td>//ul[contains(@class,'dropdown-menu')]//span[text()='${key_item}']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_DROPDOWN_NTH_LIST_ITEM</td>
	<td>//ul[contains(@class,'dropdown-menu')]/li[${key_n}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_BUTTON_ENABLED</td>
	<td>//ul[contains(@class,'pagination-buttons')]/li[not(contains(@class,'disabled'))]/a[contains(.,'${key_button}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_BUTTON_DISABLED</td>
	<td>//ul[contains(@class,'pagination-buttons')]/li[contains(@class,'disabled')]/a[contains(.,'${key_button}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>