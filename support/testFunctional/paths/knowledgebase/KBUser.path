<html>
<head>
<title>KBUser</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">KBUser</td></tr>
</thead>

<tbody>
<tr>
	<td>USER_AVATAR_IMAGE</td>
	<td>//div[contains(@class,'nav-user')]</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_TOGGLE</td>
	<td>//li[contains(@class,'language-toggle')]/a</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_LIST_ITEM</td>
	<td>//section[contains(@id,'SiteNavigationLanguagePortlet')]//a[text()='${key_language}']</td>
	<td></td>
</tr>
<tr>
	<td>LANGUAGE_LIST_ITEM_SELECTED</td>
	<td>//section[contains(@id,'SiteNavigationLanguagePortlet')]//span[text()='${key_language}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>