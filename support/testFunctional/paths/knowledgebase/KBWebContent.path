<html>
<head>
<title>KBWebContent</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">KBWebContent</td></tr>
</thead>
<tbody>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_DROPDOWN</td>
	<td>//a[@data-qa-id='filterstatus']</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTIVE_BUTTON</td>
	<td>//a[@data-qa-id='descriptiveButton']</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_DROPDOWN_ITEM</td>
	<td>//ul[@data-qa-id='filterstatusValues']/li/a[text()='${key_status}']</td>
	<td></td>
</tr>
<tr>
	<td>ROW_ELLIPSIS</td>
	<td>//li[contains(.,'${key_title}')]//a[contains(@id,'menu')]</td>
	<td></td>
</tr>
<tr>
	<td>ELLIPSIS_MENU_ITEM</td>
	<td>//li/a/span[text()='${key_menu_item}']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//button[@data-qa-id='addButton']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_MENU_ITEM</td>
	<td>//li/a[text()='${key_menu_item}']</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_FIELD</td>
	<td>//input[contains(@id,'title')]</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSIONS_SELECT</td>
	<td>//select[contains(@id,'permissions')]</td>
	<td></td>
</tr>
<tr>
	<td>PUBLISH_BUTTON</td>
	<td>//button[@data-actionname='publish']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>