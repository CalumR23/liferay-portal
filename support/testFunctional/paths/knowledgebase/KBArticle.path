<html>
<head>
<title>KBArticle</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">KBArticle</td></tr>
</thead>
<tbody>
<tr>
	<td>DOCUMENT_TITLE</td>
	<td>//h1[contains(@class,'header-title')]</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SIDE_BAR_PERMISSIONS_INTERNAL</td>
	<td>//span[@data-permission-type='1']</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_SIDE_BAR_PERMISSIONS_EXTERNAL</td>
	<td>//span[@data-permission-type='2']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>