<html>
<head>
<title>ProductMenu</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ProductMenu</td></tr>
</thead>

<tbody>
<tr>
	<td>TOGGLE</td>
	<td>//*[@data-qa-id='productMenu']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_MENU_BODY</td>
	<td>//*[@data-qa-id='productMenuBody']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_MENU_OPENED</td>
	<td>//div[contains(@id,'sidenavSliderId') and not(contains(@class,'closed')) and not(contains(@class,'transition'))]</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_MENU_CLOSED</td>
	<td>//div[contains(@id,'sidenavSliderId') and (contains(@class,'closed')) and not(contains(@class,'transition'))]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_COLLAPSED</td>
	<td>//div[a[@aria-expanded='true']]/../..//a[@aria-expanded='false' and contains(.,'${key_category}')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_EXPANDED</td>
	<td>//div[a[@aria-expanded='true']]/../..//a[@aria-expanded='true' and contains(.,'${key_category}')]</td>
	<td></td>
</tr>
<tr>
	<td>PORTLET</td>
	<td>//div[a[@aria-expanded='true']]//a[contains(@id,'Portlet') and @data-title='${key_portlet}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PRODUCT_MENU_TABS-->

<tr>
	<td>PRODUCT_MENU_TABS_SITES_COLLAPSED</td>
	<td>//*[@data-qa-id='productMenuSiteAdministrationPanelCategory'][@aria-expanded='false']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_MENU_TABS_SITES_EXPANDED</td>
	<td>//*[@data-qa-id='productMenuSiteAdministrationPanelCategory'][@aria-expanded='true']</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_MENU_TABS_EXPANDED_PANEL</td>
	<td>//div[(@class='collapse panel-collapse in' or @class='panel-collapse collapse in') and contains(@id,'${key_panelId}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>