<html>
<head>
<title>KBWebContent</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">KBWebContent</td></tr>
</thead>

<tbody>
<tr>
	<td>EXTEND_ACTION_PATH</td>
	<td>UIElements</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>STATUS_DROPDOWN</td>
	<td>//a[@data-qa-id='filterstatus']</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_DROPDOWN_ITEM</td>
	<td>//ul[@data-qa-id='filterstatusValues']/li/a[text()='${key_status}']</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_FIELD</td>
	<td>//input[contains(@id,'title')]</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSIONS_SELECT</td>
	<td>//select[contains(@id,'permissions')]</td>
	<td></td>
</tr>
<tr>
	<td>PUBLISH_BUTTON</td>
	<td>//button[@data-actionname='publish']</td>
	<td></td>
</tr>
<tr>
	<td>RECYCLE_BIN_LINK</td>
	<td>//a[@class='alert-link' and text()='the Recycle Bin']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>