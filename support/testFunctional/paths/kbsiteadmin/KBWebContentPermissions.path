<html>
<head>
<title>KBWebContentPermissions</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">KBWebContentPermissions</td></tr>
</thead>
<tbody>
<tr>
	<td>PERMISSIONS_IFRAME</td>
	<td>//iframe[@class='dialog-iframe-node ']</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSION_ROLE</td>
	<td>//tr[contains(.,'${key_role}')]</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSION_CHECKBOX</td>
	<td>//tr[contains(.,'${key_role}')]/td[contains(@class,'${key_column}-column')]/input</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_PAGE_ICON_ENABLED</td>
	<td>//div[contains(@class,'edit-permissions')]//li[not(contains(@class,'disabled'))]//span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//button/span[text()='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>