definition {

	macro addTemplate {
		Click(locator1 = "Button#PLUS");

		Click.javaScriptClick(
			key_menuItem = ${dropdownItem},
			locator1 = "MenuItem#ANY_MENU_ITEM");

		if (isSet(fieldName)) {
			Type(
				inputFieldId = "name",
				locator1 = "TextInput#INPUT_ID",
				value1 = ${fieldName});
		}

		if (isSet(routine)) {
			Select(
				locator1 = "TestrayBuild#ROUTINE_ID",
				value1 = ${routine});
		}

		if (isSet(gitHash)) {
			Type(
				inputFieldId = "gitHash",
				locator1 = "TextInput#INPUT_ID",
				value1 = ${gitHash});
		}

		if (isSet(description)) {
			Type(
				locator1 = "TextArea#DESCRIPTION",
				value1 = ${description});
		}

		Button.clickSave();
	}

	macro assertTemplateName {
		Click(locator1 = "Button#PLUS");

		AssertElementPresent(
			key_menuItem = ${dropdownItem},
			locator1 = "MenuItem#ANY_MENU_ITEM");
	}

	macro goToBuildTemplate {
		Click(locator1 = "Button#PLUS");

		Click.javaScriptClick(
			key_menuItem = ${dropdownItem},
			locator1 = "MenuItem#ANY_MENU_ITEM");
	}

	macro viewTemplateDetails {
		AssertElementPresent(
			locator1 = "TestrayTemplate#TEMPLATE_DETAILS",
			nameTemplate = ${nameTemplate},
			statusTemplate = ${statusTemplate});
	}

}