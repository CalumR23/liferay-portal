			}
			else if ("${field}" == "release.tool.git.branch") {
				var releaseToolGitBranch = "${value}";
			}
			else if ("${field}" == "fix.pack.baseCommittish") {
				var fixPackBaseCommittish = "${value}";
			}
			else if ("${field}" == "patcher.combined.branch") {
				var patcherCombinedBranch = "${value}";
			}
			else if ("${field}" == "patcher.security.patch") {
				var patcherSecurityPatch = "${value}";
			}
			else if ("${field}" == "patcher.request.key") {
				var patcherRequestKey = "${value}";
			}
			else {
				fail("No such Jenkins job field ${field} for fixpack-builder-hotfix-7x");
			}
		}

		if (!(isSet(fixPackCustomerTicket))) {
