definition {

	var jobCompletionPollIntervalInMinutes = PropsUtil.get("job.completion.poll.interval.in.minutes");
	var jobCompletionPollMaximumIterations = PropsUtil.get("job.completion.poll.maximum.iterations");

	@prose = "I check the job with the name ${jobName} and build number ${jobBuildNumber} for completion"
	macro checkForJobCompletion {
		var currentIteration = "0";
		var jobInProgress = "true";

		while (("${currentIteration}" != "${jobCompletionPollMaximumIterations}") && ("${jobInProgress}" == "true") && (maxIterations = "30")) {
			Jenkins.openJenkinsURL();

			var key_jobBuildNumber = "${jobBuildNumber}";

			Jenkins.clickJobLink(jobName = "${jobName}");

			if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_BUILD_STATUS_IN_PROGRESS")) {
				var currentIteration = ${currentIteration} + 1;
				var jobInProgress = "true";

				Jenkins.pauseInMinutes(timeInMinutes = "${jobCompletionPollIntervalInMinutes}");
			}
			else {
				var jobInProgress = "false";
			}
		}

		if ("${jobInProgress}" == "true") {
			Jenkins.openJenkinsURL();

			var key_jobBuildNumber = "${jobBuildNumber}";

			Jenkins.clickJobLink(jobName = "${jobName}");

			if (IsElementPresent(locator1 = "Jenkins#JENKINS_JOB_BUILD_STATUS_IN_PROGRESS")) {
				fail("After ${currentIteration} attempts while waiting at ${jobCompletionPollIntervalInMinutes} minutes in between each attempt, the Jenkins job still appears to be in progress.");
			}
		}
	}

	macro clickConsoleOutputLink {
		AssertClick(
			locator1 = "Jenkins#CONSOLE_OUTPUT_LINK",
			value1 = "Console Output");
	}

	macro clickFullLogLink {
		if (IsElementPresent(locator1 = "Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK")) {
			Click(locator1 = "Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK");
		}
	}

	macro clickJobHealthLink {
		var key_jobName = "${jobName}";

		Click(locator1 = "Jenkins#JENKINS_JOB_HEALTH_LINK");
	}

	macro clickJobLink {
		var key_jobName = "${jobName}";

		Click(locator1 = "Jenkins#JENKINS_JOB_LINK");
	}

	macro clickStopButtonLink {
		Click(locator1 = "Jenkins#STOP_JOB_BUTTON");
	}

	@prose = "I get the current build number for the job titled ${jobName}"
	macro getCurrentJobBuildNumber {
		Jenkins.clickJobLink(jobName = "${jobName}");

		AssertElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		AssertVisible(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		Click(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		var hasFoundTheCorrectJob = "false";

		var count = "0";

		while (("${hasFoundTheCorrectJob}" == "false") && (maxIterations = "30")){
			var count = ${count} + 1;

			Click(
				locator1 = "Jenkins#JENKINS_JOB_SIDE_MENU",
				menuOption = "Parameters");

			while (IsElementNotPresent(key_content = "${staticGitRevision}", key_parameter= "git.revision", locator1 = "Jenkins#JENKINS_JOB_PARAMETERS_CONTENT")) {
				Click(
					locator1 = "Jenkins#JENKINS_JOB_SIDE_MENU",
					menuOption = "Previous Build");
			}

			if (IsElementPresent(key_content = "${staticGitRevision}", key_parameter= "git.revision", locator1 = "Jenkins#JENKINS_JOB_PARAMETERS_CONTENT")) {
				hasFoundTheCorrectJob = "true";
			}
			else{
				Click(
					locator1 = "Jenkins#JENKINS_JOB_SIDE_MENU",
					menuOption = "Back to Project");

				Click(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");
			}
		}

		if("${hasFoundTheCorrectJob}" == "false") {
            fail("After ${count} attempts the build could not be found!");
        }

		AssertTextEquals(
			key_content = "${staticGitRevision}",
			key_parameter = "git.revision",
			locator1 = "Jenkins#JENKINS_JOB_PARAMETERS_CONTENT",
			value1 = "${staticGitRevision}");

		static var staticJobBuildNumber = selenium.getText("Jenkins#JENKINS_JOB_BREADCRUMBS_BUILD_NUMBER");

		return "${staticJobBuildNumber}";
	}

	@prose = "I get the current build number for the short job titled ${jobName}"
	macro getCurrentJobBuildNumberForShortJob {
		Jenkins.clickJobLink(jobName = "${jobName}");

		if (IsElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER")) {
			AssertElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

			AssertVisible(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

			static var staticJobBuildNumber = selenium.getText("Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");
		}
		else {
			AssertElementPresent(locator1 = "Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");

			AssertVisible(locator1 = "Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");

			static var staticJobBuildNumber = selenium.getText("Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");
		}

		return "${staticJobBuildNumber}";
	}

	@prose = "I go to the console output for the job with the name ${jobName} and build number ${jobBuildNumber}"
	macro gotoConsoleOutput {
		var key_jobBuildNumber = "${jobBuildNumber}";

		Jenkins.clickJobLink(jobName = "${jobName}");

		Click(locator1 = "Jenkins#JENKINS_JOB_BUILD_LINK");

		Jenkins.clickConsoleOutputLink();
	}

	@prose = "I go to the Patcher Builder Jenkins homepage"
	macro openJenkinsURL {
		Open(locator1 = "/view/All");
	}

	@prose = "I test the patching tool install and revert features with the following parameters ${table}"
	macro patchingToolInstallAndRevert {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var mirrorUser = PropsUtil.get("mirror.user");
		var mirrorPassword = PropsUtil.get("mirror.password");
		var portalUrl = PropsUtil.get("portal.url");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "bundle") {
				var bundle = "${value}";
			}
			else if ("${field}" == "fixPack") {
				var fixPack = "${value}";
			}
			else if ("${field}" == "hotfix") {
				var hotfix = "${value}";
			}
			else if ("${field}" == "patchingTool") {
				var patchingTool = "${value}";
			}
			else if ("${field}" == "patchingToolMajorVersion") {
				var patchingToolMajorVersion = "${value}";
			}
			else {
				fail("No such Jenkins job field ${field} for ${value}");
			}
		}

		if (!(isSet(bundle))) {
			var bundle = "";
		}

		if (!(isSet(fixPack))) {
			var fixPack = "";
		}

		if (!(isSet(hotfix))) {
			var hotfix = "";
		}

		if (!(isSet(patchingTool))) {
			var patchingTool = "";
		}

		if (contains("${patchingTool}", "LATEST")) {
			var curlLatestPatchingTool = '''
				 http://mirrors.lax.liferay.com/files.liferay.com/private/ee/fix-packs/patching-tool/LATEST-${patchingToolMajorVersion}.0.txt
				 -u ${mirrorUser}:${mirrorPassword}
			''';

			var jsonResponse = JSONCurlUtil.get("${curlLatestPatchingTool}", "$");

			var latestVersion = StringUtil.extractFirst("${jsonResponse}", "F");

			var trimmedLatestVersion = StringUtil.trim("${latestVersion}");

			var patchingTool = StringUtil.replace("${patchingTool}", "LATEST", "${trimmedLatestVersion}");
		}

		var curl = '''
			${portalUrl}/view/All/job/test-fixpack-builder-install-revert\(2x-uat\)/buildWithParameters?token=${jenkinsAuthenticationToken}
			-d bundle=${bundle}
			-d fixPack=${fixPack}
			-d hotfix=${hotfix}
			-d patchingTool=${patchingTool}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

		Jenkins.testFixPackBuilderJenkinsJob(jenkinsJobName = "test-fixpack-builder-install-revert(2x-uat)");
	}

	@prose = "I wait for ${timeInSeconds} seconds"
	macro pause {
		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I wait for ${timeInMinutes} minutes"
	macro pauseInMinutes {
		var timeInSeconds = ${timeInMinutes} * 60;

		var timeInMilliseconds = ${timeInSeconds} * 1000;

		Pause(locator1 = "${timeInMilliseconds}");
	}

	@prose = "I start the fixpack-builder-agent job with the following parameters ${table}"
