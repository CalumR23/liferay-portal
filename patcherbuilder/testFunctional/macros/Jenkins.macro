			else if ("${field}" == "patcher.user.id") {
				var patcherUserId = "${value}";
			}
			else {
				fail("No such Jenkins job field ${field} for fixpack-builder-agent");
			}
		}

		if (!(isSet(osbPatcherBaseCommittish))) {
			var osbPatcherBaseCommittish = "";
		}

		if (!(isSet(osbPatcherCommittish))) {
			var osbPatcherCommittish = "";
		}

		if (!(isSet(osbPatcherFixIds))) {
			var osbPatcherFixIds = "";
		}

		if (!(isSet(osbPatcherGitRemoteUrl))) {
			var osbPatcherGitRemoteUrl = "";
		}

		if (!(isSet(osbPatcherPatcherFixId))) {
			var osbPatcherPatcherFixId = "";
		}

		if (!(isSet(osbPatcherProductVersion))) {
			var osbPatcherProductVersion = "";
		}

		if (!(isSet(osbPatcherRebase))) {
			var osbPatcherRebase = "";
		}

		if (!(isSet(osbPatcherRepository))) {
			var osbPatcherRepository = "";
		}

		if (!(isSet(osbPatcherType))) {
			var osbPatcherType = "";
		}

		if (!(isSet(patcherFixDeliveryMethod))) {
			var patcherFixDeliveryMethod = "";
		}

		if (!(isSet(patcherRequestKey))) {
			var patcherRequestKey = "";
		}

		if (!(isSet(patcherUserId))) {
			var patcherUserId = "";
		}

		var curl = '''
			${portalUrl}/view/All/job/fixpack-builder-agent\(2x-uat\)/buildWithParameters?token=${jenkinsAuthenticationToken}
			-d osb.patcher.baseCommittish=${osbPatcherBaseCommittish}
			-d osb.patcher.committish=${osbPatcherCommittish}
			-d osb.patcher.fixIds=${osbPatcherFixIds}
			-d osb.patcher.gitRemoteURL=${osbPatcherGitRemoteUrl}
			-d osb.patcher.patcherFixId=${osbPatcherPatcherFixId}
			-d osb.patcher.productVersion=${osbPatcherProductVersion}
			-d osb.patcher.rebase=${osbPatcherRebase}
			-d osb.patcher.repository=${osbPatcherRepository}
			-d osb.patcher.type=${osbPatcherType}
			-d patcher.fix.delivery.method=${patcherFixDeliveryMethod}
			-d patcher.request.key=${patcherRequestKey}
			-d patcher.user.id=${patcherUserId}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");
	}

	@prose = "I start the fixpack-builder-fixpack-7x uat job with the following parameters ${table}"
