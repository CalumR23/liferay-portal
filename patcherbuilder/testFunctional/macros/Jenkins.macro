		}

		if (!(isSet(gitRevision))) {
			var gitRevision = "";
		}

		if (!(isSet(patcherBuildId))) {
			var patcherBuildId = "";
		}

		if (!(isSet(patcherUserId))) {
			var patcherUserId = "";
		}

		if (!(isSet(patcherFixDeliveryMethod))) {
			var patcherFixDeliveryMethod = "";
		}

		if (!(isSet(releaseToolGitRemoteUserName))) {
			var releaseToolGitRemoteUserName = "";
		}

		if (!(isSet(releaseToolGitBranch))) {
			var releaseToolGitBranch = "";
		}

		if (!(isSet(fixPackBaseCommittish))) {
			var fixPackBaseCommittish = "";
		}

		if (!(isSet(patcherCombinedBranch))) {
			var patcherCombinedBranch = "false";
		}

		if (!(isSet(patcherSecurityPatch))) {
			var patcherSecurityPatch = "false";
		}

		if (!(isSet(patcherRequestKey))) {
			var patcherRequestKey = "";
		}

		var curl = '''
			${portalUrl}/view/All/job/fixpack-builder-hotfix-7x\(2x-uat\)/buildWithParameters?token=${jenkinsAuthenticationToken}
			-d fix.pack.customer.ticket=${fixPackCustomerTicket}
			-d fix.pack.built.for=${fixPackBuiltFor}
			-d fix.pack.fixed.issues=${fixPackFixedIssues}
			-d fix.pack.hotfixed.issues=${fixPackHotfixedIssues}
			-d fix.pack.id=${fixPackId}
			-d git.revision=${gitRevision}
			-d patcher.build.id=${patcherBuildId}
			-d patcher.user.id=${patcherUserId}
			-d patcher.fix.delivery.method=${patcherFixDeliveryMethod}
			-d release.tool.git.remote.username=${releaseToolGitRemoteUserName}
			-d release.tool.git.branch=${releaseToolGitBranch}
			-d fix.pack.baseCommittish=${fixPackBaseCommittish}
			-d patcher.combined.branch=${patcherCombinedBranch}
			-d patcher.security.patch=${patcherSecurityPatch}
			-d patcher.request.key=${patcherRequestKey}
			''';

		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curl}");

		return "${staticGitRevision}";
	}

	@prose = "I start the test-fixpack-builder-hotfix-copy job with the following parameters ${table}"
	macro startTestFixPackBuilderHotfixCopyJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var RawTable rawTable = new RawTable("${table}");

		for (var row : table "${rawTable}") {
			var field = "${row[0]}";
			var value = "${row[1]}";

			if ("${field}" == "destinationFilePath") {
				var destinationFilePath = "${value}";
			}
			else if ("${field}" == "originFilePath") {
				var originFilePath = "${value}";
			}
			else {
				fail("No such Jenkins job field ${field} for test-fixpack-builder-hotfix-copy");
			}
		}

		if (!(isSet(destinationFilePath))) {
			var destinationFilePath = "";
