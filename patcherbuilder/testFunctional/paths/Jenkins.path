<html>
<head>
<title>Jenkins</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Jenkins</td></tr>
</thead>

<tbody>
<tr>
	<td>JENKINS_VIEW_SELECT</td>
	<td>//select[@id='selectView']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_JOB-->
<tr>
	<td>JENKINS_JOB_STATUS_SUCCESS</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='Success']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_STATUS_FAILED</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='Failed']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_STATUS_IN_PROGRESS</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='In progress']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_STATUS_ABORTED</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='Aborted']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_LINK</td>
	<td>//tr[contains(@id,'${jobName}')]//a[@class='model-link inside']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_HEALTH_LINK</td>
	<td>//tr[contains(@id,'${jobName}')]//a[@class='build-health-link']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_JOB-->
<tr>
	<td>CURRENT_JENKINS_JOB_BUILD_NUMBER</td>
	<td>//tr[@class='build-row no-wrap transitive']//td[1]|//tr[contains(@class, 'build-row') and contains(@class, 'transitive')]//td[1]/div[1]/a[contains(@class, 'display-name')][1]</td>
	<td></td>
</tr>
<tr>
	<td>MOST_RECENT_JENKINS_JOB_BUILD_NUMBER</td>
	<td>//tr[@class='build-row no-wrap '][1]//td[1]|//tr[contains(@class, 'build-row') and not(contains(@class, 'transitive'))]//td[1]/div[1]/a[contains(@class, 'display-name')][1]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_BUILD_STATUS_SUCCESS</td>
	<td>//tr[contains(@class,'build-row')]//a[contains(@href,substring-after('${key_jobBuildNumber}', '#'))]/img[contains(@title,'Success')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_BUILD_STATUS_FAILED</td>
	<td>//tr[contains(@class,'build-row')]//a[contains(@href,substring-after('${key_jobBuildNumber}', '#'))]/img[contains(@title,'Failed')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_BUILD_STATUS_IN_PROGRESS</td>
	<td>//tr[contains(@class,'build-row')]//a[contains(@href,substring-after('${key_jobBuildNumber}', '#'))]/img[contains(@title,'In progress')]</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_BUILD_LINK</td>
	<td>//*[@id="buildHistory"]/div[2]/table/tbody/tr[2]/td/div[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_NODE</td>
	<td>//*[@id="main-panel"]/div[1]/div[2]/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_JOB_DETAILS-->
<tr>
	<td>CONSOLE_OUTPUT_LINK</td>
	<td>//a[contains(.,'Console Output')]</td>
	<td></td>
</tr>
<tr>
	<td>STOP_JOB_BUTTON</td>
	<td>//a[@class='stop-button-link']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CONSOLE_OUTPUT-->
<tr>
	<td>CONSOLE_OUTPUT_FULL_LOG_LINK</td>
	<td>//a[contains(.,'Full Log')]</td>
	<td></td>
</tr>
<tr>
	<td>CONSOLE_OUTPUT_TEXT</td>
	<td>//pre[@class='console-output']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>