		</execute>

		<execute macro="SalesforceOrderForm#deleteAdditionalOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceAccountName}-${salesforceProjectName}-S-2017.1.3" />
		</execute>

		<execute macro="SalesforceOrderForm#viewNoProductLineItem">
			<var name="salesforceProductKeyword" value="1/3/2017" />
		</execute>

		<execute macro="SalesforceOrderForm#deleteAdditionalOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceAccountName}-${salesforceProjectName}-S-2017.1.4" />
		</execute>

		<execute macro="SalesforceOrderForm#viewNoProductLineItem">
			<var name="salesforceProductKeyword" value="1/4/2017" />
		</execute>

		<execute macro="SalesforceOrderForm#viewQuote">
			<var name="salesforceOpportunityName" value="${salesforceAccountName}-${salesforceProjectName}-S-2017.1.1" />
			<var name="salesforceQuoteKeyword" value="2017.1.1" />
			<var name="salesforceQuoteTotalPrice" value="USD 11,750.00" />
		</execute>

		<execute macro="SalesforceOrderForm#viewProductLineItem">
			<var name="salesforceProductCombined" value="Not Checked" />
			<var name="salesforceProductKeyword" value="1/1/2017" />
			<var name="salesforceProductName" value="Liferay DXP Subscription - Gold Backup Sizing 1" />
			<var name="salesforceProductOpportunityName" value="${salesforceAccountName}-${salesforceProjectName}-S-2017.1.1" />
			<var name="salesforceProductQuantity" value="1.0" />
			<var name="salesforceProductSalesPrice" value="11,750.00" />
			<var name="salesforceProductTerm" value="1.0" />
			<var name="salesforceProductTotalPrice" value="11,750.00" />
			<var name="salesforceProductType" value="New" />
		</execute>
	</command>
</definition>