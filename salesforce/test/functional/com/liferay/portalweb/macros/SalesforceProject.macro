<definition>
	<command name="viewProjectDetails">
		<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_NAME" value1="${salesforceProjectName}" />
		<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_ACCOUNT" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_LIFERAY_VERSION" value1="${salesforceProjectLiferayVersion}" />
		<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_FIRST_LINE_SUPPORT" value1="${salesforceProjectFirstLineSupport}" />

		<if>
			<equals arg1="${salesforceProjectRecordType}" arg2="OEM" />
			<then>
				<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_LICENSE_OPTION_PURCHASED" value1="${salesforceProjectLicenseOptionPurchased}" />
				<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_SUPPORT_SERVICES_LEVEL" value1="${salesforceProjectPartnerLevel}" />
				<execute function="AssertTextEquals" locator1="SalesforceProject#PROJECT_DETAILS_MAXIMUM_NUM_CONTACTS" value1="${salesforceProjectMaximumNumContacts}" />
			</then>
		</if>
	</command>
</definition>