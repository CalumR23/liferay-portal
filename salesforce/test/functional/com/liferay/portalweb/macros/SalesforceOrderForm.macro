<definition>
	<command name="addAdditionalOpportunity">
		<var name="key_additionalOpportunityPositionValue" value="1" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" />
			<then>
				<var name="key_additionalOpportunityPositionValue" value="2" />
				<if>
					<condition function="IsElementPresent" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" />
					<then>
						<var name="key_additionalOpportunityPositionValue" value="3" />
					</then>
				</if>
			</then>
		</if>

		<execute macro="SalesforceButton#edit" />

		<execute function="Type" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY" value1="${salesforceOpportunityName}" />

		<execute macro="SalesforceButton#save" />

		<execute function="AssertElementNotPresent" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" value1="${salesforceOpportunityName}" />
	</command>

	<command name="addAdditionalOpportunityWithError">
		<var name="key_additionalOpportunityPositionValue" value="1" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" />
			<then>
				<var name="key_additionalOpportunityPositionValue" value="2" />
				<if>
					<condition function="IsElementPresent" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" />
					<then>
						<var name="key_additionalOpportunityPositionValue" value="3" />
					</then>
				</if>
			</then>
		</if>

		<execute macro="SalesforceButton#edit" />

		<execute function="Type" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY" value1="${salesforceOpportunityName}" />

		<execute macro="SalesforceButton#save" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR" value1="${salesforceOrderFormSaveError}" />
	</command>

	<command name="checkOrderFormDetail">
		<var name="key_orderFormDetail" value="${salesforceOrderFormDetail}" />

		<execute function="Check" locator1="SalesforceOrderFormAdd#ORDER_FORM_CHECKBOX" />
	</command>

	<command name="clickFirstQuoteNumber">
		<execute function="Click" locator1="SalesforceOrderForm#ORDER_FORM_FIRST_QUOTE_NUMBER" />
	</command>

	<command name="clickOrderFormAttachment">
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_ATTACHMENT_TITLE" value1="${salesforceOpportunityName}" />
		<execute function="Click" locator1="SalesforceOrderForm#ORDER_FORM_ATTACHMENT_VIEW" />

		<execute function="SelectWindow#selectPopUp" locator1="title=servlet.FileDownload" />
	</command>

	<command name="closeOrderFormAttachment">
		<execute function="Close#closeWindow" locator1="title=servlet.FileDownload" />
	</command>

	<command name="deleteAdditionalOpportunity">
		<var name="key_opportunityName" value="${salesforceOpportunityName}" />

		<execute macro="SalesforceButton#edit" />

		<execute function="Type" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_NAME" value1="" />

		<execute macro="SalesforceButton#save" />

		<execute function="AssertElementNotPresent" locator1="SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR" />
		<execute function="AssertElementNotPresent" locator1="SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK" />
	</command>

	<command name="deleteOrderFormAttachment">
		<execute function="Click" locator1="SalesforceOrderForm#ORDER_FORM_ATTACHMENT_DELETE" />
	</command>

	<command name="editItem">
		<var name="key_itemLabel" value="${salesforceOrderFormItemLabel}" />

		<execute function="DoubleClick" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_ITEM" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_SELECT" />
			<then>
				<execute function="Select" locator1="SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_SELECT" value1="${salesforceOrderFormItemValue}" />
			</then>
			<else>
				<execute function="Type" locator1="SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_ITEM" value1="${salesforceOrderFormItemValue}" />
			</else>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_ITEM" value1="${salesforceOrderFormItemValue}" />
		<execute function="AssertNotVisible" locator1="SalesforceOrderForm#ORDER_FORM_SAVE_ERROR" />
	</command>

	<command name="fillOrderForm">
		<execute function="Select" locator1="SalesforceOrderFormAdd#ORDER_FORM_DOC_TYPE" value1="${salesforceOrderFormDocType}" />
		<execute function="Type" locator1="SalesforceOrderFormAdd#ORDER_FORM_CONTACT" value1="${salesforceOrderFormContactFirstName} ${salesforceOrderFormContactLastName}" />
		<execute function="Select" locator1="SalesforceOrderFormAdd#ORDER_FORM_CONTRACTING_COUNTRY" value1="${salesforceOrderFormContractingCountry}" />
		<execute function="Select" locator1="SalesforceOrderFormAdd#ORDER_FORM_LANGUAGE" value1="${salesforceOrderFormLanguage}" />
		<execute function="Select" locator1="SalesforceOrderFormAdd#ORDER_FORM_CONTRACT_FORMAT" value1="${salesforceOrderFormContractFormat}" />
		<execute function="Type" locator1="SalesforceOrderFormAdd#ORDER_FORM_VALID_THROUGH_DATE" value1="${salesforceOrderFormValidThroughDate}" />
	</command>

	<command name="regeneratePDF">
		<execute function="Click" locator1="SalesforceOrderForm#REGENERATE_PDF_BUTTON" />

		<execute function="Pause" locator1="10000" />
	</command>

	<command name="viewNoProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<execute function="AssertElementNotPresent" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_NAME" />
	</command>

	<command name="viewNoQuote">
		<var name="key_quoteKeyword" value="${salesforceQuoteKeyword}" />

		<execute function="AssertElementNotPresent" locator1="SalesforceOrderForm#ORDER_FORM_QUOTE_OPPORTUNITY_NAME" />
	</command>

	<command name="viewOrderFormAttachmentDetail">
		<var name="key_orderFormAttachmentDetail" value="${salesforceOrderFormAttachmentDetail}" />

		<execute function="AssertElementPresent" locator1="SalesforceOrderFormAttachment#ORDER_FORM_ATTACHMENT_VALUE" />
	</command>

	<command name="viewOrderFormDetails">
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_DOC_TYPE" value1="${salesforceOrderFormDocType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_CONTACT" value1="${salesforceOrderFormContactFirstName} ${salesforceOrderFormContactLastName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_CONTRACTING_COUNTRY" value1="${salesforceOrderFormContractingCountry}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_LANGUAGE" value1="${salesforceOrderFormLanguage}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_CONTRACT_FORMAT" value1="${salesforceOrderFormContractFormat}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_DETAILS_VALID_THROUGH_DATE" value1="${salesforceOrderFormValidThroughDate}" />
	</command>

	<command name="viewProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />
		<var name="key_productCombined" value="${salesforceProductCombined}" />

		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_NAME" value1="${salesforceProductName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_QUANTITY" value1="${salesforceProductQuantity}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_TERM" value1="${salesforceProductTerm}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_SALES_PRICE" value1="${salesforceProductSalesPrice}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_TOTAL_PRICE" value1="${salesforceProductTotalPrice}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_TYPE" value1="${salesforceProductType}" />
		<execute function="AssertElementPresent" locator1="SalesforceOrderForm#ORDER_FORM_PRODUCT_COMBINED" />
	</command>

	<command name="viewQuote">
		<var name="key_quoteKeyword" value="${salesforceQuoteKeyword}" />

		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_QUOTE_OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOrderForm#ORDER_FORM_QUOTE_TOTAL_PRICE" value1="${salesforceQuoteTotalPrice}" />
	</command>

	<command name="viewSubsequentOrderFormAttachmentDetails">
		<var name="orderFormDetailLocator" value="//div[@class=&apos;textLayer&apos;]//div[contains(.,&apos;${salesforceOrderFormAttachmentDetailFirst}&apos;)]" />

		<for list="${salesforceOrderFormAttachmentDetailsList}" param="salesforceOrderFormAttachmentDetail">
			<var method="StringUtil#replace('${salesforceOrderFormAttachmentDetail}',';',',')" name="salesforceOrderFormAttachmentDetail" />

			<var method="StringUtil#add('${orderFormDetailLocator}', '//following-sibling::div[contains(.,&quot;${salesforceOrderFormAttachmentDetail}&quot;)]', '')" name="orderFormDetailLocator" />
			<echo>Salesforce Order Form Attachment: ${salesforceOrderFormAttachmentDetail}</echo>
		</for>

		<execute function="AssertElementPresent" locator1="${orderFormDetailLocator}" />
	</command>
</definition>