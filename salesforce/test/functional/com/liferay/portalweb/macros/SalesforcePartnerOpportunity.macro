<definition>
	<command name="clickFirstQuoteNumber">
		<execute function="Click" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_FIRST_QUOTE_NUMBER" />
	</command>

	<command name="clickOpportunity">
		<execute function="Click" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY" />

		<execute macro="SalesforceOpportunity#gotoDetails" />
	</command>

	<command name="editStage">
		<execute function="DoubleClick" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_STAGE" />

		<execute function="Select" locator1="SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_STAGE" value1="${salesforcePartnerOpportunityStage}" />

		<execute function="Pause" locator1="3000" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_PRIMARY_REASON_LOST" />
			<then>
				<execute function="Select" locator1="SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_PRIMARY_REASON_LOST" value1="${salesforcePartnerOpportunityPrimaryReasonLost}" />
			</then>
		</if>

		<execute macro="SalesforceButton#modalOK" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_STAGE" value1="${salesforcePartnerOpportunityStage}" />
		<execute function="AssertNotVisible" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_SAVE_ERROR" />
	</command>

	<command name="fillPartnerOpportunity">
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName} ${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_FIRST_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_LAST_NAME" value1="${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_EMAIL" value1="${salesforcePartnerOpportunityPartnerEmail}" />
		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_CURRENCY" value1="${salesforcePartnerOpportunityCurrency}" />
		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_OPPORTUNITY_TYPE" value1="${salesforcePartnerOpportunityType}" />
	</command>

	<command name="syncProducts">
		<execute function="Click" locator1="SalesforcePartnerOpportunity#SYNC_PRODUCTS_BUTTON" />
	</command>

	<command name="viewPartnerOpportunityDetails">
		<execute function="AssertTextEquals" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName} ${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="AssertTextEquals" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_FIRST_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName}" />
		<execute function="AssertTextEquals" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_LAST_NAME" value1="${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_EMAIL" value1="${salesforcePartnerOpportunityPartnerEmail}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY" value1="${salesforceOpportunityName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OWNER" value1="${salesforcePartnerOpportunityOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY_TYPE" value1="${salesforcePartnerOpportunityType}" />
	</command>
</definition>