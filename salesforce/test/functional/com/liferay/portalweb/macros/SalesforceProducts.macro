<definition>
	<command name="addProduct">
		<if>
			<condition function="IsElementPresent" locator1="SalesforceProductAdd#SELECT_PRICE_BOOK" />
			<then>
				<execute function="Select" locator1="SalesforceProductAdd#SELECT_PRICE_BOOK" value1="${salesforcePriceBook}" />

				<execute macro="SalesforceButton#save" />
			</then>
		</if>

		<execute macro="SalesforceProducts#searchProduct">
			<var name="salesforceProductName" value="${salesforceProductName}" />
		</execute>

		<execute macro="SalesforceProducts#selectProduct">
			<var name="salesforceProductName" value="${salesforceProductName}" />
		</execute>

		<if>
			<and>
				<isset var="salesforceProductQuantity" />
				<not>
					<contains string="${salesforceProductQuantity}" substring="{salesforceProductQuantity}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_QUANTITY" value1="${salesforceProductQuantity}" />
			</then>
			<else>
				<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_QUANTITY" value1="1" />
			</else>
		</if>

		<if>
			<and>
				<isset var="salesforceProductSalesPrice" />
				<not>
					<contains string="${salesforceProductSalesPrice}" substring="{salesforceProductSalesPrice}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_SALES_PRICE" value1="${salesforceProductSalesPrice}" />
			</then>
		</if>

		<execute function="Select" locator1="SalesforceProductAdd#PRODUCT_TERM_TYPE" value1="${salesforceProductTermType}" />

		<if>
			<and>
				<isset var="salesforceProductType" />
				<not>
					<contains string="${salesforceProductType}" substring="{salesforceProductType}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="SalesforceProductAdd#PRODUCT_PRODUCT_TYPE" value1="${salesforceProductType}" />
			</then>
		</if>

		<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_DATE" value1="${salesforceProductDate}" />
		<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_END_DATE" value1="${salesforceProductEndDate}" />

		<if>
			<and>
				<isset var="salesforceProductAnnualSalesPrice" />
				<not>
					<contains string="${salesforceProductAnnualSalesPrice}" substring="{salesforceProductAnnualSalesPrice}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="SalesforceProductAdd#PRODUCT_ANNUAL_SALES_PRICE" value1="${salesforceProductAnnualSalesPrice}" />
			</then>
		</if>

		<execute macro="SalesforceButton#save" />
	</command>

	<command name="clickFindProduct">
		<execute function="Click" locator1="SalesforceProducts#FIND_PRODUCT_BUTTON" />
	</command>

	<command name="searchProduct">
		<execute function="Type" locator1="SalesforceProductAdd#SEARCH_PRODUCT_NAME_KEYWORD_FIELD" value1="${salesforceProductName}" />

		<execute macro="SalesforceButton#search" />
	</command>

	<command name="selectProduct">
		<var name="key_productName" value="${salesforceProductName}" />

		<execute function="Check" locator1="SalesforceProductAdd#SELECT_PRODUCT_NAME_CHECKBOX" />

		<execute macro="SalesforceButton#select" />
	</command>
</definition>