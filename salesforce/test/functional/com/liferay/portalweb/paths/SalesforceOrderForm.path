<html>
<head>
<title>SalesforceOrderForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOrderForm</td></tr>
</thead>
<tbody>
<!--ORDER_FORM_DETAILS-->
<tr>
	<td>ORDER_FORM_DETAILS_TITLE</td>
	<td>//h2[@class='mainTitle' and contains(.,'Liferay Order Form')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_DOC_TYPE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Doc Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Opportunity')]//following-sibling::td//a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_ACCOUNT_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Account')]//following-sibling::td//div/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_CONTACT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contact')]//following-sibling::td//div/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_CONTRACTING_COUNTRY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contracting Country')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_LANGUAGE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Language')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_CONTRACT_FORMAT</td>
	<td>//span[.//text()='Contract Format']//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_DETAILS_VALID_THROUGH_DATE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Valid Through Date')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADD_QUOTE-->
<tr>
	<td>ADD_QUOTE_BUTTON</td>
	<td>//input[@title='New Quote']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ORDER_FORM_QUOTES-->
<tr>
	<td>ORDER_FORM_QUOTE_NUMBER</td>
	<td>//div[@class='listRelatedObject quoteBlock']//table//tr[contains(.,'${key_quoteKeyword}')]/th/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_FIRST_QUOTE_NUMBER</td>
	<td>//div[@class='listRelatedObject quoteBlock']//table//tr[2]/th/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_FIRST_QUOTE_EDIT</td>
	<td>//div[@class='listRelatedObject quoteBlock']//table//tr//a[@class='actionLink' and contains(@title,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_FIRST_QUOTE_DELETE</td>
	<td>//div[@class='listRelatedObject quoteBlock']//table//tr//a[@class='actionLink' and contains(@title,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ORDER_FORM_PRODUCT_LINE_ITEMS-->
<tr>
	<td>ORDER_FORM_PRODUCT_NAME</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//th//a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_OPPORTUNITY_NAME</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[2]/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_TERM</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'numericalColumn')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_QUANTITY</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'numericalColumn')][2]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_SALES_PRICE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'CurrencyElement')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_TOTAL_PRICE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'CurrencyElement')][2]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_PRODUCT_TERM_TYPE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[7]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ORDER_FORM_ATTACHMENT-->
<tr>
	<td>REGENERATE_PDF_BUTTON</td>
	<td>//input[@title='Regenerate PDF']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ORDER_FORM_ATTACHMENT-->
<tr>
	<td>ORDER_FORM_ATTACHMENT_EDIT</td>
	<td>//div[contains(@id,'RelatedNoteList')]//td//a[@class='actionLink' and contains(@title,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ATTACHMENT_VIEW</td>
	<td>//div[contains(@id,'RelatedNoteList')]//td//a[@class='actionLink' and contains(@title,'View')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ATTACHMENT_DELETE</td>
	<td>//div[contains(@id,'RelatedNoteList')]//td//a[@class='actionLink' and contains(@title,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ATTACHMENT_TITLE</td>
	<td>//div[contains(@id,'RelatedNoteList')]//td[2]//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>