<html>
<head>
<title>SalesforceLeadConversionForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceLeadConversionForm</td></tr>
</thead>
<tbody>
<tr>
	<td>RECORD_OWNER</td>
	<td>//label[text()='Record Owner']//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//td[text()='Account Name']//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_NAME</td>
	<td>//td[text()='Opportunity Name']//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>CONVERTED_STATUS</td>
	<td>//label[text()='Converted Status']//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>TASK_SUBJECT</td>
	<td>//label[text()='Subject']//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>TASK_ACTIVITY_CURRENCY</td>
	<td>//label[text()='Activity Currency']//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>STATUS</td>
	<td>//label[text()='Status']//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>PRIORITY</td>
	<td>//label[text()='Priority']//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CONVERT_TO_EXISTING_CONTACT-->
<tr>
	<td>ERROR_CONVERT_EXISTING_CONTACT</td>
	<td>//div[contains(@class,'pbError') and contains(.,'Convert to an existing contact to avoid creating duplicates.')]</td>
	<td></td>
</tr>
<tr>
	<td>EXISTING_CONTACT</td>
	<td>//tr[contains(@class,'dataRow')]//th/input</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>