<html>
<head>
<title>SalesforceNavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceNavigation</td></tr>
</thead>
<tbody>
<!--SAVE_ERROR-->
<tr>
	<td>SAVE_ERROR</td>
	<td>//div[@id='errorDiv_ep']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--TOOLBAR-->
<tr>
	<td>USER_PROFILE_DROPDOWN_LINK</td>
	<td>//div[@id='userNavButton']//span</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_PROFILE_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Profile')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_SETTINGS_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Settings')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_LOGOUT_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'Logout')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--HEADER_TABS-->
<tr>
	<td>HOME_TAB</td>
	<td>//li[@id='home_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>LEADS_TAB</td>
	<td>//li[@id='Lead_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNTS_TAB</td>
	<td>//li[@id='Account_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>CONTACTS_TAB</td>
	<td>//li[@id='Contact_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITIES_TAB</td>
	<td>//li[@id='Opportunity_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCTS_TAB</td>
	<td>//li[@id='Product2_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>PROJECTS_TAB</td>
	<td>//li//a[contains(@title,'Projects Tab')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACTS_TAB</td>
	<td>//li//a[contains(@title,'Contracts Tab')]</td>
	<td></td>
</tr>
<tr>
	<td>ALL_TABS</td>
	<td>//li//a/img[@title='All Tabs']</td>
	<td></td>
</tr>
<tr>
	<td>MORE_TABS</td>
	<td>//li//a[contains(@title,'More Tabs Menu')]</td>
	<td></td>
</tr>
<tr>
	<td>GENERIC_LINK</td>
	<td>//a[contains(.,'${key_linkEntity}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>