<html>
<head>
<title>SalesforceProducts</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceProducts</td></tr>
</thead>

<tbody>

<!--FIND_PRODUCTS-->

<tr>
	<td>FIND_PRODUCT_BUTTON</td>
	<td>//input[@title='Find Product']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--RECENT_PRODUCTS-->

<tr>
	<td>RECENT_PRODUCT_NAME</td>
	<td>//div[contains(@class,'RelatedList')]//tr[contains(.,'${key_productName}')]//th/a</td>
	<td></td>
</tr>
<tr>
	<td>RECENT_PRODUCT_CODE</td>
	<td>//div[contains(@class,'RelatedList')]//tr[contains(.,'${key_productName}')]//td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_RECENT_PRODUCT_NAME</td>
	<td>//div[contains(@class,'RelatedList')]//tr[2]//th/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>