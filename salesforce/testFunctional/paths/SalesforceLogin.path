<html>
<head>
<title>SalesforceLogin</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceLogin</td></tr>
</thead>
<tbody>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[@id='username']</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[@id='password']</td>
	<td></td>
</tr>
<tr>
	<td>LOGIN_BUTTON</td>
	<td>//input[@id='Login']</td>
	<td></td>
</tr>
<tr>
	<td>REMEMBER_ME_CHECKBOX</td>
	<td>//input[contains(@id,'remember')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>