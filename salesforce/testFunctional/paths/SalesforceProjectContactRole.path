<html>
<head>
<title>SalesforceProjectContactRole</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceProjectContactRole</td></tr>
</thead>

<tbody>

<!--PROJECT_CONTACT_ROLE-->

<tr>
	<td>PROJECT_CONTACT_ACCOUNT</td>
	<td>//label[contains(.,'Account')]//parent::td//following-sibling::td//span//input</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ACCOUNT_LOOKUP</td>
	<td>//label[contains(.,'Account')]//parent::td//following-sibling::td//span//a[contains(@title,'Account Lookup')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ACCOUNT_LOOKUP_ACCOUNT</td>
	<td>//a[contains(.,'${key_accountName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ROLE_PROJECT</td>
	<td>//label[contains(.,'Project')]//parent::td//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ROLE_CONTACT</td>
	<td>//label[contains(.,'Contact')]//parent::td//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ROLE_CONTACT_ROLE</td>
	<td>//label[contains(.,'Contact Role')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ROLE_CURRENCY</td>
	<td>//label[contains(.,'Currency')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CONTACT_ROLE_PRIMARY</td>
	<td>//label[contains(.,'Primary')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>