<html>
<head>
<title>SalesforceContact</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceContact</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACT_DETAILS_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_ACCOUNT_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Account Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_TITLE</td>
	<td>//td[@class='labelCol' and contains(.,'Title')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_PURCHASE_DECISION_INVOLVEMENT</td>
	<td>//td[@class='labelCol' and contains(.,'Purchase Decision Involvement')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_CONTACT_TYPE</td>
	<td>//td[@class='labelCol' and contains(.,'Contact Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_EMAIL</td>
	<td>//td[@class='labelCol' and ./text()='Email']//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_DETAILS_MAILING_COUNTRY</td>
	<td>//td[@class='labelCol' and contains(.,'Mailing Address')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>