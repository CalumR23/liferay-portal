<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceContract</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTRACT_DETAILS_ACCOUNT_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Account Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACT_DETAILS_LIFERAY_SIGNING_ENTITY</td>
	<td>//td[@class='labelCol' and contains(.,'Liferay Signing Entity')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACT_DETAILS_CONTRACT_TYPE</td>
	<td>//td[@class='labelCol' and contains(.,'Contract Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACT_DETAILS_CONTRACT_FORMAT</td>
	<td>//td[@class='labelCol' and contains(.,'Contract Format')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACT_DETAILS_CONTRACT_NUMBER</td>
	<td>//td[@class='labelCol' and contains(.,'Contract Number')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>