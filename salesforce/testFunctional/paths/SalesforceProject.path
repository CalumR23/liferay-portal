<html>
<head>
<title>SalesforceProject</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceProject</td></tr>
</thead>

<tbody>

<!--PROJECT_DETAILS_DETAIL-->

<tr>
	<td>PROJECT_DETAILS_TITLE</td>
	<td>//h2[@class='mainTitle' and contains(.,'Project Detail')]</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Project Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_ACCOUNT</td>
	<td>//td[@class='labelCol' and contains(.,'Account')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_LIFERAY_VERSION</td>
	<td>//td[@class='labelCol' and contains(.,'Liferay Version')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_LICENSE_OPTION_PURCHASED</td>
	<td>//td[@class='labelCol' and contains(.,'License Option Purchased')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_SUPPORT_SERVICES_LEVEL</td>
	<td>//td[@class='labelCol' and contains(.,'Support Services Level')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_MAXIMUM_NUM_CONTACTS</td>
	<td>//td[@class='labelCol' and contains(.,'Maximum Num Contacts')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_SUPPORT_LANGUAGE</td>
	<td>//td[@class='labelCol' and contains(.,'Support Language')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_FIRST_LINE_SUPPORT</td>
	<td>//td[@class='labelCol' and contains(.,'Partner First Line Support')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_DETAILS_SUPPORT_CENTER</td>
	<td>//td[@class='labelCol' and contains(.,'Support Center')]//parent::span//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>