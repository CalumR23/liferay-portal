<html>
<head>
<title>SalesforceButton</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceButton</td></tr>
</thead>
<tbody>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[@title='Cancel']</td>
	<td></td>
</tr>
<tr>
	<td>CONTINUE_BUTTON</td>
	<td>//input[@title='Continue']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//input[@title='Delete']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//input[@title='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>GO_BUTTON</td>
	<td>//input[@title='Go!']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_BUTTON</td>
	<td>//input[@title='New']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[@title='Save']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_AND_ADD_PRODUCT_BUTTON</td>
	<td>//input[@title='Save &amp; Add Product']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_AND_NEW_BUTTON</td>
	<td>//input[@title='Save &amp; New']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>//input[@title='Select']</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[@title='Search' and @type='button']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_FROM_LIST_BUTTON</td>
	<td>//a[@title='Add']//img</td>
	<td></td>
</tr>
<tr>
	<td>CONVERT_BUTTON</td>
	<td>//input[@title='Convert']</td>
	<td></td>
</tr>
<tr>
	<td>CONVERT_TO_SELECTED_BUTTON</td>
	<td>//input[@title='Convert to Selected']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MODAL_BUTTONS-->
<tr>
	<td>MODAL_OK_BUTTON</td>
	<td>//div[@id='InlineEditDialogContent']//input[@value='OK']</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_CANCEL_BUTTON</td>
	<td>//div[@id='InlineEditDialogContent']//input[@value='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>