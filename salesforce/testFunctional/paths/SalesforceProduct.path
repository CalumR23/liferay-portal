<html>
<head>
<title>SalesforceProduct</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceProduct</td></tr>
</thead>

<tbody>

<!--PRODUCT_DETAILS-->

<tr>
	<td>PRODUCT_DETAILS_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Opportunity')]//following-sibling::td//a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Product')]//following-sibling::td//a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRODUCT_TYPE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Product Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_QUANTITY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Quantity')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_LIST_PRICE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'List Price')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_SALES_PRICE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Sales Price') and contains(.,'auto-calculated')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ANNUAL_SALES_PRICE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Annual Sales Price')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_PRODUCT_TERM_TYPE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Product Term Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_DATE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Date')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_END_DATE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'End Date')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ALLOTTED_CREDIT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Allotted Credit')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ALLOTTED_DISCOUNT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Allotted Discount')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ARR</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'ARR')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ITEM</td>
	<td>//td[contains(@class,'labelCol') and .//text()='${key_itemLabel}']//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCT_DETAILS_ITEM_CHECKED</td>
	<td>//td[contains(@class,'labelCol') and .//text()='${key_itemLabel}']//following-sibling::td//img[@title='Checked']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--EDIT_PRODUCT_DETAILS-->

<tr>
	<td>EDIT_PRODUCT_DETAILS_ITEM</td>
	<td>//td[@class='labelCol' and .//text()='${key_itemLabel}']//following-sibling::td//input[@type='text']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_PRODUCT_DETAILS_SELECT</td>
	<td>//td[@class='labelCol' and .//text()='${key_itemLabel}']//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_PRODUCT_DETAILS_CHECKBOX</td>
	<td>//td[@class='labelCol' and .//text()='${key_itemLabel}']//following-sibling::td//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>