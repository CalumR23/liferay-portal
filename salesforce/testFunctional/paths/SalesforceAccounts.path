<html>
<head>
<title>SalesforceAccounts</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceAccounts</td></tr>
</thead>

<tbody>

<!--RECENT_ACCOUNT-->

<tr>
	<td>RECENT_ACCOUNT_NAME</td>
	<td>//div[contains(@class,'RelatedList')]//a[.//text()='${key_accountName}']</td>
	<td></td>
</tr>
<tr>
	<td>RECENT_ACCOUNT_BILLING_CITY</td>
	<td>//div[contains(@class,'RelatedList')]//a[.//text()='${key_accountName}']//parent::th//following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>RECENT_ACCOUNT_PHONE</td>
	<td>//div[contains(@class,'RelatedList')]//a[.//text()='${key_accountName}']//parent::th//following-sibling::td[2]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_RECENT_ACCOUNT_NAME</td>
	<td>//div[contains(@class,'RelatedList')]//tr[2]//th/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>