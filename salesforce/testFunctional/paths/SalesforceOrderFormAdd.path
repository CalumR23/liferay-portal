<html>
<head>
<title>SalesforceOrderFormAdd</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOrderFormAdd</td></tr>
</thead>

<tbody>

<!--ORDER_FORM-->

<tr>
	<td>ORDER_FORM_DOC_TYPE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Doc Type')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Opportunity')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ACCOUNT_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Account')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CONTACT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contact')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CONTRACTING_COUNTRY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contracting Country')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_LANGUAGE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Language')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_SPECIAL_TERMS</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Special Terms')]//following-sibling::td//textarea</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CONTRACT_FORMAT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contract Format')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_VALID_THROUGH_DATE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Valid Through Date')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CHECKBOX</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'${key_orderFormDetail}')]//following-sibling::td/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ADDITIONAL_OPPORTUNITY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Additional Opportunity ${key_additionalOpportunityPositionValue}')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ADDITIONAL_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Additional Opportunity')]//following-sibling::td//span/input[contains(@value,'${key_opportunityName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Additional Opportunity ${key_additionalOpportunityPositionValue}')]//following-sibling::td//div[contains(@class,'errorMsg')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>