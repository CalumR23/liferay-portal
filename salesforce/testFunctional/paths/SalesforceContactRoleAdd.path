<html>
<head>
<title>SalesforceContactRoleAdd</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceContactRoleAdd</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACT_ROLE_PRIMARY</td>
	<td>xpath=(//td[@class='cbindex radioCol']/input)[${key_contactRolePrimaryPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_ROLE_CONTACT</td>
	<td>xpath=(//span[@class='lookupInput']/input)[${key_contactRolePositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_ROLE_ROLE</td>
	<td>xpath=(//select[contains(@id,'role')])[${key_contactRolePositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>