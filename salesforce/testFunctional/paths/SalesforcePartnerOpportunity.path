<html>
<head>
<title>SalesforcePartnerOpportunity</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforcePartnerOpportunity</td></tr>
</thead>

<tbody>
<tr>
	<td>SYNC_PRODUCTS_BUTTON</td>
	<td>//input[@title='Sync Products' and @type='button']</td>
	<td></td>
</tr>

<!--PARTNER_OPPORTUNITY_DETAILS-->

<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_TITLE</td>
	<td>//h2[@class='mainTitle' and contains(.,'Partner Opportunity Detail')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PARTNER_NAME</td>
	<td>//span[contains(.,'Partner Name')]//parent::td//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PARTNER_FIRST_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Partner First Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PARTNER_LAST_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Partner Last Name')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PARTNER_EMAIL</td>
	<td>//td[@class='labelCol' and contains(.,'Partner Email')]//parent::span//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY</td>
	<td>//span[contains(.,'Use this field if you need to associate this Partner Opportunity to a new Opportunity')]//parent::td//following-sibling::td//a</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_OWNER</td>
	<td>//td[@class='labelCol' and contains(.,'Owner')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY_TYPE</td>
	<td>//td[@class='labelCol' and contains(.,'Opportunity Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_STAGE</td>
	<td>//td[@class='labelCol' and contains(.,'Stage')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PRIMARY_CONTACT</td>
	<td>//td[@class='labelCol' and contains(.,'Primary Contact')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_ADDITIONAL_CONTACTS</td>
	<td>//td[@class='labelCol' and contains(.,'Additional Contacts')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_DESCRIPTION</td>
	<td>//td[@class='labelCol' and contains(.,'Description')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_COMPLETED_SALES_ACTIVITIES</td>
	<td>//td[@class='labelCol' and contains(.,'Completed Sales Activities')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_ANTICIPATED_PARTNER_SERVICES</td>
	<td>//td[@class='labelCol' and contains(.,'Anticipated Partner Services')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_ANTICIPATED_LIFERAY_SERVICES</td>
	<td>//td[@class='labelCol' and contains(.,'Anticipated Liferay Services')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_DEAL_SIZE</td>
	<td>//td[@class='labelCol' and contains(.,'Deal Size')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_PURCHASE_TIMEFRAME</td>
	<td>//td[@class='labelCol' and contains(.,'Purchase Timeframe')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DETAILS_CHANGE_REQUEST</td>
	<td>//td[@class='last labelCol' and contains(.,'Change Request')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PARTNER_OPPORTUNITY_QUOTES-->

<tr>
	<td>PARTNER_OPPORTUNITY_FIRST_QUOTE_NUMBER</td>
	<td>//div[@class='listRelatedObject quoteBlock']//tr//th//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PARTNER_OPPORTUNITY_QUOTE_LINE_ITEMS-->

<tr>
	<td>PARTNER_OPPORTUNITY_FIRST_QUOTE_LINE_ITEM_PRODUCT</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr//th//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--EDIT_MODAL_DEPENDENT_FIELDS-->

<tr>
	<td>EDIT_PARTNER_OPPORTUNITY_STAGE</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Stage')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_PARTNER_OPPORTUNITY_PRIMARY_REASON_LOST</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Primary Reason Lost')]//following-sibling::td//select[contains(.,'Other')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>