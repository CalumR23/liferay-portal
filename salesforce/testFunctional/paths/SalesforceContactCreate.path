<html>
<head>
<title>SalesforceContactCreate</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceContactCreate</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACT_FIRST_NAME</td>
	<td>//label[contains(.,'First Name')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_LAST_NAME</td>
	<td>//label[contains(.,'Last Name')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_ACCOUNT_NAME</td>
	<td>//label[contains(.,'Account Name')]//parent::td//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_TITLE</td>
	<td>//label[contains(.,'Title')]//parent::span//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_PURCHASE_DECISION_INVOLVEMENT</td>
	<td>//label[contains(.,'Purchase Decision Involvement')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_CONTACT_TYPE</td>
	<td>//label[contains(.,'Contact Type')]//parent::span//parent::td//following-sibling::td//tr[2]//select</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_CURRENCY</td>
	<td>//label[contains(.,'Contact Currency')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_EMAIL</td>
	<td>//td[@class='labelCol']/label[./text()='Email']/parent::td/following-sibling::td/input</td>
	<td></td>
</tr>
<tr>
	<td>CONTACT_MAILING_COUNTRY</td>
	<td>//label[contains(.,'Mailing Country')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>