<html>
<head>
<title>SalesforceQuote</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceQuote</td></tr>
</thead>

<tbody>

<!--QUOTE_DETAILS-->

<tr>
	<td>QUOTE_DETAILS_QUOTE_NUMBER</td>
	<td>//td[@class='labelCol' and contains(.,'Quote Number')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_QUOTE_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Quote Name')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_OPPORTUNITY_NAME</td>
	<td>//td[@class='last labelCol' and contains(.,'Opportunity Name')]//following-sibling::td//div//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--QUOTE_DETAILS_TOTALS-->

<tr>
	<td>QUOTE_DETAILS_SUBTOTAL</td>
	<td>//td[@class='labelCol' and contains(.,'Subtotal')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_DISCOUNT</td>
	<td>//td[@class='labelCol' and contains(.,'Discount')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_TOTAL_PRICE</td>
	<td>//td[@class='labelCol' and contains(.,'Total Price')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_TAX</td>
	<td>//td[@class='labelCol' and contains(.,'Tax')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_GRAND_TOTAL_PLUS_SHIPPING_TAXES</td>
	<td>//td[@class='labelCol' and contains(.,'Grand Total')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_GST</td>
	<td>//td[@class='labelCol' and contains(.,'GST')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_DETAILS_GRAND_TOTAL</td>
	<td>//td[@class='last labelCol' and contains(.,'Grand Total')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PARTNER_OPPORTUNITY-->

<tr>
	<td>QUOTE_PARTNER_OPPORTUNITY_ID</td>
	<td>//div[@class='listRelatedObject Custom15Block']//tr//th//a</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PARTNER_OPPORTUNITY_ACCOUNT_NAME</td>
	<td>//div[@class='listRelatedObject Custom15Block']//tr[contains(@class,'dataRow')]//td[2]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PARTNER_OPPORTUNITY_PARTNER_EMAIL</td>
	<td>//div[@class='listRelatedObject Custom15Block']//tr[contains(@class,'dataRow')]//td[3]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PARTNER_OPPORTUNITY_PARTNER_FULL_NAME</td>
	<td>//div[@class='listRelatedObject Custom15Block']//tr[contains(@class,'dataRow')]//td[4]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PARTNER_OPPORTUNITY_PARTNER_STAGE</td>
	<td>//div[@class='listRelatedObject Custom15Block']//tr[contains(@class,'dataRow')]//td[5]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--QUOTE_LINE_ITEMS-->

<tr>
	<td>QUOTE_ADD_LINE_ITEM_BUTTON</td>
	<td>//input[@title='Add Line Item']</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_PRICE_BOOK</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//h3</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_NAME</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//th//a</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_FIRST_PRODUCT_NAME</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr//th//a</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_TERM</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'numericalColumn')]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_DATE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'DateElement')]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_END_DATE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'DateElement')][2]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_PRODUCT_TOTAL_PRICE</td>
	<td>//div[@class='listRelatedObject quoteLineItemBlock']//tr[contains(.,'${key_productKeyword}')]//td[contains(@class,'CurrencyElement')][1]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>