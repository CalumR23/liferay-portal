definition {

	macro addAndSyncProductsViaPartnerOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.clickPartnerOpportunity(salesforcePartnerOpportunityKeyword = "Open");

		SalesforcePartnerOpportunity.clickFirstQuoteNumber();

		SalesforceQuote.addProductLineItem(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductAnnualSalesPrice = "${salesforceProductAnnualSalesPrice}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "${salesforceProductName}",
			salesforceProductQuantity = "${salesforceProductQuantity}",
			salesforceProductSalesPrice = "${salesforceProductSalesPrice}",
			salesforceProductTermType = "${salesforceProductTermType}",
			salesforceProductType = "${salesforceProductType}");

		SalesforceQuote.clickPartnerOpportunity();

		SalesforcePartnerOpportunity.syncProducts();

		SalesforceOpportunity.clickProduct(salesforceProductKeyword = "${salesforceProductName}");

		SalesforceProduct.viewProductDetails(
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceProductAnnualSalesPrice = "${salesforceProductAnnualSalesPrice}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "${salesforceProductName}",
			salesforceProductQuantity = "${salesforceProductQuantity}",
			salesforceProductSalesPrice = "${salesforceProductSalesPrice}",
			salesforceProductTermType = "${salesforceProductTermType}",
			salesforceProductType = "${salesforceProductType}");
	}

	macro addContactRoleViaOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.addContactRole(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "${salesforceContactName}",
			salesforceContactRole = "${salesforceContactRole}",
			salesforceContactRolePrimary = "${salesforceContactRolePrimary}");
	}

	macro addOrderFormViaOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.addOrderForm(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOrderFormContactFirstName = "${salesforceOrderFormContactFirstName}",
			salesforceOrderFormContactLastName = "${salesforceOrderFormContactLastName}",
			salesforceOrderFormContractFormat = "${salesforceOrderFormContractFormat}",
			salesforceOrderFormContractingCountry = "${salesforceOrderFormContractingCountry}",
			salesforceOrderFormDocType = "${salesforceOrderFormDocType}",
			salesforceOrderFormLanguage = "${salesforceOrderFormLanguage}",
			salesforceOrderFormValidThroughDate = "${salesforceOrderFormValidThroughDate}");
	}

	macro addProjectContactRoleViaAccount {
		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.addProjectContactRole(
			salesforceContactName = "${salesforceContactName}",
			salesforceContactRole = "${salesforceContactRole}",
			salesforceContactRolePrimary = "${salesforceContactRolePrimary}",
			salesforceCurrency = "${salesforceCurrency}",
			salesforceProjectName = "${salesforceProjectName}");
	}

	macro assignContractToOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.editItem(
			salesforceOpportunityItemLabel = "Contract",
			salesforceOpportunityItemValue = "${salesforceContractNumber}");
	}

	macro assignProjectToOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.assignProject(salesforceOpportunityProject = "${salesforceProjectName}");
	}

	macro createAndViewAccount {
		SalesforceNavigation.gotoAccounts();

		SalesforceAccounts.createAccount(
			salesforceAccountCurrency = "${salesforceAccountCurrency}",
			salesforceAccountIndustry = "${salesforceAccountIndustry}",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountPartnerLevel = "${salesforceAccountPartnerLevel}");

		SalesforceAccount.addDummyAccountAddress(salesforceAccountAddressType = "Billing");

		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.addDummyAccountAddress(salesforceAccountAddressType = "Shipping");

		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.viewAccountDetails(
			salesforceAccountCurrency = "${salesforceAccountCurrency}",
			salesforceAccountIndustry = "${salesforceAccountIndustry}",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "${salesforceAccountPartnerLevel}");
	}

	macro createAndViewContact {
		SalesforceNavigation.gotoContacts();

		SalesforceContacts.createContact(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactCurrency = "${salesforceContactCurrency}",
			salesforceContactEmail = "${salesforceContactEmail}",
			salesforceContactFirstName = "${salesforceContactFirstName}",
			salesforceContactLastName = "${salesforceContactLastName}",
			salesforceContactMailingCountry = "${salesforceContactMailingCountry}",
			salesforceContactPurchaseDecisionInvolvement = "${salesforceContactPurchaseDecisionInvolvement}",
			salesforceContactTitle = "${salesforceContactTitle}",
			salesforceContactType = "${salesforceContactType}");

		SalesforceContact.viewContactDetails(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactEmail = "${salesforceContactEmail}",
			salesforceContactFirstName = "${salesforceContactFirstName}",
			salesforceContactLastName = "${salesforceContactLastName}",
			salesforceContactMailingCountry = "${salesforceContactMailingCountry}",
			salesforceContactPurchaseDecisionInvolvement = "${salesforceContactPurchaseDecisionInvolvement}",
			salesforceContactTitle = "${salesforceContactTitle}",
			salesforceContactType = "${salesforceContactType}");
	}

	macro createAndViewContract {
		SalesforceNavigation.gotoContracts();

		SalesforceContracts.createContract(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContractFormat = "${salesforceContractFormat}",
			salesforceContractType = "${salesforceContractType}",
			salesforceLiferaySigningEntity = "${salesforceLiferaySigningEntity}");

		SalesforceContract.viewContractDetails(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContractFormat = "${salesforceContractFormat}",
			salesforceContractType = "${salesforceContractType}",
			salesforceLiferaySigningEntity = "${salesforceLiferaySigningEntity}");

		var salesforceContractNumber = SalesforceContract.getContractNumber();

		return "${salesforceContractNumber}";
	}

	macro createAndViewOpportunity {
		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.createOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceOpportunityCloseDate}",
			salesforceOpportunityCurrency = "${salesforceOpportunityCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityNewBusinessSource = "${salesforceOpportunityNewBusinessSource}",
			salesforceOpportunityNewBusinessSourceDetails = "${salesforceOpportunityNewBusinessSourceDetails}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "${salesforceOpportunityRecordType}",
			salesforceOpportunitySoldByCountry = "${salesforceOpportunitySoldByCountry}",
			salesforceOpportunityStage = "${salesforceOpportunityStage}",
			salesforceOpportunityStageDetail = "${salesforceOpportunityStageDetail}",
			salesforceOpportunityTermType = "${salesforceOpportunityTermType}",
			salesforceOpportunityType = "${salesforceOpportunityType}");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityStage}");

		SalesforceOpportunity.viewOpportunityDetails(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceOpportunityCloseDate}",
			salesforceOpportunityCurrency = "${salesforceOpportunityCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "${salesforceOpportunityRecordType}",
			salesforceOpportunitySoldByCountry = "${salesforceOpportunitySoldByCountry}",
			salesforceOpportunityStage = "${salesforceOpportunityStage}",
			salesforceOpportunityStageDetail = "${salesforceOpportunityStageDetail}",
			salesforceOpportunityType = "${salesforceOpportunityType}");
	}

	macro createAndViewPartnerOpportunity {
		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");

		SalesforceOpportunity.createPartnerOpportunity(
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforcePartnerOpportunityCurrency = "${salesforcePartnerOpportunityCurrency}",
			salesforcePartnerOpportunityPartnerEmail = "${salesforcePartnerOpportunityPartnerEmail}",
			salesforcePartnerOpportunityPartnerFirstName = "${salesforcePartnerOpportunityPartnerFirstName}",
			salesforcePartnerOpportunityPartnerLastName = "${salesforcePartnerOpportunityPartnerLastName}",
			salesforcePartnerOpportunityRecordType = "${salesforcePartnerOpportunityRecordType}",
			salesforcePartnerOpportunityType = "${salesforcePartnerOpportunityType}");

		SalesforcePartnerOpportunity.viewPartnerOpportunityDetails(
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforcePartnerOpportunityOwner = "${salesforcePartnerOpportunityOwner}",
			salesforcePartnerOpportunityPartnerEmail = "${salesforcePartnerOpportunityPartnerEmail}",
			salesforcePartnerOpportunityPartnerFirstName = "${salesforcePartnerOpportunityPartnerFirstName}",
			salesforcePartnerOpportunityPartnerLastName = "${salesforcePartnerOpportunityPartnerLastName}",
			salesforcePartnerOpportunityRecordType = "${salesforcePartnerOpportunityRecordType}",
			salesforcePartnerOpportunityType = "${salesforcePartnerOpportunityType}");
	}

	macro createAndViewProject {
		SalesforceNavigation.gotoProjects();

		SalesforceProjects.createProject(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "${salesforceProjectFirstLineSupport}",
			salesforceProjectLicenseOptionPurchased = "${salesforceProjectLicenseOptionPurchased}",
			salesforceProjectLiferayVersion = "${salesforceProjectLiferayVersion}",
			salesforceProjectMaximumNumContacts = "${salesforceProjectMaximumNumContacts}",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "${salesforceProjectPartnerLevel}",
			salesforceProjectRecordType = "${salesforceProjectRecordType}");

		SalesforceProject.viewProjectDetails(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "${salesforceProjectFirstLineSupport}",
			salesforceProjectLicenseOptionPurchased = "${salesforceProjectLicenseOptionPurchased}",
			salesforceProjectLiferayVersion = "${salesforceProjectLiferayVersion}",
			salesforceProjectMaximumNumContacts = "${salesforceProjectMaximumNumContacts}",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "${salesforceProjectPartnerLevel}",
			salesforceProjectRecordType = "${salesforceProjectRecordType}");
	}

	macro deleteAccount {
		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.deleteAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceNavigation.gotoAccounts();

		SalesforceAccounts.viewNoRecentAccount(salesforceAccountName = "${salesforceAccountName}");
	}

	macro deleteAllEntities {
		SalesforceNavigation.gotoProjects();

		SalesforceProjects.deleteAllProjects();

		SalesforceNavigation.gotoAccounts();

		SalesforceAccounts.deleteAllAccounts();

		SalesforceNavigation.gotoContacts();

		SalesforceContacts.deleteAllContacts();

		SalesforceNavigation.gotoContracts();

		SalesforceContracts.deleteAllContracts();
	}

	macro deleteProject {
		SalesforceNavigation.gotoRecentProject(salesforceProjectName = "${salesforceProjectName}");

		SalesforceButton.delete();

		SalesforceNavigation.gotoProjects();

		SalesforceProjects.viewNoRecentProject(salesforceProjectName = "${salesforceProjectName}");
	}

}