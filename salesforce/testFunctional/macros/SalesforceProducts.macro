definition {
	macro addProduct {
		if (IsElementPresent(locator1 = "SalesforceProductAdd#SELECT_PRICE_BOOK")) {
			Select(
				locator1 = "SalesforceProductAdd#SELECT_PRICE_BOOK",
				value1 = "${salesforcePriceBook}"
			);

			SalesforceButton.save();
		}

		SalesforceProducts.searchProduct(
			salesforceProductName = "${salesforceProductName}"
		);

		SalesforceProducts.selectProduct(
			salesforceProductName = "${salesforceProductName}"
		);

		if ((isSet(salesforceProductQuantity)) && (!(contains("${salesforceProductQuantity}", "{salesforceProductQuantity}")))) {
			Type(
				locator1 = "SalesforceProductAdd#PRODUCT_QUANTITY",
				value1 = "${salesforceProductQuantity}"
			);
		}
		else {
			Type(locator1 = "SalesforceProductAdd#PRODUCT_QUANTITY", value1 = "1");
		}

		if ((isSet(salesforceProductSalesPrice)) && (!(contains("${salesforceProductSalesPrice}", "{salesforceProductSalesPrice}")))) {
			Type(
				locator1 = "SalesforceProductAdd#PRODUCT_SALES_PRICE",
				value1 = "${salesforceProductSalesPrice}"
			);
		}

		Select(
			locator1 = "SalesforceProductAdd#PRODUCT_TERM_TYPE",
			value1 = "${salesforceProductTermType}"
		);

		if ((isSet(salesforceProductType)) && (!(contains("${salesforceProductType}", "{salesforceProductType}")))) {
			Select(
				locator1 = "SalesforceProductAdd#PRODUCT_PRODUCT_TYPE",
				value1 = "${salesforceProductType}"
			);
		}

		Type(
			locator1 = "SalesforceProductAdd#PRODUCT_DATE",
			value1 = "${salesforceProductDate}"
		);

		Type(
			locator1 = "SalesforceProductAdd#PRODUCT_END_DATE",
			value1 = "${salesforceProductEndDate}"
		);

		if ((isSet(salesforceProductAnnualSalesPrice)) && (!(contains("${salesforceProductAnnualSalesPrice}", "{salesforceProductAnnualSalesPrice}")))) {
			Type(
				locator1 = "SalesforceProductAdd#PRODUCT_ANNUAL_SALES_PRICE",
				value1 = "${salesforceProductAnnualSalesPrice}"
			);
		}

		SalesforceButton.save();

		SalesforceNavigation.assertNoSaveError();
	}

	macro clickFindProduct {
		Click(locator1 = "SalesforceProducts#FIND_PRODUCT_BUTTON");
	}

	macro searchProduct {
		Type(
			locator1 = "SalesforceProductAdd#SEARCH_PRODUCT_NAME_KEYWORD_FIELD",
			value1 = "${salesforceProductName}"
		);

		SalesforceButton.search();
	}

	macro selectProduct {
		var key_productName = "${salesforceProductName}";

		Check(locator1 = "SalesforceProductAdd#SELECT_PRODUCT_NAME_CHECKBOX");

		SalesforceButton.select();
	}
}