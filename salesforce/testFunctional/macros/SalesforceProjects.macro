definition {

	macro clickFirstRecentProject {
		Click(locator1 = "SalesforceProjects#FIRST_RECENT_PROJECT_NAME");
	}

	macro createProject {
		SalesforceButton.new();

		Select(
			locator1 = "SalesforceProjectCreate#PROJECT_RECORD_TYPE",
			value1 = "${salesforceProjectRecordType}");

		SalesforceButton.continue();

		Type(
			locator1 = "SalesforceProjectCreate#PROJECT_NAME",
			value1 = "${salesforceProjectName}");

		Type(
			locator1 = "SalesforceProjectCreate#PROJECT_ACCOUNT",
			value1 = "${salesforceAccountName}");

		Select(
			locator1 = "SalesforceProjectCreate#PROJECT_LIFERAY_VERSION",
			value1 = "${salesforceProjectLiferayVersion}");

		Select(
			locator1 = "SalesforceProjectCreate#PROJECT_FIRST_LINE_SUPPORT",
			value1 = "${salesforceProjectFirstLineSupport}");

		if ("${salesforceProjectRecordType}" == "OEM") {
			Select(
				locator1 = "SalesforceProjectCreate#PROJECT_LICENSE_OPTION_PURCHASED",
				value1 = "${salesforceProjectLicenseOptionPurchased}");

			Select(
				locator1 = "SalesforceProjectCreate#PROJECT_SUPPORT_SERVICES_LEVEL",
				value1 = "${salesforceProjectPartnerLevel}");

			Type(
				locator1 = "SalesforceProjectCreate#PROJECT_MAXIMUM_NUM_CONTACTS",
				value1 = "${salesforceProjectMaximumNumContacts}");
		}

		SalesforceButton.save();
	}

	macro deleteAllProjects {
		while (IsElementPresent(locator1 = "SalesforceProjects#FIRST_RECENT_PROJECT_NAME")) {
			SalesforceProjects.clickFirstRecentProject();

			SalesforceButton.delete();

			SalesforceNavigation.gotoProjects();
		}
	}

	macro viewNoRecentProject {
		var key_accountName = "${salesforceProjectName}";

		AssertElementNotPresent(
			locator1 = "SalesforceProjects#RECENT_PROJECT_NAME",
			value1 = "${salesforceProjectName}");
	}

}