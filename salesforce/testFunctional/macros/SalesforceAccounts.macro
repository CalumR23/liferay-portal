definition {

	macro clickFirstRecentAccount {
		Click(locator1 = "SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME");
	}

	macro createAccount {
		SalesforceButton.new();

		SalesforceButton.continue();

		SalesforceAccount.fillAccount(
			salesforceAccountCurrency = "${salesforceAccountCurrency}",
			salesforceAccountIndustry = "${salesforceAccountIndustry}",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountPartnerLevel = "${salesforceAccountPartnerLevel}");

		SalesforceButton.save();
	}

	macro deleteAllAccounts {
		while (IsElementPresent(locator1 = "SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME")) {
			var salesforceAccountName = SalesforceAccounts.getFirstRecentAccountName();

			SalesforceAccounts.clickFirstRecentAccount();

			SalesforceAccount.deleteAccount(salesforceAccountName = "${salesforceAccountName}");

			SalesforceNavigation.gotoAccounts();
		}
	}

	macro getFirstRecentAccountName {
		var salesforceAccountName = selenium.getText("SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME");

		return "${salesforceAccountName}";
	}

	macro viewNoRecentAccount {
		var key_accountName = "${salesforceAccountName}";

		AssertElementNotPresent(
			locator1 = "SalesforceAccounts#RECENT_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");
	}

}