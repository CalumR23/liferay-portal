definition {

	macro clickFirstRecentLead {
		Click(locator1 = "SalesforceLeads#FIRST_RECENT_LEAD_NAME");
	}

	macro convertExistingContact {
		if (IsElementPresent(locator1 = "SalesforceLeadConversionForm#ERROR_CONVERT_EXISTING_CONTACT")) {
			AssertElementPresent(locator1 = "SalesforceLeadConversionForm#ERROR_CONVERT_EXISTING_CONTACT");

			Click(locator1 = "SalesforceLeadConversionForm#EXISTING_CONTACT");

			SalesforceButton.convertToSelected();
		}
	}

	macro convertLead {
		SalesforceButton.convert();

		Select(
			locator1 = "SalesforceLeadConversionForm#ACCOUNT_NAME",
			value1 = "Attach to Existing: ${salesforceAccountName}");

		Type.sendKeys(
			locator1 = "SalesforceLeadConversionForm#TASK_SUBJECT",
			value1 = "${salesforceTaskSubject}");

		Select(
			locator1 = "SalesforceLeadConversionForm#TASK_ACTIVITY_CURRENCY",
			value1 = "${salesforceTaskActivityCurrency}");

		Select(
			locator1 = "SalesforceLeadConversionForm#STATUS",
			value1 = "${salesforceLeadStatus}");

		Select(
			locator1 = "SalesforceLeadConversionForm#PRIORITY",
			value1 = "${salesforceLeadPriority}");

		SalesforceButton.convert();

		SalesforceLeads.convertExistingContact();
	}

	macro selectView {
		Select(
			locator1 = "SalesforceLeads#LEADS_VIEW",
			value1 = "${salesforceLeadsView}");

		SalesforceButton.go();
	}

}