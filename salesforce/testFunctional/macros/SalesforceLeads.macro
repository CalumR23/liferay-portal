<definition>
	<command name="clickFirstRecentLead">
		<execute function="Click" locator1="SalesforceLeads#FIRST_RECENT_LEAD_NAME" />
	</command>

	<command name="convertExistingContact">
		<if>
			<condition function="IsElementPresent" locator1="SalesforceLeadConversionForm#ERROR_CONVERT_EXISTING_CONTACT" />
			<then>
				<execute function="AssertElementPresent" locator1="SalesforceLeadConversionForm#ERROR_CONVERT_EXISTING_CONTACT" />

				<execute function="Click" locator1="SalesforceLeadConversionForm#EXISTING_CONTACT" />

				<execute macro="SalesforceButton#convertToSelected" />
			</then>
		</if>
	</command>

	<command name="convertLead">
		<execute macro="SalesforceButton#convert" />

		<execute function="Select" locator1="SalesforceLeadConversionForm#ACCOUNT_NAME" value1="Attach to Existing: ${salesforceAccountName}" />
		<execute function="Type#sendKeys" locator1="SalesforceLeadConversionForm#TASK_SUBJECT" value1="${salesforceTaskSubject}" />
		<execute function="Select" locator1="SalesforceLeadConversionForm#TASK_ACTIVITY_CURRENCY" value1="${salesforceTaskActivityCurrency}" />

		<execute function="Select" locator1="SalesforceLeadConversionForm#STATUS" value1="${salesforceLeadStatus}" />
		<execute function="Select" locator1="SalesforceLeadConversionForm#PRIORITY" value1="${salesforceLeadPriority}" />

		<execute macro="SalesforceButton#convert" />

		<execute macro="SalesforceLeads#convertExistingContact" />
	</command>

	<command name="selectView">
		<execute function="Select" locator1="SalesforceLeads#LEADS_VIEW" value1="${salesforceLeadsView}" />

		<execute macro="SalesforceButton#go" />
	</command>
</definition>