<definition>
	<command name="assertNoSaveError">
		<execute function="AssertNotVisible" locator1="SalesforceNavigation#SAVE_ERROR" />
	</command>

	<command name="assertSaveErrorText">
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceNavigation#SAVE_ERROR" value1="${salesforceSaveError}" />
	</command>

	<command name="gotoAccounts">
		<execute function="Click" locator1="SalesforceNavigation#ACCOUNTS_TAB" />
	</command>

	<command name="gotoContacts">
		<execute function="Click" locator1="SalesforceNavigation#CONTACTS_TAB" />
	</command>

	<command name="gotoContracts">
		<var name="key_linkEntity" value="Contracts" />

		<execute function="Click" locator1="SalesforceNavigation#ALL_TABS" />
		<execute function="Click" locator1="SalesforceNavigation#GENERIC_LINK" />
	</command>

	<command name="gotoHome">
		<execute function="Click" locator1="SalesforceNavigation#HOME_TAB" />
	</command>

	<command name="gotoLeads">
		<execute function="Click" locator1="SalesforceNavigation#LEADS_TAB" />
	</command>

	<command name="gotoOpportunities">
		<execute function="Click" locator1="SalesforceNavigation#OPPORTUNITIES_TAB" />
	</command>

	<command name="gotoOpportunityWithinAccount">
		<var name="key_opportunityKeyword" value="${salesforceOpportunityKeyword}" />

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<if>
			<and>
				<condition function="IsElementNotPresent" locator1="SalesforceAccount#ACCOUNT_OPPORTUNITY_NAME" />
				<condition function="IsElementPresent" locator1="SalesforceAccount#ACCOUNT_OPPORTUNITY_SHOW_MORE" />
			</and>
			<then>
				<execute function="Click" locator1="SalesforceAccount#ACCOUNT_OPPORTUNITY_SHOW_MORE" />
			</then>
		</if>

		<execute macro="SalesforceAccount#clickOpportunity">
			<var name="salesforceOpportunityKeyword" value="${salesforceOpportunityKeyword}" />
		</execute>
	</command>

	<command name="gotoProducts">
		<execute function="Click" locator1="SalesforceNavigation#PRODUCTS_TAB" />
	</command>

	<command name="gotoProjects">
		<execute function="Click" locator1="SalesforceNavigation#PROJECTS_TAB" />
	</command>

	<command name="gotoRecentAccount">
		<var name="key_accountName" value="${salesforceAccountName}" />

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute function="AssertClick" locator1="SalesforceAccounts#RECENT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
	</command>

	<command name="gotoRecentOpportunity">
		<var name="key_opportunityName" value="${salesforceOpportunityName}" />

		<execute macro="SalesforceNavigation#gotoOpportunities" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="SalesforceOpportunities#RECENT_OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />

		<execute macro="SalesforceOpportunity#gotoDetails" />
	</command>

	<command name="gotoRecentProject">
		<var name="key_projectName" value="${salesforceProjectName}" />

		<execute macro="SalesforceNavigation#gotoProjects" />

		<execute function="AssertClick" locator1="SalesforceProjects#RECENT_PROJECT_NAME" value1="${salesforceProjectName}" />
	</command>

	<command name="openURL">
		<var method="TestPropsUtil#get('portal.sales.url')" name="salesforceUrl" />

		<execute function="Open" locator1="${salesforceUrl}" />
	</command>

	<command name="pause">
		<execute function="Pause" locator1="${pauseTime}" />
	</command>

	<command name="reloadPage">
		<execute function="KeyPress" locator1="SalesforceNavigation#ACCOUNTS_TAB" value1="\F5" />
	</command>

	<command name="searchItem">
		<var method="StringUtil#lowerCase('${searchType}')" name="key_searchType" />

		<execute function="Type" locator1="SalesforceSearch#SEARCHBAR" value1="${searchName}" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceSearch#SEARCHBAR_RESULT" />
			<then>
				<execute function="Click#makeVisibleClickAt" locator1="SalesforceSearch#SEARCHBAR_RESULT" />
			</then>
		</if>
	</command>
</definition>