definition {

	macro assertNoSaveError {
		AssertNotVisible(locator1 = "SalesforceNavigation#SAVE_ERROR");
	}

	macro assertSaveErrorText {
		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceNavigation#SAVE_ERROR",
			value1 = "${salesforceSaveError}");
	}

	macro closeHoverFrame {
		if ((IsElementPresent(locator1 = "SalesforceNavigation#HOVER_FRAME")) && (IsVisible(locator1 = "SalesforceNavigation#HOVER_FRAME"))) {
			MouseOver(locator1 = "SalesforceNavigation#HOME_TAB");

			AssertNotVisible(locator1 = "SalesforceNavigation#HOVER_FRAME");
		}
	}

	macro gotoAccounts {
		Click(locator1 = "SalesforceNavigation#ACCOUNTS_TAB");
	}

	macro gotoContacts {
		Click(locator1 = "SalesforceNavigation#CONTACTS_TAB");
	}

	macro gotoContracts {
		var key_linkEntity = "Contracts";

		Click(locator1 = "SalesforceNavigation#ALL_TABS");

		Click(locator1 = "SalesforceNavigation#GENERIC_LINK");
	}

	macro gotoHome {
		Click(locator1 = "SalesforceNavigation#HOME_TAB");
	}

	macro gotoLeads {
		Click(locator1 = "SalesforceNavigation#LEADS_TAB");
	}

	macro gotoOpportunities {
		Click(locator1 = "SalesforceNavigation#OPPORTUNITIES_TAB");
	}

	macro gotoOpportunityWithinAccount {
		var key_opportunityKeyword = "${salesforceOpportunityKeyword}";

		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		if ((IsElementNotPresent(locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_NAME")) && (IsElementPresent(locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_SHOW_MORE"))) {
			Click(locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_SHOW_MORE");
		}

		SalesforceAccount.clickOpportunity(salesforceOpportunityKeyword = "${salesforceOpportunityKeyword}");
	}

	macro gotoProducts {
		Click(locator1 = "SalesforceNavigation#PRODUCTS_TAB");
	}

	macro gotoProjects {
		Click(locator1 = "SalesforceNavigation#PROJECTS_TAB");
	}

	macro gotoRecentAccount {
		var key_accountName = "${salesforceAccountName}";

		SalesforceNavigation.gotoAccounts();

		AssertClick(
			locator1 = "SalesforceAccounts#RECENT_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");
	}

	macro gotoRecentOpportunity {
		var key_opportunityName = "${salesforceOpportunityName}";

		SalesforceNavigation.gotoOpportunities();

		AssertClick.assertPartialTextClickAt(
			locator1 = "SalesforceOpportunities#RECENT_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");

		SalesforceOpportunity.gotoDetails();
	}

	macro gotoRecentProject {
		var key_projectName = "${salesforceProjectName}";

		SalesforceNavigation.gotoProjects();

		AssertClick(
			locator1 = "SalesforceProjects#RECENT_PROJECT_NAME",
			value1 = "${salesforceProjectName}");
	}

	macro openURL {
		var salesforceUrl = PropsUtil.get("portal.sales.url");

		Open(locator1 = "${salesforceUrl}");
	}

	macro pause {
		Pause(locator1 = "${pauseTime}");
	}

	macro reloadPage {
		KeyPress(
			locator1 = "SalesforceNavigation#ACCOUNTS_TAB",
			value1 = "\F5");
	}

	macro searchItem {
		var key_searchType = StringUtil.lowerCase("${searchType}");

		Type(
			locator1 = "SalesforceSearch#SEARCHBAR",
			value1 = "${searchName}");

		if (IsElementPresent(locator1 = "SalesforceSearch#SEARCHBAR_RESULT")) {
			Click.makeVisibleClickAt(locator1 = "SalesforceSearch#SEARCHBAR_RESULT");
		}
	}

}