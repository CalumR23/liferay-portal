definition {

	macro clickFirstQuoteNumber {
		Click(locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_FIRST_QUOTE_NUMBER");
	}

	macro clickOpportunity {
		Click(locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY");

		SalesforceOpportunity.gotoDetails();
	}

	macro editStage {
		DoubleClick(locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_STAGE");

		Select(
			locator1 = "SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_STAGE",
			value1 = "${salesforcePartnerOpportunityStage}");

		Pause(locator1 = "3000");

		if (IsElementPresent(locator1 = "SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_PRIMARY_REASON_LOST")) {
			Select(
				locator1 = "SalesforcePartnerOpportunity#EDIT_PARTNER_OPPORTUNITY_PRIMARY_REASON_LOST",
				value1 = "${salesforcePartnerOpportunityPrimaryReasonLost}");
		}

		SalesforceButton.modalOK();

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_STAGE",
			value1 = "${salesforcePartnerOpportunityStage}");

		SalesforceNavigation.assertNoSaveError();
	}

	macro fillPartnerOpportunity {
		var salesforcePartnerOpportunityPartnerEmail = StringUtil.replace("${salesforcePartnerOpportunityPartnerEmail}", " ", "_");

		Type(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerFirstName} ${salesforcePartnerOpportunityPartnerLastName}");

		Type(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_FIRST_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerFirstName}");

		Type(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_LAST_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerLastName}");

		Type(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_EMAIL",
			value1 = "${salesforcePartnerOpportunityPartnerEmail}");

		Select(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_CURRENCY",
			value1 = "${salesforcePartnerOpportunityCurrency}");

		Select(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_OPPORTUNITY_TYPE",
			value1 = "${salesforcePartnerOpportunityType}");
	}

	macro syncProducts {
		Click(locator1 = "SalesforcePartnerOpportunity#SYNC_PRODUCTS_BUTTON");
	}

	macro viewPartnerOpportunityDetails {
		var salesforcePartnerOpportunityPartnerEmail = StringUtil.replace("${salesforcePartnerOpportunityPartnerEmail}", " ", "_");

		var salesforcePartnerOpportunityPartnerEmail = StringUtil.lowerCase("${salesforcePartnerOpportunityPartnerEmail}");

		AssertTextEquals(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerFirstName} ${salesforcePartnerOpportunityPartnerLastName}");

		AssertTextEquals(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_FIRST_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerFirstName}");

		AssertTextEquals(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_LAST_NAME",
			value1 = "${salesforcePartnerOpportunityPartnerLastName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_PARTNER_EMAIL",
			value1 = "${salesforcePartnerOpportunityPartnerEmail}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY",
			value1 = "${salesforceOpportunityName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OWNER",
			value1 = "${salesforcePartnerOpportunityOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_OPPORTUNITY_TYPE",
			value1 = "${salesforcePartnerOpportunityType}");
	}

}