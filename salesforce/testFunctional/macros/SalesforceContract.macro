<definition>
	<command name="fillContract">
		<execute function="Type" locator1="SalesforceContractCreate#CONTRACT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="Select" locator1="SalesforceContractCreate#CONTRACT_LIFERAY_SIGNING_ENTITY" value1="${salesforceLiferaySigningEntity}" />
		<execute function="Select" locator1="SalesforceContractCreate#CONTRACT_CONTRACT_TYPE" value1="${salesforceContractType}" />
		<execute function="Select" locator1="SalesforceContractCreate#CONTRACT_CONTRACT_FORMAT" value1="${salesforceContractFormat}" />
	</command>

	<command name="getContractNumber">
		<var method="selenium#getText(SalesforceContract#CONTRACT_DETAILS_CONTRACT_NUMBER)" name="salesforceContractNumber" />

		<return value="${salesforceContractNumber}" />
	</command>

	<command name="viewContractDetails">
		<execute function="AssertTextEquals" locator1="SalesforceContract#CONTRACT_DETAILS_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceContract#CONTRACT_DETAILS_LIFERAY_SIGNING_ENTITY" value1="${salesforceLiferaySigningEntity}" />
		<execute function="AssertTextEquals" locator1="SalesforceContract#CONTRACT_DETAILS_CONTRACT_TYPE" value1="${salesforceContractType}" />
		<execute function="AssertTextEquals" locator1="SalesforceContract#CONTRACT_DETAILS_CONTRACT_FORMAT" value1="${salesforceContractFormat}" />
	</command>
</definition>