definition {

	macro fillContract {
		Type(
			locator1 = "SalesforceContractCreate#CONTRACT_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		Select(
			locator1 = "SalesforceContractCreate#CONTRACT_LIFERAY_SIGNING_ENTITY",
			value1 = "${salesforceLiferaySigningEntity}");

		Select(
			locator1 = "SalesforceContractCreate#CONTRACT_CONTRACT_TYPE",
			value1 = "${salesforceContractType}");

		Select(
			locator1 = "SalesforceContractCreate#CONTRACT_CONTRACT_FORMAT",
			value1 = "${salesforceContractFormat}");
	}

	macro getContractNumber {
		var salesforceContractNumber = selenium.getText("SalesforceContract#CONTRACT_DETAILS_CONTRACT_NUMBER");

		return "${salesforceContractNumber}";
	}

	macro viewContractDetails {
		AssertTextEquals(
			locator1 = "SalesforceContract#CONTRACT_DETAILS_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceContract#CONTRACT_DETAILS_LIFERAY_SIGNING_ENTITY",
			value1 = "${salesforceLiferaySigningEntity}");

		AssertTextEquals(
			locator1 = "SalesforceContract#CONTRACT_DETAILS_CONTRACT_TYPE",
			value1 = "${salesforceContractType}");

		AssertTextEquals(
			locator1 = "SalesforceContract#CONTRACT_DETAILS_CONTRACT_FORMAT",
			value1 = "${salesforceContractFormat}");
	}

}