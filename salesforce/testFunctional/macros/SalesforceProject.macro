definition {

	macro viewProjectDetails {
		AssertTextEquals(
			locator1 = "SalesforceProject#PROJECT_DETAILS_NAME",
			value1 = "${salesforceProjectName}");

		AssertTextEquals(
			locator1 = "SalesforceProject#PROJECT_DETAILS_ACCOUNT",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceProject#PROJECT_DETAILS_LIFERAY_VERSION",
			value1 = "${salesforceProjectLiferayVersion}");

		AssertTextEquals(
			locator1 = "SalesforceProject#PROJECT_DETAILS_FIRST_LINE_SUPPORT",
			value1 = "${salesforceProjectFirstLineSupport}");

		if ("${salesforceProjectRecordType}" == "OEM") {
			AssertTextEquals(
				locator1 = "SalesforceProject#PROJECT_DETAILS_LICENSE_OPTION_PURCHASED",
				value1 = "${salesforceProjectLicenseOptionPurchased}");

			AssertTextEquals(
				locator1 = "SalesforceProject#PROJECT_DETAILS_SUPPORT_SERVICES_LEVEL",
				value1 = "${salesforceProjectPartnerLevel}");

			AssertTextEquals(
				locator1 = "SalesforceProject#PROJECT_DETAILS_MAXIMUM_NUM_CONTACTS",
				value1 = "${salesforceProjectMaximumNumContacts}");
		}
	}

}