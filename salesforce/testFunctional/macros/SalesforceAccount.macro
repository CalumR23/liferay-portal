definition {

	macro addAccountAddress {
		Click(locator1 = "SalesforceAccount#NEW_ADDRESS_BUTTON");

		Type(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_ALIAS",
			value1 = "${salesforceAccountAddressAlias}");

		Select(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_TYPE",
			value1 = "${salesforceAccountAddressType}");

		Type(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_STREET",
			value1 = "${salesforceAccountAddressStreet}");

		Type(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_CITY",
			value1 = "${salesforceAccountAddressCity}");

		Select(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_COUNTRY",
			value1 = "${salesforceAccountAddressCountry}");

		Select(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_STATE",
			value1 = "${salesforceAccountAddressState}");

		Type(
			locator1 = "SalesforceAccountAddressAdd#ACCOUNT_ADDRESS_ZIP",
			value1 = "${salesforceAccountAddressZip}");

		SalesforceButton.save();
	}

	macro addDummyAccountAddress {
		SalesforceAccount.addAccountAddress(
			salesforceAccountAddressAlias = "${salesforceAccountAddressType} Address",
			salesforceAccountAddressCity = "Diamond Bar",
			salesforceAccountAddressCountry = "United States",
			salesforceAccountAddressState = "California",
			salesforceAccountAddressStreet = "1400 Montefino Ave.",
			salesforceAccountAddressType = "Primary ${salesforceAccountAddressType} Address",
			salesforceAccountAddressZip = "91765");
	}

	macro addProjectContactRole {
		Click(locator1 = "SalesforceAccount#NEW_PROJECT_CONTACT_ROLE");

		Type(
			locator1 = "SalesforceProjectContactRole#PROJECT_CONTACT_ROLE_PROJECT",
			value1 = "${salesforceProjectName}");

		Type(
			locator1 = "SalesforceProjectContactRole#PROJECT_CONTACT_ROLE_CONTACT",
			value1 = "${salesforceContactName}");

		Select(
			locator1 = "SalesforceProjectContactRole#PROJECT_CONTACT_ROLE_CONTACT_ROLE",
			value1 = "${salesforceContactRole}");

		Select(
			locator1 = "SalesforceProjectContactRole#PROJECT_CONTACT_ROLE_CURRENCY",
			value1 = "${salesforceCurrency}");

		if ("${salesforceContactRolePrimary}" == "true") {
			Click(locator1 = "SalesforceProjectContactRole#PROJECT_CONTACT_ROLE_PRIMARY");
		}

		SalesforceButton.save();
	}

	macro clickOpportunity {
		var key_opportunityKeyword = "${salesforceOpportunityKeyword}";

		Click(locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_NAME");

		SalesforceOpportunity.gotoDetails();
	}

	macro createOpportunity {
		Click(locator1 = "SalesforceAccount#NEW_OPPORTUNITY_BUTTON");

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_RECORD_TYPE",
			value1 = "${salesforceOpportunityRecordType}");

		SalesforceButton.continue();

		SalesforceOpportunity.fillOpportunity(
			salesforceOpportunityCloseDate = "${salesforceOpportunityCloseDate}",
			salesforceOpportunityCurrency = "${salesforceOpportunityCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityNewBusinessSource = "${salesforceOpportunityNewBusinessSource}",
			salesforceOpportunityNewBusinessSourceDetails = "${salesforceOpportunityNewBusinessSourceDetails}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunitySoldByCountry = "${salesforceOpportunitySoldByCountry}",
			salesforceOpportunityStage = "${salesforceOpportunityStage}",
			salesforceOpportunityStageDetail = "${salesforceOpportunityStageDetail}",
			salesforceOpportunityTermType = "${salesforceOpportunityTermType}",
			salesforceOpportunityType = "${salesforceOpportunityType}");

		SalesforceButton.saveAndAddProduct();

		SalesforceNavigation.assertNoSaveError();
	}

	macro deleteAccount {
		SalesforceButton.delete();

		while ((IsElementPresent(locator1 = "SalesforceAccountDeleteConflicts#ERROR_DESCRIPTION")) && (IsElementPresent(locator1 = "SalesforceAccountDeleteConflicts#FIRST_CONFLICT_NAME"))) {
			Click(locator1 = "SalesforceAccountDeleteConflicts#FIRST_CONFLICT_NAME");

			if (IsElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_TITLE")) {
				Click(locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_OPPORTUNITY_NAME");

				SalesforceOpportunity.gotoDetails();

				SalesforceOpportunity.deleteOpportunity();
			}
			else if (IsElementPresent(locator1 = "SalesforcePartnerOpportunity#PARTNER_OPPORTUNITY_DETAILS_TITLE")) {
				SalesforceButton.delete();
			}
			else if (IsElementPresent(locator1 = "SalesforceProject#PROJECT_DETAILS_TITLE")) {
				SalesforceButton.delete();
			}
			else {
				SalesforceOpportunity.gotoDetails();

				SalesforceOpportunity.deleteOpportunity();
			}

			SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

			SalesforceButton.delete();
		}
	}

	macro editAccountDetails {
		SalesforceButton.edit();

		Type(
			locator1 = "SalesforceAccountCreate#ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		Select(
			locator1 = "SalesforceAccountCreate#ACCOUNT_INDUSTRY",
			value1 = "${salesforceAccountIndustry}");

		Type(
			locator1 = "SalesforceAccountCreate#ACCOUNT_DESCRIPTION",
			value1 = "${salesforceAccountDescription}");

		SalesforceButton.save();

		Pause(locator1 = "3000");
	}

	macro fillAccount {
		Type(
			locator1 = "SalesforceAccountCreate#ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		Select(
			locator1 = "SalesforceAccountCreate#ACCOUNT_CURRENCY",
			value1 = "${salesforceAccountCurrency}");

		Select(
			locator1 = "SalesforceAccountCreate#ACCOUNT_INDUSTRY",
			value1 = "${salesforceAccountIndustry}");

		if (isSet(salesforceAccountPartnerLevel) && isSet(salesforceAccountPartnerLevel)) {
			Select(
				locator1 = "SalesforceAccountCreate#ACCOUNT_PARTNER_LEVEL",
				value1 = "${salesforceAccountPartnerLevel}");
		}
	}

	macro viewAccountDetails {
		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceAccount#ACCOUNT_DETAILS_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceAccount#ACCOUNT_DETAILS_OWNER",
			value1 = "${salesforceAccountOwner}");

		if (isSet(salesforceAccountIndustry) && isSet(salesforceAccountIndustry)) {
			AssertTextEquals(
				locator1 = "SalesforceAccount#ACCOUNT_DETAILS_INDUSTRY",
				value1 = "${salesforceAccountIndustry}");
		}

		if (isSet(salesforceAccountDescription) && isSet(salesforceAccountDescription)) {
			AssertTextEquals(
				locator1 = "SalesforceAccount#ACCOUNT_DETAILS_DESCRIPTION",
				value1 = "${salesforceAccountDescription}");
		}

		if (isSet(salesforceAccountPartnerLevel) && isSet(salesforceAccountPartnerLevel)) {
			AssertTextEquals(
				locator1 = "SalesforceAccount#ACCOUNT_DETAILS_PARTNER_LEVEL",
				value1 = "${salesforceAccountPartnerLevel}");
		}
	}

	macro viewNoOpportunity {
		var key_opportunityKeyword = "${salesforceOpportunityKeyword}";

		AssertElementNotPresent(locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_NAME");
	}

	macro viewOpportunityName {
		var key_opportunityKeyword = "${salesforceOpportunityKeyword}";

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceAccount#ACCOUNT_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");
	}

	macro viewPartnershipDetails {
		if (isSet(salesforceAccountServicePartnershipTerm) && isSet(salesforceAccountServicePartnershipTerm)) {
			AssertElementPresent(locator1 = "SalesforceAccount#ACCOUNT_DETAILS_ACTIVE_SERVICE_PARTNER_CHECKED");

			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceAccount#ACCOUNT_DETAILS_ACCT_SVC_PARTNERSHIP_TERM",
				value1 = "${salesforceAccountServicePartnershipTerm}");
		}

		if (isSet(salesforceAccountTrainingPartnershipTerm) && isSet(salesforceAccountTrainingPartnershipTerm)) {
			AssertElementPresent(locator1 = "SalesforceAccount#ACCOUNT_DETAILS_ACTIVE_TRAINING_PARTNER_CHECKED");

			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceAccount#ACCOUNT_DETAILS_ACCT_TRG_PARTNERSHIP_TERM",
				value1 = "${salesforceAccountTrainingPartnershipTerm}");
		}
	}

}