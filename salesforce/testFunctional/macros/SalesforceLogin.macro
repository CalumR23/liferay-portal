definition {

	macro loginUser {
		if (isSet(roleName) && isSet(roleName)) {
			var roleName = StringUtil.lowerCase("${roleName}");
		}
		else {
			var roleName = "qa";
		}

		var userEmailAddress = PropsUtil.get("salesforce.email.address.${roleName}");
		var userPassword = PropsUtil.get("salesforce.email.password.${roleName}");

		SalesforceNavigation.openURL();

		Type(
			locator1 = "SalesforceLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "SalesforceLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "SalesforceLogin#LOGIN_BUTTON");
	}

	macro logoutUser {
		SalesforceNavigation.openURL();

		if (IsElementPresent(locator1 = "SalesforceNavigation#USER_PROFILE_DROPDOWN_LINK")) {
			Click(locator1 = "SalesforceNavigation#USER_PROFILE_DROPDOWN_LINK");

			Click(locator1 = "SalesforceNavigation#USER_LOGOUT_LINK");
		}
	}

}