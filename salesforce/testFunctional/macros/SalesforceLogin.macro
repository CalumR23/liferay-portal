<definition>
	<command name="loginUser">
		<if>
			<and>
				<isset var="roleName" />
				<not>
					<contains string="${roleName}" substring="{roleName}" />
				</not>
			</and>
			<then>
				<var method="StringUtil#lowerCase('${roleName}')" name="roleName" />
			</then>
			<else>
				<var name="roleName" value="qa" />
			</else>
		</if>

		<var method="TestPropsUtil#get('salesforce.email.address.${roleName}')" name="userEmailAddress" />
		<var method="TestPropsUtil#get('salesforce.email.password.${roleName}')" name="userPassword" />

		<execute macro="SalesforceNavigation#openURL" />

		<execute function="Type" locator1="SalesforceLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="SalesforceLogin#PASSWORD_FIELD" value1="${userPassword}" />

		<execute function="Click" locator1="SalesforceLogin#LOGIN_BUTTON" />
	</command>

	<command name="logoutUser">
		<execute macro="SalesforceNavigation#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceNavigation#USER_PROFILE_DROPDOWN_LINK" />
			<then>
				<execute function="Click" locator1="SalesforceNavigation#USER_PROFILE_DROPDOWN_LINK" />
				<execute function="Click" locator1="SalesforceNavigation#USER_LOGOUT_LINK" />
			</then>
		</if>
	</command>
</definition>