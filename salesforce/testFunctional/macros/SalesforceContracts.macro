<definition>
	<command name="clickFirstRecentContract">
		<execute function="Click" locator1="SalesforceContracts#FIRST_RECENT_CONTRACT_NUMBER" />
	</command>

	<command name="createContract">
		<execute macro="SalesforceButton#new" />

		<execute macro="SalesforceContract#fillContract">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContractFormat" value="${salesforceContractFormat}" />
			<var name="salesforceContractType" value="${salesforceContractType}" />
			<var name="salesforceLiferaySigningEntity" value="${salesforceLiferaySigningEntity}" />
		</execute>

		<execute macro="SalesforceButton#save" />
	</command>

	<command name="deleteAllContracts">
		<while>
			<condition function="IsElementPresent" locator1="SalesforceContracts#FIRST_RECENT_CONTRACT_NUMBER" />
			<then>
				<execute macro="SalesforceContracts#clickFirstRecentContract" />

				<execute macro="SalesforceButton#delete" />

				<execute macro="SalesforceNavigation#gotoContracts" />
			</then>
		</while>
	</command>

	<command name="getContractNumber">
		<var name="key_contractKeyword" value="${salesforceContractKeyword}" />

		<var method="selenium#getText(SalesforceContracts#RECENT_CONTRACT_NUMBER)" name="salesforceContractNumber" />

		<return value="${salesforceContractNumber}" />
	</command>
</definition>