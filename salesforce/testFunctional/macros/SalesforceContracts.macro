definition {

	macro clickFirstRecentContract {
		Click(locator1 = "SalesforceContracts#FIRST_RECENT_CONTRACT_NUMBER");
	}

	macro createContract {
		SalesforceButton.new();

		SalesforceContract.fillContract(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContractFormat = "${salesforceContractFormat}",
			salesforceContractType = "${salesforceContractType}",
			salesforceLiferaySigningEntity = "${salesforceLiferaySigningEntity}");

		SalesforceButton.save();
	}

	macro deleteAllContracts {
		while (IsElementPresent(locator1 = "SalesforceContracts#FIRST_RECENT_CONTRACT_NUMBER")) {
			SalesforceContracts.clickFirstRecentContract();

			SalesforceButton.delete();

			SalesforceNavigation.gotoContracts();
		}
	}

	macro getContractNumber {
		var key_contractKeyword = "${salesforceContractKeyword}";
		var salesforceContractNumber = selenium.getText("SalesforceContracts#RECENT_CONTRACT_NUMBER");

		return "${salesforceContractNumber}";
	}

}