definition {

	macro addAdditionalOpportunity {
		var key_additionalOpportunityPositionValue = "1";

		if (IsElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK")) {
			var key_additionalOpportunityPositionValue = "2";

			if (IsElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK")) {
				var key_additionalOpportunityPositionValue = "3";
			}
		}

		SalesforceButton.edit();

		Type(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY",
			value1 = "${salesforceOpportunityName}");

		SalesforceButton.save();

		AssertElementNotPresent(locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK",
			value1 = "${salesforceOpportunityName}");
	}

	macro addAdditionalOpportunityWithError {
		var key_additionalOpportunityPositionValue = "1";

		if (IsElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK")) {
			var key_additionalOpportunityPositionValue = "2";

			if (IsElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK")) {
				var key_additionalOpportunityPositionValue = "3";
			}
		}

		SalesforceButton.edit();

		Type(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY",
			value1 = "${salesforceOpportunityName}");

		SalesforceButton.save();

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR",
			value1 = "${salesforceOrderFormSaveError}");
	}

	macro checkOrderFormDetail {
		var key_orderFormDetail = "${salesforceOrderFormDetail}";

		Check(locator1 = "SalesforceOrderFormAdd#ORDER_FORM_CHECKBOX");
	}

	macro clickFirstQuoteNumber {
		Click(locator1 = "SalesforceOrderForm#ORDER_FORM_FIRST_QUOTE_NUMBER");
	}

	macro clickOrderFormAttachment {
		if (IsElementNotPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ATTACHMENT_TITLE")) {
			SalesforceNavigation.reloadPage();
		}

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_ATTACHMENT_TITLE",
			value1 = "${salesforceOpportunityName}");

		Click(locator1 = "SalesforceOrderForm#ORDER_FORM_ATTACHMENT_VIEW");

		SelectWindow.selectPopUp(locator1 = "title=servlet.FileDownload");
	}

	macro closeOrderFormAttachment {
		Close.closeWindow(locator1 = "title=servlet.FileDownload");
	}

	macro deleteAdditionalOpportunity {
		var key_opportunityName = "${salesforceOpportunityName}";

		SalesforceButton.edit();

		Type(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_NAME",
			value1 = "");

		SalesforceButton.save();

		AssertElementNotPresent(locator1 = "SalesforceOrderFormAdd#ORDER_FORM_ADDITIONAL_OPPORTUNITY_SAVE_ERROR");

		AssertElementNotPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_ADDITIONAL_OPPORTUNITY_LINK");
	}

	macro deleteOrderFormAttachment {
		Click(locator1 = "SalesforceOrderForm#ORDER_FORM_ATTACHMENT_DELETE");
	}

	macro editItem {
		var key_itemLabel = "${salesforceOrderFormItemLabel}";

		DoubleClick(locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_ITEM");

		if (IsElementPresent(locator1 = "SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_SELECT")) {
			Select(
				locator1 = "SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_SELECT",
				value1 = "${salesforceOrderFormItemValue}");
		}
		else {
			Type(
				locator1 = "SalesforceOrderForm#EDIT_ORDER_FORM_DETAILS_ITEM",
				value1 = "${salesforceOrderFormItemValue}");
		}

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_ITEM",
			value1 = "${salesforceOrderFormItemValue}");

		SalesforceNavigation.assertNoSaveError();
	}

	macro fillOrderForm {
		Select(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_DOC_TYPE",
			value1 = "${salesforceOrderFormDocType}");

		Type(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_CONTACT",
			value1 = "${salesforceOrderFormContactFirstName} ${salesforceOrderFormContactLastName}");

		Select(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_CONTRACTING_COUNTRY",
			value1 = "${salesforceOrderFormContractingCountry}");

		Select(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_LANGUAGE",
			value1 = "${salesforceOrderFormLanguage}");

		Select(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_CONTRACT_FORMAT",
			value1 = "${salesforceOrderFormContractFormat}");

		Type(
			locator1 = "SalesforceOrderFormAdd#ORDER_FORM_VALID_THROUGH_DATE",
			value1 = "${salesforceOrderFormValidThroughDate}");
	}

	macro gotoDetails {
		Click(locator1 = "SalesforceOrderForm#DETAILS_TAB");
	}

	macro gotoFeed {
		Click(locator1 = "SalesforceOrderForm#FEED_TAB");
	}

	macro regeneratePDF {
		Click(locator1 = "SalesforceOrderForm#REGENERATE_PDF_BUTTON");

		Pause(locator1 = "10000");
	}

	macro viewNoProductLineItem {
		var key_productKeyword = "${salesforceProductKeyword}";

		AssertElementNotPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_NAME");
	}

	macro viewNoQuote {
		var key_quoteKeyword = "${salesforceQuoteKeyword}";

		AssertElementNotPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_QUOTE_OPPORTUNITY_NAME");
	}

	macro viewOrderFormAttachmentDetail {
		var key_orderFormAttachmentDetail = "${salesforceOrderFormAttachmentDetail}";

		AssertElementPresent(locator1 = "SalesforceOrderFormAttachment#ORDER_FORM_ATTACHMENT_VALUE");
	}

	macro viewOrderFormDetails {
		SalesforceOrderForm.gotoDetails();

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_DOC_TYPE",
			value1 = "${salesforceOrderFormDocType}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_CONTACT",
			value1 = "${salesforceOrderFormContactFirstName} ${salesforceOrderFormContactLastName}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_CONTRACTING_COUNTRY",
			value1 = "${salesforceOrderFormContractingCountry}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_LANGUAGE",
			value1 = "${salesforceOrderFormLanguage}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_CONTRACT_FORMAT",
			value1 = "${salesforceOrderFormContractFormat}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_DETAILS_VALID_THROUGH_DATE",
			value1 = "${salesforceOrderFormValidThroughDate}");
	}

	macro viewProductLineItem {
		var key_productCombined = "${salesforceProductCombined}";
		var key_productKeyword = "${salesforceProductKeyword}";

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_NAME",
			value1 = "${salesforceProductName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_QUANTITY",
			value1 = "${salesforceProductQuantity}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_TERM",
			value1 = "${salesforceProductTerm}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_SALES_PRICE",
			value1 = "${salesforceProductSalesPrice}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_TOTAL_PRICE",
			value1 = "${salesforceProductTotalPrice}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_TYPE",
			value1 = "${salesforceProductType}");

		AssertElementPresent(locator1 = "SalesforceOrderForm#ORDER_FORM_PRODUCT_COMBINED");
	}

	macro viewQuote {
		var key_quoteKeyword = "${salesforceQuoteKeyword}";

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_QUOTE_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");

		AssertTextEquals(
			locator1 = "SalesforceOrderForm#ORDER_FORM_QUOTE_TOTAL_PRICE",
			value1 = "${salesforceQuoteTotalPrice}");
	}

	macro viewSubsequentOrderFormAttachmentDetails {
		var orderFormDetailLocator = "//div[@class='textLayer']//div[contains(.,'${salesforceOrderFormAttachmentDetailFirst}')]";

		for (var salesforceOrderFormAttachmentDetail : list "${salesforceOrderFormAttachmentDetailsList}") {
			var salesforceOrderFormAttachmentDetail = StringUtil.replace("${salesforceOrderFormAttachmentDetail}", ";", ",");

			var orderFormDetailLocator = StringUtil.add("${orderFormDetailLocator}", "//following-sibling::div[contains(.,\"${salesforceOrderFormAttachmentDetail}\")]", "");

			echo("Salesforce Order Form Attachment: ${salesforceOrderFormAttachmentDetail}");
		}

		AssertElementPresent(locator1 = "${orderFormDetailLocator}");
	}

}