definition {

	macro addFromList {
		Click(locator1 = "SalesforceButton#ADD_FROM_LIST_BUTTON");
	}

	macro cancel {
		Click(locator1 = "SalesforceButton#CANCEL_BUTTON");
	}

	macro continue {
		Click(locator1 = "SalesforceButton#CONTINUE_BUTTON");
	}

	macro convert {
		Click(locator1 = "SalesforceButton#CONVERT_BUTTON");
	}

	macro convertToSelected {
		Click(locator1 = "SalesforceButton#CONVERT_TO_SELECTED_BUTTON");
	}

	macro delete {
		Pause(locator1 = "10000");

		SalesforceNavigation.closeHoverFrame();

		Pause(locator1 = "5000");

		ClickNoError(locator1 = "SalesforceButton#DELETE_BUTTON");

		Confirm(value1 = "Are you sure?");

		Pause(locator1 = "3000");
	}

	macro edit {
		MouseOver(locator1 = "SalesforceNavigation#HOME_TAB");

		Click(locator1 = "SalesforceButton#EDIT_BUTTON");
	}

	macro go {
		Click(locator1 = "SalesforceButton#GO_BUTTON");
	}

	macro modalCancel {
		Click(locator1 = "SalesforceButton#MODAL_CANCEL_BUTTON");
	}

	macro modalOK {
		Click(locator1 = "SalesforceButton#MODAL_OK_BUTTON");
	}

	macro new {
		Click(locator1 = "SalesforceButton#NEW_BUTTON");
	}

	macro save {
		Click(locator1 = "SalesforceButton#SAVE_BUTTON");
	}

	macro saveAndAddProduct {
		Click(locator1 = "SalesforceButton#SAVE_AND_ADD_PRODUCT_BUTTON");
	}

	macro saveAndNew {
		Click(locator1 = "SalesforceButton#SAVE_AND_NEW_BUTTON");
	}

	macro saveNoError {
		ClickNoError(locator1 = "SalesforceButton#SAVE_BUTTON");
	}

	macro search {
		Click(locator1 = "SalesforceButton#SEARCH_BUTTON");
	}

	macro select {
		Click(locator1 = "SalesforceButton#SELECT_BUTTON");
	}

}