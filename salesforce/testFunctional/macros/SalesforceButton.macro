<definition>
	<command name="addFromList">
		<execute function="Click" locator1="SalesforceButton#ADD_FROM_LIST_BUTTON" />
	</command>

	<command name="cancel">
		<execute function="Click" locator1="SalesforceButton#CANCEL_BUTTON" />
	</command>

	<command name="continue">
		<execute function="Click" locator1="SalesforceButton#CONTINUE_BUTTON" />
	</command>

	<command name="convert">
		<execute function="Click" locator1="SalesforceButton#CONVERT_BUTTON" />
	</command>

	<command name="convertToSelected">
		<execute function="Click" locator1="SalesforceButton#CONVERT_TO_SELECTED_BUTTON" />
	</command>

	<command name="delete">
		<execute function="MouseOver" locator1="SalesforceNavigation#HOME_TAB" />

		<execute function="ClickNoError" locator1="SalesforceButton#DELETE_BUTTON" />

		<execute function="Confirm" value1="Are you sure?" />

		<execute function="Pause" locator1="3000" />
	</command>

	<command name="edit">
		<execute function="MouseOver" locator1="SalesforceNavigation#HOME_TAB" />

		<execute function="Click" locator1="SalesforceButton#EDIT_BUTTON" />
	</command>

	<command name="go">
		<execute function="Click" locator1="SalesforceButton#GO_BUTTON" />
	</command>

	<command name="modalCancel">
		<execute function="Click" locator1="SalesforceButton#MODAL_CANCEL_BUTTON" />
	</command>

	<command name="modalOK">
		<execute function="Click" locator1="SalesforceButton#MODAL_OK_BUTTON" />
	</command>

	<command name="new">
		<execute function="Click" locator1="SalesforceButton#NEW_BUTTON" />
	</command>

	<command name="save">
		<execute function="Click" locator1="SalesforceButton#SAVE_BUTTON" />
	</command>

	<command name="saveAndAddProduct">
		<execute function="Click" locator1="SalesforceButton#SAVE_AND_ADD_PRODUCT_BUTTON" />
	</command>

	<command name="saveAndNew">
		<execute function="Click" locator1="SalesforceButton#SAVE_AND_NEW_BUTTON" />
	</command>

	<command name="saveNoError">
		<execute function="ClickNoError" locator1="SalesforceButton#SAVE_BUTTON" />
	</command>

	<command name="search">
		<execute function="Click" locator1="SalesforceButton#SEARCH_BUTTON" />
	</command>

	<command name="select">
		<execute function="Click" locator1="SalesforceButton#SELECT_BUTTON" />
	</command>
</definition>