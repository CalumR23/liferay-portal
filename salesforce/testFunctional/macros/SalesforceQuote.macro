definition {

	macro addProductLineItem {
		Click(locator1 = "SalesforceQuote#QUOTE_ADD_LINE_ITEM_BUTTON");

		SalesforceProducts.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductAnnualSalesPrice = "${salesforceProductAnnualSalesPrice}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "${salesforceProductName}",
			salesforceProductQuantity = "${salesforceProductQuantity}",
			salesforceProductSalesPrice = "${salesforceProductSalesPrice}",
			salesforceProductTermType = "${salesforceProductTermType}",
			salesforceProductType = "${salesforceProductType}");
	}

	macro clickPartnerOpportunity {
		Click(locator1 = "SalesforceQuote#QUOTE_PARTNER_OPPORTUNITY_ID");
	}

	macro viewProductLineItem {
		var key_productKeyword = "${salesforceProductKeyword}";

		AssertTextEquals(
			locator1 = "SalesforceQuote#QUOTE_PRODUCT_NAME",
			value1 = "${salesforceProductName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceQuote#QUOTE_PRODUCT_TERM",
			value1 = "${salesforceProductTerm}");

		AssertTextEquals(
			locator1 = "SalesforceQuote#QUOTE_PRODUCT_DATE",
			value1 = "${salesforceProductDate}");

		AssertTextEquals(
			locator1 = "SalesforceQuote#QUOTE_PRODUCT_END_DATE",
			value1 = "${salesforceProductEndDate}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceQuote#QUOTE_PRODUCT_TOTAL_PRICE",
			value1 = "${salesforceProductTotalPrice}");
	}

}