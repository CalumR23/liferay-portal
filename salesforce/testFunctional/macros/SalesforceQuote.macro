<definition>
	<command name="addProductLineItem">
		<execute function="Click" locator1="SalesforceQuote#QUOTE_ADD_LINE_ITEM_BUTTON" />

		<execute macro="SalesforceProducts#addProduct">
			<var name="salesforcePriceBook" value="${salesforcePriceBook}" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="${salesforceProductQuantity}" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="${salesforceProductTermType}" />
			<var name="salesforceProductType" value="${salesforceProductType}" />
		</execute>
	</command>

	<command name="clickPartnerOpportunity">
		<execute function="Click" locator1="SalesforceQuote#QUOTE_PARTNER_OPPORTUNITY_ID" />
	</command>

	<command name="viewProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<execute function="AssertTextEquals" locator1="SalesforceQuote#QUOTE_PRODUCT_NAME" value1="${salesforceProductName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceQuote#QUOTE_PRODUCT_TERM" value1="${salesforceProductTerm}" />
		<execute function="AssertTextEquals" locator1="SalesforceQuote#QUOTE_PRODUCT_DATE" value1="${salesforceProductDate}" />
		<execute function="AssertTextEquals" locator1="SalesforceQuote#QUOTE_PRODUCT_END_DATE" value1="${salesforceProductEndDate}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceQuote#QUOTE_PRODUCT_TOTAL_PRICE" value1="${salesforceProductTotalPrice}" />
	</command>
</definition>