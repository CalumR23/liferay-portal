<definition>
	<command name="addContactRole">
		<execute function="Click" locator1="SalesforceOpportunity#NEW_CONTACT_ROLE_BUTTON" />

		<execute macro="SalesforceContact#addContactRole">
			<var name="salesforceContactName" value="${salesforceContactName}" />
			<var name="salesforceContactRole" value="${salesforceContactRole}" />
			<var name="salesforceContactRolePrimary" value="${salesforceContactRolePrimary}" />
		</execute>

		<execute macro="SalesforceOpportunity#viewContactRole">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContactName" value="${salesforceContactName}" />
			<var name="salesforceContactRole" value="${salesforceContactRole}" />
			<var name="salesforceContactRolePrimary" value="${salesforceContactRolePrimary}" />
		</execute>
	</command>

	<command name="addOrderForm">
		<execute function="Click" locator1="SalesforceOpportunity#ADD_ORDER_FORM_BUTTON" />

		<execute macro="SalesforceOrderForm#fillOrderForm">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOrderFormContactFirstName" value="${salesforceOrderFormContactFirstName}" />
			<var name="salesforceOrderFormContactLastName" value="${salesforceOrderFormContactLastName}" />
			<var name="salesforceOrderFormContractFormat" value="${salesforceOrderFormContractFormat}" />
			<var name="salesforceOrderFormContractingCountry" value="${salesforceOrderFormContractingCountry}" />
			<var name="salesforceOrderFormDocType" value="${salesforceOrderFormDocType}" />
			<var name="salesforceOrderFormLanguage" value="${salesforceOrderFormLanguage}" />
			<var name="salesforceOrderFormValidThroughDate" value="${salesforceOrderFormValidThroughDate}" />
		</execute>

		<execute macro="SalesforceButton#save" />

		<execute macro="SalesforceOrderForm#viewOrderFormDetails">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOrderFormContactFirstName" value="${salesforceOrderFormContactFirstName}" />
			<var name="salesforceOrderFormContactLastName" value="${salesforceOrderFormContactLastName}" />
			<var name="salesforceOrderFormContractFormat" value="${salesforceOrderFormContractFormat}" />
			<var name="salesforceOrderFormContractingCountry" value="${salesforceOrderFormContractingCountry}" />
			<var name="salesforceOrderFormDocType" value="${salesforceOrderFormDocType}" />
			<var name="salesforceOrderFormLanguage" value="${salesforceOrderFormLanguage}" />
			<var name="salesforceOrderFormValidThroughDate" value="${salesforceOrderFormValidThroughDate}" />
		</execute>

		<execute macro="SalesforceNavigation#pause">
			<var name="pauseTime" value="30000" />
		</execute>
	</command>

	<command name="addProduct">
		<execute function="Click" locator1="SalesforceOpportunity#ADD_PRODUCT_BUTTON" />

		<execute macro="SalesforceProducts#addProduct">
			<var name="salesforcePriceBook" value="${salesforcePriceBook}" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="${salesforceProductQuantity}" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="${salesforceProductTermType}" />
			<var name="salesforceProductType" value="${salesforceProductType}" />
		</execute>
	</command>

	<command name="assignPartner">
		<var name="key_opportunityPartner" value="${salesforceOpportunityPartner}" />

		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP" />

		<execute function="SelectWindow" locator1="title=Search ~ Salesforce - Enterprise Edition" />

		<execute function="SelectFrame" locator1="name=resultsFrame" />

		<execute function="AssertClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP_ACCOUNT" value1="${salesforceOpportunityPartner}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI" value1="${salesforceOpportunityPartner}" />
	</command>

	<command name="assignProject">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT" />

		<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_PROJECT" value1="${salesforceOpportunityProject}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT" value1="${salesforceOpportunityProject}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME" value1="${salesforceOpportunityProject}" />
	</command>

	<command name="changePriceBook">
		<execute function="Click" locator1="SalesforceOpportunity#CHOOSE_PRICE_BOOK_BUTTON" />

		<execute function="Select" locator1="SalesforceProductAdd#SELECT_PRICE_BOOK" value1="${salesforcePriceBook}" />

		<execute macro="SalesforceButton#saveNoError" />

		<execute function="Confirm" value1="You have changed the price book for this opportunity. This action permanently deletes all products from the opportunity. Continue?" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_PRICE_BOOK" value1="Products (${salesforcePriceBook})" />
	</command>

	<command name="choosePriceBook">
		<execute function="Click" locator1="SalesforceOpportunity#CHOOSE_PRICE_BOOK_BUTTON" />

		<execute function="Select" locator1="SalesforceProductAdd#SELECT_PRICE_BOOK" value1="${salesforcePriceBook}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_PRICE_BOOK" value1="Products (${salesforcePriceBook})" />
	</command>

	<command name="clickFirstQuoteNumber">
		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_QUOTE_NUMBER" />
	</command>

	<command name="clickOrderForm">
		<var name="key_orderFormKeyword" value="${salesforceOrderFormKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_ORDER_FORM_ID" />
	</command>

	<command name="clickPartnerOpportunity">
		<var name="key_partnerOpportunityKeyword" value="${salesforcePartnerOpportunityKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PARTNER_OPPORTUNITY_ID" />
	</command>

	<command name="clickProduct">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />
	</command>

	<command name="clickProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<if>
			<and>
				<condition function="IsElementNotPresent" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />
				<condition function="IsElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_SHOW_MORE" />
			</and>
			<then>
				<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_SHOW_MORE" />
			</then>
		</if>

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />
	</command>

	<command name="createPartnerOpportunity">
		<execute function="Click" locator1="SalesforceOpportunity#NEW_PARTNER_OPPORTUNITY_BUTTON" />

		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_RECORD_TYPE" value1="${salesforcePartnerOpportunityRecordType}" />

		<execute macro="SalesforceButton#continue" />

		<execute macro="SalesforcePartnerOpportunity#fillPartnerOpportunity">
			<var name="salesforcePartnerOpportunityCurrency" value="${salesforcePartnerOpportunityCurrency}" />
			<var name="salesforcePartnerOpportunityPartnerEmail" value="${salesforcePartnerOpportunityPartnerEmail}" />
			<var name="salesforcePartnerOpportunityPartnerFirstName" value="${salesforcePartnerOpportunityPartnerFirstName}" />
			<var name="salesforcePartnerOpportunityPartnerLastName" value="${salesforcePartnerOpportunityPartnerLastName}" />
			<var name="salesforcePartnerOpportunityType" value="${salesforcePartnerOpportunityType}" />
		</execute>

		<execute macro="SalesforceButton#save" />
	</command>

	<command name="deleteFirstOrderForm">
		<execute function="ClickNoError" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_DELETE" />

		<execute function="Confirm" value1="Are you sure?" />
	</command>

	<command name="deleteFirstPartnerOpportunity">
		<execute function="ClickNoError" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_DELETE" />

		<execute function="Confirm" value1="Are you sure?" />
	</command>

	<command name="deleteOpportunity">
		<while>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_ID" />
			<then>
				<execute macro="SalesforceOpportunity#deleteFirstPartnerOpportunity" />
			</then>
		</while>

		<while>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_ID" />
			<then>
				<execute macro="SalesforceOpportunity#deleteFirstOrderForm" />
			</then>
		</while>

		<execute macro="SalesforceButton#delete" />
	</command>

	<command name="deleteProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />

		<execute macro="SalesforceButton#delete" />

		<execute function="AssertElementNotPresent" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />
	</command>

	<command name="editItem">
		<var name="key_itemLabel" value="${salesforceOpportunityItemLabel}" />

		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" value1="${salesforceOpportunityItemValue}" />
			</then>
			<else>
				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />
			</else>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />

		<execute macro="SalesforceNavigation#assertNoSaveError" />
	</command>

	<command name="editItemNoSave">
		<var name="key_itemLabel" value="${salesforceOpportunityItemLabel}" />

		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" value1="${salesforceOpportunityItemValue}" />
			</then>
			<else>
				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />
			</else>
		</if>
	</command>

	<command name="editItemWithError">
		<var name="key_itemLabel" value="${salesforceOpportunityItemLabel}" />

		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT" value1="${salesforceOpportunityItemValue}" />
			</then>
			<else>
				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />
			</else>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />

		<execute macro="SalesforceNavigation#assertSaveErrorText">
			<var name="salesforceSaveError" value="${salesforceOpportunitySaveError}" />
		</execute>
	</command>

	<command name="editStage">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" />

		<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE" value1="${salesforceOpportunityStage}" />

		<if>
			<equals arg1="${salesforceOpportunityStage}" arg2="Closed Won" />
			<then>
				<execute function="AssertTextEquals" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PROBABILITY" value1="100" />
			</then>
		</if>

		<if>
			<and>
				<isset var="salesforceOpportunityTermType" />
				<not>
					<contains string="${salesforceOpportunityTermType}" substring="{salesforceOpportunityTermType}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_TERM_TYPE" value1="${salesforceOpportunityTermType}" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" value1="${salesforceOpportunityPrimaryReasonLost}" />
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_CLOSED_LOST_VENDOR_SELECTED" value1="${salesforceOpportunityClosedLostVendorSelected}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="salesforceOpportunityStageDetail" />
				<not>
					<contains string="${salesforceOpportunityStageDetail}" substring="{salesforceOpportunityStageDetail}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE_DETAIL" value1="${salesforceOpportunityStageDetail}" />
			</then>
		</if>

		<execute macro="SalesforceButton#modalOK" />

		<if>
			<and>
				<isset var="salesforceOpportunityPrimaryReasonLostComment" />
				<not>
					<contains string="${salesforceOpportunityPrimaryReasonLostComment}" substring="{salesforceOpportunityPrimaryReasonLostComment}" />
				</not>
			</and>
			<then>
				<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PRIMARY_REASON_LOST_COMMENTS" />

				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST_COMMENTS" value1="${salesforceOpportunityPrimaryReasonLostComment}" />

				<execute macro="SalesforceButton#modalOK" />
			</then>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" value1="${salesforceOpportunityStage}" />

		<execute macro="SalesforceNavigation#assertNoSaveError" />
	</command>

	<command name="editStageWithError">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" />

		<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE" value1="${salesforceOpportunityStage}" />

		<if>
			<equals arg1="${salesforceOpportunityStage}" arg2="Closed Won" />
			<then>
				<execute function="AssertTextEquals" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PROBABILITY" value1="100" />
			</then>
		</if>

		<if>
			<and>
				<isset var="salesforceOpportunityTermType" />
				<not>
					<contains string="${salesforceOpportunityTermType}" substring="{salesforceOpportunityTermType}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_TERM_TYPE" value1="${salesforceOpportunityTermType}" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" value1="${salesforceOpportunityPrimaryReasonLost}" />
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_CLOSED_LOST_VENDOR_SELECTED" value1="${salesforceOpportunityClosedLostVendorSelected}" />
			</then>
		</if>

		<execute macro="SalesforceButton#modalOK" />

		<if>
			<and>
				<isset var="salesforceOpportunityPrimaryReasonLostComment" />
				<not>
					<contains string="${salesforceOpportunityPrimaryReasonLostComment}" substring="{salesforceOpportunityPrimaryReasonLostComment}" />
				</not>
			</and>
			<then>
				<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PRIMARY_REASON_LOST_COMMENTS" />

				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST_COMMENTS" value1="${salesforceOpportunityPrimaryReasonLostComment}" />

				<execute macro="SalesforceButton#modalOK" />
			</then>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" value1="${salesforceOpportunityStage}" />

		<execute macro="SalesforceNavigation#assertSaveErrorText">
			<var name="salesforceSaveError" value="${salesforceOpportunitySaveError}" />
		</execute>
	</command>

	<command name="fillOpportunity">
		<execute function="Type" locator1="SalesforceOpportunityCreate#OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />
		<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_TYPE" value1="${salesforceOpportunityType}" />
		<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_STAGE" value1="${salesforceOpportunityStage}" />
		<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_STAGE_DETAIL" value1="${salesforceOpportunityStageDetail}" />

		<if>
			<and>
				<isset var="salesforceOpportunityCloseDate" />
				<not>
					<contains string="${salesforceOpportunityCloseDate}" substring="{salesforceOpportunityCloseDate}" />
				</not>
			</and>
			<then>
				<execute function="Type" locator1="SalesforceOpportunityCreate#OPPORTUNITY_CLOSE_DATE" value1="${salesforceOpportunityCloseDate}" />
			</then>
			<else>
				<execute function="Click" locator1="SalesforceOpportunityCreate#OPPORTUNITY_CLOSE_DATE_TODAY" />
			</else>
		</if>

		<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_CURRENCY" value1="${salesforceOpportunityCurrency}" />
		<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_SOLD_BY_COUNTRY" value1="Liferay ${salesforceOpportunitySoldByCountry}" />

		<if>
			<and>
				<isset var="salesforceOpportunityPartnerTerritoryList" />
				<not>
					<contains string="${salesforceOpportunityPartnerTerritoryList}" substring="{salesforceOpportunityPartnerTerritoryList}" />
				</not>
			</and>
			<then>
				<for list="${salesforceOpportunityPartnerTerritoryList}" param="salesforceOpportunityPartnerTerritory">
					<var method="StringUtil#replace('${salesforceOpportunityPartnerTerritory}', ';', ',')" name="salesforceOpportunityPartnerTerritory" />

					<execute function="Select" locator1="SalesforceOpportunityCreate#OPPORTUNITY_PARTNER_TERRITORY" value1="${salesforceOpportunityPartnerTerritory}" />

					<execute macro="SalesforceButton#addFromList" />
				</for>
			</then>
		</if>
	</command>

	<command name="gotoDetails">
		<execute function="Click" locator1="SalesforceOpportunity#DETAILS_TAB" />
	</command>

	<command name="gotoFeed">
		<execute function="Click" locator1="SalesforceOpportunity#FEED_TAB" />
	</command>

	<command name="viewContactRole">
		<var name="key_contactName" value="${salesforceContactName}" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_CONTACT_NAME" value1="${salesforceContactName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_ROLE" value1="${salesforceContactRole}" />

		<if>
			<equals arg1="${salesforceContactRolePrimary}" arg2="true" />
			<then>
				<execute function="AssertElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_PRIMARY_CHECKED" />
			</then>
			<else>
				<execute function="AssertElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_PRIMARY_UNCHECKED" />
			</else>
		</if>
	</command>

	<command name="viewItem">
		<var name="key_itemLabel" value="${salesforceOpportunityItemLabel}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM" value1="${salesforceOpportunityItemValue}" />
	</command>

	<command name="viewNoOrderForms">
		<execute function="AssertElementNotPresent" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_ID" />
	</command>

	<command name="viewNoQuotes">
		<execute function="AssertElementNotPresent" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_QUOTE_NUMBER" />
	</command>

	<command name="viewOpportunityDetails">
		<execute macro="SalesforceOpportunity#gotoDetails" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_RECORD_TYPE" value1="${salesforceOpportunityRecordType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_TYPE" value1="${salesforceOpportunityType}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" value1="${salesforceOpportunityStage}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE_DETAIL" value1="${salesforceOpportunityStageDetail}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_CURRENCY" value1="${salesforceOpportunityCurrency}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_SOLD_BY_COUNTRY" value1="Liferay ${salesforceOpportunitySoldByCountry}" />

		<if>
			<and>
				<isset var="salesforceOpportunityCloseDate" />
				<not>
					<contains string="${salesforceOpportunityCloseDate}" substring="{salesforceOpportunityCloseDate}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_CLOSE_DATE" value1="${salesforceOpportunityCloseDate}" />
			</then>
		</if>

		<var method="StringUtil#replace('${salesforceOpportunityPartnerTerritoryList}', ';', '*')" name="salesforceOpportunityPartnerTerritoryList" />
		<var method="StringUtil#replace('${salesforceOpportunityPartnerTerritoryList}', ',', '; ')" name="salesforceOpportunityPartnerTerritoryList" />
		<var method="StringUtil#replace('${salesforceOpportunityPartnerTerritoryList}', '*', ',')" name="salesforceOpportunityPartnerTerritoryList" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_TERRITORY" value1="${salesforceOpportunityPartnerTerritoryList}" />
	</command>

	<command name="viewProductLineItem">
		<var name="key_productKeyword" value="${salesforceProductKeyword}" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" value1="${salesforceProductName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_QUANTITY" value1="${salesforceProductQuantity}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_DATE" value1="${salesforceProductDate}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_END_DATE" value1="${salesforceProductEndDate}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_SALES_PRICE" value1="${salesforceProductSalesPrice}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_TOTAL_PRICE" value1="${salesforceProductTotalPrice}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_TYPE" value1="${salesforceProductType}" />
	</command>
</definition>