definition {

	macro addContactRole {
		Click(locator1 = "SalesforceOpportunity#NEW_CONTACT_ROLE_BUTTON");

		SalesforceContact.addContactRole(
			salesforceContactName = "${salesforceContactName}",
			salesforceContactRole = "${salesforceContactRole}",
			salesforceContactRolePrimary = "${salesforceContactRolePrimary}");

		SalesforceOpportunity.viewContactRole(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "${salesforceContactName}",
			salesforceContactRole = "${salesforceContactRole}",
			salesforceContactRolePrimary = "${salesforceContactRolePrimary}");
	}

	macro addOrderForm {
		Click(locator1 = "SalesforceOpportunity#ADD_ORDER_FORM_BUTTON");

		SalesforceOrderForm.fillOrderForm(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOrderFormContactFirstName = "${salesforceOrderFormContactFirstName}",
			salesforceOrderFormContactLastName = "${salesforceOrderFormContactLastName}",
			salesforceOrderFormContractFormat = "${salesforceOrderFormContractFormat}",
			salesforceOrderFormContractingCountry = "${salesforceOrderFormContractingCountry}",
			salesforceOrderFormDocType = "${salesforceOrderFormDocType}",
			salesforceOrderFormLanguage = "${salesforceOrderFormLanguage}",
			salesforceOrderFormValidThroughDate = "${salesforceOrderFormValidThroughDate}");

		SalesforceButton.save();

		SalesforceOrderForm.viewOrderFormDetails(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOrderFormContactFirstName = "${salesforceOrderFormContactFirstName}",
			salesforceOrderFormContactLastName = "${salesforceOrderFormContactLastName}",
			salesforceOrderFormContractFormat = "${salesforceOrderFormContractFormat}",
			salesforceOrderFormContractingCountry = "${salesforceOrderFormContractingCountry}",
			salesforceOrderFormDocType = "${salesforceOrderFormDocType}",
			salesforceOrderFormLanguage = "${salesforceOrderFormLanguage}",
			salesforceOrderFormValidThroughDate = "${salesforceOrderFormValidThroughDate}");

		SalesforceNavigation.pause(pauseTime = "30000");
	}

	macro addProduct {
		Click(locator1 = "SalesforceOpportunity#ADD_PRODUCT_BUTTON");

		SalesforceProducts.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductAnnualSalesPrice = "${salesforceProductAnnualSalesPrice}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "${salesforceProductName}",
			salesforceProductQuantity = "${salesforceProductQuantity}",
			salesforceProductSalesPrice = "${salesforceProductSalesPrice}",
			salesforceProductTermType = "${salesforceProductTermType}",
			salesforceProductType = "${salesforceProductType}");
	}

	macro assignPartner {
		var key_opportunityPartner = "${salesforceOpportunityPartner}";

		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI");

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP");

		SelectWindow(locator1 = "title=Search ~ Salesforce - Enterprise Edition");

		SelectFrame(locator1 = "name=resultsFrame");

		AssertClick(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP_ACCOUNT",
			value1 = "${salesforceOpportunityPartner}");

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI",
			value1 = "${salesforceOpportunityPartner}");
	}

	macro assignProject {
		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT");

		Type(
			locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_PROJECT",
			value1 = "${salesforceOpportunityProject}");

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT",
			value1 = "${salesforceOpportunityProject}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityProject}");
	}

	macro changePriceBook {
		Click(locator1 = "SalesforceOpportunity#CHOOSE_PRICE_BOOK_BUTTON");

		Select(
			locator1 = "SalesforceProductAdd#SELECT_PRICE_BOOK",
			value1 = "${salesforcePriceBook}");

		SalesforceButton.saveNoError();

		Confirm(value1 = "You have changed the price book for this opportunity. This action permanently deletes all products from the opportunity. Continue?");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_PRICE_BOOK",
			value1 = "Products (${salesforcePriceBook})");
	}

	macro choosePriceBook {
		Click(locator1 = "SalesforceOpportunity#CHOOSE_PRICE_BOOK_BUTTON");

		Select(
			locator1 = "SalesforceProductAdd#SELECT_PRICE_BOOK",
			value1 = "${salesforcePriceBook}");

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_PRICE_BOOK",
			value1 = "Products (${salesforcePriceBook})");
	}

	macro clickFirstQuoteNumber {
		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_QUOTE_NUMBER");
	}

	macro clickOrderForm {
		var key_orderFormKeyword = "${salesforceOrderFormKeyword}";

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_ORDER_FORM_ID");
	}

	macro clickPartnerOpportunity {
		var key_partnerOpportunityKeyword = "${salesforcePartnerOpportunityKeyword}";

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_PARTNER_OPPORTUNITY_ID");
	}

	macro clickProduct {
		var key_productKeyword = "${salesforceProductKeyword}";

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME");
	}

	macro clickProductLineItem {
		var key_productKeyword = "${salesforceProductKeyword}";

		if ((IsElementNotPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME")) && (IsElementPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_SHOW_MORE"))) {
			Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_SHOW_MORE");
		}

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME");
	}

	macro createPartnerOpportunity {
		Click(locator1 = "SalesforceOpportunity#NEW_PARTNER_OPPORTUNITY_BUTTON");

		Select(
			locator1 = "SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_RECORD_TYPE",
			value1 = "${salesforcePartnerOpportunityRecordType}");

		SalesforceButton.continue();

		SalesforcePartnerOpportunity.fillPartnerOpportunity(
			salesforcePartnerOpportunityCurrency = "${salesforcePartnerOpportunityCurrency}",
			salesforcePartnerOpportunityPartnerEmail = "${salesforcePartnerOpportunityPartnerEmail}",
			salesforcePartnerOpportunityPartnerFirstName = "${salesforcePartnerOpportunityPartnerFirstName}",
			salesforcePartnerOpportunityPartnerLastName = "${salesforcePartnerOpportunityPartnerLastName}",
			salesforcePartnerOpportunityType = "${salesforcePartnerOpportunityType}");

		SalesforceButton.save();
	}

	macro deleteFirstOrderForm {
		ClickNoError(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_DELETE");

		Confirm(value1 = "Are you sure?");
	}

	macro deleteFirstPartnerOpportunity {
		ClickNoError(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_DELETE");

		Confirm(value1 = "Are you sure?");
	}

	macro deleteOpportunity {
		while (IsElementPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_ID")) {
			SalesforceOpportunity.deleteFirstPartnerOpportunity();
		}

		while (IsElementPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_ID")) {
			SalesforceOpportunity.deleteFirstOrderForm();
		}

		SalesforceButton.delete();
	}

	macro deleteProductLineItem {
		var key_productKeyword = "${salesforceProductKeyword}";

		Click(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME");

		SalesforceButton.delete();

		AssertElementNotPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME");
	}

	macro editItem {
		var key_itemLabel = "${salesforceOpportunityItemLabel}";

		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM");

		if (IsElementPresent(locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT")) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT",
				value1 = "${salesforceOpportunityItemValue}");
		}
		else {
			Type(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM",
				value1 = "${salesforceOpportunityItemValue}");
		}

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM",
			value1 = "${salesforceOpportunityItemValue}");

		SalesforceNavigation.assertNoSaveError();
	}

	macro editItemNoSave {
		var key_itemLabel = "${salesforceOpportunityItemLabel}";

		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM");

		if (IsElementPresent(locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT")) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT",
				value1 = "${salesforceOpportunityItemValue}");
		}
		else {
			Type(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM",
				value1 = "${salesforceOpportunityItemValue}");
		}
	}

	macro editItemWithError {
		var key_itemLabel = "${salesforceOpportunityItemLabel}";

		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM");

		if (IsElementPresent(locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT")) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_SELECT",
				value1 = "${salesforceOpportunityItemValue}");
		}
		else {
			Type(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_ITEM",
				value1 = "${salesforceOpportunityItemValue}");
		}

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM",
			value1 = "${salesforceOpportunityItemValue}");

		SalesforceNavigation.assertSaveErrorText(salesforceSaveError = "${salesforceOpportunitySaveError}");
	}

	macro editStage {
		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE");

		Select(
			locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE",
			value1 = "${salesforceOpportunityStage}");

		if ("${salesforceOpportunityStage}" == "Closed Won") {
			AssertTextEquals(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PROBABILITY",
				value1 = "100");
		}

		if (isSet(salesforceOpportunityTermType) && isSet(salesforceOpportunityTermType)) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_TERM_TYPE",
				value1 = "${salesforceOpportunityTermType}");
		}

		if (IsElementPresent(locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST")) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST",
				value1 = "${salesforceOpportunityPrimaryReasonLost}");

			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_CLOSED_LOST_VENDOR_SELECTED",
				value1 = "${salesforceOpportunityClosedLostVendorSelected}");
		}

		if (isSet(salesforceOpportunityStageDetail) && isSet(salesforceOpportunityStageDetail)) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE_DETAIL",
				value1 = "${salesforceOpportunityStageDetail}");
		}

		SalesforceButton.modalOK();

		if (isSet(salesforceOpportunityPrimaryReasonLostComment) && isSet(salesforceOpportunityPrimaryReasonLostComment)) {
			DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PRIMARY_REASON_LOST_COMMENTS");

			Type(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST_COMMENTS",
				value1 = "${salesforceOpportunityPrimaryReasonLostComment}");

			SalesforceButton.modalOK();
		}

		SalesforceButton.save();

		if (IsElementPresent(locator1 = "SalesforceButton#CONTINUE_BUTTON")) {
			SalesforceButton.continue();
		}

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE",
			value1 = "${salesforceOpportunityStage}");

		SalesforceNavigation.assertNoSaveError();
	}

	macro editStageWithError {
		DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE");

		Select(
			locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE",
			value1 = "${salesforceOpportunityStage}");

		if ("${salesforceOpportunityStage}" == "Closed Won") {
			AssertTextEquals(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PROBABILITY",
				value1 = "100");
		}

		if (isSet(salesforceOpportunityTermType) && isSet(salesforceOpportunityTermType)) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_TERM_TYPE",
				value1 = "${salesforceOpportunityTermType}");
		}

		if (IsElementPresent(locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST")) {
			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST",
				value1 = "${salesforceOpportunityPrimaryReasonLost}");

			Select(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_CLOSED_LOST_VENDOR_SELECTED",
				value1 = "${salesforceOpportunityClosedLostVendorSelected}");
		}

		SalesforceButton.modalOK();

		if (isSet(salesforceOpportunityPrimaryReasonLostComment) && isSet(salesforceOpportunityPrimaryReasonLostComment)) {
			DoubleClick(locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PRIMARY_REASON_LOST_COMMENTS");

			Type(
				locator1 = "SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST_COMMENTS",
				value1 = "${salesforceOpportunityPrimaryReasonLostComment}");

			SalesforceButton.modalOK();
		}

		SalesforceButton.save();

		Pause(locator1 = "3000");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE",
			value1 = "${salesforceOpportunityStage}");

		SalesforceNavigation.assertSaveErrorText(salesforceSaveError = "${salesforceOpportunitySaveError}");
	}

	macro fillOpportunity {
		Type(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_TYPE",
			value1 = "${salesforceOpportunityType}");

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_STAGE",
			value1 = "${salesforceOpportunityStage}");

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_STAGE_DETAIL",
			value1 = "${salesforceOpportunityStageDetail}");

		if (isSet(salesforceOpportunityCloseDate) && isSet(salesforceOpportunityCloseDate)) {
			Type(
				locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_CLOSE_DATE",
				value1 = "${salesforceOpportunityCloseDate}");
		}
		else {
			Click(locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_CLOSE_DATE_TODAY");
		}

		if (isSet(salesforceOpportunityTermType) && isSet(salesforceOpportunityTermType)) {
			Select(
				locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_TERM_TYPE",
				value1 = "${salesforceOpportunityTermType}");
		}

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_CURRENCY",
			value1 = "${salesforceOpportunityCurrency}");

		if (isSet(salesforceOpportunityNewBusinessSource) && isSet(salesforceOpportunityNewBusinessSource)) {
			Select(
				locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_NEW_BUSINESS_SOURCE",
				value1 = "${salesforceOpportunityNewBusinessSource}");
		}

		if (isSet(salesforceOpportunityNewBusinessSourceDetails) && isSet(salesforceOpportunityNewBusinessSourceDetails)) {
			Select(
				locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_NEW_BUSINESS_SOURCE_DETAILS",
				value1 = "${salesforceOpportunityNewBusinessSourceDetails}");
		}

		Select(
			locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_SOLD_BY_COUNTRY",
			value1 = "Liferay ${salesforceOpportunitySoldByCountry}");

		if (isSet(salesforceOpportunityPartnerTerritoryList) && isSet(salesforceOpportunityPartnerTerritoryList)) {
			for (var salesforceOpportunityPartnerTerritory : list "${salesforceOpportunityPartnerTerritoryList}") {
				var salesforceOpportunityPartnerTerritory = StringUtil.replace("${salesforceOpportunityPartnerTerritory}", ";", ",");

				Select(
					locator1 = "SalesforceOpportunityCreate#OPPORTUNITY_PARTNER_TERRITORY",
					value1 = "${salesforceOpportunityPartnerTerritory}");

				SalesforceButton.addFromList();
			}
		}
	}

	macro gotoDetails {
		Click(locator1 = "SalesforceOpportunity#DETAILS_TAB");
	}

	macro gotoFeed {
		Click(locator1 = "SalesforceOpportunity#FEED_TAB");
	}

	macro viewContactRole {
		var key_contactName = "${salesforceContactName}";

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_CONTACT_NAME",
			value1 = "${salesforceContactName}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_ROLE",
			value1 = "${salesforceContactRole}");

		if ("${salesforceContactRolePrimary}" == "true") {
			AssertElementPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_PRIMARY_CHECKED");
		}
		else {
			AssertElementPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_CONTACT_ROLES_PRIMARY_UNCHECKED");
		}
	}

	macro viewItem {
		var key_itemLabel = "${salesforceOpportunityItemLabel}";

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_ITEM",
			value1 = "${salesforceOpportunityItemValue}");
	}

	macro viewNoOrderForms {
		AssertElementNotPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_ORDER_FORM_ID");
	}

	macro viewNoQuotes {
		AssertElementNotPresent(locator1 = "SalesforceOpportunity#OPPORTUNITY_FIRST_QUOTE_NUMBER");
	}

	macro viewOpportunityDetails {
		SalesforceOpportunity.gotoDetails();

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_RECORD_TYPE",
			value1 = "${salesforceOpportunityRecordType}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_TYPE",
			value1 = "${salesforceOpportunityType}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE",
			value1 = "${salesforceOpportunityStage}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE_DETAIL",
			value1 = "${salesforceOpportunityStageDetail}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_CURRENCY",
			value1 = "${salesforceOpportunityCurrency}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_SOLD_BY_COUNTRY",
			value1 = "Liferay ${salesforceOpportunitySoldByCountry}");

		if (isSet(salesforceOpportunityCloseDate) && isSet(salesforceOpportunityCloseDate)) {
			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_CLOSE_DATE",
				value1 = "${salesforceOpportunityCloseDate}");
		}

		var salesforceOpportunityPartnerTerritoryList = StringUtil.replace("${salesforceOpportunityPartnerTerritoryList}", ";", "*");

		var salesforceOpportunityPartnerTerritoryList = StringUtil.replace("${salesforceOpportunityPartnerTerritoryList}", ",", "; ");

		var salesforceOpportunityPartnerTerritoryList = StringUtil.replace("${salesforceOpportunityPartnerTerritoryList}", "*", ",");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_TERRITORY",
			value1 = "${salesforceOpportunityPartnerTerritoryList}");
	}

	macro viewProductLineItem {
		var key_productKeyword = "${salesforceProductKeyword}";

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME",
			value1 = "${salesforceProductName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_QUANTITY",
			value1 = "${salesforceProductQuantity}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_DATE",
			value1 = "${salesforceProductDate}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_END_DATE",
			value1 = "${salesforceProductEndDate}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_SALES_PRICE",
			value1 = "${salesforceProductSalesPrice}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_TOTAL_PRICE",
			value1 = "${salesforceProductTotalPrice}");

		AssertTextEquals(
			locator1 = "SalesforceOpportunity#OPPORTUNITY_PRODUCT_TYPE",
			value1 = "${salesforceProductType}");
	}

}