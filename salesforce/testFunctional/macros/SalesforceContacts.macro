definition {

	macro clickFirstRecentContact {
		Click(locator1 = "SalesforceContacts#FIRST_RECENT_CONTACT_NAME");
	}

	macro createContact {
		SalesforceButton.new();

		SalesforceContact.fillContact(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactCurrency = "${salesforceContactCurrency}",
			salesforceContactEmail = "${salesforceContactEmail}",
			salesforceContactFirstName = "${salesforceContactFirstName}",
			salesforceContactLastName = "${salesforceContactLastName}",
			salesforceContactMailingCountry = "${salesforceContactMailingCountry}",
			salesforceContactPurchaseDecisionInvolvement = "${salesforceContactPurchaseDecisionInvolvement}",
			salesforceContactTitle = "${salesforceContactTitle}",
			salesforceContactType = "${salesforceContactType}");

		SalesforceButton.save();
	}

	macro deleteAllContacts {
		while (IsElementPresent(locator1 = "SalesforceContacts#FIRST_RECENT_CONTACT_NAME")) {
			SalesforceContacts.clickFirstRecentContact();

			SalesforceButton.delete();

			SalesforceNavigation.gotoContacts();
		}
	}

}