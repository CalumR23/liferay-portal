definition {

	macro addContactRole {
		var key_contactRolePositionValue = "1";

		if ("${salesforceContactRolePrimary}" == "true") {
			var key_contactRolePrimaryPositionValue = ${key_contactRolePositionValue} + 1;

			Click(locator1 = "SalesforceContactRoleAdd#CONTACT_ROLE_PRIMARY");
		}

		Type(
			locator1 = "SalesforceContactRoleAdd#CONTACT_ROLE_CONTACT",
			value1 = "${salesforceContactName}");

		Select(
			locator1 = "SalesforceContactRoleAdd#CONTACT_ROLE_ROLE",
			value1 = "${salesforceContactRole}");

		SalesforceButton.save();
	}

	macro fillContact {
		var salesforceContactEmail = StringUtil.replace("${salesforceContactEmail}", " ", "_");

		Type(
			locator1 = "SalesforceContactCreate#CONTACT_FIRST_NAME",
			value1 = "${salesforceContactFirstName}");

		Type(
			locator1 = "SalesforceContactCreate#CONTACT_LAST_NAME",
			value1 = "${salesforceContactLastName}");

		Type(
			locator1 = "SalesforceContactCreate#CONTACT_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		Type(
			locator1 = "SalesforceContactCreate#CONTACT_TITLE",
			value1 = "${salesforceContactTitle}");

		Select(
			locator1 = "SalesforceContactCreate#CONTACT_PURCHASE_DECISION_INVOLVEMENT",
			value1 = "${salesforceContactPurchaseDecisionInvolvement}");

		Select(
			locator1 = "SalesforceContactCreate#CONTACT_CURRENCY",
			value1 = "${salesforceContactCurrency}");

		for (var salesforceContactType : list "${salesforceContactType}") {
			Select(
				locator1 = "SalesforceContactCreate#CONTACT_CONTACT_TYPE",
				value1 = "${salesforceContactType}");

			SalesforceButton.addFromList();
		}

		Type(
			locator1 = "SalesforceContactCreate#CONTACT_EMAIL",
			value1 = "${salesforceContactEmail}");

		Select(
			locator1 = "SalesforceContactCreate#CONTACT_MAILING_COUNTRY",
			value1 = "${salesforceContactMailingCountry}");
	}

	macro viewContactDetails {
		var salesforceContactEmail = StringUtil.replace("${salesforceContactEmail}", " ", "_");

		var salesforceContactEmail = StringUtil.lowerCase("${salesforceContactEmail}");

		AssertTextEquals(
			locator1 = "SalesforceContact#CONTACT_DETAILS_NAME",
			value1 = "${salesforceContactFirstName} ${salesforceContactLastName}");

		AssertTextEquals(
			locator1 = "SalesforceContact#CONTACT_DETAILS_ACCOUNT_NAME",
			value1 = "${salesforceAccountName}");

		AssertTextEquals(
			locator1 = "SalesforceContact#CONTACT_DETAILS_TITLE",
			value1 = "${salesforceContactTitle}");

		AssertTextEquals(
			locator1 = "SalesforceContact#CONTACT_DETAILS_PURCHASE_DECISION_INVOLVEMENT",
			value1 = "${salesforceContactPurchaseDecisionInvolvement}");

		for (var salesforceContactType : list "${salesforceContactType}") {
			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceContact#CONTACT_DETAILS_CONTACT_TYPE",
				value1 = "${salesforceContactType}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceContact#CONTACT_DETAILS_EMAIL",
			value1 = "${salesforceContactEmail}");

		AssertTextEquals(
			locator1 = "SalesforceContact#CONTACT_DETAILS_MAILING_COUNTRY",
			value1 = "${salesforceContactMailingCountry}");
	}

}