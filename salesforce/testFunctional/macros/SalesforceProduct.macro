definition {

	macro clickOpportunity {
		Click(locator1 = "SalesforceProduct#PRODUCT_DETAILS_OPPORTUNITY_NAME");
	}

	macro editItem {
		var key_itemLabel = "${salesforceProductItemLabel}";

		DoubleClick(locator1 = "SalesforceProduct#PRODUCT_DETAILS_ITEM");

		if ("${salesforceProductItemType}" == "Select") {
			Select(
				locator1 = "SalesforceProduct#EDIT_PRODUCT_DETAILS_SELECT",
				value1 = "${salesforceProductItemValue}");
		}
		else {
			if ("${salesforceProductItemType}" == "Checkbox") {
				Click(locator1 = "SalesforceProduct#EDIT_PRODUCT_DETAILS_CHECKBOX");
			}
			else {
				Type(
					locator1 = "SalesforceProduct#EDIT_PRODUCT_DETAILS_ITEM",
					value1 = "${salesforceProductItemValue}");
			}
		}

		SalesforceButton.save();

		Pause(locator1 = "3000");

		if ("${salesforceProductItemType}" == "Checkbox") {
			AssertElementPresent(locator1 = "SalesforceProduct#PRODUCT_DETAILS_ITEM_CHECKED");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceProduct#PRODUCT_DETAILS_ITEM",
				value1 = "${salesforceProductItemValue}");
		}

		SalesforceNavigation.assertNoSaveError();
	}

	macro viewItem {
		var key_itemLabel = "${salesforceProductItemLabel}";

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_ITEM",
			value1 = "${salesforceProductItemValue}");
	}

	macro viewProductDetails {
		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_OPPORTUNITY_NAME",
			value1 = "${salesforceOpportunityName}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_NAME",
			value1 = "${salesforceProductName}");

		AssertTextEquals(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_PRODUCT_TYPE",
			value1 = "${salesforceProductType}");

		if (isSet(salesforceProductQuantity) && isSet(salesforceProductQuantity)) {
			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceProduct#PRODUCT_DETAILS_QUANTITY",
				value1 = "${salesforceProductQuantity}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_SALES_PRICE",
			value1 = "${salesforceProductSalesPrice}");

		if (isSet(salesforceProductAnnualSalesPrice) && isSet(salesforceProductAnnualSalesPrice)) {
			AssertTextEquals.assertPartialText(
				locator1 = "SalesforceProduct#PRODUCT_DETAILS_ANNUAL_SALES_PRICE",
				value1 = "${salesforceProductAnnualSalesPrice}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_PRODUCT_TERM_TYPE",
			value1 = "${salesforceProductTermType}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_DATE",
			value1 = "${salesforceProductDate}");

		AssertTextEquals.assertPartialText(
			locator1 = "SalesforceProduct#PRODUCT_DETAILS_END_DATE",
			value1 = "${salesforceProductEndDate}");
	}

}