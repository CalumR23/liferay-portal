			salesforceOpportunityType = "Existing Business");
	}

	@priority = "5"
	test CloseWonPartnerOpportunityWithReseller {
		var salesforceAccountName1 = "CloseWonPartnerOpportunityWithReseller Partner";
		var salesforceAccountName2 = "CloseWonPartnerOpportunityWithReseller Other";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName1 = "${salesforceAccountName1}";
		var salesforceOpportunityName2 = "${salesforceAccountName2}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName2 = "${salesforceAccountName2} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
