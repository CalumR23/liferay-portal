@component-name = "salesforce"
definition {

	property testray.main.component.name = "salesforce";

	setUp {
		SalesforceLogin.loginUser();
	}

	tearDown {
		Salesforce.deleteAllEntities();

		SalesforceLogin.logoutUser();
	}

	@priority = "5"
	test AddRenewalOpportunity {
		var salesforceAccountName = "AddRenewalOpportunity";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityItemValue = "USD 29,375.00";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforcePriceBook = "[Current] USD - DXP Subscription and Services";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Aerospace & Defense",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Existing Business");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 2",
			salesforceProductQuantity = "1",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		Salesforce.createAndViewProject(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "Yes",
			salesforceProjectLicenseOptionPurchased = "A",
			salesforceProjectLiferayVersion = "6.2 EE",
			salesforceProjectMaximumNumContacts = "2",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "Gold",
			salesforceProjectRecordType = "OEM",
			salesforceProjectSupportCenter = "Americas");

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}");

		Salesforce.createAndViewContact(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactCurrency = "${salesforceCurrency}",
			salesforceContactEmail = "${salesforceAccountName}@liferay.com",
			salesforceContactFirstName = "Test",
			salesforceContactLastName = "${salesforceAccountName}",
			salesforceContactMailingCountry = "United States",
			salesforceContactPurchaseDecisionInvolvement = "No involvement",
			salesforceContactTitle = "CEO",
			salesforceContactType = "Legal,Email Business");

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "Test ${salesforceAccountName}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying");

		Salesforce.addProjectContactRoleViaAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "Test ${salesforceAccountName}",
			salesforceContactRole = "Influencer",
			salesforceContactRolePrimary = "true",
			salesforceCurrency = "${salesforceCurrency}",
			salesforceProjectName = "${salesforceProjectName}");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "1/1/2019",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Committed",
			salesforceOpportunityStageDetail = "No Action Taken",
			salesforceOpportunityType = "Renewal");

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "2019.1.1",
			salesforceProjectName = "${salesforceProjectName}");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "2018.1.1");

		SalesforceOpportunity.editItem(
			salesforceOpportunityItemLabel = "Renewal Opportunity",
			salesforceOpportunityItemValue = "${salesforceAccountName}-${salesforceProjectName}-2019.1.1");

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "2019.1.1");

		SalesforceOpportunity.viewItem(
			salesforceOpportunityItemLabel = "Prev Subscription Amount",
			salesforceOpportunityItemValue = "${salesforceOpportunityItemValue}");
	}

	@priority = "5"
	test CloseLostPartnerOpportunity {
		var salesforceAccountName = "CloseLostPartnerOpportunity";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforcePriceBook = "[Current] USD - DXP Subscription and Services";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Aerospace & Defense",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Existing Business");

		Salesforce.createAndViewPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "${salesforceAccountName}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforcePartnerOpportunityCurrency = "${salesforceCurrency}",
			salesforcePartnerOpportunityOwner = "${salesforceAccountOwner}",
			salesforcePartnerOpportunityPartnerEmail = "${salesforceAccountName}@liferay.com",
			salesforcePartnerOpportunityPartnerFirstName = "Test",
			salesforcePartnerOpportunityPartnerLastName = "Partner",
			salesforcePartnerOpportunityRecordType = "Subscription",
			salesforcePartnerOpportunityType = "Renewal");

		Salesforce.createAndViewProject(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "Yes",
			salesforceProjectLicenseOptionPurchased = "A",
			salesforceProjectLiferayVersion = "6.2 EE",
			salesforceProjectMaximumNumContacts = "2",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "Gold",
			salesforceProjectRecordType = "OEM",
			salesforceProjectSupportCenter = "Americas");

		Salesforce.addAndSyncProductsViaPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}");

		Salesforce.addProjectContactRoleViaAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "Test ${salesforceAccountName}",
			salesforceContactRole = "Influencer",
			salesforceContactRolePrimary = "true",
			salesforceCurrency = "${salesforceCurrency}",
			salesforceProjectName = "${salesforceProjectName}");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.clickPartnerOpportunity(salesforcePartnerOpportunityKeyword = "Open");

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityPrimaryReasonLost = "Too Expensive",
			salesforcePartnerOpportunityStage = "Closed Lost");

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityClosedLostVendorSelected = "Wordpress VIP",
			salesforceOpportunityPrimaryReasonLost = "Too Expensive",
			salesforceOpportunityPrimaryReasonLostComment = "Too Expensive",
			salesforceOpportunityStage = "Closed Lost");

		SalesforceNavigation.gotoRecentAccount(salesforceAccountName = "${salesforceAccountName}");

		SalesforceAccount.viewNoOpportunity(salesforceOpportunityKeyword = "Uncommitted Renewal");
	}

	@priority = "5"
	test CloseWonOpportunityWithoutContactRole {
		var salesforceAccountName = "CloseWonOpportunityWithoutContactRole";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "Afghanistan,Albania";
		var salesforcePriceBook = "[Current] USD - Partnership";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Energy",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityNewBusinessSource = "Personal/Professional Contact",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "Partnership",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "New Business");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "${salesforceProductDate}",
			salesforceProductEndDate = "${salesforceProductEndDate}",
			salesforceProductName = "Service Partnership",
			salesforceProductQuantity = "1",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		Salesforce.createAndViewProject(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "Yes",
			salesforceProjectLicenseOptionPurchased = "A",
			salesforceProjectLiferayVersion = "6.2 EE",
			salesforceProjectMaximumNumContacts = "2",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "Gold",
			salesforceProjectRecordType = "OEM",
			salesforceProjectSupportCenter = "Americas");

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}");

		SalesforceNavigation.gotoRecentOpportunity(salesforceOpportunityName = "${salesforceOpportunityName}");

		SalesforceOpportunity.editStageWithError(
			salesforceOpportunitySaveError = "Error: An Opportunity Contact Role is required before closing an Opportunity.",
			salesforceOpportunityStage = "Closed Won");
	}

