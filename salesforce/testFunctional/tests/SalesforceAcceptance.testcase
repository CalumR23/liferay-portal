		SalesforceOpportunity.editStage(salesforceOpportunityStage = "Closed Won");

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Energy",
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
