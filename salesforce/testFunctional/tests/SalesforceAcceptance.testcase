<definition component-name="salesforce">
	<property name="testray.main.component.name" value="salesforce" />

	<set-up>
		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="Salesforce#deleteAllEntities" />
	</set-up>

	<tear-down>
		<execute macro="SalesforceLogin#logoutUser" />
	</tear-down>

	<command name="AddRenewalOpportunity" priority="5">
		<var name="salesforceAccountName" value="AddRenewalOpportunity" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceCurrency" value="USD - U.S. Dollar" />
		<var name="salesforceOpportunityItemValue" value="USD 29,375.00" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />
		<var name="salesforceOpportunityPartnerTerritoryList" value="United States" />
		<var name="salesforcePriceBook" value="[Current] USD - DXP Subscription and Services" />
		<var name="salesforceProductDate" value="1/1/2017" />
		<var name="salesforceProductEndDate" value="12/31/2017" />
		<var name="salesforceProjectName" value="${salesforceAccountName} Project" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="${salesforceCurrency}" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCloseDate" value="${salesforceProductDate}" />
			<var name="salesforceOpportunityCurrency" value="${salesforceCurrency}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType" value="General" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addProduct">
			<var name="salesforcePriceBook" value="${salesforcePriceBook}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="Liferay DXP Subscription - Gold Backup Sizing 1" />
			<var name="salesforceProductQuantity" value="1" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>

		<execute macro="SalesforceOpportunity#addProduct">
			<var name="salesforcePriceBook" value="${salesforcePriceBook}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="Liferay DXP Subscription - Gold Backup Sizing 2" />
			<var name="salesforceProductQuantity" value="1" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>

		<execute macro="Salesforce#createAndViewProject">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceProjectFirstLineSupport" value="Yes" />
			<var name="salesforceProjectLicenseOptionPurchased" value="A" />
			<var name="salesforceProjectLiferayVersion" value="6.2 EE" />
			<var name="salesforceProjectMaximumNumContacts" value="2" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
			<var name="salesforceProjectPartnerLevel" value="Gold" />
			<var name="salesforceProjectRecordType" value="OEM" />
			<var name="salesforceProjectSupportCenter" value="Americas" />
		</execute>

		<execute macro="Salesforce#assignProjectToOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
		</execute>

		<execute macro="Salesforce#createAndViewContact">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContactCurrency" value="${salesforceCurrency}" />
			<var name="salesforceContactEmail" value="${salesforceAccountName}@liferay.com" />
			<var name="salesforceContactFirstName" value="Test" />
			<var name="salesforceContactLastName" value="${salesforceAccountName}" />
			<var name="salesforceContactMailingCountry" value="United States" />
			<var name="salesforceContactPurchaseDecisionInvolvement" value="No involvement" />
			<var name="salesforceContactTitle" value="CEO" />
			<var name="salesforceContactType" value="Legal,Email Business" />
		</execute>

		<execute macro="Salesforce#addContactRoleViaOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContactName" value="Test ${salesforceAccountName}" />
			<var name="salesforceContactRole" value="Architect" />
			<var name="salesforceContactRolePrimary" value="true" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCloseDate" value="1/1/2018" />
			<var name="salesforceOpportunityCurrency" value="${salesforceCurrency}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType" value="General" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Committed" />
			<var name="salesforceOpportunityStageDetail" value="No Action Taken" />
			<var name="salesforceOpportunityType" value="Renewal" />
		</execute>

		<execute macro="Salesforce#assignProjectToOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="2018.1.1" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="2017.1.1" />
		</execute>

		<execute macro="SalesforceOpportunity#editItem">
			<var name="salesforceOpportunityItemLabel" value="Renewal Opportunity" />
			<var name="salesforceOpportunityItemValue" value="${salesforceAccountName}-${salesforceProjectName}-2018.1.1" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
			<var name="salesforceOpportunityTermType" value="Single Year" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="2018.1.1" />
		</execute>

		<execute macro="SalesforceOpportunity#viewItem">
			<var name="salesforceOpportunityItemLabel" value="Prev Subscription Amount" />
			<var name="salesforceOpportunityItemValue" value="${salesforceOpportunityItemValue}" />
		</execute>
	</command>

	<command name="CloseLostPartnerOpportunity" priority="5">
		<var name="salesforceAccountName" value="CloseLostPartnerOpportunity" />
