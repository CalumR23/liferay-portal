<definition component-name="salesforce">
	<property name="testray.main.component.name" value="salesforce" />

	<set-up>
		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="Salesforce#deleteAllEntities" />
	</set-up>

	<tear-down>
		<execute macro="SalesforceLogin#logoutUser" />
	</tear-down>

	<command name="Populate" priority="5">
		<var name="salesforceAccountName1" value="Populate Partner" />
		<var name="salesforceAccountName2" value="Populate Other" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceCurrency" value="USD - U.S. Dollar" />
		<var name="salesforceOpportunityName1" value="${salesforceAccountName1}" />
		<var name="salesforceOpportunityName2" value="${salesforceAccountName2}" />
		<var name="salesforceProjectName" value="${salesforceAccountName2} Project" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="${salesforceCurrency}" />
			<var name="salesforceAccountIndustry" value="Education" />
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceOpportunityCloseDate" value="1/1/2012" />
			<var name="salesforceOpportunityCurrency" value="${salesforceCurrency}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName1}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="United States" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addProduct">
			<var name="salesforcePriceBook" value="[Current] USD - Partnership" />
			<var name="salesforceProductDate" value="1/1/2012" />
			<var name="salesforceProductEndDate" value="12/31/2012" />
			<var name="salesforceProductName" value="Service Partnership" />
			<var name="salesforceProductQuantity" value="1" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>

		<execute macro="Salesforce#createAndViewContact">
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceContactCurrency" value="${salesforceCurrency}" />
			<var name="salesforceContactEmail" value="${salesforceAccountName1}@liferay.com" />
			<var name="salesforceContactFirstName" value="Test" />
			<var name="salesforceContactLastName" value="${salesforceAccountName1}" />
			<var name="salesforceContactMailingCountry" value="United States" />
			<var name="salesforceContactPurchaseDecisionInvolvement" value="No involvement" />
			<var name="salesforceContactTitle" value="CEO" />
			<var name="salesforceContactType" value="Legal,Email Business" />
		</execute>

		<execute macro="Salesforce#addContactRoleViaOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceContactName" value="Test ${salesforceAccountName1}" />
			<var name="salesforceContactRole" value="Architect" />
			<var name="salesforceContactRolePrimary" value="true" />
