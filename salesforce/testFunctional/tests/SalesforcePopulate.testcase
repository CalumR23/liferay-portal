@component-name = "salesforce"
definition {
	property testray.main.component.name = "salesforce";

	setUp {
		SalesforceLogin.loginUser();

		Salesforce.deleteAllEntities();
	}

	tearDown {
		SalesforceLogin.logoutUser();
	}

	@priority = "5"
	test Populate {
		var salesforceAccountName1 = "Populate Partner";
		var salesforceAccountName2 = "Populate Other";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName1 = "${salesforceAccountName1}";
		var salesforceOpportunityName2 = "${salesforceAccountName2}";
		var salesforceProjectName = "${salesforceAccountName2} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Education",
			salesforceAccountName = "${salesforceAccountName1}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver"
		);

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName1}",
			salesforceOpportunityCloseDate = "1/1/2012",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName1}",
			salesforceOpportunityPartnerTerritoryList = "United States",
			salesforceOpportunityRecordType = "Partnership",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "New Business"
		);

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "[Current] USD - Partnership",
			salesforceProductDate = "1/1/2012",
			salesforceProductEndDate = "12/31/2012",
			salesforceProductName = "Service Partnership",
			salesforceProductQuantity = "1",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New"
		);

		Salesforce.createAndViewContact(
			salesforceAccountName = "${salesforceAccountName1}",
			salesforceContactCurrency = "${salesforceCurrency}",
			salesforceContactEmail = "${salesforceAccountName1}@liferay.com",
			salesforceContactFirstName = "Test",
			salesforceContactLastName = "${salesforceAccountName1}",
			salesforceContactMailingCountry = "United States",
			salesforceContactPurchaseDecisionInvolvement = "No involvement",
			salesforceContactTitle = "CEO",
			salesforceContactType = "Legal,Email Business"
		);

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName1}",
			salesforceContactName = "Test ${salesforceAccountName1}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceNavigation.gotoRecentOpportunity(
			salesforceOpportunityName = "${salesforceOpportunityName1}"
		);

		SalesforceOpportunity.editStage(salesforceOpportunityStage = "Closed Won");

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Manufacturing",
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver"
		);

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityCloseDate = "1/1/2012",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforceOpportunityPartnerTerritoryList = "United States",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "New Business"
		);

		Salesforce.createAndViewPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityCurrency = "${salesforceCurrency}",
			salesforcePartnerOpportunityOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityOwner = "${salesforceAccountOwner}",
			salesforcePartnerOpportunityPartnerEmail = "test@liferay.com",
			salesforcePartnerOpportunityPartnerFirstName = "Test",
			salesforcePartnerOpportunityPartnerLastName = "Partner",
			salesforcePartnerOpportunityRecordType = "Subscription",
			salesforcePartnerOpportunityType = "Renewal"
		);

		Salesforce.createAndViewProject(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceProjectFirstLineSupport = "Yes",
			salesforceProjectLiferayVersion = "DXP",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectRecordType = "Software"
		);

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.clickFirstQuoteNumber();

		SalesforceQuote.addProductLineItem(
			salesforcePriceBook = "US - Software Pricing [2012]",
			salesforceProductDate = "1/1/2012",
			salesforceProductEndDate = "12/31/2012",
			salesforceProductName = "Subscription Portal EE - Platinum (Non-Production)",
			salesforceProductQuantity = "2",
			salesforceProductSalesPrice = "5,987.50",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New"
		);

		SalesforceQuote.addProductLineItem(
			salesforcePriceBook = "US - Software Pricing [2012]",
			salesforceProductDate = "1/1/2012",
			salesforceProductEndDate = "12/31/2012",
			salesforceProductName = "Subscription Portal EE - Platinum (Production)",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "23,950.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New"
		);

		SalesforceQuote.clickPartnerOpportunity();

		SalesforcePartnerOpportunity.syncProducts();

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.editItem(
			salesforceOpportunityItemLabel = "End User Amount [P]",
			salesforceOpportunityItemValue = "5,000"
		);

		Salesforce.createAndViewContact(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceContactCurrency = "${salesforceCurrency}",
			salesforceContactEmail = "${salesforceAccountName2}@liferay.com",
			salesforceContactFirstName = "Test",
			salesforceContactLastName = "${salesforceAccountName2}",
			salesforceContactMailingCountry = "United States",
			salesforceContactPurchaseDecisionInvolvement = "No involvement",
			salesforceContactTitle = "CEO",
			salesforceContactType = "Legal,Email Business"
		);

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceContactName = "Test ${salesforceAccountName2}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Uncommitted Renewal"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Uncommitted Renewal"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Uncommitted Renewal"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Uncommitted Renewal"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Uncommitted Renewal"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);

		SalesforceNavigation.gotoRecentAccount(
			salesforceAccountName = "${salesforceAccountName2}"
		);

		SalesforceAccount.viewOpportunityName(
			salesforceOpportunityKeyword = "Uncommitted Renewal",
			salesforceOpportunityName = "2018.1.1"
		);

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityCloseDate = "1/1/2017",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforceOpportunityPartnerTerritoryList = "United States",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Existing Business"
		);

		Salesforce.createAndViewPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityCurrency = "${salesforceCurrency}",
			salesforcePartnerOpportunityOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityOwner = "${salesforceAccountOwner}",
			salesforcePartnerOpportunityPartnerEmail = "test@liferay.com",
			salesforcePartnerOpportunityPartnerFirstName = "Test",
			salesforcePartnerOpportunityPartnerLastName = "Partner",
			salesforcePartnerOpportunityRecordType = "Subscription",
			salesforcePartnerOpportunityType = "Renewal"
		);

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}"
		);

		Salesforce.addAndSyncProductsViaPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforcePriceBook = "[Current] USD - DXP Subscription and Services",
			salesforceProductDate = "1/1/2017",
			salesforceProductEndDate = "12/31/2017",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New"
		);

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceContactName = "Test ${salesforceAccountName2}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityPrimaryReasonLost = "Too Expensive",
			salesforcePartnerOpportunityStage = "Closed Lost"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(
			salesforceOpportunityClosedLostVendorSelected = "Wordpress VIP",
			salesforceOpportunityPrimaryReasonLost = "Too Expensive",
			salesforceOpportunityPrimaryReasonLostComment = "Too Expensive",
			salesforceOpportunityStage = "Closed Lost"
		);

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityCloseDate = "1/1/2013",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforceOpportunityPartnerTerritoryList = "United States",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Training"
		);

		Salesforce.createAndViewPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityCurrency = "${salesforceCurrency}",
			salesforcePartnerOpportunityOpportunityName = "${salesforceOpportunityName2}",
			salesforcePartnerOpportunityOwner = "${salesforceAccountOwner}",
			salesforcePartnerOpportunityPartnerEmail = "test@liferay.com",
			salesforcePartnerOpportunityPartnerFirstName = "Test",
			salesforcePartnerOpportunityPartnerLastName = "Partner",
			salesforcePartnerOpportunityRecordType = "Subscription",
			salesforcePartnerOpportunityType = "Renewal"
		);

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}"
		);

		Salesforce.addAndSyncProductsViaPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforcePriceBook = "US Training [2013]",
			salesforceProductDate = "1/1/2013",
			salesforceProductEndDate = "12/31/2013",
			salesforceProductName = "OST- Managing Content with Liferay - 10",
			salesforceProductSalesPrice = "16,500.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New"
		);

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceContactName = "Test ${salesforceAccountName2}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.clickPartnerOpportunity(
			salesforcePartnerOpportunityKeyword = "Open"
		);

		SalesforcePartnerOpportunity.editStage(
			salesforcePartnerOpportunityStage = "Closed Won"
		);

		SalesforcePartnerOpportunity.clickOpportunity();

		SalesforceOpportunity.editStage(salesforceOpportunityStage = "Closed Won");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityCloseDate = "1/1/2017",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName2}",
			salesforceOpportunityPartnerTerritoryList = "United States",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "US",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Existing Business"
		);

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}"
		);

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "US - Software Pricing [2013]",
			salesforceProductAnnualSalesPrice = "46,000",
			salesforceProductDate = "1/1/2017",
			salesforceProductEndDate = "12/31/2017",
			salesforceProductName = "Portal EE 6.x License (Production)",
			salesforceProductTermType = "One-Time",
			salesforceProductType = "New"
		);

		SalesforceOpportunity.viewProductLineItem(
			salesforceProductDate = "1/1/2017",
			salesforceProductEndDate = "12/31/2017",
			salesforceProductKeyword = "New",
			salesforceProductName = "Portal EE 6.x License (Production)",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "USD 46,000",
			salesforceProductTotalPrice = "USD 46,000",
			salesforceProductType = "New"
		);

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName2}",
			salesforceContactName = "Test ${salesforceAccountName2}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying"
		);

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year"
		);
	}
}