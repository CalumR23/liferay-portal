		<execute macro="Salesforce#addContactRoleViaOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
			<var name="salesforceContactName" value="Test ${salesforceAccountName2}" />
			<var name="salesforceContactRole" value="Architect" />
			<var name="salesforceContactRolePrimary" value="true" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
			<var name="salesforceOpportunityTermType" value="Single Year" />
		</execute>
	</command>
</definition>