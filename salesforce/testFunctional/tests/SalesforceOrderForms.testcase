	@priority = "5"
	test CreateOrderFormWithSpecialCharacters {
		var salesforceAccountName = "CreateOrderFormWithSpecialCharacters";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforcePriceBook = "[Current] USD - DXP Subscription and Services";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Engineering",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
