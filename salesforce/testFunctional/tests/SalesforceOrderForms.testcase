@component-name = "salesforce"
definition {

	property testray.main.component.name = "salesforce";

	setUp {
		SalesforceLogin.loginUser();
	}

	tearDown {
		Salesforce.deleteAllEntities();

		SalesforceLogin.logoutUser();
	}

	@priority = "5"
	test CheckOrderFormSalesPrices {
		var salesforceAccountName = "CheckOrderFormSalesPrices";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforcePriceBook = "[Current] USD - DXP Subscription and Services";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Energy",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "1/1/2018",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOpportunityPartnerTerritoryList = "${salesforceOpportunityPartnerTerritoryList}",
			salesforceOpportunityRecordType = "General",
			salesforceOpportunitySoldByCountry = "Brazil",
			salesforceOpportunityStage = "Qualifying",
			salesforceOpportunityStageDetail = "Attempting to Contact",
			salesforceOpportunityType = "Existing Business");

		Salesforce.createAndViewProject(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceProjectFirstLineSupport = "Yes",
			salesforceProjectLicenseOptionPurchased = "A",
			salesforceProjectLiferayVersion = "6.2 EE",
			salesforceProjectMaximumNumContacts = "2",
			salesforceProjectName = "${salesforceProjectName}",
			salesforceProjectPartnerLevel = "Gold",
			salesforceProjectRecordType = "OEM",
			salesforceProjectSupportCenter = "Americas");

		Salesforce.createAndViewContact(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactCurrency = "${salesforceCurrency}",
			salesforceContactEmail = "${salesforceAccountName}@liferay.com",
			salesforceContactFirstName = "Test",
			salesforceContactLastName = "${salesforceAccountName}",
			salesforceContactMailingCountry = "United States",
			salesforceContactPurchaseDecisionInvolvement = "No involvement",
			salesforceContactTitle = "CEO",
			salesforceContactType = "Legal,Email Business");

		Salesforce.addContactRoleViaOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceContactName = "Test ${salesforceAccountName}",
			salesforceContactRole = "Architect",
			salesforceContactRolePrimary = "true",
			salesforceOpportunityKeyword = "Qualifying");

		Salesforce.assignProjectToOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceProjectName = "${salesforceProjectName}");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/1/2018",
			salesforceProductEndDate = "12/31/2018",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Prorated",
			salesforceProductType = "New");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/1/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Annual Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/2/2018",
			salesforceProductEndDate = "1/1/2019",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Prorated",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/2/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Annual Sales Price",
			salesforceProductItemValue = "10,000.00");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/3/2018",
			salesforceProductEndDate = "1/2/2019",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/3/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Annual Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/4/2018",
			salesforceProductEndDate = "1/3/2019",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/4/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Annual Sales Price",
			salesforceProductItemValue = "10,000.00");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "20,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/5/2018",
			salesforceProductEndDate = "1/4/2019",
			salesforceProductName = "Consulting - Theme",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "One-Time",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/5/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "40,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/6/2018",
			salesforceProductEndDate = "1/5/2019",
			salesforceProductName = "Consulting - Theme",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "30,000.00",
			salesforceProductTermType = "One-Time",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/6/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "10,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/7/2018",
			salesforceProductEndDate = "3/31/2018",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Elastic",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/7/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "40,000.00");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.addProduct(
			salesforcePriceBook = "${salesforcePriceBook}",
			salesforceProductDate = "1/8/2018",
			salesforceProductEndDate = "3/31/2018",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductQuantity = "1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Elastic",
			salesforceProductType = "New");

		SalesforceOpportunity.clickProductLineItem(salesforceProductKeyword = "1/8/2018");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Override",
			salesforceProductItemType = "Checkbox");

		SalesforceProduct.editItem(
			salesforceProductItemLabel = "Sales Price",
			salesforceProductItemValue = "10,000.00");

		Salesforce.addOrderFormViaOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforceOrderFormContactFirstName = "Test",
			salesforceOrderFormContactLastName = "${salesforceAccountName}",
			salesforceOrderFormContractFormat = "Online",
			salesforceOrderFormContractingCountry = "United States",
			salesforceOrderFormDocType = "Order Form",
			salesforceOrderFormLanguage = "English",
			salesforceOrderFormValidThroughDate = "12/31/2018");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Qualifying");

		SalesforceOpportunity.clickOrderForm(salesforceOrderFormKeyword = "Online");

		SalesforceOrderForm.clickOrderFormAttachment(salesforceOpportunityName = "${salesforceOpportunityName}");

		SalesforceOrderForm.viewSubsequentOrderFormAttachmentDetails(
			salesforceOrderFormAttachmentDetailFirst = "Consulting - Theme",
			salesforceOrderFormAttachmentDetailsList = "January 05; 2018,January 04; 2019,1,USD 40;000.00,USD 40;000.00,Consulting - Theme,January 06; 2018,January 05; 2019,1,USD 30;000.00,USD 10;000.00");

		SalesforceOrderForm.viewSubsequentOrderFormAttachmentDetails(
			salesforceOrderFormAttachmentDetailFirst = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceOrderFormAttachmentDetailsList = "January 01; 2018,December 31; 2018,1,USD 20;000.00,USD 20;000.00,Liferay DXP Subscription - Gold Backup Sizing 1,January 02; 2018,January 01; 2019,1,USD 11;750.00,USD 20;000.00,Liferay DXP Subscription - Gold Backup Sizing 1,January 03; 2018,January 02; 2019,1,USD 20;000.00,USD 20;000.00,Liferay DXP Subscription - Gold Backup Sizing 1,January 04; 2018,January 03; 2019,1,USD 11;750.00,USD 20;000.00,Liferay DXP Subscription - Gold Backup Sizing 1,January 07; 2018,March 31; 2018,1,USD 40;000.00,USD 40;000.00,Liferay DXP Subscription - Gold Backup Sizing 1,January 08; 2018,March 31; 2018,1,USD 11;750.00,USD 10;000.00,Total,USD 180;000.00");

		SalesforceOrderForm.viewOrderFormAttachmentDetail(salesforceOrderFormAttachmentDetail = "ORDER FORM");

		SalesforceOrderForm.closeOrderFormAttachment();
	}

	@priority = "5"
	test CreateOrderFormBrazil {
		var salesforceAccountName = "CreateOrderFormBrazil";
		var salesforceAccountOwner = "Sales QA";
		var salesforceCurrency = "USD - U.S. Dollar";
		var salesforceOpportunityName = "${salesforceAccountName}";
		var salesforceOpportunityPartnerTerritoryList = "United States";
		var salesforcePriceBook = "[Current] USD - DXP Subscription and Services";
		var salesforceProductDate = "1/1/2018";
		var salesforceProductEndDate = "12/31/2018";
		var salesforceProjectName = "${salesforceAccountName} Project";

		Salesforce.createAndViewAccount(
			salesforceAccountCurrency = "${salesforceCurrency}",
			salesforceAccountIndustry = "Energy",
			salesforceAccountName = "${salesforceAccountName}",
			salesforceAccountOwner = "${salesforceAccountOwner}",
			salesforceAccountPartnerLevel = "Silver");

		Salesforce.createAndViewOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityCloseDate = "${salesforceProductDate}",
			salesforceOpportunityCurrency = "${salesforceCurrency}",
