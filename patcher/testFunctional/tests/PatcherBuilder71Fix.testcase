@component-name = "patcher-builder"
definition {
	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = "5"
	test RunFixPackBuilderAgentJob {
		var jobName = "fixpack-builder-agent(sandbox-5)";

		Jenkins.startFixPackBuilderAgentJob(
			osbPatcherBaseCommittish = "fix-pack-base-7110",
			osbPatcherCommittish = "LPS-89343_GA1",
			osbPatcherFixIds = "118757428",
			osbPatcherGitRemoteUrl = "git@github.com:CsabaTurcsan/liferay-portal-ee.git",
			osbPatcherPatcherFixId = "118757428",
			osbPatcherProductVersion = "DXP 7.1",
			osbPatcherRebase = "false",
			osbPatcherRepository = "liferay-portal-ee",
			osbPatcherType = "fix",
			patcherFixDeliveryMethod = "Fix Pack 3.0",
			patcherRequestKey = "ff40197637bbd98565730e72f0ba6827091f7a77",
			patcherUserId = "72559402"
		);

		Jenkins.pause(pauseTime = "100000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumber(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "4000000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}
}