@component-name = "patcher-builder"
definition {
	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = "5"
	test RunFixPackBuilderHotFix7xJob {
		var jobName = "fixpack-builder-hotfix-7x";

		Jenkins.startFixPackBuilderHotfix7xJob(
			fixPackCustomerTicket = "LRGROW-72",
			fixPackFixedIssues = "LPE-0",
			fixPackHotfixedIssues = "GROW-110,GROW-13,GROW-446,GROW-498,GROW-508,LPS-79691,LPS-83386,LPS-86575,OWXP-91",
			fixPackId = "234",
			gitRevision = "45fefda2855fff249af69ac468a72101c8902907",
			patcherBuildId = "0123",
			patcherFixDeliveryMethod = "Fix Pack 3.0",
			patcherUserId = "01234"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumber(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "4000000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}

	@priority = "5"
	test RunTestFixPackBuilderInstallJob {
		var jobName = "test-fixpack-builder-install";

		Jenkins.startTestFixPackBuilderInstallJob(
			bundle = "/mnt/mfs-hdd1-172.16.168/ee/portal/7.1.10/liferay-dxp-tomcat-7.1.10-ga1-20180703090613030.zip",
			fixPack = "/mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.1.10/dxp/liferay-fix-pack-dxp-3-7110.zip",
			hotfix = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.1.10/hotfix/liferay-hotfix-012-7110.zip",
			patchingTool = "/mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-2.0.8.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "240000");

		Jenkins.stopJob(jobName = "${jobName}");

		Jenkins.openJenkinsURL();

		Jenkins.gotoConsoleOutput(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.viewInstallConsoleText();
	}

	@priority = "5"
	test RunTestFixPackBuilderPatchDifferenceJob {
		var jobName = "test-fixpack-builder-patch-difference";

		Jenkins.startTestFixPackBuilderPatchDifferenceJob(
			alphaPath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.1.10/hotfix/liferay-hotfix-234-7110-alpha.zip",
			betaPath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.1.10/hotfix/liferay-hotfix-234-7110.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "900000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.openJenkinsURL();

		Jenkins.gotoConsoleOutput(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.viewPatchDifferenceConsoleText();
	}

	@priority = "5"
	test RunTestSmokeTest {
		var jobName = "test-fixpack-builder-main-smoke";

		Jenkins.startTestFixPackBuilderMainSmokeJob(
			gitBranch = "next",
			githubUsername = "liferay"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "120000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}

	@priority = "5"
	test SaveCurrentHotfix {
		var jobName = "test-fixpack-builder-hotfix-copy";

		Jenkins.startTestFixPackBuilderHotfixCopyJob(
			destinationFilePath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.1.10/hotfix/liferay-hotfix-234-7110-alpha.zip",
			originFilePath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.1.10/hotfix/liferay-hotfix-234-7110.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "10000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}
}