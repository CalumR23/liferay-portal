<definition component-name="patcher-builder">
	<property name="testray.main.component.name" value="Patcher Builder" />

	<set-up>
		<execute macro="Jenkins#openJenkinsURL" />
	</set-up>

	<command name="RunFixPackBuilderHotFix7xJob" priority="5">
		<var name="jobName" value="fixpack-builder-hotfix-7x" />

		<execute macro="Jenkins#startFixPackBuilderHotfix7xJob">
			<var name="fixPackCustomerTicket" value="TEST" />
			<var name="fixPackFixedIssues" value="LPE-0" />
			<var name="fixPackHotfixedIssues" value="LPS-72839" />
			<var name="fixPackId" value="012" />
			<var name="gitRevision" value="9ef31c50a9cbb5ab6265ec2f2c7d0b478fdb6dcb" />
			<var name="patcherBuildId" value="0123" />
			<var name="patcherFixDeliveryMethod" value="Fix Pack 3.0" />
			<var name="patcherUserId" value="01234" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#getCurrentJobBuildNumber">
			<var name="jobName" value="${jobName}" />
			<return name="jobBuildNumber" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="4000000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#viewJobStatusSuccess">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>
	</command>

	<command name="RunTestFixPackBuilderInstallJob" priority="5">
		<var name="jobName" value="test-fixpack-builder-install" />

		<execute macro="Jenkins#startTestFixPackBuilderInstallJob">
			<var name="bundle" value="/mnt/mfs-hdd1-172.16.168/ee/portal/7.0.10/liferay-dxp-digital-enterprise-tomcat-7.0-ga1-20160617092557801.zip" />
			<var name="fixPack" value="/mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.0.10/de/liferay-fix-pack-de-16-7010.zip" />
			<var name="hotfix" value="/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip" />
			<var name="patchingTool" value="/mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-2.0.6.zip" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#getCurrentJobBuildNumberForShortJob">
			<var name="jobName" value="${jobName}" />
			<return name="jobBuildNumber" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="240000" />
		</execute>

		<execute macro="Jenkins#stopJob">
			<var name="jobName" value="${jobName}" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#gotoConsoleOutput">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>

		<execute macro="Jenkins#viewInstallConsoleText" />
	</command>

	<command name="RunTestFixPackBuilderPatchDifferenceJob" priority="5">
		<var name="jobName" value="test-fixpack-builder-patch-difference" />

		<execute macro="Jenkins#startTestFixPackBuilderPatchDifferenceJob">
			<var name="alphaPath" value="/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010-alpha.zip" />
			<var name="betaPath" value="/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#getCurrentJobBuildNumberForShortJob">
			<var name="jobName" value="${jobName}" />
			<return name="jobBuildNumber" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="900000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#viewJobStatusSuccess">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#gotoConsoleOutput">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>

		<execute macro="Jenkins#viewPatchDifferenceConsoleText" />
	</command>

	<command name="RunTestSmokeTest" priority="5">
		<var name="jobName" value="test-fixpack-builder-main-smoke" />

		<execute macro="Jenkins#startTestFixPackBuilderMainSmokeJob">
			<var name="gitBranch" value="next" />
			<var name="githubUsername" value="liferay" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#getCurrentJobBuildNumberForShortJob">
			<var name="jobName" value="${jobName}" />
			<return name="jobBuildNumber" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="120000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#viewJobStatusSuccess">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>
	</command>

	<command name="SaveCurrentHotfix" priority="5">
		<var name="jobName" value="test-fixpack-builder-hotfix-copy" />

		<execute macro="Jenkins#startTestFixPackBuilderHotfixCopyJob">
			<var name="destinationFilePath" value="/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010-alpha.zip" />
			<var name="originFilePath" value="/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#getCurrentJobBuildNumberForShortJob">
			<var name="jobName" value="${jobName}" />
			<return name="jobBuildNumber" />
		</execute>

		<execute macro="Jenkins#pause">
			<var name="pauseTime" value="10000" />
		</execute>

		<execute macro="Jenkins#openJenkinsURL" />

		<execute macro="Jenkins#viewJobStatusSuccess">
			<var name="jobBuildNumber" value="${jobBuildNumber}" />
			<var name="jobName" value="${jobName}" />
		</execute>
	</command>
</definition>