@component-name = "patcher-builder"
definition {
	property testray.main.component.name = "Patcher Builder";

	setUp {
		Jenkins.openJenkinsURL();
	}

	@priority = "5"
	test RunFixPackBuilderHotFix7xJob {
		var jobName = "fixpack-builder-hotfix-7x";

		Jenkins.startFixPackBuilderHotfix7xJob(
			fixPackCustomerTicket = "TEST",
			fixPackFixedIssues = "LPE-0",
			fixPackHotfixedIssues = "LPS-72839",
			fixPackId = "012",
			gitRevision = "9ef31c50a9cbb5ab6265ec2f2c7d0b478fdb6dcb",
			patcherBuildId = "0123",
			patcherFixDeliveryMethod = "Fix Pack 3.0",
			patcherUserId = "01234"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumber(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "4000000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}

	@priority = "5"
	test RunTestFixPackBuilderInstallJob {
		var jobName = "test-fixpack-builder-install";

		Jenkins.startTestFixPackBuilderInstallJob(
			bundle = "/mnt/mfs-hdd1-172.16.168/ee/portal/7.0.10/liferay-dxp-digital-enterprise-tomcat-7.0-ga1-20160617092557801.zip",
			fixPack = "/mnt/mfs-hdd1-172.16.168/ee/fix-packs/7.0.10/de/liferay-fix-pack-de-16-7010.zip",
			hotfix = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip",
			patchingTool = "/mnt/mfs-hdd1-172.16.168/ee/fix-packs/patching-tool/patching-tool-2.0.6.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "240000");

		Jenkins.stopJob(jobName = "${jobName}");

		Jenkins.openJenkinsURL();

		Jenkins.gotoConsoleOutput(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.viewInstallConsoleText();
	}

	@priority = "5"
	test RunTestFixPackBuilderPatchDifferenceJob {
		var jobName = "test-fixpack-builder-patch-difference";

		Jenkins.startTestFixPackBuilderPatchDifferenceJob(
			alphaPath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010-alpha.zip",
			betaPath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "900000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.openJenkinsURL();

		Jenkins.gotoConsoleOutput(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);

		Jenkins.viewPatchDifferenceConsoleText();
	}

	@priority = "5"
	test RunTestSmokeTest {
		var jobName = "test-fixpack-builder-main-smoke";

		Jenkins.startTestFixPackBuilderMainSmokeJob(
			gitBranch = "next",
			githubUsername = "liferay"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "120000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}

	@priority = "5"
	test SaveCurrentHotfix {
		var jobName = "test-fixpack-builder-hotfix-copy";

		Jenkins.startTestFixPackBuilderHotfixCopyJob(
			destinationFilePath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder-backup/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010-alpha.zip",
			originFilePath = "/mnt/mfs-hdd1-10.50.0.226/live/opt/java/jenkins/userContent/liferay-fix-pack-builder/fix-packs/7.0.10/hotfix/liferay-hotfix-012-7010.zip"
		);

		Jenkins.pause(pauseTime = "5000");

		Jenkins.openJenkinsURL();

		var jobBuildNumber = Jenkins.getCurrentJobBuildNumberForShortJob(jobName = "${jobName}");

		Jenkins.pause(pauseTime = "10000");

		Jenkins.openJenkinsURL();

		Jenkins.viewJobStatusSuccess(
			jobBuildNumber = "${jobBuildNumber}",
			jobName = "${jobName}"
		);
	}
}