<html>
<head>
<title>Jenkins</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Jenkins</td></tr>
</thead>
<tbody>
<tr>
	<td>JENKINS_VIEW_SELECT</td>
	<td>//select[@id='selectView']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_JOB-->
<tr>
	<td>JENKINS_JOB_STATUS_SUCCESS</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='Success']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_STATUS_FAILED</td>
	<td>//tr[contains(@id,'${jobName}')]//img[@title='Failed']</td>
	<td></td>
</tr>
<tr>
	<td>JENKINS_JOB_HEALTH_LINK</td>
	<td>//tr[contains(@id,'${jobName}')]//a[@class='build-health-link']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--JENKINS_JOB_DETAILS-->
<tr>
	<td>CONSOLE_OUTPUT_LINK</td>
	<td>//a[contains(.,'Console Output')]</td>
	<td></td>
</tr>
<tr>
	<td>STOP_JOB_BUTTON</td>
	<td>//a[@class='stop-button-link']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CONSOLE_OUTPUT-->
<tr>
	<td>CONSOLE_OUTPUT_FULL_LOG_LINK</td>
	<td>//a[contains(.,'Full Log')]</td>
	<td></td>
</tr>
<tr>
	<td>CONSOLE_OUTPUT_TEXT</td>
	<td>//pre[@class='console-output']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>