definition {
	macro executeCurl {
		echo("curl ${curlArgs}");

		var status = JSONCurlUtil.post("${curlArgs}", "$['status']");
	}

	macro startFixPackBuilderHotfix7xJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var jenkinsUrl = PropsUtil.get("jenkins.url");
		var curlArgs = "${jenkinsUrl}/view/All/job/fixpack-builder-hotfix-7x/buildWithParameters?token=${jenkinsAuthenticationToken} -d fix.pack.customer.ticket=${fixPackCustomerTicket} -d fix.pack.fixed.issues=${fixPackFixedIssues} -d fix.pack.hotfixed.issues=${fixPackHotfixedIssues} -d fix.pack.id=${fixPackId} -d git.revision=${gitRevision} -d patcher.build.id=${patcherBuildId} -d patcher.user.id=${patcherUserId}";

		JenkinsJson.executeCurl(curlArgs = "${curlArgs}");
	}

	macro startFixPackBuilderInstallJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var jenkinsUrl = PropsUtil.get("jenkins.url");
		var curlArgs = "${jenkinsUrl}/view/All/job/test-fixpack-builder-install/buildWithParameters?token=${jenkinsAuthenticationToken} -d bundle=${bundle} -d fixPack=${fixPack} -d patchingTool=${patchingTool}";

		JenkinsJson.executeCurl(curlArgs = "${curlArgs}");
	}
}