<definition>
	<command name="executeCurl">
		<echo>curl ${curlArgs}</echo>

		<var method="JSONCurlUtil#post('${curlArgs}', '$[\'status\']')" name="status" />
	</command>

	<command name="startFixPackBuilderHotfix7xJob">
		<var method="PropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="PropsUtil#get('jenkins.url')" name="jenkinsUrl" />

		<var name="curlArgs" value="${jenkinsUrl}/view/All/job/fixpack-builder-hotfix-7x/buildWithParameters?token=${jenkinsAuthenticationToken} -d fix.pack.customer.ticket=${fixPackCustomerTicket} -d fix.pack.fixed.issues=${fixPackFixedIssues} -d fix.pack.hotfixed.issues=${fixPackHotfixedIssues} -d fix.pack.id=${fixPackId} -d git.revision=${gitRevision} -d patcher.build.id=${patcherBuildId} -d patcher.user.id=${patcherUserId}" />

		<execute macro="JenkinsJson#executeCurl">
			<var name="curlArgs" value="${curlArgs}" />
		</execute>
	</command>

	<command name="startFixPackBuilderInstallJob">
		<var method="PropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="PropsUtil#get('jenkins.url')" name="jenkinsUrl" />

		<var name="curlArgs" value="${jenkinsUrl}/view/All/job/test-fixpack-builder-install/buildWithParameters?token=${jenkinsAuthenticationToken} -d bundle=${bundle} -d fixPack=${fixPack} -d patchingTool=${patchingTool}" />

		<execute macro="JenkinsJson#executeCurl">
			<var name="curlArgs" value="${curlArgs}" />
		</execute>
	</command>
</definition>