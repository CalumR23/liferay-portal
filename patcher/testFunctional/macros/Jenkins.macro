<definition>
	<command name="clickConsoleOutputLink">
		<execute function="AssertClick" locator1="Jenkins#CONSOLE_OUTPUT_LINK" value1="Console Output" />
	</command>

	<command name="clickFullLogLink">
		<if>
			<condition function="IsElementPresent" locator1="Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK" />
			<then>
				<execute function="Click" locator1="Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK" />
			</then>
		</if>
	</command>

	<command name="clickJobHealthLink">
		<var name="key_jobName" value="${jobName}" />

		<execute function="Click" locator1="Jenkins#JENKINS_JOB_HEALTH_LINK" />
	</command>

	<command name="clickStopButtonLink">
		<execute function="Click" locator1="Jenkins#STOP_JOB_BUTTON" />
	</command>

	<command name="executeCurl">
		<echo>curl ${curlArgs}</echo>

		<var method="JSONCurlUtil#post('${curlArgs}', '')" name="" />
	</command>

	<command name="gotoConsoleOutput">
		<execute macro="Jenkins#clickJobHealthLink">
			<var name="jobName" value="${jobName}" />
		</execute>

		<execute macro="Jenkins#clickConsoleOutputLink" />
	</command>

	<command name="openJenkinsURL">
		<execute function="Open" locator1="/view/All" />
	</command>

	<command name="pause">
		<execute function="Pause" locator1="${pauseTime}" />
	</command>

	<command name="startFixPackBuilderHotfix7xJob">
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/fixpack-builder-hotfix-7x/buildWithParameters" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken} -d fix.pack.customer.ticket=${fixPackCustomerTicket} -d fix.pack.fixed.issues=${fixPackFixedIssues} -d fix.pack.hotfixed.issues=${fixPackHotfixedIssues} -d fix.pack.id=${fixPackId} -d git.revision=${gitRevision} -d patcher.build.id=${patcherBuildId} -d patcher.user.id=${patcherUserId}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="startTestFixPackBuilderHotfixCopyJob">
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/test-fixpack-builder-hotfix-copy/build" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="startTestFixPackBuilderInstallJob">
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/test-fixpack-builder-install/buildWithParameters" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken} -d bundle=${bundle} -d fixPack=${fixPack} -d hotfix=${hotfix} -d patchingTool=${patchingTool}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="startTestFixPackBuilderMainSmokeJob">
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/test-fixpack-builder-main-smoke/buildWithParameters" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken} -d github.username=${githubUsername} -d git.branch=${gitBranch}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="startTestFixPackBuilderPatchDifferenceJob">
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/test-fixpack-builder-patch-difference/buildWithParameters" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken} -d alphaPath=${alphaPath} -d betaPath=${betaPath}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="stopJob">
		<var method="TestPropsUtil#get('jenkins.admin.user.name')" name="jenkinsAdminUserName" />
		<var method="TestPropsUtil#get('jenkins.admin.user.token')" name="jenkinsAdminUserToken" />
		<var method="TestPropsUtil#get('jenkins.authentication.token')" name="jenkinsAuthenticationToken" />
		<var method="TestPropsUtil#get('portal.url')" name="portalUrl" />

		<var name="curlURL" value="${portalUrl}/view/All/job/${jobName}/lastBuild/stop" />
		<var name="curlURLParameters" value="?token=${jenkinsAuthenticationToken} --user ${jenkinsAdminUserName}:${jenkinsAdminUserToken}" />

		<execute macro="Jenkins#executeCurl">
			<var name="curlArgs" value="${curlURL}${curlURLParameters}" />
		</execute>
	</command>

	<command name="viewConsoleText">
		<execute function="AssertTextEquals#assertPartialText" locator1="Jenkins#CONSOLE_OUTPUT_TEXT" value1="${consoleOutputText}" />
	</command>

	<command name="viewInstallConsoleText">
		<execute macro="Jenkins#clickFullLogLink" />

		<var locator="Jenkins#CONSOLE_OUTPUT_TEXT" name="consoleOutputText" />

		<var method="StringUtil#count('${consoleOutputText}', 'ERROR')" name="errorCount" />

		<echo message="Number of errors: ${errorCount}" />

		<if>
			<not>
				<equals arg1="${fileAddedCount}" arg2="0" />
			</not>
			<then>
				<var method="StringUtil#count('${consoleOutputText}', 'ERROR [localhost-startStop-1][LicenseManager:?] No binary licenses found')" name="acceptableErrorCount" />

				<echo message="Number of acceptable errors: ${acceptableErrorCount}" />

				<if>
					<not>
						<equals arg1="${errorCount}" arg2="${acceptableErrorCount}" />
					</not>
					<then>
						<fail message="Unexpected errors may be present.  The test counted ${errorCount} errors but ${acceptableErrorCount} acceptable errors.  Please check the most recent fix pack install and either apply fixes to the builder or update the test case as needed." />
					</then>
				</if>
			</then>
		</if>

		<execute macro="Jenkins#viewConsoleText">
			<var name="consoleOutputText" value="Server startup in" />
		</execute>
	</command>

	<command name="viewJobStatusSuccess">
		<var name="key_jobName" value="${jobName}" />

		<execute function="AssertElementPresent" locator1="Jenkins#JENKINS_JOB_STATUS_SUCCESS" />
	</command>

	<command name="viewNoConsoleText">
		<execute function="AssertTextNotEquals#assertNotPartialText" locator1="Jenkins#CONSOLE_OUTPUT_TEXT" value1="${consoleOutputText}" />
	</command>

	<command name="viewPatchDifferenceConsoleText">
		<execute macro="Jenkins#clickFullLogLink" />

		<var locator="Jenkins#CONSOLE_OUTPUT_TEXT" name="consoleOutputText" />

		<var method="StringUtil#count('${consoleOutputText}', 'Added:')" name="fileAddedCount" />

		<echo message="Number of files added: ${fileAddedCount}" />

		<if>
			<not>
				<equals arg1="${fileAddedCount}" arg2="0" />
			</not>
			<then>
				<var method="StringUtil#count('${consoleOutputText}', 'Added: binaries/MODULES_BASE_PATH/target-platform/target-platform-indexes')" name="acceptableFileAddedCount" />

				<echo message="Number of acceptable files added: ${acceptableFileAddedCount}" />

				<if>
					<not>
						<equals arg1="${fileAddedCount}" arg2="${acceptableFileAddedCount}" />
					</not>
					<then>
						<fail message="Unexpected files may have been added.  The test counted ${fileAddedCount} added files but ${acceptableFileAddedCount} acceptable added files.  Please check the most recent fix pack comparison and either apply fixes to the builder or update the test case as needed." />
					</then>
				</if>
			</then>
		</if>

		<var method="StringUtil#count('${consoleOutputText}', 'Removed:')" name="fileRemovedCount" />

		<echo message="Number of files removed: ${fileRemovedCount}" />

		<if>
			<not>
				<equals arg1="${fileRemovedCount}" arg2="0" />
			</not>
			<then>
				<var method="StringUtil#count('${consoleOutputText}', 'Removed: binaries/MODULES_BASE_PATH/target-platform/target-platform-indexes')" name="acceptableFileRemovedCount" />

				<echo message="Number of acceptable files removed: ${acceptableFileRemovedCount}" />

				<if>
					<not>
						<equals arg1="${fileRemovedCount}" arg2="${acceptableFileRemovedCount}" />
					</not>
					<then>
						<fail message="Unexpected files may have been removed.  The test counted ${fileRemovedCount} removed files but ${acceptableFileRemovedCount} acceptable removed files.  Please check the most recent fix pack comparison and either apply fixes to the builder or update the test case as needed." />
					</then>
				</if>
			</then>
		</if>

		<execute macro="Jenkins#viewConsoleText">
			<var name="consoleOutputText" value="Modified 81" />
		</execute>

		<execute macro="Jenkins#viewNoConsoleText">
			<var name="consoleOutputText" value="-Liferay-Portal-Server-Info: Liferay DXP Digital Enterprise" />
		</execute>

		<execute macro="Jenkins#viewNoConsoleText">
			<var name="consoleOutputText" value="+Liferay-Portal-Server-Info: Liferay Community Edition Portal" />
		</execute>
	</command>
</definition>