definition {
	macro clickConsoleOutputLink {
		AssertClick(locator1 = "Jenkins#CONSOLE_OUTPUT_LINK", value1 = "Console Output");
	}

	macro clickFullLogLink {
		if (IsElementPresent(locator1 = "Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK")) {
			Click(locator1 = "Jenkins#CONSOLE_OUTPUT_FULL_LOG_LINK");
		}
	}

	macro clickJobHealthLink {
		var key_jobName = "${jobName}";

		Click(locator1 = "Jenkins#JENKINS_JOB_HEALTH_LINK");
	}

	macro clickJobLink {
		var key_jobName = "${jobName}";

		Click(locator1 = "Jenkins#JENKINS_JOB_LINK");
	}

	macro clickStopButtonLink {
		Click(locator1 = "Jenkins#STOP_JOB_BUTTON");
	}

	macro executeCurl {
		com.liferay.poshi.runner.util.JSONCurlUtil.post("${curlArgs}");
	}

	macro getCurrentJobBuildNumber {
		Jenkins.clickJobLink(jobName = "${jobName}");

		AssertElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		AssertVisible(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		var jobBuildNumber = selenium.getText("Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

		return "${jobBuildNumber}";
	}

	macro getCurrentJobBuildNumberForShortJob {
		Jenkins.clickJobLink(jobName = "${jobName}");

		if (IsElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER")) {
			AssertElementPresent(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

			AssertVisible(locator1 = "Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");

			var jobBuildNumber = selenium.getText("Jenkins#CURRENT_JENKINS_JOB_BUILD_NUMBER");
		}
		else {
			AssertElementPresent(locator1 = "Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");

			AssertVisible(locator1 = "Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");

			var jobBuildNumber = selenium.getText("Jenkins#MOST_RECENT_JENKINS_JOB_BUILD_NUMBER");
		}

		return "${jobBuildNumber}";
	}

	macro gotoConsoleOutput {
		var key_jobBuildNumber = "${jobBuildNumber}";

		Jenkins.clickJobLink(jobName = "${jobName}");

		Click(locator1 = "Jenkins#JENKINS_JOB_BUILD_LINK");

		Jenkins.clickConsoleOutputLink();
	}

	macro openJenkinsURL {
		Open(locator1 = "/view/All");
	}

	macro pause {
		Pause(locator1 = "${pauseTime}");
	}

	macro startFixPackBuilderAgentJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/fixpack-builder-agent(sandbox-5)/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[osb.patcher.baseCommittish=${osbPatcherBaseCommittish}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.committish=${osbPatcherCommittish}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.fixIds=${osbPatcherFixIds}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.gitRemoteURL=${osbPatcherGitRemoteUrl}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.patcherFixId=${osbPatcherPatcherFixId}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.productVersion=${osbPatcherProductVersion}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.rebase=${osbPatcherRebase}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.repository=${osbPatcherRepository}]CURL_DATA&gt; -d &lt;CURL_DATA[osb.patcher.type=${osbPatcherType}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.fix.delivery.method=${patcherFixDeliveryMethod}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.request.key=${patcherRequestKey}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.user.id=${patcherUserId}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro startFixPackBuilderHotfix7xJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/fixpack-builder-hotfix-7x/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[fix.pack.customer.ticket=${fixPackCustomerTicket}]CURL_DATA&gt; -d &lt;CURL_DATA[fix.pack.fixed.issues=${fixPackFixedIssues}]CURL_DATA&gt; -d &lt;CURL_DATA[fix.pack.hotfixed.issues=${fixPackHotfixedIssues}]CURL_DATA&gt; -d &lt;CURL_DATA[fix.pack.id=${fixPackId}]CURL_DATA&gt; -d &lt;CURL_DATA[git.revision=${gitRevision}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.build.id=${patcherBuildId}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.user.id=${patcherUserId}]CURL_DATA&gt; -d &lt;CURL_DATA[patcher.fix.delivery.method=${patcherFixDeliveryMethod}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro startTestFixPackBuilderHotfixCopyJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/test-fixpack-builder-hotfix-copy/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[originFilePath=${originFilePath}]CURL_DATA&gt; -d &lt;CURL_DATA[destinationFilePath=${destinationFilePath}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro startTestFixPackBuilderInstallJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/test-fixpack-builder-install/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[bundle=${bundle}]CURL_DATA&gt; -d &lt;CURL_DATA[fixPack=${fixPack}]CURL_DATA&gt; -d &lt;CURL_DATA[hotfix=${hotfix}]CURL_DATA&gt; -d &lt;CURL_DATA[patchingTool=${patchingTool}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro startTestFixPackBuilderMainSmokeJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/test-fixpack-builder-main-smoke/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[github.username=${githubUsername}]CURL_DATA&gt; -d &lt;CURL_DATA[git.branch=${gitBranch}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro startTestFixPackBuilderPatchDifferenceJob {
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/test-fixpack-builder-patch-difference/buildWithParameters";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} -d &lt;CURL_DATA[alphaPath=${alphaPath}]CURL_DATA&gt; -d &lt;CURL_DATA[betaPath=${betaPath}]CURL_DATA&gt;";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro stopJob {
		var jenkinsAdminUserName = PropsUtil.get("jenkins.admin.user.name");
		var jenkinsAdminUserToken = PropsUtil.get("jenkins.admin.user.token");
		var jenkinsAuthenticationToken = PropsUtil.get("jenkins.authentication.token");
		var portalUrl = PropsUtil.get("portal.url");
		var curlURL = "${portalUrl}/view/All/job/${jobName}/lastBuild/stop";
		var curlURLParameters = "?token=${jenkinsAuthenticationToken} --user ${jenkinsAdminUserName}:${jenkinsAdminUserToken}";

		Jenkins.executeCurl(curlArgs = "${curlURL}${curlURLParameters}");
	}

	macro viewConsoleText {
		AssertTextEquals.assertPartialText(
			locator1 = "Jenkins#CONSOLE_OUTPUT_TEXT",
			value1 = "${consoleOutputText}"
		);
	}

	macro viewInstallConsoleText {
		Jenkins.clickFullLogLink();

		var consoleOutputText = selenium.getText("Jenkins#CONSOLE_OUTPUT_TEXT");
		var errorCount = StringUtil.count("${consoleOutputText}", "ERROR");

		echo("Number of errors: ${errorCount}");

		if (!("${fileAddedCount}" == "0")) {
			var acceptableErrorCount = StringUtil.count("${consoleOutputText}", "ERROR [localhost-startStop-1][LicenseManager:?] No binary licenses found");

			echo("Number of acceptable errors: ${acceptableErrorCount}");

			if (!("${errorCount}" == "${acceptableErrorCount}")) {
				fail("Unexpected errors may be present.  The test counted ${errorCount} errors but ${acceptableErrorCount} acceptable errors.  Please check the most recent fix pack install and either apply fixes to the builder or update the test case as needed.");
			}
		}

		Jenkins.viewConsoleText(consoleOutputText = "Server startup in");
	}

	macro viewJobStatusSuccess {
		var key_jobBuildNumber = "${jobBuildNumber}";

		Jenkins.clickJobLink(jobName = "${jobName}");

		AssertElementPresent(locator1 = "Jenkins#JENKINS_JOB_BUILD_STATUS_SUCCESS");
	}

	macro viewNoConsoleText {
		AssertTextNotEquals.assertNotPartialText(
			locator1 = "Jenkins#CONSOLE_OUTPUT_TEXT",
			value1 = "${consoleOutputText}"
		);
	}

	macro viewPatchDifferenceConsoleText {
		Jenkins.clickFullLogLink();

		var consoleOutputText = selenium.getText("Jenkins#CONSOLE_OUTPUT_TEXT");
		var fileAddedCount = StringUtil.count("${consoleOutputText}", "Added:");

		echo("Number of files added: ${fileAddedCount}");

		if (!("${fileAddedCount}" == "0")) {
			var acceptableFileAddedCount = StringUtil.count("${consoleOutputText}", "Added: binaries/MODULES_BASE_PATH/target-platform/target-platform-indexes");

			echo("Number of acceptable files added: ${acceptableFileAddedCount}");

			if (!("${fileAddedCount}" == "${acceptableFileAddedCount}")) {
				fail("Unexpected files may have been added.  The test counted ${fileAddedCount} added files but ${acceptableFileAddedCount} acceptable added files.  Please check the most recent fix pack comparison and either apply fixes to the builder or update the test case as needed.");
			}
		}

		var fileRemovedCount = StringUtil.count("${consoleOutputText}", "Removed:");

		echo("Number of files removed: ${fileRemovedCount}");

		if (!("${fileRemovedCount}" == "0")) {
			var acceptableFileRemovedCount = StringUtil.count("${consoleOutputText}", "Removed: binaries/MODULES_BASE_PATH/target-platform/target-platform-indexes");

			echo("Number of acceptable files removed: ${acceptableFileRemovedCount}");

			if (!("${fileRemovedCount}" == "${acceptableFileRemovedCount}")) {
				fail("Unexpected files may have been removed.  The test counted ${fileRemovedCount} removed files but ${acceptableFileRemovedCount} acceptable removed files.  Please check the most recent fix pack comparison and either apply fixes to the builder or update the test case as needed.");
			}
		}

		Jenkins.viewConsoleText(consoleOutputText = "Modified 79");

		Jenkins.viewNoConsoleText(
			consoleOutputText = "-Liferay-Portal-Server-Info: Liferay DXP Digital Enterprise"
		);

		Jenkins.viewNoConsoleText(
			consoleOutputText = "+Liferay-Portal-Server-Info: Liferay Community Edition Portal"
		);
	}
}