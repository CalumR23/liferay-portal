<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />
	</set-up>

	<command name="ViewCompanyFooterLinks" priority="5">
		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Company" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Our Story" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoHome" />

		<for list="Press Releases,Careers,Locations" param="footerTitle">
			<execute macro="LRDCOMFooter#gotoFooterLink">
				<var name="linkName" value="${footerTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="${footerTitle}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoHome" />
		</for>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Newsletter Sign Up" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_1" value1="Sign up for Liferay News" />
	</command>

	<command name="ViewContactUsFooterLink" priority="5">
		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Contact Us" />
		</execute>

		<execute function="AssertTextEquals" locator1="LRDCOM#HEADING_1" value1="How can we help?" />
	</command>

	<command name="ViewGartnerReportPage" priority="5">
		<var name="key_title" value="Magic Quadrant" />
		<var name="title" value="Magic Quadrant" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_LEGO" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<execute function="AssertClick" locator1="LRDCOMLink#READ_THE_REPORT" value1="Read the Report" />

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="${title}" />
		</execute>
	</command>

	<command name="ViewIndustryIconPageLinks" priority="5">
		<for list="banking,healthcare,government,retail,manufacturing,insurance" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoHome" />

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<var method="StringUtil#upperCase('${iconTitle}')" name="iconTitle" />

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="Solutions" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>
	</command>

	<command name="ViewLearnMoreAboutLiferayDXPLink" priority="5">
		<var name="key_link" value="Learn more about Liferay DXP" />
		<var name="linkName" value="Learn more about Liferay DXP" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Product Overview" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />
	</command>

	<command name="ViewMainBannerContentLink" priority="5">
		<var name="bannerContent" value="Transform your whole enterprise." />
		<var name="key_bannerContent" value="Transform your whole enterprise." />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOM#MAIN_BANNER_CONTENT" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#MAIN_BANNER_CONTENT" value1="${bannerContent}" />

		<var name="bannerContent" value="Liferay’s software helps you develop great" />
		<var name="key_bannerContent" value="Liferay’s software helps you develop great" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#MAIN_BANNER_CONTENT" value1="${bannerContent}" />

		<var name="key_link" value="This Is How We Do It" />
		<var name="linkName" value="This Is How We Do It" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Product Overview" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />
	</command>

	<command name="ViewPlatformFooterLinks" priority="5">
		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Platform" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Case Studies and Docs" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_GARTNER" value1="Magic Quadrant" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Request a Demo" />
		</execute>

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#HEADING_1" value1="Request a Demo" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Marketplace Apps" />
		</execute>

		<execute function="AssertVisible" locator1="Marketplace#MARKETPLACE_BANNER" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Downloads" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Downloads" />
		</execute>
	</command>

	<command name="ViewPrivacyPolicy" priority="4">
		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" value1="Privacy Policy" />

		<execute function="AssertTextEquals" locator1="LRDCOM#HEADING_1" value1="Privacy Policy" />
	</command>

	<command name="ViewSocialIcons" priority="4">
		<var method="selenium#getTitle()" name="lrdcomWindowTitle" />

		<!-- Will include facebook icon view after jenkins or liferay facebook site has been fixed with updated firefox browser version

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Facebook" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay - Home | Facebook" />
		</execute>
		-->

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="GitHub" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay Inc. · GitHub" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Instagram" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay, Inc. (@liferayinc) • Instagram photos and videos" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="LinkedIn" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay, Inc | LinkedIn" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Twitter" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay (@Liferay) | Twitter" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="YouTube" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay - YouTube - YouTube" />
		</execute>
	</command>

	<command name="ViewSolutionsIconPageLinks" priority="5">
		<for list="A More Personal Portal,Create,Intranets" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoHome" />
		</for>

		<execute macro="LRDCOMNavigation#gotoIcon">
			<var name="iconTitle" value="mobile" />
		</execute>

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="Mobile Strategy" />
		</execute>
	</command>

	<command name="ViewSuccessStoriesPage" priority="5">
		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR" />

		<execute function="MouseOver" locator1="LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR" />

		<execute function="AssertVisible" locator1="LRDCOMButton#SEE_SUCCESS_STORIES" value1="See Success Stories" />

		<execute function="AssertClick" locator1="LRDCOMButton#SEE_SUCCESS_STORIES" value1="See Success Stories" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_GARTNER" value1="Magic Quadrant">
			<var name="key_title" value="Magic Quadrant" />
			<var name="title" value="Magic Quadrant" />
		</execute>
	</command>

	<command name="ViewYouMightBeInterestedInLinks" priority="5">
		<for list="What Is Digital Transformation?,What Is Digital Customer Experience?,What Is a Digital Experience Platform?" param="title">
			<execute macro="LRDCOMNavigation#gotoHome" />

			<execute macro="LRDCOMViewLink#viewBlogLink">
				<var name="title" value="${title}" />
			</execute>
		</for>
	</command>
</definition>