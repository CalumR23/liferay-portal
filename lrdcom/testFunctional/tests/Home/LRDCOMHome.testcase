<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />
	</set-up>

	<command name="UserSignInAndOut" priority="5">
		<execute macro="LRDCOMUser#signIn">
			<var method="TestPropsUtil#get('lrdcom.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('lrdcom.email.password.2')" name="userPassword" />
		</execute>

		<execute macro="LRDCOMUser#signOut" />
	</command>

	<command name="ViewCompanyFooterLinks" priority="3">
		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Press Releases" />
		</execute>

		<execute function="AssertTextEquals" locator1="LRDCOMArticle#ARTICLE_H1" value1="Press Releases" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Careers" />
		</execute>

		<execute function="AssertTextEquals" locator1="LRDCOMArticle#ARTICLE_H1" value1="Love life? So say we all." />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Locations" />
		</execute>

		<execute function="AssertVisible" locator1="LRDCOMArticle#ARTICLE_MAP" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Newsletter Sign Up" />
		</execute>

		<execute function="AssertTextEquals" locator1="LRDCOMArticle#ARTICLE_H1" value1="Sign up for Liferay News" />
	</command>

	<command name="ViewContactUsFooterLink" priority="3">
		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Contact Us" />
		</execute>

		<var name="key_articleTitle" value="How can we help?" />

		<execute function="AssertTextEquals" locator1="LRDCOMArticle#ARTICLE_H1" value1="How can we help?" />
	</command>

	<command name="ViewGartnerReportPage" priority="3">
		<var name="key_title" value="Magic Quadrant" />
		<var name="title" value="Magic Quadrant" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_LEGO" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<execute function="AssertClick" locator1="LRDCOMLink#READ_THE_REPORT" value1="Read the Report" />

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="${title}" />
		</execute>

		<var method="TestPropsUtil#get('lrdcom.email.address.2')" name="userEmailAddress" />

		<execute function="Type" locator1="LRDCOMTextInput#FIRST_NAME_2" value1="Test" />

		<execute function="Type" locator1="LRDCOMTextInput#LAST_NAME_2" value1="Test" />

		<execute function="Type" locator1="LRDCOMTextInput#WORK_EMAIL_2" value1="${userEmailAddress}" />

		<var method="MathUtil#randomNumber(242)" name="optionIndex" />
		<var method="MathUtil#sum(${optionIndex}, 1)" name="optionIndex" />

		<echo message="Option index number is: ${optionIndex}" />

		<var method="selenium#getAttribute('xpath=(//div//label[contains(.,\'Country\')]/following-sibling::select)[2]/option[${optionIndex}]@value')" name="countryName" />

		<echo message="Country name selected is: ${countryName}" />

		<execute function="Select" locator1="LRDCOMSelect#COUNTRY_2" value1="${countryName}" />

		<execute function="Click" locator1="Button#SUBMIT_2" />

		<execute function="SelectWindow#selectPopUp" locator1="null" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#DOCUMENT_TITLE_H1" value1="Magic Quadrant" />
	</command>

	<command name="ViewIndustryIconPageLinks" priority="3">
		<for list="banking,healthcare,government,retail,manufacturing,insurance" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoHome" />

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<var method="StringUtil#upperCase('${iconTitle}')" name="iconTitle" />

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="Solutions" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>
	</command>

	<command name="ViewLearnMoreAboutLiferayDXPLink" priority="3">
		<var name="key_link" value="Learn more about Liferay DXP" />
		<var name="linkName" value="Learn more about Liferay DXP" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />
	</command>

	<command name="ViewMainBannerLink" priority="3">
		<var name="key_link" value="Learn more" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_CTA" value1="Learn more" />

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Product Overview" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />
	</command>

	<command name="ViewPlatformFooterLinks" priority="3">
		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Resource Library" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_GARTNER" value1="Magic Quadrant" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Request a Demo" />
		</execute>

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#BRAND_CAMPAIGN_FORM_H3" value1="Request a Demo" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Marketplace Apps" />
		</execute>

		<execute function="AssertVisible" locator1="Marketplace#MARKETPLACE_BANNER" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Downloads" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Downloads" />
		</execute>
	</command>

	<command name="ViewPrivacyPolicy" priority="2">
		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" value1="Privacy Policy" />

		<execute function="AssertTextEquals" locator1="LRDCOM#HEADING_H1" value1="Privacy Policy" />
	</command>

	<command name="ViewSocialIcons" priority="3">
		<!-- Will include facebook icon view after jenkins or liferay facebook site has been fixed with updated firefox browser version

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Facebook" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay - Home | Facebook" />
		</execute>
		-->

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="GitHub" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Instagram" />
			<var name="socialWindowTitle" value="Liferay, Inc" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Twitter" />
		</execute>

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="YouTube" />
		</execute>

		<execute macro="LRDCOMFooter#clickSocialIcon">
			<var name="iconTitle" value="LinkedIn" />
		</execute>

		<execute function="Pause" locator1="10000" />

		<execute function="SelectWindow#selectPopUp" locator1="null" />

		<execute macro="LRDCOMFooter#viewLiferayLinkedInWindow" />
	</command>

	<command name="ViewSolutionsIconPageLinks" priority="3">
		<for list="Portal,Create,Intranet" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoHome" />
		</for>

		<execute macro="LRDCOMNavigation#gotoIcon">
			<var name="iconTitle" value="mobile" />
		</execute>

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="Mobile Strategy" />
		</execute>
	</command>

	<command name="ViewSuccessStoriesPage" priority="3">
		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR" />

		<execute function="MouseOver" locator1="LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR" />

		<execute function="AssertVisible" locator1="LRDCOMButton#SEE_SUCCESS_STORIES" value1="See Success Stories" />

		<execute function="AssertClick" locator1="LRDCOMButton#SEE_SUCCESS_STORIES" value1="See Success Stories" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_GARTNER" value1="Magic Quadrant">
			<var name="key_title" value="Magic Quadrant" />
			<var name="title" value="Magic Quadrant" />
		</execute>
	</command>

	<command name="ViewYouMightBeInterestedInLinks" priority="3">
		<for list="What is Digital Transformation?,What is Digital Customer Experience?,What is a Digital Experience Platform?" param="title">
			<execute macro="LRDCOMNavigation#gotoHome" />

			<execute macro="LRDCOMArticle#viewBlogEntry">
				<var name="title" value="${title}" />
			</execute>
		</for>
	</command>
</definition>