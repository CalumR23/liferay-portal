@component-name = "lrdcom"
definition {

	property testray.main.component.name = "lrdcom-www";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();
	}

	@priority = "5"
	test UserSignInAndOut {
		LRDCOMUser.signIn(
			userEmailAddress = PropsUtil.get("lrdcom.email.address.2"),
			userPassword = PropsUtil.get("lrdcom.email.password.2"));

		LRDCOMUser.signOut();
	}

	@priority = "3"
	test ViewCompanyFooterLinks {
		LRDCOMNavigation.gotoFooterLink(linkName = "Press Releases");

		AssertTextEquals(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "Press Releases");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Careers");

		AssertTextEquals(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "Love life? So say we all.");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Locations");

		AssertVisible(locator1 = "LRDCOMArticle#ARTICLE_MAP");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Newsletter Sign Up");

		AssertTextEquals(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "Sign up for Liferay News");
	}

	@priority = "3"
	test ViewContactUsFooterLink {
		LRDCOMNavigation.gotoFooterLink(linkName = "Contact Us");

		var key_articleTitle = "How can we help?";

		AssertTextEquals(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "How can we help?");
	}

	@priority = "3"
	test ViewGartnerReportPage {
		var key_title = "Magic Quadrant";
		var title = "Magic Quadrant";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		AssertClick(
			locator1 = "LRDCOMLink#READ_THE_REPORT",
			value1 = "Read the Report");

		LRDCOMPage.viewBannerContent(bannerContent = "${title}");

		var userEmailAddress = PropsUtil.get("lrdcom.email.address.2");

		Type(
			locator1 = "LRDCOMTextInput#FIRST_NAME_2",
			value1 = "Test");

		Type(
			locator1 = "LRDCOMTextInput#LAST_NAME_2",
			value1 = "Test");

		Type(
			locator1 = "LRDCOMTextInput#WORK_EMAIL_2",
			value1 = "${userEmailAddress}");

		var optionIndex = MathUtil.randomNumber("242");

		var optionIndex = ${optionIndex} + 1;

		echo("Option index number is: ${optionIndex}");

		var countryName = selenium.getAttribute("xpath=(//div//label[contains(.,'Country')]/following-sibling::select)[2]/option[${optionIndex}]@value");

		echo("Country name selected is: ${countryName}");

		Select(
			locator1 = "LRDCOMSelect#COUNTRY_2",
			value1 = "${countryName}");

		Click(locator1 = "Button#SUBMIT_2");

		SelectWindow.selectPopUp(locator1 = "null");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#DOCUMENT_TITLE_H1",
			value1 = "Magic Quadrant");
	}

	@priority = "3"
	test ViewIndustryIconPageLinks {
		for (var iconTitle : list "banking,healthcare,government,retail,manufacturing,insurance") {
			LRDCOMNavigation.gotoHome();

			LRDCOMNavigation.gotoIcon(iconTitle = "${iconTitle}");

			var iconTitle = StringUtil.upperCase("${iconTitle}");

			LRDCOMPage.viewActivePage(pageName = "Solutions");

			LRDCOMPage.viewBannerContent(bannerContent = "${iconTitle}");
		}
	}

	@priority = "3"
	test ViewLearnMoreAboutLiferayDXPLink {
		var key_link = "Learn more about Liferay DXP";
		var linkName = "Learn more about Liferay DXP";

		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA");

		AssertClick.assertTextClickAt(
			locator1 = "LRDCOMLink#LINK_CTA",
			value1 = "${linkName}");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_LIFERAY_DXP",
			value1 = "Platform");
	}

	@priority = "3"
	test ViewMainBannerLink {
		var key_link = "Learn more";

		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA");

		AssertClick.assertTextClickAt(
			locator1 = "LRDCOMLink#LINK_CTA",
			value1 = "Learn more");

		LRDCOMPage.viewActivePage(pageName = "Product Overview");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_LIFERAY_DXP",
			value1 = "Platform");
	}

	@priority = "3"
	test ViewPlatformFooterLinks {
		LRDCOMNavigation.gotoFooterLink(linkName = "Resource Library");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_GARTNER",
			value1 = "Magic Quadrant");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Subscription Services");

		LRDCOMPage.viewActivePage(pageName = "Subscription Services");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Request a Demo");

		AssertTextEquals.assertText(
			locator1 = "LRDCOM#BRAND_CAMPAIGN_FORM_H3",
			value1 = "Request a Demo");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Marketplace Apps");

		AssertVisible(locator1 = "Marketplace#MARKETPLACE_BANNER");

		LRDCOMNavigation.gotoHome();

		LRDCOMNavigation.gotoFooterLink(linkName = "Downloads");

		LRDCOMPage.viewActivePage(pageName = "Downloads");
	}

	@priority = "2"
	test ViewPrivacyPolicy {
		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_PRIVACY_POLICY");

		AssertClick.assertTextClickAt(
			locator1 = "LRDCOMLink#LINK_PRIVACY_POLICY",
			value1 = "Privacy Policy");

		AssertTextEquals(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Privacy Policy");
	}

	@priority = "3"
	test ViewSocialIcons {
		/* Will include facebook icon view after jenkins or liferay facebook site has been fixed with updated firefox browser version

		<execute macro="LRDCOMFooter#viewSocialIconLinkWindow">
			<var name="iconTitle" value="Facebook" />
			<var name="lrdcomWindowTitle" value="${lrdcomWindowTitle}" />
			<var name="socialWindowTitle" value="Liferay - Home | Facebook" />
		</execute>
		*/

		LRDCOMFooter.viewSocialIconLinkWindow(iconTitle = "GitHub");

		LRDCOMFooter.viewSocialIconLinkWindow(
			iconTitle = "Instagram",
			socialWindowTitle = "Liferay, Inc");

		LRDCOMFooter.viewSocialIconLinkWindow(iconTitle = "Twitter");

		LRDCOMFooter.viewSocialIconLinkWindow(iconTitle = "YouTube");

		LRDCOMFooter.clickSocialIcon(iconTitle = "LinkedIn");

		Pause(locator1 = "10000");

		SelectWindow.selectPopUp(locator1 = "null");

		LRDCOMFooter.viewLiferayLinkedInWindow();
	}

	@priority = "3"
	test ViewSolutionsIconPageLinks {
		for (var iconTitle : list "Portal,Create,Intranet") {
			LRDCOMNavigation.gotoIcon(iconTitle = "${iconTitle}");

			LRDCOMPage.viewBannerContent(bannerContent = "${iconTitle}");

			LRDCOMNavigation.gotoHome();
		}

		LRDCOMNavigation.gotoIcon(iconTitle = "mobile");

		LRDCOMPage.viewBannerContent(bannerContent = "Mobile Strategy");
	}

	@priority = "3"
	test ViewSuccessStoriesPage {
		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR");

		MouseOver(locator1 = "LRDCOMBlockContainer#BLOCK_SECTION_NO_BLUR");

		AssertVisible(
			locator1 = "LRDCOMButton#SEE_SUCCESS_STORIES",
			value1 = "See Success Stories");

		AssertClick(
			locator1 = "LRDCOMButton#SEE_SUCCESS_STORIES",
			value1 = "See Success Stories");

		AssertTextEquals.assertPartialText(
			key_title = "Magic Quadrant",
			locator1 = "LRDCOM#HEADING_GARTNER",
			title = "Magic Quadrant",
			value1 = "Magic Quadrant");
	}

	@priority = "3"
	test ViewYouMightBeInterestedInLinks {
		for (var title : list "What is Digital Transformation?,What is Digital Customer Experience?,What is a Digital Experience Platform?") {
			LRDCOMNavigation.gotoHome();

			LRDCOMArticle.viewBlogEntry(title = "${title}");
		}
	}

}