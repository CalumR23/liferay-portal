@component-name = "lrdcom"
definition {

	property testray.main.component.name = "lrdcom-www";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();
	}

	@priority = "5"
	test RequestADemoForm {
		LRDCOMNavigation.gotoFooterLink(linkName = "Request a Demo");

		AssertTextEquals.assertText(
			locator1 = "LRDCOM#BRAND_CAMPAIGN_FORM_H3",
			value1 = "Request a Demo");

		LRDCOMForms.submitRequestADemo(
			userCompany = "Liferay",
			userCountry = "United States",
			userEmailAddress = PropsUtil.get("lrdcom.email.address.2"),
			userFirstName = "Liferay",
			userLastName = "QA",
			userPhone = "555-555-5555",
			userStateProvince = "California");

		WaitForSPARefresh();

		AssertTextEquals.assertText(
			locator1 = "LRDCOM#BRAND_CAMPAIGN_FORM_H4",
			value1 = "Your request for a demo has been sent!");
	}

	@priority = "5"
	test SubmitWhitepaperForm {
		LRDCOMNavigation.gotoPage(
			childPageName = "Resource Library",
			pageName = "Resources");

		LRDCOMFilter.selectFilter(
			categoryName = "Technical Whitepapers",
			vocabularyName = "Resource Types");

		var key_entryNumber = "1";

		ScrollWebElementIntoView(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		Click(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		var windowTitle1 = selenium.getTitle();

		LRDCOMForms.submitWhitepaperForm(
			numberOfEmployees = "51 - 1,000",
			userCompany = "Liferay",
			userCountry = "United States",
			userEmailAddress = PropsUtil.get("lrdcom.email.address.2"),
			userFirstName = "Liferay",
			userJobRole = "Other",
			userLastName = "QA",
			userStateProvince = "California",
			userWhoAmI = "Other");

		WaitForSPARefresh();

		SelectWindow.selectPopUp(locator1 = "null");

		var windowTitle2 = selenium.getTitle();

		if ("${windowTitle1}" == "${windowTitle2}") {
			fail("Unexpected errors may be present.  Expected form submission to display window pop up to view whitepaper, and instead no new window is visible.");
		}
		else {
			AssertElementNotPresent(locator1 = "LRDCOM#ERROR_PAGE");
		}
	}

	@priority = "5"
	test VerifyContactSalesFormSmoke {
		AssertClick(
			locator1 = "LRDCOMButton#CONTACT_SALES_BUTTON",
			value1 = "Contact Sales");

		AssertVisible(
			locator1 = "LRDCOMTextInput#CONTACT_SALES_COMMENTS",
			value1 = "Contact Sales");

		AssertVisible(
			locator1 = "Button#SUBMIT",
			value1 = "Contact Sales");

		Click(locator1 = "LRDCOMButton#CLOSE_BUTTON");
	}

}