<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />
	</set-up>

	<command name="RequestADemoForm" priority="5">
		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Request a Demo" />
		</execute>

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#HEADING_H1" value1="Request a Demo" />

		<execute macro="LRDCOMForms#submitRequestADemo">
			<var name="userCompany" value="Liferay" />
			<var name="userCountry" value="Afghanistan" />
			<var method="TestPropsUtil#get('lrdcom.email.address.2')" name="userEmailAddress" />
			<var name="userFirstName" value="Liferay" />
			<var name="userLastName" value="QA" />
			<var name="userPhone" value="555-555-5555" />
		</execute>

		<execute function="WaitForSPARefresh" />

		<var method="selenium#getTitle()" name="windowTitle" />

		<if>
			<not>
				<equals arg1="${windowTitle}" arg2="Thank you for your interest | Liferay" />
			</not>
			<then>
				<fail message="Unexpected errors may be present.  Expected form submission to redirect to window with title &quot;Thank you for your interest | Liferay&quot; and instead got &quot;${windowTitle}&quot;" />
			</then>
		</if>
	</command>
</definition>