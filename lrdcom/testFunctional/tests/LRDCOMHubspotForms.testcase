<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />
	</set-up>

	<command name="RequestADemoForm" priority="5">
		<execute macro="LRDCOMNavigation#gotoFooterLink">
			<var name="linkName" value="Request a Demo" />
		</execute>

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#BRAND_CAMPAIGN_FORM_H3" value1="Request a Demo" />

		<execute macro="LRDCOMForms#submitRequestADemo">
			<var name="userCompany" value="Liferay" />
			<var name="userCountry" value="Afghanistan" />
			<var method="TestPropsUtil#get('lrdcom.email.address.2')" name="userEmailAddress" />
			<var name="userFirstName" value="Liferay" />
			<var name="userLastName" value="QA" />
			<var name="userPhone" value="555-555-5555" />
		</execute>

		<execute function="WaitForSPARefresh" />

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#BRAND_CAMPAIGN_FORM_H4" value1="Your request for a demo has been sent!" />
	</command>

	<command name="SubmitWhitepaperForm" priority="5">
		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="Resource Library" />
			<var name="pageName" value="Resources" />
		</execute>

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Technical Whitepapers" />
			<var name="vocabularyName" value="Resource Types" />
		</execute>

		<var name="key_entryNumber" value="1" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<execute function="Click" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<var method="selenium#getTitle()" name="windowTitle1" />

		<execute macro="LRDCOMForms#submitWhitepaperForm">
			<var name="numberOfEmployees" value="51 - 1,000" />
			<var name="userCompany" value="Liferay" />
			<var name="userCountry" value="Afghanistan" />
			<var method="TestPropsUtil#get('lrdcom.email.address.2')" name="userEmailAddress" />
			<var name="userFirstName" value="Liferay" />
			<var name="userJobRole" value="Other" />
			<var name="userLastName" value="QA" />
			<var name="userWhoAmI" value="Other" />
		</execute>

		<execute function="WaitForSPARefresh" />

		<execute function="SelectWindow#selectPopUp" locator1="null" />

		<var method="selenium#getTitle()" name="windowTitle2" />

		<if>
			<equals arg1="${windowTitle1}" arg2="${windowTitle2}" />
			<then>
				<fail message="Unexpected errors may be present.  Expected form submission to display window pop up to view whitepaper, and instead no new window is visible." />
			</then>
			<else>
				<execute function="AssertElementNotPresent" locator1="LRDCOM#ERROR_PAGE" />
			</else>
		</if>
	</command>

	<command name="VerifyContactSalesFormSmoke" priority="5">
		<execute function="AssertClick" locator1="LRDCOMButton#CONTACT_SALES_BUTTON" value1="Contact Sales" />

		<execute function="AssertVisible" locator1="LRDCOMTextInput#CONTACT_SALES_COMMENTS" value1="Contact Sales" />

		<execute function="AssertVisible" locator1="Button#SUBMIT" value1="Contact Sales" />

		<execute function="Click" locator1="LRDCOMButton#CLOSE_BUTTON" />
	</command>
</definition>