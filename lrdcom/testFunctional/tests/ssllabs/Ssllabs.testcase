@component-name = "marketplace"
definition {

	property testray.main.component.name = "Marketplace";

	@priority = "5"
	test ViewGrades {
		Ssllabs.openSsllabs(serverDomain = "liferay.com");

		Ssllabs.viewGradePG(
			serverGrade = "A-",
			serverIpAddress = "173.196.212.15");

		Ssllabs.viewGradePG(
			serverGrade = "A-",
			serverIpAddress = "38.75.15.21");

		Ssllabs.openSsllabs(serverDomain = "web.liferay.com");

		Ssllabs.viewGradePG(
			serverGrade = "A",
			serverIpAddress = "38.75.15.57");

		Ssllabs.viewGradePG(
			serverGrade = "A",
			serverIpAddress = "173.196.212.35");
	}

}