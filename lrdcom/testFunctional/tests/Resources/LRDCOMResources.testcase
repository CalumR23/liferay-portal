@component-name = "lrdcom"
definition {
	property testray.main.component.name = "lrdcom-www";
	var childPageName = "Resource Library";
	var pageName = "Resources";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}"
		);
	}

	@priority = "5"
	test CheckMultipleBackgroundImagesVisible {
		var key_imageNumber = "1";

		AssertElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE");

		while (IsElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE_N")) {
			var url = LRDCOM.getBackgroundImageURL(key_imageNumber = "${key_imageNumber}");

			LRDCOM.checkURLNotBroken(url = "${url}");

			LRDCOMNavigation.openHomeURL();

			LRDCOMNavigation.gotoPage(
				childPageName = "${childPageName}",
				pageName = "${pageName}"
			);

			var key_imageNumber = MathUtil.sum("${key_imageNumber}", "1");
		}
	}

	@priority = "4"
	test SearchAsset {
		var key_entryNumber = "150";

		while (IsElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");
		}

		while (IsElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.sum("${key_entryNumber}", "1");
		}

		var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");

		echo("Number of all resource page assets: ${key_entryNumber}");

		ScrollWebElementIntoView(locator1 = "TextInput#SEARCH_2");

		Type(locator1 = "TextInput#SEARCH_2", value1 = "Fashion");

		LRDCOMAssetEntry.view(assetName = "coach");

		LRDCOMAssetEntry.view(assetName = "May Fair");

		var key_entryNumber = MathUtil.difference("${key_entryNumber}", "2");

		echo("Number of hidden page assets: ${key_entryNumber}");

		LRDCOMAssetEntry.verifyHidden(lastHiddenAssetIndex = "${key_entryNumber}");
	}

	@priority = "4"
	test SearchInFilteredAssets {
		LRDCOMFilter.selectFilter(
			categoryName = "Financial Services",
			vocabularyName = "Industries"
		);

		var key_entryNumber = "21";

		while (IsElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");
		}

		while (IsElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.sum("${key_entryNumber}", "1");
		}

		var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");

		echo("Number of filtered resource page assets: ${key_entryNumber}");

		LRDCOMAssetEntry.view(assetName = "britam");

		ScrollWebElementIntoView(locator1 = "TextInput#SEARCH_2");

		Type(locator1 = "TextInput#SEARCH_2", value1 = "Liferay");

		LRDCOMAssetEntry.verifyHidden(assetName = "britam");

		LRDCOMAssetEntry.view(assetName = "apicil");

		LRDCOMAssetEntry.view(assetName = "lgt");

		var lastHiddenAssetIndex = MathUtil.difference("${key_entryNumber}", "8");

		LRDCOMAssetEntry.verifyHidden(lastHiddenAssetIndex = "${lastHiddenAssetIndex}");
	}

	@priority = "4"
	test ViewFilteredAssets {
		AssertElementNotPresent(locator1 = "ASSET_CATEGORY_TITLE_ANY");

		AssertElementNotPresent(locator1 = "ASSET_VOCABULARY_TITLE_ANY");

		var key_entryNumber = "150";

		while (IsElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");
		}

		while (IsElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X") && (maxIterations = "50")) {
			var key_entryNumber = MathUtil.sum("${key_entryNumber}", "1");
		}

		var key_entryNumber = MathUtil.difference("${key_entryNumber}", "1");

		echo("Number of all resource page assets: ${key_entryNumber}");

		LRDCOMFilter.selectFilter(
			categoryName = "Manufacturing",
			vocabularyName = "Industries"
		);

		LRDCOMAssetEntry.view(assetName = "advanced-energy");

		LRDCOMAssetEntry.view(assetName = "cristal-union");

		LRDCOMAssetEntry.view(assetName = "huhtamaki");

		LRDCOMAssetEntry.view(assetName = "saint-gobain");

		LRDCOMAssetEntry.view(assetName = "schott");

		LRDCOMAssetEntry.view(assetName = "thales");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_7");

		LRDCOMFilter.selectFilter(
			categoryName = "United States",
			vocabularyName = "Locations"
		);

		LRDCOMAssetEntry.view(assetName = "advanced-energy");

		LRDCOMAssetEntry.view(assetName = "huhtamaki");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_3");

		LRDCOMFilter.selectFilter(
			categoryName = "Case Studies",
			vocabularyName = "Resource Types"
		);

		LRDCOMAssetEntry.view(assetName = "advanced-energy");

		LRDCOMAssetEntry.view(assetName = "huhtamaki");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_3");

		LRDCOMFilter.selectFilter(categoryName = "Mobile", vocabularyName = "Solutions");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_1");

		LRDCOMFilter.removeFilter(categoryName = "Manufacturing");

		AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_7");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_8");

		AssertClick(locator1 = "LRDCOMFilter#RESET_FILTERS", value1 = "Reset Filters");

		AssertElementNotPresent(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE_ANY");

		AssertElementNotPresent(locator1 = "LRDCOMFilter#ASSET_VOCABULARY_TITLE_ANY");

		AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		var key_entryNumber = MathUtil.sum("${key_entryNumber}", "1");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");
	}

	@priority = "3"
	test ViewGartnerReport {
		var key_articleTitle = "Gartner Magic Quadrant";

		ScrollWebElementIntoView(locator1 = "LRDCOMButton#GET_THE_REPORT");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "2018 Gartner Magic Quadrant for Digital Experience Platforms"
		);

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#SECTION_PARAGRAPH",
			value1 = "Receive independent analysis of Liferay and the important role of DXPs in digital strategy."
		);

		AssertClick(locator1 = "LRDCOMButton#GET_THE_REPORT", value1 = "Get the Report");

		AssertTextEquals(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Liferay named a Leader in the 2018 Gartner Magic Quadrant for Digital Experience Platforms"
		);
	}

	@priority = "2"
	test ViewResourceCTALinks {
		LRDCOMArticle.viewResourceCTALinkQuote(linkName = "Watch the Case Study");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}"
		);

		LRDCOMArticle.viewResourceCTALinkQuote(linkName = "Read the Case Study");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}"
		);

		LRDCOMArticle.viewResourceCTALinkHeader(linkName = "Read the Whitepaper");
	}

	@priority = "2"
	test ViewSectionNavigationCaseStudies {
		LRDCOMNavigation.gotoPage(
			childPageName = "Case Studies",
			pageName = "${pageName}"
		);

		var key_categoryName = "Case Studies";
		var key_vocabularyName = "Resource Types";

		AssertVisible(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE");

		AssertVisible(locator1 = "LRDCOMFilter#ASSET_VOCABULARY_TITLE");
	}
}