<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<var name="pageName" value="Resources" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>
	</set-up>

	<command name="CheckMultipleBackgroundImagesVisible" priority="5">
		<var name="key_imageNumber" value="1" />

		<execute function="AssertElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE_N" />
			<then>
				<execute macro="LRDCOM#getBackgroundImageURL">
					<var name="key_imageNumber" value="${key_imageNumber}" />
					<return from="imageURL" name="url" />
				</execute>

				<execute macro="LRDCOM#checkURLNotBroken">
					<var name="url" value="${url}" />
				</execute>

				<execute function="AssertElementPresent" locator1="//body/img" />

				<execute macro="LRDCOMNavigation#openHomeURL" />

				<execute macro="LRDCOMNavigation#gotoPage">
					<var name="childPageName" value="${childPageName}" />
					<var name="pageName" value="${pageName}" />
				</execute>

				<var method="MathUtil#sum('${key_imageNumber}', '1')" name="key_imageNumber" />
			</then>
		</while>
	</command>

	<command name="SearchAsset" priority="5">
		<var name="key_entryNumber" value="155" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />
			<then>
				<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />
			</then>
		</while>

		<var method="MathUtil#sum('${key_entryNumber}', '-1')" name="key_entryNumber" />

		<echo message="Number of all resource page assets: ${key_entryNumber}" />

		<execute function="ScrollWebElementIntoView" locator1="TextInput#SEARCH_2" />

		<execute function="Type" locator1="TextInput#SEARCH_2" value1="Fashion" />

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="coach" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="May Fair" />
		</execute>

		<var method="MathUtil#sum('${key_entryNumber}', '-2')" name="key_entryNumber" />

		<echo message="Number of hidden page assets: ${key_entryNumber}" />

		<execute macro="LRDCOMAssetEntry#verifyHidden">
			<var name="lastHiddenAssetIndex" value="${key_entryNumber}" />
		</execute>
	</command>

	<command name="SearchInFilteredAssets" priority="4">
		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Financial Services" />
			<var name="vocabularyName" value="Industries" />
		</execute>

		<var name="key_entryNumber" value="22" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />
			<then>
				<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />
			</then>
		</while>

		<var method="MathUtil#sum('${key_entryNumber}', '-1')" name="key_entryNumber" />

		<echo message="Number of filtered resource page assets: ${key_entryNumber}" />

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="britam" />
		</execute>

		<execute function="ScrollWebElementIntoView" locator1="TextInput#SEARCH_2" />

		<execute function="Type" locator1="TextInput#SEARCH_2" value1="Liferay" />

		<execute macro="LRDCOMAssetEntry#verifyHidden">
			<var name="assetName" value="britam" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="apicil" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="lgt" />
		</execute>

		<var method="MathUtil#sum('${key_entryNumber}', '-7')" name="lastHiddenAssetIndex" />

		<execute macro="LRDCOMAssetEntry#verifyHidden">
			<var name="lastHiddenAssetIndex" value="15" />
		</execute>
	</command>

	<command name="ViewFilteredAssets" priority="5">
		<execute function="AssertElementNotPresent" locator1="ASSET_CATEGORY_TITLE_ANY" />
		<execute function="AssertElementNotPresent" locator1="ASSET_VOCABULARY_TITLE_ANY" />

		<var name="key_entryNumber" value="155" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />
			<then>
				<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />
			</then>
		</while>

		<var method="MathUtil#sum('${key_entryNumber}', '-1')" name="key_entryNumber" />

		<echo message="Number of all resource page assets: ${key_entryNumber}" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Automotive" />
			<var name="vocabularyName" value="Industries" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="autozone" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="volkswagen" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_3" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="United States" />
			<var name="vocabularyName" value="Locations" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="autozone" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_2" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Case Studies" />
			<var name="vocabularyName" value="Resource Types" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="autozone" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_2" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Mobile" />
			<var name="vocabularyName" value="Solutions" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_1" />

		<execute macro="LRDCOMFilter#removeFilter">
			<var name="categoryName" value="Automotive" />
		</execute>

		<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_7" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_8" />

		<execute function="AssertClick" locator1="LRDCOMFilter#RESET_FILTERS" value1="Reset Filters" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE_ANY" />
		<execute function="AssertElementNotPresent" locator1="LRDCOMFilter#ASSET_VOCABULARY_TITLE_ANY" />
		<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />
	</command>

	<command name="ViewGartnerReport" priority="5">
		<var name="key_articleTitle" value="Gartner Magic Quadrant" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMButton#GET_THE_REPORT" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#ARTICLE_H1" value1="2018 Gartner Magic Quadrant for Digital Experience Platforms" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#SECTION_PARAGRAPH" value1="Receive independent analysis of Liferay and the important role of DXPs in digital strategy." />

		<execute function="AssertClick" locator1="LRDCOMButton#GET_THE_REPORT" value1="Get the Report" />

		<execute function="AssertTextEquals" locator1="LRDCOM#HEADING_H1" value1="Liferay named a Leader in the 2018 Gartner Magic Quadrant for Digital Experience Platforms" />
	</command>

	<command name="ViewResourceCTALinks" priority="5">
		<execute macro="LRDCOMArticle#viewResourceCTALinkQuote">
			<var name="linkName" value="Watch the Case Study" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#viewResourceCTALinkQuote">
			<var name="linkName" value="Read the Case Study" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#viewResourceCTALinkHeader">
			<var name="linkName" value="Read the Whitepaper" />
		</execute>
	</command>

	<command name="ViewSectionNavigationCaseStudies" priority="5">
		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="Case Studies" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<var name="key_categoryName" value="Case Studies" />
		<var name="key_vocabularyName" value="Resource Types" />

		<execute function="AssertVisible" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE" />
		<execute function="AssertVisible" locator1="LRDCOMFilter#ASSET_VOCABULARY_TITLE" />
	</command>
</definition>