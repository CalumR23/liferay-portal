@component-name = "lrdcom"
definition {

	property testray.main.component.name = "lrdcom-www";

	var pageName = "Solutions";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();

		LRDCOMNavigation.gotoPage(pageName = "${pageName}");
	}

	@priority = "5"
	test CheckMultipleBackgroundImagesVisible {
		var key_imageNumber = "1";

		AssertElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE");

		while (IsElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE_N")) {
			var url = LRDCOM.getBackgroundImageURL(key_imageNumber = "${key_imageNumber}");

			LRDCOM.checkURLNotBroken(url = "${url}");

			LRDCOMNavigation.openHomeURL();

			LRDCOMNavigation.gotoPage(
				childPageName = "${childPageName}",
				pageName = "${pageName}");

			var key_imageNumber = ${key_imageNumber} + 1;
		}
	}

	@priority = "3"
	test ViewIndustryIconPageLinks {
		for (var iconTitle : list "banking,healthcare,government,retail,manufacturing,insurance") {
			LRDCOMNavigation.gotoPage(pageName = "${pageName}");

			LRDCOMNavigation.gotoIcon(iconTitle = "${iconTitle}");

			var iconTitle = StringUtil.upperCase("${iconTitle}");

			LRDCOMPage.viewActivePage(pageName = "${pageName}");

			LRDCOMPage.viewBannerContent(bannerContent = "${iconTitle}");
		}
	}

	@priority = "4"
	test ViewSolutionsIconPageLinks {
		for (var iconTitle : list "Intranet,Portal,Create") {
			LRDCOMNavigation.gotoPage(pageName = "${pageName}");

			LRDCOMNavigation.gotoIcon(iconTitle = "${iconTitle}");

			LRDCOMPage.viewBannerContent(bannerContent = "${iconTitle}");
		}

		LRDCOMNavigation.gotoPage(pageName = "${pageName}");

		LRDCOMNavigation.gotoIcon(iconTitle = "mobile");

		LRDCOMPage.viewBannerContent(bannerContent = "Mobile Strategy");
	}

}