<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<var name="pageName" value="Solutions" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />
	</set-up>

	<command name="ViewCompanyFooterLinks" priority="5">
		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Company" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Our Story" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<for list="Press Releases,Careers,Locations" param="footerTitle">
			<execute macro="LRDCOMFooter#gotoFooterLink">
				<var name="linkName" value="${footerTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="${footerTitle}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>
		</for>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Newsletter Sign Up" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_1" value1="Sign up for Liferay News" />
	</command>

	<command name="ViewIndustryIconPageLinks" priority="5">
		<for list="banking,healthcare,government,retail,manufacturing,insurance" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<var method="StringUtil#upperCase('${iconTitle}')" name="iconTitle" />

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>
	</command>

	<command name="ViewPlatformFooterLinks" priority="5">
		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Platform" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_LIFERAY_DXP" value1="Platform" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Case Studies and Docs" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_GARTNER" value1="Magic Quadrant" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Request a Demo" />
		</execute>

		<execute function="AssertTextEquals#assertText" locator1="LRDCOM#HEADING_1" value1="Request a Demo" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Marketplace Apps" />
		</execute>

		<execute function="AssertVisible" locator1="Marketplace#MARKETPLACE_BANNER" />

		<execute macro="LRDCOMNavigation#gotoHome" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMFooter#gotoFooterLink">
			<var name="linkName" value="Downloads" />
		</execute>

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Downloads" />
		</execute>
	</command>

	<command name="ViewPrivacyPolicy" priority="4">
		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" />

		<execute function="AssertClick#assertTextClickAt" locator1="LRDCOMLink#LINK_PRIVACY_POLICY" value1="Privacy Policy" />

		<execute function="AssertTextEquals" locator1="LRDCOM#HEADING_1" value1="Privacy Policy" />
	</command>

	<command name="ViewSocialIcons" priority="4">
		<var name="lrdcomWindowTitle" value="Liferay Use Cases" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<var name="key_title" value="GitHub" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<!-- Will include facebook icon view after jenkins or liferay facebook site has been fixed with updated firefox browser version

		<var name="key_title" value="Facebook" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="title=Liferay - Home | Facebook" />

		<execute function="Close#closeWindow" locator1="title=Liferay - Home | Facebook" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />
		-->

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="title=Liferay Inc. · GitHub" />

		<execute function="Close#closeWindow" locator1="title=Liferay Inc. · GitHub" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />

		<var name="key_title" value="Instagram" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="title=Liferay, Inc. (@liferayinc) • Instagram photos and videos" />

		<execute function="Close#closeWindow" locator1="title=Liferay, Inc. (@liferayinc) • Instagram photos and videos" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />

		<var name="key_title" value="LinkedIn" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="Liferay, Inc | LinkedIn" />

		<execute function="Close#closeWindow" locator1="LinkedIn: Log In or Sign Up" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />

		<var name="key_title" value="Twitter" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="Liferay (@Liferay) | Twitter" />

		<execute function="Close#closeWindow" locator1="Liferay (@Liferay) | Twitter" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />

		<var name="key_title" value="YouTube" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="Liferay - YouTube - YouTube" />

		<execute function="Close#closeWindow" locator1="Liferay - YouTube - YouTube" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />
	</command>

	<command name="ViewSolutionsIconPageLinks" priority="5">
		<for list="A More Personal Portal,Create,Intranets" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoIcon">
			<var name="iconTitle" value="mobile" />
		</execute>

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="Mobile Strategy" />
		</execute>
	</command>
</definition>