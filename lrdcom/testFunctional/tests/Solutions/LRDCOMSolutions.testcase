<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<var name="pageName" value="Solutions" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>
	</set-up>

	<command name="CheckMultipleBackgroundImagesVisible" priority="5">
		<var name="key_imageNumber" value="1" />

		<execute function="AssertElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE_N" />
			<then>
				<execute macro="LRDCOM#getBackgroundImageURL">
					<var name="key_imageNumber" value="${key_imageNumber}" />
					<return name="url" />
				</execute>

				<execute macro="LRDCOM#checkURLNotBroken">
					<var name="url" value="${url}" />
				</execute>

				<execute macro="LRDCOMNavigation#openHomeURL" />

				<execute macro="LRDCOMNavigation#gotoPage">
					<var name="childPageName" value="${childPageName}" />
					<var name="pageName" value="${pageName}" />
				</execute>

				<var method="MathUtil#sum('${key_imageNumber}', '1')" name="key_imageNumber" />
			</then>
		</while>
	</command>

	<command name="ViewIndustryIconPageLinks" priority="3">
		<for list="banking,healthcare,government,retail,manufacturing,insurance" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<var method="StringUtil#upperCase('${iconTitle}')" name="iconTitle" />

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>
	</command>

	<command name="ViewSolutionsIconPageLinks" priority="4">
		<for list="Intranet,Portal,Create" param="iconTitle">
			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoIcon">
				<var name="iconTitle" value="${iconTitle}" />
			</execute>

			<execute macro="LRDCOMPage#viewBannerContent">
				<var name="bannerContent" value="${iconTitle}" />
			</execute>
		</for>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoIcon">
			<var name="iconTitle" value="mobile" />
		</execute>

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="Mobile Strategy" />
		</execute>
	</command>
</definition>