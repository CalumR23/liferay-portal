<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<var name="pageName" value="Product" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="pageName" value="${pageName}" />
		</execute>
	</set-up>

	<command name="ViewFeaturesOfLiferayIconLinks" priority="5">
		<for list="Platform,Experiences,Assets" param="title">
			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="pageName" value="${pageName}" />
			</execute>

			<execute macro="LRDCOMNavigation#gotoCardBlock">
				<var name="title" value="${title}" />
			</execute>

			<execute macro="LRDCOMPage#viewActivePage">
				<var name="pageName" value="${title}" />
			</execute>
		</for>
	</command>

	<command name="ViewLiferayEnterpriseSubscriptionCTALink" priority="5">
		<var name="key_link" value="Learn more about Liferay Enterprise Subscription" />
		<var name="linkName" value="Learn more about Liferay Enterprise Subscription" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

		<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />

		<execute macro="LRDCOMPage#viewActivePage">
			<var name="pageName" value="Subscription Services" />
		</execute>

		<execute macro="LRDCOMPage#viewBannerContent">
			<var name="bannerContent" value="Liferay Enterprise Subscription" />
		</execute>
	</command>

	<command name="ViewMainBannerCTAIcons" priority="5">
		<var name="key_title" value="Experiences" />
		<var name="title" value="Experiences" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_LEGO" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<execute macro="LRDCOMArticle#viewDXPArticle">
			<var name="content" value="See how Digital Realty created a seamless customer platform" />
			<var name="header" value="Personal, omnichannel experiences for prospects and customers" />
			<var name="key_articleTitle" value="${key_title}" />
		</execute>

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<var name="key_title" value="Operations" />
		<var name="title" value="Operations" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<execute macro="LRDCOMArticle#viewDXPArticle">
			<var name="content" value="See how Unisys brings data together in a personalized way" />
			<var name="header" value="Equip your workforce with digital business processes and bridge operational silos" />
			<var name="key_articleTitle" value="${key_title}" />
		</execute>

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<var name="key_title" value="Strategy" />
		<var name="title" value="Strategy" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<execute macro="LRDCOMArticle#viewDXPArticle">
			<var name="content" value="Read how GRDF launched a web factory in only four months" />
			<var name="header" value="Develop faster with a standardized platform that’s ready for change" />
			<var name="key_articleTitle" value="${key_title}" />
		</execute>

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />

		<var name="key_title" value="Operations" />

		<execute function="AssertVisible" locator1="LRDCOMBlockContainer#BLOCK_LEGO" />
	</command>
</definition>