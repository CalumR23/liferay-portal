@component-name = "lrdcom"
definition {

	property testray.main.component.name = "lrdcom-www";

	var pageName = "Product";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();

		LRDCOMNavigation.gotoPage(pageName = "${pageName}");
	}

	@priority = "3"
	test ViewFeaturesOfLiferayIconLinks {
		for (var title : list "Platform,Experiences,Assets") {
			LRDCOMNavigation.gotoPage(pageName = "${pageName}");

			LRDCOMNavigation.gotoCardBlock(title = "${title}");

			LRDCOMPage.viewActivePage(pageName = "${title}");
		}
	}

	@priority = "3"
	test ViewLiferayEnterpriseSubscriptionCTALink {
		var key_link = "Learn more about Liferay Enterprise Subscription";
		var linkName = "Learn more about Liferay Enterprise Subscription";

		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA");

		AssertClick(
			locator1 = "LRDCOMLink#LINK_CTA",
			value1 = "${linkName}");

		LRDCOMPage.viewActivePage(pageName = "Subscription Services");

		LRDCOMPage.viewBannerContent(bannerContent = "Liferay Enterprise Subscription");
	}

	@priority = "3"
	test ViewMainBannerCTAIcons {
		var key_title = "Experiences";
		var title = "Experiences";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		LRDCOMArticle.viewDXPArticle(
			content = "See how Digital Realty created a seamless customer platform",
			header = "Personal, omnichannel experiences for prospects and customers",
			key_articleTitle = "${key_title}");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var key_title = "Operations";
		var title = "Operations";

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		LRDCOMArticle.viewDXPArticle(
			content = "See how Unisys brings data together in a personalized way",
			header = "Equip your workforce with digital business processes and bridge operational silos",
			key_articleTitle = "${key_title}");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var key_title = "Strategy";
		var title = "Strategy";

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		LRDCOMArticle.viewDXPArticle(
			content = "Read how GRDF launched a web factory in only four months",
			header = "Develop faster with a standardized platform that’s ready for change",
			key_articleTitle = "${key_title}");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var key_title = "Experiences";

		AssertVisible(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		var key_title = "Operations";

		AssertVisible(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		var key_title = "Strategy";

		AssertVisible(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");
	}

	@priority = "3"
	test ViewVideoThumbnails {
		var key_title = "Experiences";
		var title = "Experiences";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var url = LRDCOM.getSectionThumbnailImageURL(key_title = "${title}");

		LRDCOM.checkURLNotBroken(url = "${url}");

		LRDCOMNavigation.openHomeURL();

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		var key_title = "Operations";
		var title = "Operations";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var url = LRDCOM.getSectionThumbnailImageURL(key_title = "${title}");

		LRDCOM.checkURLNotBroken(url = "${url}");

		LRDCOMNavigation.openHomeURL();

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		var key_title = "Strategy";
		var title = "Strategy";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");

		var url = LRDCOM.getSectionThumbnailImageURL(key_title = "${title}");

		LRDCOM.checkURLNotBroken(url = "${url}");
	}

}