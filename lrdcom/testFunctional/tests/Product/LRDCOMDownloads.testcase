<definition component-name="lrdcom">
	<property name="testray.main.component.name" value="lrdcom-www" />

	<var name="childPageName" value="Downloads" />
	<var name="pageName" value="Product" />

	<set-up>
		<execute macro="LRDCOMNavigation#openHomeURL" />

		<execute macro="LRDCOM#acceptCookies" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>
	</set-up>

	<command name="CheckMultipleBackgroundImagesVisible" priority="5">
		<var name="key_imageNumber" value="1" />

		<execute function="AssertElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE" />

		<while>
			<condition function="IsElementPresent" locator1="LRDCOM#BACKGROUND_IMAGE_N" />
			<then>
				<execute macro="LRDCOM#getBackgroundImageURL">
					<var name="key_imageNumber" value="${key_imageNumber}" />
					<return from="imageURL" name="url" />
				</execute>

				<execute macro="LRDCOM#checkURLNotBroken">
					<var name="url" value="${url}" />
				</execute>

				<execute function="AssertElementPresent" locator1="//body/img" />

				<execute macro="LRDCOMNavigation#openHomeURL" />

				<execute macro="LRDCOMNavigation#gotoPage">
					<var name="childPageName" value="${childPageName}" />
					<var name="pageName" value="${pageName}" />
				</execute>

				<var method="MathUtil#sum('${key_imageNumber}', '1')" name="key_imageNumber" />
			</then>
		</while>
	</command>

	<command name="SearchAssets" priority="5">
		<execute function="ScrollWebElementIntoView" locator1="TextInput#SEARCH_2" />

		<execute function="Type#sendKeys" locator1="TextInput#SEARCH_2" value1="to" />

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay Portal Tools for 7.0 GA5" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay Portal 7.0 GA5 Bundled with Tomcat" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay IDE" />
		</execute>

		<var name="key_entryNumber" value="4" />

		<execute function="AssertNotVisible" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<execute function="Type#sendKeys" locator1="TextInput#SEARCH_2" value1="o" />

		<execute function="AssertNotVisible" locator1="LRDCOMAssetEntry#ASSET_ENTRY_3" />
	</command>

	<command name="StartYourEnterpriseTrial" priority="5">
		<execute function="Click" locator1="LRDCOMButton#START_YOUR_ENTERPRISE_TRIAL" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="Try Liferay DXP Free for 30 Days" />

		<execute function="AssertElementPresent" locator1="TextInput#EMAIL_ADDRESS" />

		<execute function="AssertElementPresent" locator1="TextInput#PASSWORD" />

		<execute function="AssertElementPresent" locator1="Button#SUBMIT" />

		<execute macro="LRDCOMUserSignIn#signInDXPFreeTrial">
			<var method="TestPropsUtil#get('lrdcom.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('lrdcom.email.password.5')" name="userPassword" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="Try Liferay DXP Free for 30 Days" />
	</command>

	<command name="ViewCTALinks" priority="5">
		<execute macro="LRDCOMArticle#clickCTALink">
			<var name="linkName" value="View the license" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="Liferay Portal CE License" />

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#clickCTALink">
			<var name="linkName" value="Getting started" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="Community" />
	</command>

	<command name="ViewDownloadButtons" priority="5">
		<!-- Blocked by LRQA-39201 and need to update test login permissions to access Liferay Connected Services
		<execute macro="LRDCOMArticle#download">
			<var name="title" value="AlloyUI" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Connected Services" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="//div/span[contains(@class,'title')]" value1="Connected Services" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>-->

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Developer Tools" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#H1_SECTION_HEADING" value1="Liferay IDE" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#H1_SECTION_HEADING_2" value1="Liferay Developer Studio" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Faces" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#H1_SECTION_HEADING" value1="Liferay Faces" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Push" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="Liferay CE Push" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Screens" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="GitHub#ARTICLE_H1" value1="Liferay Screens" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Sync" />
		</execute>

		<execute macro="LRDCOMUserSignIn#signIn">
			<var method="TestPropsUtil#get('lrdcom.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('lrdcom.email.password.5')" name="userPassword" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="Checkbox#AGREED_TO_TERMS_OF_USE_CHECKBOX" />
			<then>
				<execute macro="LRDCOMUserSignIn#agreeToTermsOfUse" />
			</then>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#H1_SECTION_HEADING" value1="Liferay Sync" />
		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#H1_SECTION_HEADING_2" value1="Liferay Sync for Mobile" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Mobile SDK" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="GitHub#REPO_PATH_H1" value1="liferay-mobile-sdk" />
	</command>

	<command name="ViewFilteredAssets" priority="5">
		<execute function="AssertElementNotPresent" locator1="ASSET_CATEGORY_TITLE_ANY" />
		<execute function="AssertElementNotPresent" locator1="ASSET_VOCABULARY_TITLE_ANY" />

		<var name="key_entryNumber" value="12" />

		<echo message="Number of all filterable assets on Downloads page: ${key_entryNumber}" />

		<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Products" />
			<var name="vocabularyName" value="Download Types" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_1" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Tools" />
			<var name="vocabularyName" value="Download Types" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay IDE" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay Portal Tools for 7.0 GA5" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_3" />

		<execute macro="LRDCOMFilter#selectFilter">
			<var name="categoryName" value="Dependencies" />
			<var name="vocabularyName" value="Download Types" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Dependencies for 7.0 GA5" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="OSGi Dependencies" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay IDE" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Liferay Portal Tools for 7.0 GA5" />
		</execute>

		<execute macro="LRDCOMFilter#removeFilter">
			<var name="categoryName" value="Tools" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="Dependencies for 7.0 GA5" />
		</execute>

		<execute macro="LRDCOMAssetEntry#view">
			<var name="assetName" value="OSGi Dependencies" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_3" />

		<execute function="AssertClick" locator1="LRDCOMFilter#RESET_FILTERS" value1="Reset Filters" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE_ANY" />
		<execute function="AssertElementNotPresent" locator1="LRDCOMFilter#ASSET_VOCABULARY_TITLE_ANY" />
		<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />

		<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_X" />
	</command>

	<command name="ViewKBLink" priority="5">
		<var name="key_link" value="Visit the Liferay Developer Network for more information" />
		<var name="linkName" value="${key_link}" />
		<var name="viewHeadingName" value="WHAT IS LIFERAY PORTAL?" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

		<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#ARTICLE_H1" value1="${viewHeadingName}" />
	</command>

	<command name="ViewLearnMoreCTALinks" priority="5">
		<var name="linkIndexNumber" value="0" />

		<for list="AlloyUI,Liferay Connected Services,Liferay IDE,Liferay Faces,Liferay Screens,Liferay Sync,Mobile SDK" param="viewHeadingTitle">
			<var method="MathUtil#sum('${linkIndexNumber}', '1')" name="linkIndexNumber" />

			<execute macro="LRDCOMArticle#clickCTALink">
				<var name="linkIndexNumber" value="${linkIndexNumber}" />
				<var name="linkName" value="Learn More" />
			</execute>

			<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#ARTICLE_H1" value1="${viewHeadingTitle}" />

			<execute macro="LRDCOMNavigation#gotoHome" />

			<execute macro="LRDCOMNavigation#gotoPage">
				<var name="childPageName" value="${childPageName}" />
				<var name="pageName" value="${pageName}" />
			</execute>
		</for>
	</command>
</definition>