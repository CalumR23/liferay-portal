@component-name = "lrdcom"
definition {

	property testray.main.component.name = "lrdcom-www";

	var childPageName = "Downloads";
	var pageName = "Product";

	setUp {
		LRDCOMNavigation.openHomeURL();

		LRDCOM.acceptCookies();

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");
	}

	@priority = "5"
	test CheckMultipleBackgroundImagesVisible {
		var key_imageNumber = "1";

		AssertElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE");

		while (IsElementPresent(locator1 = "LRDCOM#BACKGROUND_IMAGE_N")) {
			var url = LRDCOM.getBackgroundImageURL(key_imageNumber = "${key_imageNumber}");

			LRDCOM.checkURLNotBroken(url = "${url}");

			LRDCOMNavigation.openHomeURL();

			LRDCOMNavigation.gotoPage(
				childPageName = "${childPageName}",
				pageName = "${pageName}");

			var key_imageNumber = ${key_imageNumber} + 1;
		}
	}

	@priority = "4"
	test SearchAssets {
		ScrollWebElementIntoView(locator1 = "TextInput#SEARCH_2");

		Type.sendKeys(
			locator1 = "TextInput#SEARCH_2",
			value1 = "to");

		LRDCOMAssetEntry.view(assetName = "Liferay Portal Tools for 7.0 GA5");

		LRDCOMAssetEntry.view(assetName = "Liferay Portal 7.0 GA5 Bundled with Tomcat");

		LRDCOMAssetEntry.view(assetName = "Liferay IDE");

		var key_entryNumber = "4";

		AssertNotVisible(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		Type.sendKeys(
			locator1 = "TextInput#SEARCH_2",
			value1 = "o");

		AssertNotVisible(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_3");
	}

	@priority = "4"
	test StartYourEnterpriseTrial {
		Click(locator1 = "LRDCOMButton#START_YOUR_ENTERPRISE_TRIAL");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Try Liferay DXP Free For 30 Days");

		AssertElementPresent(locator1 = "TextInput#EMAIL_ADDRESS");

		AssertElementPresent(locator1 = "TextInput#PASSWORD");

		AssertElementPresent(locator1 = "Button#SUBMIT");

		LRDCOMUserSignIn.signInDXPFreeTrial(
			userEmailAddress = PropsUtil.get("lrdcom.email.address.2"),
			userPassword = PropsUtil.get("lrdcom.email.password.2"));

		if (IsElementPresent(locator1 = "//div[@id='ee-trial']")) {
			AssertTextEquals.assertPartialText(
				locator1 = "//div[@id='ee-trial']",
				value1 = "30-Day Trial");

			AssertClick(
				locator1 = "LRDCOMButton#DOWNLOAD_BUTTON",
				value1 = "Download");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "LRDCOMArticle#ARTICLE_H2",
				value1 = "Trial has expired");

			Click(locator1 = "LRDCOMLink#LINK_ACTIVATION_LICENSE");

			AssertTextEquals.assertPartialText(
				locator1 = "LRDCOM#SECTION_HEADING_H1",
				value1 = "License Management");
		}
	}

	@priority = "4"
	test ViewCTALinks {
		LRDCOMArticle.clickCTALink(linkName = "View the license");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Liferay Portal CE License");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.clickCTALink(linkName = "Getting started");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Community");
	}

	@priority = "4"
	test ViewDownloadButtons {
		/* Blocked by LRQA-39201 and need to update test login permissions to access Liferay Connected Services
		<execute macro="LRDCOMArticle#download">
			<var name="title" value="AlloyUI" />
		</execute>

		<execute macro="LRDCOMArticle#download">
			<var name="title" value="Liferay Connected Services" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="//div/span[contains(@class,'title')]" value1="Connected Services" />

		<execute macro="LRDCOMNavigation#gotoHome">
			<var name="childPageName" value="${childPageName}" />
		</execute>

		<execute macro="LRDCOMNavigation#gotoPage">
			<var name="childPageName" value="${childPageName}" />
			<var name="pageName" value="${pageName}" />
		</execute>*/

		LRDCOMArticle.download(title = "Liferay Developer Tools");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#H1_SECTION_HEADING",
			value1 = "Liferay IDE");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#H1_SECTION_HEADING_2",
			value1 = "Liferay Developer Studio");

		LRDCOMNavigation.gotoHome(childPageName = "${childPageName}");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.download(title = "Liferay Faces");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#H1_SECTION_HEADING",
			value1 = "Liferay Faces");

		LRDCOMNavigation.gotoHome(childPageName = "${childPageName}");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.download(title = "Liferay Push");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "Liferay CE Push");

		LRDCOMNavigation.gotoHome(childPageName = "${childPageName}");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.download(title = "Liferay Screens");

		AssertTextEquals.assertPartialText(
			locator1 = "GitHub#ARTICLE_H1",
			value1 = "Liferay Screens");

		LRDCOMNavigation.gotoHome(childPageName = "${childPageName}");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.download(title = "Liferay Sync");

		LRDCOMUserSignIn.signIn(
			userEmailAddress = PropsUtil.get("lrdcom.email.address.2"),
			userPassword = PropsUtil.get("lrdcom.email.password.2"));

		if (IsElementPresent(locator1 = "LRDCOMCheckbox#AGREED_TO_TERMS_OF_USE_CHECKBOX")) {
			LRDCOMUserSignIn.agreeToTermsOfUse();
		}

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#H1_SECTION_HEADING",
			value1 = "Liferay Sync");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#H1_SECTION_HEADING_2",
			value1 = "Liferay Sync for Mobile");

		LRDCOMNavigation.gotoHome(childPageName = "${childPageName}");

		LRDCOMNavigation.gotoPage(
			childPageName = "${childPageName}",
			pageName = "${pageName}");

		LRDCOMArticle.download(title = "Mobile SDK");

		AssertTextEquals.assertPartialText(
			locator1 = "GitHub#REPO_PATH_H1",
			value1 = "liferay-mobile-sdk");
	}

	@priority = "4"
	test ViewFilteredAssets {
		AssertElementNotPresent(locator1 = "ASSET_CATEGORY_TITLE_ANY");

		AssertElementNotPresent(locator1 = "ASSET_VOCABULARY_TITLE_ANY");

		var key_entryNumber = "12";

		echo("Number of all filterable assets on Downloads page: ${key_entryNumber}");

		AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		LRDCOMFilter.selectFilter(
			categoryName = "Products",
			vocabularyName = "Download Types");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_1");

		LRDCOMFilter.selectFilter(
			categoryName = "Tools",
			vocabularyName = "Download Types");

		LRDCOMAssetEntry.view(assetName = "Liferay IDE");

		LRDCOMAssetEntry.view(assetName = "Liferay Portal Tools for 7.0 GA5");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_3");

		LRDCOMFilter.selectFilter(
			categoryName = "Dependencies",
			vocabularyName = "Download Types");

		LRDCOMAssetEntry.view(assetName = "Dependencies for 7.0 GA5");

		LRDCOMAssetEntry.view(assetName = "OSGi Dependencies");

		LRDCOMAssetEntry.view(assetName = "Liferay IDE");

		LRDCOMAssetEntry.view(assetName = "Liferay Portal Tools for 7.0 GA5");

		LRDCOMFilter.removeFilter(categoryName = "Tools");

		LRDCOMAssetEntry.view(assetName = "Dependencies for 7.0 GA5");

		LRDCOMAssetEntry.view(assetName = "OSGi Dependencies");

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_3");

		AssertClick(
			locator1 = "LRDCOMFilter#RESET_FILTERS",
			value1 = "Reset Filters");

		AssertElementNotPresent(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE_ANY");

		AssertElementNotPresent(locator1 = "LRDCOMFilter#ASSET_VOCABULARY_TITLE_ANY");

		AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");

		var key_entryNumber = ${key_entryNumber} + 1;

		AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_X");
	}

	@priority = "3"
	test ViewKBLink {
		var key_link = "Visit the Liferay Developer Network for more information";

		var linkName = "${key_link}";
		var viewHeadingName = "WHAT IS LIFERAY PORTAL?";

		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA");

		AssertClick(
			locator1 = "LRDCOMLink#LINK_CTA",
			value1 = "${linkName}");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#ARTICLE_H1",
			value1 = "${viewHeadingName}");
	}

	@priority = "3"
	test ViewLearnMoreCTALinks {
		var linkIndexNumber = "0";

		for (var viewHeadingTitle : list "AlloyUI,Liferay Connected Services,Liferay IDE,Liferay Faces,Liferay Screens,Liferay Sync,Mobile SDK") {
			var linkIndexNumber = ${linkIndexNumber} + 1;

			LRDCOMArticle.clickCTALink(
				linkIndexNumber = "${linkIndexNumber}",
				linkName = "Learn More");

			AssertTextEquals.assertPartialText(
				locator1 = "LRDCOMArticle#ARTICLE_H1",
				value1 = "${viewHeadingTitle}");

			LRDCOMNavigation.gotoHome();

			LRDCOMNavigation.gotoPage(
				childPageName = "${childPageName}",
				pageName = "${pageName}");
		}
	}

}