<html>
<head>
<title>LRDCOM</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOM</td></tr>
</thead>
<tbody>
<tr>
	<td>BACKGROUND_IMAGE</td>
	<td>//div[contains(@style,'background-image')]</td>
	<td></td>
</tr>
<tr>
	<td>BACKGROUND_IMAGE_N</td>
	<td>xpath=(//div[contains(@style,'background-image')])[${key_imageNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>BRAND_CAMPAIGN_FORM_H3</td>
	<td>//div[contains(@class,'brand-campaign-form')]//h3</td>
	<td></td>
</tr>
<tr>
	<td>DOCUMENT_TITLE_H1</td>
	<td>//h1[@id='docTitle']</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_PAGE</td>
	<td>//div[contains(@class,'error-content') or contains(.,'Internal Server Error') or contains(.,'Server not found')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_GARTNER</td>
	<td>//div[contains(@class,'block')]/h1[contains(@class,'gartner-header')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_H1</td>
	<td>//div[contains(@id,'heading') or contains(@class,'heading')]//h1</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_LIFERAY_DXP</td>
	<td>//div[contains(@class,'dxp-heading')]//h1</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_BANNER_CONTENT</td>
	<td>//div[contains(@class,'main-banner-content')]//*[contains(.,'${key_bannerContent}')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_HEADING_H1</td>
	<td>//div/h1[contains(@class,'heading')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>