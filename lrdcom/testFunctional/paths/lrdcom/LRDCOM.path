<html>
<head>
<title>LRDCOM</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOM</td></tr>
</thead>
<tbody>
<tr>
	<td>HEADING_1</td>
	<td>//div[contains(@id,'heading')]//h1</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_GARTNER</td>
	<td>//div[contains(@class,'block')]/h1[contains(@class,'gartner-header')]</td>
	<td></td>
</tr>
<tr>
	<td>HEADING_LIFERAY_DXP</td>
	<td>//div[contains(@class,'dxp-heading')]//h1</td>
	<td></td>
</tr>
<tr>
	<td>LOGO_LIFERAY</td>
	<td>//div[contains(@class,'main-banner')]//*[name()='use' and contains(@*,'liferayLogo')]/..</td>
	<td></td>
</tr>
<tr>
	<td>MAIN_BANNER_CONTENT</td>
	<td>//div[contains(@class,'main-banner-content')]//*[contains(.,'${key_bannerContent}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>