<html>
<head>
<title>LRDCOMBlockContainer</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMBlockContainer</td></tr>
</thead>
<tbody>
<!--LRDCOM Block Elements-->
<tr>
	<td>CARD</td>
	<td>//div[contains(@class,'card-block')]/a[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTAINER</td>
	<td>//div[contains(@class,'block')]/a[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>LEGO</td>
	<td>//div[contains(@class,'lego')]//div[contains(@class,'block')]/a[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<!--LRDCOM Blogs Entry-->
<tr>
	<td>BLOGS_ENTRY</td>
	<td>///div[contains(@class,'blogs-entry') and contains(@class,'block')]//a[contains(@class,'text') and contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>