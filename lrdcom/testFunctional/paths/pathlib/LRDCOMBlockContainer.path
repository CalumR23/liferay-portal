<html>
<head>
<title>LRDCOMBlockContainer</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMBlockContainer</td></tr>
</thead>
<tbody>
<!--LRDCOM Block Elements-->
<tr>
	<td>BLOCK_CARD</td>
	<td>//div[contains(@class,'card-block')]/a[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOCK_CONTAINER</td>
	<td>//div[contains(@class,'block')]/a[contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOCK_LEGO</td>
	<td>//div[contains(@class,'lego')]//div[contains(@class,'block') and contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOCK_LEGO_BLUR</td>
	<td>//div[contains(@class,'lego-block')]//a[contains(@class,'blur')]</td>
	<td></td>
</tr>
<tr>
	<td>BLOCK_SECTION_NO_BLUR</td>
	<td>//div[contains(@class,'lego-block')]//a[contains(@class,'blur')]/../..</td>
	<td></td>
</tr>
<!--LRDCOM Block Blogs Entry-->
<tr>
	<td>BLOCK_BLOGS_ENTRY</td>
	<td>//div[contains(@class,'blogs-entry') and contains(@class,'block')]//a[contains(@class,'text') and contains(.,'${key_title}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>