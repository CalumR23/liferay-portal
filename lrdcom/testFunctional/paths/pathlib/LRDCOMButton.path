<html>
<head>
<title>LRDCOMButton</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMButton</td></tr>
</thead>
<tbody>
<tr>
	<td>SEE_SUCCESS_STORIES</td>
	<td>//div[contains(@class,'lego-article')]/section/div[contains(@class,'block')]/a/span[contains(.,'See Success Stories')]</td>
	<td></td>
</tr>
<tr>
	<td>COOKIE_ACCEPT_BUTTON</td>
	<td>//div[contains(@class,'cookie')]//a[contains(@class,'cookie-acceptance-btn')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>