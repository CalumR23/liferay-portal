<html>
<head>
<title>LRDCOMButton</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMButton</td></tr>
</thead>
<tbody>
<tr>
	<td>COOKIE_ACCEPT_BUTTON</td>
	<td>//div[contains(@class,'cookie')]//a[contains(@class,'cookie-acceptance-btn')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOAD</td>
	<td>//div[a[contains(.,'${key_title}')]]//a[contains(.,'Download') and contains(@class,'btn')] | //div[h3[contains(.,'${key_title}')]]//a[contains(.,'Download') and contains(@class,'btn')]</td>
	<td></td>
</tr>
<tr>
	<td>GET_THE_REPORT</td>
	<td>//a[contains(@class,'btn') and contains(.,'Get the Report')]</td>
	<td></td>
</tr>
<tr>
	<td>SEE_SUCCESS_STORIES</td>
	<td>//span[contains(.,'See Success Stories')]</td>
	<td></td>
</tr>
<tr>
	<td>START_YOUR_ENTERPRISE_TRIAL</td>
	<td>//a[contains(@class,'btn') and contains(.,'Start your Enterprise Trial')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_TOGGLE</td>
	<td>//a[contains(@class,'btn') and contains(@class,'toggle')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>