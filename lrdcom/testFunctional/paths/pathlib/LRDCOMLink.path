<html>
<head>
<title>LRDCOMLink</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMLink</td></tr>
</thead>

<tbody>
<tr>
	<td>READ_THE_REPORT</td>
	<td>//a[contains(@class,'cta') and contains(.,'Read the Report')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_ACTIVATION_LICENSE</td>
	<td>//a[contains(.,'activation/license key tab')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_CTA</td>
	<td>//a[contains(@class,'cta') and contains(.,'${key_link}')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_CTA_N</td>
	<td>xpath=(//a[contains(@class,'cta') and contains(.,'${key_link}')])[${key_linkIndexNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_FOOTER</td>
	<td>//div[contains(@class,'footer')]//a[contains(.,'${key_link}')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_PRIVACY_POLICY</td>
	<td>//a[contains(@class,'privacy-policy')]</td>
	<td></td>
</tr>
<tr>
	<td>LINK_SECTION_H3</td>
	<td>//section//a[contains(.,'${key_link}')]/../h3</td>
	<td></td>
</tr>
<tr>
	<td>LINK_SECTION_H3_N</td>
	<td>xpath=(//section//a[contains(.,'${key_link}')])[${key_linkIndexNumber}]/../h3</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>