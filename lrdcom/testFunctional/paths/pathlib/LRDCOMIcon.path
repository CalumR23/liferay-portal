<html>
<head>
<title>LRDCOMIcon</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMIcon</td></tr>
</thead>

<tbody>

<!--LRDCOM Block Elements-->

<tr>
	<td>ICON</td>
	<td>//div[contains(@class,'card-block')]//*[((name()='svg' and contains(@class,'icon') or contains(@id,'icon')) and contains(.,'${key_iconTitle}'))]</td>
	<td></td>
</tr>
<tr>
	<td>ICON_SOCIAL</td>
	<td>//a[@title='${key_title}']//*[name()='use' and contains(@*,'Icon')]/..</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>