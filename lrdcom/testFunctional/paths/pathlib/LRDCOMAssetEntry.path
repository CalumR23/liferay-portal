<html>
<head>
<title>LRDCOMAssetEntry</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMAssetEntry</td></tr>
</thead>

<tbody>
<tr>
	<td>ASSET_ENTRY</td>
	<td>//div[contains(@class,'asset-entries')]//a[contains(@href,'${key_assetName}') or contains(.,'${key_assetName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_1</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[1]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_2</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[2]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_3</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[3]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_7</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[7]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_8</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[8]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_X</td>
	<td>xpath=(//div[contains(@class,'asset-entries')]//a)[${key_entryNumber}]</td>
	<td></td>
</tr>

<!-- Hidden assets or filtered out assets-->

<tr>
	<td>ASSET_ENTRY_HIDDEN</td>
	<td>//div[contains(@class,'asset-entries')]//div[contains(@class,'hide')]//a[contains(@href,'${key_assetName}') or contains(.,'${key_assetName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_ENTRY_HIDDEN_X</td>
	<td>//div[contains(@class,'asset-entries')]//div[contains(@class,'hide')][${key_entryNumber}]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>