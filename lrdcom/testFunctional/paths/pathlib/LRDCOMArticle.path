<html>
<head>
<title>LRDCOMArticle</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMArticle</td></tr>
</thead>

<tbody>

<!--LRDCOM Article Content-->

<tr>
	<td>ARTICLE_H1</td>
	<td>//div[contains(@class,'article')]//h1</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_H2</td>
	<td>//div[contains(@class,'article')]//h2/strong</td>
	<td></td>
</tr>
<tr>
	<td>ARTICLE_MAP</td>
	<td>//div[contains(@class,'article')]//div[contains(@class,'map')]</td>
	<td></td>
</tr>
<tr>
	<td>H1_SECTION_HEADING</td>
	<td>//h1[contains(@class,'section-heading')]</td>
	<td></td>
</tr>
<tr>
	<td>H1_SECTION_HEADING_2</td>
	<td>xpath=(//h1[contains(@class,'section-heading')])[2]</td>
	<td></td>
</tr>
<tr>
	<td>QUOTE_SECTION</td>
	<td>//div[contains(@class,'quote-section')]</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_H3</td>
	<td>//section[contains(.,'${key_articleTitle}')]//h3</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_PARAGRAPH</td>
	<td>//section[contains(.,'${key_articleTitle}')]//p</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_QUOTE_BY_LINK</td>
	<td>//section//a[contains(.,'${key_link}')]/../..//div[contains(@class,'quote')]//p</td>
	<td></td>
</tr>
<tr>
	<td>SECTION_QUOTE_BY_LINK_N</td>
	<td>xpath=(//section//a[contains(.,'${key_link}')]/../..//div[contains(@class,'quote')]//p)[${key_linkIndexNumber}]</td>
	<td></td>
</tr>

<!--LRDCOM Blogs Entry-->

<tr>
	<td>BLOGS_ENTRY</td>
	<td>//div[contains(@class,'blogs-entry')]//a[contains(@class,'text') and contains(.,'${key_title}')]</td>
	<td></td>
</tr>

<!--LRDCOM Resource Entry-->

<tr>
	<td>RESOURCE_H1</td>
	<td>//div[contains(@class,'resource-display')]//h1</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>