<html>
<head>
<title>LRDCOMTextInput</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMTextInput</td></tr>
</thead>

<tbody>
<tr>
	<td>CONTACT_SALES_COMMENTS</td>
	<td>//div//label[contains(.,'sales representative about:')]/following-sibling::textarea</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_1</td>
	<td>xpath=(//div//label[contains(.,'First Name')]/following-sibling::input)[1]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_NAME_2</td>
	<td>xpath=(//div//label[contains(.,'First Name')]/following-sibling::input)[2]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_1</td>
	<td>xpath=(//div//label[contains(.,'Last Name')]/following-sibling::input)[1]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_NAME_2</td>
	<td>xpath=(//div//label[contains(.,'Last Name')]/following-sibling::input)[2]</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_1</td>
	<td>xpath=(//div//label[contains(.,'Work Email')]/following-sibling::input)[1]</td>
	<td></td>
</tr>
<tr>
	<td>WORK_EMAIL_2</td>
	<td>xpath=(//div//label[contains(.,'Work Email')]/following-sibling::input)[2]</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_2</td>
	<td>xpath=(//div//label[contains(.,'Phone')]/following-sibling::input)[2]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_2</td>
	<td>xpath=(//div//label[contains(.,'Company')]/following-sibling::input)[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>