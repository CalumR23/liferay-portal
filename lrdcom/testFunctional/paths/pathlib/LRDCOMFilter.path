<html>
<head>
<title>LRDCOMFilter</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMFilter</td></tr>
</thead>

<tbody>
<tr>
	<td>ASSET_CATEGORY_TITLE</td>
	<td>//div[contains(@class,'asset-category-title') and contains(.,'${key_categoryName}')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_CATEGORY_TITLE_ANY</td>
	<td>//div[contains(@class,'asset-category-title')]/a</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_VOCABULARY_TITLE</td>
	<td>//div[@class='asset-vocabulary-title' and contains(.,'${key_vocabularyName}')]</td>
	<td></td>
</tr>
<tr>
	<td>ASSET_VOCABULARY_TITLE_ANY</td>
	<td>//div[@class='asset-vocabulary-title']</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_OPTION</td>
	<td>//div[contains(@class,'asset-category-title') and contains(.,'${key_categoryName}')]/a[contains(@class,'remove')]</td>
	<td></td>
</tr>
<tr>
	<td>RESET_FILTERS</td>
	<td>//a[contains(@class,'navigation-reset') and contains(.,'Reset Filters')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_OPTION</td>
	<td>//select[contains(.,'${key_vocabularyName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>