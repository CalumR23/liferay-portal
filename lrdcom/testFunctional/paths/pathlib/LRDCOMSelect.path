<html>
<head>
<title>LRDCOMSelect</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMSelect</td></tr>
</thead>

<tbody>
<tr>
	<td>COUNTRY_1</td>
	<td>xpath=(//div//label[contains(.,'Country')]/following-sibling::select)[1]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_2</td>
	<td>xpath=(//div//label[contains(.,'Country')]/following-sibling::select)[2]</td>
	<td></td>
</tr>
<tr>
	<td>DEPARTMENT</td>
	<td>//div//label[contains(.,'Department')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>JOB_ROLE</td>
	<td>//div//label[contains(.,'Job Role')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>I_AM_SOMEONE_WHO</td>
	<td>//div//label[contains(.,'I am someone who')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>NUMBER_OF_EMPLOYEES</td>
	<td>//div//label[contains(.,'Number of Employees')]/following-sibling::select</td>
	<td></td>
</tr>
<tr>
	<td>STATE_PROVINCE_1</td>
	<td>xpath=(//div//label[contains(.,'State/Province')]/following-sibling::select)[1]</td>
	<td></td>
</tr>
<tr>
	<td>STATE_PROVINCE_2</td>
	<td>xpath=(//div//label[contains(.,'State/Province')]/following-sibling::select)[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>