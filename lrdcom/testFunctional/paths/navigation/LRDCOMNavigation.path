<html>
<head>
<title>LRDCOMNavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMNavigation</td></tr>
</thead>
<tbody>
<!--LRDCOM Page Navigation -->
<tr>
	<td>PAGE_MAIN</td>
	<td>//*[contains(@id,'mainNavigation')]//a[contains(.,'${key_pageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_CHILD</td>
	<td>//*[contains(@id,'childNavigation')]//a[contains(.,'${key_childPageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_ACTIVE</td>
	<td>//div[contains(@class,'banner')]//ul/li[@aria-selected='true']/a[contains(.,'${key_pageName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--Side Menu Navigation-->
<tr>
	<td>NAVIGATION_MENU</td>
	<td>//div[contains(@id,'sideMenu')]/a[contains(@id,'menuToggle')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_IN</td>
	<td>//div[contains(@id,'sideMenu')]//a[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_OUT</td>
	<td>//div[contains(@id,'sideMenu')]//a[.='Sign Out']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>