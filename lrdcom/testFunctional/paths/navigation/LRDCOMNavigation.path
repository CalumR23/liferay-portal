<html>
<head>
<title>LRDCOMNavigation</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LRDCOMNavigation</td></tr>
</thead>

<tbody>

<!--LRDCOM Logo Navigation -->

<tr>
	<td>LOGO_LIFERAY</td>
	<td>//header[contains(@id,'banner')]//*[name()='use' and contains(@*,'liferayLogo')]/..</td>
	<td></td>
</tr>
<tr>
	<td>RETURN_TO_LIFERAY</td>
	<td>//a[contains(.,'Return to Liferay')]</td>
	<td></td>
</tr>

<!--LRDCOM Page Navigation -->

<tr>
	<td>PAGE_ACTIVE</td>
	<td>//div[contains(@class,'nav-item') and @aria-selected='true']//span[contains(.,'${key_pageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_CHILD</td>
	<td>//div[span[contains(.,'${key_pageName}')]]//a[contains(.,'${key_childPageName}')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_CHILD_1</td>
	<td>xpath=(//div[span[contains(.,'${key_pageName}')]]//a)[1]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_MAIN</td>
	<td>//div[contains(@class,'primary-nav')]//span[contains(.,'${key_pageName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--Side Menu Navigation-->

<tr>
	<td>NAVIGATION_ACCOUNT_AVATAR</td>
	<td>//div[contains(@class,'account-avatar')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_IN</td>
	<td>//a[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_OUT</td>
	<td>//a[.='Sign Out']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>