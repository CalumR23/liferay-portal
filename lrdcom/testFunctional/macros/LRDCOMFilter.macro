<definition>
	<command name="removeFilter">
		<var name="key_categoryName" value="${categoryName}" />

		<execute function="AssertElementPresent" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMFilter#REMOVE_OPTION" />

		<execute function="Click" locator1="LRDCOMFilter#REMOVE_OPTION" value1="${categoryName}" />

		<execute function="AssertElementNotPresent" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE" />
	</command>

	<command name="selectFilter">
		<var name="key_categoryName" value="${categoryName}" />
		<var name="key_vocabularyName" value="${vocabularyName}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMFilter#SELECT_OPTION" />

		<execute function="Select" locator1="LRDCOMFilter#SELECT_OPTION" value1="${categoryName}" />

		<execute function="AssertElementPresent" locator1="LRDCOMFilter#ASSET_CATEGORY_TITLE" />
		<execute function="AssertElementPresent" locator1="LRDCOMFilter#ASSET_VOCABULARY_TITLE" />
	</command>
</definition>