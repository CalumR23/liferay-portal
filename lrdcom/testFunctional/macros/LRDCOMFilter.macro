definition {

	macro removeFilter {
		var key_categoryName = "${categoryName}";

		AssertElementPresent(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE");

		ScrollWebElementIntoView(locator1 = "LRDCOMFilter#REMOVE_OPTION");

		Click(locator1 = "LRDCOMFilter#REMOVE_OPTION");

		AssertElementNotPresent(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE");
	}

	macro selectFilter {
		var key_categoryName = "${categoryName}";
		var key_vocabularyName = "${vocabularyName}";

		ScrollWebElementIntoView(locator1 = "LRDCOMFilter#SELECT_OPTION");

		Select(
			locator1 = "LRDCOMFilter#SELECT_OPTION",
			value1 = "${categoryName}");

		AssertElementPresent(locator1 = "LRDCOMFilter#ASSET_CATEGORY_TITLE");

		AssertElementPresent(locator1 = "LRDCOMFilter#ASSET_VOCABULARY_TITLE");
	}

}