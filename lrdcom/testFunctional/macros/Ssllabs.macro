definition {

	macro openSsllabs {
		Open(locator1 = "https://www.ssllabs.com/ssltest/analyze.html?d=${serverDomain}");

		if (IsElementPresent(locator1 = "Ssllabs#CLEAR_CACHE_LINK")) {
			AssertClick(
				locator1 = "Ssllabs#CLEAR_CACHE_LINK",
				value1 = "Clear cache");
		}

		AssertElementPresent(locator1 = "Ssllabs#TABLE");
	}

	macro viewGradePG {
		var key_serverIpAddress = "${serverIpAddress}";

		AssertTextEquals(
			locator1 = "Ssllabs#TABLE_SERVER_IP_ADDRESS",
			value1 = "${serverIpAddress}");

		Pause(locator1 = "90000");

		AssertTextEquals(
			locator1 = "Ssllabs#TABLE_SERVER_GRADE",
			value1 = "${serverGrade}");
	}

}