<definition>
	<command name="clickCTALink">
		<if>
			<isset var="linkIndexNumber" />
			<then>
				<var name="key_link" value="${linkName}" />
				<var name="key_linkIndexNumber" value="${linkIndexNumber}" />

				<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA_N" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA_N" value1="${linkName}" />
			</then>
			<else>
				<var name="key_link" value="${linkName}" />

				<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_CTA" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />
			</else>
		</if>
	</command>

	<command name="download">
		<var name="key_title" value="${title}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMButton#DOWNLOAD_TITLE_BUTTON" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMButton#DOWNLOAD_TITLE_BUTTON" value1="Download" />
	</command>

	<command name="viewBlogEntry">
		<var name="key_title" value="${title}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMArticle#BLOGS_ENTRY" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMArticle#BLOGS_ENTRY" value1="${title}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_H1" value1="${title}" />
	</command>

	<command name="viewDXPArticle">
		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#SECTION_H3" value1="${header}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#SECTION_PARAGRAPH" value1="${content}" />
	</command>

	<command name="viewResourceCTALinkHeader">
		<var name="key_link" value="${linkName}" />

		<if>
			<isset var="linkIndexNumber" />
			<then>
				<var name="key_linkIndexNumber" value="${linkIndexNumber}" />

				<var method="selenium#getText(LRDCOMLink#LINK_SECTION_H3_N)" name="resourceTitle" />

				<execute function="ScrollBy" value1="0, 100" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA_N" value1="${linkName}" />
			</then>
			<else>
				<var method="selenium#getText(LRDCOMLink#LINK_SECTION_H3)" name="resourceTitle" />

				<execute function="ScrollBy" value1="0, 100" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />
			</else>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#RESOURCE_H1" value1="${resourceTitle}" />
	</command>

	<command name="viewResourceCTALinkQuote">
		<var name="key_link" value="${linkName}" />

		<if>
			<isset var="linkIndexNumber" />
			<then>
				<var name="key_linkIndexNumber" value="${linkIndexNumber}" />

				<var method="selenium#getText(LRDCOMArticle#SECTION_QUOTE_BY_LINK_N)" name="resourceTitle" />

				<execute function="ScrollBy" value1="0, 100" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA_N" value1="${linkName}" />
			</then>
			<else>
				<var method="selenium#getText(LRDCOMArticle#SECTION_QUOTE_BY_LINK)" name="resourceTitle" />

				<execute function="ScrollBy" value1="0, 100" />

				<execute function="AssertClick" locator1="LRDCOMLink#LINK_CTA" value1="${linkName}" />
			</else>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOMArticle#QUOTE_SECTION" value1="${resourceTitle}" />
	</command>
</definition>