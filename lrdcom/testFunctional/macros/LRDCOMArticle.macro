definition {

	macro clickCTALink {
		if (isSet(linkIndexNumber)) {
			var key_link = "${linkName}";
			var key_linkIndexNumber = "${linkIndexNumber}";

			ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA_N");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA_N",
				value1 = "${linkName}");
		}
		else {
			var key_link = "${linkName}";

			ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_CTA");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA",
				value1 = "${linkName}");
		}
	}

	macro download {
		var key_title = "${title}";

		ScrollWebElementIntoView(locator1 = "LRDCOMButton#DOWNLOAD_TITLE_BUTTON");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMButton#DOWNLOAD_TITLE_BUTTON",
			value1 = "Download");
	}

	macro viewBlogEntry {
		var key_title = "${title}";

		ScrollWebElementIntoView(locator1 = "LRDCOMArticle#BLOGS_ENTRY");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMArticle#BLOGS_ENTRY",
			value1 = "${title}");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#HEADING_H1",
			value1 = "${title}");
	}

	macro viewDXPArticle {
		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#SECTION_H3",
			value1 = "${header}");

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#SECTION_PARAGRAPH",
			value1 = "${content}");
	}

	macro viewResourceCTALinkHeader {
		var key_link = "${linkName}";

		if (isSet(linkIndexNumber)) {
			var key_linkIndexNumber = "${linkIndexNumber}";
			var resourceTitle = selenium.getText("LRDCOMLink#LINK_SECTION_H3_N");

			ScrollBy(value1 = "0, 100");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA_N",
				value1 = "${linkName}");
		}
		else {
			var resourceTitle = selenium.getText("LRDCOMLink#LINK_SECTION_H3");

			ScrollBy(value1 = "0, 100");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA",
				value1 = "${linkName}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#RESOURCE_H1",
			value1 = "${resourceTitle}");
	}

	macro viewResourceCTALinkQuote {
		var key_link = "${linkName}";

		if (isSet(linkIndexNumber)) {
			var key_linkIndexNumber = "${linkIndexNumber}";
			var resourceTitle = selenium.getText("LRDCOMArticle#SECTION_QUOTE_BY_LINK_N");

			ScrollBy(value1 = "0, 100");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA_N",
				value1 = "${linkName}");
		}
		else {
			var resourceTitle = selenium.getText("LRDCOMArticle#SECTION_QUOTE_BY_LINK");

			ScrollBy(value1 = "0, 100");

			AssertClick(
				locator1 = "LRDCOMLink#LINK_CTA",
				value1 = "${linkName}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOMArticle#QUOTE_SECTION",
			value1 = "${resourceTitle}");
	}

}