<definition>
	<command name="viewBlogLink">
		<var name="key_title" value="${title}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_BLOGS_ENTRY" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_BLOGS_ENTRY" value1="${title}" />

		<var method="StringUtil#replace('${title}', 'What Is', 'What is')" name="title" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#HEADING_1" value1="${title}" />
	</command>
</definition>