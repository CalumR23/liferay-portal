definition {

	macro clickSocialIcon {
		var key_title = "${iconTitle}";

		ScrollWebElementIntoView(locator1 = "LRDCOMIcon#ICON_SOCIAL");

		Click(locator1 = "LRDCOMIcon#ICON_SOCIAL");
	}

	macro verifySocialWindowTitle {
		var windowTitle = selenium.getTitle();

		echo("Window Title: ${windowTitle}");

		var argA = StringUtil.startsWith("${windowTitle}", "Liferay");
		var argB = StringUtil.contains("${windowTitle}", "${iconTitle}", " ");
		var argC = StringUtil.contains("${windowTitle}", "Liferay,", " ");

		if ((("${argA}" == "true") && ("${argB}" == "true")) || (("${argB}" == "true") && ("${argC}" == "true"))) {
			Close.closeWindow(locator1 = "title=${windowTitle}");

			SelectWindow.selectWindowTop();
		}
		else {
			fail("ERROR: Check Liferay ${iconTitle} URL link");
		}
	}

	macro viewLiferayLinkedInWindow {
		var windowTitle = selenium.getTitle();

		echo("Window Title: ${windowTitle}");

		var argA = StringUtil.startsWith("${windowTitle}", "Liferay");
		var argB = StringUtil.contains("${windowTitle}", "LinkedIn", " ");

		if (("${argA}" == "true") && ("${argB}" == "true")) {
			Close.closeWindow(locator1 = "title=${socialWindowTitle}");

			SelectWindow.selectWindowTop();
		}
		else {
			var userEmailAddress = PropsUtil.get("lrdcom.email.address.2");
			var userPassword = PropsUtil.get("lrdcom.email.password.2");

			Click(locator1 = "LinkedInLogin#SIGN_IN");

			Type(
				locator1 = "LinkedInLogin#EMAIL_ADDRESS",
				value1 = "${userEmailAddress}");

			Type(
				locator1 = "LinkedInLogin#PASSWORD",
				value1 = "${userPassword}");

			Click(locator1 = "LinkedInLogin#SUBMIT_BUTTON");

			AssertElementNotPresent(locator1 = "LinkedInLogin#SUBMIT_BUTTON");

			LRDCOMFooter.verifySocialWindowTitle(iconTitle = "LinkedIn");
		}
	}

	macro viewSocialIconLinkWindow {
		LRDCOMFooter.clickSocialIcon(iconTitle = "${iconTitle}");

		SelectWindow.selectPopUp(locator1 = "null");

		LRDCOMFooter.verifySocialWindowTitle(iconTitle = "${iconTitle}");
	}

}