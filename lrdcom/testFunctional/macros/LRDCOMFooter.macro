<definition>
	<command name="gotoFooterLink">
		<var name="key_link" value="${linkName}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMLink#LINK_FOOTER" />

		<execute function="AssertClick" locator1="LRDCOMLink#LINK_FOOTER" value1="${linkName}" />
	</command>

	<command name="viewSocialIconLinkWindow">
		<var name="key_title" value="${iconTitle}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="Click" locator1="LRDCOMIcon#ICON_SOCIAL" />

		<execute function="SelectWindow" locator1="title=${socialWindowTitle}" />

		<execute function="Close#closeWindow" locator1="title=${socialWindowTitle}" />

		<execute function="SelectWindow" locator1="${lrdcomWindowTitle}" />
	</command>
</definition>