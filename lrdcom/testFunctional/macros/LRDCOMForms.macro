definition {

	macro submitRequestADemo {
		Type(
			locator1 = "LRDCOMTextInput#FIRST_NAME_2",
			value1 = "${userFirstName}");

		Type(
			locator1 = "LRDCOMTextInput#LAST_NAME_2",
			value1 = "${userLastName}");

		Type(
			locator1 = "LRDCOMTextInput#WORK_EMAIL_2",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "LRDCOMTextInput#PHONE_2",
			value1 = "${userPhone}");

		Type(
			locator1 = "LRDCOMTextInput#COMPANY_2",
			value1 = "${userCompany}");

		Select(
			locator1 = "LRDCOMSelect#COUNTRY_2",
			value1 = "${userCountry}");

		if (IsElementPresent(locator1 = "LRDCOMSelect#STATE_PROVINCE_2")) {
			Select(
				locator1 = "LRDCOMSelect#STATE_PROVINCE_2",
				value1 = "${userStateProvince}");
		}

		AssertClick(
			locator1 = "Button#SUBMIT_2",
			value1 = "Submit");
	}

	macro submitWhitepaperForm {
		Type(
			locator1 = "LRDCOMTextInput#FIRST_NAME_2",
			value1 = "${userFirstName}");

		Type(
			locator1 = "LRDCOMTextInput#LAST_NAME_2",
			value1 = "${userLastName}");

		Type(
			locator1 = "LRDCOMTextInput#WORK_EMAIL_2",
			value1 = "${userEmailAddress}");

		Select(
			locator1 = "LRDCOMSelect#COUNTRY_2",
			value1 = "${userCountry}");

		Select(
			locator1 = "LRDCOMSelect#NUMBER_OF_EMPLOYEES",
			value1 = "${numberOfEmployees}");

		Select(
			locator1 = "LRDCOMSelect#JOB_ROLE",
			value1 = "${userJobRole}");

		Select(
			locator1 = "LRDCOMSelect#I_AM_SOMEONE_WHO",
			value1 = "${userWhoAmI}");

		if (IsElementPresent(locator1 = "LRDCOMSelect#STATE_PROVINCE_2")) {
			Select(
				locator1 = "LRDCOMSelect#STATE_PROVINCE_2",
				value1 = "${userStateProvince}");
		}

		AssertClick(
			locator1 = "Button#SUBMIT_2",
			value1 = "Submit");
	}

}