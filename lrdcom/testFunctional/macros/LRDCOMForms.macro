<definition>
	<command name="submitRequestADemo">
		<execute function="Type" locator1="LRDCOMTextInput#FIRST_NAME_2" value1="${userFirstName}" />
		<execute function="Type" locator1="LRDCOMTextInput#LAST_NAME_2" value1="${userLastName}" />
		<execute function="Type" locator1="LRDCOMTextInput#WORK_EMAIL_2" value1="${userEmailAddress}" />
		<execute function="Type" locator1="LRDCOMTextInput#PHONE_2" value1="${userPhone}" />
		<execute function="Type" locator1="LRDCOMTextInput#COMPANY_2" value1="${userCompany}" />
		<execute function="Select" locator1="LRDCOMSelect#COUNTRY_2" value1="${userCountry}" />

		<if>
			<isset var="state" />
			<then>
				<execute function="Select" locator1="LRDCOMSelect#STATE_PROVINCE_2" value1="${state}" />
			</then>
		</if>

		<execute function="AssertClick" locator1="Button#SUBMIT_2" value1="Submit" />
	</command>
</definition>