<definition>
	<command name="signIn">
		<execute function="Click" locator1="LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR" />

		<execute function="AssertClick" locator1="LRDCOMNavigation#NAVIGATION_MENU_SIGN_IN" value1="Sign In/Create Account" />

		<execute macro="LRDCOMUserSignIn#signIn">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>
	</command>

	<command name="signOut">
		<execute function="Click" locator1="LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR" />

		<execute function="AssertClick" locator1="LRDCOMNavigation#NAVIGATION_MENU_SIGN_OUT" value1="Sign Out" />

		<execute function="WaitForSPARefresh" />

		<var method="selenium#getTitle()" name="windowTitle" />

		<if>
			<not>
				<equals arg1="${windowTitle}" arg2="Liferay: Digital experience software tailored to your needs" />
			</not>
			<then>
				<fail message="Unexpected errors may be present.  After sign out, expected site to redirect to home page titled &quot;Liferay: Digital experience software tailored to your needs&quot;.  Instead the landing page title is &quot;${windowTitle}&quot;" />
			</then>
		</if>

		<execute function="Click" locator1="LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR" />

		<execute function="AssertElementPresent" locator1="LRDCOMNavigation#NAVIGATION_MENU_SIGN_IN" />

		<execute function="Click" locator1="LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR" />
	</command>
</definition>