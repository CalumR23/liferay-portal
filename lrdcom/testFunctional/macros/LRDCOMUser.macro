definition {

	macro signIn {
		Click(locator1 = "LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR");

		AssertClick(
			locator1 = "LRDCOMNavigation#NAVIGATION_MENU_SIGN_IN",
			value1 = "Sign In/Create Account");

		LRDCOMUserSignIn.signIn(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}");
	}

	macro signOut {
		Click(locator1 = "LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR");

		AssertClick(
			locator1 = "LRDCOMNavigation#NAVIGATION_MENU_SIGN_OUT",
			value1 = "Sign Out");

		WaitForSPARefresh();

		var windowTitle = selenium.getTitle();

		if ("${windowTitle}" != "Liferay: Digital experience software tailored to your needs") {
			fail("Unexpected errors may be present.  After sign out, expected site to redirect to home page titled "Liferay: Digital experience software tailored to your needs".  Instead the landing page title is "${windowTitle}"");
		}

		Click(locator1 = "LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR");

		AssertElementPresent(locator1 = "LRDCOMNavigation#NAVIGATION_MENU_SIGN_IN");

		Click(locator1 = "LRDCOMNavigation#NAVIGATION_ACCOUNT_AVATAR");
	}

}