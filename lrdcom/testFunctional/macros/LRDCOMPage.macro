<definition>
	<command name="view">
		<if>
			<isset var="pageName" />
			<then>
				<var name="key_pageName" value="${pageName}" />

				<execute function="AssertVisible" locator1="LRDCOMNavigation#PAGE_ACTIVE" />/>
			</then>
		</if>

		<if>
			<isset var="bannerContent" />
			<then>
				<var name="key_bannerContent" value="${bannerContent}" />

				<execute function="AssertVisible" locator1="LRDCOM#MAIN_BANNER_CONTENT" />
			</then>
		</if>
	</command>
</definition>