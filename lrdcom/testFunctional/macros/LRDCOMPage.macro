definition {

	macro viewActivePage {
		var key_pageName = "${pageName}";

		AssertElementPresent(locator1 = "LRDCOMNavigation#PAGE_ACTIVE");
	}

	macro viewBannerContent {
		var key_bannerContent = "${bannerContent}";

		AssertTextEquals.assertPartialText(
			locator1 = "LRDCOM#MAIN_BANNER_CONTENT",
			value1 = "${bannerContent}");
	}

}