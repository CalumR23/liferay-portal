<definition>
	<command name="viewActivePage">
		<var name="key_pageName" value="${pageName}" />

		<execute function="AssertVisible" locator1="LRDCOMNavigation#PAGE_ACTIVE" />/>
	</command>

	<command name="viewBannerContent">
		<var name="key_bannerContent" value="${bannerContent}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="LRDCOM#MAIN_BANNER_CONTENT" value1="${bannerContent}" />
	</command>
</definition>