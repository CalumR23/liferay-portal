<definition>
	<command name="gotoCardBlock">
		<var name="key_title" value="${title}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_CARD" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_CARD" value1="${title}" />
	</command>

	<command name="gotoChildPagePG">
		<if>
			<isset var="pageName" />
			<then>
				<execute macro="LRDCOMNavigation#gotoPage">
					<var name="pageName" value="${pageName}" />
				</execute>
			</then>
		</if>

		<var name="key_childPageName" value="${childPageName}" />

		<execute function="AssertVisible" locator1="LRDCOMNavigation#PAGE_CHILD" />

		<execute function="Click" locator1="LRDCOMNavigation#PAGE_CHILD" />
	</command>

	<command name="gotoHome">
		<if>
			<condition function="IsElementPresent" locator1="LRDCOM#LOGO_LIFERAY" />
			<then>
				<execute function="Click#clickAt" locator1="LRDCOM#LOGO_LIFERAY" />
			</then>
			<else>
				<execute macro="LRDCOMNavigation#openHomeURL" />
			</else>
		</if>
	</command>

	<command name="gotoIcon">
		<var name="key_iconTitle" value="${iconTitle}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMIcon#ICON" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMIcon#ICON" value1="${iconTitle}" />
	</command>

	<command name="gotoLegoBlock">
		<var name="key_title" value="${title}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMBlockContainer#BLOCK_LEGO" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMBlockContainer#BLOCK_LEGO" value1="${title}" />
	</command>

	<command name="gotoPage" summary="Navigate to the page named '${pageName}'">
		<var name="key_pageName" value="${pageName}" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="LRDCOMNavigation#PAGE_MAIN" value1="${pageName}" />

		<execute function="AssertVisible" locator1="LRDCOMNavigation#PAGE_ACTIVE" />
	</command>

	<command name="openHomeURL">
		<var method="TestPropsUtil#get('lrdcom.web.url')" name="lrdcomURL" />

		<execute function="WaitForSPARefresh" />

		<execute function="Open" locator1="${lrdcomURL}" />
	</command>
</definition>