definition {

	macro gotoCardBlock {
		var key_title = "${title}";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_CARD");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_CARD",
			value1 = "${title}");
	}

	macro gotoFooterLink {
		var key_link = "${linkName}";

		ScrollWebElementIntoView(locator1 = "LRDCOMLink#LINK_FOOTER");

		AssertClick(
			locator1 = "LRDCOMLink#LINK_FOOTER",
			value1 = "${linkName}");
	}

	macro gotoHome {
		if (IsElementPresent(locator1 = "LRDCOMNavigation#LOGO_LIFERAY")) {
			Click.clickAt(locator1 = "LRDCOMNavigation#LOGO_LIFERAY");

			if (IsVisible(locator1 = "LRDCOMNavigation#RETURN_TO_LIFERAY")) {
				Click.clickAt(locator1 = "LRDCOMNavigation#RETURN_TO_LIFERAY");
			}
		}
		else {
			LRDCOMNavigation.openHomeURL();
		}
	}

	macro gotoIcon {
		var key_iconTitle = "${iconTitle}";

		ScrollWebElementIntoView(locator1 = "LRDCOMIcon#ICON");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMIcon#ICON",
			value1 = "${iconTitle}");
	}

	macro gotoLegoBlock {
		var key_title = "${title}";

		ScrollWebElementIntoView(locator1 = "LRDCOMBlockContainer#BLOCK_LEGO");

		AssertClick.assertPartialTextClickAt(
			locator1 = "LRDCOMBlockContainer#BLOCK_LEGO",
			value1 = "${title}");
	}

	@summary = "Navigate to the page named '${pageName}'"
	macro gotoPage {
		var key_pageName = "${pageName}";

		AssertClick(
			locator1 = "LRDCOMNavigation#PAGE_MAIN",
			value1 = "${pageName}");

		if (isSet(childPageName)) {
			var key_childPageName = "${childPageName}";

			Click(locator1 = "LRDCOMNavigation#PAGE_CHILD");

			AssertVisible(locator1 = "LRDCOMNavigation#PAGE_ACTIVE");
		}
		else {
			Click(locator1 = "LRDCOMNavigation#PAGE_CHILD_1");

			AssertVisible(locator1 = "LRDCOMNavigation#PAGE_ACTIVE");
		}
	}

	macro openHomeURL {
		var lrdcomURL = PropsUtil.get("lrdcom.www.url");

		WaitForSPARefresh();

		Open(locator1 = "${lrdcomURL}");
	}

}