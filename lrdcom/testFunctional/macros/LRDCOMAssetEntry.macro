definition {

	macro verifyHidden {
		if (isSet(assetName)) {
			var key_assetName = "${assetName}";

			AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN");
		}
		else {
			var key_entryNumber = "${lastHiddenAssetIndex}";

			AssertElementPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN_X");

			var key_entryNumber = ${key_entryNumber} + 1;

			AssertElementNotPresent(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN_X");
		}
	}

	macro view {
		var key_assetName = "${assetName}";

		ScrollWebElementIntoView(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY");

		AssertVisible(locator1 = "LRDCOMAssetEntry#ASSET_ENTRY");
	}

}