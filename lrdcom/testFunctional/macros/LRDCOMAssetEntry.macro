<definition>
	<command name="view">
		<var method="StringUtil#lowerCase('${assetName}')" name="key_assetName" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMAssetEntry#ASSET_ENTRY_RESOURCES" />

		<execute function="AssertVisible" locator1="LRDCOMAssetEntry#ASSET_ENTRY_RESOURCES" />
	</command>
</definition>