<definition>
	<command name="verifyHidden">
		<if>
			<isset var="assetName" />
			<then>
				<var name="key_assetName" value="${assetName}" />

				<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN" />
			</then>
			<else>
				<var name="key_entryNumber" value="${lastHiddenAssetIndex}" />

				<execute function="AssertElementPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN_X" />

				<var method="MathUtil#sum('${key_entryNumber}', '1')" name="key_entryNumber" />

				<execute function="AssertElementNotPresent" locator1="LRDCOMAssetEntry#ASSET_ENTRY_HIDDEN_X" />
			</else>
		</if>
	</command>

	<command name="view">
		<var name="key_assetName" value="${assetName}" />

		<execute function="ScrollWebElementIntoView" locator1="LRDCOMAssetEntry#ASSET_ENTRY" />

		<execute function="AssertVisible" locator1="LRDCOMAssetEntry#ASSET_ENTRY" />
	</command>
</definition>