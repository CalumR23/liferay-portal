<definition>
	<command name="acceptCookies">
		<if>
			<condition function="IsElementPresent" locator1="LRDCOMButton#COOKIE_ACCEPT_BUTTON" />
			<then>
				<execute function="AssertClick" locator1="LRDCOMButton#COOKIE_ACCEPT_BUTTON" value1="Accept" />
			</then>
		</if>
	</command>

	<command name="checkURLNotBroken">
		<execute function="Open" locator1="${url}" />

		<execute function="AssertElementNotPresent" locator1="LRDCOM#ERROR_PAGE" />
	</command>

	<command name="getBackgroundImageURL">
		<var method="selenium#getAttribute('xpath=(//div[contains(@style,\'background-image\')])[${key_imageNumber}]@style')" name="imageStyleAttribute" />

		<echo message="Image style attribute is: ${imageStyleAttribute}" />

		<var method="StringUtil#extractLast('${imageStyleAttribute}', 'background-image: url(&quot;')" name="partialImageURL" />

		<var method="StringUtil#extractFirst('${partialImageURL}', '&quot;);')" name="imageURL" />

		<var method="StringUtil#startsWith('${imageURL}','/')" name="relativeURL" />

		<if>
			<equals arg1="${relativeURL}" arg2="true" />
			<then>
				<var method="PropsUtil#get('lrdcom.www.url')" name="lrdcomURL" />

				<var method="StringUtil#add('${lrdcomURL}','${imageURL}','')" name="imageURL" />

				<return value="${imageURL}" />
			</then>
			<else>
				<return value="${imageURL}" />
			</else>
		</if>
	</command>

	<command name="getSectionThumbnailImageURL">
		<var method="selenium#getAttribute('//section[contains(.,\'${key_title}\')]//div/a/img@src')" name="imageURL" />

		<var method="StringUtil#startsWith('${imageURL}','/')" name="relativeURL" />

		<if>
			<equals arg1="${relativeURL}" arg2="true" />
			<then>
				<var method="PropsUtil#get('lrdcom.www.url')" name="lrdcomURL" />

				<var method="StringUtil#add('${lrdcomURL}','${imageURL}','')" name="imageURL" />

				<return value="${imageURL}" />
			</then>
			<else>
				<return value="${imageURL}" />
			</else>
		</if>
	</command>
</definition>