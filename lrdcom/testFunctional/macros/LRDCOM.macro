definition {

	macro acceptCookies {
		if (IsElementPresent(locator1 = "LRDCOMButton#COOKIE_ACCEPT_BUTTON")) {
			AssertClick(
				locator1 = "LRDCOMButton#COOKIE_ACCEPT_BUTTON",
				value1 = "Accept");
		}
	}

	macro checkURLNotBroken {
		Open(locator1 = "${url}");

		AssertElementNotPresent(locator1 = "LRDCOM#ERROR_PAGE");
	}

	macro getBackgroundImageURL {
		var imageStyleAttribute = selenium.getAttribute("xpath=(//div[contains(@style,'background-image')])[${key_imageNumber}]@style");

		echo("Image style attribute is: ${imageStyleAttribute}");

		var partialImageURL = StringUtil.extractLast("${imageStyleAttribute}", "background-image: url(\"");

		var imageURL = StringUtil.extractFirst("${partialImageURL}", "\");");

		var relativeURL = StringUtil.startsWith("${imageURL}", "/");

		if ("${relativeURL}" == "true") {
			var lrdcomURL = PropsUtil.get("lrdcom.www.url");

			var imageURL = StringUtil.add("${lrdcomURL}", "${imageURL}", "");

			return "${imageURL}";
		}
		else {
			return "${imageURL}";
		}
	}

	macro getSectionThumbnailImageURL {
		var imageURL = selenium.getAttribute("//section[contains(.,'${key_title}')]//div/a/img@src");

		var relativeURL = StringUtil.startsWith("${imageURL}", "/");

		if ("${relativeURL}" == "true") {
			var lrdcomURL = PropsUtil.get("lrdcom.www.url");

			var imageURL = StringUtil.add("${lrdcomURL}", "${imageURL}", "");

			return "${imageURL}";
		}
		else {
			return "${imageURL}";
		}
	}

}