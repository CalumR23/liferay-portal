<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />
	<property name="timeout.explicit.wait" value="300" />

	<command name="ViewGrades" priority="5">
		<execute function="Open" locator1="https://www.ssllabs.com/ssltest/analyze.html?d=liferay.com" />

		<if>
			<condition function="IsElementPresent" locator1="Ssllabs#CLEAR_CACHE_LINK" />
			<then>
				<execute function="AssertClick" locator1="Ssllabs#CLEAR_CACHE_LINK" value1="Clear cache" />
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="Ssllabs#TABLE" />

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverDomain" value="www.liferay.com" />
			<var name="serverGrade" value="A" />
			<var name="serverIpAddress" value="173.198.31.71" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverDomain" value="liferay.com" />
			<var name="serverGrade" value="A-" />
			<var name="serverIpAddress" value="173.198.31.72" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverDomain" value="liferay.com" />
			<var name="serverGrade" value="A-" />
			<var name="serverIpAddress" value="38.75.15.21" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverDomain" value="www.liferay.com" />
			<var name="serverGrade" value="A" />
			<var name="serverIpAddress" value="38.75.15.20" />
		</execute>
	</command>
</definition>