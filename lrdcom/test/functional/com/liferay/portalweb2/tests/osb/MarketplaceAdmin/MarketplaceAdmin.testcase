<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />

	<var name="appTitle" value="QA Pending" />
	<var name="companyName" value="QA Company" />
	<var name="liferayURL" property-value="portal.url" />
	<var name="marketplaceURL" value="/marketplace" />
	<var name="userEmailAddress1" property-value="marketplace.email.address.1" />
	<var name="userEmailAddress5" property-value="marketplace.email.address.5" />
	<var name="userPassword1" property-value="marketplace.email.password.1" />
	<var name="userPassword5" property-value="marketplace.email.password.5" />

	<set-up>
		<execute macro="User#login">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigation#gotoMarketplace" />

		<execute macro="Registration#setupCompany">
			<var name="companyAddress" value="123 A St" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
			<var name="key_companyName" value="${companyName}" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="Account#setupAppFree">
			<var name="appCategory" value="index=3" />
			<var name="appDescription" value="This is a test of the app making system." />
			<var name="appIconFile" value="marketplace_icon.png" />
			<var name="appTitle" value="${appTitle}" />
			<var name="appWarFile" value="test-app1-portlet-6.2.0.3.war" />
			<var name="developerWebsiteUrl" value="http://www.liferay.com" />
			<var name="isFreePaid" value="free" />
			<var name="supportUrl" value="http://www.liferay.com/marketplace" />
			<var name="versionNumber" value="1.0" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="liferayURL" value="${liferayURL}" />
			<var name="userEmailAddress" value="${userEmailAddress5}" />
			<var name="userPassword" value="${userPassword5}" />
		</execute>

		<execute macro="MarketplaceNavigation#gotoMarketplace" />
	</set-up>

	<tear-down>
		<execute macro="MarketplaceAdmin#tearDownApprovedApp">
			<var name="appTitle" value="${appTitle}" />
			<var name="appWarFile" value="test-app1-portlet-6.2.0.3.war" />
			<var name="companyName" value="${companyName}" />
			<var name="key_appTitle" value="${appTitle}" />
			<var name="liferayURL" value="${liferayURL}" />
			<var name="versionNumber" value="1.0" />
		</execute>

		<execute macro="User#logout" />
	</tear-down>

	<command name="ApproveApp" priority="5">
		<var name="pendingQADenyOrApprove" value="Approve" />
		<var name="requestDenyOrSendToQA" value="Send To QA" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdmin#workflowSubmittedApp">
			<var name="appTitle" value="${appTitle}" />
			<var name="pendingQADenyOrApprove" value="${pendingQADenyOrApprove}" />
			<var name="requestDenyOrSendToQA" value="${requestDenyOrSendToQA}" />
		</execute>
	</command>

	<command name="DenyAppViaQA" priority="5">
		<var name="pendingQADenyOrApprove" value="Deny App" />
		<var name="requestDenyOrSendToQA" value="Send To QA" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdmin#workflowSubmittedApp">
			<var name="appTitle" value="${appTitle}" />
			<var name="pendingQADenyOrApprove" value="${pendingQADenyOrApprove}" />
			<var name="requestDenyOrSendToQA" value="${requestDenyOrSendToQA}" />
		</execute>
	</command>

	<command name="DenyCompany" priority="5">
		<var name="companyName" value="QA Company Deny" />	

		<execute macro="User#logoutAndLogin">
			<var name="liferayURL" value="${liferayURL}" />
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigation#gotoMarketplace" />

		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />
		<if>
			<condition function="IsElementNotPresent" locator1="MPNavigation#COMPANY_SITE" />
			<then>
				<execute macro="MarketplaceNavigation#gotoBecomeDeveloper" />

				<execute macro="Registration#searchForCompany">
					<var name="companyName" value="${companyName}" />
				</execute>

				<execute macro="Registration#registerNewCompany">
					<var name="companyAddress" value="123 A St" />
					<var name="companyCity" value="Los Angeles" />
					<var name="companyCountry" value="United States" />
					<var name="companyDescription" value="This is a test." />
					<var name="companyEmail" value="${userEmailAddress1}" />
					<var name="companyIcon" value="Document_3.png" />
					<var name="companyName" value="${companyName}" />
					<var name="companyPhone" value="555-555-5555" />
					<var name="companyPostalCode" value="90210" />
					<var name="companyRegion" value="California" />
					<var name="companyTaxDocument" value="Document_1.pdf" />
					<var name="companyTaxType" value="Other" />
					<var name="key_companyName" value="${companyName}" />
				</execute>
			</then>
		</if>

		<execute macro="User#logoutAndLogin">
				<var name="liferayURL" value="${liferayURL}" />
				<var name="userEmailAddress" value="${userEmailAddress5}" />
				<var name="userPassword" value="${userPassword5}" />
		</execute>

		<execute macro="MarketplaceNavigation#gotoMarketplace" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="key_companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#denyOrApproveCompany">
			<var name="denyOrPass" value="Deny" />
		</execute>
	</command>
</definition>