<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />

	<set-up>
		<var method="TestPropsUtil#get('portal.url')" name="marketplaceURL" />

		<execute macro="User#login">
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />
	</set-up>

	<tear-down>
		<execute macro="Registration#tearDownJoinCompany" />
		<execute macro="User#logout" />
	</tear-down>

	<command name="EditSubmission" priority="5">
		<var name="companyName" value="QA Company Edit" />

		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

		<execute macro="Registration#registerNewCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a company description." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="QA Company Edit" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

		<execute function="AssertTextPresent" locator1="MPRegistration#PENDING_REGISTRATIONS" value1="Pending Registrations" />

		<execute macro="Registration#editCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is an edited company description." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="QA Company Edit" />
			<var name="companyNameEdited" value="QA Company Edited" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
		</execute>

		<execute macro="Registration#viewCompanyProfile">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is an edited company description." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyName" value="QA Company Edited" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
		</execute>
	</command>

	<command name="JoinCompany" priority="5">
		<var name="companyName" value="QA Company Join" />
		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />
		<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress2" />
		<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword1" />
		<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword2" />

		<execute macro="Registration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test for joining a company." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress2}" />
			<var name="userPassword" value="${userPassword2}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute macro="Registration#searchForCompany">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="Registration#requestJoinCompany" >
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="Registration#confirmMembershipRequest">
			<var name="userEmailAddress" value="${userEmailAddress2}" />
		</execute>
	</command>

	<command name="RegisterDuplicateCompany" priority="5">
		<var name="companyName" value="QA Company Duplicate" />
		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />
		<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword1" />

		<execute macro="Registration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test to create a duplicate company." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

		<execute function="Click" locator1="MPRegistrationCompany#REGISTER_BUTTON" />

		<execute function="Click" locator1="MPRegistrationCompany#LOGO_BUTTON" />

		<execute macro="Sikuli#uploadFile">
			<var name="fileName" value="Document_3.png" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyName">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyDescription">
			<var name="companyDescription" value="This is a test to create a duplicate company." />
		</execute>

		<execute macro="RegistrationEntry#typeAddressLine1">
			<var name="companyAddress" value="123 Main Street" />
		</execute>

		<execute macro="RegistrationEntry#selectCountry">
			<var name="companyCountry" value="United States" />
		</execute>

		<execute macro="RegistrationEntry#selectRegion">
			<var name="companyRegion" value="California" />
		</execute>

		<execute macro="RegistrationEntry#typeCity">
			<var name="companyCity" value="Los Angeles" />
		</execute>

		<execute macro="RegistrationEntry#typePostalCode">
			<var name="companyPostalCode" value="90210" />
		</execute>

		<execute macro="RegistrationEntry#typePhone">
			<var name="companyPhone" value="555-555-5555" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyEmail">
			<var name="companyEmail" value="${userEmailAddress1}" />
		</execute>

		<execute function="Click" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON" />

		<execute macro="Sikuli#uploadFile">
			<var name="fileName" value="Document_1.pdf" />
		</execute>

		<execute macro="RegistrationEntry#selectTaxDocumentType">
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="RegistrationEntry#checkAgree" />

		<execute function="Click" locator1="MPRegistrationCompany#SUBMIT_REQUEST" />

		<execute function="AssertTextEquals" locator1="Message#FAIL_MESSAGE" value1="Your request failed to complete." />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#DUPLICATE_COMPANY_ERROR_MESSAGE" value1="Your company is already registered." />
	</command>

	<command name="RegisterNewCompany" priority="5">
		<var name="companyAddress" value="123 A St" />
		<var name="companyCity" value="Los Angeles" />
		<var name="companyCountry" value="United States" />
		<var name="companyDescription" value="This is a test." />
		<var name="companyEmail" value="${userEmailAddress1}" />
		<var name="companyIcon" value="Document_3.png" />
		<var name="companyName" value="QA Company Test" />
		<var name="companyPhone" value="555-555-5555" />
		<var name="companyPostalCode" value="90210" />
		<var name="companyRegion" value="California" />
		<var name="companyTaxDocument" value="Document_1.pdf" />
		<var name="companyTaxType" value="Other" />
		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute macro="Registration#searchForCompany">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="Registration#registerNewCompany">
			<var name="companyAddress" value="${companyAddress}" />
			<var name="companyCity" value="${companyCity}" />
			<var name="companyCountry" value="${companyCountry}" />
			<var name="companyDescription" value="${companyDescription}" />
			<var name="companyEmail" value="${companyEmail}" />
			<var name="companyIcon" value="${companyIcon}" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="${companyPhone}" />
			<var name="companyPostalCode" value="${companyPostalCode}" />
			<var name="companyRegion" value="${companyRegion}" />
			<var name="companyTaxDocument" value="${companyTaxDocument}" />
			<var name="companyTaxType" value="${companyTaxType}" />
		</execute>
	</command>

	<command name="RegisterPaidCompanyCancel" priority="5">
		<var name="companyName" value="QA Company Cancel" />
		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />
		<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress3" />
		<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword1" />

		<execute macro="Registration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount" >
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Click" locator1="Button#ADD_NEW_APP_BUTTON" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute macro="Registration#convertToPaidDeveloperEnterAccountInfo">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#requestFailed" />

		<execute function="Click" locator1="MPRegistrationDeveloper#BACK_BUTTON" />

		<execute function="AssertTextEquals" locator1="MPDeveloperAppsAdd#DETAILS" value1="App Details" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute macro="Registration#convertToPaidDeveloperEnterAccountInfo">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="RegistrationEntry#typeFirstName">
			<var name="firstName" value="Joe" />
		</execute>

		<execute macro="RegistrationEntry#typeLastName">
			<var name="lastName" value="WrongName" />
		</execute>

		<execute macro="RegistrationEntry#typePaymentEmail">
			<var name="paymentEmailAddress" value="${userEmailAddress3}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#requestFailed" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Back" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#CIRCLE_NUMBER" value1="1" />

		<execute macro="Registration#convertToPaidDeveloperEnterAccountInfo">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="RegistrationEntry#typeFirstName">
			<var name="firstName" value="Joe" />
		</execute>

		<execute macro="RegistrationEntry#typeLastName">
			<var name="lastName" value="Bloggs" />
		</execute>

		<execute macro="RegistrationEntry#typePaymentEmail">
			<var name="paymentEmailAddress" value="${userEmailAddress3}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />

		<execute macro="Button#cancel" />

		<execute function="AssertTextEquals" locator1="MPDeveloperAppsAdd#DETAILS" value1="App Details" />
	</command>

	<command name="RenewCompanyPaid" priority="5">
		<var name="companyName" value="QA Company Renew" />
		<var method="TestPropsUtil#get('portal.url')" name="marketplaceURL" />
		<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress1" />
		<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress3" />
		<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress5" />
		<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword1" />
		<var method="TestPropsUtil#get('marketplace.email.password.3')" name="userPassword3" />
		<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword5" />

		<execute macro="Registration#setupCompany">
			<var name="companyAddress" value="123 A St" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var name="companyEmail" value="${userEmailAddress1}" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="QA Company Renew" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
			<var name="key_companyName" value="${companyName}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute macro="Button#addNewApp" />

		<execute macro="Registration#convertToPaidDeveloperAccount">
			<var name="companyName" value="${companyName}" />
			<var name="userEmailAddress3" value="${userEmailAddress3}" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress5}" />
			<var name="userPassword" value="${userPassword5}" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute function="AssertClick" locator1="MPAdminDevelopers#APPROVE_PAID_DEVELOPER_STATUS_BUTTON" value1="Approve Paid Developer Status" />

		<execute macro="Message#success" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#expirePaidStatus" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="User#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress1}" />
			<var name="userPassword" value="${userPassword1}" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute macro="Button#addNewApp" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#PAID_DEVELOPER_ACCOUNT_PAGE_TITLE" value1="Renew Paid App Developer Account" />

		<execute macro="Button#next" />

		<execute function="AssertElementNotPresent" locator1="MPDeveloperAppsAddDetails#UPGRADE" />
	</command>
</definition>