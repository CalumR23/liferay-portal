			<var name="appDescription" value="Non-Perpetual License, Trial." />
			<var name="appIconFile" value="marketplace_icon.png" />
			<var name="appTitle" value="QA.NT" />
			<var name="appWarFile" value="test-app3-portlet-6.2.0.3.war" />
