<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />

	<set-up>
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />
	</set-up>

	<tear-down>
		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword" />
		</execute>

		<execute macro="Account#tearDownSubmittedApp" >
			<var name="appTitleList" value="QA.Buy.F,QA.Buy.PST,QA.Buy.PT,QA.Buy.NT" />
			<var name="companyNameList" value="Account Home" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<for list="QA.Buy.F,QA.Buy.PST,QA.Buy.PT,QA.Buy.NT" param="appTitle">
			<execute macro="Marketplace#tearDownPurchase">
				<var name="appTitle" value="${appTitle}" />
			</execute>
		</for>

		<execute macro="User#logout" />
	</tear-down>

	<command name="PurchaseFreeAppViaProject" priority="5">
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="Account#setupAndSubmitApp">
			<var name="appCategory" value="index=3" />
			<var name="appDescription" value="Free License" />
			<var name="appFileList" value="test-app-portlet-6.2.0.3.war" />
			<var name="appIconFile" value="marketplace_icon.png" />
			<var name="appTitle" value="QA.Buy.F" />
			<var name="companyName" value="Account Home" />
			<var name="developerWebsiteUrl" value="http://www.liferay.com/developer" />
			<var name="doApprove" value="true" />
			<var name="isFreePaid" value="free" />
			<var name="isTrial" value="true" />
			<var name="portalVersionShort" value="6200" />
			<var name="supportUrl" value="http://www.liferay.com/support" />
			<var name="versionNumber" value="1.0.0.0" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigator#searchForApp">
			<var name="appTitle" value="QA.Buy.F" />
		</execute>

		<execute macro="Marketplace#purchaseFreeApp">
			<var name="legalEntityName" value="QA.Buy.Project.Free" />
			<var name="projectName" value="QA.Buy.Project.Free" />
		</execute>

		<execute macro="AccountNavigator#gotoUserAppViaProjects">
			<var name="appTitle" value="QA.Buy.F" />
			<var name="projectName" value="QA.Buy.Project.Free" />
		</execute>
	</command>

	<command name="PurchasePaidAppAndAddAdditionalUnitsViaProject" priority="5">
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="Account#setupAndSubmitApp">
			<var name="addCountryList" value="all" />
			<var name="appCategory" value="index=3" />
			<var name="appDescription" value="Paid License, Trial" />
			<var name="appFileList" value="test-app-portlet-6.2.0.3.war" />
			<var name="appIconFile" value="marketplace_icon.png" />
			<var name="appTitle" value="QA.Buy.PT" />
			<var name="companyName" value="Account Home" />
			<var name="currencyList" value="USD" />
			<var name="developerLicensePriceList" value="10.00" />
			<var name="developerLicenseUnitsList" value="1" />
			<var name="developerWebsiteUrl" value="http://www.liferay.com/developer" />
			<var name="doApprove" value="true" />
			<var name="isFreePaid" value="paid-license" />
			<var name="isTrial" value="true" />
			<var name="licenseTerm" value="Perpetual" />
			<var name="portalVersionShort" value="6200" />
			<var name="standardLicensePriceList" value="10.00" />
			<var name="standardLicenseUnitsList" value="1" />
			<var name="supportUrl" value="http://www.liferay.com/support" />
			<var name="versionNumber" value="1.0.0.0" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigator#searchForApp">
			<var name="appTitle" value="QA.Buy.PT" />
		</execute>

		<execute macro="Marketplace#purchasePaidApp">
			<var name="destinationAddressName" value="QA.Buy.Project.Paid" />
			<var name="developerLicenseQuantityList" value="1" />
			<var name="legalEntityName" value="QA.Buy.Project.Paid" />
			<var name="paymentMethod" value="Pay Now" />
			<var name="projectName" value="QA.Buy.Project.Paid" />
			<var name="standardLicenseQuantityList" value="1" />
		</execute>

		<execute macro="AccountNavigator#gotoUserAppViaProjects">
			<var name="appTitle" value="QA.Buy.PT" />
			<var name="projectName" value="QA.Buy.Project.Paid" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigator#searchForApp">
			<var name="appTitle" value="QA.Buy.PT" />
		</execute>

		<execute macro="Marketplace#purchasePaidApp">
			<var name="destinationAddressName" value="QA.Buy.Project.Paid" />
			<var name="developerLicenseQuantityList" value="1" />
			<var name="legalEntityName" value="QA.Buy.Project.Paid" />
			<var name="licensePurchaseType" value="add" />
			<var name="paymentMethod" value="Pay Now" />
			<var name="projectName" value="QA.Buy.Project.Paid" />
			<var name="standardLicenseQuantityList" value="1" />
		</execute>

		<execute macro="AccountNavigator#gotoUserAppViaProjects">
			<var name="appTitle" value="QA.Buy.PT" />
			<var name="projectName" value="QA.Buy.Project.Paid" />
		</execute>
	</command>

