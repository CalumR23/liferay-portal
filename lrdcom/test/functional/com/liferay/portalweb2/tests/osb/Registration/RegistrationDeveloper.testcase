<definition component-name="marketplace">
	<property name="testray.main.component.name" value="MarketplaceRegistration" />

	<set-up>
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="User#login">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />
	</set-up>

	<tear-down>
		<execute macro="User#logout" />
	</tear-down>

	<command name="RegisterDeveloperFree" priority="5">
		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute macro="Registration#registerNewDeveloper">
			<var name="developerCountry" value="United States" />
			<var name="developerPhone" value="555-555-5555" />
		</execute>
	</command>

	<command name="RegisterDeveloperPaid" priority="5">
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute macro="Registration#registerNewDeveloper">
			<var name="developerCountry" value="United States" />
			<var name="developerPhone" value="555-555-5555" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigationBar#gotoAccountHome" />

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Click" locator1="Button#ADD_NEW_APP_BUTTON" />

		<execute macro="Registration#convertToPaidDeveloperAccount">
			<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress3" />
		</execute>
	</command>

	<command name="RenewPaidDeveloperRegistration" priority="5">
		<var name="companyName" value="QA 1" />
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

		<execute macro="Registration#registerNewDeveloper">
			<var name="developerCountry" value="United States" />
			<var name="developerPhone" value="555-555-5555" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigationBar#gotoAccountHome" />

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="Button#AGREE_BUTTON" />
			<then>
				<execute function="Click" locator1="Button#AGREE_BUTTON" />
			</then>
		</if>

		<execute function="Click" locator1="Button#ADD_NEW_APP_BUTTON" />

		<execute macro="Registration#convertToPaidDeveloperAccount">
			<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress" />
		</execute>

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute function="AssertClick" locator1="MPAdminDevelopers#APPROVE_PAID_DEVELOPER_STATUS_BUTTON" value1="Approve Paid Developer Status" />

		<execute macro="Message#success" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#expirePaidStatus" />

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigationBar#gotoAccountHome" />

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Click" locator1="Button#ADD_NEW_APP_BUTTON" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#PAID_DEVELOPER_ACCOUNT_PAGE_TITLE" value1="Renew Paid App Developer Account" />

		<execute macro="Button#next" />

		<execute function="AssertElementNotPresent" locator1="MPDeveloperAppsAddDetails#UPGRADE" />
	</command>
</definition>