<html>
<head>
<title>MPPurchaseLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPPurchaseLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPPurchaseLicense</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_INSTANCE_QUANTITY</td>
	<td>//th[contains(.,' Standard License ')]/../..//td[contains(.,'${key_units} Instance Unit')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_INSTANCE_QUANTITY</td>
	<td>//th[contains(.,' Developer License ')]/../..//td[contains(.,'${key_units} Instance Unit')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASE_TYPE_RADIO</td>
	<td>//label[contains(.,'${key_licensePurchaseType}')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SERVICES_TYPE_CHECKBOX</td>
	<td>//label[contains(.,'Subscription Services for ${key_renewSubscriptionType} License')]/..//input[2]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>