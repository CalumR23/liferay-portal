<html>
<head>
<title>MPAdminApps</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminApps</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAdminApps</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>MANAGE</td>
	<td>//a[contains(.,'Manage')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUESTS</td>
	<td>//a[contains(.,'Requests')]</td>
	<td></td>
</tr>
<tr>
	<td>PENDING_QA</td>
	<td>//a[contains(.,'Pending QA')]</td>
	<td></td>
</tr>
<tr>
	<td>DENIED</td>
	<td>//a[contains(.,'Denied')]</td>
	<td></td>
</tr>
<tr>
	<td>DISABLED</td>
	<td>//a[contains(.,'Disabled')]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_FIELD</td>
	<td>//label[contains(@for,title)]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_MENU</td>
	<td>//select[contains(@id,'CategoryId')]</td>
	<td></td>
</tr>
<tr>
	<td>HIDE_LIFERAY_APPS_CHECKBOX</td>
	<td>//input[contains(@name,'hideliferayApp')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[contains(@value,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>TITLE_SORT</td>
	<td>//th[contains(@id,'title')]/span</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_SORT</td>
	<td>//th[contains(@id,'developer')]/span</td>
	<td></td>
</tr>
<tr>
	<td>APP_TITLE</td>
	<td>//a[contains(.,'${key_appTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER</td>
	<td>//a[contains(.,'${key_developerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY</td>
	<td>//a[contains(.,'${key_categoryName}')]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS</td>
	<td>//a[contains(.,'${key_appStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>MODIFIED_DATE</td>
	<td>//a[contains(@href,'modified-date')]</td>
	<td></td>
</tr>
<tr>
	<td>STATUS_DATE</td>
	<td>//a[contains(@href,'status-date')]</td>
	<td></td>
</tr>
<tr>
	<td>ITEMS_PER_PAGE</td>
	<td>//select[contains(@id,'itemsPerPage')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_NUMBER</td>
	<td>//select[contains(@id,'page')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_PAGE</td>
	<td>//span[contains(@class,'first')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_PAGE</td>
	<td>//span[contains(@class,'previous')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_PAGE</td>
	<td>//span[contains(@class,'next')]</td>
	<td></td>
</tr>
<tr>
	<td>LAST_PAGE</td>
	<td>//span[contains(@class,'last')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_TAB</td>
	<td>//a[contains(@href,'preview')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_TAB</td>
	<td>//a[contains(@href,'details')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENTS_TAB</td>
	<td>//a[contains(@href,'comments')]</td>
	<td></td>
</tr>
<tr>
	<td>PACL_PROPERTIES_TAB</td>
	<td>//a[contains(@href,'pacl-properties')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSES_TAB</td>
	<td>//a[contains(@href,'licenses')]</td>
	<td></td>
</tr>
<tr>
	<td>PRICING_TAB</td>
	<td>//a[contains(@href,'pricing')]</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[contains(@class,'success')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>