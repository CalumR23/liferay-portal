<html>
<head>
<title>MPTransactions</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPTransactions</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPTransactions</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--First row-->
<tr>
	<td>PURCHASED_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>TXN_ID_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[2]/a</td>
	<td></td>
</tr>
<tr>
	<td>APP_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[3]/a</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_BY_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[4]/a</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[5]/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_TOTAL_1</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[3]/td[6]/a</td>
	<td></td>
</tr>

<!--N'th row (2 is added to get desired row)-->
<tr>
	<td>PURCHASED_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>TXN_ID_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[2]/a</td>
	<td></td>
</tr>
<tr>
	<td>APP_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[3]/a</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_BY_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[4]/a</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[5]/a</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_TOTAL_I</td>
	<td>//div[contains(@class,'lfr-search-container')]/div/div/table/tbody/tr[${key_itemRow}+2]/td[6]/a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>