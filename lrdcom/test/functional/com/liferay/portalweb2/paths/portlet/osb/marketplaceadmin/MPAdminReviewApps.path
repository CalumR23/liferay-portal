<html>
<head>
<title>MPAdminReviewApps</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminReviewApps</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAdminReviewApps</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--App Preview-->
<tr>
	<td>PREVIEW_APP_TITLE</td>
	<td>//div[contains(@class,'title')]/h1</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_APP_DEVELOPER</td>
	<td>//div[contains(@class,'owner')]/a</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_APP_ENTRY_ID</td>
	<td>//span[contains(.,'${key_appEntryId}')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_LATEST_APP_VERSION_ID</td>
	<td>//span[contains(.,'${key_latestAppVersionId}')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_APP_STATUS</td>
	<td>//label[contains(.,'App Status')]/..//span[contains(.,'${key_appStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>PREVIEW_VERSION_STATUS</td>
	<td>//label[contains(.,'Version Status')]/..//span[contains(.,'${key_versionStatus}')]</td>
	<td></td>
</tr>
<tr>
	<td>APPROVE</td>
	<td>//input[contains(@value,'Approve')]</td>
	<td></td>
</tr>
<tr>
	<td>SEND_TO_QA</td>
	<td>//input[contains(@value,'Send To QA')]</td>
	<td></td>
</tr>
<tr>
	<td>DENY_APP</td>
	<td>//input[contains(@value,'Deny App')]</td>
	<td></td>
</tr>
<tr>
	<td>DENY_BUTTON</td>
	<td>//input[contains(@value,'Deny')]</td>
	<td></td>
</tr>
<tr>
	<td>REJECT_APP</td>
	<td>//input[contains(@value,'Reject App')]</td>
	<td></td>
</tr>
<!--App Details-->
<tr>
	<td>OWNER_TYPE</td>
	<td>//td[contains(.,'Type')]/..//td[contains(.,'${key_ownerType}')]</td>
	<td></td>
</tr>
<tr>
	<td>OWNER_NAME</td>
	<td>//td[contains(.,'Name')]/..//td/a[contains(.,'${key_ownerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>OWNER_EMAIL_ADDRESS</td>
	<td>//td[contains(.,'Email Address')]/..//td/a[contains(.,'${key_companyEmailAddress}')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOADER</td>
	<td>//td[contains(.,'Uploader')]/..//td[contains(.,'${key_uploaderName}')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_APP_ENTRY_ID</td>
	<td>//td[contains(.,'App Entry ID')]/..//td[contains(.,'$key_appEntryId')]</td>
	<td></td>
</tr>
<tr>
	<td>APPROVED_DETAIL_ASSET_ENTRY</td>
	<td>//td[contains(.,'${key_assetEntry')]/..//td[contains(@class,'approved')]</td>
	<td></td>
</tr>
<tr>
	<td>LATEST_DETAIL_ASSET_ENTRY</td>
	<td>//td[contains(.,'${key_assetEntry}')]/..//td[contains(@class,'latest')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>