<html>
<head>
<title>MPPurchaseDestination</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPPurchaseDestination</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPPurchaseDestination</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ADDRESS_BUTTON</td>
	<td>//div[contains(.,'${key_CompanyName}')]/../..//a[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_NEW_ADDRESS</td>
	<td>//div[contains(@class,'new-address')]/div</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_CARD</td>
	<td>//div[contains(@class,'card-body')]/div[contains(.,'${key_CompanyName}')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_COMPANY_NAME</td>
	<td>//div[contains(@class,'card destination-address')]/div/div/div</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_STREET_1</td>
	<td>//input[contains(@id,'street1')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_STREET_2</td>
	<td>//input[contains(@id,'street2')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_STREET_3</td>
	<td>//input[contains(@id,'street3')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_COUNTRY</td>
	<td>//label[contains(.,'Country')]/../span</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_REGION</td>
	<td>//select[contains(@id,'regionId')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_CITY</td>
	<td>//input[contains(@id,'city')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_ZIP</td>
	<td>//input[contains(@id,'zip')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>