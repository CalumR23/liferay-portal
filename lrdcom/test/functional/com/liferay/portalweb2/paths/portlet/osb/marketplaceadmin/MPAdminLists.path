<html>
<head>
<title>MPAdminLists</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminLists</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAdminLists</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_MENU</td>
	<td>//select[contains(@id,'category')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//input[contains(@value,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td>FEATURED_APPS_ADD</td>
	<td>//div[contains(.,'Featured Apps')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>NEW_AND_INTERESTING_ADD</td>
	<td>//div[contains(.,'New and Interesting')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>BANNER_ADD</td>
	<td>//div[contains(.,'Banner')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>CENTER_AD_1_ADD</td>
	<td>//div[contains(.,'Medium Sized Center Ad #1')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>CENTER_AD_2_ADD</td>
	<td>//div[contains(.,'Medium Sized Center Ad #2')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>CENTER_AD_3_ADD</td>
	<td>//div[contains(.,'Medium Sized Center Ad #3')]/a[contains(@class,'add-asset-entry')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_APP</td>
	<td>//span[contains(.,'${key_appName}')]/../../..//a[contains(@class,'remove')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_ENTRY</td>
	<td>//span[contains(.,'${key_appName')]/../../../</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>