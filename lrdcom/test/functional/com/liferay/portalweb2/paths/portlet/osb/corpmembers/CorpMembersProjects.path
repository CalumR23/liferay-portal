<html>
<head>
<title>CorpMembersProjects</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">CorpMembersProjects</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>CorpMembersProjects</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--Membership Requests-->
<tr>
	<td>SELECT_ALL_CHECKBOX</td>
	<td>//div/span[contains(@class,'select-all')]/input</td>
	<td></td>
</tr>
<tr>
	<td>CONFIRM_SELECTED</td>
	<td>//div/span[contains(@class,'confirm')]/span/input</td>
	<td></td>
</tr>
<tr>
	<td>IGNORE_SELECTECED</td>
	<td>//div/span[contains(@class,'ignor')]/span/input</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_USER_CHECKBOX</td>
	<td>//div/table/tbody/tr[${key_memberRequestRow}+2]/td[1]/input</td>
	<td></td>
</tr>1
<tr>
	<td>MEMBERSHIP_REQUEST_NAME</td>
	<td>//td[contains(@class,'col-name')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBERSHIP_REQUEST_EMAIL_ADDRESS</td>
	<td>//td[contains(@class,'col-email-address')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBERSHIP_REQUEST_USER_CONFIRM_BUTTON</td>
	<td>//td[contains(.,'${key_userEmailAddress}')]/..//input[contains(@value,'Confirm')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBERSHIP_REQUEST_USER_IGNORE_BUTTON</td>
	<td>//td[contains(.,'${key_userEmailAddress}')]/..//input[contains(@value,'Ignore')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBERSHIP_REQUEST_USER_RESEND_EMAIL_BUTTON</td>
	<td>//td[contains(.,'${key_userEmailAddress}')]/..//input[contains(@value,'Resend Email')]</td>
	<td></td>
</tr>
<!--Company members-->
<tr>
	<td>SEARCH_FIELD</td>
	<td>//div[contains(@class,'search')]/span/span/span/input</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//div[contains(@class,'search')]/span/span/input</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_NAME</td>
	<td>//div[@class='company-members']//td[contains(@class,'col-name')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_USER_ADMIN_CHECKBOX</td>
	<td>//div[@class='company-members']//td[contains(@class,'col-name')]/..//input[contains(@id,'userAdmin') and contains(@type,'checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>MEMBER_DEVELOPER_CHECKBOX</td>
	<td>//div[@class='company-members']//td[contains(@class,'col-name')]/..//input[contains(@id,'developer') and contains(@type,'checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_USER_BUTTON</td>
	<td>//a[contains(@class,'unset-user-button')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>