<html>
<head>
<title>MPDeveloperApps</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperApps</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPDeveloperApps</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--Main-->
<tr>
	<td>APP_TITLE</td>
	<td>//a[contains(.,'${key_appTitle}')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_BUTTON</td>
	<td>//div/a[contains(.,'Add New App')]</td>
	<td></td>
</tr>
<tr>
	<td>BACK_BUTTON</td>
	<td>//div/a[contains(.,'Back to All Apps')]</td>
	<td></td>
</tr>
<!--Summary-->
<tr>
	<td>SUMMARY_TYPE</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_CATEGORY</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_STATUS</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_LICENSE</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_SUPPORT</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_TRIAL</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[6]</td>
	<td></td>
</tr>
<!--App View-->
<tr>
	<td>PREVIEW_BUTTON</td>
	<td>//div/a[contains(.,'App Preview')]</td>
	<td></td>
</tr>
<tr>
	<td>PRICING_BUTTON</td>
	<td>//div/a[contains(.,'App Pricing')]</td>
	<td></td>
</tr>
<!--App Preview-->
<tr>
	<td>APP_NAME</td>
	<td>//div[@class='app-heading']/div[@class='title']/h1</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME</td>
	<td>//div[@class='app-heading']/div[@class='title']/div[@class='owner']/a</td>
	<td></td>
</tr>
<tr>
	<td>SECURITY_ENABLED</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SUBSCRIPTION_SERVICES</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION</td>
	<td>//div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>LATEST_CHANGES</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>TAGS</td>
	<td>//li[contains(.,'Latest Version')]</td>
	<td></td>
</tr>
<tr>
	<td>VERSION</td>
	<td>//li[contains(.,'Latest Version')]</td>
	<td></td>
</tr>
<!--Versions-->
<tr>
	<td>VERSION_NUMBER_1</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>COMPATABILITY_1</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DATE_CREATED_1</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOADS_1</td>
	<td></td>
	<td></td>
</tr>

<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--App Pricing-->
<tr>
	<td>STANDARD_PRICE_1</td>
	<td>//div[@class='prices']/div[@class='column standard']/div[@class='price']</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_ALLOTMENT_1</td>
	<td>//div[@class='prices']/div[@class='column standard']/div[@class='license-type-allotment']</td>
	<td></td>
</tr>

<tr>
	<td>DEVELOPMENT_PRICE_1</td>
	<td>//div[@class='prices']/div[@class='column developer']/div[@class='price']</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPMENT_ALLOTMENT_1</td>
	<td>//div[@class='prices']/div[@class='column developer']/div[@class='license-type-allotment']</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRIES_1</td>
	<td>//div[@class='pricing-display-body']/div/div[@class='countries']/ul/li</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--App Controls-->
<tr>
	<td>EDIT_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_PRICING_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Update Pricing')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_NEW_VERSION_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Add New Version')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_FOR_REVIEW_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Submit for Review')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_FROM_STORE_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/div/a[contains(.,'Remove from Store')]</td>
	<td></td>
</tr>
<tr>
	<td>DISCARD_CHANGES</td>
	<td>//a[contains(.,'Discard Changes')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_SUBMISSION</td>
	<td>//input[contains(@value,'Cancel Submission')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>