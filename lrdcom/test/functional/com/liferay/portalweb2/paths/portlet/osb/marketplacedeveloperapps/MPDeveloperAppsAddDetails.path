<html>
<head>
<title>MPDeveloperAppsAddDetails</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperAppsAddDetails</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPDeveloperAppsAddDetails</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--App Pricing-->
<tr>
	<td>PRICE_RADIO</td>
	<td>//span[contains(@class,'${key_isFreePaid}-radio')]/span/span/input</td>
	<td></td>
</tr>
<tr>
	<td>UPGRADE</td>
	<td>//a[.='upgrade your developer account']</td>
	<td></td>
</tr>
<!--App Information-->
<tr>
	<td>TITLE</td>
	<td>//input[contains(@name,'title')]</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION</td>
	<td>//textarea[contains(@name,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>LOCALIZED_CHECKBOX</td>
	<td>//div/span/span/span/span/input[contains(@name,'descriptionLocalizedCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>ICON_BROWSE_BUTTON</td>
	<td>//div[contains(@class,'edit-icon')]/span/span/span/input</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_CAPTURES_BROWSE_BUTTON</td>
	<td>//div[contains(@class,'lfr-upload-movie-content')]/object</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_SELECT</td>
	<td>//select[contains(@name,"Category")]</td>
	<td></td>
</tr>
<tr>
	<td>DEV_DOC_SUP_SRC_URL</td>
	<td>//label[contains(.,'Developer')]/../span/input</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_WEBSITE_URL</td>
	<td>//input[contains(@name,'website')]</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_URL</td>
	<td>//input[contains(@name,'supportWebsite')]</td>
	<td></td>
</tr>
<tr>
	<td>DOCUMENTATION_URL</td>
	<td>//input[contains(@name,'documentationWebsite')]</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_CODE_URL</td>
	<td>//input[contains(@name,'sourceCodeWebsite')]</td>
	<td></td>
</tr>
<tr>
	<td>LABS_CHECKBOX</td>
	<td>//div/span/span/span/input[contains(@name,'labsCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>SECURITY_CHECKBOX</td>
	<td>//div/span/span/span/input[contains(@name,'paclDisabledCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>TAGS_FIELD</td>
	<td>//div/ul/li/span/span/input[contains(@title,'Add Tags')]</td>
	<td></td>
</tr>
<tr>
	<td>TAGS_ADD</td>
	<td>//button[contains(@id,'add')]</td>
	<td></td>
</tr>
<tr>
	<td>TAGS_SELECT</td>
	<td>//button[contains(@id,'select')]</td>
	<td></td>
</tr>
<tr>
	<td>TAGS_SUGGESTIONS</td>
	<td>//button[contains(@id,'suggest')]</td>
	<td></td>
</tr>
<!--EULA-->
<tr>
	<td>EULA_DEFAULT_RADIO</td>
	<td>//div/span[2]/span/span/input[contains(@name,'customEula')]</td>
	<td></td>
</tr>
<tr>
	<td>EULA_CUSTOM_RADIO</td>
	<td>//div/span[3]/span/span/input[contains(@name,'customEula')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>