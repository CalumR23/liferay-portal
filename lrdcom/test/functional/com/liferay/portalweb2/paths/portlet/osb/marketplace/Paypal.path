<html>
<head>
<title>Paypal</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Paypal</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>Paypal</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>LOGIN_TO_PAYPAL</td>
	<td>//input[contains(@name,'login_button')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//input[contains(@id,'login_email')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//input[contains(@id,'login_password')]</td>
	<td></td>
</tr>
<tr>
	<td>LOGIN_BUTTON</td>
	<td>//input[contains(@id,'submitLogin')]</td>
	<td></td>
</tr>
<tr>
	<td>DESTINATION_ADDRESS</td>
	<td>//span[contains(@class,'addr')]</td>
	<td></td>
</tr>
<tr>
	<td>PAYMENT_METHOD</td>
	<td>//div[contains(@class,'payment type')]/div</td>
	<td></td>
</tr>
<tr>
	<td>PAY_BUTTON</td>
	<td>//input[contains(@value,'Pay')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[contains(@id,'cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>RETURN_TO_STORE_BUTTON</td>
	<td>//input[contains(@value,'Return')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>