<html>
<head>
<title>MPRegistrationDeveloper</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPRegistrationDeveloper</td></tr>
</thead>
<tbody>
<tr>
	<td>BACK_BUTTON</td>
	<td>//a[contains(@id,'Back')]</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_NAME_LABEL</td>
	<td>//label[contains(@for,'screenName')]</td>
	<td></td>
</tr>
<tr>
	<td>SCREEN_NAME_FIELD</td>
	<td>//input[contains(@id,'screenName')]</td>
	<td></td>
</tr>
<tr>
	<td>REGISTRATION_INFORMATION_LABEL</td>
	<td>//label[contains(@for,'${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>REGISTRATION_INFORMATION_FIELD</td>
	<td>//input[contains(@id,'${key_fieldName}')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_LABEL</td>
	<td>//label[contains(.,'Country')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRY_FIELD</td>
	<td>//select[contains(@id,'countryId')]</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_LABEL</td>
	<td>//label[contains(.,'Phone Number')]</td>
	<td></td>
</tr>
<tr>
	<td>PHONE_NUMBER_FIELD</td>
	<td>//input[contains(@id,'PhoneNumber')]</td>
	<td></td>
</tr>
<tr>
	<td>TERMS_OF_AGREEMENT</td>
	<td>//div[contains(@id,'terms')]</td>
	<td></td>
</tr>
<tr>
	<td>TERMS_OF_AGREEMENT_CHECKBOX</td>
	<td>//input[contains(@type,'checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>TERMS_OF_AGREEMENT_CHECKBOX_LABEL</td>
	<td>//label[contains(@for,'acceptContractEntryCheckbox')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[contains(@value,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//input[contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>ALREADY_REGISTERED_DEV_TEXT</td>
	<td>//div[contains(@class,'registration')]/p</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>