<html>
<head>
<title>MPPurchase</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPPurchase</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPPurchase</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>PURCHASE</td>
	<td>//h1[contains(@class,'purchase-title')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASE_PROCESS_BREADCRUMB_CURRENT</td>
	<td>//a[contains(@class,'purchase-breadcrumb') and contains (.,'${key_currentPurchaseProcess}')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_TITLE</td>
	<td>//a[contains(@title,'${key_appName}')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_AUTHOR</td>
	<td>//li[contains(.,'${key_appAuthor}')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[contains(@value,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>BACK_BUTTON</td>
	<td>//input[contains(@value,'Back')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_BUTTON</td>
	<td>//input[contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_NEW_ADDRESS</td>
	<td>//div[contains(@class,'new-address')]/div</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_ADDRESS_BUTTON</td>
	<td>//input[contains(@value,'Choose Address')]</td>
	<td></td>
</tr>
<tr>
	<td>LEGAL_ENTITY_NAME_FIELD</td>
	<td>//input[contains(@name,'legalEntityName')]</td>
	<td></td>
</tr>
<tr>
	<td>KEEP_SHOPPING_BUTTON</td>
	<td>//a[contains(.,'Keep Shopping')]</td>
	<td></td>
</tr>
<tr>
	<td>SEE_PURCHASED</td>
	<td>//a[contains(.,'See Purchased')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>