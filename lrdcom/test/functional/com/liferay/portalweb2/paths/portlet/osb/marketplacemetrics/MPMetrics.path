<html>
<head>
<title>MPMetrics</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPMetrics</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPMetrics</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>APP_PERFORMANCE</td>
	<td>//a[contains(@href,"app-performance")]</td>
	<td></td>
</tr>
<tr>
	<td>TOP_PERFORMERS</td>
	<td>//a[contains(@href,"top-performers")]</td>
	<td></td>
</tr>

<!--App Performance-->
<tr>
	<td>INTERVAL_SELECT</td>
	<td>//select[contains(@name,"interval")]</td>
	<td></td>
</tr>
<tr>
	<td>START_MONTH_SELECT</td>
	<td>//select[contains(@name,"startDateMonth")]</td>
	<td></td>
</tr>
<tr>
	<td>START_DAY_SELECT</td>
	<td>//select[contains(@name,"startDateDay")]</td>
	<td></td>
</tr>
<tr>
	<td>START_YEAR_SELECT</td>
	<td>//select[contains(@name,"startDateYear")]</td>
	<td></td>
</tr>
<tr>
	<td>END_MONTH_SELECT</td>
	<td>//select[contains(@name,"endDateMonth")]</td>
	<td></td>
</tr>
<tr>
	<td>END_DAY_SELECT</td>
	<td>//select[contains(@name,"endDateDay")]</td>
	<td></td>
</tr>
<tr>
	<td>END_YEAR_SELECT</td>
	<td>//select[contains(@name,"endDateYear")]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_BUTTON</td>
	<td>//a[contains(@class,"btn update")]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ALL</td>
	<td>//a[contains(@class,"select-all")]</td>
	<td></td>
</tr>
<tr>
	<td>DESELECT_ALL</td>
	<td>//a[contains(@class,"deselect-all")]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_APP_CHECKBOX_I</td>
	<td>//li[${key_appNumber}]/span/span/span/input[contains(@name,"Checkbox")]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>