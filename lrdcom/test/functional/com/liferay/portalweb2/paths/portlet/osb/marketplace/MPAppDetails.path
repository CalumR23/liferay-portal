<html>
<head>
<title>MPAppDetails</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAppDetails</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAppDetails</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>APP_TITLE</td>
	<td>//h2[contains(.,'${key_appName}')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_AUTHOR</td>
	<td>//a[contains(.,'${key_appAuthor}')]</td>
	<td></td>
</tr>
<tr>
	<td>BUY_BUTTON</td>
	<td>//a[contains(@href,'purchase')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASE_BUTTON</td>
	<td>//input[contains(@value,'Purchase')]</td>
	<td></td>
</tr>
<tr>
	<td>TRIAL_BUTTON</td>
	<td>//a[contains(@href,'trial')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_LATEST_VERSION</td>
	<td>//li[contains(.,'Latest Version')]</td>
	<td></td>
</tr>
<tr>
	<td>SECURITY_OPTION</td>
	<td>//li[contains(@class,'info-item-security')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_DESCRIPTION</td
>	<td>//div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_VALUE</td>
	<td>//span[contains(.,'${key_standardLicenses} Instance Unit')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_PRICING</td>
	<td>//li[contains(.,'${key_standardLicenses Instance Unit')]/span[contains(@class,'price')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_VALUE</td>
	<td>//span[contains(.,'${key_developerLicenses} Instance Unit')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_PRICING</td>
	<td>//li[contains(.,'${key_developerLicenses} Instance Unit')]/span[contains(@class,'price')]</td>
	<td></td>
</tr>
<tr>
	<td>LICENSE_TERM</td>
	<td>//div[contains(.,'License Term')]/../div[contains(.,'${key_licenseTerm}')]</td>
	<td></td>
</tr>
<tr>
	<td>REVIEWS_TAB</td>
	<td>//a[contains(@href,'reviews')]</td>
	<td></td>
</tr>
<tr>
	<td>VERSION_HISTORY_TAB</td>
	<td>//a[contains(@href,'history')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCESS_CONTROL_TAB</td>
	<td>//a[contains(@href,'access-control')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCESS_CONTROL_SUPPORTED_VERSIONS</td>
	<td>//select[contains(@id,'supported-framework-versions')]</td>
	<td></td>
</tr>
<tr>
	<td>REVIEWS_CUSTOMER_RATINGS_AVERAGE</td>
	<td>//div[contains(.,'Average')]</td>
	<td></td>
</tr>
<tr>
	<td>REVIEWS_CUSTOMER_RATINGS_STARS</td>
	<td>//div[contains(@class,'overlaycontextpanel')]/div[contains(.,'Stars')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>