<html>
<head>
<title>MPAdminContracts</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminContracts</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAdminContracts</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CONTRACTS_MENU</td>
	<td>//select[contains(@id,'contracts')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_DEFAULT_APP_EULA_BUTTON</td>
	<td>//input[contains(@value,'Add Default App EULA')]</td>
	<td></td>
</tr>
<tr>
	<td>DATE</td>
	<td>//td[contains(@id,'date')]/a</td>
	<td></td>
</tr>
<tr>
	<td>VERSION</td>
	<td>//td[contains(@id,'version')]/a</td>
	<td></td>
</tr>
<tr>
	<td>USER_NAME</td>
	<td>//td[contains(@id,'user-name')]/a</td>
	<td></td>
</tr>
<tr>
	<td>CONTRACT_CONTENT</td>
	<td>//textarea[contains(@id,'content')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//input[contains(@class,'cancel')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>