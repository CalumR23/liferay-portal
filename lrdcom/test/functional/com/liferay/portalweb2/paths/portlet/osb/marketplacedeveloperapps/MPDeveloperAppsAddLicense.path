<html>
<head>
<title>MPDeveloperAppsAddLicense</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperAppsAddLicense</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPDeveloperAppsAddLicense</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--License-->
<tr>
	<td>LICENSE_TERM_RADIO</td>
	<td>//label[.=' ${key_LicenseTerm} ']/../span/input</td>
	<td></td>
</tr>
<tr>
	<td>TERM_PERPETUAL_RADIO</td>
	<td>//input[contains(@name,'licenseLifetime')]</td>
	<td></td>
</tr>
<tr>
	<td>TERM_NON_PERPETUAL_RADIO</td>
	<td>//div/span[2]/span/span/input[contains(@name,'licenseLifetime')]</td>
	<td></td>
</tr>
<tr>
	<td>OFFER_SUBSCRIPTION_CHECKBOX</td>
	<td>//input[contains(@name,'supportedCheckbox')]</td>
	<td></td>
</tr>

<!--License Options-->
<tr>
	<td>STANDARD_LICENSE_QUANTITY_FIELD</td>
	<td>//div[contains(@class,'standard')]/div/input</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_ADD_QUANTITY_BUTTON</td>
	<td>//div[contains(@class,'standard')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_QUANTITY_I</td>
	<td>//div[contains(@class,'standard')]/ul/li[${key_LIcenseI}]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_DELETE_I</td>
	<td>//div[contains(@class,'standard')]/ul/li[${key_LIcenseI}]/a</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_QUANTITY_FIELD</td>
	<td>//div[contains(@class,'developer')]/div/input</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_ADD_QUANTITY_BUTTON</td>
	<td>//div[contains(@class,'developer')]/div/a</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_QUANTITY_I</td>
	<td>//div[contains(@class,'license-option-field developer')]/ul/li[${key_LIcenseI}]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_DELETE_I</td>
	<td>//div[contains(@class,'license-option-field developer')]/ul/li[${key_LIcenseI}]/a</td>
	<td></td>
</tr>
<tr>
	<td>TRIAL_LICENSE_CHECKBOX</td>
	<td>//input[contains(@name,'osbportlet_trialCheckbox')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>