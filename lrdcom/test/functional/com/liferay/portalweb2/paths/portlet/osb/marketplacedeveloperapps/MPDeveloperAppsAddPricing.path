<html>
<head>
<title>MPDeveloperAppsAddPricing</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperAppsAddPricing</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPDeveloperAppsAddPricing</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--Pricing-->
<tr>
	<td>ADD_PRICING_TABLE_BUTTON</td>
	<td>//a[contains(@class,'add-pricing btn')]</td>
	<td></td>
</tr>

<!--Default Pricing-->
<tr>
	<td>CURRENCY_SELECT_DEFAULT</td>
	<td>//select[contains(@class,'currency-select')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_QUANTITY_FIELD_DEFAULT_I</td>
	<td>//div[contains(@class,'prices')]/div[contains(@class,'standard')]/div[${key_StandardLicenseNum}]/input</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_QUANTITY_FIELD_DEFAULT_I</td>
	<td>//div[contains(@class,'prices')]/div[contains(@class,'developer')]/div[${key_DeveloperLicenseNum}]/input</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_SUBSCRIPTION_QUANTITY_FIELD_DEFAULT</td>
	<td>//input[contains(@class,'standard-support-price')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_SUBSCRIPTION_QUANTITY_FIELD_DEFAULT</td>
	<td>//input[contains(@class,'developer-support-price')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ALL_DEFAULT</td>
	<td>//a[contains(@class,'select-all')]</td>
	<td></td>
</tr>
<tr>
	<td>DESELECT_ALL_DEFAULT</td>
	<td>//a[contains(@class,'deselect-all')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRIES_DEFAULT</td>
	<td>//div[contains(@class,'countries')]/ul/li</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRIES_ZONE_DEFAULT</td>
	<td>//div[contains(@class,'countries')]/ul</td>
	<td></td>
</tr>
<!--Available Countries-->
<tr>
	<td>AVAILABLE_COUNTRIES_COUNTRY</td>
	<td>//div[contains(@class,'country-availability')]/ul/li[contains(.,'${key_Country}')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_COUNTRIES_ZONE</td>
	<td>//div[contains(@class,'country-availability')]/ul</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_COUNTRIES_SELECT_ALL</td>
	<td>//div[contains(@class,'country-availability')]/div/a[contains(@class,'select-all')]</td>
	<td></td>
</tr>
<tr>
	<td>AVAILABLE_COUNTRIES_DESELECT_ALL</td>
	<td>//div[contains(@class,'country-availability')]/div/a[contains(@class,'deselect-all')]</td>
	<td></td>
</tr>
<!--Additional Pricing-->
<tr>
	<td>TITLE_FIELD_I</td>
	<td>//div[${key_PricingTable}]/div/input[contains(@class,'edit-pricing name')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_I</td>
	<td>//div[${key_PricingTable}]/div/span/a[contains(@class,'delete-pricing')]</td>
	<td></td>
</tr>
<tr>
	<td>CURRENCY_SELECT_I</td>
	<td>//div[${key_PricingTable}]/div/div/select[contains(@class,'currency-select')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_QUANTITY_FIELD_I</td>
	<td>//div[${key_PricingTable}]/div/div/div[contains(@class,'standard')]/div[${key_StandardPrice}]/input[contains(@class,'edit-pricing-item')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_QUANTITY_FIELD_I</td>
	<td>//div[${key_PricingTable}]/div/div/div[contains(@class,'developer')]/div[${key_DeveloperPrice}]/input[contains(@class,'edit-pricing-item')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_SUBSCRIPTION_QUANTITY_FIELD_I</td>
	<td>//div[${key_PricingTable}]/div/div/div/input[contains(@class,'standard-support-price')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_SUBSCRIPTION_QUANTITY_FIELD_I</td>
	<td>//div[${key_PricingTable}]/div/div/div/input[contains(@class,'developer-support-price')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_ALL_I</td>
	<td>//div[${key_PricingTable}]/div/div/div/a[contains(@class,'select-all')]</td>
	<td></td>
</tr>
<tr>
	<td>DESELECT_ALL_I</td>
	<td>//div[${key_PricingTable}]/div/div/div/a[contains(@class,'deselect-all')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRIES_I</td>
	<td>//div[${key_PricingTable}]/div/div/ul/li[contains(.,'${key_Country}')]</td>
	<td></td>
</tr>
<tr>
	<td>COUNTRIES_ZONE_I</td>
	<td>//div[${key_PricingTable}]/div/div/ul</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>