<html>
<head>
<title>MPPurchaseSummary</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPPurchaseSummary</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPPurchaseSummary</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_INSTANCE_UNITS</td>
	<td>//td[contains(.,'${key_units} Instance Unit') and contains(.,'Developer')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_INSTANCE_UNITS</td>
	<td>//td[contains(.,'${key_units} Instance Unit') and contains(.,'Standard')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_CART_BUTTON</td>
	<td>//input[contains(@value,'Update')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_INVOICE_BUTTON</td>
	<td>//input[contains(@value,'Request Invoice')]</td>
	<td></td>
</tr>
<tr>
	<td>PAY_WITH_PAYPAL_BUTTON</td>
	<td>//input[contains(@value,'Pay with PayPal')]</td>
	<td></td>
</tr>
<tr>
	<td>PAYMENT_METHOD_CHECKBOX</td>
	<td>//div[contains(@class,'payment-option')]//label[contains(.,'${key_paymentMethod}')]/..//input</td>
	<td></td>
</tr>
<tr>
	<td>INVOICE_EMAIL_ADDRESS_FIELD</td>
	<td>//div[contains(@class,'payment-option')]//input[contains(@id,'emailAddress')]</td>
	<td></td>
</tr>
<tr>
	<td>EULA_CHECKBOX</td>
	<td>//input[contains(@id,'acceptContractCheckbox')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>