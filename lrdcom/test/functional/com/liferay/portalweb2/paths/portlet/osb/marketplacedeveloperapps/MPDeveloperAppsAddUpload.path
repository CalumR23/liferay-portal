<html>
<head>
<title>MPDeveloperAppsAddUpload</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperAppsAddUpload</td></tr>
</thead>
<tbody>
<!--Upload-->
<tr>
	<td>VERSION_NUMBER_FIELD</td>
	<td>//input[contains(@name,'version')]</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_NEW_FIELD</td>
	<td>//textarea[contains(.,changelog)]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_BROWSE_BUTTON</td>
	<td>//div[contains(@data-swfid,'${key_portalVersionShort}')]/div[contains(@class,'lfr-upload-movie-content')]/object</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY_VERSIONS_CHECKBOX</td>
	<td>//div[contains(@class,'liferay-portal-builds')]//label[contains(@for,'_24_WAR_osbportlet_${key_portalVersionShort}Checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE</td>
	<td>//span/span[contains(@class,'msg')]</td>
	<td></td>
</tr>
<tr>
	<td>DELETE</td>
	<td>//a[contains(@class,'action delete')]</td>
	<td></td>
</tr>
<tr>
	<td>UPLOAD_AREA</td>
	<td>//div[contains(@class,'upload-area')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>