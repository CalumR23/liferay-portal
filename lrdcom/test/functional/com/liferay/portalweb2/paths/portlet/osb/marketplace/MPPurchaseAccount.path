<html>
<head>
<title>MPPurchaseAccount</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPPurchaseAccount</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPPurchaseAccount</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ADD_A_NEW_PROJECT</td>
	<td>//div[contains(@class,'new-project')]/div[contains(@class,'card-body')]</td>
	<td></td>
</tr>
<tr>
	<td>NEW_PROJECT__NAME_FIELD</td>
	<td>//span[contains(.,'New Project')]/../..//fieldset//input</td>
	<td></td>
</tr>
<tr>
	<td>PROJECT_CARD</td>
	<td>//div[contains(@class,'purchase-app-entry-project')]//div[.=' ${key_projectName} ']</td>
	<td></td>
</tr>
<tr>
	<td>USER_CARD</td>
	<td>//div[contains(@class,'card-body')]/div[contains(@class,'owner') and contains(.,'${key_ownerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_LICENSE_INSTANCES</td>
	<td>//div[contains(@class,'licenses standard')]/div[contains(@class,'alottment')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_LICENSE_INSTANCES</td>
	<td>//div[contains(@class,'licenses developer')]/div[contains(@class,'allotment')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_SELECT_BUTTON</td>
	<td>//div[contains(@class,'card user') and contains(.,'${key_ownerName}')]//a[contains(.,'Select')]</td>
	<td></td>
</tr>
<tr>
	<td>LEGAL_ENTITY_NAME_FIELD</td>
	<td>//input[contains(@name,'legalEntityName')]</td>
	<td></td>
</tr>z
</tbody>
</table>
</body>
</html>