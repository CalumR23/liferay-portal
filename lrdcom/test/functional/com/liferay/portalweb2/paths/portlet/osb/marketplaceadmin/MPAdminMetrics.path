<html>
<head>
<title>MPAdminMetrics</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminMetrics</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>MPAdminMetrics</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_MONTH</td>
	<td>//select[contains(@id,'startDateMonth')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_DAY</td>
	<td>//select[contains(@id,'startDateDay')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_YEAR</td>
	<td>//select[contains(@id,'startDateYear')]</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_MONTH</td>
	<td>//select[contains(@id,'endDateMonth')]</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_DAY</td>
	<td>//select[contains(@id,'endDateDay')]</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_YEAR</td>
	<td>//select[contains(@id,'endDateYear')]</td>
	<td></td>
</tr>
<tr>
	<td>START_DATE_CALENDAR</td>
	<td>//label[contains(.,'Start Date')]/..//button</td>
	<td></td>
</tr>
<tr>
	<td>END_DATE_CALENDAR</td>
	<td>//label[contains(.,'End Date')]/..//button</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_PREVIOUS_MONTH</td>
	<td>//div[contains(@aria-hidden,'false')]//a[contains(@class,'prev')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_NEXT_MONTH</td>
	<td>//div[contains(@aria-hidden,'false')]//a[contains(@class,'next')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_TODAY</td>
	<td>//div[contains(@aria-hidden,'false')]//a[contains(@class,'today')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_NONE</td>
	<td>//div[contains(@aria-hidden,'false')]//a[contains(@class,'none')]</td>
	<td></td>
</tr>
<tr>
	<td>CALENDAR_DATE</td>
	<td>//div[contains(@aria-hidden,'false')]//a[contains(@class,'calendar-day') and contains(.,'${key_calendarDate}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>input[contains(@value,'Search')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_TITLE</td>
	<td>//a[contains(.,'${key_appName}')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER</td>
	<td>//a[contains(.,'${key_appName}')]/..//a[contains(.,'${key_developerName}')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY</td>
	<td>//a[contains(.,'${key_appName}')]/..//a[contains(.,'${key_category}')]</td>
	<td></td>
</tr>
<tr>
	<td>DOWNLOADS</td>
	<td>//a[contains(.,'${key_appName}')]/..//a[contains(.,'${key_downloads}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEWS</td>
	<td>//a[contains(.,'${key_appName}')]/..//a[contains(.,'${key_views}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>