<html>
<head>
<title>MPAdminDevelopers</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">MPAdminDevelopers</td></tr>
</thead>
<tbody>
<tr>
	<td>MANAGE</td>
	<td>//a[contains(@href,'manage')]</td>
