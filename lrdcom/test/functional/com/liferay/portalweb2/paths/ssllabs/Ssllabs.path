<html>
<head>
<title>Ssllabs</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Ssllabs</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>Ssllabs</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>CLEAR_CACHE_LINK</td>
	<td>//a[contains(.,'Clear cache')]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE</td>
	<td>//table[@id='multiTable']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_SERVER_IP_ADDRESS</td>
	<td>//tr[contains(.,'${key_serverIpAddress}')]/td/span[@class='ip']</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_SERVER_DOMAIN</td>
	<td>//tr[contains(.,'${key_serverIpAddress}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_SERVER_GRADE</td>
	<td>//tr[contains(.,'${key_serverIpAddress}')]/td/div[contains(@class,'percentage')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>