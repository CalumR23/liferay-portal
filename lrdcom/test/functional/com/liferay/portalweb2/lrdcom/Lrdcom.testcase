<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />

	<command name="Smoke" priority="5">
		<execute action="Lrdcom#assertClick" locator-key1="DEVELOPER_TAB" value1="Developers" />

		<execute action="Lrdcom#assertClick" locator-key1="MARKETPLACE_TAB" value1="Marketplace" />

		<execute action="Lrdcom#assertTextEquals" locator-key1="MARKETPLACE_TITLE" value1="MARKETPLACE" />
	</command>
</definition>