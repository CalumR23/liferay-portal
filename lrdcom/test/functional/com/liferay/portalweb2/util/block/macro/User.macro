<definition>
	<var name="password" value="test" />
	<var name="userEmailAddress" value="test@liferay.com" />

	<command name="firstLoginPG">
		<description message="Log into Liferay Portal as ${userEmailAddress} using the password ${password}, if not logged in as ${userEmailAddress} log out first." />
	</command>

	<command name="loginPG">
		<description message="Log into Liferay Portal as ${userEmailAddress} using the password ${password}." />
	</command>

	<command name="logoutPG">
		<description message="Log out of Liferay Portal." />
	</command>
</definition>