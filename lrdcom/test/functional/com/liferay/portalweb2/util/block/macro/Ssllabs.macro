<definition>
	<command name="viewGradePG">
		<var name="key_serverIpAddress" value="${serverIpAddress}" />

		<execute action="Ssllabs#assertTextEquals" locator-key1="TABLE_SERVER_IP_ADDRESS" value1="${serverIpAddress}" />
		<execute action="Ssllabs#assertTextEquals" locator-key1="TABLE_SERVER_DOMAIN" value1="${serverDomain}" />
		<execute action="Ssllabs#assertTextEquals" locator-key1="TABLE_SERVER_GRADE" value1="${serverGrade}" />
	</command>
</definition>