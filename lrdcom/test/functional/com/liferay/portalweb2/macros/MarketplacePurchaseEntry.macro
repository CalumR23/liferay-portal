<definition>
	<command name="checkEula">
		<execute function="Check" locator1="MPPurchaseSummary#EULA_CHECKBOX" />
	</command>

	<command name="checkPaymentMethod">
		<var name="key_paymentMethod" value="${paymentMethod}" />

		<execute function="Check" locator1="MPPurchaseSummary#PAYMENT_METHOD_CHECKBOX" />
	</command>

	<command name="checkPurchaseType">
		<var name="key_licensePurchaseType" value="${licensePurchaseType}" />

		<execute function="Check" locator1="MPPurchaseLicense#PURCHASE_TYPE_RADIO" />
	</command>

	<command name="checkSubscriptionServicesType">
		<var name="key_subscriptionType" value="subscriptionType" />

		<execute function="Check" locator1="MPPurchaseLicense#SUBSCRIPTION_SERVICES_TYPE_CHECKBOX" />
	</command>

	<command name="clickDestinationAddressCard">
		<var name="key_destinationAddressName" value="${destinationAddressName}" />

		<execute function="Click" locator1="MPPurchaseDestination#DESTINATION_ADDRESS_CARD" />
	</command>

	<command name="clickProjectCard">
		<var name="key_projectName" value="${projectName}" />

		<execute function="Click" locator1="MPPurchaseAccount#PROJECT_CARD" />
	</command>

	<command name="clickProjectPersonalUse">
		<execute function="Click" locator1="MPApps#PROJECT_PERSONAL_USE" />
	</command>

	<command name="selectDestinationregion">
		<execute function="Select" locator1="MPPurchaseDestination#DESTINATION_REGION" value1="California" />
	</command>

	<command name="typeDestinationCity">
		<execute function="Type" locator1="MPPurchaseDestination#DESTINATION_CITY" value1="Diamond Bar" />
	</command>

	<command name="typeDestinationCompanyName">
		<execute function="Type" locator1="MPPurchaseDestination#DESTINATION_COMPANY_NAME" value1="${destinationAddressName}" />
	</command>

	<command name="typeDestinationStreet1">
		<execute function="Type" locator1="MPPurchaseDestination#DESTINATION_STREET_1" value1="123 Main Street" />
	</command>

	<command name="typeDestinationZip">
		<execute function="Type" locator1="MPPurchaseDestination#DESTINATION_ZIP" value1="91765" />
	</command>

	<command name="typeDeveloperLicenseQuantity">
		<var name="key_units" value="${quantity}" />

		<execute function="Type" locator1="MPPurchaseLicense#DEVELOPER_LICENSE_INSTANCE_QUANTITY" value1="${quantity}" />
	</command>

	<command name="typeDeveloperSummaryQuantity">
		<var name="key_units" value="${quantity}" />

		<execute function="Type" locator1="MPPurchaseSummary#DEVELOPER_INSTANCE_UNITS" value1="${quantity}" />
	</command>

	<command name="typeInvoiceEmailAddress">
		<execute function="Type" locator1="MPPurchaseSummary#INVOICE_EMAIL_ADDRESS_FIELD" value1="${invoiceEmailAddress}" />
	</command>

	<command name="typeLegalEntityName">
		<execute function="Type" locator1="MPPurchaseAccount#LEGAL_ENTITY_NAME_FIELD" value1="${legalEntityName}" />
	</command>

	<command name="typeNewProjectName">
		<execute function="Type" locator1="MPPurchaseAccount#NEW_PROJECT__NAME_FIELD" value1="${projectName}" />
	</command>

	<command name="typeStandardLicenseQuantity">
		<var name="key_units" value="${quantity}" />

		<execute function="Type" locator1="MPPurchaseLicense#STANDARD_LICENSE_INSTANCE_QUANTITY" value1="${quantity}" />
	</command>

	<command name="typeStandardSummaryQuantity">
		<var name="key_units" value="${quantity}" />

		<execute function="Type" locator1="MPPurchaseSummary#STANDARD_INSTANCE_UNITS" value1="${quantity}" />
	</command>

	<command name="uncheckSubscriptionServicesType">
		<var name="key_subscriptionType" value="subscriptionType" />

		<execute function="Uncheck" locator1="MPPurchaseLicense#SUBSCRIPTION_SERVICES_TYPE_CHECKBOX" />
	</command>

	<command name="viewDestinationCountry">
		<execute function="AssertTextPresent" locator1="MPPurchaseDestination#DESTINATION_COUNTRY" value1="United States" />
	</command>
</definition>