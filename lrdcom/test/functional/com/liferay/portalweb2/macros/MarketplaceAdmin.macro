<definition>
	<command name="addLicense">
		<execute function="AssertClick" locator1="MPAdminCustomers#ADD_LICENSE_BUTTON" value1="Add License" />

		<execute function="SelectWindow" locator1="title=Control Panel" />

		<execute function="Pause" locator1="3000" />

		<if>
			<equals arg1="${licenseType}" arg2="Standard" />
			<then>
				<execute function="ClickNoError" locator1="MPAdminCustomers#STANDARD_INSTANCE" />
			</then>
			<elseif>
				<equals arg1="${licenseType}" arg2="Developer" />
				<then>
					<execute function="ClickNoError" locator1="MPAdminCustomers#DEVELOPER_INSTANCE" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${licenseType}" arg2="Trial" />
				<then>
					<execute function="ClickNoError" locator1="MPAdminCustomers#TRIAL_INSTANCE" />
				</then>
			</elseif>
		</if>

		<execute function="SelectWindow" locator1="title=Control Panel - Liferay.com" />

		<execute macro="Message#success" />
	</command>

	<command name="denyOrApproveCompany">
		<execute macro="Button#button1">
			<var name="buttonName" value="${denyOrPass}" />
		</execute>

		<if>
			<equals arg1="${denyOrPass}" arg2="Deny" />
			<then>
				<execute macro="Button#button1">
					<var name="buttonName" value="Deny" />
				</execute>
			</then>
		</if>

		<execute macro="Message#success" />
	</command>

	<command name="denyOrPassApp">
		<execute macro="Button#button1">
			<var name="buttonName" value="${denyOrPass}" />
		</execute>

		<if>
			<equals arg1="${denyOrPass}" arg2="Deny App" />
			<then>
				<execute macro="Button#button1">
					<var name="buttonName" value="Deny" />
				</execute>
			</then>
		</if>
	</command>

	<command name="disableCompany">
		<execute function="AssertClick" locator1="MPAdminDevelopers#DISABLE_BUTTON" value1="Disable" />
		<execute function="AssertClick" locator1="MPAdminDevelopers#DISABLE_BUTTON" value1="Disable" />

		<execute macro="Message#success" />
	</command>

	<command name="expirePaidStatus">
		<execute function="Click" locator1="MPAdminDevelopers#EDIT_DEVELOPER_REGISTRATION" />

		<execute function="Type" locator1="MPAdminDevelopers#DOMAIN_NAME" value1="www.google.com" />

		<execute function="Select" locator1="MPAdminDevelopers#SUBSCRIPTION_EXPIRATION_DATE_YEAR" value1="2014" />

		<execute function="Click" locator1="Button#SAVE_BUTTON" />

		<execute macro="Message#success" />
	</command>

	<command name="lookforCustomer">
		<var name="key_appTitle" value="${appTitle}" />

		<execute function="Type" locator1="MPAdminCustomers#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />

		<execute function="AssertClick" locator1="MPAdminCustomers#LOOKUP_BUTTON" value1="Lookup" />

		<execute function="AssertClick" locator1="MPAdminCustomers#APP_ENTRY_NAME" value1="${appTitle}" />
	</command>

	<command name="tearDownApprovedApp">
		<var name="key_appTitle" value="${appTitle}" />

		<execute macro="User#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword"  />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Pause" locator1="3000" />

		<if>
			<condition function="IsElementPresent" locator1="MPDeveloperApps#APP_TITLE_LINK" />
			<then>
				<execute macro="AccountNavigator#gotoDevApp">
					<var name="appTitle" value="${appTitle}" />
				</execute>
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="MPDeveloperApps#ADD_NEW_VERSION_BUTTON" />
			<then>
				<execute macro="Account#editAppWithNewVersion">
					<var name="appWarFile" value="${appWarFile}" />
					<var name="versionNumber" value="${versionNumber}" />
					<var name="whatsNewDescription" value="Delete when this isn't required anymore" />
				</execute>
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="MPDeveloperApps#CANCEL_SUBMISSION" />
			<then>
				<execute function="AssertClick" locator1="MPDeveloperApps#CANCEL_SUBMISSION" value1="Cancel Submission" />
			</then>
		</if>

		<execute macro="AccountAppAdd#clickSubmit" />
	</command>

	<command name="workflowCompanyApprove">
		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#approveSubmission" />
	</command>

	<command name="workflowCompanyDisable">
		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#approveSubmission" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#disableCompany" />
	</command>

	<command name="workflowSubmittedApp">
		<execute macro="MarketplaceAdminNavigator#gotoApp">
			<var name="appTitle" value="${appTitle}" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="MPAdminReviewApps#REVIEW_DEVELOPER_PAGE" />
			<then>
				<execute function="AssertClick" locator1="MPAdminReviewApps#REVIEW_DEVELOPER_PAGE" value1="Review Developer page" />

				<execute function="AssertClick" locator1="MPAdminDevelopers#APPROVE_PAID_DEVELOPER_STATUS_BUTTON" value1="Approve Paid Developer Status" />

				<execute macro="Message#success" />
			</then>
		</if>

		<execute macro="MarketplaceAdmin#denyOrPassApp">
			<var name="denyOrPass" value="${requestDenyOrSendToQA}" />
		</execute>

		<execute macro="Message#success" />

		<if>
			<equals arg1="${requestDenyOrSendToQA}" arg2="Send To QA" />
			<then>
				<execute macro="MarketplaceAdminNavigator#gotoApp">
					<var name="appTitle" value="${appTitle}" />
				</execute>

				<execute macro="MarketplaceAdmin#denyOrPassApp">
					<var name="denyOrPass" value="${pendingQADenyOrApprove}" />
				</execute>

				<execute macro="Message#success" />
			</then>
		</if>
	</command>
</definition>