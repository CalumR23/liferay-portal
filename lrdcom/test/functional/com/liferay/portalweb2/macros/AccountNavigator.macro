<definition>
	<command name="gotoDevApp">
		<var name="key_appTitle" value="${appTitle}" />
		<execute function="Click" locator1="MPDeveloperApps#APP_TITLE" />
	</command>

	<command name="gotoDevSidebar">
		<var name="key_devSidebar" value="${devSidebarItem}" />
		<execute function="Click" locator1="AccountSidebar#DEVELOPMENT_SIDEBAR" />
	</command>

	<command name="gotoEditAppDetails">
		<execute function="Click" locator1="MPDeveloperAppsAdd#DETAILS" />
	</command>

	<command name="gotoEditAppLicense">
		<execute function="Click" locator1="MPDeveloperAppsAdd#LICENSE" />
	</command>

	<command name="gotoEditAppPricing">
		<execute function="Click" locator1="MPDeveloperAppsAdd#PRICING" />
	</command>

	<command name="gotoEditAppVersion">
		<execute function="Click" locator1="MPDeveloperAppsAdd#VERSION" />
	</command>

	<command name="gotoUserApp">
		<if>
			<condition function="IsElementPresent" locator1="AccountSidebar#USER_APPS" />
			<then>
				<execute function="Click" locator1="AccountSidebar#USER_APPS" />
			</then>
			<else>
				<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />
				<execute function="AssertClick" locator1="MPNavigation#PURCHASED_APPS" value1="Purchased Apps" />
			</else>
		</if>

		<execute function="AssertClick" locator1="MPApps#PROJECT_PERSONAL_USE" value1="Personal Use" />
		<execute function="Click" locator1="Marketplace#APP_TITLE">
			<var name="key_appTitle" value="${appTitle}" />
		</execute>
	</command>
</definition>