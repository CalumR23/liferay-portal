<definition>

	<command name="clickSubmit">
		<execute macro="Button#submit" />

		<execute macro="Message#success" />
	</command>

	<command name="editDetails">
		<if>
			<isset var="isFreePaid" />
			<then>
				<if>
					<and>
						<contains string="${isFreePaid}" substring="paid" />
						<condition function="IsElementPresent" locator1="MPDeveloperAppsAddDetails#UPGRADE" />
					</and>
					<then>
						<execute macro="Registration#convertToPaidDeveloperAccount">
							<var name="companyName" value="${companyName}" />
							<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress" />
						</execute>
					</then>
				</if>

				<execute macro="AccountAppAddEntry#checkPricing">
					<var name="isFreePaid" value="${isFreePaid}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appTitle" />
			<then>
				<execute macro="AccountAppAddEntry#typeTitle">
					<var name="appTitle" value="${appTitle}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appDescription" />
			<then>
				<execute macro="AccountAppAddEntry#typeDescription">
					<var name="appDescription" value="${appDescription}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="translations" />
			<then>
				<execute macro="AccountAppAddEntry#checkLocalized" />
			</then>
		</if>

		<if>
			<isset var="appIconFile" />
			<then>
				<execute macro="Button#iconBrowse" />

				<execute macro="Sikuli#uploadFile">
					<var name="fileName" value="${appIconFile}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="screenCaptures" />
			<then>
				<for list="${screenCaptures}" param="screenShot">
					<execute macro="Button#button2">
						<var name="buttonName" value="Browse" />
					</execute>

					<execute macro="Sikuli#uploadFile">
						<var name="fileName" value="${screenShot}" />
					</execute>
				</for>
			</then>
		</if>

		<if>
			<isset var="appCategory" />
			<then>
				<execute macro="AccountAppAddEntry#selectCategory">
					<var name="appCategory" value="${appCategory}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="developerWebsiteUrl" />
			<then>
				<execute macro="AccountAppAddEntry#typeDeveloperUrl">
					<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="supportUrl" />
			<then>
				<execute macro="AccountAppAddEntry#typeSupportUrl">
					<var name="supportUrl" value="${supportUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="documentationUrl" />
			<then>
				<execute macro="AccountAppAddEntry#typeDocumentationUrl">
					<var name="documentationUrl" value="${documentationUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="sourceCodeUrl" />
			<then>
				<execute macro="AccountAppAddEntry#typeSourceCodeUrl">
					<var name="sourceCodeUrl" value="${sourceCodeUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<equals arg1="${labs}" arg2="true" />
			<then>
				<execute macro="AccountAppAddEntry#checkLabs" />
			</then>
		</if>

		<if>
			<equals arg1="${security}" arg2="true" />
			<then>
				<execute macro="AccountAppAddEntry#checkSecurity" />
			</then>
		</if>

		<if>
			<isset var="tagsList" />
			<then>
				<while>
					<condition function="IsElementPresent" locator1="TAG_DELETE_BUTTON" />
					<then>
						<execute macro="AccountAppAddEntry#deleteTag" />
					</then>
				</while>

				<if>
					<equals arg1="${tagInputMethod}" arg2="type" />
					<then>
						<for list="${tagsList}" param="tag">
							<execute macro="AccountAppAddEntry#inputTagViaTyping">
								<var name="tag" value="${tag}" />
							</execute>
						</for>
					</then>
					<elseif>
						<equals arg1="${tagInputMethod}" arg2="add" />
						<then>
							<for list="${tagsList}" param="tag">
								<execute macro="AccountAppAddEntry#inputTagViaAdd">
									<var name="tag" value="${tag}" />
								</execute>
							</for>
						</then>
					</elseif>
					<elseif>
						<equals arg1="${tagInputMethod}" arg2="select" />
						<then>
							<for list="${tagsList}" param="tag">
								<execute macro="AccountAppAddEntry#inputTagViaSelect">
									<var name="tag" value="${tag}" />
								</execute>
							</for>
						</then>
					</elseif>
					<elseif>
						<equals arg1="${tagInputMethod}" arg2="suggest" />
						<then>
							<for list="${tagsList}" param="tag">
								<execute macro="AccountAppAddEntry#inputTagViaSuggestions">
									<var name="tag" value="${tag}" />
								</execute>
							</for>
						</then>
					</elseif>
				</if>
			</then>
		</if>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="editLicense">
		<if>
			<isset var="licenseTerm" />
			<then>
				<execute macro="AccountAppAddEntry#checkLicenseTerm" >
					<var name="licenseTerm" value="${licenseTerm}" />
				</execute>
			</then>
		</if>

		<if>
			<equals arg1="${subscriptionServices}" arg2="true" />
			<then>
				<execute macro="AccountAppAddEntry#checkSubscriptionServices" />
			</then>
		</if>

		<if>
			<isset var="standardLicenseUnitsList" />
			<then>
				<while>
					<condition function="IsElementPresent" locator1="MPDeveloperAppsAddLicense#STANDARD_DELETE" />
					<then>
						<execute function="Click" locator1="MPDeveloperAppsAddLicense#STANDARD_DELETE" />
					</then>
				</while>

				<for list="${standardLicenseUnitsList}" param="standardLicenseQuantity">
					<execute macro="AccountAppAddEntry#typeStandardLicenseQuantity">
						<var name="standardLicensePrice" value="${standardLicensePrice}" />
					</execute>

					<execute function="Pause" locator1="1000" />
					<execute macro="Button#standardLicenseAddQuantityButton" />
				</for>
			</then>
		</if>

		<if>
			<isset var="developerLicenseUnitsList" />
			<then>
				<while>
					<condition function="IsElementPresent" locator1="MPDeveloperAppsAddLicense#DEVELOPER_DELETE" />
					<then>
						<execute function="Click" locator1="MPDeveloperAppsAddLicense#DEVELOPER_DELETE" />
					</then>
				</while>

				<for list="${developerLicenseUnitsList}" param="developerLicenseQuantity">
					<execute macro="AccountAppAddEntry#typeDeveloperLicenseQuantity">
						<var name="developerLicenseQuantity" value="${developerLicenseQuantity}" />
					</execute>

					<execute function="Pause" locator1="1000" />
					<execute macro="Button#developerLicenseAddQuantityButton" />
				</for>
			</then>
		</if>

		<if>
			<equals arg1="${trialLicense}" arg2="false" />
			<then>
				<execute macro="AccountAppAddEntry#checkTrialLicense" />
			</then>
		</if>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="editPricing">
		<if>
			<isset var="tableTitleList" />
			<then>
				<var name="i" value="1" />
				<for list="${tableTitleList}" param="tableTitle">
					<execute macro="AccountAppAddEntry#typeTableTitle">
						<var name="tableNum" value="${i}" />
						<var name="tableTitle" value="${tableTitle}" />
					</execute>

					<var name="i" value="${i?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="currencyList" />
			<then>
				<var name="i" value="1" />

				<for list="${currencyList}" param="currency">
					<execute macro="AccountAppAddEntry#selectCurrency">
						<var name="currency" value="${currency}" />
						<var name="tableNum" value="${i}" />
					</execute>

					<var name="i" value="${i?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="standardLicensePriceList" />
			<then>
				<var name="j" value="1" />
				<for list="${standardLicensePriceList}" param="standardLicensePrice">
					<execute macro="AccountAppAddEntry#typeStandardLicensePrice">
						<var name="licenseNum" value="${j}" />
						<var name="standardLicensePrice" value="${standardLicensePrice}" />
						<var name="tableNum" value="1" />
					</execute>

					<var name="j" value="${j?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="developerLicensePriceList" />
			<then>
				<var name="j" value="1" />
				<for list="${developerLicensePriceList}" param="developerLicensePrice">
					<execute macro="AccountAppAddEntry#typeDeveloperLicensePrice">
						<var name="developerLicensePrice" value="${developerLicensePrice}" />
						<var name="licenseNum" value="${j}" />
						<var name="tableNum" value="1" />
					</execute>

					<var name="j" value="${j?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="standardSubscriptionPriceList" />
			<then>
				<var name="i" value="1" />
				<for list="${standardSubscriptionPriceList}" param="standardSubscriptionPrice">
					<execute macro="AccountAppAddEntry#typeStandardSubscriptionPrice">
						<var name="standardSubscriptionPrice" value="${standardSubscriptionPrice}" />
						<var name="tableNum" value="${i}" />
					</execute>

					<var name="i" value="${i?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="developerSubscriptionPriceList" />
			<then>
				<var name="i" value="1" />
				<for list="${developerSubscriptionPriceList}" param="developerSubscriptionPrice">
					<execute macro="AccountAppAddEntry#typeDeveloperSubscriptionPrice">
						<var name="developerSubscriptionPrice" value="${developerSubscriptionPrice}" />
						<var name="tableNum" value="${i}" />
					</execute>

					<var name="i" value="${i?increment()}" />
				</for>
			</then>
		</if>

		<if>
			<isset var="removeCountryList" />
			<then>
				<if>
					<equals arg1="${removeCountryList}" arg2="all" />
					<then>
						<execute macro="AccountAppAddEntry#moveAllCountriesFromTableToPool">
							<var name="tableNum" value="1" />
						</execute>
					</then>
					<else>
						<for list="${countryList}" param="country">
							<execute macro="AccountAppAddEntry#moveSelectedCountryToPool">
								<var name="country" value="${country}" />
								<var name="tableNum" value="1" />
							</execute>
						</for>
					</else>
				</if>
			</then>
		</if>

		<if>
			<isset var="addCountryList" />
			<then>
				<if>
					<equals arg1="${addCountryList}" arg2="all" />
					<then>
						<execute macro="AccountAppAddEntry#moveAllCountriesFromPoolToTable">
							<var name="tableNum" value="1" />
						</execute>
					</then>
					<else>
						<for list="${countryList}" param="country">
							<execute macro="AccountAppAddEntry#moveSelectedCountryToTable">
								<var name="country" value="${country}" />
								<var name="tableNum" value="1" />
							</execute>
						</for>
					</else>
				</if>
			</then>
		</if>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="editUpload">
		<if>
			<isset var="versionNumber" />
			<then>
				<execute macro="AccountAppAddEntry#typeVersionNumber">
					<var name="versionNumber" value="${versionNumber}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="whatsNewDescription" />
			<then>
				<execute function="Type" locator1="MPDeveloperAppsAddUpload#WHATS_NEW_FIELD" value1="${whatsNewDescription}" />
			</then>
		</if>

		<if>
			<isset var="appWarFile" />
			<then>
				<for list="${appWarFile}" param="fileName">
					<execute macro="Button#uploadBrowse" />

					<execute macro="Sikuli#uploadFile">
						<var name="fileName" value="${fileName}" />
					</execute>

					<execute function="Pause" locator1="5000" />
				</for>
			</then>
		</if>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>
</definition>