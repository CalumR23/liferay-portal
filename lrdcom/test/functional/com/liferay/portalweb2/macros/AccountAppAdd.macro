<definition>
	<command name="addDetails">
		<if>
			<and>
				<contains string="${isFreePaid}" substring="paid" />
				<condition function="IsElementPresent" locator1="MPDeveloperAppsAddDetails#UPGRADE" />
			</and>
			<then>
				<execute macro="Registration#convertToPaidDeveloperAccount">
					<var name="companyName" value="${companyName}" />
					<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress" />
				</execute>
			</then>
		</if>

		<execute macro="AccountAppAddEntry#checkPricing">
			<var name="isFreePaid" value="${isFreePaid}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeTitle">
			<var name="appTitle" value="${appTitle}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDescription">
			<var name="appDescription" value="${appDescription}" />
		</execute>

		<execute macro="AccountAppAddEntry#uploadAppIcon">
			<var name="appIconFile" value="${appIconFile}" />
		</execute>

		<execute macro="AccountAppAddEntry#selectCategory">
			<var name="appCategory" value="${appCategory}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperUrl">
			<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeSupportUrl">
			<var name="supportUrl" value="${supportUrl}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addLicense">
		<execute macro="AccountAppAddEntry#checkLicenseTerm" >
			<var name="licenseTerm" value="${licenseTerm}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeStandardLicenseQuantity">
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperLicenseQuantity">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addLicenseWithSubscription">
		<execute macro="AccountAppAddEntry#checkLicenseTerm" >
			<var name="licenseTerm" value="${licenseTerm}" />
		</execute>

		<execute macro="AccountAppAddEntry#checkSubscriptionServices" />

		<execute macro="AccountAppAddEntry#typeStandardLicenseQuantity">
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperLicenseQuantity">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addPricing">
		<execute macro="AccountAppAddEntry#selectCurrency">
			<var name="currency" value="${currency}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeStandardLicensePrice">
			<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperLicensePrice">
			<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#moveAllCountriesFromPoolToTable">
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addPricingWithSubscription">
		<execute macro="AccountAppAddEntry#typeTableTitle">
			<var name="tableNum" value="1" />
			<var name="tableTitle" value="${tableTitle}" />
		</execute>

		<execute macro="AccountAppAddEntry#selectCurrency">
			<var name="currency" value="${currency}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeStandardLicensePrice">
			<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperLicensePrice">
			<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeStandardSubscriptionPrice">
			<var name="standardSubscriptionPriceList" value="${standardSubscriptionPriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDeveloperSubscriptionPrice">
			<var name="developerSubscriptionPriceList" value="${developerSubscriptionPriceList}" />
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="AccountAppAddEntry#moveAllCountriesFromPoolToTable">
			<var name="tableNum" value="1" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addUpload">
		<execute macro="AccountAppAddEntry#typeVersionNumber">
			<var name="versionNumber" value="${versionNumber}" />
		</execute>

		<execute macro="AccountAppAddEntry#uploadAppFiles">
			<var name="appWarFileList" value="${appWarFileList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="addUploadWithWhatsNewDescription">
		<execute macro="AccountAppAddEntry#typeVersionNumber">
			<var name="versionNumber" value="${versionNumber}" />
		</execute>

		<execute function="Type" locator1="MPDeveloperAppsAddUpload#WHATS_NEW_FIELD" value1="${whatsNewDescription}" />

		<execute macro="AccountAppAddEntry#uploadAppFiles">
			<var name="appWarFileList" value="${appWarFileList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>

	<command name="clickSubmit">
		<execute macro="Button#submit" />

		<execute macro="Message#success" />
	</command>

	<command name="editLicense">
		<while>
			<condition function="IsElementPresent" locator1="MPDeveloperAppsAddLicense#STANDARD_DELETE" />
			<then>
				<execute function="Click" locator1="MPDeveloperAppsAddLicense#STANDARD_DELETE" />
			</then>
		</while>

		<execute macro="AccountAppAddEntry#typeStandardLicenseQuantity">
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<while>
			<condition function="IsElementPresent" locator1="MPDeveloperAppsAddLicense#DEVELOPER_DELETE" />
			<then>
				<execute function="Click" locator1="MPDeveloperAppsAddLicense#DEVELOPER_DELETE" />
			</then>
		</while>

		<execute macro="AccountAppAddEntry#typeDeveloperLicenseQuantity">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Message#success" />
	</command>
</definition>