<definition>
	<command name="addApp">
		<execute macro="Button#addNewApp" />

		<execute macro="AccountAppAdd#addDetails">
			<var name="appCategory" value="${appCategory}" />
			<var name="appDescription" value="${appDescription}" />
			<var name="appIconFile" value="${appIconFile}" />
			<var name="appTitle" value="${appTitle}" />
			<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
			<var name="isFreePaid" value="${isFreePaid}" />
			<var name="supportUrl" value="${supportUrl}" />
		</execute>

		<execute macro="AccountAppAdd#addUpload">
			<var name="appWarFileList" value="${appWarFileList}" />
			<var name="versionNumber" value="${versionNumber}" />
		</execute>

		<if>
			<contains string="${isFreePaid}" substring="paid" />
			<then>
		<execute macro="AccountNavigator#gotoEditAppLicense" />

		<execute macro="AccountAppAdd#addLicense">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
			<var name="licenseTerm" value="${licenseTerm}" />
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<execute macro="AccountAppAdd#addPricing">
			<var name="currency" value="${currency}" />
			<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
					<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
					<var name="developerSubscriptionPriceList" value="${developerSubscriptionPriceList}" />
					<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
					<var name="standardSubscriptionPriceList" value="${standardSubscriptionPriceList}" />
					<var name="tableTitleList" value="${tableTitleList}" />
				</execute>
			</then>
		</if>
	</command>

	<command name="editAppViaAddNewVersion">
		<execute macro="Button#addNewVersion" />

		<execute macro="AccountAppAdd#addDetails" />

		<execute macro="AccountAppAdd#addUpload">
			<var name="appWarFileList" value="${appWarFileList}" />
			<var name="versionNumber" value="${versionNumber}" />
			<var name="whatsNewDescription" value="Delete when this isn't required anymore" />
		</execute>
	</command>

	<command name="editFreeAppViaEdit">
		<execute macro="Button#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountAppAdd#addDetails" />

		<execute macro="AccountAppAdd#addUpload" />
	</command>

	<command name="editPaidAppViaEdit">
		<execute macro="Button#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountAppAdd#addDetails" />

		<execute macro="AccountAppAdd#addUpload">
			<var name="appWarFileList" value="${appWarFileList}" />
			<var name="versionNumber" value="${versionNumber}" />
			<var name="whatsNewDescription" value="Delete when this isn't required anymore" />
		</execute>

		<execute macro="AccountAppAdd#addLicense" />

		<execute macro="AccountAppAdd#addPricing" />
	</command>

	<command name="setupAndSubmitApp">
		<var name="key_appTitle" value="${appTitle}" />

		<execute macro="AccountNavigator#gotoDevAppFromHome">
			<var name="appTitle" value="${appTitle}" />
			<var name="companyName" value="${companyName}" />
		</execute>

		<if>
			<condition function="IsElementNotPresent" locator1="MPDeveloperApps#APP_TITLE" value1="appTitle" />
			<then>
				<execute macro="Account#addApp">
					<var name="addCountryList" value="${addCountryList}" />
					<var name="appCategory" value="${appCategory}" />
					<var name="appDescription" value="${appDescription}" />
					<var name="appIconFile" value="${appIconFile}" />
					<var name="appTitle" value="${appTitle}" />
					<var name="appWarFileList" value="${appWarFileList}" />
					<var name="currencyList" value="${currencyList}" />
					<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
					<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
					<var name="developerSubscriptionPriceList" value="${developerSubscriptionPriceList}" />
					<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
					<var name="documentationUrl" value="${documentationUrl}" />
					<var name="isFreePaid" value="${isFreePaid}" />
					<var name="labs" value="${labs}" />
					<var name="licenseTerm" value="${licenseTerm}" />
					<var name="removeCountryList" value="${removeCountryList}" />
					<var name="screenCaptures" value="${screenCaptures}" />
					<var name="security" value="${security}" />
					<var name="sourceCodeUrl" value="${sourceCodeUrl}" />
					<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
					<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
					<var name="standardSubscriptionPriceList" value="${standardSubscriptionPriceList}" />
					<var name="subscriptionServices" value="${subscriptionServices}" />
					<var name="supportUrl" value="${supportUrl}" />
					<var name="tableTitleList" value="${tableTitleList}" />
					<var name="tagInputMethod" value="${tagInputMethod}" />
					<var name="tagsList" value="${tagsList}" />
					<var name="translations" value="${translations}" />
					<var name="trialLicense" value="${trialLicense}" />
					<var name="versionNumber" value="${versionNumber}" />
					<var name="whatsNewDescription" value="${whatsNewDescription}" />
				</execute>

				<execute macro="AccountAppAdd#clickSubmit" />

				<if>
					<equals arg1="${doApprove}" arg2="true" />
					<then>
						<execute macro="User#logoutAndLogin">
							<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
							<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
						</execute>

						<execute macro="Account#setupAppApprove">
							<var name="appTitle" value="${appTitle}" />
						</execute>
					</then>
				</if>
			</then>
		</if>
	</command>

	<command name="setupAppApprove">
		<var name="pendingQADenyOrApprove" value="Approve" />
		<var name="requestDenyOrSendToQA" value="Send To QA" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdmin#workflowSubmittedApp">
			<var name="appTitle" value="${appTitle}" />
			<var name="pendingQADenyOrApprove" value="${pendingQADenyOrApprove}" />
			<var name="requestDenyOrSendToQA" value="${requestDenyOrSendToQA}" />
		</execute>
	</command>

	<command name="tearDownSubmittedApp">
		<var name="companyNames" value="Account Home,QA.Company" />
		<for list="${companyNames}" param="companyName" >
			<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
				<var name="companyName" value="${companyName}" />
			</execute>

			<for list="QA.Discard,QA.Update,QA.Update.Free" param="appTitle" >
				<execute macro="AccountNavigator#gotoDevSidebar">
					<var name="devSidebarItem" value="Apps" />
				</execute>

				<execute function="Pause" locator1="1000" />

				<var name="key_appTitle" value="${appTitle}" />
				<if>
					<condition function="IsElementPresent" locator1="MPDeveloperApps#APP_TITLE_LINK" />
					<then>
						<execute macro="AccountNavigator#gotoDevApp">
							<var name="appTitle" value="${appTitle}" />
						</execute>

						<execute function="Pause" locator1="1000" />

						<if>
							<condition function="IsElementPresent" locator1="Button#CANCEL_SUBMISSION_BUTTON" />
							<then>
								<execute macro="Button#cancelSubmission" />
							</then>
						</if>

						<if>
							<condition function="IsElementPresent" locator1="MPDeveloperApps#DISCARD_CHANGES" />
							<then>
								<execute function="AssertClickNoError" locator1="MPDeveloperApps#DISCARD_CHANGES" value1="Discard Changes" />
								<execute function="Confirm" value1="Are you sure you want to discard all changes?" />

								<execute macro="Message#success" />
							</then>
						</if>
					</then>
				</if>
			</for>
		</for>
	</command>
</definition>