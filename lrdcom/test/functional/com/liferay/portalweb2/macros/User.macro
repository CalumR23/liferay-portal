<definition>
	<var method="TestPropsUtil#get('portal.login.url')" name="loginURL" />
	<var method="TestPropsUtil#get('portal.logout.url')" name="logoutURL" />
	<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

	<command name="login">
		<execute function="Open" locator1="${loginURL}" />s

		<execute function="Type" locator1="Login#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="Login#PASSWORD_FIELD" value1="${userPassword}" />
		<execute function="Click" locator1="Login#SIGN_IN_BUTTON" />

		<execute function="Open" locator1="${marketplaceURL}" />
	</command>

	<command name="logout">
		<execute function="Open" locator1="${logoutURL}" />
		<execute function="Open" locator1="${marketplaceURL}" />
	</command>

	<command name="logoutAndLogin">
		<execute macro="User#logout" />

		<execute macro="User#login">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>
	</command>
</definition>