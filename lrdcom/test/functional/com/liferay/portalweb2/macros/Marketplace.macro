<definition>
	<command name="purchaseApp">
		<execute macro="Button#button2">
			<var name="buttonName" value="${purchaseOption}" />
		</execute>

		<execute macro="MarketplacePurchaseApp#purchaseAccountTab">
			<var name="legalEntityName" value="${legalEntityName}" />
			<var name="projectName" value="${projectName}" />
			<var name="purchaseOption" value="${purchaseOption}" />
		</execute>

		<if>
			<equals arg1="${purchaseOption}" arg2="Buy" />
			<then>
				<execute macro="MarketplacePurchaseApp#purchaseLicenseTab">
					<var name="developerLicenseQuantityList" value="${developerLicenseQuantityList}" />
					<var name="extendSubscriptionCheckList" value="${extendSubscriptionCheckList}" />
					<var name="extendSubscriptionUncheckList" value="${extendSubscriptionUncheckList}" />
					<var name="licensePurchaseType" value="${licensePurchaseType}" />
					<var name="renewSubscriptionTypeList" value="${renewSubscriptionTypeList}" />
					<var name="renewSubscriptionUncheckList" value="${renewSubscriptionUncheckList}" />
					<var name="standardLicenseQuantityList" value="${standardLicenseQuantityList}" />
				</execute>

				<execute macro="MarketplacePurchaseApp#purchaseDestinationTab">
					<var name="destinationAddressName" value="${destinationAddressName}" />
				</execute>

				<execute macro="MarketplacePurchaseApp#purchaseSummaryTab">
					<var name="developerSummaryQuantityList" value="${developerSummaryQuantityList}" />
					<var name="invoiceEmailAddress" value="${invoiceEmailAddress}" />
					<var name="paymentMethod" value="${paymentMethod}" />
					<var name="standardSummaryQuantityList" value="${standardSummaryQuantityList}" />
				</execute>

				<execute macro="Paypal#pay">
					<var name="paypalEmailAddress" value="${userEmailAddress4}" />
					<var name="paypalEmailPassword" value="${userPassword4}" />
				</execute>
			</then>
		</if>
	</command>

	<command name="tearDownPurchase">
		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Customers" />
		</execute>

		<execute function="Type" locator1="MPAdminCustomers#KEYWORDS_FIELD" value1="${appTitle}" />

		<execute macro="Button#search" />

		<while>
			<condition function="IsElementPresent" locator1="MPAdminCustomers#DELETE" />
			<then>
				<execute function="AssertClickNoError" locator1="MPAdminCustomers#DELETE" value1="Delete" />
				<execute function="Confirm" locator1="Message#CONFIRMATION" value1="Are you sure you want to delete this?" />

				<execute macro="Message#success" />
			</then>
		</while>
	</command>
</definition>