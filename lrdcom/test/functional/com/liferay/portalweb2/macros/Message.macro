<definition>
	<command name="marketplaceUnavailable">
		<execute function="AssertTextEquals" locator1="Message#FAIL_MESSAGE" value1="Marketplace is temporarily unavailable." />
	</command>

	<command name="portletUnavailable">
		<execute function="AssertTextEquals" locator1="Message#FAIL_MESSAGE" value1="Portlet is temporarily unavailable." />
	</command>

	<command name="success">
		<execute function="AssertTextEquals" locator1="Message#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="requestFailed">
		<execute function="AssertTextEquals" locator1="Message#FAIL_MESSAGE" value1="Your request failed to complete." />
	</command>

</definition>