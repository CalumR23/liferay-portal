<definition>
	<command name="searchForApp">
		<var name="key_appTitle" value="${appTitle}" />

		<execute function="Type" locator1="Marketplace#SEARCH_FIELD" value1="${appTitle}" />

		<execute macro="Button#search" />

		<execute function="AssertClick" locator1="Marketplace#APP_TITLE" value1="${appTitle}" />
	</command>
</definition>