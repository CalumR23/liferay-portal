<definition>
	<command name="addNewApp">
		<execute function="Click" locator1="Button#ADD_NEW_APP_BUTTON" />
	</command>

	<command name="addNewVersion">
		<execute function="Click" locator1="MPDeveloperApps#ADD_NEW_VERSION_BUTTON" />
	</command>

	<command name="browse">
		<execute function="Click" locator1="Button#BROWSE_BUTTON" />
	</command>

	<command name="button1">
		<var name="key_ButtonName" value="${buttonName}" />
		<execute function="Click" locator1="Button#BUTTON_1" />
	</command>

	<command name="button2">
		<var name="key_ButtonName" value="${buttonName}" />
		<execute function="Click" locator1="Button#BUTTON_2" />
	</command>

	<command name="cancel">
		<execute function="Click" locator1="Button#CANCEL_BUTTON" />
	</command>

	<command name="cancelSubmission">
		<execute function="Click" locator1="Button#CANCEL_SUBMISSION_BUTTON" />
	</command>

	<command name="developerLicenseAddQuantityButton">
		<execute function="Click" locator1="Button#DEVELOPER_LICENSES_ADD_QUANTITY_BUTTON" />
	</command>

	<command name="edit">
		<execute function="Click" locator1="Button#EDIT_BUTTON" />
	</command>

	<command name="iconBrowse">
		<execute function="Click" locator1="MPDeveloperAppsAddDetails#ICON_BROWSE_BUTTON" />
	</command>

	<command name="next">
		<execute function="Click" locator1="Button#NEXT_BUTTON" />
	</command>

	<command name="saveAsDraft">
		<execute function="Click" locator1="Button#SAVE_AS_DRAFT_BUTTON" />
	</command>

	<command name="search">
		<execute function="Click" locator1="Button#SEARCH_BUTTON" />
	</command>

	<command name="standardLicenseAddQuantityButton">
		<execute function="Click" locator1="Button#STANDARD_LICENSES_ADD_QUANTITY_BUTTON" />
	</command>

	<command name="submit">
		<execute function="Click" locator1="Button#SUBMIT_BUTTON" />
	</command>

	<command name="submitForReview">
		<execute function="Click" locator1="Button#SUBMIT_FOR_REVIEW_BUTTON" />
	</command>

	<command name="uploadBrowse">
		<execute function="Click" locator1="MPDeveloperAppsAddUpload#UPLOAD_BROWSE_BUTTON" />
	</command>

	<command name="uploadTax">
		<execute function="Click" locator1="Button#UPLOAD_TAX_BUTTON" />
	</command>
</definition>