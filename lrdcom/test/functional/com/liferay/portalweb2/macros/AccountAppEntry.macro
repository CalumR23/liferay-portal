<definition>
	<command name="typeNoteToReviewer">
		<execute function="Type" locator1="MPDeveloperApps#NOTE_TO_REVIEWER" value1="${noteToReviewerMessage}" />
	</command>

	<command name="viewAppTitle">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#APP_TITLE" value1="${appTitle}" />
	</command>

	<command name="viewCompanyName">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#COMPANY_NAME" value1="${companyName}" />
	</command>

	<command name="viewCountryViaAppPricing">
		<var name="key_country" value="${country}" />
		<var name="key_tableTitle" value="${tableTitle}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_COUNTRY" />
	</command>

	<command name="viewCurrentRequirements">
		<var name="key_requirementNum" value="requirementNum" />

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#" value1="${liferayVersion}" />
	</command>

	<command name="viewDescription">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#DESCRIPTION" value1="${appDescription}" />
	</command>

	<command name="viewDeveloperLicensePriceViaAppPricing">
		<var name="key_license" value="developer" />
		<var name="key_licenseType" value="prices" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="${developerLicensePrice}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewDeveloperLicensesPriceViaAppPreview">
		<var name="key_licenseNum" value="${licenseNum}" />

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#DEVELOPER_PRICING_PRICE" value1="${developerLicensePrice}" />
	</command>

	<command name="viewDeveloperLicensesUnitsViaAppPreview">
		<var name="key_licenseNum" value="${licenseNum}" />

		<if>
			<equals arg1="${developerLicenseUnits}" arg2="1" />
			<then>
				<var name="val" value="${developerLicenseUnits} Instance Unit" />
			</then>
			<else>
				<var name="val" value="${developerLicenseUnits} Instance Units" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#DEVELOPER_PRICING_LICENSE" value1="${val}" />
	</command>

	<command name="viewDeveloperLicenseunitViaAppPricing">
		<var name="key_license" value="developer" />
		<var name="key_licenseType" value="prices" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="${developerLicenseUnit}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewDeveloperSubscriptionPriceViaAppPricing">
		<var name="key_licenseType" value="support" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="developerSubscriptionPrice" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewDeveloperSubscriptionViaAppPreview">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#DEVELOPER_SUBSCRIPTION" value1="${developerSubscriptionPrice}" />
	</command>

	<command name="viewDeveloperWebsiteURL">
		<var name="key_developerWebsiteUrl" value="${developerWebsiteUrl}" />
		<execute function="AssertElementPresent" locator1="MPDeveloperApps#DEVELOPER_WEBSITE_URL" />
	</command>

	<command name="viewDocumentationURL">
		<var name="key_documentationUrl" value="${documentationUrl}" />
		<execute function="AssertElementPresent" locator1="MPDeveloperApps#DOCUMENTATION_WEBSITE_URL" />
	</command>

	<command name="viewLatestChanges">
		<if>
			<condition function="IsElementPresent" locator1="MPDeveloperApps#LATEST_CHANGES_COLLAPSED" />
			<then>
				<execute function="Click" locator1="MPDeveloperApps#LATEST_CHANGES_COLLAPSED" />
			</then>
		</if>

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#LATEST_CHANGES" value1="${latestChanges}" />
	</command>

	<command name="viewSourceCodeURL">
		<var name="key_sourceCodeUrl" value="${sourceCodeUrl}" />
		<execute function="AssertElementPresent" locator1="MPDeveloperApps#SOURCE_CODE_URL" />
	</command>

	<command name="viewStandardLicensePriceViaAppPricing">
		<var name="key_license" value="standard" />
		<var name="key_licenseType" value="prices" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="${standardLicensePrice}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewStandardLicensesPriceViaAppPreview">
		<var name="key_licenseNum" value="${licenseNum}" />

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#STANDARD_PRICING_PRICE" value1="${standardLicensePrice}" />
	</command>

	<command name="viewStandardLicensesUnitsViaAppPreview">
		<var name="key_licenseNum" value="${licenseNum}" />

		<if>
			<equals arg1="${standardLicenseUnits}" arg2="1" />
			<then>
				<var name="val" value="${standardLicenseUnits} Instance Unit" />
			</then>
			<else>
				<var name="val" value="${standardLicenseUnits} Instance Units" />
			</else>
		</if>

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#STANDARD_PRICING_LICENSE" value1="${val}" />
	</command>

	<command name="viewStandardLicenseUnitViaAppPricing">
		<var name="key_license" value="standard" />
		<var name="key_licenseType" value="prices" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="${standardLicenseUnit}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewStandardSubscriptionPriceViaAppPricing">
		<var name="key_licenseType" value="support" />
		<var name="key_tableTitle" value="${tableTitle}" />
		<var name="key_value" value="${standardSubscriptionPrice}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_LICENSES" />
	</command>

	<command name="viewStandardSubscriptionViaAppPreview">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#STANDARD_SUBSCRIPTION" value1="${standardSubscriptionPrice}" />
	</command>

	<command name="viewSummaryAppStatus">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_STATUS" value1="${appStatus}" />
	</command>

	<command name="viewSummaryAppTitle">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_APP_TITLE" value1="${appTitle}" />
	</command>

	<command name="viewSummaryCategory">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_CATEGORY" value1="${appCategory}" />
	</command>

	<command name="viewSummaryCompanyName">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_COMPANY_NAME" value1="${companyName}" />
	</command>

	<command name="viewSummaryLicense">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_LICENSE" value1="${appLicense}" />
	</command>

	<command name="viewSummarySupport">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_SUPPORT" value1="${appSupport}" />
	</command>

	<command name="viewSummaryTrial">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_TRIAL" value1="${appTrial}" />
	</command>

	<command name="viewSummaryType">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_TYPE" value1="${appType}" />
	</command>

	<command name="viewSupportURL">
		<var name="key_supportUrl" value="${supportUrl}" />
		<execute function="AssertElementPresent" locator1="MPDeveloperApps#SUPPORT_URL" />
	</command>

	<command name="viewTableTitleViaAppPricing">
		<var name="key_tableTitle" value="${tableTitle}" />

		<execute function="AssertElementPresent" locator1="MPDeveloperApps#APP_PRICING_TABLE_NAME" />
	</command>

	<command name="viewTags">
		<var name="key_tagNum" value="${tagNum}" />

		<execute function="AssertTextEquals" locator1="MPDeveloperApps#TAGS" value1="${tag}" />
	</command>

	<command name="viewVersion">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#VERSION" value1="Latest Version: ${versionNumber}" />
	</command>
</definition>