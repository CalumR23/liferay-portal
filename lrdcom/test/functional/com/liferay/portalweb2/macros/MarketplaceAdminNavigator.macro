<definition>
	<command name="gotoAdminTab">
		<if>
			<equals arg1="${adminTab}" arg2="Dashboard" />
			<then>
				<execute function="AssertClick" locator1="MPAdmin#DASHBOARD" value1="Dasboard" />
			</then>
			<elseif>
				<equals arg1="${adminTab}" arg2="Apps" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#APPS" value1="Apps" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Contracts" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#CONTRACTS" value1="Contracts" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Customers" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#CUSTOMERS" value1="Customers" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Developers" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#DEVELOPERS" value1="Developers" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Lists" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#LISTS" value1="Lists" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Metrics" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#METRICS" value1="Metrics" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${adminTab}" arg2="Reports" />
				<then>
					<execute function="AssertClick" locator1="MPAdmin#REPORTS" value1="Reports" />
				</then>
			</elseif>
		</if>
	</command>

	<command name="gotoApp">
		<var name="key_appTitle" value="${appTitle}" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Apps" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoAppsTab">
			<var name="appsTab" value="Manage" />
		</execute>

		<execute function="Type" locator1="MPAdminApps#TITLE_FIELD" value1="${appTitle}" />

		<execute macro="Button#search" />

		<execute function="Click" locator1="MPAdminApps#APP_TITLE" value1="${appTitle}" />
	</command>

	<command name="gotoAppsTab">
		<if>
			<equals arg1="${appsTab}" arg2="Manage" />
			<then>
				<execute function="AssertClick" locator1="MPAdminApps#MANAGE" value1="Manage" />
			</then>
			<elseif>
				<equals arg1="${appsTab}" arg2="Requests" />
				<then>
					<execute function="AssertClick" locator1="MPAdminApps#REQUESTS" value1="Requests" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${appsTab}" arg2="Pending QA" />
				<then>
					<execute function="AssertClick" locator1="MPAdminApps#PENDING_QA" value1="Pending QA" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${appsTab}" arg2="Denied" />
				<then>
					<execute function="AssertClick" locator1="MPAdminApps#DENIED" value1="Denied" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${appsTab}" arg2="Disabled" />
				<then>
					<execute function="AssertClick" locator1="MPAdminApps#DISABLED" value1="Disabled" />
				</then>
			</elseif>
		</if>
	</command>

	<command name="gotoCustomer">
		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Customers" />
		</execute>

		<execute macro="MarketplaceAdmin#lookforCustomer">
			<var name="appTitle" value="${appTitle}" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>
	</command>

	<command name="gotoDeveloper">
		<var name="key_companyName" value="${companyName}" />

		<execute function="Type" locator1="MPAdminDevelopers#KEYWORDS_FIELD" value1="${companyName}" />
		<execute function="Click" locator1="MPAdminDevelopers#SEARCH_BUTTON" />
		<execute function="Click" locator1="MPAdminDevelopers#CREATE_DATE" />
		<execute function="Click" locator1="MPAdminDevelopers#CREATE_DATE" />
		<execute function="Click" locator1="MPAdminDevelopers#NAME_LIST" />
	</command>

	<command name="gotoMPAdmin">
		<var method="TestPropsUtil#get('portal.control.panel.url')" name="controlPanelURL" />

		<execute function="Open" locator1="${controlPanelURL}" />
		<execute function="AssertClick" locator1="MPAdmin#MARKETPLACE_ADMIN" value1="Marketplace Admin" />
	</command>
</definition>