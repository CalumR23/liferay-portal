<definition>
	<command name="pay">
		<execute function="AssertClick" locator1="Paypal#LOGIN_TO_PAYPAL" value1="Log in to your PayPal account" />

		<execute macro="PaypalEntry#typeEmailAddress">
			<var name="paypalEmailAddress" value="${paypalEmailAddress}" />
		</execute>

		<execute macro="PaypalEntry#typePassword">
			<var name="paypalEmailPassword" value="${paypalEmailPassword}" />
		</execute>

		<execute function="AssertClick" locator1="Paypal#LOGIN_BUTTON" value1="Log In" />

		<execute function="AssertClick" locator1="Paypal#PAY_BUTTON" value1="Pay" />

		<execute function="Pause" locator1="5000" />
	</command>
</definition>