<definition>
	<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

	<command name="gotoAccountHome">

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />

		<execute function="Click" locator1="MPNavigation#ACCOUNT_HOME" />
	</command>

	<command name="gotoBecomeDeveloper">
		<var name="key_devSubmenuItem" value="Become a Developer" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute function="Click" locator1="MPNavigation#DEVELOPERS" />

		<execute function="Click" locator1="MPNavigation#DEVELOPERS_SUBMENU" />
	</command>

	<command name="gotoCompanyAccount">
		<var name="key_companyName" value="${companyName}" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />

		<execute function="Click" locator1="MPNavigation#COMPANY_SITE" />
	</command>

	<command name="gotoMarketplace">
		<var name="key_devSubmenuItem" value="Marketplace" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute function="Click" locator1="MPNavigation#DEVELOPERS" />

		<execute function="Click" locator1="MPNavigation#DEVELOPERS_SUBMENU" />
	</command>
</definition>