<definition>
	<command name="checkLabs">
		<execute function="Check" locator1="MPDeveloperAppsAddDetails#LABS_CHECKBOX" />
	</command>

	<command name="checkLicenseTerm">
		<var name="key_licenseTerm" value="${licenseTerm}" />

		<execute function="Check" locator1="MPDeveloperAppsAddLicense#LICENSE_TERM_RADIO" />
	</command>

	<command name="checkLocalized">
		<execute function="Check" locator1="MPDeveloperAppsAddDetails#LOCALIZED_CHECKBOX" />
	</command>

	<command name="checkPricing">
		<var name="key_isFreePaid" value="${isFreePaid}" />

		<execute function="Check" locator1="MPDeveloperAppsAddDetails#PRICE_RADIO" />
	</command>

	<command name="checkSecurity">
		<execute function="Check" locator1="MPDeveloperAppsAddDetails#SECURITY_CHECKBOX" />
	</command>

	<command name="checkSubscriptionServices">
		<execute function="Check" locator1="MPDeveloperAppsAddLicense#OFFER_SUBSCRIPTION_CHECKBOX" />
	</command>

	<command name="checkTrialLicense">
		<execute function="Check" locator1="MPDeveloperAppsAddLicense#TRIAL_LICENSE_CHECKBOX" />
	</command>

	<command name="clickDeleteTable">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Click" locator1="MPDeveloperAppsAddPricing#DELETE" />
	</command>

	<command name="moveAllCountriesFromPoolToTable">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Click" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_SELECT_ALL" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />
		<execute function="MouseDown#mouseDownAt" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />

		<execute function="Pause" locator1="2000" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />
		<execute function="MouseUp#mouseUpAt" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />
	</command>

	<command name="moveAllCountriesFromTableToPool">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Click" locator1="MPDeveloperAppsAddPricing#SELECT_ALL" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />
		<execute function="MouseDown#mouseDownAt" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />

		<execute function="Pause" locator1="2000" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />
		<execute function="MouseUp#mouseUpAt" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />
	</command>

	<command name="moveSelectedCountryToPool">
		<var name="key_country" value="${country}" />
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Click" locator1="MPDeveloperAppsAddPricing#COUNTRY" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#COUNTRY" />
		<execute function="MouseDown#mouseDownAt" locator1="MPDeveloperAppsAddPricing#COUNTRY" />

		<execute function="Pause" locator1="2000" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />
		<execute function="MouseUp#mouseUpAt" locator1="MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE" />
	</command>

	<command name="moveSelectedCountryToTable">
		<var name="key_country" value="${country}" />
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Click" locator1="MPDeveloperAppsAddPricing#COUNTRY" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#COUNTRY" />
		<execute function="MouseDown#mouseDownAt" locator1="MPDeveloperAppsAddPricing#COUNTRY" />

		<execute function="Pause" locator1="2000" />

		<execute function="MouseOver" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />
		<execute function="MouseUp#mouseUpAt" locator1="MPDeveloperAppsAddPricing#COUNTRIES_ZONE" />
	</command>

	<command name="selectCategory">
		<execute function="Select" locator1="MPDeveloperAppsAddDetails#CATEGORY_SELECT" value1="${appCategory}" />
	</command>

	<command name="selectCurrency">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Select" locator1="MPDeveloperAppsAddPricing#CURRENCY_SELECT" value1="${currency}" />
	</command>

	<command name="typeDescription">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#DESCRIPTION" value1="${appDescription}" />
	</command>

	<command name="typeDeveloperLicensePrice">
		<var name="key_licenseNum" value="${licenseNum}" />
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Type" locator1="MPDeveloperAppsAddPricing#DEVELOPER_LICENSE_PRICE_FIELD" value1="${developerLicensePrice}" />
	</command>

	<command name="typeDeveloperLicenseQuantity">
		<execute function="Type" locator1="MPDeveloperAppsAddLicense#DEVELOPER_LICENSE_QUANTITY_FIELD" value1="${developerLicenseQuantity}" />
	</command>

	<command name="typeDeveloperSubscriptionPrice">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Type" locator1="MPDeveloperAppsAddPricing#DEVELOPER_SUBSCRIPTION_PRICE_FIELD" value1="${developerSubscriptionPrice}" />
	</command>

	<command name="typeDeveloperUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#DEVELOPER_WEBSITE_URL" value1="${developerWebsiteUrl}" />
	</command>

	<command name="typeDocumentationUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#DOCUMENTATION_URL" value1="${documentationUrl}" />
	</command>

	<command name="typeSourceCodeUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#SOURCE_CODE_URL" value1="${sourceCodeUrl}" />
	</command>

	<command name="typeStandardLicensePrice">
		<var name="key_licenseNum" value="${licenseNum}" />
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Type" locator1="MPDeveloperAppsAddPricing#STANDARD_LICENSE_PRICE_FIELD" value1="${standardLicensePrice}" />
	</command>

	<command name="typeStandardLicenseQuantity">
		<execute function="Type" locator1="MPDeveloperAppsAddLicense#STANDARD_LICENSE_QUANTITY_FIELD" value1="${standardLicenseQuantity}" />
	</command>

	<command name="typeStandardSubscriptionPrice">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Type" locator1="MPDeveloperAppsAddPricing#STANDARD_SUBSCRIPTION_PRICE_FIELD" value1="${standardSubscriptionPrice}" />
	</command>

	<command name="typeSupportUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#SUPPORT_URL" value1="${supportUrl}" />
	</command>

	<command name="typeTableTitle">
		<var name="key_tableNum" value="${tableNum}" />

		<execute function="Type" locator1="MPDeveloperAppsAddPricing#TITLE_FIELD" value1="${tableTitle}" />
	</command>

	<command name="typeTitle">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#TITLE" value1="${appTitle}" />
	</command>

	<command name="typeVersionNumber">
		<execute function="Type" locator1="MPDeveloperAppsAddUpload#VERSION_NUMBER_FIELD" value1="${versionNumber}" />
	</command>
</definition>