<definition>
	<command name="checkPricing">
		<var name="key_isFreePaid" value="${isFreePaid}" />
		<execute function="Check" locator1="MPDeveloperAppsAddDetails#PRICE_RADIO" />
	</command>

	<command name="selectCategory">
		<execute function="Select" locator1="MPDeveloperAppsAddDetails#CATEGORY_SELECT" value1="${appCategory}" />
	</command>

	<command name="typeDescription">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#DESCRIPTION" value1="${appDescription}" />
	</command>

	<command name="typeDeveloperUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#DEVELOPER_WEBSITE_URL" value1="${developerWebsiteUrl}" />
	</command>

	<command name="typeSupportUrl">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#SUPPORT_URL" value1="${supportUrl}" />
	</command>

	<command name="typeTitle">
		<execute function="Type" locator1="MPDeveloperAppsAddDetails#TITLE" value1="${appTitle}" />
	</command>

	<command name="typeVersionNumber">
		<execute function="Type" locator1="MPDeveloperAppsAddUpload#VERSION_NUMBER_FIELD" value1="${versionNumber}" />
	</command>

	<command name="viewAppDetails">
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#COMPANY_NAME" value1="${companyName}" />
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#APP_NAME" value1="${appTitle}" />
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#DESCRIPTION" value1="${appDescription}" />
		<execute function="AssertTextEquals" locator1="MPDeveloperApps#VERSION" value1="Latest Version: ${versionNumber}" />
	</command>
</definition>