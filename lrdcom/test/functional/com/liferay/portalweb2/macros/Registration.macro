<definition>
	<command name="convertToPaidDeveloperAccount">
		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute macro="Button#uploadTax" />

		<execute macro="Sikuli#uploadFile">
			<var name="fileName" value="Document_1.pdf" />
		</execute>

		<execute macro="RegistrationEntry#selectTaxDocumentType">
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="RegistrationEntry#typeFirstName">
			<var name="firstName" value="Test" />
		</execute>

		<execute macro="RegistrationEntry#typeMiddleName">
			<var name="middleName" value="QA" />
		</execute>

		<execute macro="RegistrationEntry#typeLastName">
			<var name="lastName" value="Marketplace" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyName">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="RegistrationEntry#typeAddressLine1">
			<var name="companyAddress" value="123 A St" />
		</execute>

		<execute macro="RegistrationEntry#selectCountry">
			<var name="companyCountry" value="United States" />
		</execute>

		<execute macro="RegistrationEntry#selectRegion">
			<var name="companyRegion" value="California" />
		</execute>

		<execute macro="RegistrationEntry#typeCity">
			<var name="companyCity" value="Los Angeles" />
		</execute>

		<execute macro="RegistrationEntry#typePostalCode">
			<var name="companyPostalCode" value="90210" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="RegistrationEntry#typeFirstName">
			<var name="firstName" value="Joe" />
		</execute>

		<execute macro="RegistrationEntry#typeLastName">
			<var name="lastName" value="Bloggs" />
		</execute>

		<execute macro="RegistrationEntry#typePaymentEmail">
			<var name="userEmailAddress3" value="${userEmailAddress3}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="Button#next" />

		<execute macro="Button#next" />
	</command>

	<command name="registerNewCompany">
		<execute function="Click" locator1="MPRegistrationCompany#REGISTER_BUTTON" />

		<execute function="Click" locator1="MPRegistrationCompany#LOGO_BUTTON" />

		<execute macro="Sikuli#uploadFile">
			<var name="fileName" value="${companyIcon}" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyName">
			<var name="companyDescription" value="${companyDescription}" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyDescription">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="RegistrationEntry#typeAddressLine1">
			<var name="companyAddress" value="${companyAddress}" />
		</execute>

		<execute macro="RegistrationEntry#selectCountry">
			<var name="companyCountry" value="${companyCountry}" />
		</execute>

		<execute macro="RegistrationEntry#selectRegion">
			<var name="companyRegion" value="${companyRegion}" />
		</execute>

		<execute macro="RegistrationEntry#typeCity">
			<var name="companyCity" value="${companyCity}" />
		</execute>

		<execute macro="RegistrationEntry#typePostalCode">
			<var name="companyPostalCode" value="${companyPostalCode}" />
		</execute>

		<execute macro="RegistrationEntry#typePhone">
			<var name="companyPhone" value="${companyPhone}" />
		</execute>

		<execute macro="RegistrationEntry#typeCompanyEmail">
			<var name="companyEmail" value="${companyEmail}" />
		</execute>

		<execute function="Click" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON" />

		<execute macro="Sikuli#uploadFile">
			<var name="fileName" value="${companyTaxDocument}" />
		</execute>

		<execute macro="RegistrationEntry#selectTaxDocumentType">
			<var name="companyTaxType" value="${companyTaxType}" />
		</execute>

		<execute macro="RegistrationEntry#checkAgree" />

		<execute function="Click" locator1="MPRegistrationCompany#SUBMIT_REQUEST" />

		<execute macro="Message#success" />
	</command>

	<command name="searchForCompany">
		<var name="key_companyNane" value="${companyName}" />

		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_NAME_SEARCH_FIELD" value1="${companyName}" />

		<execute macro="Button#search" />
	</command>

	<command name="setupCompany">
		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />
		<if>
			<condition function="IsElementNotPresent" locator1="MPNavigation#COMPANY_SITE" />
			<then>
				<execute macro="MarketplaceNavigation#gotoBecomeDeveloper" />

				<execute macro="Registration#searchForCompany">
					<var name="companyName" value="${companyName}" />
				</execute>

				<execute macro="Registration#registerNewCompany">
					<var name="companyAddress" value="${companyAddress}" />
					<var name="companyCity" value="${companyCity}" />
					<var name="companyCountry" value="${companyCountry}" />
					<var name="companyDescription" value="${companyDescription}" />
					<var name="companyEmail" value="${companyEmail}" />
					<var name="companyIcon" value="${companyIcon}" />
					<var name="companyName" value="${companyName}" />
					<var name="companyPhone" value="${companyPhone}" />
					<var name="companyPostalCode" value="${companyPostalCode}" />
					<var name="companyRegion" value="${companyRegion}" />
					<var name="companyTaxDocument" value="${companyTaxDocument}" />
					<var name="companyTaxType" value="${companyTaxType}" />
				</execute>

				<execute macro="User#logoutAndLogin">
					<var name="liferayURL" value="${liferayURL}" />
					<var name="userEmailAddress" value="${userEmailAddress5}" />
					<var name="userPassword" value="${userPassword5}" />
				</execute>

				<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

				<execute macro="MarketplaceAdmin#workflowCompany">
					<var name="companyName" value="${companyName}" />
					<var name="denyOrPass" value="Approve" />
				</execute>

				<execute macro="MarketplaceNavigation#gotoMarketplace" />
			</then>
		</if>
	</command>

	<command name="tearDownRegistrationCompany">
		<execute macro="User#logout">
			<var name="liferayURL" value="${liferayURL}" />
		</execute>

		<execute macro="User#login">
			<var name="userEmailAddress" value="${userEmailAddress5}" />
			<var name="userPassword" value="${userPassword5}" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#denyOrApproveCompany">
			<var name="denyOrPass" value="Deny" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#disableCompany" />
	</command>
</definition>