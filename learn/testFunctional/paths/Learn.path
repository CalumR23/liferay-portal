<html>
<head>
<title>Learn</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Learn</td></tr>
</thead>

<tbody>
<tr>
	<td>ERROR_BLOCK</td>
	<td>//div[contains(@class,'block error')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_1</td>
	<td>//*[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_2</td>
	<td>//*[contains(@class,'portlet-msg-error')]</td>
	<td></td>
</tr>
<tr>
	<td>HOMEPAGE_LINK</td>
	<td>xpath=(//*[contains(@class,'row')]//a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_CARD_LINK</td>
	<td>xpath=(//div/ul[contains(@class,'subsection') and not(contains(@style,'display'))]/li[not(contains(@style,'display'))]//a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_1</td>
	<td>//h1[contains(.,'Sorry, this page does not exist.')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_2</td>
	<td>//h2[contains(.,"This page doesn't exist!")]</td>
	<td></td>
</tr>
<tr>
	<td>TOP_NAVIGATION_LINKS</td>
	<td>//div[contains(@class,'header-links') and contains(@aria-label,'navigation')]/a[${key_positionValue}]</td>
	<td></td>
</tr>

<!--FOOTER-->

<tr>
	<td>FOOTER_DROPDOWN_LANGUAGE_LINK</td>
	<td>xpath=(//ul[contains(@aria-labelledby,'languageSelector')]/li/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_LANGUAGE_DROPDOWN</td>
	<td>//div[contains(@class,'doc-nav-footer')]//button[contains(@id,'languageSelector')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>