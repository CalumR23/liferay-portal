@component-name = "liferay-dev"
definition {

	property testray.main.component.name = "liferay-dev";

	@priority = "5"
	test DemoTest {
		var portalURL = PropsUtil.get("portal.url");

		Open(locator1 = "${portalURL}");

		Pause(locator1 = "3000");

		LDNavigation.goToAsk();

		Pause(locator1 = "3000");

		LDNavigation.goToBlogs();

		Pause(locator1 = "3000");

		LDNavigation.goToChat();

		Pause(locator1 = "3000");

		LDNavigation.goToDev24();

		Pause(locator1 = "3000");

		LDNavigation.goToMeet();

		Pause(locator1 = "3000");

		LDNavigation.goToProjects();

		Pause(locator1 = "3000");
	}

}