definition {

	macro viewCardResults {
		LDAsk.openCard(cardTitle = "${cardTitle}");

		var key_cardTitle = "${cardTitle}";

		Default.AssertElementPresent(locator1 = "LDCardResults#BREADCRUMB_TITLE");

		Default.AssertElementPresent(locator1 = "LDCardResults#QUESTION_TITLE");

		Default.AssertElementPresent(locator1 = "LDCardResults#QUESTION_CONTENT");
	}

}