definition {

	macro signIn {
		LDNavigation.goToLogin();

		Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		AssertElementNotPresent(locator1 = "OktaLogin#SIGN_IN_BUTTON");
	}

}