definition {

	macro signIn {
		LDNavigation.goToLogin();

		Default.Type(
			locator1 = "OktaLogin#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Default.Type(
			locator1 = "OktaLogin#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Default.Click(locator1 = "OktaLogin#SIGN_IN_BUTTON");

		Default.AssertElementNotPresent(locator1 = "OktaLogin#SIGN_IN_BUTTON");
	}

}