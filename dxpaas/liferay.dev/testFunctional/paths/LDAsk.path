<html>
<head>
<title>LDAsk</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">LDAsk</td></tr>
</thead>

<tbody>
<!-- SEARCH -->
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[@data-qa-id='searchInput']</td>
	<td></td>
</tr>

<!-- CARDS SECTION -->
<tr>
	<td>CARD_TITLE</td>
	<td>//section[contains(@class,'questions-section')]//div[contains(@class,'questions-container')]//p[@title='${key_cardTitle}']</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>