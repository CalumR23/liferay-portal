<definition component-name="analytics-cloud-sales-demo">
	<property name="testray.main.component.name" value="analytics-cloud" />

	<command name="SalesDemoDeveloperPersona" priority="5">
		<execute function="Open" locator1="https://demo:cloud@cloud-10-0-20-20.liferay.com" />

		<execute function="Pause" locator1="3000" />

		<execute macro="ACLogin#signIn">
			<var name="password" value="test" />
			<var name="userName" value="neil" />
		</execute>

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Product" />
			<var name="menuSecondary" value="Features" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Resource" />
			<var name="menuSecondary" value="Resource Library" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACLink#click">
			<var name="linkText" value="Application Integration Strategies" />
		</execute>

		<execute macro="ACLink#click">
			<var name="linkText" value="Get the Whitepaper" />
		</execute>

		<execute function="Open" locator1="https://cloud-10-0-20-20.liferay.com/web/analyticscloud/resource-library" />

		<execute macro="ACLink#click">
			<var name="linkText" value="Advanced Architecture" />
		</execute>

		<execute macro="ACLink#click">
			<var name="linkText" value="Get the Whitepaper" />
		</execute>

		<execute function="Open" locator1="https://cloud-10-0-20-20.liferay.com/web/analyticscloud/resource-library" />

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Services" />
			<var name="menuSecondary" value="Training" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Services" />
			<var name="menuSecondary" value="Hosting" />
		</execute>

		<execute function="Pause" locator1="15000" />
	</command>

	<command name="SalesDemoCTOPersona" priority="5">
		<execute function="Open" locator1="https://demo:cloud@cloud-10-0-20-20.liferay.com" />

		<execute macro="ACLogin#signIn">
			<var name="password" value="test" />
			<var name="userName" value="max" />
		</execute>

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Resource" />
			<var name="menuSecondary" value="Case Studies" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute function="Click" locator1="//a[contains(@href,'case-study')]" />

		<execute function="Pause" locator1="15000" />

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Resource" />
			<var name="menuSecondary" value="Blog" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACLink#click">
			<var name="linkText" value="MindSpark Symposium" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACNavigation#useNavBar">
			<var name="menuPrimary" value="Resource" />
			<var name="menuSecondary" value="Events" />
		</execute>

		<execute function="Pause" locator1="15000" />

		<execute macro="ACLink#click">
			<var name="linkText" value="Mindspark Symposium" />
		</execute>

		<execute macro="ACLink#click">
			<var name="linkText" value="Registration Form" />
		</execute>

		<execute macro="ACForm#type">
			<var name="fieldName" value="FirstName" />
			<var name="fieldValue" value="Max" />
		</execute>

		<execute macro="ACForm#type">
			<var name="fieldName" value="LastName" />
			<var name="fieldValue" value="Smith" />
		</execute>

		<execute macro="ACForm#type">
			<var name="fieldName" value="Email" />
			<var name="fieldValue" value="max@insightful.com" />
		</execute>

		<execute macro="ACForm#type">
			<var name="fieldName" value="CellPhone" />
			<var name="fieldValue" value="123-456-7890" />
		</execute>

		<execute macro="ACButton#click">
			<var name="buttonText" value="Next" />
		</execute>

		<execute function="Pause" locator1="15000" />
	</command>
</definition>