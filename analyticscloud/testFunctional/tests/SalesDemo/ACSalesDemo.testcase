@component-name = "analytics-cloud-sales-demo"
definition {

	property testray.main.component.name = "analytics-cloud";

	@priority = "5"
	test SalesDemoCTOPersona {
		Open(locator1 = "https://demo:cloud@cloud-10-0-20-20.liferay.com");

		ACLogin.signIn(
			password = "test",
			userName = "max");

		ACNavigation.useNavBar(
			menuPrimary = "Resource",
			menuSecondary = "Case Studies");

		Pause(locator1 = "15000");

		Click(locator1 = "//a[contains(@href,'case-study')]");

		Pause(locator1 = "15000");

		ACNavigation.useNavBar(
			menuPrimary = "Resource",
			menuSecondary = "Blog");

		Pause(locator1 = "15000");

		ACLink.click(linkText = "MindSpark Symposium");

		Pause(locator1 = "15000");

		ACNavigation.useNavBar(
			menuPrimary = "Resource",
			menuSecondary = "Events");

		Pause(locator1 = "15000");

		ACLink.click(linkText = "Mindspark Symposium");

		ACLink.click(linkText = "Registration Form");

		ACForm.type(
			fieldName = "FirstName",
			fieldValue = "Max");

		ACForm.type(
			fieldName = "LastName",
			fieldValue = "Smith");

		ACForm.type(
			fieldName = "Email",
			fieldValue = "max@insightful.com");

		ACForm.type(
			fieldName = "CellPhone",
			fieldValue = "123-456-7890");

		ACButton.click(buttonText = "Next");

		Pause(locator1 = "15000");
	}

	@priority = "5"
	test SalesDemoDeveloperPersona {
		Open(locator1 = "https://demo:cloud@cloud-10-0-20-20.liferay.com");

		Pause(locator1 = "3000");

		ACLogin.signIn(
			password = "test",
			userName = "neil");

		ACNavigation.useNavBar(
			menuPrimary = "Product",
			menuSecondary = "Features");

		Pause(locator1 = "15000");

		ACNavigation.useNavBar(
			menuPrimary = "Resource",
			menuSecondary = "Resource Library");

		Pause(locator1 = "15000");

		ACLink.click(linkText = "Application Integration Strategies");

		ACLink.click(linkText = "Get the Whitepaper");

		Open(locator1 = "https://cloud-10-0-20-20.liferay.com/web/analyticscloud/resource-library");

		ACLink.click(linkText = "Advanced Architecture");

		ACLink.click(linkText = "Get the Whitepaper");

		Open(locator1 = "https://cloud-10-0-20-20.liferay.com/web/analyticscloud/resource-library");

		ACNavigation.useNavBar(
			menuPrimary = "Services",
			menuSecondary = "Training");

		Pause(locator1 = "15000");

		ACNavigation.useNavBar(
			menuPrimary = "Services",
			menuSecondary = "Hosting");

		Pause(locator1 = "15000");
	}

}