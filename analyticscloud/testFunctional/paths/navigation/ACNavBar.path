<html>
<head>
<title>ACNavBar</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ACNavBar</td></tr>
</thead>

<tbody>
<tr>
	<td>MENU</td>
	<td>//div[@class='navbar']//li[contains(.,'${key_menuBar}')]</td>
	<td></td>
</tr>
<tr>
	<td>MENU_DROPDOWN</td>
	<td>//ul[contains(@class,'dropdown-menu')]//a[contains(.,'${key_menuDropdown}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>