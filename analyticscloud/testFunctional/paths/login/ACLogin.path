<html>
<head>
<title>ACLogin</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">ACLogin</td></tr>
</thead>

<tbody>
<tr>
	<td>USERNAME</td>
	<td>//input[contains(@id,'LoginPortlet_login')]</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD</td>
	<td>//input[contains(@id,'LoginPortlet_password')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_LINK</td>
	<td>//a[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//button[contains(.,'Sign In')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>