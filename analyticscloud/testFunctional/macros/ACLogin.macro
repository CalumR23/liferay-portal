<definition>
	<command name="signIn">
		<execute function="Click" locator1="ACLogin#SIGN_IN_LINK"/>

		<execute function="Type" locator1="ACLogin#USERNAME" value1="${userName}" />
		<execute function="Type" locator1="ACLogin#PASSWORD" value1="${password}" />

		<execute function="Click" locator1="ACLogin#SIGN_IN_BUTTON" />
	</command>
</definition>