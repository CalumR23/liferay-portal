<definition>
	<command name="useNavBar">
		<var name="key_menuDropdown" value="${menuSecondary}" />
		<var name="key_menuBar" value="${menuPrimary}" />

		<execute function="Click" locator1="ACNavBar#MENU" value1="${menuPrimary}" />
		<execute function="Click" locator1="ACNavBar#MENU_DROPDOWN" value1="${menuSecondary}" />
	</command>
</definition>