definition {
	var siteMember = "User";
	var siteType = "Open";

	macro addCP {
		LexiconEntry.gotoAdd();

		if (!("${singleSiteTypePermission}" == "true")) {
			if ("${siteType}" == "Blank") {
				AssertClick(
					locator1 = "MenuItem#ANY_MENU_ITEM",
					value1 = "Blank Site",
					key_menuItem = "Blank Site"
				);
			}
			else if ("${siteType}" == "Community") {
				AssertClick(
					locator1 = "MenuItem#ANY_MENU_ITEM",
					value1 = "Community Site",
					key_menuItem = "Community Site"
				);
			}
			else if ("${siteType}" == "Intranet") {
				AssertClick(
					locator1 = "MenuItem#ANY_MENU_ITEM",
					value1 = "Intranet Site",
					key_menuItem = "Intranet Site"
				);
			}
			else if ("${siteType}" == "Site Template") {
				Click(locator1 = "MenuItem#ANY_MENU_ITEM", key_menuItem = "${siteTemplateName}");
			}
			else {
				fail("Invalid var siteType. Must be (Blank|Community|Intranet|Site Template).");
			}
		}

		PortletEntry.inputName(name = "${siteName}");

		if (("${siteType}" == "Community") || ("${siteType}" == "Site Template")) {
			if ("${uncheckPropagation}" == "true") {
				Panel.expandPanel(panelHeading = "Pages");

				Uncheck.uncheckToggleSwitch(locator1 = "Checkbox#ENABLE_PROPAGATION");
			}
		}

		if ("${siteType}" == "Site Template") {
			if ("${pageType}" == "Private") {
				Click(locator1 = "SiteSettings#PAGES_COPY_AS_PRIVATE_PAGES_RADIO_BUTTON");
			}
			else {
				Click(locator1 = "SiteSettings#PAGES_COPY_AS_PUBLIC_PAGES_RADIO_BUTTON");
			}
		}

		if ("${membershipType}" == "Private") {
			Select(locator1 = "SitesEditSite#MEMBERSHIP_TYPE", value1 = "Private");
		}
		else if ("${membershipType}" == "Restricted") {
			Select(locator1 = "SitesEditSite#MEMBERSHIP_TYPE", value1 = "Restricted");
		}
		else {
			Select(locator1 = "SitesEditSite#MEMBERSHIP_TYPE", value1 = "Open");
		}

		if (isSet(parentSiteName)) {
			AssertClick(locator1 = "SyncButtonSELECT", value1 = "Select");

			var key_parentSiteName = "${parentSiteName}";

			SelectFrame(locator1 = "SitesSelectSite#SELECT_SITE_IFRAME");

			Type(locator1 = "NavBar#BASIC_SEARCH_FIELD", value1 = "${parentSiteName}");

			KeyPress(locator1 = "NavBar#BASIC_SEARCH_FIELD", value1 = "\RETURN");

			var key_site = "${parentSiteName}";

			AssertTextEquals(
				locator1 = "ContentRow#ENTRY_CONTENT_ROW_TD_1_SITE_LINK",
				value1 = "${parentSiteName}"
			);

			Click(locator1 = "ContentRow#ENTRY_CONTENT_ROW_TD_1_SITE_LINK");

			var key_parentSiteName = "${parentSiteName}";

			SelectFrameTop();
		}

		PortletEntry.save();

		AssertTextEquals(
			locator1 = "SitesEditSite#DETAILS_NAME",
			value1 = "${siteName}"
		);
	}

	macro addPrivatePageTemplateCP {
		AssertTextEquals(locator1 = "TextInput#NAME", value1 = "${siteName}");

		Select(
			locator1 = "SiteSettings#PAGES_PRIVATE_PAGES_SITE_TEMPLATE_SELECT",
			value1 = "${siteTemplateName}"
		);

		PortletEntry.save();
	}

	macro addSiteTemplateCP {
		Site.addCP(
			membershipType = "${membershipType}",
			parentSiteName = "${parentSiteName}",
			siteName = "${siteName}",
			siteTemplateName = "${siteTemplateName}",
			siteType = "Site Template",
			uncheckPropagation = "${uncheckPropagation}"
		);
	}

	macro tearDownCP {
		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites"
		);

		Type(locator1 = "NavBar#BASIC_SEARCH_FIELD", value1 = "Name");

		Click(locator1 = "Icon#BASIC_SEARCH");

		if (IsElementNotPresent(locator1 = "Message#EMPTY_INFO")) {
			Check.checkAll(locator1 = "Checkbox#SELECT_ALL");

			ClickNoError(locator1 = "Icon#DELETE");

			Confirm(
				value1 = "Are you sure you want to delete this? It will be deleted immediately."
			);

			Alert.viewSuccessMessage();
		}
	}

	macro viewAdminMemberAsSiteAdminCP {
		Portlet.changeDisplayStyle(displayStyle = "Icon");

		var key_cardText = "${userScreenName}";
		var userNameLowerCased = StringUtil.replace("${userScreenName}", ".", " ");
		var userFirstNameLowerCased = StringUtil.extractFirst("${userNameLowerCased}", " ");
		var userLastNameLowerCased = StringUtil.extractLast("${userNameLowerCased}", " ");
		var userFirstName = StringUtil.upperCaseFirstLetter("${userFirstNameLowerCased}");
		var userLastName = StringUtil.upperCaseFirstLetter("${userLastNameLowerCased}");

		AssertTextEquals.assertPartialText(
			locator1 = "Card#SPECIFIC_LARGE_TEXT",
			value1 = "${userFirstName} ${userLastName}"
		);

		AssertTextEquals(locator1 = "Card#SPECIFIC_TEXT", value1 = "${userScreenName}");

		var key_rowEntry = "${key_cardText}";

		Click(locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");

		AssertTextEquals(
			locator1 = "MenuItem#ANY_MENU_ITEM",
			value1 = "Assign Site Roles",
			key_menuItem = "Assign Site Roles"
		);

		AssertElementNotPresent(
			locator1 = "MenuItem#ANY_MENU_ITEM",
			value1 = "Remove Membership",
			key_menuItem = "Remove Membership"
		);

		Click(locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");
	}

	macro viewAdminMemberAsSyncMemberManagerCP {
		Site.viewAdminMemberAsSiteAdminCP(userScreenName = "${userScreenName}");
	}

	macro viewMemberAsSiteAdminCP {
		Site.viewMemberAsSiteOwnerCP(userScreenName = "${userScreenName}");
	}

	macro viewMemberAsSiteOwnerCP {
		Portlet.changeDisplayStyle(displayStyle = "Icon");

		var key_cardText = "${userScreenName}";
		var userNameLowerCased = StringUtil.replace("${userScreenName}", ".", " ");
		var userFirstNameLowerCased = StringUtil.extractFirst("${userNameLowerCased}", " ");
		var userLastNameLowerCased = StringUtil.extractLast("${userNameLowerCased}", " ");
		var userFirstName = StringUtil.upperCaseFirstLetter("${userFirstNameLowerCased}");
		var userLastName = StringUtil.upperCaseFirstLetter("${userLastNameLowerCased}");

		AssertTextEquals.assertPartialText(
			locator1 = "Card#SPECIFIC_LARGE_TEXT",
			value1 = "${userFirstName} ${userLastName}"
		);

		AssertTextEquals(locator1 = "Card#SPECIFIC_TEXT", value1 = "${userScreenName}");

		var key_rowEntry = "${key_cardText}";

		Click(locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");

		AssertTextEquals(
			locator1 = "MenuItem#ANY_MENU_ITEM",
			value1 = "Assign Site Roles",
			key_menuItem = "Assign Site Roles"
		);

		AssertTextEquals(
			locator1 = "MenuItem#ANY_MENU_ITEM",
			value1 = "Remove Membership",
			key_menuItem = "Remove Membership"
		);

		Click(locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");
	}

	macro viewMemberAsSyncMemberManagerCP {
		Site.viewMemberAsSiteOwnerCP(userScreenName = "${userScreenName}");
	}
}