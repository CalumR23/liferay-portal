<definition>
	<command name="gotoPortlet" summary="Navigate to Product Menu > ${panel} > ${category} > ${portlet}">
		<execute macro="ProductMenuHelper#expandPanel">
			<var name="panel" value="${panel}" />
		</execute>

		<execute macro="ProductMenuHelper#expandCategory">
			<var name="category" value="${category}" />
		</execute>

		<execute macro="ProductMenuHelper#gotoPortlet">
			<var name="portlet" value="${portlet}" />
		</execute>
	</command>

	<command name="gotoSiteViaURL" summary="Navigate to Product Menu > Sites > Sites Modal > ${site}">
		<execute macro="Navigator#openSiteURL">
			<var name="siteName" value="${siteName}" />
		</execute>

		<execute macro="ProductMenuHelper#expandPanel">
			<var name="panel" value="Site Administration" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="ProductMenu#PRODUCT_MENU_PANEL_SITE_ADMINISTRATION_SITE_NAME" value1="${siteName}" />
	</command>

	<command name="viewNoCategory" summary="Navigate to Product Menu > ${panel} > ${category} > ${portlet}">
		<execute macro="ProductMenuHelper#expandPanel">
			<var name="panel" value="${panel}" />
		</execute>

		<execute macro="ProductMenuHelper#viewNoCategory">
			<var name="category" value="${category}" />
		</execute>
	</command>
</definition>