definition {

	var adminEmailAddress = PropsUtil.get("admin.email.address");
	var adminPassword = PropsUtil.get("admin.password");

	macro _addUser {
		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		if (isSet(userFirstName)) {
			var userFirstNameEncoded = URLUtil.encode("${userFirstName}", "UTF-8");
		}
		else {
			fail("Please set 'userFirstName'.");
		}

		if (isSet(userLastName)) {
			var userLastNameEncoded = URLUtil.encode("${userLastName}", "UTF-8");
		}
		else {
			fail("Please set 'userLastName'.");
		}

		if (!(isSet(userScreenName))) {
			fail("Please set 'userScreenName'.");
		}

		/*<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>*/

		/*<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>*/

		/*<if>
			<isset var="groupName" />
			<then>
				<execute macro="JSONGroup#getGroupIdByName">
					<var name="groupName" value="${groupName}" />
					<return name="groupId" />
				</execute>
			</then>
		</if>*/

		var openId = StringUtil.randomString("5");

		var curl = '''
			${portalURL}/api/jsonws/user/add-user \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d autoPassword=false \
				-d password1=test \
				-d password2=test \
				-d autoScreenName=false \
				-d screenName=${userScreenName} \
				-d emailAddress=${userEmailAddress} \
				-d facebookId=0 \
				-d openId=${openId} \
				-d locale= \
				-d firstName=${userFirstNameEncoded} \
				-d middleName= \
				-d lastName=${userLastNameEncoded} \
				-d prefixId=0 \
				-d suffixId=0 \
				-d male=true \
				-d birthdayMonth=4 \
				-d birthdayDay=31 \
				-d birthdayYear=1986 \
				-d jobTitle= \
				-d groupIds=${groupId} \
				-d organizationIds= \
				-d roleIds= \
				-d userGroupIds= \
				-d sendEmail=true
		''';

		echo("## Adding a 'User' with the following info using JSONWS:");

		echo("## * Company ID: ${companyId}");

		echo("## * Email Address: ${userEmailAddress}");

		echo("## * First Name: ${userFirstName}");

		echo("## * Last Name: ${userLastName}");

		echo("## * Screen Name: ${userScreenName}");

		echo("## * Group IDs: ${groupId}");

		var userId = JSONCurlUtil.post("${curl}", "$['userId']");

		return "${userId}";
	}

	macro _deleteUser {
		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		var userEmailAddress = JSONUser.getUserEmailAddress(userId = "${userId}");
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/user/delete-user \
				-u ${adminEmailAddress}:${adminPassword} \
				-d userId=${userId}
		''';

		echo("## Deleting a 'User' with the following info using JSONWS:");

		echo("## * Email Address: ${userEmailAddress}");

		var temporary = JSONCurlUtil.post("${curl}", "");
	}

	macro addUser {
		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		if (!(isSet(userFirstName))) {
			fail("Please set 'userFirstName'.");
		}

		if (!(isSet(userLastName))) {
			fail("Please set 'userLastName'.");
		}

		if (!(isSet(userScreenName))) {
			fail("Please set 'userScreenName'.");
		}

		JSONUser._addUser(
			userEmailAddress = "${userEmailAddress}",
			userFirstName = "${userFirstName}",
			userLastName = "${userLastName}",
			userScreenName = "${userScreenName}");
	}

	macro deleteUserByEmailAddress {
		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		var userId = JSONUser.getUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		JSONUser._deleteUser(userId = "${userId}");
	}

	macro deleteUserByUserId {
		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		JSONUser._deleteUser(userId = "${userId}");
	}

	macro getUserEmailAddress {
		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/user/get-user-by-id \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d userId=${userId}
		''';

		var userEmailAddress = JSONCurlUtil.post("${curl}", "$['emailAddress']");

		return "${userEmailAddress}";
	}

	macro getUserFirstName {
		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/user/get-user-by-id \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d userId=${userId}
		''';

		var userFirstName = JSONCurlUtil.post("${curl}", "$['firstName']");

		return "${userFirstName}";
	}

	macro getUserIdByEmailAddress {
		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/user/get-user-by-email-address \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d emailAddress=${userEmailAddress}
		''';

		var userId = JSONCurlUtil.post("${curl}", "$['userId']");

		return "${userId}";
	}

	macro tearDownByFirstName {
		if (!(isSet(userFirstName))) {
			fail("Please set 'userFirstName'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/user/get-company-users-count \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId}
		''';

		var userCount = JSONCurlUtil.post("${curl}", "$");

		var curl = '''
			${portalURL}/api/jsonws/user/get-company-users \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d start=0 \
				-d end=${userCount}
		''';

		var userIds = JSONCurlUtil.post("${curl}", "$..['userId']");

		var userIds = StringUtil.replace("${userIds}", "[", "");

		var userIds = StringUtil.replace("${userIds}", "]", "");

		var userIds = StringUtil.replace("${userIds}", "\"", "");

		for (var userId : list "${userIds}") {
			var currentUserFirstName = JSONUser.getUserFirstName(userId = "${userId}");

			if (contains("${currentUserFirstName}", "${userFirstName}")) {
				JSONUser.deleteUserByUserId(userId = "${userId}");
			}
		}
	}

}