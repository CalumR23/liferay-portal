<definition>
	<var method="PropsUtil#get('admin.email.address')" name="adminEmailAddress" />
	<var method="PropsUtil#get('admin.password')" name="adminPassword" />

	<command name="_addUser">
		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<if>
			<isset var="userFirstName" />
			<then>
				<var name="userFirstNameEncoded" method="URLUtil#encode('${userFirstName}', 'UTF-8')"/>
			</then>
			<else>
				<fail message="Please set 'userFirstName'." />
			</else>
		</if>

		<if>
			<isset var="userLastName" />
			<then>
				<var name="userLastNameEncoded" method="URLUtil#encode('${userLastName}', 'UTF-8')"/>
			</then>
			<else>
				<fail message="Please set 'userLastName'." />
			</else>
		</if>

		<if>
			<not>
				<isset var="userScreenName" />
			</not>
			<then>
				<fail message="Please set 'userScreenName'." />
			</then>
		</if>

		<!--<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>-->

		<!--<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>-->

		<!--<if>
			<isset var="groupName" />
			<then>
				<execute macro="JSONGroup#getGroupIdByName">
					<var name="groupName" value="${groupName}" />
					<return name="groupId" />
				</execute>
			</then>
		</if>-->

		<var method="StringUtil#randomString('5')" name="openId" />

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/add-user \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d autoPassword=false \
				-d password1=test \
				-d password2=test \
				-d autoScreenName=false \
				-d screenName=${userScreenName} \
				-d emailAddress=${userEmailAddress} \
				-d facebookId=0 \
				-d openId=${openId} \
				-d locale= \
				-d firstName=${userFirstNameEncoded} \
				-d middleName= \
				-d lastName=${userLastNameEncoded} \
				-d prefixId=0 \
				-d suffixId=0 \
				-d male=true \
				-d birthdayMonth=4 \
				-d birthdayDay=31 \
				-d birthdayYear=1986 \
				-d jobTitle= \
				-d groupIds=${groupId} \
				-d organizationIds= \
				-d roleIds= \
				-d userGroupIds= \
				-d sendEmail=true
		]]></var>

		<echo message="## Adding a 'User' with the following info using JSONWS:" />

		<echo message="## * Company ID: ${companyId}" />

		<echo message="## * Email Address: ${userEmailAddress}" />

		<echo message="## * First Name: ${userFirstName}" />

		<echo message="## * Last Name: ${userLastName}" />

		<echo message="## * Screen Name: ${userScreenName}" />

		<echo message="## * Group IDs: ${groupId}" />

		<var name="userId" method="JSONCurlUtil#post('${curl}', '$[\'userId\']')"/>

		<return value="${userId}" />
	</command>

	<command name="_deleteUser">
		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<execute macro="JSONUser#getUserEmailAddress">
			<return name="userEmailAddress" />
			<var name="userId" value="${userId}" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/delete-user \
				-u ${adminEmailAddress}:${adminPassword} \
				-d userId=${userId}
		]]></var>

		<echo message="## Deleting a 'User' with the following info using JSONWS:" />

		<echo message="## * Email Address: ${userEmailAddress}" />

		<var name="temporary" method="JSONCurlUtil#post('${curl}', '')"/>
	</command>

	<command name="addUser">
		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userFirstName" />
			</not>
			<then>
				<fail message="Please set 'userFirstName'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userLastName" />
			</not>
			<then>
				<fail message="Please set 'userLastName'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userScreenName" />
			</not>
			<then>
				<fail message="Please set 'userScreenName'." />
			</then>
		</if>

		<execute macro="JSONUser#_addUser">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userFirstName" value="${userFirstName}" />
			<var name="userLastName" value="${userLastName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>
	</command>

	<command name="deleteUserByEmailAddress">
		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<execute macro="JSONUser#getUserIdByEmailAddress">
			<return name="userId" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>

		<execute macro="JSONUser#_deleteUser">
			<var name="userId" value="${userId}" />
		</execute>
	</command>

	<command name="deleteUserByUserId">
		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<execute macro="JSONUser#_deleteUser">
			<var name="userId" value="${userId}" />
		</execute>
	</command>

	<command name="getUserEmailAddress">
		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/get-user-by-id \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d userId=${userId}
		]]></var>

		<var name="userEmailAddress" method="JSONCurlUtil#post('${curl}', '$[\'emailAddress\']')"/>

		<return value="${userEmailAddress}" />
	</command>

	<command name="getUserFirstName">
		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/get-user-by-id \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d userId=${userId}
		]]></var>

		<var name="userFirstName" method="JSONCurlUtil#post('${curl}', '$[\'firstName\']')"/>

		<return value="${userFirstName}" />
	</command>

	<command name="getUserIdByEmailAddress">
		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/get-user-by-email-address \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d emailAddress=${userEmailAddress}
		]]></var>

		<var name="userId" method="JSONCurlUtil#post('${curl}', '$[\'userId\']')"/>

		<return value="${userId}" />
	</command>

	<command name="tearDownByFirstName">
		<if>
			<not>
				<isset var="userFirstName" />
			</not>
			<then>
				<fail message="Please set 'userFirstName'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/get-company-users-count \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId}
		]]></var>

		<var name="userCount" method="JSONCurlUtil#post('${curl}', '$')"/>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/get-company-users \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d start=0 \
				-d end=${userCount}
		]]></var>

		<var name="userIds" method="JSONCurlUtil#post('${curl}', '$..[\'userId\']')"/>

		<var name="userIds" method="StringUtil#replace('${userIds}', '[', '')"/>

		<var name="userIds" method="StringUtil#replace('${userIds}', ']', '')"/>

		<var name="userIds" method="StringUtil#replace('${userIds}', '&quot;', '')"/>

		<for list="${userIds}" param="userId">
			<execute macro="JSONUser#getUserFirstName">
				<return name="currentUserFirstName" />
				<var name="userId" value="${userId}" />
			</execute>

			<if>
				<contains string="${currentUserFirstName}" substring="${userFirstName}" />
				<then>
					<execute macro="JSONUser#deleteUserByUserId">
						<var name="userId" value="${userId}" />
					</execute>
				</then>
			</if>
		</for>
	</command>
</definition>