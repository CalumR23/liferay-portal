definition {

	var adminEmailAddress = PropsUtil.get("admin.email.address");
	var adminPassword = PropsUtil.get("admin.password");

	macro getCompanyId {
		var portalURL = JSONCompany.getPortalURL();
		var portalInstanceName = JSONCompany.getPortalInstanceName();

		var curl = '''
			${portalURL}/api/jsonws/company/get-company-by-virtual-host \
				-u ${adminEmailAddress}:${adminPassword} \
				-d virtualHost=${portalInstanceName}
		''';

		var companyId = JSONCurlUtil.post("${curl}", "$['companyId']");

		return "${companyId}";
	}

	macro getPortalInstanceName {
		var testNameSkipPortalInstance = PropsUtil.get("test.name.skip.portal.instance");
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (("${testPortalInstance}" == "true") && !(IsTestName(locator1 = "", value1 = "${testNameSkipPortalInstance}"))) {
			var portalURL = JSONCompany.getPortalURL();

			var portalInstanceName = StringUtil.replace("${portalURL}", "https://", "");

			var portalInstanceName = StringUtil.replace("${portalInstanceName}", "nightly", "uat");

			return "${portalInstanceName}";
		}
		else {
			return "localhost";
		}
	}

	macro getPortalURL {
		var portalURL = PropsUtil.get("portal.url");

		return "${portalURL}";
	}

}