definition {

	var adminEmailAddress = PropsUtil.get("admin.email.address");
	var adminPassword = PropsUtil.get("admin.password");

	macro _addGroup {
		if (isSet(groupDescription)) {
			var groupDescriptionEncoded = URLUtil.encode("${groupDescription}", "UTF-8");

			var groupDescriptionMap = '''{"en_US":"${groupDescriptionEncoded}"}''';
		}
		else {
			var groupDescriptionMap = "{}";
		}

		if (isSet(groupName)) {
			var groupNameEncoded = URLUtil.encode("${groupName}", "UTF-8");

			var groupNameMap = '''{"en_US":"${groupNameEncoded}"}''';
		}
		else {
			fail("Please set 'groupName'.");
		}

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/group/add-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d parentGroupId=0 \
				-d liveGroupId=0 \
				-d nameMap=${groupNameMap} \
				-d descriptionMap=${groupDescriptionMap} \
				-d type=1 \
				-d manualMembership=true \
				-d membershipRestriction=0 \
				-d friendlyURL= \
				-d site=true \
				-d inheritContent=false \
				-d active=true
		''';

		echo("## Adding a 'Group' with the following info using JSONWS:");

		if (isSet(groupDescription)) {
			echo("## * Group Description: ${groupDescription}");
		}

		echo("## * Group Name: ${groupName}");

		var groupId = JSONCurlUtil.post("${curl}", "$['groupId']");
	}

	macro _addUserGroup {
		if (isSet(userGroupDescription)) {
			var userGroupDescriptionEncoded = URLUtil.encode("${userGroupDescription}", "UTF-8");

			var userGroupDescription = '''${userGroupDescriptionEncoded}''';
		}
		else {
			var userGroupDescription = "";
		}

		if (isSet(userGroupName)) {
			var userGroupNameEncoded = URLUtil.encode("${userGroupName}", "UTF-8");

			var userGroupName = '''${userGroupNameEncoded}''';
		}
		else {
			fail("Please set 'userGroupName'.");
		}

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/usergroup/add-user-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d name=${userGroupName} \
				-d description=${userGroupDescription}
		''';

		echo("## Adding a 'User Group' with the following info using JSONWS:");

		if (isSet(userGroupDescription)) {
			echo("## * User Group Description: ${userGroupDescription}");
		}

		echo("## * User Group Name: ${userGroupName}");

		var userGroupId = JSONCurlUtil.post("${curl}", "$['userGroupId']");

		return "${userGroupId}";
	}

	macro _assignGroupRoleToUser {
		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		if (!(isSet(roleId))) {
			fail("Please set 'roleId'.");
		}

		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		/*<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>*/

		var curl = '''
			${portalURL}/api/jsonws/usergrouprole/add-user-group-roles \
				-u ${adminEmailAddress}:${adminPassword} \
				-d roleId=${roleId} \
				-d groupId=${groupId} \
				-d userIds=${userId}
		''';

		/*<execute macro="JSONGroup#getGroupName">
			<var name="groupId" value="${groupId}" />
			<return name="groupName" />
		</execute>

		<execute macro="JSONRole#getRoleName">
			<var name="roleId" value="${roleId}" />
			<return name="roleName" />
		</execute>

		<execute macro="JSONUser#getUserEmailAddress">
			<var name="userId" value="${userId}" />
			<return name="userEmailAddress" />
		</execute>

		<echo message="## Assign a 'Group Role' to a 'User' with the following info using JSONWS:" />

		<echo message="## * Group Name: ${groupName}" />

		<echo message="## * Role Name: ${roleName}" />

		<echo message="## * User Email Address: ${userEmailAddress}" />*/

		var temp = JSONCurlUtil.post("${curl}", "$");
	}

	macro _assignUserToGroup {
		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		if (!(isSet(userId))) {
			fail("Please set 'userId'.");
		}

		/*<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>*/

		var curl = '''
			${portalURL}/api/jsonws/user/add-group-users \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId} \
				-d userIds=${userId}
		''';

		/*<execute macro="JSONGroup#getGroupName">
			<var name="groupId" value="${groupId}" />
			<return name="groupName" />
		</execute>

		<execute macro="JSONUser#getUserEmailAddress">
			<var name="userId" value="${userId}" />
			<return name="userEmailAddress" />
		</execute>

		<echo message="## Assigning a 'User' to an 'Group' with the following info using JSONWS:" />

		<echo message="## * Group Name: ${groupName}" />

		<echo message="## * User Email Address: ${userEmailAddress}" />*/

		var temp = JSONCurlUtil.post("${curl}", "$");
	}

	macro _deleteGroup {
		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		var groupName = JSONGroup.getGroupName(groupId = "${groupId}");

		echo("## Deleting a 'Group' with the following info using JSONWS:");

		echo("## * Group Name: ${groupName}");

		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/group/delete-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId}
		''';

		var temp = JSONCurlUtil.post("${curl}", "$");
	}

	macro addGroup {
		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		JSONGroup._addGroup(
			groupDescription = "${groupDescription}",
			groupName = "${groupName}");
	}

	macro assignGroupRoleToUser {
		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		if (!(isSet(roleName))) {
			fail("Please set 'roleName'.");
		}

		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		/*<execute macro="JSONGroup#getGroupIdByName">
			<var name="groupName" value="${groupName}" />
			<return name="groupId" />
		</execute>*/

		/*<execute macro="JSONRole#getRoleIdByName">
			<var name="roleName" value="${roleName}" />
			<return name="roleId" />
		</execute>*/

		/*<execute macro="JSONUser#getUserIdByEmailAddress">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<return name="userId" />
		</execute>*/

		JSONGroup._assignGroupRoleToUser(
			groupId = "${groupId}",
			roleId = "${roleId}",
			userId = "${userId}");
	}

	macro assignUserToGroup {
		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		if (!(isSet(userEmailAddress))) {
			fail("Please set 'userEmailAddress'.");
		}

		var groupId = JSONGroup.getGroupIdByName(groupName = "${groupName}");
		var userId = JSONUser.getUserIdByEmailAddress(userEmailAddress = "${userEmailAddress}");

		JSONGroup._assignUserToGroup(
			groupId = "${groupId}",
			userId = "${userId}");
	}

	macro deleteGroupByName {
		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		var groupId = JSONGroup.getGroupIdByName(groupName = "${groupName}");

		JSONGroup._deleteGroup(groupId = "${groupId}");
	}

	macro getGroupIdByName {
		if (!(isSet(groupName))) {
			fail("Please set 'groupName'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/group/get-groups \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d parentGroupId=0 \
				-d site=true
		''';

		var groupId = JSONCurlUtil.post("${curl}", "$.[?(@['nameCurrentValue'] == '${groupName}')]['groupId']");

		var groupId = StringUtil.replace("${groupId}", "[\"", "");

		var groupId = StringUtil.replace("${groupId}", "\"]", "");

		return "${groupId}";
	}

	macro getGroupName {
		if (!(isSet(groupId))) {
			fail("Please set 'groupId'.");
		}

		var companyId = JSONCompany.getCompanyId();
		var portalURL = JSONCompany.getPortalURL();

		var curl = '''
			${portalURL}/api/jsonws/group/get-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId}
		''';

		var groupName = JSONCurlUtil.post("${curl}", "$['nameCurrentValue']");

		return "${groupName}";
	}

}