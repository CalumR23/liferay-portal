<definition>
	<var method="PropsUtil#get('admin.email.address')" name="adminEmailAddress" />
	<var method="PropsUtil#get('admin.password')" name="adminPassword" />

	<command name="_addGroup">
		<if>
			<isset var="groupDescription" />
			<then>
				<var name="groupDescriptionEncoded" method="URLUtil#encode('${groupDescription}', 'UTF-8')"/>

				<var name="groupDescriptionMap"><![CDATA[{"en_US":"${groupDescriptionEncoded}"}]]></var>
			</then>
			<else>
				<var name="groupDescriptionMap" value="{}" />
			</else>
		</if>

		<if>
			<isset var="groupName" />
			<then>
				<var name="groupNameEncoded" method="URLUtil#encode('${groupName}', 'UTF-8')"/>

				<var name="groupNameMap"><![CDATA[{"en_US":"${groupNameEncoded}"}]]></var>
			</then>
			<else>
				<fail message="Please set 'groupName'." />
			</else>
		</if>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/group/add-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d parentGroupId=0 \
				-d liveGroupId=0 \
				-d nameMap=${groupNameMap} \
				-d descriptionMap=${groupDescriptionMap} \
				-d type=1 \
				-d manualMembership=true \
				-d membershipRestriction=0 \
				-d friendlyURL= \
				-d site=true \
				-d inheritContent=false \
				-d active=true
		]]></var>

		<echo message="## Adding a 'Group' with the following info using JSONWS:" />

		<if>
			<isset var="groupDescription" />
			<then>
				<echo message="## * Group Description: ${groupDescription}" />
			</then>
		</if>

		<echo message="## * Group Name: ${groupName}" />

		<var name="groupId" method="JSONCurlUtil#post('${curl}', '$[\'groupId\']')"/>
	</command>

	<command name="_addUserGroup">
		<if>
			<isset var="userGroupDescription" />
			<then>
				<var name="userGroupDescriptionEncoded" method="URLUtil#encode('${userGroupDescription}', 'UTF-8')"/>

				<var name="userGroupDescription"><![CDATA[${userGroupDescriptionEncoded}]]></var>
			</then>
			<else>
				<var name="userGroupDescription" value="" />
			</else>
		</if>

		<if>
			<isset var="userGroupName" />
			<then>
				<var name="userGroupNameEncoded" method="URLUtil#encode('${userGroupName}', 'UTF-8')"/>

				<var name="userGroupName"><![CDATA[${userGroupNameEncoded}]]></var>
			</then>
			<else>
				<fail message="Please set 'userGroupName'." />
			</else>
		</if>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/usergroup/add-user-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d name=${userGroupName} \
				-d description=${userGroupDescription}
		]]></var>

		<echo message="## Adding a 'User Group' with the following info using JSONWS:" />

		<if>
			<isset var="userGroupDescription" />
			<then>
				<echo message="## * User Group Description: ${userGroupDescription}" />
			</then>
		</if>

		<echo message="## * User Group Name: ${userGroupName}" />

		<var name="userGroupId" method="JSONCurlUtil#post('${curl}', '$[\'userGroupId\']')"/>

		<return value="${userGroupId}" />
	</command>

	<command name="_assignGroupRoleToUser">
		<if>
			<not>
				<isset var="groupId" />
			</not>
			<then>
				<fail message="Please set 'groupId'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="roleId" />
			</not>
			<then>
				<fail message="Please set 'roleId'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<!--<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>-->

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/usergrouprole/add-user-group-roles \
				-u ${adminEmailAddress}:${adminPassword} \
				-d roleId=${roleId} \
				-d groupId=${groupId} \
				-d userIds=${userId}
		]]></var>

		<!--<execute macro="JSONGroup#getGroupName">
			<var name="groupId" value="${groupId}" />
			<return name="groupName" />
		</execute>

		<execute macro="JSONRole#getRoleName">
			<var name="roleId" value="${roleId}" />
			<return name="roleName" />
		</execute>

		<execute macro="JSONUser#getUserEmailAddress">
			<var name="userId" value="${userId}" />
			<return name="userEmailAddress" />
		</execute>

		<echo message="## Assign a 'Group Role' to a 'User' with the following info using JSONWS:" />

		<echo message="## * Group Name: ${groupName}" />

		<echo message="## * Role Name: ${roleName}" />

		<echo message="## * User Email Address: ${userEmailAddress}" />-->

		<var name="temp" method="JSONCurlUtil#post('${curl}', '$')"/>
	</command>

	<command name="_assignUserToGroup">
		<if>
			<not>
				<isset var="groupId" />
			</not>
			<then>
				<fail message="Please set 'groupId'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userId" />
			</not>
			<then>
				<fail message="Please set 'userId'." />
			</then>
		</if>

		<!--<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>-->

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/user/add-group-users \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId} \
				-d userIds=${userId}
		]]></var>

		<!--<execute macro="JSONGroup#getGroupName">
			<var name="groupId" value="${groupId}" />
			<return name="groupName" />
		</execute>

		<execute macro="JSONUser#getUserEmailAddress">
			<var name="userId" value="${userId}" />
			<return name="userEmailAddress" />
		</execute>

		<echo message="## Assigning a 'User' to an 'Group' with the following info using JSONWS:" />

		<echo message="## * Group Name: ${groupName}" />

		<echo message="## * User Email Address: ${userEmailAddress}" />-->

		<var name="temp" method="JSONCurlUtil#post('${curl}', '$')"/>
	</command>

	<command name="_deleteGroup">
		<if>
			<not>
				<isset var="groupId" />
			</not>
			<then>
				<fail message="Please set 'groupId'." />
			</then>
		</if>

		<execute macro="JSONGroup#getGroupName">
			<return name="groupName" />
			<var name="groupId" value="${groupId}" />
		</execute>

		<echo message="## Deleting a 'Group' with the following info using JSONWS:" />

		<echo message="## * Group Name: ${groupName}" />

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/group/delete-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId}
		]]></var>

		<var name="temp" method="JSONCurlUtil#post('${curl}', '$')"/>
	</command>

	<command name="addGroup">
		<if>
			<not>
				<isset var="groupName" />
			</not>
			<then>
				<fail message="Please set 'groupName'." />
			</then>
		</if>

		<execute macro="JSONGroup#_addGroup">
			<var name="groupDescription" value="${groupDescription}" />
			<var name="groupName" value="${groupName}" />
		</execute>
	</command>

	<command name="assignGroupRoleToUser">
		<if>
			<not>
				<isset var="groupName" />
			</not>
			<then>
				<fail message="Please set 'groupName'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="roleName" />
			</not>
			<then>
				<fail message="Please set 'roleName'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<!--<execute macro="JSONGroup#getGroupIdByName">
			<var name="groupName" value="${groupName}" />
			<return name="groupId" />
		</execute>-->

		<!--<execute macro="JSONRole#getRoleIdByName">
			<var name="roleName" value="${roleName}" />
			<return name="roleId" />
		</execute>-->

		<!--<execute macro="JSONUser#getUserIdByEmailAddress">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<return name="userId" />
		</execute>-->

		<execute macro="JSONGroup#_assignGroupRoleToUser">
			<var name="groupId" value="${groupId}" />
			<var name="roleId" value="${roleId}" />
			<var name="userId" value="${userId}" />
		</execute>
	</command>

	<command name="assignUserToGroup">
		<if>
			<not>
				<isset var="groupName" />
			</not>
			<then>
				<fail message="Please set 'groupName'." />
			</then>
		</if>

		<if>
			<not>
				<isset var="userEmailAddress" />
			</not>
			<then>
				<fail message="Please set 'userEmailAddress'." />
			</then>
		</if>

		<execute macro="JSONGroup#getGroupIdByName">
			<return name="groupId" />
			<var name="groupName" value="${groupName}" />
		</execute>

		<execute macro="JSONUser#getUserIdByEmailAddress">
			<return name="userId" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
		</execute>

		<execute macro="JSONGroup#_assignUserToGroup">
			<var name="groupId" value="${groupId}" />
			<var name="userId" value="${userId}" />
		</execute>
	</command>

	<command name="deleteGroupByName">
		<if>
			<not>
				<isset var="groupName" />
			</not>
			<then>
				<fail message="Please set 'groupName'." />
			</then>
		</if>

		<execute macro="JSONGroup#getGroupIdByName">
			<return name="groupId" />
			<var name="groupName" value="${groupName}" />
		</execute>

		<execute macro="JSONGroup#_deleteGroup">
			<var name="groupId" value="${groupId}" />
		</execute>
	</command>

	<command name="getGroupIdByName">
		<if>
			<not>
				<isset var="groupName" />
			</not>
			<then>
				<fail message="Please set 'groupName'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/group/get-groups \
				-u ${adminEmailAddress}:${adminPassword} \
				-d companyId=${companyId} \
				-d parentGroupId=0 \
				-d site=true
		]]></var>

		<var name="groupId" method="JSONCurlUtil#post('${curl}', '$.[?(@[\'nameCurrentValue\'] == \'${groupName}\')][\'groupId\']')"/>

		<var name="groupId" method="StringUtil#replace('${groupId}', '[&quot;', '')"/>

		<var name="groupId" method="StringUtil#replace('${groupId}', '&quot;]', '')"/>

		<return value="${groupId}" />
	</command>

	<command name="getGroupName">
		<if>
			<not>
				<isset var="groupId" />
			</not>
			<then>
				<fail message="Please set 'groupId'." />
			</then>
		</if>

		<execute macro="JSONCompany#getCompanyId">
			<return name="companyId" />
		</execute>

		<execute macro="JSONCompany#getPortalURL">
			<return name="portalURL" />
		</execute>

		<var name="curl"><![CDATA[
			${portalURL}/api/jsonws/group/get-group \
				-u ${adminEmailAddress}:${adminPassword} \
				-d groupId=${groupId}
		]]></var>

		<var name="groupName" method="JSONCurlUtil#post('${curl}', '$[\'nameCurrentValue\']')"/>

		<return value="${groupName}" />
	</command>
</definition>