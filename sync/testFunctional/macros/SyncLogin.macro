definition {
	var liferayURL = PropsUtil.get("portal.url");

	macro login {
		Open(locator1 = "${liferayURL}/web/guest/local-login");

		// <execute function="AssertClick" locator1="UserBar#USER_SIGN_IN" value1="Sign In" />

		Type(locator1 = "TextInput#EMAIL_ADDRESS", value1 = "${userEmailAddress}");

		Type(locator1 = "TextInput#PASSWORD", value1 = "${userPassword}");

		Click(locator1 = "SyncButtonSIGN_IN");

		/*<execute function="Type" locator1="SyncLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="SyncLogin#PASSWORD_FIELD" value1="${userPassword}" />
		<execute function="Click" locator1="SyncLogin#SIGN_IN_BUTTON" />*/
	}

	macro logout {
		Open(locator1 = "${liferayURL}/c/portal/logout");
	}

	macro logoutAndLogin {
		SyncLogin.logout();

		SyncLogin.login(
			userEmailAddress = "${userEmailAddress}",
			userPassword = "${userPassword}"
		);
	}
}