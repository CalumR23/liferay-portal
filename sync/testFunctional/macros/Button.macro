definition {
	macro clickAddRow {
		Click(locator1 = "SyncButtonADD_ROW");
	}

	macro clickCancel {
		AssertClick(locator1 = "SyncButtonCANCEL", value1 = "Cancel");
	}

	macro clickConfirm {
		AssertClick(locator1 = "SyncButtonCONFIRM", value1 = "Confirm");
	}

	macro clickDelete {
		AssertClick(locator1 = "SyncButtonDELETE", value1 = "Delete");
	}

	macro clickDone {
		AssertClick(locator1 = "SyncButtonDONE", value1 = "Done");
	}

	macro clickNext {
		AssertClick(locator1 = "SyncButtonNEXT", value1 = "Next");
	}

	macro clickPublish {
		ScrollWebElementIntoView(locator1 = "SyncButtonPUBLISH");

		AssertClick(locator1 = "SyncButtonPUBLISH", value1 = "Publish");
	}

	macro clickSave {
		AssertClick(locator1 = "SyncButtonSAVE", value1 = "Save");
	}

	macro clickSaveAsDraft {
		AssertClick(locator1 = "SyncButtonSAVE_AS_DRAFT", value1 = "Save as Draft");
	}

	macro clickSubmitForPublication {
		AssertClick(
			locator1 = "SyncButtonSUBMIT_FOR_PUBLICATION",
			value1 = "Submit for Publication"
		);
	}

	macro clickUpdate {
		AssertClick(locator1 = "SyncButtonUPDATE", value1 = "Update");
	}
}