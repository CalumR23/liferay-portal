definition {
	macro clickAddRow {
		Click(locator1 = "Button#ADD_ROW");
	}

	macro clickCancel {
		AssertClick(locator1 = "Button#CANCEL", value1 = "Cancel");
	}

	macro clickConfirm {
		AssertClick(locator1 = "Button#CONFIRM", value1 = "Confirm");
	}

	macro clickDelete {
		AssertClick(locator1 = "Button#DELETE", value1 = "Delete");
	}

	macro clickDone {
		AssertClick(locator1 = "Button#DONE", value1 = "Done");
	}

	macro clickNext {
		AssertClick(locator1 = "Button#NEXT", value1 = "Next");
	}

	macro clickPublish {
		ScrollWebElementIntoView(locator1 = "Button#PUBLISH");

		AssertClick(locator1 = "Button#PUBLISH", value1 = "Publish");
	}

	macro clickSave {
		AssertClick(locator1 = "Button#SAVE", value1 = "Save");
	}

	macro clickSaveAsDraft {
		AssertClick(locator1 = "Button#SAVE_AS_DRAFT", value1 = "Save as Draft");
	}

	macro clickSubmitForPublication {
		AssertClick(
			locator1 = "Button#SUBMIT_FOR_PUBLICATION",
			value1 = "Submit for Publication"
		);
	}

	macro clickUpdate {
		AssertClick(locator1 = "Button#UPDATE", value1 = "Update");
	}
}