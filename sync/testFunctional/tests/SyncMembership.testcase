	@priority = "5"
	test ViewSiteMembershipPermissionsForSite1 {

		// Member permission viewing for Site 1 admins

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress1}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		ProductMenu.gotoPortlet(
			category = "Members",
			panel = "Site Administration",
			portlet = "Site Memberships");

		Site.viewMemberAsSiteOwnerCP(userScreenName = "${userScreenName1}");

		Site.viewMemberAsSiteOwnerCP(userScreenName = "${userScreenName2}");

