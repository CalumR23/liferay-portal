	@priority = "5"
	test ViewSiteMembershipPermissionsForSite2 {

		// Member permission viewing for Site 2 admins

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress11}",
			userPassword = "${adminPassword}");

