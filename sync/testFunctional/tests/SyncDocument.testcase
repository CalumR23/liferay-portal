	<tear-down>
		<var method="PropsUtil#get('test.name')" name="testName" />

		<var method="RegexUtil#replace('${testName}', '[^\.]*\.(.*)', '1')" name="testName" />

		<var method="StringUtil#extractLast('${testName}', '#')" name="testCaseName" />

		<if>
			<not>
				<equals arg1="${testCaseName}" arg2="AASetUp" />
			</not>
			<then>
				<execute macro="Navigator#openURL" />

				<execute macro="SyncLogin#logoutAndLogin">
					<var name="userEmailAddress" value="${adminEmailAddress}" />
					<var name="userPassword" value="${adminPassword}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName1}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName2}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName3}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName4}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName5}" />
				</execute>

				<execute macro="DMDocument#tearDownPG">
					<var name="siteName" value="${siteName6}" />
				</execute>
			</then>
		</if>
	</tear-down>

	<command name="AASetUp" priority="5">
		<execute macro="SyncLogin#logoutAndLogin">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<!-- Check for previous entities and tear down if present -->

		<execute macro="User#tearDownCP" />

		<execute macro="Site#tearDownCP" />

		<!-- Add sites -->

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Open" />
			<var name="pageType" value="Public" />
			<var name="siteName" value="${siteName1}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Open" />
			<var name="pageType" value="Private" />
			<var name="siteName" value="${siteName2}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Private" />
			<var name="pageType" value="Private" />
			<var name="siteName" value="${siteName3}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Private" />
			<var name="pageType" value="Public" />
			<var name="siteName" value="${siteName4}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Open" />
			<var name="pageType" value="Public" />
			<var name="siteName" value="${siteName5}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoSiteViaURL">
			<var name="siteName" value="${siteName5}" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Configuration" />
			<var name="panel" value="Site Administration" />
			<var name="portlet" value="Site Settings" />
		</execute>

		<execute macro="Site#addPrivatePageTemplateCP">
			<var name="siteName" value="${siteName5}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoPortlet">
			<var name="category" value="Sites" />
			<var name="panel" value="Control Panel" />
			<var name="portlet" value="Sites" />
		</execute>

		<execute macro="Site#addSiteTemplateCP">
			<var name="membershipType" value="Private" />
			<var name="pageType" value="Public" />
			<var name="siteName" value="${siteName6}" />
			<var name="siteTemplateName" value="Team Sync" />
		</execute>

		<execute macro="ProductMenu#gotoSiteViaURL">
			<var name="siteName" value="${siteName6}" />
