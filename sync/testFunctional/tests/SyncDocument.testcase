			userEmailAddress = "${userEmailAddress5}",
			userFirstName = "${userFirstName5}",
			userLastName = "${userLastName5}",
			userScreenName = "${userScreenName5}");
		var userId6 = JSONUser._addUser(
			companyId = "${companyId}",
			groupId = "${groupId1}",
			portalURL = "${portalURL}",
