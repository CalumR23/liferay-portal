	<command name="AddAndViewFolderAndDocumentPermissionsForSite5" priority="5">
		<!-- Folder and Document adding and viewing for Site 5 members -->

		<execute macro="SyncLogin#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress41}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="Navigator#openSiteURL">
			<var name="siteName" value="${siteName5}" />
		</execute>

		<execute macro="DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Word Folder1 Description" />
			<var name="dmFolderName" value="DM Word Folder1 Name" />
		</execute>

		<execute macro="DMFolder#gotoPG">
			<var name="dmFolderName" value="DM Word Folder1 Name" />
		</execute>

		<execute macro="DMDocument#addPG">
			<var name="dmDocumentDescription" value="DM Word Document1 Description" />
			<var name="dmDocumentFile" value="Document_1.doc" />
			<var name="dmDocumentTitle" value="Document_1.doc" />
		</execute>

		<execute macro="SyncLogin#logoutAndLogin">
			<var name="userEmailAddress" value="${userEmailAddress42}" />
			<var name="userPassword" value="${adminPassword}" />
		</execute>

		<execute macro="Navigator#openSiteURL">
			<var name="siteName" value="${siteName5}" />
		</execute>

		<execute macro="DMFolder#addPG">
			<var name="dmFolderDescription" value="DM Image Folder1 Description" />
			<var name="dmFolderName" value="DM Image Folder1 Name" />
		</execute>

		<execute macro="DMFolder#gotoPG">
