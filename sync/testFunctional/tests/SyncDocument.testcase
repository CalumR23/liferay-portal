	@priority = "5"
	test AddAndViewFolderAndDocumentPermissionsForSite6 {

		// Folder and Document adding and viewing for Site 6 members

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress51}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName6}");

