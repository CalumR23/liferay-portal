	@priority = "5"
	test AddAndViewFolderAndDocumentPermissionsForSite1 {

		// Folder and Document adding and viewing for Site 1 members

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress1}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMFolder.addPG(
			dmFolderDescription = "DM Word Folder1 Description",
			dmFolderName = "DM Word Folder1 Name");

		DMFolder.gotoPG(dmFolderName = "DM Word Folder1 Name");

		DMDocument.addPG(
			dmDocumentDescription = "DM Word Document1 Description",
			dmDocumentFile = "Document_1.doc",
			dmDocumentTitle = "Document_1.doc");

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress2}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMFolder.addPG(
			dmFolderDescription = "DM Image Folder1 Description",
			dmFolderName = "DM Image Folder1 Name");

		DMFolder.gotoPG(dmFolderName = "DM Image Folder1 Name");

		DMDocument.addPG(
			dmDocumentDescription = "DM Image Document1 Description",
			dmDocumentFile = "Document_1.jpg",
			dmDocumentTitle = "Document_1.jpg");

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress4}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMFolder.addPG(
			dmFolderDescription = "DM PowerPoint Folder1 Description",
			dmFolderName = "DM PowerPoint Folder1 Name");

		DMFolder.gotoPG(dmFolderName = "DM PowerPoint Folder1 Name");

		DMDocument.addPG(
			dmDocumentDescription = "DM PowerPoint Document1 Description",
			dmDocumentFile = "Document_1.ppt",
			dmDocumentTitle = "Document_1.ppt");

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress6}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMDocument.addPG(
			dmDocumentDescription = "DM Excel Document1 Description",
			dmDocumentFile = "Document_1.xls",
			dmDocumentTitle = "Document_1.xls");

		SyncLogin.logoutAndLogin(
			userEmailAddress = "${userEmailAddress1}",
			userPassword = "${adminPassword}");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMFolder.viewFolderActionsAsAdminPG(dmFolderName = "DM Word Folder1 Name");

		DMFolder.gotoPG(dmFolderName = "DM Word Folder1 Name");

		DMDocument.viewDocumentToolbarCmdAsAdminPG(dmDocumentTitle = "Document_1.doc");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMFolder.viewFolderActionsAsAdminPG(dmFolderName = "DM Image Folder1 Name");

		DMFolder.gotoPG(dmFolderName = "DM Image Folder1 Name");

		DMDocument.viewDocumentToolbarCmdAsAdminPG(dmDocumentTitle = "Document_1.jpg");

		Navigator.openSiteURL(siteName = "${siteName1}");

		DMDocument.viewDocumentToolbarCmdAsAdminPG(dmDocumentTitle = "Document_1.xls");

