	tearDown {
		var testName = PropsUtil.get("test.name");

		var testName = RegexUtil.replace("${testName}", "[^\.]*\.(.*)", "1");

		var testCaseName = StringUtil.extractLast("${testName}", "#");

		if ("${testCaseName}" != "AASetUp") {
			Navigator.openURL();

			SyncLogin.logoutAndLogin(
				userEmailAddress = "${adminEmailAddress}",
				userPassword = "${adminPassword}");

			DMDocument.tearDownPG(siteName = "${siteName1}");

			DMDocument.tearDownPG(siteName = "${siteName2}");

			DMDocument.tearDownPG(siteName = "${siteName3}");

			DMDocument.tearDownPG(siteName = "${siteName4}");

			DMDocument.tearDownPG(siteName = "${siteName5}");

			DMDocument.tearDownPG(siteName = "${siteName6}");
		}
	}

	@priority = "5"
	test AASetUp {
		SyncLogin.logoutAndLogin(
			userEmailAddress = "${adminEmailAddress}",
			userPassword = "${adminPassword}");

		// Check for previous entities and tear down if present

		User.tearDownCP();

		Site.tearDownCP();

		// Add sites

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Open",
			pageType = "Public",
			siteName = "${siteName1}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Open",
			pageType = "Private",
			siteName = "${siteName2}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Private",
			pageType = "Private",
			siteName = "${siteName3}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Private",
			pageType = "Public",
			siteName = "${siteName4}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Open",
			pageType = "Public",
			siteName = "${siteName5}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoSiteViaURL(siteName = "${siteName5}");

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Site Administration",
			portlet = "Site Settings");

		Site.addPrivatePageTemplateCP(
			siteName = "${siteName5}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		Site.addSiteTemplateCP(
			membershipType = "Private",
			pageType = "Public",
			siteName = "${siteName6}",
			siteTemplateName = "Team Sync");

		ProductMenu.gotoSiteViaURL(siteName = "${siteName6}");

		ProductMenu.gotoPortlet(
			category = "Configuration",
			panel = "Site Administration",
			portlet = "Site Settings");

		Site.addPrivatePageTemplateCP(
			siteName = "${siteName6}",
			siteTemplateName = "Team Sync");

		// Get Portal URL

		var portalURL = JSONCompany.getPortalURL();

		// Get Company ID

		var companyId = JSONCompany.getCompanyId();

		// Get site IDs

		var groupId1 = JSONGroup.getGroupIdByName(groupName = "${siteName1}");
		var groupId2 = JSONGroup.getGroupIdByName(groupName = "${siteName2}");
		var groupId3 = JSONGroup.getGroupIdByName(groupName = "${siteName3}");
		var groupId4 = JSONGroup.getGroupIdByName(groupName = "${siteName4}");
		var groupId5 = JSONGroup.getGroupIdByName(groupName = "${siteName5}");
		var groupId6 = JSONGroup.getGroupIdByName(groupName = "${siteName6}");

		// Get role IDs

		var roleId1 = JSONRole.getRoleIdByName(roleName = "${roleName1}");
		var roleId2 = JSONRole.getRoleIdByName(roleName = "${roleName2}");
		var roleId3 = JSONRole.getRoleIdByName(roleName = "${roleName3}");
		var roleId4 = JSONRole.getRoleIdByName(roleName = "${roleName4}");
		var roleId5 = JSONRole.getRoleIdByName(roleName = "${roleName5}");
		var roleId6 = JSONRole.getRoleIdByName(roleName = "${roleName6}");
		var roleId7 = JSONRole.getRoleIdByName(roleName = "${roleName7}");

		// Add users

		var userId1 = JSONUser._addUser(
			companyId = "${companyId}",
			groupId = "${groupId1}",
			portalURL = "${portalURL}",
			userEmailAddress = "${userEmailAddress1}",
			userFirstName = "${userFirstName1}",
			userLastName = "${userLastName1}",
			userScreenName = "${userScreenName1}");
		var userId2 = JSONUser._addUser(
			companyId = "${companyId}",
			groupId = "${groupId1}",
			portalURL = "${portalURL}",
			userEmailAddress = "${userEmailAddress2}",
			userFirstName = "${userFirstName2}",
			userLastName = "${userLastName2}",
			userScreenName = "${userScreenName2}");
