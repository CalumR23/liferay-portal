<html>
<head>
<title>SalesforceOpportunityProductAdd</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOpportunityProductAdd</td></tr>
</thead>
<tbody>
<!--PRICE_BOOK_SELECTION-->
<tr>
	<td>OPPORTUNITY_SELECT_PRICE_BOOK</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Price Book')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PRODUCT_SELECTION-->
<tr>
	<td>OPPORTUNITY_SELECT_PRODUCT_NAME_CHECKBOX</td>
	<td>//div[contains(@class,'x-grid3-row') and contains(.,'${key_productName}')]//input[@class='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PRODUCT_DETAILS_FORM-->
<tr>
	<td>OPPORTUNITY_PRODUCT_QUANTITY</td>
	<td>//input[contains(@name,'Quantity')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_SALES_PRICE</td>
	<td>//input[contains(@name,'UnitPrice')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_TERM_TYPE</td>
	<td>//select[contains(.,'Annual')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_TYPE</td>
	<td>//select[contains(.,'New')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_DATE</td>
	<td>//input[contains(@name,'ServiceDate')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_END_DATE</td>
	<td>//input[contains(@name,'ServiceDate')]//parent::span//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_ANNUAL_SALES_PRICE</td>
	<td>//input[contains(@name,'Description')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>