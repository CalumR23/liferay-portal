<html>
<head>
<title>SalesforceOpportunityCreate</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOpportunityCreate</td></tr>
</thead>
<tbody>
<!--NEW_OPPORTUNITY_FORM-->
<tr>
	<td>OPPORTUNITY_RECORD_TYPE</td>
	<td>//label[contains(.,'Record Type')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_NAME</td>
	<td>//label[contains(.,'Opportunity Name')]//parent::span//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_TYPE</td>
	<td>//label[contains(.,'Type')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_STAGE</td>
	<td>//label[contains(.,'Stage')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_STAGE_DETAIL</td>
	<td>//label[contains(.,'Stage Detail')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_CLOSE_DATE</td>
	<td>//label[contains(.,'Close Date')]//parent::span//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_CLOSE_DATE_TODAY</td>
	<td>//div[@class='requiredInput']//span[contains(@class,'dateInput')]//span//a</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_CURRENCY</td>
	<td>//label[contains(.,'Opportunity Currency')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_SOLD_BY_COUNTRY</td>
	<td>//label[contains(.,'Sold By')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PARTNER_TERRITORY</td>
	<td>//select[contains(@title,'Partner Territory')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>