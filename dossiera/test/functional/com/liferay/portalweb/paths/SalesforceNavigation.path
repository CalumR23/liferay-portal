<html>
<head>
<title>SalesforceNavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceNavigation</td></tr>
</thead>
<tbody>
<!--TOOLBAR-->
<tr>
	<td>USER_PROFILE_DROPDOWN_LINK</td>
	<td>//div[@id='userNavButton']//span</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_PROFILE_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Profile')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_SETTINGS_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Settings')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_LOGOUT_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'Logout')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--HEADER_TABS-->
<tr>
	<td>HOME_TAB</td>
	<td>//li[@id='home_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNTS_TAB</td>
	<td>//li[@id='Account_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITIES_TAB</td>
	<td>//li[@id='Opportunity_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCTS_TAB</td>
	<td>//li[@id='Product2_Tab']//a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>