<html>
<head>
<title>SalesforceNavigation</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceNavigation</td></tr>
</thead>
<tbody>
<!--TOOLBAR-->
<tr>
	<td>SEARCHBAR</td>
	<td>//div[contains(@class,'searchBox')]//input</td>
	<td></td>
</tr>
<tr>
	<td>SEARCHBAR_RESULT</td>
	<td>//li[contains(@id,'phSearchInput_autoComplete')]//a[contains(.,'${key_searchName}')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_PROFILE_DROPDOWN_LINK</td>
	<td>//div[@id='userNavButton']//span</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_PROFILE_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Profile')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_MY_SETTINGS_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'My Settings')]</td>
	<td></td>
</tr>
<tr>
	<td>USER_LOGOUT_LINK</td>
	<td>//div[contains(@id,'userNav-menuItems')]//a[contains(.,'Logout')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--HEADER_TABS-->
<tr>
	<td>HOME_TAB</td>
	<td>//li[@id='home_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNTS_TAB</td>
	<td>//li[@id='Account_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITIES_TAB</td>
	<td>//li[@id='Opportunity_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td>PRODUCTS_TAB</td>
	<td>//li[@id='Product2_Tab']//a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MULTIPURPOSE_BUTTONS-->
<tr>
	<td>SAVE_BUTTON</td>
	<td>//td[contains(@id,'bottomButton')]//input[@title='Save'] | //td[@align='center']//input[@title='Save']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_AND_NEW_BUTTON</td>
	<td>//td[contains(@id,'bottomButton')]//input[contains(@title,'New')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//td[contains(@id,'bottomButton')]//input[@title='Cancel']</td>
	<td></td>
</tr>
<tr>
	<td>CONTINUE_BUTTON</td>
	<td>//td[contains(@id,'bottomButton')]//input[contains(@title,'Continue')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_BUTTON</td>
	<td>//div[@class='selectButtons']//input[@title='Select']</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_IN_LIST_ADD_BUTTON</td>
	<td>//a[@title='Add']//img</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>DELETE_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='Delete']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MODAL_BUTTONS-->
<tr>
	<td>MODAL_OK_BUTTON</td>
	<td>//div[@id='InlineEditDialogContent']//input[@value='OK']</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_CANCEL_BUTTON</td>
	<td>//div[@id='InlineEditDialogContent']//input[@value='Cancel']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>