<html>
<head>
<title>SalesforceOpportunity</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOpportunity</td></tr>
</thead>
<tbody>
<!--OPPORTUNITY_DETAILS-->
<tr>
	<td>OPPORTUNITY_DETAILS_RECORD_TYPE</td>
	<td>//td[@class='labelCol' and contains(.,'Record Type')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_OPPORTUNITY_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Opportunity Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_TYPE</td>
	<td>//td[@class='labelCol' and contains(.,'Type')]//span[contains(@id,'Opportunity.Type')]//parent::td//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_STAGE</td>
	<td>//td[@class='labelCol' and contains(.,'Stage')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_STAGE_DETAIL</td>
	<td>//td[@class='labelCol' and contains(.,'Stage Detail')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_CLOSE_DATE</td>
	<td>//td[@class='labelCol' and contains(.,'Close Date')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_CURRENCY</td>
	<td>//td[@class='labelCol' and contains(.,'Opportunity Currency')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_SOLD_BY_COUNTRY</td>
	<td>//td[@class='labelCol' and contains(.,'Sold By')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_PARTNER_TERRITORY</td>
	<td>//td[@class='labelCol' and contains(.,'Partner Territory')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--OPPORTUNITY_NAVIGATION-->
<tr>
	<td>FEED_TAB</td>
	<td>//ul[@class='optionContainer']//a[contains(.,'Feed')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_TAB</td>
	<td>//ul[@class='optionContainer']//a[contains(.,'Details')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADD_PRODUCT-->
<tr>
	<td>ADD_PRODUCT_BUTTON</td>
	<td>//input[@title='Add Product']</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRICE_BOOK_BUTTON</td>
	<td>//input[@title='Choose Price Book']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EDIT_MODAL_DEPENDENT_FIELDS-->
<tr>
	<td>EDIT_OPPORTUNITY_STAGE</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Stage')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_OPPORTUNITY_PROBABILITY</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Probability')]//following-sibling::td//input</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>