	<td>ORDER_FORM_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Opportunity')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_ACCOUNT_NAME</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Account')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CONTACT</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contact')]//following-sibling::td//span/input</td>
	<td></td>
</tr>
<tr>
	<td>ORDER_FORM_CONTRACTING_COUNTRY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Contracting Country')]//following-sibling::td//select</td>
