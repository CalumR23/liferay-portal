</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_TERM_TYPE</td>
	<td>//td//select[contains(.,'Annual')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_TYPE</td>
	<td>//td//select[contains(.,'New')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_DATE</td>
	<td>//td//input[contains(@name,'ServiceDate')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_END_DATE</td>
	<td>xpath=(//td//span[contains(@class,'dateInput')])[2]//input</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_ANNUAL_SALES_PRICE</td>
	<td>//td//input[contains(@name,'Description')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EDIT_MODAL_DEPENDENT_FIELDS-->
<tr>
	<td>EDIT_OPPORTUNITY_STAGE</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Stage')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_OPPORTUNITY_PROBABILITY</td>
	<td>//div[@id='InlineEditDialogContent']//td[contains(@class,'labelCol') and contains(.,'Probability')]//following-sibling::td//input</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>