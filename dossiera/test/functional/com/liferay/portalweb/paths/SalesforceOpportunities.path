</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_CLOSE_DATE</td>
	<td>//td[@class='labelCol' and contains(.,'Close Date')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_CURRENCY</td>
	<td>//td[@class='labelCol' and contains(.,'Opportunity Currency')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_SOLD_BY_COUNTRY</td>
	<td>//td[@class='labelCol' and contains(.,'Sold By')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_DETAILS_PARTNER_TERRITORY</td>
	<td>//td[@class='labelCol' and contains(.,'Partner Territory')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--OPPORTUNITY_NAVIGATION-->
<tr>
	<td>FEED_TAB</td>
	<td>//ul[@class='optionContainer']//a[contains(.,'Feed')]</td>
	<td></td>
</tr>
<tr>
	<td>DETAILS_TAB</td>
	<td>//ul[@class='optionContainer']//a[contains(.,'Details')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--OPPORTUNITY_BUTTONS-->
<tr>
	<td>ADD_PRODUCT_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='Add Product']</td>
	<td></td>
</tr>
<tr>
	<td>CHOOSE_PRICE_BOOK_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='Choose Price Book']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ADD_PRODUCT-->
<tr>
	<td>OPPORTUNITY_SELECT_PRICE_BOOK</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Price Book')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_SELECT_PRODUCT_NAME_CHECKBOX</td>
	<td>//div[contains(@class,'x-grid3-row') and contains(.,'${key_productName}')]//input[@class='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_QUANTITY</td>
	<td>//td//input[contains(@name,'Quantity')]</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_PRODUCT_SALES_PRICE</td>
