<html>
<head>
<title>SalesforceOpportunities</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceOpportunities</td></tr>
</thead>
<tbody>
<!--OPPORTUNITY_HOME-->
<tr>
	<td>NEW_OPPORTUNITY_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='New']</td>
	<td></td>
</tr>
<tr>
	<td>RECENT_OPPORTUNITY_NAME</td>
	<td>//td[contains(@class,'dataCell') and contains(.,'${key_accountName}')]//parent::tr//th//a[contains(.,'${key_opportunityName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--NEW_OPPORTUNITY_FORM-->
<tr>
	<td>OPPORTUNITY_RECORD_TYPE</td>
	<td>//label[contains(.,'Record Type')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_NAME</td>
	<td>//label[contains(.,'Opportunity Name')]//parent::span//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>OPPORTUNITY_TYPE</td>
	<td>//label[contains(.,'Type')]//parent::span//parent::td//following-sibling::td//select</td>
