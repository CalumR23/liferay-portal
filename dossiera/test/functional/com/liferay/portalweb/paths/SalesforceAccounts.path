<html>
<head>
<title>SalesforceAccounts</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SalesforceAccounts</td></tr>
</thead>
<tbody>
<!--ACCOUNT_HOME-->
<tr>
	<td>NEW_ACCOUNT_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='New']</td>
	<td></td>
</tr>
<tr>
	<td>RECENT_ACCOUNT_NAME</td>
	<td>//th[contains(@class,'dataCell')]//a[contains(.,'${key_accountName}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--NEW_ACCOUNT_FORM-->
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//label[contains(.,'Account Name')]//parent::td//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_CURRENCY</td>
	<td>//label[contains(.,'Account Currency')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_INDUSTRY</td>
	<td>//label[contains(.,'Industry')]//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_PARTNER_LEVEL</td>
	<td>//label[contains(.,'Partner Level')]//parent::span//parent::td//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DESCRIPTION</td>
	<td>//label[contains(.,'Description')]//parent::td//following-sibling::td//textarea</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ACCOUNT_DETAILS-->
<tr>
	<td>ACCOUNT_DETAILS_NAME</td>
	<td>//td[@class='labelCol' and contains(.,'Account Name')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_OWNER</td>
	<td>//td[@class='labelCol' and contains(.,'Account Owner')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_INDUSTRY</td>
	<td>//td[@class='labelCol' and contains(.,'Industry')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_PARTNER_LEVEL</td>
	<td>//td[@class='labelCol' and contains(.,'Partner Level')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_ACTIVE_SERVICE_PARTNER_CHECKED</td>
	<td>//td[@class='labelCol' and contains(.,'Active Service Partner?')]//following-sibling::td//div//img[@title='Checked']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_ACCT_SVC_PARTNERSHIP_TERM</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Acct Svc Partnership Term')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_ACTIVE_TRAINING_PARTNER_CHECKED</td>
	<td>//td[@class='labelCol' and contains(.,'Active Training Partner?')]//following-sibling::td//div//img[@title='Checked']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_ACCT_TRG_PARTNERSHIP_TERM</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Acct Trg Partnership Term')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_DETAILS_DESCRIPTION</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Description')]//following-sibling::td//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ACCOUNT_OPPORTUNITIES-->
<tr>
	<td>ACCOUNT_OPPORTUNITIES_SPECIFIC_OPPORTUNITY</td>
	<td>xpath=(//div[contains(@id,'RelatedOpportunityList')]//tr[contains(@class,'dataRow')])[${key_salesforceOpportunityPosition}]//th//a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_OPPORTUNITIES_FIRST_OPPORTUNITY</td>
	<td>//div[contains(@id,'RelatedOpportunityList')]//tr[contains(@class,'dataRow')]//th//a</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_OPPORTUNITIES_FIRST_OPPORTUNITY_EDIT</td>
	<td>//div[contains(@id,'RelatedOpportunityList')]//tr[contains(@class,'dataRow')]//td//a[@class='actionLink' and contains(@title,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_OPPORTUNITIES_FIRST_OPPORTUNITY_DELETE</td>
	<td>//div[contains(@id,'RelatedOpportunityList')]//tr[contains(@class,'dataRow')]//td//a[@class='actionLink' and contains(@title,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ACCOUNT_BUTTONS-->
<tr>
	<td>NEW_ADDRESS_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='New Account Address']</td>
	<td></td>
</tr>
<tr>
	<td>NEW_OPPORTUNITY_BUTTON</td>
	<td>//td[contains(@class,'pbButton')]//input[@title='New Opportunity']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--NEW_ACCOUNT_ADDRESS-->
<tr>
	<td>ACCOUNT_ADDRESS_ALIAS</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Account Address Alias')]//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_TYPE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Address Type')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_STREET</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Street')]//following-sibling::td//textarea</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_CITY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'City')]//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_COUNTRY</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Country')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_STATE</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'State')]//following-sibling::td//select</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_ADDRESS_ZIP</td>
	<td>//td[contains(@class,'labelCol') and contains(.,'Postal Code')]//following-sibling::td//input</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--DELETE_PROBLEMS-->
<tr>
	<td>LISTED_OPPORTUNITY_NAME</td>
	<td>//div[contains(@class,'listRelatedObject')]//tr[contains(@class,'dataRow')]//th//a</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>