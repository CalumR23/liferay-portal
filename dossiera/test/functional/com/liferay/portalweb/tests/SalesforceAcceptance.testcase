<definition component-name="salesforce">

	<set-up>
		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute macro="SalesforceAccounts#deleteAllAccounts" />

		<execute macro="SalesforceNavigation#gotoProjects" />

		<execute macro="SalesforceProjects#deleteAllProjects" />
	</set-up>

	<tear-down>
		<execute macro="SalesforceLogin#logoutUser" />
	</tear-down>

	<command name="CloseWonSvcPartnership" priority="5">
		<var name="salesforceAccountName" value="GeneralSvcAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Service Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editOpportunityStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#viewPartnershipDetails">
			<var name="salesforceAccountAcctSvcPartnershipTerm" value="2016, Sep 6 - 2017, Sep 5" />
			<var name="salesforceAccountActiveServicePartner" value="true" />
		</execute>
	</command>

	<command name="CloseWonSvcPartnershipAndDeleteAccount" priority="5">
		<var name="salesforceAccountName" value="DeleteSvcAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Service Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editOpportunityStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="Salesforce#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>
	</command>

	<command name="CloseWonTrgPartnership" priority="5">
		<var name="salesforceAccountName" value="GeneralTrgAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Training Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editOpportunityStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#viewPartnershipDetails">
			<var name="salesforceAccountAcctTrgPartnershipTerm" value="2016, Sep 6 - 2017, Sep 5" />
			<var name="salesforceAccountActiveTrainingPartner" value="true" />
		</execute>
	</command>

	<command name="CloseWonTrgPartnershipAndDeleteAccount" priority="5">
		<var name="salesforceAccountName" value="DeleteTrgAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName"  value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType"  value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry"  value="US" />
			<var name="salesforceOpportunityStage"  value="Qualifying" />
			<var name="salesforceOpportunityStageDetail"  value="Attempting to Contact" />
			<var name="salesforceOpportunityType"  value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Training Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editOpportunityStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="Salesforce#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>
	</command>

	<command name="CreateAndDeleteProject" priority="5">
		<var name="salesforceAccountName" value="GeneralSvcAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />
		<var name="salesforceProjectName" value="GeneralPrj" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="Salesforce#createAndViewProject">
			<var name="salesforceProjectAccount" value="${salesforceAccountName}" />
			<var name="salesforceProjectFirstLineSupport" value="Yes" />
			<var name="salesforceProjectLicenseOptionPurchased" value="A" />
			<var name="salesforceProjectLiferayVersion" value="6.2 EE" />
			<var name="salesforceProjectMaximumNumContacts" value="2" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
			<var name="salesforceProjectPartnerLevel" value="Gold" />
			<var name="salesforceProjectRecordType" value="OEM" />
			<var name="salesforceProjectSupportCenter" value="Americas" />
			<var name="salesforceProjectSupportLanguage" value="English" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#assignProject">
			<var name="salesforceOpportunityProject" value="${salesforceProjectName}" />
		</execute>

		<execute macro="Salesforce#deleteProject">
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
		</execute>
	</command>

	<command name="CreateAndUpdateAccount" priority="5">
		<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
		<var name="salesforceAccountDescription" value="This is a test" />
		<var name="salesforceAccountIndustry1" value="Aerospace &amp; Defense" />
		<var name="salesforceAccountIndustry2" value="Agriculture" />
		<var name="salesforceAccountName1" value="Pre-UpdateAcct" />
		<var name="salesforceAccountName2" value="Post-UpdateAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceAccountPartnerLevel" value="Silver" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry1}" />
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
		</execute>

		<execute macro="SalesforceAccount#editAccountDetails">
			<var name="salesforceAccountDescription" value="${salesforceAccountDescription}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry2}" />
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
		</execute>

		<execute macro="SalesforceAccount#viewAccountDetails">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountDescription" value="${salesforceAccountDescription}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry2}" />
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>
	</command>

	<command name="CreateAndUpdatePartnerOpportunity" priority="5">
		<var name="salesforceAccountName" value="GeneralSvcAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="Salesforce#createAndViewPartnerOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="${salesforceAccountName}" />
			<var name="salesforcePartnerOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforcePartnerOpportunityOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePartnerOpportunityOpportunityType" value="Renewal" />
			<var name="salesforcePartnerOpportunityOwner" value="${salesforceAccountOwner}" />
			<var name="salesforcePartnerOpportunityPartnerEmail" value="test@liferay.com" />
			<var name="salesforcePartnerOpportunityPartnerFirstName" value="Test" />
			<var name="salesforcePartnerOpportunityPartnerLastName" value="Partner" />
			<var name="salesforcePartnerOpportunityRecordType" value="Training" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
		</execute>

		<execute macro="SalesforceOpportunity#clickPartnerOpportunity">
			<var name="salesforcePartnerOpportunityKeyword" value="Open" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#editPartnerOpportunityStage">
			<var name="salesforcePartnerOpportunityPrimaryReasonLost" value="Too Expensive" />
			<var name="salesforcePartnerOpportunityStage" value="Closed Lost" />
		</execute>
	</command>
</definition>