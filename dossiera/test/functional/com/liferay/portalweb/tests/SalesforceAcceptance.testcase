<definition component-name="salesforce">

	<set-up>
		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute macro="SalesforceAccounts#deleteAllAccounts" />

		<execute macro="SalesforceNavigation#gotoProjects" />

		<execute macro="SalesforceProjects#deleteAllProjects" />
	</set-up>

	<tear-down>
		<execute macro="SalesforceLogin#logoutUser" />
	</tear-down>

	<command name="CloseLostPartnerOpportunity" priority="5">
		<var name="salesforceAccountName" value="CloseLostPartnerOpportunity" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="${salesforceAccountName}" />
		<var name="salesforceProjectName" value="${salesforceAccountName} Project" />

		<execute macro="Salesforce#createAndViewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCloseDate" value="1/1/2017" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan" />
			<var name="salesforceOpportunityRecordType" value="General" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="Salesforce#createAndViewPartnerOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePartnerOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforcePartnerOpportunityOwner" value="${salesforceAccountOwner}" />
			<var name="salesforcePartnerOpportunityPartnerEmail" value="test@liferay.com" />
			<var name="salesforcePartnerOpportunityPartnerFirstName" value="Test" />
			<var name="salesforcePartnerOpportunityPartnerLastName" value="Partner" />
			<var name="salesforcePartnerOpportunityRecordType" value="Subscription" />
			<var name="salesforcePartnerOpportunityType" value="Renewal" />
		</execute>

		<execute macro="Salesforce#createAndViewProject">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceProjectFirstLineSupport" value="Yes" />
			<var name="salesforceProjectLicenseOptionPurchased" value="A" />
			<var name="salesforceProjectLiferayVersion" value="6.2 EE" />
			<var name="salesforceProjectMaximumNumContacts" value="2" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
			<var name="salesforceProjectPartnerLevel" value="Gold" />
			<var name="salesforceProjectRecordType" value="OEM" />
			<var name="salesforceProjectSupportCenter" value="Americas" />
			<var name="salesforceProjectSupportLanguage" value="English" />
		</execute>

		<execute macro="Salesforce#addAndSyncProducts">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePriceBook" value="[Current] USD - DXP Subscription and Services" />
			<var name="salesforceProductDate" value="1/1/2017" />
			<var name="salesforceProductEndDate" value="12/31/2017" />
			<var name="salesforceProductName" value="Liferay DXP Subscription - Gold Backup Sizing 1" />
			<var name="salesforceProductSalesPrice" value="11,750.00" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
		</execute>

		<execute macro="SalesforceOpportunity#assignProject">
			<var name="salesforceOpportunityProject" value="${salesforceProjectName}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
		</execute>

		<execute macro="SalesforceOpportunity#clickPartnerOpportunity">
			<var name="salesforcePartnerOpportunityKeyword" value="Open" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#editStage">
			<var name="salesforcePartnerOpportunityPrimaryReasonLost" value="Too Expensive" />
			<var name="salesforcePartnerOpportunityStage" value="Closed Lost" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#clickOpportunity" />

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityClosedLostVendorSelected" value="Wordpress VIP" />
			<var name="salesforceOpportunityPrimaryReasonLost" value="Too Expensive" />
			<var name="salesforceOpportunityPrimaryReasonLostComment" value="Too Expensive" />
			<var name="salesforceOpportunityStage" value="Closed Lost" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#viewNoOpportunity">
			<var name="salesforceOpportunityKeyword" value="Uncommitted Renewal" />
		</execute>
	</command>

	<command name="CloseWonPartnerOpportunity" priority="5">
