<definition component-name="salesforce-acceptance">

	<command name="CloseWonTrgPartnership" priority="5">
		<var name="salesforceAccountName" value="GeneralAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="GeneralOpp" />

		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="Salesforce#createAndViewNewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewNewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType" value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry" value="US" />
			<var name="salesforceOpportunityStage" value="Qualifying" />
			<var name="salesforceOpportunityStageDetail" value="Attempting to Contact" />
			<var name="salesforceOpportunityType" value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Training Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#viewPartnershipDetails">
			<var name="salesforceAccountAcctTrgPartnershipTerm" value="2016, Sep 6 - 2017, Sep 5" />
			<var name="salesforceAccountActiveTrainingPartner" value="true" />
		</execute>
	</command>

	<command name="CloseWonTrgPartnershipAndDeleteAccount" priority="5">
		<var name="salesforceAccountName" value="DeleteAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceOpportunityName" value="DeleteOpp" />

		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="Salesforce#createAndViewNewAccount">
			<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceAccountIndustry" value="Aerospace &amp; Defense" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="Silver" />
		</execute>

		<execute macro="Salesforce#createAndViewNewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceOpportunityName"  value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="Afghanistan,Albania" />
			<var name="salesforceOpportunityRecordType"  value="Partnership" />
			<var name="salesforceOpportunitySoldByCountry"  value="US" />
			<var name="salesforceOpportunityStage"  value="Qualifying" />
			<var name="salesforceOpportunityStageDetail"  value="Attempting to Contact" />
			<var name="salesforceOpportunityType"  value="New Business" />
		</execute>

		<execute macro="SalesforceOpportunity#addPartnershipProduct">
			<var name="salesforceOpportunityProductDate" value="9/6/2016" />
			<var name="salesforceOpportunityProductEndDate" value="9/5/2017" />
			<var name="salesforceOpportunityProductName" value="Training Partnership" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="Salesforce#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>
	</command>

	<command name="CreateAndUpdateAccount" priority="5">
		<var name="salesforceAccountCurrency" value="USD - U.S. Dollar" />
		<var name="salesforceAccountDescription" value="This is a test" />
		<var name="salesforceAccountIndustry1" value="Aerospace &amp; Defense" />
		<var name="salesforceAccountIndustry2" value="Agriculture" />
		<var name="salesforceAccountName1" value="Pre-UpdateAcct" />
		<var name="salesforceAccountName2" value="Post-UpdateAcct" />
		<var name="salesforceAccountOwner" value="Sales QA" />
		<var name="salesforceAccountPartnerLevel" value="Silver" />

		<execute macro="SalesforceLogin#loginUser" />

		<execute macro="Salesforce#createAndViewNewAccount">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry1}" />
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName1}" />
		</execute>

		<execute macro="SalesforceAccount#editAccountDetails">
			<var name="salesforceAccountDescription" value="${salesforceAccountDescription}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry2}" />
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
		</execute>

		<execute macro="SalesforceAccount#viewAccountDetails">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountDescription" value="${salesforceAccountDescription}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry2}" />
			<var name="salesforceAccountName" value="${salesforceAccountName2}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>
	</command>
</definition>