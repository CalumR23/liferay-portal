<definition>
	<command name="clickOpportunity">
		<execute function="Click" locator1="SalesforceProduct#PRODUCT_DETAILS_OPPORTUNITY_NAME" />
	</command>

	<command name="viewProductDetails">
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_NAME" value1="${salesforceProductName}" />
		<execute function="AssertTextEquals" locator1="SalesforceProduct#PRODUCT_DETAILS_PRODUCT_TYPE" value1="${salesforceProductType}" />

		<if>
			<and>
				<isset var="salesforceProductQuantity" />
				<not>
					<contains string="${salesforceProductQuantity}" substring="{salesforceProductQuantity}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_QUANTITY" value1="${salesforceProductQuantity}" />
			</then>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_SALES_PRICE" value1="${salesforceProductSalesPrice}" />

		<if>
			<and>
				<isset var="salesforceProductAnnualSalesPrice" />
				<not>
					<contains string="${salesforceProductAnnualSalesPrice}" substring="{salesforceProductAnnualSalesPrice}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_ANNUAL_SALES_PRICE" value1="${salesforceProductAnnualSalesPrice}" />
			</then>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_PRODUCT_TERM_TYPE" value1="${salesforceProductTermType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_DATE" value1="${salesforceProductDate}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceProduct#PRODUCT_DETAILS_END_DATE" value1="${salesforceProductEndDate}" />
	</command>
</definition>