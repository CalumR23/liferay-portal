<definition>
	<command name="gotoAccounts">
		<execute function="Click" locator1="SalesforceNavigation#ACCOUNTS_TAB" />
	</command>

	<command name="gotoHome">
		<execute function="Click" locator1="SalesforceNavigation#HOME_TAB" />
	</command>

	<command name="gotoOpportunities">
		<execute function="Click" locator1="SalesforceNavigation#OPPORTUNITIES_TAB" />
	</command>

	<command name="gotoProducts">
		<execute function="Click" locator1="SalesforceNavigation#PRODUCTS_TAB" />
	</command>

	<command name="gotoRecentAccount">
		<var name="key_accountName" value="${salesforceAccountName}" />

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute function="AssertClick" locator1="SalesforceAccounts#RECENT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
	</command>

	<command name="gotoRecentOpportunity">
		<var name="key_opportunityName" value="${salesforceOpportunityName}" />

		<execute macro="SalesforceNavigation#gotoOpportunities" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="SalesforceOpportunities#RECENT_OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />

		<execute macro="SalesforceOpportunity#gotoDetails" />
	</command>

	<command name="searchItem">
		<var method="StringUtil#lowerCase('${searchType}')" name="key_searchType" />

		<execute function="Type" locator1="SalesforceSearch#SEARCHBAR" value1="${searchName}" />

		<if>
			<condition function="IsElementPresent" locator1="SalesforceSearch#SEARCHBAR_RESULT" />
			<then>
				<execute function="Click#makeVisibleClickAt" locator1="SalesforceSearch#SEARCHBAR_RESULT" />
			</then>
		</if>
	</command>
</definition>