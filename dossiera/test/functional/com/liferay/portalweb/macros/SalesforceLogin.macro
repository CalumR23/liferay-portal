<definition>
	<command name="loginUser">
		<var method="TestPropsUtil#get('salesforce.email.address.1')" name="userEmailAddress" />
		<var method="TestPropsUtil#get('salesforce.email.password.1')" name="userEmailPassword" />

		<execute macro="SalesforceLogin#openURL" />

		<execute function="Type" locator1="SalesforceLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />

		<execute function="Type" locator1="SalesforceLogin#PASSWORD_FIELD" value1="${userEmailPassword}" />

		<execute function="Click" locator1="SalesforceLogin#SIGN_IN_BUTTON" value1="Sign In" />
	</command>

	<command name="logoutUser">
		<execute macro="SalesforceLogin#openURL" />

		<execute function="Click" locator1="SalesforceNavigation#USER_PROFILE_DROPDOWN_LINK" />
		<execute function="Click" locator1="SalesforceNavigation#USER_LOGOUT_LINK" />
	</command>

	<command name="openURL">
		<var method="TestPropsUtil#get('salesforce.url')" name="salesforceUrl" />

		<execute function="Open" locator1="${salesforceUrl}" />
	</command>
</definition>