<definition>
	<command name="addEndUserAmount">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_END_USER_AMOUNT" />

		<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_END_USER_AMOUNT" value1="${salesforceOpportunityEndUserAmount}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_END_USER_AMOUNT" value1="${salesforceOpportunityEndUserAmount}" />
	</command>

	<command name="addPartnershipProduct">
		<execute function="Click" locator1="SalesforceOpportunity#ADD_PRODUCT_BUTTON" />

		<execute macro="SalesforceProductAdd#addProduct">
			<var name="salesforcePriceBook" value="[Current] USD - Partnership" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="1" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>
	</command>

	<command name="addSubscriptionProduct">
		<execute function="Click" locator1="SalesforceOpportunity#ADD_PRODUCT_BUTTON" />

		<execute macro="SalesforceProductAdd#addProduct">
			<var name="salesforcePriceBook" value="[Current] USD - DXP Subscription and Services" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="1" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>
	</command>

	<command name="assignPartner">
		<var name="key_opportunityPartner" value="${salesforceOpportunityPartner}" />

		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP" />

		<execute function="SelectWindow" locator1="title=Search ~ Salesforce - Enterprise Edition" />

		<execute function="SelectFrame" locator1="name=resultsFrame" />

		<execute function="AssertClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI_LOOKUP_ACCOUNT" value1="${salesforceOpportunityPartner}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_RESELLER_SI" value1="${salesforceOpportunityPartner}" />
	</command>

	<command name="assignProject">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT" />

		<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_DETAILS_PROJECT" value1="${salesforceOpportunityProject}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PROJECT" value1="${salesforceOpportunityProject}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME" value1="${salesforceOpportunityProject}" />
	</command>

	<command name="choosePriceBook">
		<execute function="Click" locator1="SalesforceOpportunity#CHOOSE_PRICE_BOOK_BUTTON" />

		<execute function="Select" locator1="SalesforceOpportunityProductAdd#OPPORTUNITY_SELECT_PRICE_BOOK" value1="${salesforceOpportunityPriceBook}" />

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />
	</command>

	<command name="clickOpportunityProduct">
		<var name="key_opportunityProductKeyword" value="${salesforceOpportunityProductKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PRODUCT_NAME" />
	</command>

	<command name="clickPartnerOpportunity">
		<var name="key_partnerOpportunityKeyword" value="${salesforcePartnerOpportunityKeyword}" />

		<execute function="Click" locator1="SalesforceOpportunity#OPPORTUNITY_PARTNER_OPPORTUNITY_ID" />
	</command>

	<command name="createPartnerOpportunity">
		<execute function="Click" locator1="SalesforceOpportunity#NEW_PARTNER_OPPORTUNITY_BUTTON" />

		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_RECORD_TYPE" value1="${salesforcePartnerOpportunityRecordType}" />

		<execute macro="SalesforceButton#continue" />

		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName} ${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_FIRST_NAME" value1="${salesforcePartnerOpportunityPartnerFirstName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_LAST_NAME" value1="${salesforcePartnerOpportunityPartnerLastName}" />
		<execute function="Type" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_PARTNER_EMAIL" value1="${salesforcePartnerOpportunityPartnerEmail}" />
		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_CURRENCY" value1="${salesforcePartnerOpportunityCurrency}" />
		<execute function="Select" locator1="SalesforcePartnerOpportunityCreate#PARTNER_OPPORTUNITY_OPPORTUNITY_TYPE" value1="${salesforcePartnerOpportunityType}" />

		<execute macro="SalesforceButton#save" />
	</command>

	<command name="deleteOpportunity">
		<while>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_ID" />
			<then>
				<execute function="ClickNoError" locator1="SalesforceOpportunity#OPPORTUNITY_FIRST_PARTNER_OPPORTUNITY_DELETE" />

				<execute function="Confirm" value1="Are you sure?" />

				<execute function="Pause" locator1="3000" />
			</then>
		</while>

		<execute macro="SalesforceButton#delete" />
	</command>

	<command name="editStage">
		<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" />

		<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_STAGE" value1="${salesforceOpportunityStage}" />

		<if>
			<equals arg1="${salesforceOpportunityStage}" arg2="Closed Won" />
			<then>
				<execute function="AssertTextEquals" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PROBABILITY" value1="100" />
			</then>
		</if>

		<if>
			<and>
				<isset var="salesforceOpportunityTermType" />
				<not>
					<contains string="${salesforceOpportunityTermType}" substring="{salesforceOpportunityTermType}" />
				</not>
			</and>
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_TERM_TYPE" value1="${salesforceOpportunityTermType}" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" />
			<then>
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST" value1="${salesforceOpportunityPrimaryReasonLost}" />
				<execute function="Select" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_CLOSED_LOST_VENDOR_SELECTED" value1="${salesforceOpportunityClosedLostVendorSelected}" />
			</then>
		</if>

		<execute macro="SalesforceButton#modalOK" />

		<if>
			<and>
				<isset var="salesforceOpportunityPrimaryReasonLostComment" />
				<not>
					<contains string="${salesforceOpportunityPrimaryReasonLostComment}" substring="{salesforceOpportunityPrimaryReasonLostComment}" />
				</not>
			</and>
			<then>
				<execute function="DoubleClick" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PRIMARY_REASON_LOST_COMMENTS" />

				<execute function="Type" locator1="SalesforceOpportunity#EDIT_OPPORTUNITY_PRIMARY_REASON_LOST_COMMENTS" value1="${salesforceOpportunityPrimaryReasonLostComment}" />

				<execute macro="SalesforceButton#modalOK" />
			</then>
		</if>

		<execute macro="SalesforceButton#save" />

		<execute function="Pause" locator1="3000" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" value1="${salesforceOpportunityStage}" />
		<execute function="AssertNotVisible" locator1="SalesforceOpportunity#OPPORTUNITY_SAVE_ERROR" />
	</command>

	<command name="gotoDetails">
		<execute function="Click" locator1="SalesforceOpportunity#DETAILS_TAB" />
	</command>

	<command name="gotoFeed">
		<execute function="Click" locator1="SalesforceOpportunity#FEED_TAB" />
	</command>

	<command name="viewOpportunityDetails">
		<execute macro="SalesforceOpportunity#gotoDetails" />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_RECORD_TYPE" value1="${salesforceOpportunityRecordType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_OPPORTUNITY_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_TYPE" value1="${salesforceOpportunityType}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE" value1="${salesforceOpportunityStage}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_STAGE_DETAIL" value1="${salesforceOpportunityStageDetail}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_CURRENCY" value1="${salesforceOpportunityCurrency}" />
		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_SOLD_BY_COUNTRY" value1="Liferay ${salesforceOpportunitySoldByCountry}" />

		<if>
			<and>
				<isset var="salesforceOpportunityCloseDate" />
				<not>
					<contains string="${salesforceOpportunityCloseDate}" substring="{salesforceOpportunityCloseDate}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_CLOSE_DATE" value1="${salesforceOpportunityCloseDate}" />
			</then>
		</if>

		<var method="StringUtil#replace('${salesforceOpportunityPartnerTerritoryList}', ',', '; ')" name="salesforceOpportunityPartnerTerritoryList" />

		<execute function="AssertTextEquals" locator1="SalesforceOpportunity#OPPORTUNITY_DETAILS_PARTNER_TERRITORY" value1="${salesforceOpportunityPartnerTerritoryList}" />
	</command>
</definition>