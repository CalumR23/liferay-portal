<definition>
	<command name="addAndSyncProducts">
		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Qualifying" />
		</execute>

		<execute macro="SalesforceOpportunity#clickPartnerOpportunity">
			<var name="salesforcePartnerOpportunityKeyword" value="Open" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#clickFirstQuoteNumber" />

		<execute macro="SalesforceQuote#addLineItem">
			<var name="salesforcePriceBook" value="${salesforcePriceBook}" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="${salesforceProductQuantity}" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="${salesforceProductTermType}" />
			<var name="salesforceProductType" value="${salesforceProductType}" />
		</execute>

		<execute macro="SalesforceQuote#clickPartnerOpportunity" />

		<execute macro="SalesforcePartnerOpportunity#syncProducts" />

		<execute macro="SalesforceOpportunity#clickOpportunityProduct">
			<var name="salesforceOpportunityProductKeyword" value="${salesforceProductName}" />
		</execute>

		<execute macro="SalesforceProduct#viewProductDetails">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceProductAnnualSalesPrice" value="${salesforceProductAnnualSalesPrice}" />
			<var name="salesforceProductDate" value="${salesforceProductDate}" />
			<var name="salesforceProductEndDate" value="${salesforceProductEndDate}" />
			<var name="salesforceProductName" value="${salesforceProductName}" />
			<var name="salesforceProductQuantity" value="${salesforceProductQuantity}" />
			<var name="salesforceProductSalesPrice" value="${salesforceProductSalesPrice}" />
			<var name="salesforceProductTermType" value="${salesforceProductTermType}" />
			<var name="salesforceProductType" value="${salesforceProductType}" />
		</execute>
	</command>

	<command name="createAndViewAccount">
		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute macro="SalesforceAccounts#createAccount">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry}" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>

		<execute macro="SalesforceAccount#addDummyAccountAddress">
			<var name="salesforceAccountAddressType" value="Billing" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#viewAccountDetails">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry}" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>
	</command>

	<command name="createAndViewContact">
		<execute macro="SalesforceNavigation#gotoContacts" />

		<execute macro="SalesforceContacts#createContact">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContactCurrency" value="${salesforceContactCurrency}" />
			<var name="salesforceContactFirstName" value="${salesforceContactFirstName}" />
			<var name="salesforceContactLastName" value="${salesforceContactLastName}" />
			<var name="salesforceContactMailingCountry" value="${salesforceContactMailingCountry}" />
			<var name="salesforceContactPurchaseDecisionInvolvement" value="${salesforceContactPurchaseDecisionInvolvement}" />
			<var name="salesforceContactTitle" value="${salesforceContactTitle}" />
			<var name="salesforceContactType" value="${salesforceContactType}" />
		</execute>

		<execute macro="SalesforceContact#viewContactDetails">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceContactFirstName" value="${salesforceContactFirstName}" />
			<var name="salesforceContactLastName" value="${salesforceContactLastName}" />
			<var name="salesforceContactMailingCountry" value="${salesforceContactMailingCountry}" />
			<var name="salesforceContactPurchaseDecisionInvolvement" value="${salesforceContactPurchaseDecisionInvolvement}" />
			<var name="salesforceContactTitle" value="${salesforceContactTitle}" />
			<var name="salesforceContactType" value="${salesforceContactType}" />
		</execute>
	</command>

	<command name="createAndViewOpportunity">
		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#createOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCloseDate" value="${salesforceOpportunityCloseDate}" />
			<var name="salesforceOpportunityCurrency" value="${salesforceOpportunityCurrency}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType" value="${salesforceOpportunityRecordType}" />
			<var name="salesforceOpportunitySoldByCountry" value="${salesforceOpportunitySoldByCountry}" />
			<var name="salesforceOpportunityStage" value="${salesforceOpportunityStage}" />
			<var name="salesforceOpportunityStageDetail" value="${salesforceOpportunityStageDetail}" />
			<var name="salesforceOpportunityType" value="${salesforceOpportunityType}" />
		</execute>

		<execute macro="SalesforceOpportunity#viewOpportunityDetails">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCloseDate" value="${salesforceOpportunityCloseDate}" />
			<var name="salesforceOpportunityCurrency" value="${salesforceOpportunityCurrency}" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType" value="${salesforceOpportunityRecordType}" />
			<var name="salesforceOpportunitySoldByCountry" value="${salesforceOpportunitySoldByCountry}" />
			<var name="salesforceOpportunityStage" value="${salesforceOpportunityStage}" />
			<var name="salesforceOpportunityStageDetail" value="${salesforceOpportunityStageDetail}" />
			<var name="salesforceOpportunityType" value="${salesforceOpportunityType}" />
		</execute>
	</command>

	<command name="createAndViewPartnerOpportunity">
		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="${salesforceOpportunityKeyword}" />
		</execute>

		<execute macro="SalesforceOpportunity#createPartnerOpportunity">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePartnerOpportunityCurrency" value="${salesforcePartnerOpportunityCurrency}" />
			<var name="salesforcePartnerOpportunityPartnerEmail" value="${salesforcePartnerOpportunityPartnerEmail}" />
			<var name="salesforcePartnerOpportunityPartnerFirstName" value="${salesforcePartnerOpportunityPartnerFirstName}" />
			<var name="salesforcePartnerOpportunityPartnerLastName" value="${salesforcePartnerOpportunityPartnerLastName}" />
			<var name="salesforcePartnerOpportunityRecordType" value="${salesforcePartnerOpportunityRecordType}" />
			<var name="salesforcePartnerOpportunityType" value="${salesforcePartnerOpportunityType}" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#viewPartnerOpportunityDetails">
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePartnerOpportunityOwner" value="${salesforcePartnerOpportunityOwner}" />
			<var name="salesforcePartnerOpportunityPartnerEmail" value="${salesforcePartnerOpportunityPartnerEmail}" />
			<var name="salesforcePartnerOpportunityPartnerFirstName" value="${salesforcePartnerOpportunityPartnerFirstName}" />
			<var name="salesforcePartnerOpportunityPartnerLastName" value="${salesforcePartnerOpportunityPartnerLastName}" />
			<var name="salesforcePartnerOpportunityRecordType" value="${salesforcePartnerOpportunityRecordType}" />
			<var name="salesforcePartnerOpportunityType" value="${salesforcePartnerOpportunityType}" />
		</execute>
	</command>

	<command name="createAndViewProject">
		<execute macro="SalesforceNavigation#gotoProjects" />

		<execute macro="SalesforceProjects#createProject">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceProjectFirstLineSupport" value="${salesforceProjectFirstLineSupport}" />
			<var name="salesforceProjectLicenseOptionPurchased" value="${salesforceProjectLicenseOptionPurchased}" />
			<var name="salesforceProjectLiferayVersion" value="${salesforceProjectLiferayVersion}" />
			<var name="salesforceProjectMaximumNumContacts" value="${salesforceProjectMaximumNumContacts}" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
			<var name="salesforceProjectPartnerLevel" value="${salesforceProjectPartnerLevel}" />
			<var name="salesforceProjectRecordType" value="${salesforceProjectRecordType}" />
			<var name="salesforceProjectSupportCenter" value="${salesforceProjectSupportCenter}" />
			<var name="salesforceProjectSupportLanguage" value="${salesforceProjectSupportLanguage}" />
		</execute>

		<execute macro="SalesforceProject#viewProjectDetails">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceProjectFirstLineSupport" value="${salesforceProjectFirstLineSupport}" />
			<var name="salesforceProjectLicenseOptionPurchased" value="${salesforceProjectLicenseOptionPurchased}" />
			<var name="salesforceProjectLiferayVersion" value="${salesforceProjectLiferayVersion}" />
			<var name="salesforceProjectMaximumNumContacts" value="${salesforceProjectMaximumNumContacts}" />
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
			<var name="salesforceProjectPartnerLevel" value="${salesforceProjectPartnerLevel}" />
			<var name="salesforceProjectRecordType" value="${salesforceProjectRecordType}" />
			<var name="salesforceProjectSupportCenter" value="${salesforceProjectSupportCenter}" />
			<var name="salesforceProjectSupportLanguage" value="${salesforceProjectSupportLanguage}" />
		</execute>
	</command>

	<command name="deleteAccount">
		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccount#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute macro="SalesforceAccounts#viewNoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>
	</command>

	<command name="deleteProject">
		<execute macro="SalesforceNavigation#gotoRecentProject">
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
		</execute>

		<execute macro="SalesforceButton#delete" />

		<execute macro="SalesforceNavigation#gotoProjects" />

		<execute macro="SalesforceProjects#viewNoRecentProject">
			<var name="salesforceProjectName" value="${salesforceProjectName}" />
		</execute>
	</command>
</definition>