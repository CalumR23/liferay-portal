<definition>
	<command name="addFromList">
		<execute function="Click" locator1="Button#ADD_FROM_LIST_BUTTON" />
	</command>

	<command name="cancel">
		<execute function="Click" locator1="Button#CANCEL_BUTTON" />
	</command>

	<command name="continue">
		<execute function="Click" locator1="Button#CONTINUE_BUTTON" />
	</command>

	<command name="delete">
		<execute function="ClickNoError" locator1="Button#DELETE_BUTTON" />

		<execute function="Confirm" value1="Are you sure?" />

		<execute function="Pause" locator1="3000" />
	</command>

	<command name="edit">
		<execute function="Click" locator1="Button#EDIT_BUTTON" />
	</command>

	<command name="modalCancel">
		<execute function="Click" locator1="Button#MODAL_CANCEL_BUTTON" />
	</command>

	<command name="modalOK">
		<execute function="Click" locator1="Button#MODAL_OK_BUTTON" />
	</command>

	<command name="new">
		<execute function="Click" locator1="Button#NEW_BUTTON" />
	</command>

	<command name="save">
		<execute function="Click" locator1="Button#SAVE_BUTTON" />
	</command>

	<command name="saveAndNew">
		<execute function="Click" locator1="Button#SAVE_AND_NEW_BUTTON" />
	</command>

	<command name="select">
		<execute function="Click" locator1="Button#SELECT_BUTTON" />
	</command>
</definition>