<definition>
	<command name="fillContact">
		<execute function="Type" locator1="SalesforceContactCreate#CONTACT_FIRST_NAME" value1="${salesforceContactFirstName}" />
		<execute function="Type" locator1="SalesforceContactCreate#CONTACT_LAST_NAME" value1="${salesforceContactLastName}" />
		<execute function="Type" locator1="SalesforceContactCreate#CONTACT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="Type" locator1="SalesforceContactCreate#CONTACT_TITLE" value1="${salesforceContactTitle}" />
		<execute function="Select" locator1="SalesforceContactCreate#CONTACT_PURCHASE_DECISION_INVOLVEMENT" value1="${salesforceContactPurchaseDecisionInvolvement}" />
		<execute function="Select" locator1="SalesforceContactCreate#CONTACT_CURRENCY" value1="${salesforceContactCurrency}" />

		<for list="${salesforceContactType}" param="salesforceContactType">
			<execute function="Select" locator1="SalesforceContactCreate#CONTACT_CONTACT_TYPE" value1="${salesforceContactType}" />
			<execute macro="SalesforceButton#addFromList" />
		</for>

		<execute function="Select" locator1="SalesforceContactCreate#CONTACT_MAILING_COUNTRY" value1="${salesforceContactMailingCountry}" />
	</command>

	<command name="viewContactDetails">
		<execute function="AssertTextEquals" locator1="SalesforceContact#CONTACT_DETAILS_NAME" value1="${salesforceContactFirstName} ${salesforceContactLastName}" />
		<execute function="AssertTextEquals" locator1="SalesforceContact#CONTACT_DETAILS_ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="AssertTextEquals" locator1="SalesforceContact#CONTACT_DETAILS_TITLE" value1="${salesforceContactTitle}" />
		<execute function="AssertTextEquals" locator1="SalesforceContact#CONTACT_DETAILS_PURCHASE_DECISION_INVOLVEMENT" value1="${salesforceContactPurchaseDecisionInvolvement}" />

		<for list="${salesforceContactType}" param="salesforceContactType">
			<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceContact#CONTACT_DETAILS_CONTACT_TYPE" value1="${salesforceContactType}" />
		</for>

		<execute function="AssertTextEquals" locator1="SalesforceContact#CONTACT_DETAILS_MAILING_COUNTRY" value1="${salesforceContactMailingCountry}" />
	</command>
</definition>