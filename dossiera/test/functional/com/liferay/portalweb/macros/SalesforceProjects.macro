<definition>
	<command name="clickFirstRecentProject">
		<execute function="Click" locator1="SalesforceProjects#FIRST_RECENT_PROJECT_NAME" />
	</command>

	<command name="createProject">
		<execute macro="SalesforceButton#new" />

		<execute function="Select" locator1="SalesforceProjectCreate#PROJECT_RECORD_TYPE" value1="${salesforceProjectRecordType}" />

		<execute macro="SalesforceButton#continue" />

		<execute function="Type" locator1="SalesforceProjectCreate#PROJECT_NAME" value1="${salesforceProjectName}" />
		<execute function="Type" locator1="SalesforceProjectCreate#PROJECT_ACCOUNT" value1="${salesforceAccountName}" />
		<execute function="Select" locator1="SalesforceProjectCreate#PROJECT_LIFERAY_VERSION" value1="${salesforceProjectLiferayVersion}" />
		<execute function="Select" locator1="SalesforceProjectCreate#PROJECT_FIRST_LINE_SUPPORT" value1="${salesforceProjectFirstLineSupport}" />

		<if>
			<equals arg1="${salesforceProjectRecordType}" arg2="OEM" />
			<then>
				<execute function="Select" locator1="SalesforceProjectCreate#PROJECT_LICENSE_OPTION_PURCHASED" value1="${salesforceProjectLicenseOptionPurchased}" />
				<execute function="Select" locator1="SalesforceProjectCreate#PROJECT_SUPPORT_SERVICES_LEVEL" value1="${salesforceProjectPartnerLevel}" />
				<execute function="Type" locator1="SalesforceProjectCreate#PROJECT_MAXIMUM_NUM_CONTACTS" value1="${salesforceProjectMaximumNumContacts}" />
			</then>
		</if>

		<execute macro="SalesforceButton#save" />
	</command>

	<command name="deleteAllProjects">
		<while>
			<condition function="IsElementPresent" locator1="SalesforceProjects#FIRST_RECENT_PROJECT_NAME" />
			<then>
				<execute macro="SalesforceProjects#clickFirstRecentProject" />

				<execute macro="SalesforceButton#delete" />

				<execute macro="SalesforceNavigation#gotoProjects" />
			</then>
		</while>
	</command>

	<command name="viewNoRecentProject">
		<var name="key_accountName" value="${salesforceProjectName}" />

		<execute function="AssertElementNotPresent" locator1="SalesforceProjects#RECENT_PROJECT_NAME" value1="${salesforceProjectName}" />
	</command>
</definition>