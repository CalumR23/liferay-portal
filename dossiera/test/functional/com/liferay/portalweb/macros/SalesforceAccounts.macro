<definition>
	<command name="createNewAccount">
		<execute macro="Button#new" />

		<execute macro="Button#continue" />

		<execute function="Type" locator1="SalesforceAccountCreate#ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_CURRENCY" value1="${salesforceAccountCurrency}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_INDUSTRY" value1="${salesforceAccountIndustry}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_PARTNER_LEVEL" value1="${salesforceAccountPartnerLevel}" />

		<execute macro="Button#save" />
	</command>

	<command name="viewNoRecentAccount">
		<var name="key_accountName" value="${salesforceAccountName}" />

		<execute function="AssertElementNotPresent" locator1="SalesforceAccounts#RECENT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
	</command>
</definition>