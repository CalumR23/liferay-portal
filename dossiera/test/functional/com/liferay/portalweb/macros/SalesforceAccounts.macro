<definition>
	<command name="addAccountAddress">
		<execute function="Click" locator1="SalesforceAccounts#NEW_ADDRESS_BUTTON" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_ALIAS" value1="${salesforceAccountAddressAlias}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_TYPE" value1="${salesforceAccountAddressType}" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_STREET" value1="${salesforceAccountAddressStreet}" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_CITY" value1="${salesforceAccountAddressCity}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_COUNTRY" value1="${salesforceAccountAddressCountry}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_STATE" value1="${salesforceAccountAddressState}" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_ADDRESS_ZIP" value1="${salesforceAccountAddressZip}" />

		<execute function="Click" locator1="SalesforceNavigation#SAVE_BUTTON" />
	</command>

	<command name="addDummyAccountAddress">
		<execute macro="SalesforceAccounts#addAccountAddress">
			<var name="salesforceAccountAddressAlias" value="${salesforceAccountAddressType} Address" />
			<var name="salesforceAccountAddressCity" value="Diamond Bar" />
			<var name="salesforceAccountAddressCountry" value="United States" />
			<var name="salesforceAccountAddressState" value="California" />
			<var name="salesforceAccountAddressStreet" value="1400 Montefino Ave." />
			<var name="salesforceAccountAddressType" value="Primary ${salesforceAccountAddressType} Address" />
			<var name="salesforceAccountAddressZip" value="91765" />
		</execute>
	</command>

	<command name="clickSpecificOpportunity">
		<var name="key_salesforceOpportunityPosition" value="${salesforceOpportunityPosition}" />

		<execute function="Click" locator1="SalesforceAccounts#ACCOUNT_OPPORTUNITIES_SPECIFIC_OPPORTUNITY" />
	</command>

	<command name="createAndViewNewAccount">
		<execute macro="SalesforceAccounts#createNewAccount">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry}" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>

		<execute macro="SalesforceAccounts#addDummyAccountAddress">
			<var name="salesforceAccountAddressType" value="Billing" />
		</execute>

		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute macro="SalesforceAccounts#viewAccountDetails">
			<var name="salesforceAccountCurrency" value="${salesforceAccountCurrency}" />
			<var name="salesforceAccountIndustry" value="${salesforceAccountIndustry}" />
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceAccountOwner" value="${salesforceAccountOwner}" />
			<var name="salesforceAccountPartnerLevel" value="${salesforceAccountPartnerLevel}" />
		</execute>
	</command>

	<command name="createAndViewNewOpportunity">
		<execute macro="SalesforceAccounts#createNewOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency"  value="${salesforceOpportunityCurrency}" />
			<var name="salesforceOpportunityName"  value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType"  value="${salesforceOpportunityRecordType}" />
			<var name="salesforceOpportunitySoldByCountry"  value="${salesforceOpportunitySoldByCountry}" />
			<var name="salesforceOpportunityStage"  value="${salesforceOpportunityStage}" />
			<var name="salesforceOpportunityStageDetail"  value="${salesforceOpportunityStageDetail}" />
			<var name="salesforceOpportunityType"  value="${salesforceOpportunityType}" />
		</execute>

		<execute macro="SalesforceOpportunities#gotoDetails" />

		<execute macro="SalesforceOpportunities#viewOpportunityDetails">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityCurrency"  value="${salesforceOpportunityCurrency}" />
			<var name="salesforceOpportunityName"  value="${salesforceOpportunityName}" />
			<var name="salesforceOpportunityPartnerTerritoryList" value="${salesforceOpportunityPartnerTerritoryList}" />
			<var name="salesforceOpportunityRecordType"  value="${salesforceOpportunityRecordType}" />
			<var name="salesforceOpportunitySoldByCountry"  value="${salesforceOpportunitySoldByCountry}" />
			<var name="salesforceOpportunityStage"  value="${salesforceOpportunityStage}" />
			<var name="salesforceOpportunityStageDetail"  value="${salesforceOpportunityStageDetail}" />
			<var name="salesforceOpportunityType"  value="${salesforceOpportunityType}" />
		</execute>
	</command>

	<command name="createNewAccount">
		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute function="Click" locator1="SalesforceAccounts#NEW_ACCOUNT_BUTTON" />

		<execute function="Click" locator1="SalesforceNavigation#CONTINUE_BUTTON" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_NAME" value1="${salesforceAccountName}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_CURRENCY" value1="${salesforceAccountCurrency}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_INDUSTRY" value1="${salesforceAccountIndustry}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_PARTNER_LEVEL" value1="${salesforceAccountPartnerLevel}" />

		<execute function="Click" locator1="SalesforceNavigation#SAVE_BUTTON" />
	</command>

	<command name="createNewOpportunity">
		<execute function="Click" locator1="SalesforceAccounts#NEW_OPPORTUNITY_BUTTON" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_RECORD_TYPE" value1="${salesforceOpportunityRecordType}" />

		<execute function="Click" locator1="SalesforceNavigation#CONTINUE_BUTTON" />

		<execute function="Type" locator1="SalesforceOpportunities#OPPORTUNITY_NAME" value1="${salesforceOpportunityName}" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_TYPE" value1="${salesforceOpportunityType}" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_STAGE" value1="${salesforceOpportunityStage}" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_STAGE_DETAIL" value1="${salesforceOpportunityStageDetail}" />

		<execute function="Click" locator1="SalesforceOpportunities#OPPORTUNITY_CLOSE_DATE_TODAY" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_CURRENCY" value1="${salesforceOpportunityCurrency}" />

		<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_SOLD_BY_COUNTRY" value1="Liferay ${salesforceOpportunitySoldByCountry}" />

		<for list="${salesforceOpportunityPartnerTerritoryList}" param="salesforceOpportunityPartnerTerritory">
			<execute function="Select" locator1="SalesforceOpportunities#OPPORTUNITY_PARTNER_TERRITORY" value1="${salesforceOpportunityPartnerTerritory}" />

			<execute function="Click" locator1="SalesforceNavigation#SELECT_IN_LIST_ADD_BUTTON" />
		</for>

		<execute function="Click" locator1="SalesforceNavigation#SAVE_BUTTON" />
	</command>

	<command name="deleteAccount">
		<execute macro="SalesforceNavigation#gotoRecentAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute function="ClickNoError" locator1="SalesforceNavigation#DELETE_BUTTON" />

		<execute function="Confirm" value1="Are you sure?" />

		<execute function="Pause" locator1="3000" />
	</command>

	<command name="deleteAccountWithOpportunity">
		<execute macro="SalesforceAccounts#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>

		<execute function="AssertElementPresent" locator1="SalesforceAccounts#LISTED_OPPORTUNITY_NAME" />

		<execute function="Click" locator1="SalesforceAccounts#LISTED_OPPORTUNITY_NAME" />

		<execute macro="SalesforceOpportunities#gotoDetails" />

		<execute macro="SalesforceOpportunities#deleteOpportunity" />

		<execute macro="SalesforceAccounts#deleteAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
		</execute>
	</command>

	<command name="editAccountDetails">
		<execute function="Click" locator1="SalesforceNavigation#EDIT_BUTTON" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_NAME" value1="${salesforceAccountName}" />

		<execute function="Select" locator1="SalesforceAccounts#ACCOUNT_INDUSTRY" value1="${salesforceAccountIndustry}" />

		<execute function="Type" locator1="SalesforceAccounts#ACCOUNT_DESCRIPTION" value1="${salesforceAccountDescription}" />

		<execute function="Click" locator1="SalesforceNavigation#SAVE_BUTTON" />

		<execute function="Pause" locator1="3000" />
	</command>

	<command name="viewAccountDetails">
		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceAccounts#ACCOUNT_DETAILS_NAME" value1="${salesforceAccountName}"  />

		<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceAccounts#ACCOUNT_DETAILS_OWNER" value1="${salesforceAccountOwner}"  />

		<execute function="AssertTextEquals" locator1="SalesforceAccounts#ACCOUNT_DETAILS_INDUSTRY" value1="${salesforceAccountIndustry}"  />

		<execute function="AssertTextEquals" locator1="SalesforceAccounts#ACCOUNT_DETAILS_PARTNER_LEVEL" value1="${salesforceAccountPartnerLevel}"  />

		<if>
			<and>
				<isset var="salesforceAccountDescription" />
				<not>
					<contains string="${salesforceAccountDescription}" substring="{salesforceAccountDescription}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals" locator1="SalesforceAccounts#ACCOUNT_DETAILS_DESCRIPTION" value1="${salesforceAccountDescription}"  />
			</then>
		</if>
	</command>

	<command name="viewNoRecentAccount">
		<var name="key_accountName" value="${salesforceAccountName}" />

		<execute macro="SalesforceNavigation#gotoAccounts" />

		<execute function="AssertElementNotPresent" locator1="SalesforceAccounts#RECENT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
	</command>

	<command name="viewPartnershipDetails">
		<if>
			<equals arg1="${salesforceAccountActiveServicePartner}" arg2="true" />
			<then>
				<execute function="AssertElementPresent" locator1="SalesforceAccounts#ACCOUNT_DETAILS_ACTIVE_SERVICE_PARTNER_CHECKED" />
				<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceAccounts#ACCOUNT_DETAILS_ACCT_SVC_PARTNERSHIP_TERM" value1="${salesforceAccountAcctSvgPartnershipTerm}"  />
			</then>
			<elseif>
				<equals arg1="${salesforceAccountActiveTrainingPartner}" arg2="true" />
				<then>
					<execute function="AssertElementPresent" locator1="SalesforceAccounts#ACCOUNT_DETAILS_ACTIVE_TRAINING_PARTNER_CHECKED" />
					<execute function="AssertTextEquals#assertPartialText" locator1="SalesforceAccounts#ACCOUNT_DETAILS_ACCT_TRG_PARTNERSHIP_TERM" value1="${salesforceAccountAcctTrgPartnershipTerm}"  />
				</then>
			</elseif>
		</if>
	</command>
</definition>