<definition>
	<command name="clickFirstRecentAccount">
		<execute function="Click" locator1="SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME" />
	</command>

	<command name="createNewAccount">
		<execute macro="Button#new" />

		<execute macro="Button#continue" />

		<execute function="Type" locator1="SalesforceAccountCreate#ACCOUNT_NAME" value1="${salesforceAccountName}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_CURRENCY" value1="${salesforceAccountCurrency}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_INDUSTRY" value1="${salesforceAccountIndustry}" />
		<execute function="Select" locator1="SalesforceAccountCreate#ACCOUNT_PARTNER_LEVEL" value1="${salesforceAccountPartnerLevel}" />

		<execute macro="Button#save" />
	</command>

	<command name="deleteAllAccounts">
		<while>
			<condition function="IsElementPresent" locator1="SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME" />
			<then>
				<execute macro="SalesforceAccounts#getFirstRecentAccountName">
					<return from="salesforceAccountName" name="salesforceAccountName" />
				</execute>

				<execute macro="SalesforceAccounts#clickFirstRecentAccount" />

				<execute macro="SalesforceAccount#deleteAccount">
					<var name="salesforceAccountName" value="${salesforceAccountName}" />
				</execute>
			</then>
		</while>
	</command>

	<command name="getFirstRecentAccountName" returns="salesforceAccountName">
		<var locator="SalesforceAccounts#FIRST_RECENT_ACCOUNT_NAME" name="salesforceAccountName" />

		<return name="salesforceAccountName" value="${salesforceAccountName}" />
	</command>

	<command name="viewNoRecentAccount">
		<var name="key_accountName" value="${salesforceAccountName}" />

		<execute function="AssertElementNotPresent" locator1="SalesforceAccounts#RECENT_ACCOUNT_NAME" value1="${salesforceAccountName}" />
	</command>
</definition>