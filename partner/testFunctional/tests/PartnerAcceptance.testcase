<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<var name="businessPlanID" static="true" />
	<var name="mdfRequestID" static="true" />

	<var method="PropsUtil#get('partner.region.code')" name="partnerBusinessPlanRegionCode" />
	<var method="PropsUtil#get('partner.company')" name="partnerCompany" />
	<var method="PropsUtil#get('partner.region')" name="partnerRegion" />

	<set-up>
		<execute macro="Partner#loginUser">
			<var name="roleName" value="admin" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#deleteBusinessPlan">
			<var name="partnerBusinessPlanID" value="${businessPlanID}" />
		</execute>
	</tear-down>

	<command name="BusinessPlan" priority="5">
		<property name="test.group" value="businessPlan" />
		<var name="partnerBusinessPlanCompany" value="${partnerCompany}" />
		<var method="PropsUtil#get('partner.${partnerBusinessPlanRegionCode}.name.partner')" name="partnerBusinessPlanPartnerBusinessPlanOwner" />
		<var name="partnerBusinessPlanRegion" value="${partnerRegion}" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="USD" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanRegionCode" value="${partnerBusinessPlanRegionCode}" />
			<var name="partnerBusinessPlanYear" value="2018" />
			<return name="businessPlanID" />
		</execute>

		<execute macro="PartnerWorkflow#requestMoreInfoBusinessPlan">
			<var name="partnerBusinessPlanID" value="${businessPlanID}" />
			<var name="partnerBusinessPlanYear" value="2018" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="GBP" />
			<var name="partnerBusinessPlanID" value="${businessPlanID}" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="2018" />
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="PartnerWorkflow#approveBusinessPlan">
			<var name="partnerBusinessPlanID" value="${businessPlanID}" />
			<var name="partnerBusinessPlanYear" value="2018" />
		</execute>
	</command>

	<command name="MDFRequestAndClaim" priority="5">
		<property name="test.group" value="mdfRequest" />
		<var name="partnerMDFRequestCompanyName" value="${partnerCompany}" />
		<var name="partnerMDFRequestRegion" value="${partnerRegion}" />

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return name="mdfRequestID" />
		</execute>

		<execute macro="PartnerWorkflow#requestMoreInfoMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7891" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerWorkflow#approveMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#createMDFClaimFull">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<return name="mdfClaimID" />
		</execute>

		<execute macro="PartnerWorkflow#requestMoreInfoMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#approveMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerWorkflow#payoutMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>
	</command>
</definition>