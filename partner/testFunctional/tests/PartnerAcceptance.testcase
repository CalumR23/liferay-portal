@component-name = "partner"
definition {

	property testray.main.component.name = "partner";

	static var businessPlanID = "";
	static var mdfRequestID = "";
	var partnerBusinessPlanRegionCode = PropsUtil.get("partner.region.code");
	var partnerCompany = PropsUtil.get("partner.company");
	var partnerRegion = PropsUtil.get("partner.region");

	setUp {
		Partner.loginUser(roleName = "admin");
	}

	tearDown {
		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.deleteBusinessPlan(partnerBusinessPlanID = "${businessPlanID}");
	}

	@priority = "5"
	test BusinessPlan {
		property test.group = "businessPlan";

		var partnerBusinessPlanCompany = "${partnerCompany}";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanRegion = "${partnerRegion}";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "USD",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "2019");

		PartnerWorkflow.requestMoreInfoBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "2019");

		PartnerWorkflow.editAndSubmitBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "GBP",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanYear = "2019",
			roleName = "alliance_manager");

		PartnerWorkflow.approveBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "2019");
	}

	@priority = "5"
	test MDFRequestAndClaim {
		property test.group = "mdfRequest";

		var partnerMDFRequestCompanyName = "${partnerCompany}";
		var partnerMDFRequestRegion = "${partnerRegion}";

		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "USD",
			partnerMDFRequestFundingPeriod = "Q1-Q2 2020",
			partnerMDFRequestPhoneNumber = "123 456 7890",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.requestMoreInfoMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.editAndSubmitMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "USD",
			partnerMDFRequestFundingPeriod = "Q1-Q2 2020",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestPhoneNumber = "123 456 7891",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}",
			roleName = "partner");

		PartnerWorkflow.approveMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.requestMoreInfoMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerWorkflow.editAndSubmitMDFClaim(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.approveMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerWorkflow.payoutMDFClaim(partnerMDFClaimID = "${mdfClaimID}");
	}

}