	<command name="SaveAsDraftBusinessPlan" priority="5">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="PartnerMDFManager#clickNewBusinessPlanButton" />

		<execute macro="PartnerBusinessPlanForm#fillPartner">
			<var name="partnerBusinessPlanPartnerCompany" value="Omegabit" />
			<var name="partnerBusinessPlanPartnerCurrencyCode" value="USD" />
			<var name="partnerBusinessPlanPartnerRegion" value="United States" />
			<var name="partnerBusinessPlanPartnerYear" value="2018" />
		</execute>

		<execute macro="Partner#clickSaveDraftButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Drafts" />
		</execute>

		<execute macro="Partner#readLastRowID">
			<return from="rowID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
		<var name="partnerBusinessPlanStatus" value="Draft" />

		<execute macro="PartnerMDFManager#assertBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="" />
			<var name="partnerBusinessPlanPartner" value="Omegabit" />
			<var name="partnerBusinessPlanPartnerRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
		</execute>

		<execute macro="PartnerMDFManager#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="0" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="" />
			<var name="partnerBusinessPlanYear" value="2018" />
		</execute>
	</command>

	<command name="SaveIncompleteBusinessPlan" priority="5">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="PartnerMDFManager#clickNewBusinessPlanButton" />

		<execute macro="PartnerBusinessPlanForm#fillPartner">
			<var name="partnerBusinessPlanPartnerCompany" value="Omegabit" />
			<var name="partnerBusinessPlanPartnerCurrencyCode" value="USD" />
			<var name="partnerBusinessPlanPartnerRegion" value="United States" />
			<var name="partnerBusinessPlanPartnerYear" value="2018" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Drafts" />
		</execute>

		<execute macro="Partner#readLastRowID">
