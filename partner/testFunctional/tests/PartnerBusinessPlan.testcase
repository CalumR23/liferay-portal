		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact Edit" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="William Berks" />
			<var name="partnerBusinessPlanPartnerCompany" value="Omegabit" />
			<var name="partnerBusinessPlanPartnerCurrency" value="British Pound Sterling" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="Test MP Owner Edit" />
			<var name="partnerBusinessPlanPartnerRegion" value="us" />
		</execute>
	</command>

	<command name="RequestMoreInfoBusinessPlan" priority="5">
