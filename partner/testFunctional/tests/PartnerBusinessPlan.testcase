			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="Pending" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="$300.00" />
			<var name="partnerBusinessPlanYear" value="2018" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
