@component-name = "partner"
definition {

	property test.group = "businessPlan";
	property testray.main.component.name = "partner";

	static var businessPlanID = "";
	var partnerBusinessPlanCompany = PropsUtil.get("partner.company");
	var partnerBusinessPlanRegion = PropsUtil.get("partner.region");
	var partnerBusinessPlanRegionCode = PropsUtil.get("partner.region.code");

	setUp {
		Partner.loginUser(roleName = "admin");
	}

	tearDown {
		PartnerWorkflow.deleteBusinessPlan(partnerBusinessPlanID = "${businessPlanID}");
	}

	@priority = "5"
	test ApproveBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanStatus = "Approved";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2019";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerWorkflow.approveBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Business Plan Approved",
			mockMockRecipient = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "Your Business Plan ${businessPlanID} was approved by your General Manager.;Your approved plan can be found at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${businessPlanID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "alliance_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.assertComment(partnerComment = "Approved by General Manager.");
	}

	@priority = "5"
	test CheckFilterByBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanStatus = "Pending";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2020";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.logoutAndLoginUser(roleName = "alliance_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");
	}

	@priority = "5"
	test CreateBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanGeneralManager = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.general_manager");
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner";
		var partnerBusinessPlanStatus = "Pending";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2019";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "US Dollar",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "${partnerBusinessPlanPartnerMarketingPlanOwner}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertNoComments();

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Business Plan Submitted",
			mockMockRecipient = "${partnerBusinessPlanGeneralManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "An Alliance Manager has (re)submitted a business plan for your review.;Please review the plan at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${businessPlanID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "general_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "US Dollar",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "${partnerBusinessPlanPartnerMarketingPlanOwner}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertNoComments();
	}

	@priority = "5"
	test EditAndSubmitBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanGeneralManager = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.general_manager");
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanStatus = "Pending";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2019";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerWorkflow.requestMoreInfoBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerWorkflow.editAndSubmitBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "BRL",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}",
			roleName = "alliance_manager");

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact Edit",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "2",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "BRL 600",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "Brazilian Real",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact Edit",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner Edit",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");

		Partner.assertComment(partnerComment = "Adding an Edit as Alliance manager.");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Business Plan Submitted",
			mockMockRecipient = "${partnerBusinessPlanGeneralManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "An Alliance Manager has (re)submitted a business plan for your review.;Please review the plan at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${businessPlanID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "general_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact Edit",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "2",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "BRL 600",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "Brazilian Real",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact Edit",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner Edit",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");

		Partner.assertComment(partnerComment = "Adding an Edit as Alliance manager.");
	}

	@priority = "5"
	test RequestMoreInfoBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanStatus = "More Info Requested";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2019";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerWorkflow.requestMoreInfoBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Business Plan Request for More Information",
			mockMockRecipient = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "Your General Manager has requested more information about your Business Plan ${businessPlanID}.;The General Manager's comment was:;Requesting for More Info by General Manager.;Please revise the business plan, and then resubmit it at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${businessPlanID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "alliance_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");
	}

	@priority = "5"
	test ResendForReviewBusinessPlan {
		var partnerBusinessPlanCurrencyCode = "USD";
		var partnerBusinessPlanGeneralManager = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.general_manager");
		var partnerBusinessPlanLiferayBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.alliance_manager");
		var partnerBusinessPlanLiferayMarketingPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.regional_field_marketing");
		var partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact";
		var partnerBusinessPlanPartnerBusinessPlanOwner = PropsUtil.get("partner.${partnerBusinessPlanRegionCode}.name.partner");
		var partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner";
		var partnerBusinessPlanStatus = "Pending";
		var partnerBusinessPlanTotalRevenueProjections = "USD 300";
		var partnerBusinessPlanYear = "2019";

		var businessPlanID = PartnerWorkflow.createBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.deleteAllMail();

		PartnerWorkflow.requestMoreInfoBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerWorkflow.resendForReviewBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "US Dollar",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "${partnerBusinessPlanPartnerMarketingPlanOwner}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");

		Partner.assertComment(partnerComment = "Resending for Review by Alliance Manager.");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Business Plan Submitted",
			mockMockRecipient = "${partnerBusinessPlanGeneralManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "An Alliance Manager has (re)submitted a business plan for your review.;Please review the plan at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${businessPlanID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "general_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.assertBusinessPlan(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
