			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${businessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertSummary(
			partnerBusinessPlanNumberOfGoals = "1",
			partnerBusinessPlanStatus = "${partnerBusinessPlanStatus}",
			partnerBusinessPlanTotalRevenueProjections = "${partnerBusinessPlanTotalRevenueProjections}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlan.assertAccountInformation(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrency = "US Dollar",
			partnerBusinessPlanLiferayBusinessPlanOwner = "${partnerBusinessPlanLiferayBusinessPlanOwner}",
			partnerBusinessPlanLiferayMarketingPlanOwner = "${partnerBusinessPlanLiferayMarketingPlanOwner}",
			partnerBusinessPlanLiferayRenewalContact = "${partnerBusinessPlanLiferayRenewalContact}",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "${partnerBusinessPlanPartnerMarketingPlanOwner}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}");

		Partner.assertComment(partnerComment = "Requesting for More Info by General Manager.");

		Partner.assertComment(partnerComment = "Resending for Review by Alliance Manager.");
	}

