<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<var name="partnerBusinessPlanID" static="true" />

	<tear-down>
		<execute macro="PartnerWorkflow#deleteBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
		</execute>
	</tear-down>

	<command name="ApproveBusinessPlan" priority="5">
		<var name="partnerBusinessPlanAllianceManager" value="Douglas Simon" />
		<var name="partnerBusinessPlanCompany" value="Valamis Inc." />
		<var name="partnerBusinessPlanCurrencyCode" value="USD" />
		<var name="partnerBusinessPlanGeneralManager" value="Joshua Asbury" />
		<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
		<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
		<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
		<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="Johnnie Stubbs" />
		<var name="partnerBusinessPlanRegion" value="United States" />
		<var name="partnerBusinessPlanStatus" value="Approved" />
		<var name="partnerBusinessPlanTotalRevenueProjections" value="USD 300" />
		<var name="partnerBusinessPlanYear" value="2018" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<return from="partnerBusinessPlanID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />

		<execute macro="PartnerWorkflow#approveBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="${partnerBusinessPlanTotalRevenueProjections}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="${partnerBusinessPlanTotalRevenueProjections}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Approved by General Manager." />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] Business Plan Approved" />
			<var name="mockMockRecipient" value="${partnerBusinessPlanAllianceManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Alliance Manager,;Your Business Plan ${partnerBusinessPlanID} was approved by your General Manager.;Your approved plan can be found at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${partnerBusinessPlanID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="CheckFilterByBusinessPlan" priority="5">
		<var name="partnerBusinessPlanCompany" value="Valamis Inc." />
		<var name="partnerBusinessPlanCurrencyCode" value="USD" />
		<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
		<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
		<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
		<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="Johnnie Stubbs" />
		<var name="partnerBusinessPlanRegion" value="United States" />
		<var name="partnerBusinessPlanStatus" value="Pending" />
		<var name="partnerBusinessPlanTotalRevenueProjections" value="USD 300" />
		<var name="partnerBusinessPlanYear" value="2019" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<return from="partnerBusinessPlanID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>
	</command>

	<command name="CreateBusinessPlan" priority="5">
		<var name="partnerBusinessPlanAllianceManager" value="Douglas Simon" />
		<var name="partnerBusinessPlanCompany" value="Valamis Inc." />
		<var name="partnerBusinessPlanCurrencyCode" value="USD" />
		<var name="partnerBusinessPlanGeneralManager" value="Joshua Asbury" />
		<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
		<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
		<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
		<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="Johnnie Stubbs" />
		<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="Test MP Owner" />
		<var name="partnerBusinessPlanRegion" value="United States" />
		<var name="partnerBusinessPlanStatus" value="Pending" />
		<var name="partnerBusinessPlanTotalRevenueProjections" value="USD 300" />
		<var name="partnerBusinessPlanYear" value="2018" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<return from="partnerBusinessPlanID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="${partnerBusinessPlanTotalRevenueProjections}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrency" value="US Dollar" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="${partnerBusinessPlanPartnerMarketingPlanOwner}" />
			<var name="partnerBusinessPlanRegion" value="US" />
		</execute>

		<execute macro="Partner#assertNoComments" />

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="general_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="${partnerBusinessPlanTotalRevenueProjections}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrency" value="US Dollar" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="${partnerBusinessPlanLiferayRenewalContact}" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="${partnerBusinessPlanPartnerMarketingPlanOwner}" />
			<var name="partnerBusinessPlanRegion" value="US" />
		</execute>

		<execute macro="Partner#assertNoComments" />

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] Business Plan Submitted" />
			<var name="mockMockRecipient" value="${partnerBusinessPlanGeneralManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear General Manager,;An Alliance Manager has (re)submitted a business plan for your review.;Please review the plan at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${partnerBusinessPlanID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="EditAndSubmitBusinessPlan" priority="5">
		<var name="partnerBusinessPlanCompany" value="Valamis Inc." />
		<var name="partnerBusinessPlanCurrencyCode" value="USD" />
		<var name="partnerBusinessPlanGeneralManager" value="Joshua Asbury" />
		<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
		<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
		<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
		<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="Johnnie Stubbs" />
		<var name="partnerBusinessPlanRegion" value="United States" />
		<var name="partnerBusinessPlanStatus" value="Pending" />
		<var name="partnerBusinessPlanTotalRevenueProjections" value="USD 300" />
		<var name="partnerBusinessPlanYear" value="2018" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<return from="partnerBusinessPlanID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />

		<execute macro="PartnerWorkflow#requestMoreInfoBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact Edit" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="2" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="GBP 600" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrency" value="British Pound Sterling" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact Edit" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="Test MP Owner Edit" />
			<var name="partnerBusinessPlanRegion" value="US" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by General Manager." />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Adding an Edit as alliance_manager." />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="general_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact Edit" />
			<var name="partnerBusinessPlanRegion" value="US" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="2" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="GBP 600" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertAccountInformation">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrency" value="British Pound Sterling" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
			<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact Edit" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="Test MP Owner Edit" />
			<var name="partnerBusinessPlanRegion" value="US" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by General Manager." />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Adding an Edit as alliance_manager." />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] Business Plan Submitted" />
			<var name="mockMockRecipient" value="${partnerBusinessPlanGeneralManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear General Manager,;An Alliance Manager has (re)submitted a business plan for your review.;Please review the plan at the following link:;https://partner.liferay.com/business-plan-manager/-/business-plan-manager/${partnerBusinessPlanID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="RequestMoreInfoBusinessPlan" priority="5">
		<var name="partnerBusinessPlanAllianceManager" value="Douglas Simon" />
		<var name="partnerBusinessPlanCompany" value="Valamis Inc." />
		<var name="partnerBusinessPlanCurrencyCode" value="USD" />
		<var name="partnerBusinessPlanGeneralManager" value="Joshua Asbury" />
		<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="Douglas Simon" />
		<var name="partnerBusinessPlanLiferayMarketingPlanOwner" value="Michelle Hoshi" />
		<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
		<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="Johnnie Stubbs" />
		<var name="partnerBusinessPlanRegion" value="United States" />
		<var name="partnerBusinessPlanStatus" value="More Info Requested" />
		<var name="partnerBusinessPlanTotalRevenueProjections" value="USD 300" />
		<var name="partnerBusinessPlanYear" value="2018" />

		<execute macro="PartnerWorkflow#createBusinessPlan">
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
			<return from="partnerBusinessPlanID" name="partnerBusinessPlanID" />
		</execute>

		<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />

		<execute macro="PartnerWorkflow#requestMoreInfoBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlan#assertSummary">
			<var name="partnerBusinessPlanNumberOfGoals" value="1" />
			<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
			<var name="partnerBusinessPlanTotalRevenueProjections" value="${partnerBusinessPlanTotalRevenueProjections}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by General Manager." />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#assertBusinessPlan">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanLiferayBusinessPlanOwner" value="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
