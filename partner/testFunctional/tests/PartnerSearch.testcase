<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<var name="mdfClaimID" static="true" />
	<var name="mdfRequestID" static="true" />

	<var method="PropsUtil#get('partner.company')" name="partnerMDFRequestCompanyName" />
	<var method="PropsUtil#get('partner.region')" name="partnerMDFRequestRegion" />
	<var method="PropsUtil#get('partner.region.code')" name="partnerRegionCode" />

	<set-up>
		<execute macro="Partner#loginUser">
			<var name="roleName" value="admin" />
		</execute>

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return name="mdfRequestID" />
		</execute>

		<execute macro="PartnerWorkflow#approveMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>
	</tear-down>

	<command name="SearchMDFClaimDocuments" priority="5">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#clickNewClaimButton" />

		<execute macro="PartnerMDFClaimForm#fillGeneralInformation">
			<var name="partnerMDFClaimActivities" value="Test Activity1" />
			<var name="partnerMDFClaimInvoice" value="Document_1.doc" />
			<var name="partnerMDFClaimType" value="Partial" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="Event Collaterals" />
			<var name="partnerMDFClaimPOPDocument" value="Document_1.pdf" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="Event Invitations" />
			<var name="partnerMDFClaimPOPDocument" value="Document_1.doc" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="Event Photos" />
			<var name="partnerMDFClaimPOPDocument" value="Document_2.jpg" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="Event Programs" />
			<var name="partnerMDFClaimPOPDocument" value="Document_3.jpeg" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="List of Qualified Leads" />
			<var name="partnerMDFClaimPOPDocument" value="Partner_Leads.xlsx" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabel" value="Third Party Invoices" />
			<var name="partnerMDFClaimPOPDocument" value="Document_4.jpg" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#readTitleID">
			<return name="mdfClaimID" />
		</execute>

		<var name="partnerMDFClaimID" value="${mdfClaimID}" />

		<execute macro="Partner#gotoHome" />

		<execute macro="PartnerSearch#searchKeyword">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="PartnerSearch#assertNoSearchResult">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="general_manager" />
		</execute>

		<execute macro="PartnerSearch#searchKeyword">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="PartnerSearch#assertNoSearchResult">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="PartnerSearch#searchKeyword">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="PartnerSearch#assertNoSearchResult">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner2" />
		</execute>

		<execute macro="PartnerSearch#searchKeyword">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>

		<execute macro="PartnerSearch#assertNoSearchResult">
			<var name="partnerSearchKeyword" value="Document_1" />
		</execute>
	</command>
</definition>