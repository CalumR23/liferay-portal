@component-name = "partner"
definition {

	property test.group = "mdfRequest";
	property testray.main.component.name = "partner";

	static var mdfRequestID = "";
	var partnerMDFRequestCompanyName = PropsUtil.get("partner.company");
	var partnerMDFRequestGlobalAllianceManager = PropsUtil.get("partner.name.global_alliance_manager");
	var partnerMDFRequestGlobalPartnerMarketing = PropsUtil.get("partner.name.global_partner_marketing");
	var partnerMDFRequestRegion = PropsUtil.get("partner.region");
	var partnerRegionCode = PropsUtil.get("partner.region.code");

	setUp {
		Partner.loginUser(roleName = "admin");
	}

	tearDown {
		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${mdfRequestID}");
	}

	@priority = "5"
	test ApproveMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 100";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestGeneralManager = PropsUtil.get("partner.${partnerRegionCode}.name.general_manager");
		var partnerMDFRequestOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestRegionalFieldMarketing = PropsUtil.get("partner.${partnerRegionCode}.name.regional_field_marketing");
		var partnerMDFRequestStatus = "Approved";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.approveMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");

		Partner.gotoManagement();

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerOptionsList = "Edit,Delete");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Approved",
			mockMockRecipient = "${partnerMDFRequestOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		// LRQA-44688 Bug in MockMock prevents viewing this mail

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "Thank you for submitting your Marketing proposal. Your Marketing Development Fund request has been approved.;Comment:;Approved by Global Partner Marketing.;Your approved request can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/${mdfRequestID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund request;Comment:;Approved by Global Partner Marketing.;the following link:;${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Approved",
			mockMockRecipient = "${partnerMDFRequestGlobalAllianceManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "A Marketing Development Fund request was submitted and signed off by the Alliances team.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${mdfRequestID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund request;Comment:;Approved by Global Partner Marketing.;the following link:;${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Approved",
			mockMockRecipient = "${partnerMDFRequestGeneralManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "A Marketing Development Fund request was submitted and signed off by the Alliances team.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${mdfRequestID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund request;Comment:;Approved by Global Partner Marketing.;the following link:;${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Approved",
			mockMockRecipient = "${partnerMDFRequestRegionalFieldMarketing}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "A Marketing Development Fund request was submitted and signed off by the Alliances team.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${mdfRequestID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund request;Comment:;Approved by Global Partner Marketing.;the following link:;${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestReimbursementClaims = "Claim(s) Due by Aug 1, 2020",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View,Duplicate");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");
	}

	@priority = "5"
	test CreateMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Pending Marketing Review";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerNoOptionsList = "Edit,Delete,Duplicate",
			partnerOptionsList = "View");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Submitted",
			mockMockRecipient = "${partnerMDFRequestGlobalPartnerMarketing}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund request has been [re]submitted.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagement();

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerOptionsList = "Edit,Delete");

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");
	}

	@priority = "5"
	test DuplicateMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q3-Q4 2020";
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Pending Marketing Review";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "Q1-Q2 2020",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.approveMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		var partnerMDFRequestID2 = PartnerWorkflow.duplicateMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID2}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagement();

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${partnerMDFRequestID2}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.viewMDFRequestOptions(
			partnerMDFRequestID = "${partnerMDFRequestID2}",
			partnerOptionsList = "Edit,Delete");

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID2}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID2}");
	}

	@priority = "5"
	test EditAndSubmitMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 150";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Pending Marketing Review";
		var partnerMDFRequestTotalCost = "USD 300";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.requestMoreInfoMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.editAndSubmitMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}",
			roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMDFRequest.assertBusinessGoals(
			partnerMDFRequestBusinessGoals = "Generate Awareness,Increase ROI,Create Demand Generation",
			partnerMDFRequestMarketFocus = "Banking",
			partnerMDFRequestMarketingPlan = "Retain");

		PartnerMDFRequest.assertMarketingActivity(partnerMDFRequestActivityName = "Test Activity3");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");

		Partner.assertComment(partnerComment = "Adding an Edit as Partner.");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Submitted",
			mockMockRecipient = "${partnerMDFRequestGlobalPartnerMarketing}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund request has been [re]submitted.;The requester's comment was:;Adding an Edit as Partner.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagement();

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMDFRequest.assertBusinessGoals(
			partnerMDFRequestBusinessGoals = "Generate Awareness,Increase ROI,Create Demand Generation",
			partnerMDFRequestMarketFocus = "Banking",
			partnerMDFRequestMarketingPlan = "Retain");

		PartnerMDFRequest.assertMarketingActivity(partnerMDFRequestActivityName = "Test Activity3");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");

		Partner.assertComment(partnerComment = "Adding an Edit as Partner.");
	}

	@priority = "5"
	test RejectMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Rejected";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.rejectMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Rejected by Global Partner Marketing.");

		Partner.gotoManagement();

		Partner.gotoTab(tabName = "Completed");

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerOptionsList = "Edit,Delete");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request Rejected",
			mockMockRecipient = "${partnerMDFRequestOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "Unfortunately, your Marketing Development Fund request has been rejected.;The reviewer's comment was:;Rejected by Global Partner Marketing.;If you would like to create another request, please go to Liferay Partner Portal. If you have questions once you review the comments, please reach out to your Global Partner Marketing Manager.;The rejected request can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		Partner.gotoTab(tabName = "Completed");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerNoOptionsList = "Duplicate,Delete",
			partnerOptionsList = "View");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Rejected by Global Partner Marketing.");
	}

	@priority = "5"
	test RequestMoreInfoMDFRequest {
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "More Info Requested";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.requestMoreInfoMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");

		Partner.gotoManagement();

		PartnerManagement.assertMDFRequest(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerManagement.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerOptionsList = "Edit,Delete");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Request for More Information",
			mockMockRecipient = "${partnerMDFRequestOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A reviewer has requested more information about your Marketing Development Fund request.;The reviewer's comment was:;Requesting for More Info by Global Partner Marketing.;Please revise the request, and then resubmit it at the following link:;https://partner.liferay.com/mdf/-/mdf/${mdfRequestID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.viewMDFRequestOptions(
			partnerMDFRequestID = "${mdfRequestID}",
			partnerNoOptionsList = "Delete,Duplicate",
			partnerOptionsList = "Edit,View");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");
	}

