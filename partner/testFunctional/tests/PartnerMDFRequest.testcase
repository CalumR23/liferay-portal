<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<var name="partnerMDFRequestID" static="true" />

	<tear-down>
		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>
	</tear-down>

	<command name="ApproveMDFRequest" priority="5">
		<var name="partnerMDFRequestAllianceManager" value="Douglas Simon" />
		<var name="partnerMDFRequestAmountApproved" value="USD 100" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestCompanyName" value="Valamis Inc." />
		<var name="partnerMDFRequestCurrencyCode" value="USD" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestGeneralManager" value="Joshua Asbury" />
		<var name="partnerMDFRequestGlobalAllianceManager" value="Glenn Saler" />
		<var name="partnerMDFRequestGlobalPartnerMarketing" value="Karen Newnam" />
		<var name="partnerMDFRequestOwner" value="Johnnie Stubbs" />
		<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
		<var name="partnerMDFRequestRegion" value="United States" />
		<var name="partnerMDFRequestRegionalFieldMarketing" value="Michelle Hoshi" />
		<var name="partnerMDFRequestStatus" value="Approved" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return from="partnerMDFRequestID" name="partnerMDFRequestID" />
		</execute>

		<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />

		<execute macro="PartnerWorkflow#approveMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Approved by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#assertMDFRequest">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerManagement#viewMDFRequestOptions">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerOptionsList" value="Edit,Delete" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestReimbursementClaims" value="Claim(s) Due by Aug 1, 2019" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#viewMDFRequestOptions">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerNoOptionsList" value="Edit,Delete" />
			<var name="partnerOptionsList" value="View,Duplicate" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Approved by Global Partner Marketing." />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Request Available for Review" />
			<var name="mockMockRecipient" value="${partnerMDFRequestGlobalAllianceManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Global Alliance Manager,;A Marketing Development Fund request was submitted and signed off by Alliances Marketing and the partner's Alliance Manager.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link and provide any feedback you would like considered:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Request Available for Review" />
			<var name="mockMockRecipient" value="${partnerMDFRequestGeneralManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Regional Leadership,;A Marketing Development Fund request was submitted and signed off by your Alliances team.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] Partner MDF Request Available for Review" />
			<var name="mockMockRecipient" value="${partnerMDFRequestRegionalFieldMarketing}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Regional Field Marketing,;A Marketing Development Fund request was submitted and signed off by the Alliances team.;Comment:;Approved by Global Partner Marketing.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Request Approved" />
			<var name="mockMockRecipient" value="${partnerMDFRequestOwner}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear ${partnerMDFRequestOwner},;Thank you for submitting your Marketing proposal. Your Marketing Development Fund request has been approved.;Comment:;Approved by Global Partner Marketing.;Your approved request can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="CreateMDFRequest" priority="5">
		<var name="partnerMDFRequestAllianceManager" value="Douglas Simon" />
		<var name="partnerMDFRequestAmountApproved" value="USD 0" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestCompanyName" value="Valamis Inc." />
		<var name="partnerMDFRequestCurrencyCode" value="USD" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestGlobalPartnerMarketing" value="Karen Newnam" />
		<var name="partnerMDFRequestOwner" value="Johnnie Stubbs" />
		<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
		<var name="partnerMDFRequestRegion" value="United States" />
		<var name="partnerMDFRequestStatus" value="Pending Marketing Review" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return from="partnerMDFRequestID" name="partnerMDFRequestID" />
		</execute>

		<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#viewMDFRequestOptions">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerNoOptionsList" value="Edit,Delete,Duplicate" />
			<var name="partnerOptionsList" value="View" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#assertMDFRequest">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerManagement#viewMDFRequestOptions">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerOptionsList" value="Edit,Delete" />
		</execute>

		<execute macro="PartnerManagement#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] Business Plan Approved" />
			<var name="mockMockRecipient" value="${partnerMDFRequestGlobalPartnerMarketing}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Global Partner Marketing,;A Marketing Development Fund request has been [re]submitted.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${partnerMDFRequestID}" />
		</execute>r

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="DuplicateMDFRequest" priority="5">
		<var name="partnerMDFRequestAmountApproved" value="USD 0" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestCompanyName" value="Valamis Inc." />
		<var name="partnerMDFRequestCurrencyCode" value="USD" />
		<var name="partnerMDFRequestFundingPeriod" value="Q3-Q4 2019" />
		<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
		<var name="partnerMDFRequestRegion" value="United States" />
		<var name="partnerMDFRequestStatus" value="Pending Marketing Review" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return from="partnerMDFRequestID" name="partnerMDFRequestID" />
		</execute>

		<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />

		<execute macro="PartnerWorkflow#approveMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#duplicateMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<return from="partnerMDFRequestID2" name="partnerMDFRequestID2" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID2}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#assertMDFRequest">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID2}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerManagement#viewMDFRequestOptions">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID2}" />
			<var name="partnerOptionsList" value="Edit,Delete" />
		</execute>

		<execute macro="PartnerManagement#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID2}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID2}" />
		</execute>
	</command>

	<command name="EditAndSubmitMDFRequest" priority="5">
		<var name="partnerMDFRequestAmountApproved" value="USD 0" />
		<var name="partnerMDFRequestAmountRequested" value="USD 150" />
		<var name="partnerMDFRequestCompanyName" value="Valamis Inc." />
		<var name="partnerMDFRequestCurrencyCode" value="USD" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
		<var name="partnerMDFRequestRegion" value="United States" />
		<var name="partnerMDFRequestStatus" value="Pending Marketing Review" />
		<var name="partnerMDFRequestTotalCost" value="USD 300" />

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<return from="partnerMDFRequestID" name="partnerMDFRequestID" />
		</execute>

		<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />

		<execute macro="PartnerWorkflow#requestMoreInfoMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Generate Awareness,Increase ROI,Create Demand Generation" />
			<var name="partnerMDFRequestMarketFocus" value="Banking" />
			<var name="partnerMDFRequestMarketingPlan" value="Retain" />
		</execute>

		<execute macro="PartnerMDFRequest#assertMarketingActivity">
			<var name="partnerMDFRequestActivityName" value="Test Activity3" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Adding an Edit as partner." />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#assertMDFRequest">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerManagement#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertSummary">
			<var name="partnerMDFRequestAmountApproved" value="${partnerMDFRequestAmountApproved}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Generate Awareness,Increase ROI,Create Demand Generation" />
			<var name="partnerMDFRequestMarketFocus" value="Banking" />
			<var name="partnerMDFRequestMarketingPlan" value="Retain" />
		</execute>

		<execute macro="PartnerMDFRequest#assertMarketingActivity">
			<var name="partnerMDFRequestActivityName" value="Test Activity3" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Adding an Edit as partner." />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Request Submitted" />
			<var name="mockMockRecipient" value="${partnerMDFRequestGlobalPartnerMarketing}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Global Partner Marketing,;A Marketing Development Fund request has been [re]submitted.;The requester's comment was:;Adding an Edit as partner.;Please review the request at the following link:;https://partner.liferay.com/mdf-request-manager/-/mdf-request-manager/${partnerMDFRequestID}" />
