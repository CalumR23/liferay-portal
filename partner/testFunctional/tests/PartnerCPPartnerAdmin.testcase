@component-name = "partner"
definition {

	property test.group = "mdfRequest";
	property testray.main.component.name = "partner";

	static var mdfRequestID = "";
	var partnerMDFRequestCompanyName = PropsUtil.get("partner.company");
	var partnerMDFRequestRegion = PropsUtil.get("partner.region");
	var partnerRegionCode = PropsUtil.get("partner.region.code");

	setUp {
		Partner.loginUser(roleName = "admin");
	}

	tearDown {
		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${mdfRequestID}");
	}

	@priority = "5"
	test AssignGlobalPartnerMarketing {
		var partnerGlobalPartnerMarketing = "security user";
		var partnerGlobalPartnerMarketingEmail = "security.user@liferay.com.broken";
		var partnerGlobalPartnerMarketingUserID = "nJH%2F%2BXKjKkuAblT4wwjitg%3D%3D";
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Pending Manager Review";
		var partnerMDFRequestTotalCost = "USD 200";

		Partner.gotoCPPartnerAdmin();

		PartnerCPPartnerAdmin.addPartnerManagers(
			partnerManagerType = "Global Partner Marketing",
			partnerManagerUserEmailList = "${partnerGlobalPartnerMarketingEmail}",
			partnerRegionCode = "");

		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		Partner.impersonateUser(
			appendUrl = "home",
			userID = "${partnerGlobalPartnerMarketingUserID}");

		Partner.gotoManagement();

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by ${partnerGlobalPartnerMarketing}");

		Partner.clickSubmitButtonInModal();

		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		Partner.impersonateUser(
			appendUrl = "home",
			userID = "${partnerGlobalPartnerMarketingUserID}");

		Partner.gotoManagementClaims();

		PartnerManagement.clickMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by ${partnerGlobalPartnerMarketing}.");

		Partner.clickSubmitButtonInModal();

		Partner.gotoCPPartnerAdmin();

		PartnerCPPartnerAdmin.deletePartnerManagers(
			partnerManagerType = "Global Partner Marketing",
			partnerManagerUserEmailList = "${partnerGlobalPartnerMarketingEmail}",
			partnerRegionCode = "");

		Partner.impersonateUser(
			appendUrl = "home",
			userID = "${partnerGlobalPartnerMarketingUserID}");

		Partner.assertNoManagementView();
	}

	@priority = "5"
	test AssignMultipleAllianceManagers {
		var partnerAllianceManagerEmailList = "jeffrey.handa@liferay.com.broken,charles.may@liferay.com.broken";
		var partnerAllianceManagerList = "Jeffrey Handa,Charles May";
		var partnerMDFRequestAmountApproved = "USD 0";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestCurrencyCode = "USD";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestPhoneNumber = "123 456 7890";
		var partnerMDFRequestStatus = "Pending Manager Review";
		var partnerMDFRequestTotalCost = "USD 200";

		Partner.gotoCPPartnerAdmin();

		PartnerCPPartnerAdmin.addPartnerManagers(
			partnerManagerType = "Alliance Manager",
			partnerManagerUserEmailList = "${partnerAllianceManagerEmailList}",
			partnerRegionCode = "${partnerRegionCode}");

		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.sendForManagerReviewMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertAllianceManagerList(partnerMDFRequestAllianceManagerList = "${partnerAllianceManagerList}");

		Partner.gotoCPPartnerAdmin();

		PartnerCPPartnerAdmin.deletePartnerManagers(
			partnerManagerType = "Alliance Manager",
			partnerManagerUserEmailList = "${partnerAllianceManagerEmailList}",
			partnerRegionCode = "${partnerRegionCode}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewDuplicateMailFromInbox(
			mockMockAsset = "[Liferay Partner Portal] Request for Review: Partner MDF Proposal",
			mockMockRecipientList = "${partnerAllianceManagerList}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.deleteAllMail();
	}

}