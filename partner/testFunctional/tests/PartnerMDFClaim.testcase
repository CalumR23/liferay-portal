@component-name = "partner"
definition {

	property test.group = "mdfRequest";
	property testray.main.component.name = "partner";

	static var mdfClaimID = "";
	static var mdfRequestID = "";
	var partnerMDFRequestCompanyName = PropsUtil.get("partner.company");
	var partnerMDFRequestGlobalPartnerMarketing = PropsUtil.get("partner.name.global_partner_marketing");
	var partnerMDFRequestRegion = PropsUtil.get("partner.region");
	var partnerRegionCode = PropsUtil.get("partner.region.code");

	setUp {
		Partner.loginUser(roleName = "admin");

		var mdfRequestID = PartnerWorkflow.createMDFRequest(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "USD",
			partnerMDFRequestFundingPeriod = "Q1-Q2 2020",
			partnerMDFRequestPhoneNumber = "123 456 7890",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerWorkflow.approveMDFRequest(partnerMDFRequestID = "${mdfRequestID}");
	}

	tearDown {
		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${mdfRequestID}");
	}

	@priority = "5"
	test ApproveMDFClaim {
		var partnerMDFClaimActivities = "Test Activity1, Test Activity2";
		var partnerMDFClaimAmountClaimed = "USD 100";
		var partnerMDFClaimAmountPaid = "USD 0";
		var partnerMDFClaimOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFClaimPaymentReceived = "USD 0";
		var partnerMDFClaimRegionalFinance = PropsUtil.get("partner.${partnerRegionCode}.name.regional_finance");
		var partnerMDFClaimStatus = "Approved";
		var partnerMDFClaimType = "Full";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Approved";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.approveMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");

		Partner.gotoManagementClaims();

		PartnerManagement.assertMDFClaim(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimAmountPaid = "${partnerMDFClaimAmountPaid}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPartner = "${partnerMDFRequestCompanyName}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerManagement.viewNoMDFClaimOptions(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Approved",
			mockMockRecipient = "${partnerMDFClaimOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		// LRQA-44688 Bug in MockMock prevents viewing this mail

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "Your Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;Your approved claim and details about payment can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/claim/${mdfClaimID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;the following link:;${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Approved",
			mockMockRecipient = "${partnerMDFClaimRegionalFinance}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		//PartnerMockMock.viewMailMessage(

		// MockMockAsset = "A Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;Your approved claim and details about payment can be found at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}"

		//);

		PartnerMockMock.viewMailMessage(mockMockAsset = "Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;the following link:;${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "${partnerMDFClaimActivities}",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagementClaims();

		PartnerManagement.viewMDFClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerOptionsList = "Edit,Delete");
	}

	@priority = "5"
	test CreateMDFClaim {
		var partnerMDFClaimActivities = "Test Activity1, Test Activity2";
		var partnerMDFClaimAmountClaimed = "USD 100";
		var partnerMDFClaimAmountPaid = "USD 0";
		var partnerMDFClaimOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFClaimPaymentReceived = "USD 0";
		var partnerMDFClaimRegionalFinance = PropsUtil.get("partner.${partnerRegionCode}.name.regional_finance");
		var partnerMDFClaimStatus = "Finance Review";
		var partnerMDFClaimType = "Full";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Approved";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "${partnerMDFClaimActivities}",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Submitted",
			mockMockRecipient = "${partnerMDFClaimRegionalFinance}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund claim was [re]submitted.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Submitted",
			mockMockRecipient = "${partnerMDFRequestGlobalPartnerMarketing}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund claim was [re]submitted.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "regional_finance");

		Partner.gotoManagementClaims();

		PartnerManagement.assertMDFClaim(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimAmountPaid = "${partnerMDFClaimAmountPaid}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPartner = "${partnerMDFRequestCompanyName}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerManagement.viewMDFClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerNoOptionsList = "Delete",
			partnerOptionsList = "Edit");

		PartnerManagement.clickMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		Partner.pause(pauseTime = "2000");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagementClaims();

		PartnerManagement.viewMDFClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerOptionsList = "Edit,Delete");
	}

	@priority = "5"
	test CreateMDFClaims {
		var partnerMDFClaimAmountClaimed = "USD 50";
		var partnerMDFClaimAmountPaid = "USD 0";
		var partnerMDFClaimPaymentReceived = "USD 0";
		var partnerMDFClaimStatus = "Finance Review";
		var partnerMDFClaimType = "Partial";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Approved";
		var partnerMDFRequestTotalCost = "USD 200";

		PartnerWorkflow.createMDFClaimsPartial(partnerMDFRequestID = "${mdfRequestID}");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "Test Activity1",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "Test Activity2",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimNumber = "1",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimNumber = "2",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimNumber = "1");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.clickBackArrow();

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimNumber = "2");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");
	}

	@priority = "5"
	test EditAndSubmitMDFClaim {
		var partnerMDFClaimActivities = "Test Activity1, Test Activity2";
		var partnerMDFClaimAmountClaimed = "USD 100";
		var partnerMDFClaimAmountPaid = "USD 0";
		var partnerMDFClaimOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFClaimPaymentReceived = "USD 0";
		var partnerMDFClaimRegionalFinance = PropsUtil.get("partner.${partnerRegionCode}.name.regional_finance");
		var partnerMDFClaimStatus = "Finance Review";
		var partnerMDFClaimType = "Full";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Approved";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.requestMoreInfoMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerWorkflow.editAndSubmitMDFClaim(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");

		Partner.assertComment(partnerComment = "Adding an Edit as Partner.");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Submitted",
			mockMockRecipient = "${partnerMDFClaimRegionalFinance}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund claim was [re]submitted.;The requester's comment was:;Adding an Edit as Partner.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Submitted",
			mockMockRecipient = "${partnerMDFRequestGlobalPartnerMarketing}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A Marketing Development Fund claim was [re]submitted.;The requester's comment was:;Adding an Edit as Partner.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "${partnerMDFClaimActivities}",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Requesting for More Info by Global Partner Marketing.");

		Partner.assertComment(partnerComment = "Adding an Edit as Partner.");
	}

	@priority = "5"
	test PayoutMDFClaim {
		var partnerMDFClaimActivities = "Test Activity1, Test Activity2";
		var partnerMDFClaimAmountClaimed = "USD 100";
		var partnerMDFClaimAmountPaid = "USD 100";
		var partnerMDFClaimOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerMDFClaimPaymentReceived = "USD 100";
		var partnerMDFClaimRegionalFinance = PropsUtil.get("partner.${partnerRegionCode}.name.regional_finance");
		var partnerMDFClaimStatus = "Claim Paid";
		var partnerMDFClaimType = "Full";
		var partnerMDFRequestAmountApproved = "USD 100";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Completed";
		var partnerMDFRequestTotalCost = "USD 200";
		var mdfClaimID = PartnerWorkflow.createMDFClaimFull(partnerMDFRequestID = "${mdfRequestID}");

		PartnerWorkflow.approveMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerWorkflow.payoutMDFClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");

		Partner.gotoManagementClaims();

		Partner.gotoTab(tabName = "Completed");

		PartnerManagement.assertMDFClaim(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimAmountPaid = "${partnerMDFClaimAmountPaid}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPartner = "${partnerMDFRequestCompanyName}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerManagement.viewNoMDFClaimOptions(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] MDF Claim Paid",
			mockMockRecipient = "${partnerMDFClaimOwner}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "A check has been sent for your Marketing Development Fund claim.;The claim can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/claim/${mdfClaimID}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		Partner.gotoTab(tabName = "Completed");

		PartnerMarketingMDF.assertMDFRequest(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestID = "${mdfRequestID}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertSummary(
			partnerMDFRequestAmountApproved = "${partnerMDFRequestAmountApproved}",
			partnerMDFRequestAmountRequested = "${partnerMDFRequestAmountRequested}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestStatus = "${partnerMDFRequestStatus}",
			partnerMDFRequestTotalCost = "${partnerMDFRequestTotalCost}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "${partnerMDFClaimActivities}",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		Partner.assertComment(partnerComment = "Approved by Global Partner Marketing.");

		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagementClaims();

		PartnerManagement.viewNoMDFClaimOptions(partnerMDFClaimID = "${mdfClaimID}");
	}

	@priority = "5"
	test PayoutMDFClaims {
		var partnerMDFClaimAmountClaimed = "USD 50";
		var partnerMDFClaimAmountPaid = "USD 50";
		var partnerMDFClaimPaymentReceived = "USD 50";
		var partnerMDFClaimStatus = "Claim Paid";
		var partnerMDFClaimType = "Partial";
		var partnerMDFRequestAmountApproved = "USD 100";
		var partnerMDFRequestAmountRequested = "USD 100";
		var partnerMDFRequestFundingPeriod = "Q1-Q2 2020";
		var partnerMDFRequestStatus = "Completed";
		var partnerMDFRequestTotalCost = "USD 200";

