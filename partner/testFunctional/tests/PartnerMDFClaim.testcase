<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<var name="mdfClaimID" static="true" />
	<var name="mdfRequestID" static="true" />

	<var method="PropsUtil#get('partner.company')" name="partnerMDFRequestCompanyName" />
	<var method="PropsUtil#get('partner.name.global_partner_marketing')" name="partnerMDFRequestGlobalPartnerMarketing" />
	<var method="PropsUtil#get('partner.region')" name="partnerMDFRequestRegion" />
	<var method="PropsUtil#get('partner.region.code')" name="partnerRegionCode" />

	<set-up>
		<execute macro="Partner#loginUser">
			<var name="roleName" value="admin" />
		</execute>

		<execute macro="PartnerWorkflow#createMDFRequest">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
			<return name="mdfRequestID" />
		</execute>

		<execute macro="PartnerWorkflow#approveMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>
	</tear-down>

	<command name="ApproveMDFClaim" priority="5">
		<var name="partnerMDFClaimActivities" value="Test Activity1, Test Activity2" />
		<var name="partnerMDFClaimAmountClaimed" value="USD 100" />
		<var name="partnerMDFClaimAmountPaid" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.partner')" name="partnerMDFClaimOwner" />
		<var name="partnerMDFClaimPaymentReceived" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.regional_finance')" name="partnerMDFClaimRegionalFinance" />
		<var name="partnerMDFClaimStatus" value="Approved" />
		<var name="partnerMDFClaimType" value="Full" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestStatus" value="Approved" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFClaimFull">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<return name="mdfClaimID" />
		</execute>

		<execute macro="PartnerWorkflow#approveMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Approved by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#assertMDFClaim">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimAmountPaid" value="${partnerMDFClaimAmountPaid}" />
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimPartner" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerManagement#viewNoMDFClaimOptions">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertReimbursementClaim">
			<var name="partnerMDFClaimActivities" value="${partnerMDFClaimActivities}" />
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaimOptions">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerNoOptionsList" value="Edit,Delete" />
			<var name="partnerOptionsList" value="View" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Approved by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#viewMDFClaimOptions">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerOptionsList" value="Edit,Delete" />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Claim Approved" />
			<var name="mockMockRecipient" value="${partnerMDFClaimOwner}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Your Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;Your approved claim and details about payment can be found at the following link:;https://partner.liferay.com/mdf/-/mdf/claim/${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Claim Approved" />
			<var name="mockMockRecipient" value="${partnerMDFClaimRegionalFinance}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Your Marketing Development Fund claim has been approved.;The reviewer's comment was:;Approved by Global Partner Marketing.;Your approved claim and details about payment can be found at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="CreateMDFClaim" priority="5">
		<var name="partnerMDFClaimActivities" value="Test Activity1, Test Activity2" />
		<var name="partnerMDFClaimAmountClaimed" value="USD 100" />
		<var name="partnerMDFClaimAmountPaid" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.partner')" name="partnerMDFClaimOwner" />
		<var name="partnerMDFClaimPaymentReceived" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.regional_finance')" name="partnerMDFClaimRegionalFinance" />
		<var name="partnerMDFClaimStatus" value="Finance Review" />
		<var name="partnerMDFClaimType" value="Full" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestStatus" value="Approved" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFClaimFull">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<return name="mdfClaimID" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertReimbursementClaim">
			<var name="partnerMDFClaimActivities" value="${partnerMDFClaimActivities}" />
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaimOptions">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerNoOptionsList" value="Edit,Delete" />
			<var name="partnerOptionsList" value="View" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#assertMDFClaim">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimAmountPaid" value="${partnerMDFClaimAmountPaid}" />
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimPartner" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerManagement#viewMDFClaimOptions">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerNoOptionsList" value="Delete" />
			<var name="partnerOptionsList" value="Edit" />
		</execute>

		<execute macro="PartnerManagement#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#viewMDFClaimOptions">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerOptionsList" value="Edit,Delete" />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Claim Submitted" />
			<var name="mockMockRecipient" value="${partnerMDFClaimRegionalFinance}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Regional Finance,;A Marketing Development Fund claim was [re]submitted for review and payment.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="[Liferay Partner Portal] MDF Claim Submitted" />
			<var name="mockMockRecipient" value="${partnerMDFRequestGlobalPartnerMarketing}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Dear Global Partner Marketing,;A Marketing Development Fund claim was [re]submitted.;Please review the claim at the following link:;https://partner.liferay.com/mdf-claim-manager/-/mdf-claim-manager/claim/${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="CreateMDFClaims" priority="5">
		<var name="partnerMDFClaimAmountClaimed" value="USD 50" />
		<var name="partnerMDFClaimAmountPaid" value="USD 0" />
		<var name="partnerMDFClaimPaymentReceived" value="USD 0" />
		<var name="partnerMDFClaimStatus" value="Finance Review" />
		<var name="partnerMDFClaimType" value="Partial" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestStatus" value="Approved" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFClaimsPartial">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertReimbursementClaim">
			<var name="partnerMDFClaimActivities" value="Test Activity1" />
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertReimbursementClaim">
			<var name="partnerMDFClaimActivities" value="Test Activity2" />
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaimOptions">
			<var name="partnerMDFClaimNumber" value="1" />
			<var name="partnerNoOptionsList" value="Edit,Delete" />
			<var name="partnerOptionsList" value="View" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaimOptions">
			<var name="partnerMDFClaimNumber" value="2" />
			<var name="partnerNoOptionsList" value="Edit,Delete" />
			<var name="partnerOptionsList" value="View" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimNumber" value="1" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#clickBackArrow" />

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimNumber" value="2" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>
	</command>

	<command name="EditAndSubmitMDFClaim" priority="5">
		<var name="partnerMDFClaimActivities" value="Test Activity1, Test Activity2" />
		<var name="partnerMDFClaimAmountClaimed" value="USD 100" />
		<var name="partnerMDFClaimAmountPaid" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.partner')" name="partnerMDFClaimOwner" />
		<var name="partnerMDFClaimPaymentReceived" value="USD 0" />
		<var method="PropsUtil#get('partner.${partnerRegionCode}.name.regional_finance')" name="partnerMDFClaimRegionalFinance" />
		<var name="partnerMDFClaimStatus" value="Finance Review" />
		<var name="partnerMDFClaimType" value="Full" />
		<var name="partnerMDFRequestAmountRequested" value="USD 100" />
		<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
		<var name="partnerMDFRequestStatus" value="Approved" />
		<var name="partnerMDFRequestTotalCost" value="USD 200" />

		<execute macro="PartnerWorkflow#createMDFClaimFull">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<return name="mdfClaimID" />
		</execute>

		<execute macro="PartnerWorkflow#requestMoreInfoMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerWorkflow#editAndSubmitMDFClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Adding an Edit as Partner." />
		</execute>

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="PartnerMarketingMDF#assertMDFRequest">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFRequestAmountRequested" value="${partnerMDFRequestAmountRequested}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
			<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
			<var name="partnerMDFRequestTotalCost" value="${partnerMDFRequestTotalCost}" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${mdfRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#assertReimbursementClaim">
			<var name="partnerMDFClaimActivities" value="${partnerMDFClaimActivities}" />
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimID" value="${mdfClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#assertSummary">
			<var name="partnerMDFClaimAmountClaimed" value="${partnerMDFClaimAmountClaimed}" />
			<var name="partnerMDFClaimPaymentReceived" value="${partnerMDFClaimPaymentReceived}" />
			<var name="partnerMDFClaimStatus" value="${partnerMDFClaimStatus}" />
			<var name="partnerMDFClaimType" value="${partnerMDFClaimType}" />
		</execute>

		<execute macro="Partner#assertComment">
			<var name="partnerComment" value="Requesting for More Info by Global Partner Marketing." />
