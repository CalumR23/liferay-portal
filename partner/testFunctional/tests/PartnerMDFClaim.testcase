		var mdfClaimID = Partner.readTitleID();

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		Partner.clickEditButton();

		PartnerMDFClaimForm.deleteInvoiceUpload();

		PartnerMDFClaimForm.uploadInvoice(partnerMDFClaimInvoice = "Document_1.doc");

		PartnerMDFClaimForm.uploadActivityPOPs(
			partnerMDFClaimActivity = "Test Activity1",
			partnerMDFClaimLabels = "Images");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${mdfRequestID}");

		PartnerMDFRequest.assertReimbursementClaim(
			partnerMDFClaimActivities = "${partnerMDFClaimActivities}",
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimID = "${mdfClaimID}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");

		PartnerMDFRequest.viewReimbursementClaimOptions(
			partnerMDFClaimID = "${mdfClaimID}",
			partnerNoOptionsList = "Edit,Delete",
			partnerOptionsList = "View");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${mdfClaimID}");

		PartnerMDFClaim.assertSummary(
			partnerMDFClaimAmountClaimed = "${partnerMDFClaimAmountClaimed}",
			partnerMDFClaimPaymentReceived = "${partnerMDFClaimPaymentReceived}",
			partnerMDFClaimStatus = "${partnerMDFClaimStatus}",
			partnerMDFClaimType = "${partnerMDFClaimType}");
	}

}