<definition component-name="partner">
	<property name="testray.main.component.name" value="partner" />

	<command known-issues="true" name="AddPartnerOpportunity" priority="5">
		<var name="partnerOpportunityCustomerEmailAddress" value="test@liferay.com" />
		<var name="partnerOpportunityCustomerFirstName" value="Test" />
		<var name="partnerOpportunityCustomerLastName" value="Test" />
		<var name="partnerOpportunityOwner" value="Johnnie Stubbs" />
		<var name="partnerOpportunityPartnerAccount" value="Valamis Inc." />
		<var name="partnerOpportunityProspectAccountName" value="Deathray Inc - Test" />
		<var name="partnerOpportunityProspectCountry" value="United States" />
		<var name="partnerOpportunityProspectIndustry" value="Aerospace &amp; Defense" />
		<var name="salesforceAccountName" value="Deathray Inc - Test" />
		<var name="salesforceOpportunityName" value="Deathray Inc - Test" />
		<var name="salesforceProjectName" value="Deathray Project" />

		<execute macro="PartnerWorkflow#createPartnerOpportunity">
			<var name="partnerOpportunityCustomerEmailAddress" value="${partnerOpportunityCustomerEmailAddress}" />
			<var name="partnerOpportunityCustomerFirstName" value="${partnerOpportunityCustomerFirstName}" />
			<var name="partnerOpportunityCustomerLastName" value="${partnerOpportunityCustomerLastName}" />
			<var name="partnerOpportunityPartnerAccount" value="${partnerOpportunityPartnerAccount}" />
			<var name="partnerOpportunityProspectAccountName" value="${partnerOpportunityProspectAccountName}" />
			<var name="partnerOpportunityProspectCountry" value="${partnerOpportunityProspectCountry}" />
			<var name="partnerOpportunityProspectIndustry" value="${partnerOpportunityProspectIndustry}" />
		</execute>

		<execute macro="PartnerOpportunities#assertOpportunity">
			<var name="partnerOpportunityAccountName" value="${partnerOpportunityProspectAccountName}" />
			<var name="partnerOpportunityOwner" value="Johnnie Stubbs" />
			<var name="partnerOpportunityStage" value="Pending Review" />
		</execute>

		<execute macro="SalesforceLogin#loginUser">
			<var name="roleName" value="sales3" />
		</execute>

		<execute macro="SalesforceNavigation#gotoLeads" />

		<execute macro="SalesforceLeads#selectView">
			<var name="salesforceLeadsView" value="Partner Registered Leads Queue" />
		</execute>

		<execute macro="SalesforceLeads#clickFirstRecentLead" />

		<execute macro="SalesforceLeads#convertLead">
			<var name="salesforceAccountName" value="Deathray Inc - Test" />
			<var name="salesforceLeadPriority" value="Normal" />
			<var name="salesforceLeadStatus" value="In Progress" />
			<var name="salesforceTaskActivityCurrency" value="USD - U.S. Dollar" />
			<var name="salesforceTaskSubject" value="Call" />
		</execute>

		<execute macro="SalesforceAccount#viewAccountDetails">
			<var name="salesforceAccountName" value="Deathray Inc - Test" />
			<var name="salesforceAccountOwner" value="Sales QA" />
		</execute>

		<execute macro="Salesforce#addAndSyncProductsViaPartnerOpportunity">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Justification / Vendor Selection" />
			<var name="salesforceOpportunityName" value="${salesforceOpportunityName}" />
			<var name="salesforcePriceBook" value="[Current] USD - DXP Subscription and Services" />
			<var name="salesforceProductDate" value="1/1/2018" />
			<var name="salesforceProductEndDate" value="12/31/2018" />
			<var name="salesforceProductName" value="Liferay DXP Subscription - Gold Backup Sizing 1" />
			<var name="salesforceProductSalesPrice" value="11,750.00" />
			<var name="salesforceProductTermType" value="Annual" />
			<var name="salesforceProductType" value="New" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Justification / Vendor Selection" />
		</execute>

		<execute macro="SalesforceOpportunity#editItemNoSave">
			<var name="salesforceOpportunityItemLabel" value="Type" />
			<var name="salesforceOpportunityItemValue" value="Existing Business" />
		</execute>

		<execute macro="SalesforceOpportunity#editItemNoSave">
			<var name="salesforceOpportunityItemLabel" value="Sold By [*]" />
			<var name="salesforceOpportunityItemValue" value="Liferay US" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Justification / Vendor Selection" />
			<var name="salesforceOpportunityStageDetail" value="Competing Against CE" />
		</execute>

		<execute macro="SalesforceOpportunity#assignProject">
			<var name="salesforceOpportunityProject" value="${salesforceProjectName}" />
		</execute>

		<execute macro="SalesforceOpportunity#clickPartnerOpportunity">
			<var name="salesforcePartnerOpportunityKeyword" value="Open" />
		</execute>

		<execute macro="SalesforcePartnerOpportunity#editStage">
			<var name="salesforcePartnerOpportunityStage" value="Closed Won" />
		</execute>

		<execute macro="SalesforceNavigation#gotoOpportunityWithinAccount">
			<var name="salesforceAccountName" value="${salesforceAccountName}" />
			<var name="salesforceOpportunityKeyword" value="Justification / Vendor Selection" />
		</execute>

		<execute macro="SalesforceOpportunity#editStage">
			<var name="salesforceOpportunityStage" value="Closed Won" />
			<var name="salesforceOpportunityTermType" value="Single Year" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoSalesPartnerOpportunities" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Closed" />
		</execute>

		<execute macro="PartnerOpportunities#selectAccountClosed">
			<var name="partnerOpportunityAccountName" value="Deathray Inc - Test" />
		</execute>

		<execute macro="PartnerOpportunities#assertOpportunity">
			<var name="partnerOpportunityAccountName" value="${partnerOpportunityProspectAccountName}" />
			<var name="partnerOpportunityOwner" value="Johnnie Stubbs" />
			<var name="partnerOpportunityStage" value="Closed" />
		</execute>

		<!--<execute macro="PartnerOpportunities#discardOpportunity">
			<var name="partnerOpportunityAccountName" value="${partnerOpportunityAccountName}" />
		</execute>-->

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="Partner Opportunity Registration" />
			<var name="mockMockRecipient" value="Partners Internal" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="Partner Opportunity;${partnerOpportunityPartnerAccount};${partnerOpportunityProspectAccountName};${partnerOpportunityCustomerFirstName} ${partnerOpportunityCustomerLastName};${partnerOpportunityCustomerEmailAddress};${partnerOpportunityProspectCountry}" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="RenewalOpportunityRequests" priority="5">
		<var name="partnerOpportunityAllianceManager" value="Salesforce Integration" />
		<var name="partnerOpportunityOwner" value="Johnnie Stubbs" />
		<var name="partnerRenewalOpportunityAccount" value="Deathray Inc - Test" />
		<var name="partnerRenewalOpportunityComment" value="Test" />

		<execute macro="Partner#loginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoSalesRenewalOpportunities" />

		<execute macro="PartnerRenewalOpportunities#clickRenewalOpportunity">
			<var name="partnerRenewalOpportunityAccount" value="${partnerRenewalOpportunityAccount}" />
		</execute>

		<execute macro="PartnerRenewalOpportunity#assertAccountName">
			<var name="partnerRenewalOpportunityAccount" value="${partnerRenewalOpportunityAccount}" />
		</execute>

		<execute macro="PartnerRenewalOpportunity#clickRequestOrderForm" />

		<execute macro="Partner#gotoSalesRenewalOpportunities" />

		<execute macro="PartnerRenewalOpportunities#assertRenewalOpportunity">
			<var name="partnerRenewalOpportunityAccount" value="${partnerRenewalOpportunityAccount}" />
			<var name="partnerRenewalOpportunityStage" value="Order Form Requested" />
		</execute>

		<execute macro="PartnerRenewalOpportunities#clickRenewalOpportunity">
			<var name="partnerRenewalOpportunityAccount" value="${partnerRenewalOpportunityAccount}" />
		</execute>

		<execute macro="PartnerRenewalOpportunity#clickRequestChange">
			<var name="partnerRenewalOpportunityComment" value="${partnerRenewalOpportunityComment}" />
		</execute>

		<execute macro="PartnerRenewalOpportunity#assertTimelineActivity">
			<var name="partnerRenewalOpportunityOrder" value="2" />
			<var name="partnerRenewalOpportunityTimelineActivity" value="Stage updated from Order Form Requested to Change Requested." />
		</execute>

		<execute macro="Partner#gotoSalesRenewalOpportunities" />

		<execute macro="PartnerRenewalOpportunities#assertRenewalOpportunity">
			<var name="partnerRenewalOpportunityAccount" value="${partnerRenewalOpportunityAccount}" />
			<var name="partnerRenewalOpportunityStage" value="Change Requested" />
		</execute>

		<execute macro="PartnerMockMock#gotoMockMock" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="Reseller Order Form Requested" />
			<var name="mockMockRecipient" value="${partnerOpportunityAllianceManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="${partnerOpportunityOwner} has requested a reseller order form for the Partner Opportunity associated with ${partnerRenewalOpportunityAccount};Please review the Partner Opportunity and generate the order form on Salesforce.com" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#viewAndClickMail">
			<var name="mockMockAsset" value="Change Requested" />
			<var name="mockMockRecipient" value="${partnerOpportunityAllianceManager}" />
			<var name="mockMockSender" value="Partner Portal Admin &lt;partner-portal-admin@liferay.com&gt;" />
		</execute>

		<execute macro="PartnerMockMock#viewMailMessage">
			<var name="mockMockAsset" value="${partnerOpportunityOwner} has submitted a request to make changes for the Partner Opportunity associated with ${partnerRenewalOpportunityAccount};Please review the Partner Opportunity activity feed and make the appropriate adjustments on Salesforce.com" />
		</execute>

		<execute macro="PartnerMockMock#backtoInbox" />

		<execute macro="PartnerMockMock#deleteAllMail" />
	</command>

	<command name="ViewOpportunitiesAsManager" priority="5">
		<var method="TestPropsUtil#get('partner.email.address.partner2')" name="partnerEmailAddress2" />
		<var name="partnerOpportunityAccountName" value="Arcusys" />

		<execute macro="Partner#loginUser">
			<var name="roleName" value="partner2" />
		</execute>

		<execute macro="Partner#gotoSalesPartnerOpportunities" />

		<execute macro="PartnerOpportunities#assertNoAccountDropdown" />

		<execute macro="OSBAdminUser#login">
			<var name="liferayURL" value="https://web-uat.liferay.com" />
			<var name="userEmailAddress" value="ryan.park@liferay.com.broken" />
			<var name="userPassword" value="test" />
		</execute>

		<execute macro="Partner#openSpecificURL">
			<var name="url" value="https://web-uat.liferay.com/group/control_panel" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminPartner#assignWorker">
			<var name="emailAddress" value="${partnerEmailAddress2}" />
			<var name="partnerCode" value="${partnerOpportunityAccountName}" />
			<var name="role" value="Manager" />
		</execute>

		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner2" />
		</execute>

		<execute macro="Partner#gotoSalesPartnerOpportunities" />

		<execute macro="PartnerOpportunities#assertAccountDropdown" />

		<execute macro="PartnerOpportunities#selectAccount">
			<var name="partnerOpportunityAccountName" value="${partnerOpportunityAccountName}" />
		</execute>

		<execute macro="Partner#openSpecificURL">
			<var name="url" value="https://web-uat.liferay.com/group/control_panel" />
		</execute>

		<execute macro="OSBAdminNavigation#gotoOSBAdmin" />

		<execute macro="OSBAdminPartner#assignWorker">
			<var name="emailAddress" value="${partnerEmailAddress2}" />
			<var name="partnerCode" value="${partnerOpportunityAccountName}" />
			<var name="role" value="Watcher" />
		</execute>
	</command>
</definition>