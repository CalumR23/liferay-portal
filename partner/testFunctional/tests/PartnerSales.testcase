@component-name = "partner"
definition {

	property test.group = "sales";
	property testray.main.component.name = "partner";

	var partnerCompany = PropsUtil.get("partner.company");
	var partnerOpportunityProspectCountry = PropsUtil.get("partner.region");
	var partnerRegionCode = PropsUtil.get("partner.region.code");

	setUp {
		Partner.loginUser(roleName = "admin");
	}

	@priority = "5"
	test AddPartnerOpportunity {
		property inactive = "true";

		var partnerOpportunityCustomerEmailAddress = "test@liferay.com";
		var partnerOpportunityCustomerFirstName = "Test";
		var partnerOpportunityCustomerLastName = "Test";
		var partnerOpportunityOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerOpportunityPartnerAccount = "${partnerCompany}";
		var partnerOpportunityProspectAccountName = "Deathray Inc - Test";
		var partnerOpportunityProspectIndustry = "Aerospace & Defense";
		var salesforceAccountName = "Deathray Inc - Test";
		var salesforceOpportunityName = "Deathray Inc - Test";
		var salesforceProjectName = "Deathray Project";

		PartnerWorkflow.createPartnerOpportunity(
			partnerOpportunityCustomerEmailAddress = "${partnerOpportunityCustomerEmailAddress}",
			partnerOpportunityCustomerFirstName = "${partnerOpportunityCustomerFirstName}",
			partnerOpportunityCustomerLastName = "${partnerOpportunityCustomerLastName}",
			partnerOpportunityPartnerAccount = "${partnerOpportunityPartnerAccount}",
			partnerOpportunityProspectAccountName = "${partnerOpportunityProspectAccountName}",
			partnerOpportunityProspectCountry = "${partnerOpportunityProspectCountry}",
			partnerOpportunityProspectIndustry = "${partnerOpportunityProspectIndustry}");

		PartnerOpportunities.assertOpportunity(
			partnerOpportunityAccountName = "${partnerOpportunityProspectAccountName}",
			partnerOpportunityOwner = "${partnerOpportunityOwner}",
			partnerOpportunityStage = "Pending Review");

		SalesforceLogin.loginUser(roleName = "sales3");

		SalesforceNavigation.gotoLeads();

		SalesforceLeads.selectView(salesforceLeadsView = "Partner Registered Leads Queue");

		SalesforceLeads.clickFirstRecentLead();

		SalesforceLeads.convertLead(
			salesforceAccountName = "Deathray Inc - Test",
			salesforceLeadPriority = "Normal",
			salesforceLeadStatus = "In Progress",
			salesforceTaskActivityCurrency = "USD - U.S. Dollar",
			salesforceTaskSubject = "Call");

		SalesforceAccount.viewAccountDetails(
			salesforceAccountName = "Deathray Inc - Test",
			salesforceAccountOwner = "Sales QA");

		Salesforce.addAndSyncProductsViaPartnerOpportunity(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Justification / Vendor Selection",
			salesforceOpportunityName = "${salesforceOpportunityName}",
			salesforcePriceBook = "[Current] USD - DXP Subscription and Services",
			salesforceProductDate = "1/1/2019",
			salesforceProductEndDate = "12/31/2019",
			salesforceProductName = "Liferay DXP Subscription - Gold Backup Sizing 1",
			salesforceProductSalesPrice = "11,750.00",
			salesforceProductTermType = "Annual",
			salesforceProductType = "New");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Justification / Vendor Selection");

		SalesforceOpportunity.editItemNoSave(
			salesforceOpportunityItemLabel = "Type",
			salesforceOpportunityItemValue = "Existing Business");

		SalesforceOpportunity.editItemNoSave(
			salesforceOpportunityItemLabel = "Sold By [*]",
			salesforceOpportunityItemValue = "Liferay US");

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Justification / Vendor Selection",
			salesforceOpportunityStageDetail = "Competing Against CE");

		SalesforceOpportunity.assignProject(salesforceOpportunityProject = "${salesforceProjectName}");

		SalesforceOpportunity.clickPartnerOpportunity(salesforcePartnerOpportunityKeyword = "Open");

		SalesforcePartnerOpportunity.editStage(salesforcePartnerOpportunityStage = "Closed Won");

		SalesforceNavigation.gotoOpportunityWithinAccount(
			salesforceAccountName = "${salesforceAccountName}",
			salesforceOpportunityKeyword = "Justification / Vendor Selection");

		SalesforceOpportunity.editStage(
			salesforceOpportunityStage = "Closed Won",
			salesforceOpportunityTermType = "Single Year");

		Partner.openURL();

		Partner.gotoSalesPartnerOpportunities(roleName = "partner");

		Partner.gotoTab(tabName = "Closed");

		PartnerOpportunities.selectAccountClosed(partnerOpportunityAccountName = "Deathray Inc - Test");

		PartnerOpportunities.assertOpportunity(
			partnerOpportunityAccountName = "${partnerOpportunityProspectAccountName}",
			partnerOpportunityOwner = "${partnerOpportunityOwner}",
			partnerOpportunityStage = "Closed");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "Partner Opportunity Registration",
			mockMockRecipient = "Partners Internal",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "Partner Opportunity;${partnerOpportunityPartnerAccount};${partnerOpportunityProspectAccountName};${partnerOpportunityCustomerFirstName} ${partnerOpportunityCustomerLastName};${partnerOpportunityCustomerEmailAddress};${partnerOpportunityProspectCountry}");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();
	}

	@priority = "5"
	test RenewalOpportunityRequests {
		property inactive = "true";

		var partnerOpportunityAllianceManager = "Salesforce Integration";
		var partnerOpportunityOwner = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerRenewalOpportunityAccount = "Deathray Inc - Test";
		var partnerRenewalOpportunityComment = "Test";

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoSalesRenewalOpportunities(roleName = "partner");

		PartnerRenewalOpportunities.clickRenewalOpportunity(partnerRenewalOpportunityAccount = "${partnerRenewalOpportunityAccount}");

		PartnerRenewalOpportunity.assertAccountName(partnerRenewalOpportunityAccount = "${partnerRenewalOpportunityAccount}");

		PartnerRenewalOpportunity.clickRequestOrderForm();

		Partner.gotoSalesRenewalOpportunities(roleName = "partner");

		PartnerRenewalOpportunities.assertRenewalOpportunity(
			partnerRenewalOpportunityAccount = "${partnerRenewalOpportunityAccount}",
			partnerRenewalOpportunityStage = "Order Form Requested");

		PartnerRenewalOpportunities.clickRenewalOpportunity(partnerRenewalOpportunityAccount = "${partnerRenewalOpportunityAccount}");

		PartnerRenewalOpportunity.clickRequestChange(partnerRenewalOpportunityComment = "${partnerRenewalOpportunityComment}");

		PartnerRenewalOpportunity.assertTimelineActivity(
			partnerRenewalOpportunityOrder = "2",
			partnerRenewalOpportunityTimelineActivity = "Stage updated from Order Form Requested to Change Requested.");

		Partner.gotoSalesRenewalOpportunities(roleName = "partner");

		PartnerRenewalOpportunities.assertRenewalOpportunity(
			partnerRenewalOpportunityAccount = "${partnerRenewalOpportunityAccount}",
			partnerRenewalOpportunityStage = "Change Requested");

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "Reseller Order Form Requested",
			mockMockRecipient = "${partnerOpportunityAllianceManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "${partnerOpportunityOwner} has requested a reseller order form for the Partner Opportunity associated with ${partnerRenewalOpportunityAccount};Please review the Partner Opportunity and generate the order form on Salesforce.com");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "Change Requested",
			mockMockRecipient = "${partnerOpportunityAllianceManager}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "${partnerOpportunityOwner} has submitted a request to make changes for the Partner Opportunity associated with ${partnerRenewalOpportunityAccount};Please review the Partner Opportunity activity feed and make the appropriate adjustments on Salesforce.com");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();
	}

	@priority = "5"
	test UpdateRebatePayment {
		var partnerRebatePaymentBankAccountName = "Test Account";
		var partnerRebatePaymentBankAccountNumber = "1234567890";
		var partnerRebatePaymentBankCity = "Diamond Bar";
		var partnerRebatePaymentBankCode = "TB";
		var partnerRebatePaymentBankCountry = "United States";
		var partnerRebatePaymentBankName = "Test Bank";
		var partnerRebatePaymentBankRegion = "California";
		var partnerRebatePaymentBankStreet = "1400 Montefino Ave";
		var partnerRebatePaymentBankZip = "91765";
		var partnerRebatePaymentLeadContactUser1 = PropsUtil.get("partner.${partnerRegionCode}.name.partner");
		var partnerRebatePaymentLeadContactUser2 = PropsUtil.get("partner.${partnerRegionCode}.name.partner2");
		var partnerRebatePaymentPartnerCity = "Diamond Bar";
		var partnerRebatePaymentPartnerCountry = "United States";
		var partnerRebatePaymentPartnerRegion = "California";
		var partnerRebatePaymentPartnerStreet = "1400 Montefino Ave";
		var partnerRebatePaymentPartnerZip = "91765";
		var partnerRebatePaymentRebateMethod1 = "Liferay Credit Note";
		var partnerRebatePaymentRebateMethod2 = "Partner Invoice";
		var partnerRegionalFinance = PropsUtil.get("partner.${partnerRegionCode}.name.regional_finance");

		Partner.gotoSalesRebatePayment(roleName = "partner");

		PartnerRebatePaymentForm.assertRebatePaymentPartner(partnerRebatePaymentPartner = "${partnerCompany}");

		PartnerRebatePaymentForm.fillPartnerInformation(
			partnerRebatePaymentPartnerCity = "${partnerRebatePaymentPartnerCity}",
			partnerRebatePaymentPartnerCountry = "${partnerRebatePaymentPartnerCountry}",
			partnerRebatePaymentPartnerRegion = "${partnerRebatePaymentPartnerRegion}",
			partnerRebatePaymentPartnerStreet = "${partnerRebatePaymentPartnerStreet}",
			partnerRebatePaymentPartnerZip = "${partnerRebatePaymentPartnerZip}");

		PartnerRebatePaymentForm.selectLeadContactUser(partnerRebatePaymentLeadContactUser = "${partnerRebatePaymentLeadContactUser1}");

		PartnerRebatePaymentForm.clickRebateMethod(partnerRebatePaymentRebateMethod = "${partnerRebatePaymentRebateMethod1}");

		PartnerRebatePaymentForm.fillPartnerBankAccount(
			partnerRebatePaymentBankAccountName = "${partnerRebatePaymentBankAccountName}",
			partnerRebatePaymentBankAccountNumber = "${partnerRebatePaymentBankAccountNumber}",
			partnerRebatePaymentBankCity = "${partnerRebatePaymentBankCity}",
			partnerRebatePaymentBankCode = "${partnerRebatePaymentBankCode}",
			partnerRebatePaymentBankCountry = "${partnerRebatePaymentBankCountry}",
			partnerRebatePaymentBankName = "${partnerRebatePaymentBankName}",
			partnerRebatePaymentBankRegion = "${partnerRebatePaymentBankRegion}",
			partnerRebatePaymentBankStreet = "${partnerRebatePaymentBankStreet}",
			partnerRebatePaymentBankZip = "${partnerRebatePaymentBankZip}");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		PartnerMockMock.gotoMockMock();

		PartnerMockMock.viewAndClickMail(
			mockMockAsset = "[Liferay Partner Portal] Rebate Payment Form Updated",
			mockMockRecipient = "${partnerRegionalFinance}",
			mockMockSender = "Partner Portal Admin <partner-portal-admin@liferay.com>");

		PartnerMockMock.viewMailMessage(mockMockAsset = "${partnerCompany};updated their Rebate Payment Form;You can view their changes at the following link:;https://partner.liferay.com/sales/rebate-payment/-/rebate-payment-account/");

		PartnerMockMock.backtoInbox();

		PartnerMockMock.deleteAllMail();

		Partner.gotoSalesRebatePayment(roleName = "regional_finance");

		PartnerRebatePayments.assertRebatePaymentPartner(partnerRebatePaymentPartner = "${partnerCompany}");

		PartnerRebatePayments.clickRebatePaymentPartner(partnerRebatePaymentPartner = "${partnerCompany}");

		PartnerRebatePaymentForm.assertRebatePaymentPartner(partnerRebatePaymentPartner = "${partnerCompany}");

		PartnerRebatePaymentForm.assertPartnerInformation(
			partnerRebatePaymentPartnerCity = "${partnerRebatePaymentPartnerCity}",
			partnerRebatePaymentPartnerCountry = "${partnerRebatePaymentPartnerCountry}",
			partnerRebatePaymentPartnerRegion = "${partnerRebatePaymentPartnerRegion}",
			partnerRebatePaymentPartnerStreet = "${partnerRebatePaymentPartnerStreet}",
			partnerRebatePaymentPartnerZip = "${partnerRebatePaymentPartnerZip}");

		PartnerRebatePaymentForm.assertRebateMethod(partnerRebatePaymentRebateMethod = "${partnerRebatePaymentRebateMethod1}");

		PartnerRebatePaymentForm.assertLeadContactUser(partnerRebatePaymentLeadContactUser = "${partnerRebatePaymentLeadContactUser1}");

		PartnerRebatePaymentForm.assertPartnerBankAccount(
			partnerRebatePaymentBankAccountName = "${partnerRebatePaymentBankAccountName}",
			partnerRebatePaymentBankAccountNumber = "${partnerRebatePaymentBankAccountNumber}",
			partnerRebatePaymentBankCity = "${partnerRebatePaymentBankCity}",
			partnerRebatePaymentBankCode = "${partnerRebatePaymentBankCode}",
			partnerRebatePaymentBankCountry = "${partnerRebatePaymentBankCountry}",
			partnerRebatePaymentBankName = "${partnerRebatePaymentBankName}",
			partnerRebatePaymentBankRegion = "${partnerRebatePaymentBankRegion}",
			partnerRebatePaymentBankStreet = "${partnerRebatePaymentBankStreet}",
			partnerRebatePaymentBankZip = "${partnerRebatePaymentBankZip}");

		PartnerRebatePaymentForm.fillPartnerInformation(
			partnerRebatePaymentPartnerCity = "${partnerRebatePaymentPartnerCity}",
			partnerRebatePaymentPartnerCountry = "${partnerRebatePaymentPartnerCountry}",
			partnerRebatePaymentPartnerRegion = "${partnerRebatePaymentPartnerRegion}",
			partnerRebatePaymentPartnerStreet = "${partnerRebatePaymentPartnerStreet} Edit",
			partnerRebatePaymentPartnerZip = "${partnerRebatePaymentPartnerZip}");

		PartnerRebatePaymentForm.clickRebateMethod(partnerRebatePaymentRebateMethod = "${partnerRebatePaymentRebateMethod2}");

		PartnerRebatePaymentForm.selectLeadContactUser(partnerRebatePaymentLeadContactUser = "${partnerRebatePaymentLeadContactUser2}");

		PartnerRebatePaymentForm.fillPartnerBankAccount(
			partnerRebatePaymentBankAccountName = "${partnerRebatePaymentBankAccountName}",
			partnerRebatePaymentBankAccountNumber = "${partnerRebatePaymentBankAccountNumber}",
			partnerRebatePaymentBankCity = "${partnerRebatePaymentBankCity}",
			partnerRebatePaymentBankCode = "${partnerRebatePaymentBankCode}",
			partnerRebatePaymentBankCountry = "${partnerRebatePaymentBankCountry}",
			partnerRebatePaymentBankName = "${partnerRebatePaymentBankName} Edit",
			partnerRebatePaymentBankRegion = "${partnerRebatePaymentBankRegion}",
			partnerRebatePaymentBankStreet = "${partnerRebatePaymentBankStreet} Edit",
			partnerRebatePaymentBankZip = "${partnerRebatePaymentBankZip}");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		Partner.gotoSalesRebatePayment(roleName = "partner");

		PartnerRebatePaymentForm.assertRebatePaymentPartner(partnerRebatePaymentPartner = "${partnerCompany}");

		PartnerRebatePaymentForm.assertPartnerInformation(
			partnerRebatePaymentPartnerCity = "${partnerRebatePaymentPartnerCity}",
			partnerRebatePaymentPartnerCountry = "${partnerRebatePaymentPartnerCountry}",
			partnerRebatePaymentPartnerRegion = "${partnerRebatePaymentPartnerRegion}",
			partnerRebatePaymentPartnerStreet = "${partnerRebatePaymentPartnerStreet} Edit",
			partnerRebatePaymentPartnerZip = "${partnerRebatePaymentPartnerZip}");

		PartnerRebatePaymentForm.assertRebateMethod(partnerRebatePaymentRebateMethod = "${partnerRebatePaymentRebateMethod2}");

		PartnerRebatePaymentForm.assertLeadContactUser(partnerRebatePaymentLeadContactUser = "${partnerRebatePaymentLeadContactUser2}");

		PartnerRebatePaymentForm.assertPartnerBankAccount(
			partnerRebatePaymentBankAccountName = "${partnerRebatePaymentBankAccountName}",
			partnerRebatePaymentBankAccountNumber = "${partnerRebatePaymentBankAccountNumber}",
			partnerRebatePaymentBankCity = "${partnerRebatePaymentBankCity}",
			partnerRebatePaymentBankCode = "${partnerRebatePaymentBankCode}",
			partnerRebatePaymentBankCountry = "${partnerRebatePaymentBankCountry}",
			partnerRebatePaymentBankName = "${partnerRebatePaymentBankName} Edit",
			partnerRebatePaymentBankRegion = "${partnerRebatePaymentBankRegion}",
			partnerRebatePaymentBankStreet = "${partnerRebatePaymentBankStreet} Edit",
			partnerRebatePaymentBankZip = "${partnerRebatePaymentBankZip}");
	}

	@priority = "5"
	test ViewOpportunitiesAsManager {
		property inactive = "true";

		var partnerOpportunityAccountName = "${partnerCompany}";
		var partnerOpportunityEmailAddress = PropsUtil.get("partner.${partnerRegionCode}.email.address.partner");

		Partner.loginLiferay(
			specificURL = "https://web-uat.liferay.com/sign-in",
			userEmailAddress = "ryan.park@liferay.com.broken",
			userPassword = "test");

		Partner.openSpecificURL(url = "https://web-uat.liferay.com/group/control_panel");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminPartner.assignWorker(
			emailAddress = "${partnerOpportunityEmailAddress}",
			partnerCode = "${partnerOpportunityAccountName}",
			role = "Watcher");

		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoSalesPartnerOpportunities(roleName = "partner");

		PartnerOpportunities.assertNoAccountDropdown();

		Partner.openSpecificURL(url = "https://web-uat.liferay.com/group/control_panel");

		OSBAdminNavigation.gotoOSBAdmin();

		OSBAdminPartner.assignWorker(
			emailAddress = "${partnerOpportunityEmailAddress}",
			partnerCode = "${partnerOpportunityAccountName}",
			role = "Manager");

		Partner.gotoSalesPartnerOpportunities(roleName = "partner");

		PartnerOpportunities.assertAccountDropdown();

		PartnerOpportunities.selectAccount(partnerOpportunityAccountName = "${partnerOpportunityAccountName}");
	}

}