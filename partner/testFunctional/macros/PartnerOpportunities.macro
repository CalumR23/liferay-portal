<definition>
	<command name="assertAccountDropdown">
		<execute function="AssertElementPresent" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN" />
	</command>

	<command name="assertNoAccountDropdown">
		<execute function="AssertElementNotPresent" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN" />
	</command>

	<command name="assertOpportunity">
		<var name="key_partnerOpportunity" value="${partnerOpportunityAccountName}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerOpportunityAccountName}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_ACCOUNT" value1="${partnerOpportunityAccountName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_PARTNER_REP" value1="${partnerOpportunityOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_STAGE" value1="${partnerOpportunityStage}" />
	</command>

	<command name="clickAddOpportunityButton">
		<execute function="Click" locator1="PartnerOpportunities#ADD_OPPORTUNITY_BUTTON" />
	</command>

	<command name="clickOpportunity">
		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_ACCOUNT" />
	</command>

	<command name="discardOpportunity">
		<var name="key_option" value="Discard Opportunity" />
		<var name="key_partnerOpportunity" value="${partnerOpportunityAccountName}" />

		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="3000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="selectAccount">
		<var name="key_partnerOpportunity" value="${partnerOpportunityAccountName}" />

		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN" />

		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_OPTION" />
	</command>

	<command name="selectAccountClosed">
		<var name="key_partnerOpportunity" value="${partnerOpportunityAccountName}" />

		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_CLOSED" />

		<execute function="Click" locator1="PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_OPTION_CLOSED" />
	</command>
</definition>