definition {

	macro assertAccountDropdown {
		AssertElementPresent(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN");
	}

	macro assertNoAccountDropdown {
		AssertElementNotPresent(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN");
	}

	macro assertOpportunity {
		var key_partnerOpportunity = "${partnerOpportunityAccountName}";

		Partner.findRowID(rowID = "${partnerOpportunityAccountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_ACCOUNT",
			value1 = "${partnerOpportunityAccountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_PARTNER_REP",
			value1 = "${partnerOpportunityOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_STAGE",
			value1 = "${partnerOpportunityStage}");
	}

	macro clickAddOpportunityButton {
		Click(locator1 = "PartnerOpportunities#ADD_OPPORTUNITY_BUTTON");
	}

	macro clickOpportunity {
		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_ACCOUNT");
	}

	macro discardOpportunity {
		var key_option = "Discard Opportunity";
		var key_partnerOpportunity = "${partnerOpportunityAccountName}";

		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_OPTIONS");

		Click(locator1 = "Partner#DROPDOWN_OPTION");

		Partner.pause(pauseTime = "3000");

		Partner.assertSuccess();
	}

	macro selectAccount {
		var key_partnerOpportunity = "${partnerOpportunityAccountName}";

		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN");

		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_OPTION");
	}

	macro selectAccountClosed {
		var key_partnerOpportunity = "${partnerOpportunityAccountName}";

		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_CLOSED");

		Click(locator1 = "PartnerOpportunities#PARTNER_OPPORTUNITY_DROPDOWN_OPTION_CLOSED");
	}

}