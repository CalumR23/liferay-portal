<definition>
	<command name="assertAccountInformation">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_COMPANY" value1="${partnerBusinessPlanPartnerCompany}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_REGION" value1="${partnerBusinessPlanPartnerRegion}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_CURRENCY" value1="${partnerBusinessPlanPartnerCurrency}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_BUSINESS_PLAN_OWNER" value1="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER" value1="${partnerBusinessPlanPartnerMarketingPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER" value1="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER" value1="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT" value1="${partnerBusinessPlanLiferayRenewalContact}" />
	</command>

	<command name="assertSummary">
		<var method="StringUtil#upperCase('${partnerBusinessPlanStatus}')" name="partnerBusinessPlanStatus" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_STATUS" value1="${partnerBusinessPlanStatus}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_YEAR" value1="${partnerBusinessPlanYear}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_TOTAL_REVENUE_PROJECTIONS" value1="${partnerBusinessPlanTotalRevenueProjections}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlan#BUSINESS_PLAN_NUMBER_OF_GOALS" value1="${partnerBusinessPlanNumberOfGoals}" />
	</command>
</definition>