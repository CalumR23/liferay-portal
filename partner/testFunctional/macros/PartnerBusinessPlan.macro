definition {

	macro assertAccountInformation {
		var partnerBusinessPlanRegionCode = Partner.formatRegionCode(regionCode = "${partnerBusinessPlanRegionCode}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_COMPANY",
			value1 = "${partnerBusinessPlanCompany}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_REGION_CODE",
			value1 = "${partnerBusinessPlanRegionCode}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_CURRENCY",
			value1 = "${partnerBusinessPlanCurrency}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_BUSINESS_PLAN_OWNER",
			value1 = "${partnerBusinessPlanPartnerBusinessPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER",
			value1 = "${partnerBusinessPlanPartnerMarketingPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER",
			value1 = "${partnerBusinessPlanLiferayBusinessPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER",
			value1 = "${partnerBusinessPlanLiferayMarketingPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT",
			value1 = "${partnerBusinessPlanLiferayRenewalContact}");
	}

	macro assertSummary {
		var partnerBusinessPlanStatus = StringUtil.upperCase("${partnerBusinessPlanStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_STATUS",
			value1 = "${partnerBusinessPlanStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_YEAR",
			value1 = "${partnerBusinessPlanYear}");

		if ("${partnerBusinessPlanTotalRevenueProjections}" == "") {
			IsNotVisible(locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_TOTAL_REVENUE_PROJECTIONS");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_TOTAL_REVENUE_PROJECTIONS",
				value1 = "${partnerBusinessPlanTotalRevenueProjections}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlan#BUSINESS_PLAN_NUMBER_OF_GOALS",
			value1 = "${partnerBusinessPlanNumberOfGoals}");
	}

}