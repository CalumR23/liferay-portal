definition {

	macro assertNoSearchResult {
		var key_searchKeyword = "${partnerSearchKeyword}";

		AssertElementNotPresent(locator1 = "PartnerSearch#SEARCH_RESULT_ITEM_TITLE");
	}

	macro assertSearchResult {
		var key_searchKeyword = "${partnerSearchKeyword}";

		AssertElementPresent(locator1 = "PartnerSearch#SEARCH_RESULT_ITEM_TITLE");
	}

	macro searchKeyword {
		if (IsElementPresent(locator1 = "Partner#NAVBAR_SEARCH_ICON")) {
			Click(locator1 = "Partner#NAVBAR_SEARCH_ICON");
		}

		Type.sendKeys(
			locator1 = "Partner#NAVBAR_SEARCH",
			value1 = "${partnerSearchKeyword}");

		KeyPress(
			locator1 = "Partner#NAVBAR_SEARCH",
			value1 = "\ENTER");
	}

}