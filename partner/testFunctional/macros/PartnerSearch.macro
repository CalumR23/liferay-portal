<definition>
	<command name="assertNoSearchResult">
		<var name="key_searchKeyword" value="${partnerSearchKeyword}" />

		<execute function="AssertElementNotPresent" locator1="PartnerSearch#SEARCH_RESULT_ITEM_TITLE" />
	</command>

	<command name="assertSearchResult">
		<var name="key_searchKeyword" value="${partnerSearchKeyword}" />

		<execute function="AssertElementPresent" locator1="PartnerSearch#SEARCH_RESULT_ITEM_TITLE" />
	</command>

	<command name="searchKeyword">
		<if>
			<condition function="IsElementPresent" locator1="Partner#NAVBAR_SEARCH_ICON" />
			<then>
				<execute function="Click" locator1="Partner#NAVBAR_SEARCH_ICON" />
			</then>
		</if>

		<execute function="Type#sendKeys" locator1="Partner#NAVBAR_SEARCH" value1="${partnerSearchKeyword}" />

		<execute function="KeyPress" locator1="Partner#NAVBAR_SEARCH" value1="\ENTER" />
	</command>
</definition>