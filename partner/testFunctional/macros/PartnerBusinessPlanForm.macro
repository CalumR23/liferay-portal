definition {

	macro addBusiness {
		Click(locator1 = "PartnerBusinessPlanForm#ADD_BUSINESS_BUTTON");

		var key_quarter = "${partnerBusinessPlanNewBusinessGoalQuarter}";

		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_NEW_BUSINESS_TYPE",
			value1 = "${partnerBusinessPlanNewBusinessType}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_COMPANY_NAME",
			value1 = "${partnerBusinessPlanNewBusinessCompanyName}");

		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECT_INFORMATION",
			value1 = "${partnerBusinessPlanNewBusinessProjectInformation}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_SALES_FORECAST",
			value1 = "${partnerBusinessPlanNewBusinessSalesForecast}");

		Click(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_GOAL_QUARTER");

		Click(locator1 = "PartnerBusinessPlanForm#SAVE_BUSINESS_BUTTON");
	}

	macro addGoal {
		Click(locator1 = "PartnerBusinessPlanForm#ADD_GOAL_BUTTON");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_DESCRIPTION",
			value1 = "${partnerBusinessPlanGoalDescription}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_LIFERAY_OWNER",
			value1 = "${partnerBusinessPlanGoalLiferayOwner}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_PARTNER_OWNER",
			value1 = "${partnerBusinessPlanGoalPartnerOwner}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q1_PROGRESS_DESCRIPTION",
			value1 = "${partnerBusinessPlanGoalQ1ProgressDescription}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q2_PROGRESS_DESCRIPTION",
			value1 = "${partnerBusinessPlanGoalQ2ProgressDescription}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q3_PROGRESS_DESCRIPTION",
			value1 = "${partnerBusinessPlanGoalQ3ProgressDescription}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q4_PROGRESS_DESCRIPTION",
			value1 = "${partnerBusinessPlanGoalQ4ProgressDescription}");

		Click(locator1 = "PartnerBusinessPlanForm#SAVE_GOAL_BUTTON");
	}

	macro addService {
		Click(locator1 = "PartnerBusinessPlanForm#ADD_SERVICE_BUTTON");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_ACCOUNT_NAME",
			value1 = "${partnerBusinessPlanServiceAccountName}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_SECTOR",
			value1 = "${partnerBusinessPlanServiceSector}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_LIFERAY_SERVICES_PROVIDED",
			value1 = "${partnerBusinessPlanServiceLiferayServicesProvided}");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_DATE",
			value1 = "${partnerBusinessPlanServiceDate}");

		Click(locator1 = "PartnerBusinessPlanForm#SAVE_SERVICE_BUTTON");
	}

	macro assertConflict {
		AssertElementPresent(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_FAILURE_MESSAGE");
	}

	macro deleteBusinessPlanConflict {
		Partner.pause(pauseTime = "2000");

		if (IsElementPresent(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_FAILURE_MESSAGE")) {
			PartnerManagement.deleteBusinessPlanConflict(
				partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
				partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
				partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

			PartnerManagement.clickNewBusinessPlanButton();

			PartnerBusinessPlanForm.fillPartner(
				partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
				partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
				partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
				partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

			Partner.clickSaveAndContinueButton();
		}
	}

	macro editFocus {
		Partner.unselectOptions(
			selectOptionList = "${partnerBusinessPlanSectorsVerticals}",
			unselectOptionList = "${partnerBusinessPlanUnselectSectorsVerticals}");

		SelectFieldText(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY",
			value1 = "${partnerBusinessPlanTechnologyStrategy}");
	}

	macro fillAccount {
		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_BUSINESS_PLAN_OWNER",
			value1 = "${partnerBusinessPlanPartnerBusinessPlanOwner}");

		SelectFieldText(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER",
			value1 = "${partnerBusinessPlanPartnerMarketingPlanOwner}");

		SelectFieldText(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT");

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT",
			value1 = "${partnerBusinessPlanLiferayRenewalContact}");
	}

	macro fillFocus {
		for (var sector : list "${partnerBusinessPlanSectorsVerticals}") {
			Select(
				locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_SECTORS_OR_VERTICALS",
				value1 = "${sector}");
		}

		Type.sendKeys(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY",
			value1 = "${partnerBusinessPlanTechnologyStrategy}");
	}

	macro fillPartner {
		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_COMPANY",
			value1 = "${partnerBusinessPlanCompany}");

		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_REGION",
			value1 = "${partnerBusinessPlanRegion}");

		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_CURRENCY_CODE",
			value1 = "${partnerBusinessPlanCurrencyCode}");

		Select(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_YEAR",
			value1 = "${partnerBusinessPlanYear}");
	}

	macro fillRevenue {
		var key_quarter = "0";
		var partnerBusinessPlanNewBusinessProjectionTotal = "0";
		var partnerBusinessPlanRenewalProjectionTotal = "0";

		for (var projection : list "${partnerBusinessPlanNewBusinessProjections}") {
			var key_quarter = ${key_quarter} + 1;
			var partnerBusinessPlanNewBusinessProjectionTotal = ${partnerBusinessPlanNewBusinessProjectionTotal} + ${projection};

			SelectFieldText(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION");

			Type.sendKeys(
				locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION",
				value1 = "${projection}");
		}

		var key_quarter = "0";

		for (var projection : list "${partnerBusinessPlanRenewalProjections}") {
			var key_quarter = ${key_quarter} + 1;
			var partnerBusinessPlanRenewalProjectionTotal = ${partnerBusinessPlanRenewalProjectionTotal} + ${projection};

			SelectFieldText(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION");

			Type.sendKeys(
				locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION",
				value1 = "${projection}");
		}

		Click(locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION_TOTAL");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION_TOTAL",
			value1 = "${partnerBusinessPlanNewBusinessProjectionTotal}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION_TOTAL",
			value1 = "${partnerBusinessPlanRenewalProjectionTotal}");
	}

}