<definition>
	<command name="addBusiness">
		<execute function="Click" locator1="PartnerBusinessPlanForm#ADD_BUSINESS_BUTTON" />

		<var name="key_quarter" value="${partnerBusinessPlanNewBusinessGoalQuarter}" />

		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_NEW_BUSINESS_TYPE" value1="${partnerBusinessPlanNewBusinessType}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_COMPANY_NAME" value1="${partnerBusinessPlanNewBusinessCompanyName}" />
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECT_INFORMATION" value1="${partnerBusinessPlanNewBusinessProjectInformation}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_SALES_FORECAST" value1="${partnerBusinessPlanNewBusinessSalesForecast}" />
		<execute function="Click" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_GOAL_QUARTER" />

		<execute function="Click" locator1="PartnerBusinessPlanForm#SAVE_BUSINESS_BUTTON" />
	</command>

	<command name="addGoal">
		<execute function="Click" locator1="PartnerBusinessPlanForm#ADD_GOAL_BUTTON" />

		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_DESCRIPTION" value1="${partnerBusinessPlanGoalDescription}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_LIFERAY_OWNER" value1="${partnerBusinessPlanGoalLiferayOwner}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_PARTNER_OWNER" value1="${partnerBusinessPlanGoalPartnerOwner}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q1_PROGRESS_DESCRIPTION" value1="${partnerBusinessPlanGoalQ1ProgressDescription}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q2_PROGRESS_DESCRIPTION" value1="${partnerBusinessPlanGoalQ2ProgressDescription}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q3_PROGRESS_DESCRIPTION" value1="${partnerBusinessPlanGoalQ3ProgressDescription}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_GOAL_Q4_PROGRESS_DESCRIPTION" value1="${partnerBusinessPlanGoalQ4ProgressDescription}" />

		<execute function="Click" locator1="PartnerBusinessPlanForm#SAVE_GOAL_BUTTON" />
	</command>

	<command name="addService">
		<execute function="Click" locator1="PartnerBusinessPlanForm#ADD_SERVICE_BUTTON" />

		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_ACCOUNT_NAME" value1="${partnerBusinessPlanServiceAccountName}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_SECTOR" value1="${partnerBusinessPlanServiceSector}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_LIFERAY_SERVICES_PROVIDED" value1="${partnerBusinessPlanServiceLiferayServicesProvided}" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_SERVICE_DATE" value1="${partnerBusinessPlanServiceDate}" />

		<execute function="Click" locator1="PartnerBusinessPlanForm#SAVE_SERVICE_BUTTON" />
	</command>

	<command name="assertConflict">
		<execute function="AssertElementPresent" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_FAILURE_MESSAGE" />
	</command>

	<command name="deleteBusinessPlanConflict">
		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_FAILURE_MESSAGE" />
			<then>
				<execute macro="PartnerManagement#deleteBusinessPlanConflict">
					<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
					<var name="partnerBusinessPlanRegionCode" value="${partnerBusinessPlanRegionCode}" />
					<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
				</execute>

				<execute macro="PartnerManagement#clickNewBusinessPlanButton" />

				<execute macro="PartnerBusinessPlanForm#fillPartner">
					<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
					<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
					<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
					<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
				</execute>

				<execute macro="Partner#clickSaveAndContinueButton" />
			</then>
		</if>
	</command>

	<command name="editFocus">
		<execute macro="Partner#unselectOptions">
			<var name="selectOptionList" value="${partnerBusinessPlanSectorsVerticals}" />
			<var name="unselectOptionList" value="${partnerBusinessPlanUnselectSectorsVerticals}" />
		</execute>

		<execute function="SelectFieldText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY" value1="${partnerBusinessPlanTechnologyStrategy}" />
	</command>

	<command name="fillAccount">
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_BUSINESS_PLAN_OWNER" value1="${partnerBusinessPlanPartnerBusinessPlanOwner}" />

		<execute function="SelectFieldText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER" value1="${partnerBusinessPlanPartnerMarketingPlanOwner}" />

		<execute function="SelectFieldText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT" />
		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT" value1="${partnerBusinessPlanLiferayRenewalContact}" />
	</command>

	<command name="fillFocus">
		<for list="${partnerBusinessPlanSectorsVerticals}" param="sector">
			<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_SECTORS_OR_VERTICALS" value1="${sector}" />
		</for>

		<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_TECHNOLOGY_STRATEGY" value1="${partnerBusinessPlanTechnologyStrategy}" />
	</command>

	<command name="fillPartner">
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_COMPANY" value1="${partnerBusinessPlanCompany}" />
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_REGION" value1="${partnerBusinessPlanRegion}" />
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_CURRENCY_CODE" value1="${partnerBusinessPlanCurrencyCode}" />
		<execute function="Select" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_PARTNER_YEAR" value1="${partnerBusinessPlanYear}" />
	</command>

	<command name="fillRevenue">
		<var name="key_quarter" value="0" />
		<var name="partnerBusinessPlanNewBusinessProjectionTotal" value="0" />
		<var name="partnerBusinessPlanRenewalProjectionTotal" value="0" />

		<for list="${partnerBusinessPlanNewBusinessProjections}" param="projection">
			<var method="MathUtil#sum('${key_quarter}', '1')" name="key_quarter" />
			<var method="MathUtil#sum('${partnerBusinessPlanNewBusinessProjectionTotal}', '${projection}')" name="partnerBusinessPlanNewBusinessProjectionTotal" />

			<execute function="SelectFieldText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION" />
			<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION" value1="${projection}" />
		</for>

		<var name="key_quarter" value="0" />

		<for list="${partnerBusinessPlanRenewalProjections}" param="projection">
			<var method="MathUtil#sum('${key_quarter}', '1')" name="key_quarter" />
			<var method="MathUtil#sum('${partnerBusinessPlanRenewalProjectionTotal}', '${projection}')" name="partnerBusinessPlanRenewalProjectionTotal" />

			<execute function="SelectFieldText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION" />
			<execute function="Type#sendKeys" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION" value1="${projection}" />
		</for>

		<execute function="Click" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION_TOTAL" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_NEW_BUSINESS_PROJECTION_TOTAL" value1="${partnerBusinessPlanNewBusinessProjectionTotal}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerBusinessPlanForm#BUSINESS_PLAN_RENEWAL_PROJECTION_TOTAL" value1="${partnerBusinessPlanRenewalProjectionTotal}" />
	</command>
</definition>