definition {

	macro assertLeadContactUser {
		AssertSelectedLabel(
			locator1 = "PartnerRebatePaymentForm#PARTNER_LEAD_CONTACT_USER",
			value1 = "${partnerRebatePaymentLeadContactUser}");
	}

	macro assertPartnerBankAccount {
		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#BANK_NAME",
			value1 = "${partnerRebatePaymentBankName}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#BANK_STREET",
			value1 = "${partnerRebatePaymentBankStreet}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#BANK_CITY",
			value1 = "${partnerRebatePaymentBankCity}");

		AssertSelectedLabel(
			locator1 = "PartnerRebatePaymentForm#BANK_COUNTRY",
			value1 = "${partnerRebatePaymentBankCountry}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#BANK_ZIP",
			value1 = "${partnerRebatePaymentBankZip}");

		AssertSelectedLabel(
			locator1 = "PartnerRebatePaymentForm#BANK_REGION",
			value1 = "${partnerRebatePaymentBankRegion}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#BANK_CODE",
			value1 = "${partnerRebatePaymentBankCode}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#ACCOUNT_NAME",
			value1 = "${partnerRebatePaymentBankAccountName}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#ACCOUNT_NUMBER",
			value1 = "${partnerRebatePaymentBankAccountNumber}");
	}

	macro assertPartnerInformation {
		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#PARTNER_STREET",
			value1 = "${partnerRebatePaymentPartnerStreet}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#PARTNER_CITY",
			value1 = "${partnerRebatePaymentPartnerCity}");

		AssertSelectedLabel(
			locator1 = "PartnerRebatePaymentForm#PARTNER_COUNTRY",
			value1 = "${partnerRebatePaymentPartnerCountry}");

		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#PARTNER_ZIP",
			value1 = "${partnerRebatePaymentPartnerZip}");

		AssertSelectedLabel(
			locator1 = "PartnerRebatePaymentForm#PARTNER_REGION",
			value1 = "${partnerRebatePaymentPartnerRegion}");
	}

	macro assertRebateMethod {
		if ("${partnerRebatePaymentRebateMethod}" == "Liferay Credit Note") {
			AssertElementPresent(locator1 = "PartnerRebatePaymentForm#REBATE_METHOD_LIFERAY_CREDIT_NOTE_CHECKED");
		}
		else {
			AssertElementPresent(locator1 = "PartnerRebatePaymentForm#REBATE_METHOD_PARTNER_INVOICE_CHECKED");
		}
	}

	macro assertRebatePaymentPartner {
		AssertTextEquals(
			locator1 = "PartnerRebatePaymentForm#LIFERAY_PARTNER_NAME",
			value1 = "${partnerRebatePaymentPartner}");
	}

	macro clickRebateMethod {
		if ("${partnerRebatePaymentRebateMethod}" == "Liferay Credit Note") {
			Click(locator1 = "PartnerRebatePaymentForm#REBATE_METHOD_LIFERAY_CREDIT_NOTE");
		}
		else {
			Click(locator1 = "PartnerRebatePaymentForm#REBATE_METHOD_PARTNER_INVOICE");
		}
	}

	macro fillPartnerBankAccount {
		SelectFieldText(locator1 = "PartnerRebatePaymentForm#BANK_NAME");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#BANK_NAME",
			value1 = "${partnerRebatePaymentBankName}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#BANK_STREET");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#BANK_STREET",
			value1 = "${partnerRebatePaymentBankStreet}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#BANK_CITY");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#BANK_CITY",
			value1 = "${partnerRebatePaymentBankCity}");

		Select(
			locator1 = "PartnerRebatePaymentForm#BANK_COUNTRY",
			value1 = "${partnerRebatePaymentBankCountry}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#BANK_ZIP");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#BANK_ZIP",
			value1 = "${partnerRebatePaymentBankZip}");

		Select(
			locator1 = "PartnerRebatePaymentForm#BANK_REGION",
			value1 = "${partnerRebatePaymentBankRegion}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#BANK_CODE");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#BANK_CODE",
			value1 = "${partnerRebatePaymentBankCode}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#ACCOUNT_NAME");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#ACCOUNT_NAME",
			value1 = "${partnerRebatePaymentBankAccountName}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#ACCOUNT_NUMBER");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#ACCOUNT_NUMBER",
			value1 = "${partnerRebatePaymentBankAccountNumber}");
	}

	macro fillPartnerInformation {
		SelectFieldText(locator1 = "PartnerRebatePaymentForm#PARTNER_STREET");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#PARTNER_STREET",
			value1 = "${partnerRebatePaymentPartnerStreet}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#PARTNER_CITY");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#PARTNER_CITY",
			value1 = "${partnerRebatePaymentPartnerCity}");

		Select(
			locator1 = "PartnerRebatePaymentForm#PARTNER_COUNTRY",
			value1 = "${partnerRebatePaymentPartnerCountry}");

		SelectFieldText(locator1 = "PartnerRebatePaymentForm#PARTNER_ZIP");

		Type.sendKeys(
			locator1 = "PartnerRebatePaymentForm#PARTNER_ZIP",
			value1 = "${partnerRebatePaymentPartnerZip}");

		Select(
			locator1 = "PartnerRebatePaymentForm#PARTNER_REGION",
			value1 = "${partnerRebatePaymentPartnerRegion}");
	}

	macro selectLeadContactUser {
		Select(
			locator1 = "PartnerRebatePaymentForm#PARTNER_LEAD_CONTACT_USER",
			value1 = "${partnerRebatePaymentLeadContactUser}");
	}

}