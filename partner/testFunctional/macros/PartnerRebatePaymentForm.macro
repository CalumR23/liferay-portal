<definition>
	<command name="assertLeadContactUser">
		<execute function="AssertSelectedLabel" locator1="PartnerRebatePaymentForm#PARTNER_LEAD_CONTACT_USER" value1="${partnerRebatePaymentLeadContactUser}" />
	</command>

	<command name="assertPartnerBankAccount">
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#BANK_NAME" value1="${partnerRebatePaymentBankName}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#BANK_STREET" value1="${partnerRebatePaymentBankStreet}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#BANK_CITY" value1="${partnerRebatePaymentBankCity}" />
		<execute function="AssertSelectedLabel" locator1="PartnerRebatePaymentForm#BANK_COUNTRY" value1="${partnerRebatePaymentBankCountry}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#BANK_ZIP" value1="${partnerRebatePaymentBankZip}" />
		<execute function="AssertSelectedLabel" locator1="PartnerRebatePaymentForm#BANK_REGION" value1="${partnerRebatePaymentBankRegion}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#BANK_CODE" value1="${partnerRebatePaymentBankCode}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#ACCOUNT_NAME" value1="${partnerRebatePaymentBankAccountName}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#ACCOUNT_NUMBER" value1="${partnerRebatePaymentBankAccountNumber}" />
	</command>

	<command name="assertPartnerInformation">
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#PARTNER_STREET" value1="${partnerRebatePaymentPartnerStreet}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#PARTNER_CITY" value1="${partnerRebatePaymentPartnerCity}" />
		<execute function="AssertSelectedLabel" locator1="PartnerRebatePaymentForm#PARTNER_COUNTRY" value1="${partnerRebatePaymentPartnerCountry}" />
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#PARTNER_ZIP" value1="${partnerRebatePaymentPartnerZip}" />
		<execute function="AssertSelectedLabel" locator1="PartnerRebatePaymentForm#PARTNER_REGION" value1="${partnerRebatePaymentPartnerRegion}" />
	</command>

	<command name="assertRebateMethod">
		<if>
			<equals arg1="${partnerRebatePaymentRebateMethod}" arg2="Liferay Credit Note" />
			<then>
				<execute function="AssertElementPresent" locator1="PartnerRebatePaymentForm#REBATE_METHOD_LIFERAY_CREDIT_NOTE_CHECKED"  />
			</then>
			<else>
				<execute function="AssertElementPresent" locator1="PartnerRebatePaymentForm#REBATE_METHOD_PARTNER_INVOICE_CHECKED" />
			</else>
		</if>
	</command>

	<command name="assertRebatePaymentPartner">
		<execute function="AssertTextEquals" locator1="PartnerRebatePaymentForm#LIFERAY_PARTNER_NAME" value1="${partnerRebatePaymentPartner}" />
	</command>

	<command name="clickRebateMethod">
		<if>
			<equals arg1="${partnerRebatePaymentRebateMethod}" arg2="Liferay Credit Note" />
			<then>
				<execute function="Click" locator1="PartnerRebatePaymentForm#REBATE_METHOD_LIFERAY_CREDIT_NOTE" />
			</then>
			<else>
				<execute function="Click" locator1="PartnerRebatePaymentForm#REBATE_METHOD_PARTNER_INVOICE" />
			</else>
		</if>
	</command>

	<command name="fillPartnerBankAccount">
		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#BANK_NAME" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#BANK_NAME" value1="${partnerRebatePaymentBankName}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#BANK_STREET" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#BANK_STREET" value1="${partnerRebatePaymentBankStreet}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#BANK_CITY" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#BANK_CITY" value1="${partnerRebatePaymentBankCity}" />

		<execute function="Select" locator1="PartnerRebatePaymentForm#BANK_COUNTRY" value1="${partnerRebatePaymentBankCountry}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#BANK_ZIP" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#BANK_ZIP" value1="${partnerRebatePaymentBankZip}" />

		<execute function="Select" locator1="PartnerRebatePaymentForm#BANK_REGION" value1="${partnerRebatePaymentBankRegion}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#BANK_CODE" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#BANK_CODE" value1="${partnerRebatePaymentBankCode}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#ACCOUNT_NAME" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#ACCOUNT_NAME" value1="${partnerRebatePaymentBankAccountName}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#ACCOUNT_NUMBER" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#ACCOUNT_NUMBER" value1="${partnerRebatePaymentBankAccountNumber}" />
	</command>

	<command name="fillPartnerInformation">
		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#PARTNER_STREET" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#PARTNER_STREET" value1="${partnerRebatePaymentPartnerStreet}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#PARTNER_CITY" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#PARTNER_CITY" value1="${partnerRebatePaymentPartnerCity}" />

		<execute function="Select" locator1="PartnerRebatePaymentForm#PARTNER_COUNTRY" value1="${partnerRebatePaymentPartnerCountry}" />

		<execute function="SelectFieldText" locator1="PartnerRebatePaymentForm#PARTNER_ZIP" />
		<execute function="Type#sendKeys" locator1="PartnerRebatePaymentForm#PARTNER_ZIP" value1="${partnerRebatePaymentPartnerZip}" />

		<execute function="Select" locator1="PartnerRebatePaymentForm#PARTNER_REGION" value1="${partnerRebatePaymentPartnerRegion}" />
	</command>

	<command name="selectLeadContactUser">
		<execute function="Select" locator1="PartnerRebatePaymentForm#PARTNER_LEAD_CONTACT_USER" value1="${partnerRebatePaymentLeadContactUser}" />
	</command>
</definition>