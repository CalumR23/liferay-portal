definition {

	macro backtoInbox {
		AssertClick.assertPartialTextClickAt(
			locator1 = "PartnerMockMock#MOCKMOCK_HOME_LINK",
			value1 = "Home");
	}

	macro deleteAllMail {
		AssertClick(
			locator1 = "PartnerMockMock#MOCKMOCK_DELETE_ALL_LINK",
			value1 = "Delete all");

		PartnerMockMock.viewNoMailCount();
	}

	macro gotoMailMessage {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";

		AssertClick.assertPartialTextClickAt(
			locator1 = "PartnerMockMock#MOCKMOCK_SUBJECT_FIELD_LINK",
			value1 = "${mockMockAsset}");
	}

	macro gotoMockMock {
		var mockUrl = PropsUtil.get("portal.mock.url");

		Pause(locator1 = "5000");

		Open(locator1 = "${mockUrl}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_HEADER_LINK",
			value1 = "MockMock");
	}

	macro viewAndClickMail {
		PartnerMockMock.viewMailFromInbox(
			mockMockAsset = "${mockMockAsset}",
			mockMockRecipient = "${mockMockRecipient}",
			mockMockSender = "${mockMockSender}");

		PartnerMockMock.gotoMailMessage(
			mockMockAsset = "${mockMockAsset}",
			mockMockRecipient = "${mockMockRecipient}",
			mockMockSender = "${mockMockSender}");
	}

	macro viewDuplicateMailFromInbox {
		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE",
			value1 = "You have");

		for (var mockMockRecipient : list "${mockMockRecipientList}") {
			var key_columnEntry1 = "${mockMockAsset}";
			var key_columnEntry2 = "${mockMockRecipient}";
			var key_columnEntry3 = "${mockMockSender}";

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMockMock#MOCKMOCK_FROM_FIELD",
				value1 = "${mockMockSender}");

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMockMock#MOCKMOCK_TO_FIELD",
				value1 = "${mockMockRecipient}");

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMockMock#MOCKMOCK_SUBJECT_FIELD",
				value1 = "${mockMockAsset}");
		}
	}

	macro viewMailCount {
		var key_emailCount = "${emailCount}";

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_EMAIL_COUNT_MESSAGE",
			value1 = "You have ${emailCount}");
	}

	macro viewMailFromInbox {
		var key_columnEntry1 = "${mockMockAsset}";
		var key_columnEntry2 = "${mockMockRecipient}";
		var key_columnEntry3 = "${mockMockSender}";

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE",
			value1 = "You have");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_FROM_FIELD",
			value1 = "${mockMockSender}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_TO_FIELD",
			value1 = "${mockMockRecipient}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_SUBJECT_FIELD",
			value1 = "${mockMockAsset}");
	}

	macro viewMailMessage {
		var mockMockAsset = StringUtil.replace("${mockMockAsset}", ",", "+");

		var mockMockAsset = StringUtil.replace("${mockMockAsset}", ";", ",");

		for (var line : list "${mockMockAsset}") {
			var line = StringUtil.replace("${line}", "+", ",");

			var key_asset = "${line}";

			AssertElementPresent(locator1 = "PartnerMockMock#MOCKMOCK_MESSAGE_BODY");
		}
	}

	macro viewNoMailCount {
		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMockMock#MOCKMOCK_NO_EMAILS_MESSAGE",
			value1 = "No emails in queue");
	}

}