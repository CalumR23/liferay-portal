<definition>
	<command name="backtoInbox">
		<execute function="AssertClick#assertPartialTextClickAt" locator1="PartnerMockMock#MOCKMOCK_HOME_LINK" value1="Home" />
	</command>

	<command name="deleteAllMail">
		<execute function="AssertClick" locator1="PartnerMockMock#MOCKMOCK_DELETE_ALL_LINK" value1="Delete all" />

		<execute macro="PartnerMockMock#viewNoMailCount" />
	</command>

	<command name="gotoMailMessage">
		<var name="key_columnEntry1" value="${mockMockAsset}" />
		<var name="key_columnEntry2" value="${mockMockRecipient}" />
		<var name="key_columnEntry3" value="${mockMockSender}" />

		<execute function="AssertClick#assertPartialTextClickAt" locator1="PartnerMockMock#MOCKMOCK_SUBJECT_FIELD_LINK" value1="${mockMockAsset}" />
	</command>

	<command name="gotoMockMock">
		<var method="PropsUtil#get('portal.mock.url')" name="mockUrl" />

		<execute function="Pause" locator1="5000" />
		<execute function="Open" locator1="${mockUrl}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_HEADER_LINK" value1="MockMock" />
	</command>

	<command name="viewAndClickMail">
		<execute macro="PartnerMockMock#viewMailFromInbox">
			<var name="mockMockAsset" value="${mockMockAsset}" />
			<var name="mockMockRecipient" value="${mockMockRecipient}" />
			<var name="mockMockSender" value="${mockMockSender}" />
		</execute>

		<execute macro="PartnerMockMock#gotoMailMessage">
			<var name="mockMockAsset" value="${mockMockAsset}" />
			<var name="mockMockRecipient" value="${mockMockRecipient}" />
			<var name="mockMockSender" value="${mockMockSender}" />
		</execute>
	</command>

	<command name="viewDuplicateMailFromInbox">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE" value1="You have" />

		<for list="${mockMockRecipientList}" param="mockMockRecipient">
			<var name="key_columnEntry1" value="${mockMockAsset}" />
			<var name="key_columnEntry2" value="${mockMockRecipient}" />
			<var name="key_columnEntry3" value="${mockMockSender}" />

			<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_FROM_FIELD" value1="${mockMockSender}" />
			<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_TO_FIELD" value1="${mockMockRecipient}" />
			<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_SUBJECT_FIELD" value1="${mockMockAsset}" />
		</for>
	</command>

	<command name="viewMailCount">
		<var name="key_emailCount" value="${emailCount}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_EMAIL_COUNT_MESSAGE" value1="You have ${emailCount}" />
	</command>

	<command name="viewMailFromInbox">
		<var name="key_columnEntry1" value="${mockMockAsset}" />
		<var name="key_columnEntry2" value="${mockMockRecipient}" />
		<var name="key_columnEntry3" value="${mockMockSender}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_HAVE_EMAILS_MESSAGE" value1="You have" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_FROM_FIELD" value1="${mockMockSender}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_TO_FIELD" value1="${mockMockRecipient}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_SUBJECT_FIELD" value1="${mockMockAsset}" />
	</command>

	<command name="viewMailMessage">
		<var method="StringUtil#replace('${mockMockAsset}', ',', '+')" name="mockMockAsset" />
		<var method="StringUtil#replace('${mockMockAsset}', ';', ',')" name="mockMockAsset" />

		<for list="${mockMockAsset}" param="line">
			<var method="StringUtil#replace('${line}', '+', ',')" name="line" />

			<var name="key_asset" value="${line}" />

			<execute function="AssertElementPresent" locator1="PartnerMockMock#MOCKMOCK_MESSAGE_BODY" />
		</for>
	</command>

	<command name="viewNoMailCount">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMockMock#MOCKMOCK_NO_EMAILS_MESSAGE" value1="No emails in queue" />
	</command>
</definition>