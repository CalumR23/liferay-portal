definition {

	macro assertRebatePaymentPartner {
		var key_partnerRebatePaymentPartner = "${partnerRebatePaymentPartner}";

		AssertElementPresent(locator1 = "PartnerRebatePayments#REBATE_PAYMENT_PARTNER");
	}

	macro clickRebatePaymentPartner {
		var key_partnerRebatePaymentPartner = "${partnerRebatePaymentPartner}";

		ScrollWebElementIntoView(locator1 = "PartnerRebatePayments#REBATE_PAYMENT_PARTNER_NEXT");

		Click(locator1 = "PartnerRebatePayments#REBATE_PAYMENT_PARTNER");
	}

}