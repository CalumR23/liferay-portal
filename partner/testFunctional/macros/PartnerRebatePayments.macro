<definition>
	<command name="assertRebatePaymentPartner">
		<var name="key_partnerRebatePaymentPartner" value="${partnerRebatePaymentPartner}" />

		<execute function="AssertElementPresent" locator1="PartnerRebatePayments#REBATE_PAYMENT_PARTNER" />
	</command>

	<command name="clickRebatePaymentPartner">
		<var name="key_partnerRebatePaymentPartner" value="${partnerRebatePaymentPartner}" />

		<execute function="ScrollWebElementIntoView" locator1="PartnerRebatePayments#REBATE_PAYMENT_PARTNER_NEXT" />

		<execute function="Click" locator1="PartnerRebatePayments#REBATE_PAYMENT_PARTNER" />
	</command>
</definition>