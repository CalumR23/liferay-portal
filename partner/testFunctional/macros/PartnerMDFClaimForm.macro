<definition>
	<command name="fillGeneralInformation">
		<var name="key_mdfClaimType" value="${partnerMDFClaimType}" />

		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_TYPE" />

		<execute function="UploadCommonFile" locator1="PartnerMDFClaimForm#MDF_CLAIM_UPLOAD_INVOICE_UPLOAD" value1="${partnerMDFClaimInvoice}" />

		<execute function="AssertElementPresent" locator1="PartnerMDFClaimForm#MDF_CLAIM_UPLOAD_INVOICE_FILLED" />

		<for list="${partnerMDFClaimActivities}" param="mdfClaimActivity">
			<var name="key_mdfClaimActivity" value="${mdfClaimActivity}" />

			<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_CHECKBOX" />
		</for>
	</command>

	<command name="uploadProofOfPerformance">
		<var name="key_mdfClaimActivity" value="${partnerMDFClaimActivity}" />
		<var name="key_mdfClaimPOPLabel" value="${partnerMDFClaimPOPLabel}" />

		<execute function="UploadCommonFile" locator1="PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_UPLOAD" value1="${partnerMDFClaimPOP}" />
	</command>
</definition>