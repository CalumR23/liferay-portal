<definition>
	<command name="fillGeneralInformation">
		<var name="key_mdfClaimType" value="${partnerMDFClaimType}" />

		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_TYPE" />

		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_INVOICE_UPLOAD" />
		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_SELECT_FILE_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_FILE_NAME_FIELD_PNG" value1="${partnerMDFClaimInvoice}" />

		<if>
			<and>
				<isset var="partnerMDFClaimActivities" />
				<not>
					<contains string="${partnerMDFClaimActivities}" substring="{partnerMDFClaimActivities}" />
				</not>
			</and>
			<then>
				<for list="${partnerMDFClaimActivities}" param="mdfClaimActivity">
					<var method="StringUtil#trim('${mdfClaimActivity}')" name="mdfClaimActivity" />

					<var name="key_mdfClaimActivity" value="${mdfClaimActivity}" />

					<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_CHECKBOX" />
				</for>
			</then>
		</if>
	</command>

	<command name="uploadActivityPOP">
		<var name="key_mdfClaimActivity" value="${partnerMDFClaimActivity}" />
		<var name="key_mdfClaimPOPLabel" value="${partnerMDFClaimLabel}" />

		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_UPLOAD" />
		<execute function="Click" locator1="PartnerMDFClaimForm#MDF_CLAIM_SELECT_FILE_BUTTON" />

		<execute function="SikuliUploadCommonFile" locator1="OS#FILE_DIALOG_BOX_FILE_NAME_FIELD_PNG" value1="${partnerMDFClaimPOPDocument}" />
	</command>

	<command name="uploadActivityPOPs">
		<var name="partnerMDFClaimPOPdoc" value="Document_1.doc" />
		<var name="partnerMDFClaimPOPjpeg" value="Document_1.jpeg" />
		<var name="partnerMDFClaimPOPjpg" value="Document_1.jpg" />
		<var name="partnerMDFClaimPOPleads" value="Partner_Leads.xlsx" />
		<var name="partnerMDFClaimPOPpdf" value="Document_1.pdf" />

		<var name="key_mdfClaimActivity" value="${partnerMDFClaimActivity}" />

		<for list="${partnerMDFClaimLabels}" param="label">
			<var name="key_mdfClaimPOPLabel" value="${label}" />

			<if>
				<or>
					<equals arg1="${label}" arg2="Metrics" />
					<equals arg1="${label}" arg2="Telemarketing Metrics" />
					<equals arg1="${label}" arg2="Video Links" />
				</or>
				<then>
					<execute function="Type#sendKeys" locator1="PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_TEXTBOX" value1="${label} Test" />
				</then>
				<elseif>
					<equals arg1="${label}" arg2="List of Qualified Leads" />
					<then>
						<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
							<var name="partnerMDFClaimActivity" value="${partnerMDFClaimActivity}" />
							<var name="partnerMDFClaimLabel" value="${label}" />
							<var name="partnerMDFClaimPOPDocument" value="${partnerMDFClaimPOPleads}" />
						</execute>
					</then>
				</elseif>
				<else>
					<execute macro="PartnerMDFClaimForm#uploadActivityPOP">
						<var name="partnerMDFClaimActivity" value="${partnerMDFClaimActivity}" />
						<var name="partnerMDFClaimLabel" value="${label}" />
						<var name="partnerMDFClaimPOPDocument" value="${partnerMDFClaimPOPpdf}" />
					</execute>
				</else>
			</if>
		</for>
	</command>
</definition>