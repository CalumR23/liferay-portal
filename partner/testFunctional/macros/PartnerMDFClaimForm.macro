definition {

	macro deleteActivityPOPs {
		var key_mdfClaimActivity = "${partnerMDFClaimActivity}";

		for (var partnerMDFClaimLabel : list "${partnerMDFClaimLabels}") {
			var key_mdfClaimPOP = "";
			var key_mdfClaimPOPLabel = "${partnerMDFClaimLabel}";

			Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_DELETE_UPLOAD");
		}
	}

	macro deleteInvoiceUpload {
		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_INVOICE_DELETE_UPLOAD");
	}

	macro fillGeneralInformation {
		var key_mdfClaimType = "${partnerMDFClaimType}";

		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_TYPE");

		PartnerMDFClaimForm.uploadInvoice(partnerMDFClaimInvoice = "${partnerMDFClaimInvoice}");

		if (isSet(partnerMDFClaimActivities) && isSet(partnerMDFClaimActivities)) {
			for (var mdfClaimActivity : list "${partnerMDFClaimActivities}") {
				var mdfClaimActivity = StringUtil.trim("${mdfClaimActivity}");

				var key_mdfClaimActivity = "${mdfClaimActivity}";

				Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_CHECKBOX");
			}
		}
	}

	macro uploadActivityPOP {
		var key_mdfClaimActivity = "${partnerMDFClaimActivity}";
		var key_mdfClaimPOPLabel = "${partnerMDFClaimLabel}";

		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_UPLOAD");

		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_SELECT_FILE_BUTTON");

		SikuliUploadCommonFile(
			locator1 = "OS#FILE_DIALOG_BOX_FILE_NAME_FIELD_PNG",
			value1 = "${partnerMDFClaimPOPDocument}");

		Partner.pause(pauseTime = "5000");
	}

	macro uploadActivityPOPs {
		var partnerMDFClaimPOPdoc = "Document_1.doc";
		var partnerMDFClaimPOPjpeg = "Document_1.jpeg";
		var partnerMDFClaimPOPjpg = "Document_1.jpg";
		var partnerMDFClaimPOPleads = "Partner_Leads.xlsx";
		var partnerMDFClaimPOPpdf = "Document_1.pdf";
		var key_mdfClaimActivity = "${partnerMDFClaimActivity}";

		for (var label : list "${partnerMDFClaimLabels}") {
			var key_mdfClaimPOPLabel = "${label}";

			if (("${label}" == "Metrics") || ("${label}" == "Telemarketing Metrics") || ("${label}" == "Video Links")) {
				Type.sendKeys(
					locator1 = "PartnerMDFClaimForm#MDF_CLAIM_ACTIVITY_POP_TEXTBOX",
					value1 = "${label} Test");
			}
			else if ("${label}" == "List of Qualified Leads") {
				PartnerMDFClaimForm.uploadActivityPOP(
					partnerMDFClaimActivity = "${partnerMDFClaimActivity}",
					partnerMDFClaimLabel = "${label}",
					partnerMDFClaimPOPDocument = "${partnerMDFClaimPOPleads}");
			}
			else {
				PartnerMDFClaimForm.uploadActivityPOP(
					partnerMDFClaimActivity = "${partnerMDFClaimActivity}",
					partnerMDFClaimLabel = "${label}",
					partnerMDFClaimPOPDocument = "${partnerMDFClaimPOPpdf}");
			}
		}
	}

	macro uploadInvoice {
		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_INVOICE_UPLOAD");

		Click(locator1 = "PartnerMDFClaimForm#MDF_CLAIM_SELECT_FILE_BUTTON");

		SikuliUploadCommonFile(
			locator1 = "OS#FILE_DIALOG_BOX_FILE_NAME_FIELD_PNG",
			value1 = "${partnerMDFClaimInvoice}");
	}

}