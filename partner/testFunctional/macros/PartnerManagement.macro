<definition>
	<command name="assertBusinessPlan">
		<var name="key_businessPlan" value="${partnerBusinessPlanID}" />
		<var method="StringUtil#upperCase('${partnerBusinessPlanStatus}')" name="partnerBusinessPlanStatus" />

		<execute macro="Partner#formatRegionCode">
			<var name="regionCode" value="${partnerBusinessPlanRegionCode}" />
			<return name="partnerBusinessPlanRegionCode" />
		</execute>

		<execute macro="PartnerManagement#filterBusinessPlanByYear">
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_PARTNER" value1="${partnerBusinessPlanCompany}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_REGION_CODE" value1="${partnerBusinessPlanRegionCode}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_STATUS" value1="${partnerBusinessPlanStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER" value1="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER" value1="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT" value1="${partnerBusinessPlanLiferayRenewalContact}" />
	</command>

	<command name="assertMDFClaim">
		<var name="key_mdfClaim" value="${partnerMDFClaimID}" />
		<var method="StringUtil#upperCase('${partnerMDFClaimStatus}')" name="partnerMDFClaimStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFClaimID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_CLAIM_PARTNER" value1="${partnerMDFClaimPartner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_CLAIM_STATUS" value1="${partnerMDFClaimStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_CLAIM_TYPE" value1="${partnerMDFClaimType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_CLAIM_AMOUNT_CLAIMED" value1="${partnerMDFClaimAmountClaimed}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_CLAIM_AMOUNT_PAID" value1="${partnerMDFClaimAmountPaid}" />
	</command>

	<command name="assertMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />
		<var method="StringUtil#upperCase('${partnerMDFRequestStatus}')" name="partnerMDFRequestStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_REQUEST_PARTNER" value1="${partnerMDFRequestCompanyName}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_REQUEST_STATUS" value1="${partnerMDFRequestStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_REQUEST_TOTAL_COST" value1="${partnerMDFRequestTotalCost}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_REQUEST_AMOUNT_REQUESTED" value1="${partnerMDFRequestAmountRequested}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerManagement#MDF_REQUEST_AMOUNT_APPROVED" value1="${partnerMDFRequestAmountApproved}" />
	</command>

	<command name="clickBusinessPlan">
		<var name="key_businessPlan" value="${partnerBusinessPlanID}" />

		<execute macro="PartnerManagement#filterBusinessPlanByYear">
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute function="Click" locator1="PartnerManagement#BUSINESS_PLAN_ID" />
	</command>

	<command name="clickMDFClaim">
		<var name="key_mdfClaim" value="${partnerMDFClaimID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFClaimID}" />
		</execute>

		<execute function="Click" locator1="PartnerManagement#MDF_CLAIM_ID" />
	</command>

	<command name="clickMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="Click" locator1="PartnerManagement#MDF_REQUEST_ID" />
	</command>

	<command name="clickNewBusinessPlanButton">
		<execute function="Click" locator1="PartnerManagement#NEW_BUSINESS_PLAN_BUTTON" />
	</command>

	<command name="deleteBusinessPlanConflict">
		<var name="key_businessPlanCompany" value="${partnerBusinessPlanCompany}" />
		<var name="key_businessPlanYear" value="${partnerBusinessPlanYear}" />

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#filterBusinessPlanByYear">
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#formatRegionCode">
			<var name="regionCode" value="${partnerBusinessPlanRegionCode}" />
			<return name="partnerBusinessPlanRegionCode" />
		</execute>

		<var name="key_businessPlanRegionCode" value="${partnerBusinessPlanRegionCode}" />

		<if>
			<condition function="IsElementNotPresent" locator1="PartnerManagement#BUSINESS_PLAN_OPTIONS2" />
			<then>
				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Drafts" />
				</execute>

				<execute macro="PartnerManagement#filterBusinessPlanByYear">
					<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
				</execute>
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="PartnerManagement#BUSINESS_PLAN_OPTIONS2" />

		<execute function="Click" locator1="PartnerManagement#BUSINESS_PLAN_OPTIONS2" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="5000" />
		</execute>
	</command>

	<command name="filterBusinessPlanByYear">
		<var name="key_businessPlanYear" value="${partnerBusinessPlanYear}" />

		<if>
			<condition function="IsElementPresent" locator1="PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR" />
			<then>
				<execute function="Click" locator1="PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR" />
			</then>
		</if>

		<if>
			<and>
				<contains string="${partnerBusinessPlanYear}" substring="20" />
				<condition function="IsElementPresent" locator1="PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR_OPTION" />
			</and>
			<then>
				<execute function="Click" locator1="PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR_OPTION" value1="Year ${partnerBusinessPlanYear}" />
			</then>
		</if>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="viewMDFClaimOptions">
		<var name="key_mdfClaim" value="${partnerMDFClaimID}" />

		<execute function="Click" locator1="PartnerManagement#MDF_CLAIM_OPTIONS" />

		<execute macro="Partner#viewDropdownOptions">
			<var name="partnerNoOptionsList" value="${partnerNoOptionsList}" />
			<var name="partnerOptionsList" value="${partnerOptionsList}" />
		</execute>

		<execute function="Click" locator1="PartnerManagement#MDF_CLAIM_OPTIONS" />
	</command>

	<command name="viewMDFRequestOptions">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="Click" locator1="PartnerManagement#MDF_REQUEST_OPTIONS" />

		<execute macro="Partner#viewDropdownOptions">
			<var name="partnerNoOptionsList" value="${partnerNoOptionsList}" />
			<var name="partnerOptionsList" value="${partnerOptionsList}" />
		</execute>

		<execute function="Click" locator1="PartnerManagement#MDF_REQUEST_OPTIONS" />
	</command>

	<command name="viewNoMDFClaimOptions">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="AssertElementNotPresent" locator1="PartnerManagement#MDF_CLAIM_OPTIONS" />
	</command>

	<command name="viewNoMDFRequestOptions">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="AssertElementNotPresent" locator1="PartnerManagement#MDF_REQUEST_OPTIONS" />
	</command>
</definition>