definition {

	macro assertBusinessPlan {
		var key_businessPlan = "${partnerBusinessPlanID}";
		var partnerBusinessPlanStatus = StringUtil.upperCase("${partnerBusinessPlanStatus}");
		var partnerBusinessPlanRegionCode = Partner.formatRegionCode(regionCode = "${partnerBusinessPlanRegionCode}");

		PartnerManagement.filterBusinessPlanByYear(partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.findRowID(rowID = "${partnerBusinessPlanID}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_PARTNER",
			value1 = "${partnerBusinessPlanCompany}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_REGION_CODE",
			value1 = "${partnerBusinessPlanRegionCode}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_STATUS",
			value1 = "${partnerBusinessPlanStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER",
			value1 = "${partnerBusinessPlanLiferayBusinessPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER",
			value1 = "${partnerBusinessPlanLiferayMarketingPlanOwner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT",
			value1 = "${partnerBusinessPlanLiferayRenewalContact}");
	}

	macro assertMDFClaim {
		var key_mdfClaim = "${partnerMDFClaimID}";
		var partnerMDFClaimStatus = StringUtil.upperCase("${partnerMDFClaimStatus}");

		Partner.findRowID(rowID = "${partnerMDFClaimID}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_CLAIM_PARTNER",
			value1 = "${partnerMDFClaimPartner}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_CLAIM_STATUS",
			value1 = "${partnerMDFClaimStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_CLAIM_TYPE",
			value1 = "${partnerMDFClaimType}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_CLAIM_AMOUNT_CLAIMED",
			value1 = "${partnerMDFClaimAmountClaimed}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_CLAIM_AMOUNT_PAID",
			value1 = "${partnerMDFClaimAmountPaid}");
	}

	macro assertMDFRequest {
		var key_mdfRequest = "${partnerMDFRequestID}";
		var partnerMDFRequestStatus = StringUtil.upperCase("${partnerMDFRequestStatus}");

		Partner.findRowID(rowID = "${partnerMDFRequestID}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_REQUEST_PARTNER",
			value1 = "${partnerMDFRequestCompanyName}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_REQUEST_STATUS",
			value1 = "${partnerMDFRequestStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_REQUEST_TOTAL_COST",
			value1 = "${partnerMDFRequestTotalCost}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_REQUEST_AMOUNT_REQUESTED",
			value1 = "${partnerMDFRequestAmountRequested}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerManagement#MDF_REQUEST_AMOUNT_APPROVED",
			value1 = "${partnerMDFRequestAmountApproved}");
	}

	macro clickBusinessPlan {
		var key_businessPlan = "${partnerBusinessPlanID}";

		PartnerManagement.filterBusinessPlanByYear(partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.findRowID(rowID = "${partnerBusinessPlanID}");

		Click(locator1 = "PartnerManagement#BUSINESS_PLAN_ID");
	}

	macro clickMDFClaim {
		var key_mdfClaim = "${partnerMDFClaimID}";

		Partner.findRowID(rowID = "${partnerMDFClaimID}");

		Click(locator1 = "PartnerManagement#MDF_CLAIM_ID");
	}

	macro clickMDFRequest {
		var key_mdfRequest = "${partnerMDFRequestID}";

		Partner.findRowID(rowID = "${partnerMDFRequestID}");

		Click(locator1 = "PartnerManagement#MDF_REQUEST_ID");
	}

	macro clickNewBusinessPlanButton {
		Click(locator1 = "PartnerManagement#NEW_BUSINESS_PLAN_BUTTON");
	}

	macro deleteBusinessPlanConflict {
		var key_businessPlanCompany = "${partnerBusinessPlanCompany}";
		var key_businessPlanYear = "${partnerBusinessPlanYear}";

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.filterBusinessPlanByYear(partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		var partnerBusinessPlanRegionCode = Partner.formatRegionCode(regionCode = "${partnerBusinessPlanRegionCode}");

		var key_businessPlanRegionCode = "${partnerBusinessPlanRegionCode}";

		if (IsElementNotPresent(locator1 = "PartnerManagement#BUSINESS_PLAN_OPTIONS2")) {
			Partner.gotoTab(tabName = "Drafts");

			PartnerManagement.filterBusinessPlanByYear(partnerBusinessPlanYear = "${partnerBusinessPlanYear}");
		}

		AssertElementPresent(locator1 = "PartnerManagement#BUSINESS_PLAN_OPTIONS2");

		Click(locator1 = "PartnerManagement#BUSINESS_PLAN_OPTIONS2");

		Click(locator1 = "Partner#DROPDOWN_OPTION_DELETE");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		Partner.pause(pauseTime = "2000");

		Partner.assertSuccess();

		Partner.pause(pauseTime = "5000");
	}

	macro filterBusinessPlanByYear {
		var key_businessPlanYear = "${partnerBusinessPlanYear}";

		if (IsElementPresent(locator1 = "PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR")) {
			Click(locator1 = "PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR");
		}

		if (contains("${partnerBusinessPlanYear}", "20") && (IsElementPresent(locator1 = "PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR_OPTION"))) {
			Click(
				locator1 = "PartnerManagement#BUSINESS_PLAN_FILTER_BY_YEAR_OPTION",
				value1 = "Year ${partnerBusinessPlanYear}");
		}

		Partner.pause(pauseTime = "2000");
	}

	macro viewMDFClaimOptions {
		var key_mdfClaim = "${partnerMDFClaimID}";

		Click(locator1 = "PartnerManagement#MDF_CLAIM_OPTIONS");

		Partner.viewDropdownOptions(
			partnerNoOptionsList = "${partnerNoOptionsList}",
			partnerOptionsList = "${partnerOptionsList}");

		Click(locator1 = "PartnerManagement#MDF_CLAIM_OPTIONS");
	}

	macro viewMDFRequestOptions {
		var key_mdfRequest = "${partnerMDFRequestID}";

		Click(locator1 = "PartnerManagement#MDF_REQUEST_OPTIONS");

		Partner.viewDropdownOptions(
			partnerNoOptionsList = "${partnerNoOptionsList}",
			partnerOptionsList = "${partnerOptionsList}");

		Click(locator1 = "PartnerManagement#MDF_REQUEST_OPTIONS");
	}

	macro viewNoMDFClaimOptions {
		var key_mdfRequest = "${partnerMDFRequestID}";

		AssertElementNotPresent(locator1 = "PartnerManagement#MDF_CLAIM_OPTIONS");
	}

	macro viewNoMDFRequestOptions {
		var key_mdfRequest = "${partnerMDFRequestID}";

		AssertElementNotPresent(locator1 = "PartnerManagement#MDF_REQUEST_OPTIONS");
	}

}