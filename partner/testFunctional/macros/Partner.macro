<definition>
	<command name="assertApproveButton">
		<execute function="AssertElementPresent" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="assertComment">
		<var name="key_comment" value="${partnerComment}" />

		<execute function="AssertElementPresent" locator1="Partner#COMMENT_BOX_COMMENT_MESSAGE" />
	</command>

	<command name="assertNoApproveButton">
		<execute function="AssertElementNotPresent" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="assertNoComments">
		<execute function="AssertElementNotPresent" locator1="Partner#COMMENT_BOX_COMMENT" />
	</command>

	<command name="assertNoCommentSection">
		<execute function="AssertElementNotPresent" locator1="Partner#COMMENT_BOX" />
	</command>

	<command name="assertNoManagementView">
		<execute function="AssertElementNotPresent" locator1="Partner#NAVBAR_MANAGEMENT" />
	</command>

	<command name="assertNoSendForManagerReviewButton">
		<execute function="AssertElementNotPresent" locator1="Partner#SEND_FOR_MANAGER_REVIEW_BUTTON" />
	</command>

	<command name="assertSuccess">
		<execute function="AssertTextEquals" locator1="Partner#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="clickApproveButton">
		<execute function="Click" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="clickBackArrow">
		<execute function="Click" locator1="Partner#BACK_ARROW" />
	</command>

	<command name="clickCancelButton">
		<execute function="Click" locator1="Partner#CANCEL_BUTTON" />
	</command>

	<command name="clickEditButton">
		<execute function="Click" locator1="Partner#EDIT_BUTTON" />
	</command>

	<command name="clickLastPage">
		<execute function="Click" locator1="Partner#PAGINATION_LAST_BUTTON" />
	</command>

	<command name="clickNextButton">
		<execute function="Click" locator1="Partner#NEXT_BUTTON" />
	</command>

	<command name="clickNextPage">
		<execute function="Click" locator1="Partner#PAGINATION_NEXT_BUTTON" />
	</command>

	<command name="clickPreviousButton">
		<execute function="Click" locator1="Partner#PREVIOUS_BUTTON" />
	</command>

	<command name="clickPreviousPage">
		<execute function="Click" locator1="Partner#PAGINATION_PREVIOUS_BUTTON" />
	</command>

	<command name="clickRejectButton">
		<execute function="Click" locator1="Partner#REJECT_BUTTON" />
	</command>

	<command name="clickRequestMoreInfoButton">
		<execute function="Click" locator1="Partner#REQUEST_MORE_INFO_BUTTON" />
	</command>

	<command name="clickResendForReviewButton">
		<execute function="Click" locator1="Partner#RESEND_FOR_REVIEW_BUTTON" />
	</command>

	<command name="clickSaveAndContinueButton">
		<execute function="Click" locator1="Partner#SAVE_AND_CONTINUE_BUTTON" />
	</command>

	<command name="clickSaveButton">
		<execute function="Click" locator1="Partner#SAVE_BUTTON" />
	</command>

	<command name="clickSaveDraftButton">
		<execute function="Click" locator1="Partner#SAVE_DRAFT_BUTTON" />
	</command>

	<command name="clickSendForManagerReviewButton">
		<execute function="Click" locator1="Partner#SEND_FOR_MANAGER_REVIEW_BUTTON" />
	</command>

	<command name="clickSubmitButton">
		<execute function="Click" locator1="Partner#SUBMIT_BUTTON" />
	</command>

	<command name="clickSubmitButtonInModal">
		<execute function="Click" locator1="Partner#MODAL_SUBMIT" />
	</command>

	<command name="closeOverlay">
		<if>
			<condition function="IsElementPresent" locator1="Partner#CLOSE_OVERLAY_BUTTON" />
			<then>
				<execute function="Click" locator1="Partner#CLOSE_OVERLAY_BUTTON" />
			</then>
		</if>
	</command>

	<command name="closeSidebar">
		<if>
			<and>
				<condition function="IsElementPresent" locator1="Partner#LIFERAY_SIDEBAR" />
				<condition function="IsVisible" locator1="Partner#LIFERAY_SIDEBAR" />
			</and>
			<then>
				<execute function="Click" locator1="Partner#LIFERAY_SIDEBAR_HIDE" />

				<execute function="AssertNotVisible" locator1="Partner#LIFERAY_SIDEBAR" />
			</then>
		</if>
	</command>

	<command name="findRowID">
		<var name="key_rowID" value="${rowID}" />

		<while>
			<and>
				<condition function="IsElementNotPresent" locator1="Partner#TABLE_ROW_ID" />
				<condition function="IsElementNotPresent" locator1="Partner#PAGINATION_NEXT_BUTTON_DISABLED" />
				<condition function="IsElementPresent" locator1="Partner#PAGINATION_NEXT_BUTTON" />
			</and>
			<then>
				<execute macro="Partner#clickNextPage" />
			</then>
		</while>

		<execute function="KeyPress" locator1="Partner#TABLE_ROW_ID" value1="\DOWN" />
	</command>

	<command name="formatRegionCode">
		<if>
			<or>
				<equals arg1="${regionCode}" arg2="anz" />
				<equals arg1="${regionCode}" arg2="dach" />
				<equals arg1="${regionCode}" arg2="uk" />
				<equals arg1="${regionCode}" arg2="us" />
			</or>
			<then>
				<var method="StringUtil#upperCase('${regionCode}')" name="regionCodeFormatted" />
			</then>
			<elseif>
				<equals arg1="${regionCode}" arg2="" />
				<then>
					<var name="regionCodeFormatted" value="" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="europe" />
				<then>
					<var name="regionCodeFormatted" value="Central and Eastern Europe" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="chpearurpa" />
				<then>
					<var name="regionCodeFormatted" value="ChPeArUrPa" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="coeccenam" />
				<then>
					<var name="regionCodeFormatted" value="CoEcCenAm" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="middleeast" />
				<then>
					<var name="regionCodeFormatted" value="Middle East" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="itgrcy" />
				<then>
					<var name="regionCodeFormatted" value="ItGrCy" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="latinamerica" />
				<then>
					<var name="regionCodeFormatted" value="Latin America" />
				</then>
			</elseif>
			<elseif>
				<equals arg1="${regionCode}" arg2="spainportugal" />
				<then>
					<var name="regionCodeFormatted" value="Spain/Portugal" />
				</then>
			</elseif>
			<else>
				<var method="StringUtil#upperCaseFirstLetter('${regionCode}')" name="regionCodeFormatted" />
			</else>
		</if>

		<return value="${regionCodeFormatted}" />
	</command>

	<command name="formatRoleName">
		<var method="StringUtil#replace('${roleName}','_',' ')" name="roleNameFormatted" />
		<var method="StringUtil#upperCaseFirstLetter('${roleNameFormatted}')" name="roleNameFormatted" />

		<return value="${roleNameFormatted}" />
	</command>

	<command name="gotoCPPartnerAdmin">
		<execute macro="Partner#openURL">
			<var name="appendUrl" value="/group/control_panel/manage?p_p_id=com_liferay_osb_partner_admin_web_PartnerAdminPortlet" />
		</execute>
	</command>

	<command name="gotoCPServerAdministration">
		<execute macro="Partner#openURL">
			<var name="appendUrl" value="/group/control_panel/manage?p_p_id=com_liferay_server_admin_web_portlet_ServerAdminPortlet" />
		</execute>
	</command>

	<command name="gotoHome">
		<execute function="Click" locator1="Partner#NAVBAR_HOME" />
	</command>

	<command name="gotoManagement">
		<execute function="Click" locator1="Partner#NAVBAR_MANAGEMENT" />
	</command>

	<command name="gotoManagementBusinessPlans">
		<execute macro="Partner#gotoManagement" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Business Plans" />
		</execute>
	</command>

	<command name="gotoManagementClaims">
		<execute macro="Partner#gotoManagement" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="MDF Claims" />
		</execute>
	</command>

	<command name="gotoMarketingMDF">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute function="Click" locator1="Partner#NAVBAR_MARKETING" />-->

		<!--<execute macro="PartnerMarketing#gotoMarketingMDF" />-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="mdf" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="gotoSales">
		<execute function="Click" locator1="Partner#NAVBAR_SALES" />
	</command>

	<command name="gotoSalesBusinessPlans">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute function="Click" locator1="Partner#NAVBAR_SALES" />-->

		<!--<execute macro="PartnerSales#gotoBusinessPlans" />-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="sales/business-plans" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="gotoSalesPartnerOpportunities">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute function="Click" locator1="Partner#NAVBAR_SALES" />-->

		<!--<execute macro="PartnerSales#gotoPartnerOpportunities" />-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="sales/opportunities" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="gotoSalesRebatePayment">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute function="Click" locator1="Partner#NAVBAR_MANAGEMENT" />-->

		<!--<execute macro="Partner#gotoTab">
			<var name="tabName" value="Rebate Payment" />
		</execute>-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="sales/rebate-payment" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="gotoSalesRenewalOpportunities">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute function="Click" locator1="Partner#NAVBAR_SALES" />-->

		<!--<execute macro="PartnerSales#gotoRenewalOpportunities" />-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="sales/renewals" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="gotoTab">
		<var name="key_tabName" value="${tabName}" />

		<execute function="Click" locator1="Partner#GENERAL_TAB" />
	</command>

	<command name="impersonateRoleUser">
		<var method="StringUtil#lowerCase('${roleName}')" name="roleName" />

		<if>
			<or>
				<equals arg1="${roleName}" arg2="global_alliance_manager" />
				<equals arg1="${roleName}" arg2="global_partner_marketing" />
			</or>
			<then>
				<var method="PropsUtil#get('partner.userID.${roleName}')" name="userID" />
			</then>
			<else>
				<var method="PropsUtil#get('partner.region.code')" name="partnerRegionCode" />

				<var method="PropsUtil#get('partner.${partnerRegionCode}.userID.${roleName}')" name="userID" />
			</else>
		</if>

		<execute macro="Partner#impersonateUser">
			<var name="appendUrl" value="${appendUrl}" />
			<var name="userID" value="${userID}" />
		</execute>
	</command>

	<command name="impersonateUser">
		<var method="PropsUtil#get('portal.partner.url')" name="partnerUrl" />

		<var method="StringUtil#add('${partnerUrl}', '/${appendUrl}', '')" name="partnerUrl" />

		<var method="StringUtil#add('${partnerUrl}', '?doAsUserId=${userID}', '')" name="partnerUrl" />

		<execute function="Open" locator1="${partnerUrl}" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="5000" />
		</execute>

		<execute macro="Partner#closeSidebar" />
	</command>

	<command name="loginLiferay">
		<var method="PropsUtil#get('partner.email.address.admin')" name="userEmailAddress" />
		<var method="PropsUtil#get('partner.email.password.admin')" name="userPassword" />

		<execute macro="Partner#openURL" />

		<execute function="Type" locator1="Partner#LIFERAY_EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="Partner#LIFERAY_PASSWORD_FIELD" value1="${userPassword}" />

		<execute function="Click" locator1="Partner#LIFERAY_SIGN_IN_LINK" />
	</command>

	<command name="loginUser">
		<var method="StringUtil#lowerCase('${roleName}')" name="roleName" />

		<if>
			<or>
				<equals arg1="${roleName}" arg2="global_alliance_manager" />
				<equals arg1="${roleName}" arg2="global_partner_marketing" />
				<equals arg1="${roleName}" arg2="admin" />
			</or>
			<then>
				<var method="PropsUtil#get('partner.email.address.${roleName}')" name="userEmailAddress" />
			</then>
			<else>
				<var method="PropsUtil#get('partner.region.code')" name="partnerRegionCode" />

				<var method="PropsUtil#get('partner.${partnerRegionCode}.email.address.${roleName}')" name="userEmailAddress" />
			</else>
		</if>

		<if>
			<equals arg1="${roleName}" arg2="admin" />
			<then>
				<var method="PropsUtil#get('partner.email.password.${roleName}')" name="userPassword" />
			</then>
			<else>
				<var name="userPassword" value="test" />
			</else>
		</if>

		<execute macro="Partner#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="Partner#HOME_SIGN_IN_LINK" />
			<then>
				<execute function="Click" locator1="Partner#HOME_SIGN_IN_LINK" />
			</then>
		</if>

		<execute function="Type" locator1="Partner#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="Partner#PASSWORD_FIELD" value1="${userPassword}" />

		<execute macro="Partner#closeOverlay" />

		<execute function="AssertClick" locator1="Partner#SIGN_IN_BUTTON" value1="Sign In" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="logoutAndLoginUser">

		<!--LRQA-44000 Uncomment if not impersonating-->

		<!--<execute macro="Partner#logoutUserCP" />-->

		<!--<execute macro="Partner#loginUser">
			<var name="roleName" value="${roleName}" />
		</execute>-->

		<execute macro="Partner#impersonateRoleUser">
			<var name="appendUrl" value="home" />
			<var name="roleName" value="${roleName}" />
		</execute>
	</command>

	<command name="logoutUser">
		<if>
			<condition function="IsElementPresent" locator1="Partner#USER_DROPDOWN_ICON" />
			<then>
				<execute function="Click" locator1="Partner#USER_DROPDOWN_ICON" />

				<execute function="Click" locator1="Partner#SIGN_OUT_LINK" />
			</then>
		</if>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="logoutUserCP">
		<execute macro="Partner#openURL">
			<var name="appendUrl" value="/c/portal/logout" />
		</execute>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="openSpecificURL">
		<execute function="Open" locator1="${url}" />
	</command>

	<command name="openURL">
		<var method="PropsUtil#get('portal.partner.url')" name="partnerUrl" />

		<if>
			<and>
				<isset var="appendUrl" />
				<not>
					<contains string="${appendUrl}" substring="{appendUrl}" />
				</not>
			</and>
			<then>
				<var method="StringUtil#add('${partnerUrl}', '${appendUrl}', '')" name="partnerUrl" />
			</then>
		</if>

		<execute function="Open" locator1="${partnerUrl}" />
	</command>

	<command name="pause">
		<execute function="Pause" locator1="${pauseTime}" />
	</command>

	<command name="readLastRowID">
		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<if>
			<and>
				<condition function="IsElementNotPresent" locator1="Partner#PAGINATION_LAST_BUTTON_DISABLED" />
				<condition function="IsElementPresent" locator1="Partner#PAGINATION_LAST_BUTTON" />
			</and>
			<then>
				<execute macro="Partner#clickLastPage" />
			</then>
		</if>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<var method="selenium#getText(Partner#TABLE_LAST_ROW_ID)" name="rowID" />

		<echo>ID: ${rowID}</echo>

		<return value="${rowID}" />
	</command>

	<command name="readTitleID">
		<var method="selenium#getText(Partner#TITLE_ID)" name="titleID" />

		<var method="StringUtil#extractDigits('${titleID}')" name="titleID" />

		<echo>ID: ${titleID}</echo>

		<return value="${titleID}" />
	</command>

	<command name="reloadPage">
		<execute function="KeyPress" locator1="Partner#NAVBAR_HOME" value1="\F5" />
	</command>

	<command name="typeCommentInModal">
		<execute function="Type#sendKeys" locator1="Partner#MODAL_COMMENT" value1="${partnerComment}" />
	</command>

	<command name="unselectOptions">
		<for list="${unselectOptionList}" param="option">
			<var name="key_option" value="${option}" />

			<execute function="Click" locator1="Partner#SELECT_OPTION" />
		</for>

		<for list="${selectOptionList}" param="option">
			<var name="key_option" value="${option}" />

			<execute function="Click" locator1="Partner#SELECT_OPTION" />
		</for>
	</command>

	<command name="viewDropdownOptions">
		<for list="${partnerOptionsList}" param="option">
			<var name="key_option" value="${option}" />

			<execute function="AssertElementPresent" locator1="Partner#DROPDOWN_OPTION" />
		</for>

		<if>
			<and>
				<isset var="partnerNoOptionsList" />
				<not>
					<contains string="${partnerNoOptionsList}" substring="{partnerNoOptionsList}" />
				</not>
			</and>
			<then>
				<for list="${partnerNoOptionsList}" param="option">
					<var name="key_option" value="${option}" />

					<execute function="AssertElementNotPresent" locator1="Partner#DROPDOWN_OPTION" />
				</for>
			</then>
		</if>
	</command>
</definition>