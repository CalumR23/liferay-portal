	}

	macro closeSidebar {
		if ((IsElementPresent(locator1 = "Partner#LIFERAY_SIDEBAR")) && (IsVisible(locator1 = "Partner#LIFERAY_SIDEBAR"))) {
			Click(locator1 = "Partner#LIFERAY_SIDEBAR_HIDE");

			AssertNotVisible(locator1 = "Partner#LIFERAY_SIDEBAR");
		}
	}

	macro findRowID {
		var key_rowID = "${rowID}";

		while ((IsElementNotPresent(locator1 = "Partner#TABLE_ROW_ID")) && (IsElementNotPresent(locator1 = "Partner#PAGINATION_NEXT_BUTTON_DISABLED")) && (IsElementPresent(locator1 = "Partner#PAGINATION_NEXT_BUTTON"))) {
			Partner.clickNextPage();
		}

		KeyPress(
			locator1 = "Partner#TABLE_ROW_ID",
			value1 = "\DOWN");
	}

	macro formatRegionCode {
		if (("${regionCode}" == "anz") || ("${regionCode}" == "dach") || ("${regionCode}" == "uk") || ("${regionCode}" == "us")) {
			var regionCodeFormatted = StringUtil.upperCase("${regionCode}");
		}
		else if ("${regionCode}" == "") {
			var regionCodeFormatted = "";
		}
		else if ("${regionCode}" == "europe") {
			var regionCodeFormatted = "Central and Eastern Europe";
		}
		else if ("${regionCode}" == "chpearurpa") {
			var regionCodeFormatted = "ChPeArUrPa";
		}
		else if ("${regionCode}" == "coeccenam") {
			var regionCodeFormatted = "CoEcCenAm";
		}
		else if ("${regionCode}" == "middleeast") {
			var regionCodeFormatted = "Middle East";
		}
		else if ("${regionCode}" == "itgrcy") {
			var regionCodeFormatted = "ItGrCy";
		}
		else if ("${regionCode}" == "latinamerica") {
			var regionCodeFormatted = "Latin America";
		}
		else if ("${regionCode}" == "spainportugal") {
			var regionCodeFormatted = "Spain/Portugal";
		}
		else {
			var regionCodeFormatted = StringUtil.upperCaseFirstLetter("${regionCode}");
		}

		return "${regionCodeFormatted}";
	}

	macro formatRoleName {
		var roleNameFormatted = StringUtil.replace("${roleName}", "_", " ");

		var roleNameFormatted = StringUtil.upperCaseFirstLetter("${roleNameFormatted}");

		return "${roleNameFormatted}";
	}

	macro gotoCPPartnerAdmin {
		Partner.openURL(appendUrl = "/group/control_panel/manage?p_p_id=com_liferay_osb_partner_admin_web_PartnerAdminPortlet");
	}

	macro gotoCPServerAdministration {
		Partner.openURL(appendUrl = "/group/control_panel/manage?p_p_id=com_liferay_server_admin_web_portlet_ServerAdminPortlet");
	}

	macro gotoHome {
		Click(locator1 = "Partner#NAVBAR_HOME");
	}

	macro gotoManagement {
