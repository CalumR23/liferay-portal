<definition>
	<var method="TestPropsUtil#get('portal.url')" name="partnerUrl" />

	<command name="assertApproveButton">
		<execute function="AssertElementPresent" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="assertComment">
		<var name="key_comment" value="${partnerComment}" />

		<execute function="AssertElementPresent" locator1="Partner#COMMENT_BOX_CONTENT" />
	</command>

	<command name="assertID">
		<if>
			<equals arg1="${entryID}" arg2="" />
			<then>
				<fail message="ID is not valid: ${entryID}" />
			</then>
		</if>
	</command>

	<command name="assertNoApproveButton">
		<execute function="AssertElementNotPresent" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="assertNoSendForManagerReviewButton">
		<execute function="AssertElementNotPresent" locator1="Partner#SEND_FOR_MANAGER_REVIEW_BUTTON" />
	</command>

	<command name="assertSuccess">
		<execute function="AssertTextEquals" locator1="Partner#SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="clickApproveButton">
		<execute function="Click" locator1="Partner#APPROVE_BUTTON" />
	</command>

	<command name="clickBackArrow">
		<execute function="Click" locator1="Partner#BACK_ARROW" />
	</command>

	<command name="clickCancelButton">
		<execute function="Click" locator1="Partner#CANCEL_BUTTON" />
	</command>

	<command name="clickEditButton">
		<execute function="Click" locator1="Partner#EDIT_BUTTON" />
	</command>

	<command name="clickLastPage">
		<execute function="Click" locator1="Partner#PAGINATION_LAST_BUTTON" />
	</command>

	<command name="clickNextButton">
		<execute function="Click" locator1="Partner#NEXT_BUTTON" />
	</command>

	<command name="clickNextPage">
		<execute function="Click" locator1="Partner#PAGINATION_NEXT_BUTTON" />
	</command>

	<command name="clickPreviousButton">
		<execute function="Click" locator1="Partner#PREVIOUS_BUTTON" />
	</command>

	<command name="clickPreviousPage">
		<execute function="Click" locator1="Partner#PAGINATION_PREVIOUS_BUTTON" />
	</command>

	<command name="clickRejectButton">
		<execute function="Click" locator1="Partner#REJECT_BUTTON" />
	</command>

	<command name="clickRequestMoreInfoButton">
		<execute function="Click" locator1="Partner#REQUEST_MORE_INFO_BUTTON" />
	</command>

	<command name="clickResendForReviewButton">
		<execute function="Click" locator1="Partner#RESEND_FOR_REVIEW_BUTTON" />
	</command>

	<command name="clickSaveAndContinueButton">
		<execute function="Click" locator1="Partner#SAVE_AND_CONTINUE_BUTTON" />
	</command>

	<command name="clickSaveDraftButton">
		<execute function="Click" locator1="Partner#SAVE_DRAFT_BUTTON" />
	</command>

	<command name="clickSendForManagerReviewButton">
		<execute function="Click" locator1="Partner#SEND_FOR_MANAGER_REVIEW_BUTTON" />
	</command>

	<command name="clickSubmitButton">
		<execute function="Click" locator1="Partner#SUBMIT_BUTTON" />
	</command>

	<command name="clickSubmitButtonInModal">
		<execute function="Click" locator1="Partner#MODAL_SUBMIT" />
	</command>

	<command name="findRowID">
		<var name="key_rowID" value="${rowID}" />

		<while>
			<and>
				<condition function="IsElementNotPresent" locator1="Partner#TABLE_ROW_ID" />
				<condition function="IsElementNotPresent" locator1="Partner#PAGINATION_NEXT_BUTTON_DISABLED" />
				<condition function="IsElementPresent" locator1="Partner#PAGINATION_NEXT_BUTTON" />
			</and>
			<then>
				<execute macro="Partner#clickNextPage" />
			</then>
		</while>
	</command>

	<command name="gotoHome">
		<execute function="Click" locator1="Partner#NAVBAR_HOME" />
	</command>

	<command name="gotoMDFManager">
		<execute function="Click" locator1="Partner#NAVBAR_MANAGEMENT" />
	</command>

	<command name="gotoMDFManagerBusinessPlans">
		<execute macro="Partner#gotoMDFManager" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Business Plans" />
		</execute>
	</command>

	<command name="gotoMDFManagerClaims">
		<execute macro="Partner#gotoMDFManager" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="MDF Claims" />
		</execute>
	</command>

	<command name="gotoMDFPartner">
		<execute function="Click" locator1="Partner#NAVBAR_MARKETING" />

		<execute macro="PartnerMarketing#gotoMDFPartner" />
	</command>

	<command name="gotoSales">
		<execute function="Click" locator1="Partner#NAVBAR_SALES" />
	</command>

	<command name="gotoTab">
		<var name="key_tabName" value="${tabName}" />

		<execute function="Click" locator1="Partner#GENERAL_TAB" />
	</command>

	<command name="loginUser">
		<var method="StringUtil#lowerCase('${key_role}')" name="key_role" />

		<var method="TestPropsUtil#get('partner.email.address.${key_role}')" name="userEmailAddress" />
		<var method="TestPropsUtil#get('partner.email.password.${key_role}')" name="userPassword" />

		<execute macro="Partner#openURL" />

		<if>
			<condition function="IsElementPresent" locator1="Partner#HOME_SIGN_IN_LINK" />
			<then>
				<execute function="Click" locator1="Partner#HOME_SIGN_IN_LINK" />
			</then>
		</if>

		<execute function="Type" locator1="Partner#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="Partner#PASSWORD_FIELD" value1="${userPassword}" />

		<execute function="AssertClick" locator1="Partner#SIGN_IN_BUTTON" value1="Sign In" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="logoutAndLoginUser">
		<if>
			<condition function="IsElementPresent" locator1="Partner#USER_DROPDOWN_ICON" />
			<then>
				<execute macro="Partner#logoutUser" />
			</then>
		</if>

		<execute macro="Partner#loginUser">
			<var name="key_role" value="${roleName}" />
		</execute>
	</command>

	<command name="logoutUser">
		<execute function="Click" locator1="Partner#USER_DROPDOWN_ICON" />

		<execute function="Click" locator1="Partner#SIGN_OUT_LINK" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>
	</command>

	<command name="openURL">
		<execute function="Open" locator1="${partnerUrl}" />
	</command>

	<command name="pause">
		<execute function="Pause" locator1="${pauseTime}" />
	</command>

	<command name="readLastRowID" returns="rowID">
		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<if>
			<and>
				<condition function="IsElementNotPresent" locator1="Partner#PAGINATION_LAST_BUTTON_DISABLED" />
				<condition function="IsElementPresent" locator1="Partner#PAGINATION_LAST_BUTTON" />
			</and>
			<then>
				<execute macro="Partner#clickLastPage" />
			</then>
		</if>

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<var locator="Partner#TABLE_LAST_ROW_ID" name="rowID" />

		<echo>ID: ${rowID}</echo>

		<return name="rowID" value="${rowID}" />
	</command>

	<command name="readTitleID" returns="titleID">
		<var locator="Partner#TITLE_ID" name="titleID" />

		<var method="StringUtil#extractDigits('${titleID}')" name="titleID" />

		<echo>ID: ${titleID}</echo>

		<return name="titleID" value="${titleID}" />
	</command>

	<command name="reloadPage">
		<execute function="KeyPress" locator1="Partner#NAVBAR_HOME" value1="\F5" />
	</command>

	<command name="typeCommentInModal">
		<execute function="Type#sendKeys" locator1="Partner#MODAL_COMMENT" value1="${partnerMDFRequestComment}" />
	</command>

	<command name="unselectOptions">
		<for list="${unselectOptionList}" param="option">
			<var name="key_option" value="${option}" />

			<execute function="Click" locator1="Partner#SELECT_OPTION" />
		</for>

		<for list="${selectOptionList}" param="option">
			<var name="key_option" value="${option}" />

			<execute function="Click" locator1="Partner#SELECT_OPTION" />
		</for>
	</command>
</definition>