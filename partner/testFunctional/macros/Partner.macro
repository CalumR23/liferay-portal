	macro gotoTab {
		var key_tabName = "${tabName}";

		Click(locator1 = "Partner#GENERAL_TAB");
	}

	macro impersonateRoleUser {
		var roleName = StringUtil.lowerCase("${roleName}");

		if (("${roleName}" == "global_alliance_manager") || ("${roleName}" == "global_partner_marketing")) {
			var userID = PropsUtil.get("partner.userID.${roleName}");
		}
		else {
			var partnerRegionCode = PropsUtil.get("partner.region.code");

			var userID = PropsUtil.get("partner.${partnerRegionCode}.userID.${roleName}");
		}

		Partner.impersonateUser(
			appendUrl = "${appendUrl}",
			userID = "${userID}");
	}

	macro impersonateUser {
		var partnerUrl = PropsUtil.get("portal.partner.url");

		var partnerUrl = StringUtil.add("${partnerUrl}", "/${appendUrl}", "");

		var partnerUrl = StringUtil.add("${partnerUrl}", "?doAsUserId=${userID}", "");

		Open(locator1 = "${partnerUrl}");

		Partner.pause(pauseTime = "5000");

		Partner.closeSidebar();
	}

	macro loginLiferay {
		if (isSet(specificURL)) {
			Partner.openSpecificURL(url = "${specificURL}");
		}
		else {
			var userEmailAddress = PropsUtil.get("partner.email.address.admin");
			var userPassword = PropsUtil.get("partner.email.password.admin");

			Partner.openURL();
		}

		Type(
			locator1 = "Partner#LIFERAY_EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Partner#LIFERAY_PASSWORD_FIELD",
			value1 = "${userPassword}");

		Click(locator1 = "Partner#LIFERAY_SIGN_IN_LINK");
	}

	macro loginUser {
		var roleName = StringUtil.lowerCase("${roleName}");

		if (("${roleName}" == "global_alliance_manager") || ("${roleName}" == "global_partner_marketing") || ("${roleName}" == "admin")) {
			var userEmailAddress = PropsUtil.get("partner.email.address.${roleName}");
		}
		else {
			var partnerRegionCode = PropsUtil.get("partner.region.code");

			var userEmailAddress = PropsUtil.get("partner.${partnerRegionCode}.email.address.${roleName}");
		}

		if ("${roleName}" == "admin") {
			var userPassword = PropsUtil.get("partner.email.password.${roleName}");
		}
		else {
			var userPassword = "test";
		}

		Partner.openURL();

		if (IsElementPresent(locator1 = "Partner#HOME_SIGN_IN_LINK")) {
			Click(locator1 = "Partner#HOME_SIGN_IN_LINK");
		}

		Type(
			locator1 = "Partner#EMAIL_ADDRESS_FIELD",
			value1 = "${userEmailAddress}");

		Type(
			locator1 = "Partner#PASSWORD_FIELD",
			value1 = "${userPassword}");

		Partner.closeOverlay();

		AssertClick(
			locator1 = "Partner#SIGN_IN_BUTTON",
			value1 = "Sign In");

		Partner.pause(pauseTime = "2000");
	}

	macro logoutAndLoginUser {

		// LRQA-44000 Uncomment if not impersonating

		//Partner.logoutUserCP();
		//PartnerSales.loginUser(roleName = "${roleName}");

		Partner.impersonateRoleUser(
			appendUrl = "home",
			roleName = "${roleName}");
	}

	macro logoutUser {
		if (IsElementPresent(locator1 = "Partner#USER_DROPDOWN_ICON")) {
			Click(locator1 = "Partner#USER_DROPDOWN_ICON");

			Click(locator1 = "Partner#SIGN_OUT_LINK");
		}

		Partner.pause(pauseTime = "2000");
	}

	macro logoutUserCP {
		Partner.openURL(appendUrl = "/c/portal/logout");

		Partner.pause(pauseTime = "2000");
	}

	macro openSpecificURL {
		Open(locator1 = "${url}");
	}

	macro openURL {
		var partnerUrl = PropsUtil.get("portal.partner.url");

		if (isSet(appendUrl) && isSet(appendUrl)) {
			var partnerUrl = StringUtil.add("${partnerUrl}", "${appendUrl}", "");
		}

		Open(locator1 = "${partnerUrl}");
	}

	macro pause {
		Pause(locator1 = "${pauseTime}");
	}

	macro readLastRowID {
		Partner.pause(pauseTime = "2000");

		if ((IsElementNotPresent(locator1 = "Partner#PAGINATION_LAST_BUTTON_DISABLED")) && (IsElementPresent(locator1 = "Partner#PAGINATION_LAST_BUTTON"))) {
			Partner.clickLastPage();
		}

		Partner.pause(pauseTime = "2000");

		var rowID = selenium.getText("Partner#TABLE_LAST_ROW_ID");

		echo("ID: ${rowID}");

		return "${rowID}";
	}

	macro readTitleID {
		var titleID = selenium.getText("Partner#TITLE_ID");

		var titleID = StringUtil.extractDigits("${titleID}");

		echo("ID: ${titleID}");

		return "${titleID}";
	}

	macro reloadPage {
		KeyPress(
			locator1 = "Partner#NAVBAR_HOME",
			value1 = "\F5");
	}

	macro typeCommentInModal {
		Type.sendKeys(
			locator1 = "Partner#MODAL_COMMENT",
			value1 = "${partnerComment}");
	}

	macro unselectOptions {
		for (var option : list "${unselectOptionList}") {
			var key_option = "${option}";

			Click(locator1 = "Partner#SELECT_OPTION");
		}

		for (var option : list "${selectOptionList}") {
			var key_option = "${option}";

			Click(locator1 = "Partner#SELECT_OPTION");
		}
	}

	macro viewDropdownOptions {
		for (var option : list "${partnerOptionsList}") {
			var key_option = "${option}";

			AssertElementPresent(locator1 = "Partner#DROPDOWN_OPTION");
		}

		if (isSet(partnerNoOptionsList) && isSet(partnerNoOptionsList)) {
			for (var option : list "${partnerNoOptionsList}") {
				var key_option = "${option}";

				AssertElementNotPresent(locator1 = "Partner#DROPDOWN_OPTION");
			}
		}
	}

}