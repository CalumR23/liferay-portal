definition {

	macro assertRenewalOpportunity {
		var key_partnerRenewalOpportunity = "${partnerRenewalOpportunityAccount}";

		Partner.findRowID(rowID = "${partnerOpportunityProspectAccountName}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_ACCOUNT",
			value1 = "${partnerRenewalOpportunityAccount}");

		if (isSet(partnerRenewalOpportunityStage) && isSet(partnerRenewalOpportunityStage)) {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_STAGE",
				value1 = "${partnerRenewalOpportunityStage}");
		}

		if (isSet(partnerRenewalOpportunityStatus) && isSet(partnerRenewalOpportunityStatus)) {
			var partnerRenewalOpportunityStatus = StringUtil.upperCase("${partnerRenewalOpportunityStatus}");

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_STATUS",
				value1 = "${partnerRenewalOpportunityStatus}");
		}
	}

	macro clickRenewalOpportunity {
		var key_partnerRenewalOpportunity = "${partnerRenewalOpportunityAccount}";

		Click(locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_ACCOUNT");
	}

	macro closeLostOpportunity {
		var key_option = "Lost Opportunity";
		var key_partnerRenewalOpportunity = "${partnerRenewalOpportunityAccount}";

		Click(locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_OPTIONS");

		Click(locator1 = "Partner#DROPDOWN_OPTION");

		Partner.pause(pauseTime = "3000");

		Partner.assertSuccess();
	}

	macro closeWonOpportunity {
		var key_option = "Won Opportunity";
		var key_partnerRenewalOpportunity = "${partnerRenewalOpportunityAccount}";

		Click(locator1 = "PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_OPTIONS");

		Click(locator1 = "Partner#DROPDOWN_OPTION");

		Partner.pause(pauseTime = "3000");

		Partner.assertSuccess();
	}

}