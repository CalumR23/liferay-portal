<definition>
	<command name="assertRenewalOpportunity">
		<var name="key_partnerRenewalOpportunity" value="${partnerRenewalOpportunityAccount}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerOpportunityProspectAccountName}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_ACCOUNT" value1="${partnerRenewalOpportunityAccount}" />

		<if>
			<and>
				<isset var="partnerRenewalOpportunityStage" />
				<not>
					<contains string="${partnerRenewalOpportunityStage}" substring="{partnerRenewalOpportunityStage}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_STAGE" value1="${partnerRenewalOpportunityStage}" />
			</then>
		</if>

		<if>
			<and>
				<isset var="partnerRenewalOpportunityStatus" />
				<not>
					<contains string="${partnerRenewalOpportunityStatus}" substring="{partnerRenewalOpportunityStatus}" />
				</not>
			</and>
			<then>
				<var method="StringUtil#upperCase('${partnerRenewalOpportunityStatus}')" name="partnerRenewalOpportunityStatus" />

				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_STATUS" value1="${partnerRenewalOpportunityStatus}" />
			</then>
		</if>
	</command>

	<command name="clickRenewalOpportunity">
		<var name="key_partnerRenewalOpportunity" value="${partnerRenewalOpportunityAccount}" />

		<execute function="Click" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_ACCOUNT" />
	</command>

	<command name="closeLostOpportunity">
		<var name="key_option" value="Lost Opportunity" />
		<var name="key_partnerRenewalOpportunity" value="${partnerRenewalOpportunityAccount}" />

		<execute function="Click" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="3000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="closeWonOpportunity">
		<var name="key_option" value="Won Opportunity" />
		<var name="key_partnerRenewalOpportunity" value="${partnerRenewalOpportunityAccount}" />

		<execute function="Click" locator1="PartnerRenewalOpportunities#RENEWAL_OPPORTUNITY_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION" />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="3000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>
</definition>