definition {

	macro deleteBusinessPlan {
		var partnerScript = '''import com.liferay.osb.partner.business.plan.model.BusinessPlan;import com.liferay.osb.partner.business.plan.service.BusinessPlanLocalServiceUtil;BusinessPlan businessPlan = BusinessPlanLocalServiceUtil.fetchBusinessPlan(ID_NUMBER);if (businessPlan != null) {BusinessPlanLocalServiceUtil.deleteBusinessPlan(businessPlan.getBusinessPlanId());}''';

		var partnerScript = StringUtil.replace("${partnerScript}", "ID_NUMBER", "${partnerBusinessPlanID}");

		PartnerCPServerAdministration.executeScript(partnerScript = "${partnerScript}");
	}

	macro deleteMDFRequest {
		var partnerScript = '''import com.liferay.osb.partner.mdf.model.MDFRequest;import com.liferay.osb.partner.mdf.service.MDFRequestLocalServiceUtil;MDFRequest mdfRequest = MDFRequestLocalServiceUtil.fetchMDFRequest(ID_NUMBER);if (mdfRequest != null) {MDFRequestLocalServiceUtil.deleteMDFRequest(mdfRequest.getMdfRequestId());}''';

		var partnerScript = StringUtil.replace("${partnerScript}", "ID_NUMBER", "${partnerMDFRequestID}");

		PartnerCPServerAdministration.executeScript(partnerScript = "${partnerScript}");
	}

	macro executeResourcesAction {
		var key_action = "${partnerCPAction}";

		Click(locator1 = "PartnerCPServerAdministration#EXECUTE_ACTION_BUTTON");
	}

	macro executeScript {
		SelectFieldText(locator1 = "PartnerCPServerAdministration#SCRIPT_TEXTBOX");

		Type.sendKeys(
			locator1 = "PartnerCPServerAdministration#SCRIPT_TEXTBOX",
			value1 = "${partnerScript}");

		Click(locator1 = "PartnerCPServerAdministration#EXECUTE_BUTTON");

		AssertElementPresent(locator1 = "Partner#SUCCESS_MESSAGE");

		Click(locator1 = "Partner#SUCCESS_MESSAGE_CLOSE");
	}

}