<definition>
	<command name="deleteBusinessPlan">
		<var name="partnerScript"><![CDATA[import com.liferay.osb.partner.business.plan.model.BusinessPlan;import com.liferay.osb.partner.business.plan.service.BusinessPlanLocalServiceUtil;BusinessPlan businessPlan = BusinessPlanLocalServiceUtil.fetchBusinessPlan(ID_NUMBER);if (businessPlan != null) {BusinessPlanLocalServiceUtil.deleteBusinessPlan(businessPlan.getBusinessPlanId());}]]></var>

		<var method="StringUtil#replace('${partnerScript}', 'ID_NUMBER', '${partnerBusinessPlanID}')" name="partnerScript" />

		<execute macro="PartnerCPServerAdministration#executeScript">
			<var name="partnerScript" value="${partnerScript}" />
		</execute>
	</command>

	<command name="deleteMDFRequest">
		<var name="partnerScript"><![CDATA[import com.liferay.osb.partner.mdf.model.MDFRequest;import com.liferay.osb.partner.mdf.service.MDFRequestLocalServiceUtil;MDFRequest mdfRequest = MDFRequestLocalServiceUtil.fetchMDFRequest(ID_NUMBER);if (mdfRequest != null) {MDFRequestLocalServiceUtil.deleteMDFRequest(mdfRequest.getMdfRequestId());}]]></var>

		<var method="StringUtil#replace('${partnerScript}', 'ID_NUMBER', '${partnerMDFRequestID}')" name="partnerScript" />

		<execute macro="PartnerCPServerAdministration#executeScript">
			<var name="partnerScript" value="${partnerScript}" />
		</execute>
	</command>

	<command name="executeResourcesAction">
		<var name="key_action" value="${partnerCPAction}" />

		<execute function="Click" locator1="PartnerCPServerAdministration#EXECUTE_ACTION_BUTTON" />
	</command>

	<command name="executeScript">
		<execute function="SelectFieldText" locator1="PartnerCPServerAdministration#SCRIPT_TEXTBOX" />
		<execute function="Type#sendKeys" locator1="PartnerCPServerAdministration#SCRIPT_TEXTBOX" value1="${partnerScript}" />

		<execute function="Click" locator1="PartnerCPServerAdministration#EXECUTE_BUTTON" />

		<execute function="AssertElementPresent" locator1="Partner#SUCCESS_MESSAGE" />
		<execute function="Click" locator1="Partner#SUCCESS_MESSAGE_CLOSE" />
	</command>
</definition>