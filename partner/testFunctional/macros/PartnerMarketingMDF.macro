<definition>
	<command name="assertMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />
		<var method="StringUtil#upperCase('${partnerMDFRequestStatus}')" name="partnerMDFRequestStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMarketingMDF#MDF_REQUEST_STATUS" value1="${partnerMDFRequestStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMarketingMDF#MDF_REQUEST_FUNDING_PERIOD" value1="${partnerMDFRequestFundingPeriod}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMarketingMDF#MDF_REQUEST_TOTAL_COST" value1="${partnerMDFRequestTotalCost}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMarketingMDF#MDF_REQUEST_AMOUNT_REQUESTED" value1="${partnerMDFRequestAmountRequested}" />

		<if>
			<and>
				<isset var="partnerMDFClaimID" />
				<isset var="partnerMDFClaimStatus" />
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMarketingMDF#MDF_REQUEST_REIMBURSEMENT_CLAIMS" value1="Claim-${partnerMDFClaimID}: ${partnerMDFClaimStatus}" />
			</then>
		</if>
	</command>

	<command name="clickMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="Click" locator1="PartnerMarketingMDF#MDF_REQUEST_ID" />
	</command>

	<command name="clickNewMDFRequestButton">
		<execute function="Click" locator1="PartnerMarketingMDF#NEW_MDF_REQUEST_BUTTON" />
	</command>

	<command name="deleteMDFRequestConflict">
		<var name="key_mdfRequest" value="${partnerMDFRequestFundingPeriod}" />

		<execute macro="Partner#gotoMarketingMDF">
			<var name="roleName" value="${roleName}" />
		</execute>

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Active" />
		</execute>

		<if>
			<condition function="IsElementNotPresent" locator1="PartnerMarketingMDF#MDF_REQUEST_ID" />
			<then>
				<execute macro="Partner#gotoMarketingMDF">
					<var name="roleName" value="${roleName}" />
				</execute>

				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Completed" />
				</execute>
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="PartnerMarketingMDF#MDF_REQUEST_ID" />

		<var locator="PartnerMarketingMDF#MDF_REQUEST_ID" name="conflictID" />

		<execute macro="PartnerWorkflow#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${conflictID}" />
		</execute>
	</command>

	<command name="duplicateMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />
		<var name="key_option" value="Duplicate" />

		<execute function="Click" locator1="PartnerMarketingMDF#MDF_REQUEST_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION" />
	</command>

	<command name="viewMDFRequestOptions">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="Click" locator1="PartnerMarketingMDF#MDF_REQUEST_OPTIONS" />

		<execute macro="Partner#viewDropdownOptions">
			<var name="partnerNoOptionsList" value="${partnerNoOptionsList}" />
			<var name="partnerOptionsList" value="${partnerOptionsList}" />
		</execute>

		<execute function="Click" locator1="PartnerMarketingMDF#MDF_REQUEST_OPTIONS" />
	</command>
</definition>