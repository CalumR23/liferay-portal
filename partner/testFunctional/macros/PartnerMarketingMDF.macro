definition {

	macro assertMDFRequest {
		var key_mdfRequest = "${partnerMDFRequestID}";
		var partnerMDFRequestStatus = StringUtil.upperCase("${partnerMDFRequestStatus}");

		Partner.findRowID(rowID = "${partnerMDFRequestID}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMarketingMDF#MDF_REQUEST_STATUS",
			value1 = "${partnerMDFRequestStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMarketingMDF#MDF_REQUEST_FUNDING_PERIOD",
			value1 = "${partnerMDFRequestFundingPeriod}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMarketingMDF#MDF_REQUEST_TOTAL_COST",
			value1 = "${partnerMDFRequestTotalCost}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMarketingMDF#MDF_REQUEST_AMOUNT_REQUESTED",
			value1 = "${partnerMDFRequestAmountRequested}");

		if (isSet(partnerMDFClaimID) && isSet(partnerMDFClaimStatus)) {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMarketingMDF#MDF_REQUEST_REIMBURSEMENT_CLAIMS",
				value1 = "Claim-${partnerMDFClaimID}: ${partnerMDFClaimStatus}");
		}
	}

	macro clickMDFRequest {
		var key_mdfRequest = "${partnerMDFRequestID}";

		Partner.findRowID(rowID = "${partnerMDFRequestID}");

		Click(locator1 = "PartnerMarketingMDF#MDF_REQUEST_ID");
	}

	macro clickNewMDFRequestButton {
		Click(locator1 = "PartnerMarketingMDF#NEW_MDF_REQUEST_BUTTON");
	}

	macro deleteMDFRequestConflict {
		var key_mdfRequest = "${partnerMDFRequestFundingPeriod}";

		Partner.gotoMarketingMDF(roleName = "${roleName}");

		Partner.gotoTab(tabName = "Active");

		if (IsElementNotPresent(locator1 = "PartnerMarketingMDF#MDF_REQUEST_ID")) {
			Partner.gotoMarketingMDF(roleName = "${roleName}");

			Partner.gotoTab(tabName = "Completed");
		}

		AssertElementPresent(locator1 = "PartnerMarketingMDF#MDF_REQUEST_ID");

		var conflictID = selenium.getText("PartnerMarketingMDF#MDF_REQUEST_ID");

		PartnerWorkflow.deleteMDFRequest(partnerMDFRequestID = "${conflictID}");
	}

	macro duplicateMDFRequest {
		var key_mdfRequest = "${partnerMDFRequestID}";
		var key_option = "Duplicate";

		Click(locator1 = "PartnerMarketingMDF#MDF_REQUEST_OPTIONS");

		Click(locator1 = "Partner#DROPDOWN_OPTION");
	}

	macro viewMDFRequestOptions {
		var key_mdfRequest = "${partnerMDFRequestID}";

		Click(locator1 = "PartnerMarketingMDF#MDF_REQUEST_OPTIONS");

		Partner.viewDropdownOptions(
			partnerNoOptionsList = "${partnerNoOptionsList}",
			partnerOptionsList = "${partnerOptionsList}");

		Click(locator1 = "PartnerMarketingMDF#MDF_REQUEST_OPTIONS");
	}

}