		</execute>

		<execute macro="PartnerMDFRequest#clickNewClaimButton" />

		<execute macro="PartnerMDFClaimForm#fillGeneralInformation">
			<var name="partnerMDFClaimActivities" value="Test Activity1,Test Activity2" />
			<var name="partnerMDFClaimInvoice" value="Document_1.pdf" />
			<var name="partnerMDFClaimType" value="Full" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabels" value="Event Collaterals,Event Invitation,Event Photos,Event Programs,List of Qualified Leads,Third Party Invoices" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity2" />
			<var name="partnerMDFClaimLabels" value="All Contents,List of Qualified Leads,Telemarketing Metrics,Telemarketing Script,Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#readTitleID">
			<return from="titleID" name="partnerMDFClaimID" />
		</execute>

		<return name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
	</command>

