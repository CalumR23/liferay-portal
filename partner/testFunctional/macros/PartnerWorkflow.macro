			<var name="partnerMDFClaimLabels" value="Event Collaterals,Event Invitation,Event Photos,Event Programs,List of Qualified Leads,Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#clickNewClaimButton" />

		<execute macro="PartnerMDFClaimForm#fillGeneralInformation">
			<var name="partnerMDFClaimActivities" value="Test Activity2" />
			<var name="partnerMDFClaimInvoice" value="Document_1.pdf" />
			<var name="partnerMDFClaimType" value="Partial" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity2" />
			<var name="partnerMDFClaimLabels" value="All Contents,List of Qualified Leads,Telemarketing Metrics,Telemarketing Script,Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="createMDFRequest" returns="partnerMDFRequestID">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Active" />
		</execute>

		<execute macro="PartnerMarketingMDF#clickNewMDFRequestButton" />

		<execute macro="PartnerMDFRequestForm#fillGeneralInformation">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerMDFRequestForm#deleteMDFRequestConflict">
			<var name="partnerMDFRequestCompanyName" value="${partnerMDFRequestCompanyName}" />
			<var name="partnerMDFRequestCurrencyCode" value="${partnerMDFRequestCurrencyCode}" />
			<var name="partnerMDFRequestFundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
			<var name="partnerMDFRequestPhoneNumber" value="${partnerMDFRequestPhoneNumber}" />
			<var name="partnerMDFRequestRegion" value="${partnerMDFRequestRegion}" />
		</execute>

		<execute macro="PartnerMDFRequestForm#fillBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Generate Awareness,Increase ROI,Create Demand Generation" />
			<var name="partnerMDFRequestMarketFocus" value="Energy" />
			<var name="partnerMDFRequestMarketingPlan" value="Awareness" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity1" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="In-Person Partner" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Event" />
		</execute>

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity2" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="Direct Mail" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Traditional Marketing" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#assertSuccessPage" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="Partner#readLastRowID">
			<return from="rowID" name="partnerMDFRequestID" />
		</execute>

		<return name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
	</command>

	<command name="createPartnerOpportunity">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoSalesPartnerOpportunities" />

		<execute macro="PartnerOpportunities#clickAddOpportunityButton" />

		<execute macro="PartnerOpportunityForm#fillNewOpportunity">
			<var name="partnerOpportunityAnticipatedLiferayServices" value="Test" />
			<var name="partnerOpportunityAnticipatedPartnerServices" value="Test" />
			<var name="partnerOpportunityCompletedSalesActivities" value="Test" />
			<var name="partnerOpportunityCustomerBusinessUnit" value="Test Business Unit" />
			<var name="partnerOpportunityCustomerDepartment" value="Business - Sales" />
			<var name="partnerOpportunityCustomerEmailAddress" value="${partnerOpportunityCustomerEmailAddress}" />
			<var name="partnerOpportunityCustomerFirstName" value="${partnerOpportunityCustomerFirstName}" />
			<var name="partnerOpportunityCustomerJobRole" value="Director/Manager" />
			<var name="partnerOpportunityCustomerLastName" value="${partnerOpportunityCustomerLastName}" />
			<var name="partnerOpportunityCustomerPhoneNumber" value="123 456 7890" />
			<var name="partnerOpportunityDealSize" value="Under $10,000" />
			<var name="partnerOpportunityDescription" value="Test" />
			<var name="partnerOpportunityProspectAccountName" value="${partnerOpportunityProspectAccountName}" />
			<var name="partnerOpportunityProspectCountry" value="${partnerOpportunityProspectCountry}" />
			<var name="partnerOpportunityProspectIndustry" value="${partnerOpportunityProspectIndustry}" />
			<var name="partnerOpportunityPurchaseTimeFrame" value="Next 30 days" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerOpportunityForm#assertSuccessPage" />

		<execute macro="PartnerOpportunityForm#clickSeeOpportunitiesButton" />
	</command>

	<command name="deleteBusinessPlan">
		<if>
			<not>
				<equals arg1="${partnerBusinessPlanID}" arg2="" />
			</not>
			<then>
				<execute macro="Partner#logoutAndLoginUser">
					<var name="roleName" value="admin" />
				</execute>

				<execute macro="Partner#gotoCPServerAdministration" />

				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Script" />
				</execute>

				<execute macro="PartnerCPServerAdministration#deleteBusinessPlan">
					<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
				</execute>

				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Resources" />
				</execute>

				<execute macro="PartnerCPServerAdministration#executeResourcesAction">
					<var name="partnerCPAction" value="Clear the database cache." />
				</execute>

				<echo>Deleted Business Plan ID: ${partnerBusinessPlanID}</echo>
			</then>
		</if>
	</command>

	<command name="deleteMDFRequest">
		<if>
			<not>
				<equals arg1="${partnerMDFRequestID}" arg2="" />
			</not>
			<then>
				<execute macro="Partner#logoutAndLoginUser">
					<var name="roleName" value="admin" />
				</execute>

				<execute macro="Partner#gotoCPServerAdministration" />

				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Script" />
				</execute>

				<execute macro="PartnerCPServerAdministration#deleteMDFRequest">
					<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
				</execute>

				<execute macro="Partner#gotoTab">
					<var name="tabName" value="Resources" />
				</execute>

				<execute macro="PartnerCPServerAdministration#executeResourcesAction">
					<var name="partnerCPAction" value="Clear the database cache." />
				</execute>

				<echo>Deleted MDF Request ID: ${partnerMDFRequestID}</echo>
			</then>
		</if>
	</command>

	<command name="duplicateMDFRequest" returns="partnerMDFRequestID2">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="PartnerMarketingMDF#duplicateMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequestForm#editGeneralInformation">
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q3-Q4 2019,Q1-Q2 2019" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#assertSuccessPage" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="Partner#readLastRowID">
			<return from="rowID" name="partnerMDFRequestID2" />
		</execute>

		<return name="partnerMDFRequestID2" value="${partnerMDFRequestID2}" />
	</command>

