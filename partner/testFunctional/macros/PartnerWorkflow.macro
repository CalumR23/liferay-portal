definition {

	macro approveAndPayoutMDFRequestClaim {
		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagement();

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimNumber = "${partnerMDFClaimNumber}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by Global Partner Marketing.");

		Partner.clickSubmitButtonInModal();

		Partner.logoutAndLoginUser(roleName = "regional_finance");

		Partner.gotoManagement();

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimNumber = "${partnerMDFClaimNumber}");

		PartnerMDFClaim.clickPayoutClaimButton();

		PartnerMDFClaim.fillPayoutClaim(
			partnerMDFClaimCheckAmount = "50",
			partnerMDFClaimCheckDate = "01/01/2020",
			partnerMDFClaimCheckNumber = "A12345");

		Partner.clickSubmitButtonInModal();
	}

	macro approveBusinessPlan {
		Partner.logoutAndLoginUser(roleName = "general_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${partnerBusinessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by General Manager.");

		Partner.clickSubmitButtonInModal();

		Partner.reloadPage();
	}

	macro approveMDFClaim {
		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagementClaims();

		PartnerManagement.clickMDFClaim(partnerMDFClaimID = "${partnerMDFClaimID}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by Global Partner Marketing.");

		Partner.clickSubmitButtonInModal();

		Partner.reloadPage();
	}

	macro approveMDFRequest {
		Partner.logoutAndLoginUser(roleName = "global_partner_marketing");

		Partner.gotoManagement();

		PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		Partner.clickApproveButton();

		Partner.typeCommentInModal(partnerComment = "Approved by Global Partner Marketing.");

		Partner.clickSubmitButtonInModal();

		Partner.reloadPage();
	}

	macro createBusinessPlan {
		Partner.logoutAndLoginUser(roleName = "alliance_manager");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.clickNewBusinessPlanButton();

		PartnerBusinessPlanForm.fillPartner(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.deleteBusinessPlanConflict(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanRegionCode = "${partnerBusinessPlanRegionCode}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		PartnerBusinessPlanForm.fillAccount(
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addGoal(
			partnerBusinessPlanGoalDescription = "Test Description",
			partnerBusinessPlanGoalLiferayOwner = "Test Liferay Owner",
			partnerBusinessPlanGoalPartnerOwner = "Test Partner Contact",
			partnerBusinessPlanGoalQ1ProgressDescription = "Q1 Description",
			partnerBusinessPlanGoalQ2ProgressDescription = "Q2 Description",
			partnerBusinessPlanGoalQ3ProgressDescription = "Q3 Description",
			partnerBusinessPlanGoalQ4ProgressDescription = "Q4 Description");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.fillRevenue(
			partnerBusinessPlanNewBusinessProjections = "10,20,30,40",
			partnerBusinessPlanRenewalProjections = "20,40,60,80");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addService(
			partnerBusinessPlanServiceAccountName = "Test Service Account",
			partnerBusinessPlanServiceDate = "01/01/2019",
			partnerBusinessPlanServiceLiferayServicesProvided = "Test Liferay Services",
			partnerBusinessPlanServiceSector = "Test Service Sector");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addBusiness(
			partnerBusinessPlanNewBusinessCompanyName = "Test Company Name",
			partnerBusinessPlanNewBusinessGoalQuarter = "Q3",
			partnerBusinessPlanNewBusinessProjectInformation = "Extranet",
			partnerBusinessPlanNewBusinessSalesForecast = "100",
			partnerBusinessPlanNewBusinessType = "Current Partner Account Upsell");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.fillFocus(
			partnerBusinessPlanSectorsVerticals = "Agriculture,Automotive",
			partnerBusinessPlanTechnologyStrategy = "Test Technology Strategy");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		PartnerManagement.filterBusinessPlanByYear(partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		var partnerBusinessPlanID = Partner.readLastRowID();

		return "${partnerBusinessPlanID}";
	}

	macro createMDFClaimFull {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.clickNewClaimButton();

		PartnerMDFClaimForm.fillGeneralInformation(
			partnerMDFClaimActivities = "Test Activity2,Test Activity1",
			partnerMDFClaimInvoice = "Document_1.pdf",
			partnerMDFClaimType = "Full");

		PartnerMDFClaimForm.uploadActivityPOPs(
			partnerMDFClaimActivity = "Test Activity1",
			partnerMDFClaimLabels = "Images");

		PartnerMDFClaimForm.uploadActivityPOPs(
			partnerMDFClaimActivity = "Test Activity2",
			partnerMDFClaimLabels = "All Contents,List of Qualified Leads,Third Party Invoices,Video Links");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		var partnerMDFClaimID = Partner.readTitleID();

		return "${partnerMDFClaimID}";
	}

	macro createMDFClaimsPartial {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.clickNewClaimButton();

		PartnerMDFClaimForm.fillGeneralInformation(
			partnerMDFClaimActivities = "Test Activity1",
			partnerMDFClaimInvoice = "Document_1.pdf",
			partnerMDFClaimType = "Partial");

		PartnerMDFClaimForm.uploadActivityPOPs(
			partnerMDFClaimActivity = "Test Activity1",
			partnerMDFClaimLabels = "Images");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.clickNewClaimButton();

		PartnerMDFClaimForm.fillGeneralInformation(
			partnerMDFClaimActivities = "Test Activity2",
			partnerMDFClaimInvoice = "Document_1.pdf",
			partnerMDFClaimType = "Partial");

		PartnerMDFClaimForm.uploadActivityPOPs(
			partnerMDFClaimActivity = "Test Activity2",
			partnerMDFClaimLabels = "All Contents,List of Qualified Leads,Third Party Invoices,Video Links");

		Partner.clickSubmitButton();

		Partner.assertSuccess();
	}

	macro createMDFRequest {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		Partner.gotoTab(tabName = "Active");

		PartnerMarketingMDF.clickNewMDFRequestButton();

		PartnerMDFRequestForm.fillGeneralInformation(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		Partner.clickSaveAndContinueButton();

		PartnerMDFRequestForm.deleteMDFRequestConflict(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}",
			roleName = "partner");

		PartnerMDFRequestForm.fillBusinessGoals(
			partnerMDFRequestBusinessGoals = "Generate Awareness,Increase ROI,Create Demand Generation",
			partnerMDFRequestMarketFocus = "Energy",
			partnerMDFRequestMarketingPlan = "Awareness");

		Partner.clickSaveAndContinueButton();

		PartnerMDFRequestForm.addActivity(
			partnerMDFRequestActivityCampaign = "Mobile",
			partnerMDFRequestActivityEndDate = "01/01/2020",
			partnerMDFRequestActivityFollowUpStrategy = "Email Nurturing",
			partnerMDFRequestActivityLineItem = "Sponsorship Fee",
			partnerMDFRequestActivityLineItemCost = "100",
			partnerMDFRequestActivityName = "Test Activity1",
			partnerMDFRequestActivityStartDate = "01/01/2020",
			partnerMDFRequestActivityTactic = "Cobranded Merchandise",
			partnerMDFRequestActivityTargetAudience = "Test Audience",
			partnerMDFRequestActivityTargetLeadGoal = "Test Goal",
			partnerMDFRequestActivityTotalMDFRequested = "50",
			partnerMDFRequestActivityType = "Other");

		PartnerMDFRequestForm.addActivity(
			partnerMDFRequestActivityCampaign = "Mobile",
			partnerMDFRequestActivityEndDate = "01/01/2020",
			partnerMDFRequestActivityFollowUpStrategy = "Email Nurturing",
			partnerMDFRequestActivityLineItem = "Sponsorship Fee",
			partnerMDFRequestActivityLineItemCost = "100",
			partnerMDFRequestActivityName = "Test Activity2",
			partnerMDFRequestActivityStartDate = "01/01/2020",
			partnerMDFRequestActivityTactic = "Web Content",
			partnerMDFRequestActivityTargetAudience = "Test Audience",
			partnerMDFRequestActivityTargetLeadGoal = "Test Goal",
			partnerMDFRequestActivityTotalMDFRequested = "50",
			partnerMDFRequestActivityType = "Content");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		PartnerMDFRequestForm.assertSuccessPage();

		PartnerMDFRequestForm.clickSeeMDFRequestsButton();

		Partner.gotoMarketingMDF(roleName = "partner");

		var partnerMDFRequestID = Partner.readLastRowID();

		return "${partnerMDFRequestID}";
	}

	macro createPartnerOpportunity {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoSalesPartnerOpportunities(roleName = "partner");

		PartnerOpportunities.clickAddOpportunityButton();

		PartnerOpportunityForm.fillNewOpportunity(
			partnerOpportunityAnticipatedLiferayServices = "Test",
			partnerOpportunityAnticipatedPartnerServices = "Test",
			partnerOpportunityCompletedSalesActivities = "Test",
			partnerOpportunityCustomerBusinessUnit = "Test Business Unit",
			partnerOpportunityCustomerDepartment = "Business - Sales",
			partnerOpportunityCustomerEmailAddress = "${partnerOpportunityCustomerEmailAddress}",
			partnerOpportunityCustomerFirstName = "${partnerOpportunityCustomerFirstName}",
			partnerOpportunityCustomerJobRole = "Director/Manager",
			partnerOpportunityCustomerLastName = "${partnerOpportunityCustomerLastName}",
			partnerOpportunityCustomerPhoneNumber = "123 456 7890",
			partnerOpportunityDealSize = "Under $10,000",
			partnerOpportunityDescription = "Test",
			partnerOpportunityProspectAccountName = "${partnerOpportunityProspectAccountName}",
			partnerOpportunityProspectCountry = "${partnerOpportunityProspectCountry}",
			partnerOpportunityProspectIndustry = "${partnerOpportunityProspectIndustry}",
			partnerOpportunityPurchaseTimeFrame = "Next 30 days");

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		PartnerOpportunityForm.assertSuccessPage();

		PartnerOpportunityForm.clickSeeOpportunitiesButton();
	}

	macro deleteBusinessPlan {
		if ("${partnerBusinessPlanID}" != "") {
			Partner.logoutAndLoginUser(roleName = "admin");

			Partner.gotoCPServerAdministration();

			Partner.gotoTab(tabName = "Script");

			PartnerCPServerAdministration.deleteBusinessPlan(partnerBusinessPlanID = "${partnerBusinessPlanID}");

			Partner.gotoTab(tabName = "Resources");

			PartnerCPServerAdministration.executeResourcesAction(partnerCPAction = "Clear the database cache.");

			echo("Deleted Business Plan ID: ${partnerBusinessPlanID}");
		}
	}

	macro deleteMDFRequest {
		if ("${partnerMDFRequestID}" != "") {
			Partner.logoutAndLoginUser(roleName = "admin");

			Partner.gotoCPServerAdministration();

			Partner.gotoTab(tabName = "Script");

			PartnerCPServerAdministration.deleteMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

			Partner.gotoTab(tabName = "Resources");

			PartnerCPServerAdministration.executeResourcesAction(partnerCPAction = "Clear the database cache.");

			echo("Deleted MDF Request ID: ${partnerMDFRequestID}");
		}
	}

	macro duplicateMDFRequest {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.duplicateMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequestForm.editGeneralInformation(
			partnerMDFRequestCurrencyCode = "USD",
			partnerMDFRequestFundingPeriod = "Q3-Q4 2020,Q1-Q2 2020",
			partnerMDFRequestPhoneNumber = "123 456 7890");

		Partner.clickSaveAndContinueButton();

		Partner.clickSaveAndContinueButton();

		Partner.clickSubmitButton();

		Partner.assertSuccess();

		PartnerMDFRequestForm.assertSuccessPage();

		PartnerMDFRequestForm.clickSeeMDFRequestsButton();

		Partner.gotoMarketingMDF(roleName = "partner");

		var partnerMDFRequestID2 = Partner.readLastRowID();

		return "${partnerMDFRequestID2}";
	}

	macro editAndSubmitBusinessPlan {
		Partner.logoutAndLoginUser(roleName = "${roleName}");

		Partner.gotoManagementBusinessPlans();

		PartnerManagement.clickBusinessPlan(
			partnerBusinessPlanID = "${partnerBusinessPlanID}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.clickEditButton();

		PartnerBusinessPlanForm.fillPartner(
			partnerBusinessPlanCompany = "${partnerBusinessPlanCompany}",
			partnerBusinessPlanCurrencyCode = "${partnerBusinessPlanCurrencyCode}",
			partnerBusinessPlanRegion = "${partnerBusinessPlanRegion}",
			partnerBusinessPlanYear = "${partnerBusinessPlanYear}");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.fillAccount(
			partnerBusinessPlanLiferayRenewalContact = "Test Renewal Contact Edit",
			partnerBusinessPlanPartnerBusinessPlanOwner = "${partnerBusinessPlanPartnerBusinessPlanOwner}",
			partnerBusinessPlanPartnerMarketingPlanOwner = "Test MP Owner Edit");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addGoal(
			partnerBusinessPlanGoalDescription = "Test Description",
			partnerBusinessPlanGoalLiferayOwner = "Test Liferay Owner",
			partnerBusinessPlanGoalPartnerOwner = "Test Partner Contact",
			partnerBusinessPlanGoalQ1ProgressDescription = "Q1 Description",
			partnerBusinessPlanGoalQ2ProgressDescription = "Q2 Description",
			partnerBusinessPlanGoalQ3ProgressDescription = "Q3 Description",
			partnerBusinessPlanGoalQ4ProgressDescription = "Q4 Description");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.fillRevenue(
			partnerBusinessPlanNewBusinessProjections = "20,40,60,80",
			partnerBusinessPlanRenewalProjections = "40,80,120,160");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addService(
			partnerBusinessPlanServiceAccountName = "Test Service Account",
			partnerBusinessPlanServiceDate = "01/01/2019",
			partnerBusinessPlanServiceLiferayServicesProvided = "Test Liferay Services",
			partnerBusinessPlanServiceSector = "Test Service Sector");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.addBusiness(
			partnerBusinessPlanNewBusinessCompanyName = "Test Company Name",
			partnerBusinessPlanNewBusinessGoalQuarter = "Q3",
			partnerBusinessPlanNewBusinessProjectInformation = "Extranet",
			partnerBusinessPlanNewBusinessSalesForecast = "100",
			partnerBusinessPlanNewBusinessType = "Current Partner Account Upsell");

		Partner.clickSaveAndContinueButton();

		PartnerBusinessPlanForm.editFocus(
			partnerBusinessPlanSectorsVerticals = "Consulting/Market Research,Energy",
			partnerBusinessPlanTechnologyStrategy = "Test Technology Strategy",
			partnerBusinessPlanUnselectSectorsVerticals = "Agriculture,Automotive");

		Partner.clickSubmitButton();

		var roleNameFormatted = Partner.formatRoleName(roleName = "${roleName}");

		Partner.typeCommentInModal(partnerComment = "Adding an Edit as ${roleNameFormatted}.");

		Partner.clickSubmitButtonInModal();

		Partner.assertSuccess();
	}

	macro editAndSubmitMDFClaim {
		Partner.logoutAndLoginUser(roleName = "partner");

		Partner.gotoMarketingMDF(roleName = "partner");

		PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");

		PartnerMDFRequest.viewReimbursementClaim(partnerMDFClaimID = "${partnerMDFClaimID}");

		Partner.clickEditButton();

		PartnerMDFClaimForm.deleteActivityPOPs(
			partnerMDFClaimActivity = "Test Activity2",
			partnerMDFClaimLabels = "List of Qualified Leads,Third Party Invoices");

		PartnerMDFClaimForm.uploadActivityPOP(
			partnerMDFClaimActivity = "Test Activity2",
			partnerMDFClaimLabel = "Third Party Invoices",
			partnerMDFClaimPOPDocument = "Document_1.doc");

		PartnerMDFClaimForm.uploadActivityPOP(
			partnerMDFClaimActivity = "Test Activity2",
			partnerMDFClaimLabel = "List of Qualified Leads",
			partnerMDFClaimPOPDocument = "Partner_Leads.xlsx");

		Partner.clickSubmitButton();

		Partner.typeCommentInModal(partnerComment = "Adding an Edit as Partner.");

		Partner.clickSubmitButtonInModal();

		Partner.assertSuccess();

		Partner.reloadPage();
	}

	macro editAndSubmitMDFRequest {
		Partner.logoutAndLoginUser(roleName = "${roleName}");

		if ("${roleName}" == "partner") {
			Partner.gotoMarketingMDF(roleName = "partner");

			PartnerMarketingMDF.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");
		}
		else {
			Partner.gotoManagement();

			PartnerManagement.clickMDFRequest(partnerMDFRequestID = "${partnerMDFRequestID}");
		}

		Partner.clickEditButton();

		PartnerMDFRequestForm.viewDisabledGeneralInformation(
			partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
			partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
			partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

		PartnerMDFRequestForm.editGeneralInformation(
			partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
			partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}");

		Partner.clickSaveAndContinueButton();

		PartnerMDFRequestForm.editBusinessGoals(
			partnerMDFRequestBusinessGoals = "Banking,Retain",
			partnerMDFRequestUnselectBusinessGoals = "Energy,Awareness");

		Partner.clickSaveAndContinueButton();

		PartnerMDFRequestForm.addActivity(
			partnerMDFRequestActivityCampaign = "Mobile",
			partnerMDFRequestActivityEndDate = "01/01/2020",
			partnerMDFRequestActivityFollowUpStrategy = "Email Nurturing",
			partnerMDFRequestActivityLineItem = "Sponsorship Fee",
			partnerMDFRequestActivityLineItemCost = "100",
			partnerMDFRequestActivityName = "Test Activity3",
			partnerMDFRequestActivityStartDate = "01/01/2020",
			partnerMDFRequestActivityTactic = "Blog",
			partnerMDFRequestActivityTargetAudience = "Test Audience",
			partnerMDFRequestActivityTargetLeadGoal = "Test Goal",
			partnerMDFRequestActivityTotalMDFRequested = "50",
			partnerMDFRequestActivityType = "Digital Marketing");

		Partner.clickSubmitButton();

		var roleNameFormatted = Partner.formatRoleName(roleName = "${roleName}");

		Partner.typeCommentInModal(partnerComment = "Adding an Edit as ${roleNameFormatted}.");

		Partner.clickSubmitButtonInModal();

		PartnerMDFRequestForm.clickSeeMDFRequestsButton();
	}

	macro payoutMDFClaim {
		Partner.logoutAndLoginUser(roleName = "regional_finance");

		Partner.gotoManagementClaims();

		PartnerManagement.clickMDFClaim(partnerMDFClaimID = "${partnerMDFClaimID}");

		PartnerMDFClaim.clickPayoutClaimButton();

		PartnerMDFClaim.fillPayoutClaim(
			partnerMDFClaimCheckAmount = "100",
			partnerMDFClaimCheckDate = "01/01/2020",
			partnerMDFClaimCheckNumber = "A12345");

		Partner.clickSubmitButtonInModal();

		Partner.reloadPage();
	}

