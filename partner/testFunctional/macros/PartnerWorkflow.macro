	<command name="editAndSubmitMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickEditButton" />

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabels" value="Event Collaterals,Event Photos,List of Qualified Leads,Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Adding an Edit as Partner." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#reloadPage" />
	</command>

	<command name="editAndSubmitMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="${roleName}" />
		</execute>

		<if>
			<equals arg1="${roleName}" arg2="partner" />
			<then>
				<execute macro="Partner#gotoMarketingMDF" />

				<execute macro="PartnerMarketingMDF#clickMDFRequest">
					<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
				</execute>
			</then>
			<else>
				<execute macro="Partner#gotoManagement" />

				<execute macro="PartnerManagement#clickMDFRequest">
					<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
				</execute>
			</else>
		</if>

		<execute macro="Partner#clickEditButton" />

		<execute macro="PartnerMDFRequestForm#viewDisabledGeneralInformation">
			<var name="partnerMDFRequestCompanyName" value="Valamis Inc." />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestRegion" value="United States" />
		</execute>

		<execute macro="PartnerMDFRequestForm#editGeneralInformation">
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7891" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerMDFRequestForm#editBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Banking,Retain" />
			<var name="partnerMDFRequestUnselectBusinessGoals" value="Energy,Awareness" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity3" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="Blog" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Digital Marketing" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Adding an Edit as ${roleName}." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />
	</command>

	<command name="payoutMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#clickPayoutClaimButton" />

		<execute macro="PartnerMDFClaim#fillPayoutClaim">
			<var name="partnerMDFClaimCheckAmount" value="100" />
			<var name="partnerMDFClaimCheckDate" value="01/01/2019" />
			<var name="partnerMDFClaimCheckNumber" value="A12345" />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#reloadPage" />
	</command>

