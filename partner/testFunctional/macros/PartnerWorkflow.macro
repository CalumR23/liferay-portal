		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#editBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Banking,Retain" />
			<var name="partnerMDFRequestUnselectBusinessGoals" value="Energy,Awareness" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity3" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="Blog" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Digital Marketing" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Adding an Edit as ${roleName}." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />
	</command>

	<command name="payoutMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoMDFManagerClaims" />

		<execute macro="PartnerMDFManager#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#clickPayoutClaimButton" />

		<execute macro="PartnerMDFClaim#fillPayoutClaim">
			<var name="partnerMDFClaimCheckAmount" value="100.00" />
			<var name="partnerMDFClaimCheckDate" value="01/01/2019" />
			<var name="partnerMDFClaimCheckNumber" value="A12345" />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="rejectMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoMDFManagerClaims" />

		<execute macro="PartnerMDFManager#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickRejectButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Rejected by Finance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="rejectMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickRejectButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Rejected by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="requestMoreInfoBusinessPlan">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="general_manager" />
		</execute>

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="PartnerMDFManager#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute macro="Partner#clickRequestMoreInfoButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Requesting for More Info by General Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="requestMoreInfoMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoMDFManagerClaims" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickRequestMoreInfoButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Requesting for More Info by Finance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="requestMoreInfoMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickRequestMoreInfoButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Requesting for More Info by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="resendForReviewBusinessPlan">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoMDFManagerBusinessPlans" />

		<execute macro="PartnerMDFManager#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute macro="Partner#clickResendForReviewButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Resending for Review by Alliance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="resendForReviewMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMDFPartner" />

		<execute macro="PartnerMDFPartner#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickResendForReviewButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Resending for Review by Partner." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="resendForReviewMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickResendForReviewButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Resending for Review by Partner." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="sendForManagerReviewMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickSendForManagerReviewButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Sending for Manager Review by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="teardown">
		<for list="${partnerTeardown}" param="entry">
			<if>
				<equals arg1="${entry}" arg2="Business Plan" />
				<then>
					<execute macro="PartnerWorkflow#deleteBusinessPlan">
						<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
						<var name="partnerBusinessPlanStatus" value="${partnerBusinessPlanStatus}" />
					</execute>
				</then>
			</if>

			<if>
				<equals arg1="${entry}" arg2="MDF Request" />
				<then>
					<execute macro="PartnerWorkflow#deleteMDFRequest">
						<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
						<var name="partnerMDFRequestStatus" value="${partnerMDFRequestStatus}" />
					</execute>
				</then>
			</if>
		</for>
	</command>
</definition>