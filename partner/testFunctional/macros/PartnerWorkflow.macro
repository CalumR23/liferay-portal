<definition>
	<command name="approveAndPayoutMDFRequestClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#viewReimbursementClaim">
			<var name="partnerMDFClaimNumber" value="${partnerMDFClaimNumber}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Approved by Finance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#reloadPage" />

		<execute macro="PartnerMDFClaim#clickPayoutClaimButton" />

		<execute macro="PartnerMDFClaim#fillPayoutClaim">
			<var name="partnerMDFClaimCheckAmount" value="50" />
			<var name="partnerMDFClaimCheckDate" value="01/01/2019" />
			<var name="partnerMDFClaimCheckNumber" value="A12345" />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="approveBusinessPlan">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="general_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#clickBusinessPlan">
			<var name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Approved by General Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#reloadPage" />
	</command>

	<command name="approveMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="regional_finance" />
		</execute>

		<execute macro="Partner#gotoManagementClaims" />

		<execute macro="PartnerManagement#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Approved by Finance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#reloadPage" />
	</command>

	<command name="approveMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="global_partner_marketing" />
		</execute>

		<execute macro="Partner#gotoManagement" />

		<execute macro="PartnerManagement#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerComment" value="Approved by Global Partner Marketing." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="Partner#reloadPage" />
	</command>

	<command name="createBusinessPlan" returns="partnerBusinessPlanID">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="alliance_manager" />
		</execute>

		<execute macro="Partner#gotoManagementBusinessPlans" />

		<execute macro="PartnerManagement#clickNewBusinessPlanButton" />

		<execute macro="PartnerBusinessPlanForm#fillPartner">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#deleteBusinessPlanConflict">
			<var name="partnerBusinessPlanCompany" value="${partnerBusinessPlanCompany}" />
			<var name="partnerBusinessPlanCurrencyCode" value="${partnerBusinessPlanCurrencyCode}" />
			<var name="partnerBusinessPlanRegion" value="${partnerBusinessPlanRegion}" />
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="PartnerBusinessPlanForm#fillAccount">
			<var name="partnerBusinessPlanLiferayRenewalContact" value="Test Renewal Contact" />
			<var name="partnerBusinessPlanPartnerBusinessPlanOwner" value="${partnerBusinessPlanPartnerBusinessPlanOwner}" />
			<var name="partnerBusinessPlanPartnerMarketingPlanOwner" value="Test MP Owner" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#addGoal">
			<var name="partnerBusinessPlanGoalDescription" value="Test Description" />
			<var name="partnerBusinessPlanGoalLiferayOwner" value="Test Liferay Owner" />
			<var name="partnerBusinessPlanGoalPartnerOwner" value="Test Partner Contact" />
			<var name="partnerBusinessPlanGoalQ1ProgressDescription" value="Q1 Description" />
			<var name="partnerBusinessPlanGoalQ2ProgressDescription" value="Q2 Description" />
			<var name="partnerBusinessPlanGoalQ3ProgressDescription" value="Q3 Description" />
			<var name="partnerBusinessPlanGoalQ4ProgressDescription" value="Q4 Description" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#fillRevenue">
			<var name="partnerBusinessPlanNewBusinessProjections" value="10,20,30,40" />
			<var name="partnerBusinessPlanRenewalProjections" value="20,40,60,80" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#addService">
			<var name="partnerBusinessPlanServiceAccountName" value="Test Service Account" />
			<var name="partnerBusinessPlanServiceDate" value="01/01/2018" />
			<var name="partnerBusinessPlanServiceLiferayServicesProvided" value="Test Liferay Services" />
			<var name="partnerBusinessPlanServiceSector" value="Test Service Sector" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#addBusiness">
			<var name="partnerBusinessPlanNewBusinessCompanyName" value="Test Company Name" />
			<var name="partnerBusinessPlanNewBusinessGoalQuarter" value="Q3" />
			<var name="partnerBusinessPlanNewBusinessProjectInformation" value="Extranet" />
			<var name="partnerBusinessPlanNewBusinessSalesForecast" value="100" />
			<var name="partnerBusinessPlanNewBusinessType" value="Current Partner Account Upsell" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="PartnerBusinessPlanForm#fillFocus">
			<var name="partnerBusinessPlanSectorsVerticals" value="Agriculture,Automotive" />
			<var name="partnerBusinessPlanTechnologyStrategy" value="Test Technology Strategy" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerManagement#filterBusinessPlanByYear">
			<var name="partnerBusinessPlanYear" value="${partnerBusinessPlanYear}" />
		</execute>

		<execute macro="Partner#readLastRowID">
			<return from="rowID" name="partnerBusinessPlanID" />
		</execute>

		<return name="partnerBusinessPlanID" value="${partnerBusinessPlanID}" />
	</command>

	<command name="createMDFClaimFull" returns="partnerMDFClaimID">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMarketingMDF" />

		<execute macro="PartnerMarketingMDF#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#clickNewClaimButton" />

		<execute macro="PartnerMDFClaimForm#fillGeneralInformation">
			<var name="partnerMDFClaimActivities" value="Test Activity2,Test Activity1" />
			<var name="partnerMDFClaimInvoice" value="Document_1.pdf" />
			<var name="partnerMDFClaimType" value="Full" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimLabels" value="Event Collaterals,Event Invitations,Event Photos,Event Programs,List of Qualified Leads,Third Party Invoices" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadActivityPOPs">
			<var name="partnerMDFClaimActivity" value="Test Activity2" />
			<var name="partnerMDFClaimLabels" value="All Contents,List of Qualified Leads,Telemarketing Metrics,Telemarketing Script,Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="Partner#readTitleID">
			<return from="titleID" name="partnerMDFClaimID" />
		</execute>

		<return name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
	</command>

	<command name="createMDFClaimsPartial">
