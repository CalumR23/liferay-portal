<definition>
	<command name="approveMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="finance" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="MDF Claim Manager" />
		</execute>

		<execute macro="PartnerMDFManager#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Approved by Finance Manager." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="approveMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="manager" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickApproveButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Approved by GPM." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="createMDFClaim" returns="partnerMDFClaimID">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMDFPartner" />

		<execute macro="PartnerMDFPartner#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="PartnerMDFRequest#clickNewClaimButton" />

		<execute macro="PartnerMDFClaimForm#fillGeneralInformation">
			<var name="partnerMDFClaimActivities" value="Test Activity1" />
			<var name="partnerMDFClaimInvoice" value="Document_1.pdf" />
			<var name="partnerMDFClaimType" value="Partial" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Document_1.doc" />
			<var name="partnerMDFClaimPOPLabel" value="Event Collaterals" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Document_2.docx" />
			<var name="partnerMDFClaimPOPLabel" value="Event Invitations" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Document_1.jpeg" />
			<var name="partnerMDFClaimPOPLabel" value="Event Photos" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Document_1.jpg" />
			<var name="partnerMDFClaimPOPLabel" value="Event Programs" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Partner_Leads.xlsx" />
			<var name="partnerMDFClaimPOPLabel" value="List of Qualified Leads" />
		</execute>

		<execute macro="PartnerMDFClaimForm#uploadProofOfPerformance" >
			<var name="partnerMDFClaimActivity" value="Test Activity1" />
			<var name="partnerMDFClaimPOP" value="Document_2.pdf" />
			<var name="partnerMDFClaimPOPLabel" value="Third Party Invoices" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFClaim#readMDFClaimID">
			<return from="partnerMDFClaimID" name="partnerMDFClaimID" />
		</execute>

		<return name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
	</command>

	<command name="createMDFRequest" returns="partnerMDFRequestID">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="partner" />
		</execute>

		<execute macro="Partner#gotoMDFPartner" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="Active" />
		</execute>

		<execute macro="PartnerMDFPartner#clickNewMDFRequest" />

		<execute macro="PartnerMDFRequestForm#fillGeneralInformation">
			<var name="partnerMDFRequestCompanyName" value="Arcusys USA" />
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7890" />
			<var name="partnerMDFRequestRegion" value="United States" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#fillBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Generate Awareness,Increase ROI,Create Demand Generation" />
			<var name="partnerMDFRequestMarketFocus" value="Energy" />
			<var name="partnerMDFRequestMarketingPlan" value="Awareness" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity1" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="In-Person Partner" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Event" />
		</execute>

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity2" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="In-Person Partner" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Event" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="PartnerMDFRequestForm#assertSuccessPage" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />

		<execute macro="Partner#gotoMDFPartner" />

		<execute macro="Partner#readLastRowID">
			<return from="rowID" name="partnerMDFRequestID" />
		</execute>

		<return name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
	</command>

	<command name="deleteMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="manager" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#deleteMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>
	</command>

	<command name="editMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="${roleName}" />
		</execute>

		<if>
			<equals arg1="${roleName}" arg2="partner" />
			<then>
				<execute macro="Partner#gotoMDFPartner" />

				<execute macro="PartnerMDFPartner#clickMDFRequest">
					<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
				</execute>
			</then>
			<else>
				<execute macro="Partner#gotoMDFManager" />

				<execute macro="PartnerMDFManager#clickMDFRequest">
					<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
				</execute>
			</else>
		</if>

		<execute macro="Partner#clickEditButton" />

		<execute macro="PartnerMDFRequestForm#viewDisabledGeneralInformation">
			<var name="partnerMDFRequestCompanyName" value="Arcusys USA" />
			<var name="partnerMDFRequestFundingPeriod" value="Q1-Q2 2019" />
			<var name="partnerMDFRequestRegion" value="United States" />
		</execute>

		<execute macro="PartnerMDFRequestForm#editGeneralInformation">
			<var name="partnerMDFRequestCurrencyCode" value="USD" />
			<var name="partnerMDFRequestPhoneNumber" value="123 456 7891" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#editBusinessGoals">
			<var name="partnerMDFRequestBusinessGoals" value="Banking,Retain" />
			<var name="partnerMDFRequestUnselectBusinessGoals" value="Energy,Awareness" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />

		<execute macro="Partner#assertSuccess" />

		<execute macro="PartnerMDFRequestForm#addActivity">
			<var name="partnerMDFRequestActivityCampaign" value="Mobile" />
			<var name="partnerMDFRequestActivityEndDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityFollowUpStrategy" value="Email Nurturing" />
			<var name="partnerMDFRequestActivityLineItem" value="Sponsorship Fee" />
			<var name="partnerMDFRequestActivityLineItemCost" value="100" />
			<var name="partnerMDFRequestActivityName" value="Test Activity3" />
			<var name="partnerMDFRequestActivityStartDate" value="01/01/2019" />
			<var name="partnerMDFRequestActivityTactic" value="Blog" />
			<var name="partnerMDFRequestActivityTargetAudience" value="Test Audience" />
			<var name="partnerMDFRequestActivityTargetLeadGoal" value="Test Goal" />
			<var name="partnerMDFRequestActivityType" value="Digital Marketing" />
		</execute>

		<execute macro="Partner#clickSubmitButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Adding an Edit as ${roleName}" />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />

		<execute macro="PartnerMDFRequestForm#clickSeeMDFRequestsButton" />
	</command>

	<command name="payoutMDFClaim">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="finance" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="Partner#gotoTab">
			<var name="tabName" value="MDF Claim Manager" />
		</execute>

		<execute macro="PartnerMDFManager#clickMDFClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
		</execute>

		<execute macro="PartnerMDFClaim#clickPayoutClaimButton" />

		<execute macro="PartnerMDFClaim#fillPayoutClaim">
			<var name="partnerMDFClaimCheckAmount" value="50.00" />
			<var name="partnerMDFClaimCheckDate" value="01/01/2019" />
			<var name="partnerMDFClaimCheckNumber" value="A12345" />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="requestMoreInfoMDFRequest">
		<execute macro="Partner#logoutAndLoginUser">
			<var name="roleName" value="manager" />
		</execute>

		<execute macro="Partner#gotoMDFManager" />

		<execute macro="PartnerMDFManager#clickMDFRequest">
			<var name="partnerMDFRequestID" value="${partnerMDFRequestID}" />
		</execute>

		<execute macro="Partner#clickRequestMoreInfoButton" />

		<execute macro="Partner#typeCommentInModal">
			<var name="partnerMDFRequestComment" value="Requesting for More Info by GPM." />
		</execute>

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>
</definition>