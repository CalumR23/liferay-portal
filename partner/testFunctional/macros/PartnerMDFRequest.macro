definition {

	macro assertAllianceManagerList {
		for (var allianceManager : list "${partnerMDFRequestAllianceManagerList}") {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMDFRequest#MDF_REQUEST_ALLIANCE_MANAGER",
				value1 = "${allianceManager}");
		}
	}

	macro assertBusinessGoals {
		for (var businessGoal : list "${partnerMDFRequestBusinessGoals}") {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMDFRequest#MDF_REQUEST_BUSINESS_GOALS",
				value1 = "${businessGoal}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_VERTICAL_MARKET_FOCUS",
			value1 = "${partnerMDFRequestMarketFocus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_MARKETING_PLAN",
			value1 = "${partnerMDFRequestMarketingPlan}");
	}

	macro assertMarketingActivity {
		var key_activity = "${partnerMDFRequestActivityName}";

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_ACTIVITY_NAME",
			value1 = "${partnerMDFRequestActivityName}");
	}

	macro assertReimbursementClaim {
		var partnerMDFClaimStatus = StringUtil.upperCase("${partnerMDFClaimStatus}");

		if (isSet(partnerMDFClaimID) && isSet(partnerMDFClaimID)) {
			var key_mdfClaim = "${partnerMDFClaimID}";

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_TITLE",
				value1 = "Claim-${partnerMDFClaimID}");
		}
		else {
			var key_mdfClaim = "${partnerMDFClaimActivities}";
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_TYPE",
			value1 = "Type: ${partnerMDFClaimType}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_AMOUNTS",
			value1 = "Amount Claimed: ${partnerMDFClaimAmountClaimed}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_AMOUNTS",
			value1 = "Payment Received: ${partnerMDFClaimPaymentReceived}");

		if (isSet(partnerMDFClaimActivities) && isSet(partnerMDFClaimActivities)) {
			var partnerMDFClaimActivities = StringUtil.add("Claimed Activities:", " ${partnerMDFClaimActivities}", "");

			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_ACTIVITIES",
				value1 = "${partnerMDFClaimActivities}");
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_STATUS",
			value1 = "${partnerMDFClaimStatus}");
	}

	macro assertSummary {
		var partnerMDFRequestStatus = StringUtil.upperCase("${partnerMDFRequestStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_STATUS",
			value1 = "${partnerMDFRequestStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_FUNDING_PERIOD",
			value1 = "${partnerMDFRequestFundingPeriod}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_TOTAL_COST",
			value1 = "${partnerMDFRequestTotalCost}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_AMOUNT_REQUESTED",
			value1 = "${partnerMDFRequestAmountRequested}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequest#MDF_REQUEST_AMOUNT_APPROVED",
			value1 = "${partnerMDFRequestAmountApproved}");
	}

	macro chooseAllianceManager {
		Click(locator1 = "PartnerMDFRequest#MDF_REQUEST_CHOOSE_ALLIANCE_MANAGER_BUTTON");

		Select(
			locator1 = "PartnerMDFRequest#MODAL_SELECT_ALLIANCE_MANAGER",
			value1 = "${partnerMDFRequestAllianceManager}");

		Partner.clickSubmitButtonInModal();
	}

	macro clickNewClaimButton {
		KeyPress(
			locator1 = "Partner#NAVBAR_HOME",
			value1 = "\PAGE_DOWN");

		Click(locator1 = "PartnerMDFRequest#MDF_REQUEST_NEW_CLAIM_BUTTON");
	}

	macro clickReimbursementClaim {
		if (isSet(partnerMDFClaimNumber) && isSet(partnerMDFClaimNumber)) {
			var key_mdfClaimNumber = "${partnerMDFClaimNumber}";

			Click(locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_OPTIONS_NUMBER");
		}
		else {
			var key_mdfClaim = "${partnerMDFClaimID}";

			Click(locator1 = "PartnerMDFRequest#MDF_REQUEST_CLAIM_OPTIONS");
		}
	}

	macro viewReimbursementClaim {
		PartnerMDFRequest.clickReimbursementClaim(
			partnerMDFClaimID = "${partnerMDFClaimID}",
			partnerMDFClaimNumber = "${partnerMDFClaimNumber}");

		Click(locator1 = "Partner#DROPDOWN_OPTION_VIEW");
	}

	macro viewReimbursementClaimOptions {
		PartnerMDFRequest.clickReimbursementClaim(
			partnerMDFClaimID = "${partnerMDFClaimID}",
			partnerMDFClaimNumber = "${partnerMDFClaimNumber}");

		Partner.viewDropdownOptions(
			partnerNoOptionsList = "${partnerNoOptionsList}",
			partnerOptionsList = "${partnerOptionsList}");

		PartnerMDFRequest.clickReimbursementClaim(
			partnerMDFClaimID = "${partnerMDFClaimID}",
			partnerMDFClaimNumber = "${partnerMDFClaimNumber}");
	}

}