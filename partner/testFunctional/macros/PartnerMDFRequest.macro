<definition>
	<command name="assertAllianceManagerList">
		<for list="${partnerMDFRequestAllianceManagerList}" param="allianceManager">
			<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_ALLIANCE_MANAGER" value1="${allianceManager}" />
		</for>
	</command>

	<command name="assertBusinessGoals">
		<for list="${partnerMDFRequestBusinessGoals}" param="businessGoal">
			<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_BUSINESS_GOALS" value1="${businessGoal}" />
		</for>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_VERTICAL_MARKET_FOCUS" value1="${partnerMDFRequestMarketFocus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_MARKETING_PLAN" value1="${partnerMDFRequestMarketingPlan}" />
	</command>

	<command name="assertMarketingActivity">
		<var name="key_activity" value="${partnerMDFRequestActivityName}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_ACTIVITY_NAME" value1="${partnerMDFRequestActivityName}" />
	</command>

	<command name="assertReimbursementClaim">
		<var method="StringUtil#upperCase('${partnerMDFClaimStatus}')" name="partnerMDFClaimStatus" />

		<if>
			<and>
				<isset var="partnerMDFClaimID" />
				<not>
					<contains string="${partnerMDFClaimID}" substring="{partnerMDFClaimID}" />
				</not>
			</and>
			<then>
				<var name="key_mdfClaim" value="${partnerMDFClaimID}" />

				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_TITLE" value1="Claim-${partnerMDFClaimID}" />
			</then>
			<else>
				<var name="key_mdfClaim" value="${partnerMDFClaimActivities}" />
			</else>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_TYPE" value1="Type: ${partnerMDFClaimType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_AMOUNTS" value1="Amount Claimed: ${partnerMDFClaimAmountClaimed}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_AMOUNTS" value1="Payment Received: ${partnerMDFClaimPaymentReceived}" />

		<if>
			<and>
				<isset var="partnerMDFClaimActivities" />
				<not>
					<contains string="${partnerMDFClaimActivities}" substring="{partnerMDFClaimActivities}" />
				</not>
			</and>
			<then>
				<var method="StringUtil#add('Claimed Activities:', ' ${partnerMDFClaimActivities}','')" name="partnerMDFClaimActivities" />

				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_ACTIVITIES" value1="${partnerMDFClaimActivities}" />
			</then>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_STATUS" value1="${partnerMDFClaimStatus}" />
	</command>

	<command name="assertSummary">
		<var method="StringUtil#upperCase('${partnerMDFRequestStatus}')" name="partnerMDFRequestStatus" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_STATUS" value1="${partnerMDFRequestStatus}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_FUNDING_PERIOD" value1="${partnerMDFRequestFundingPeriod}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_TOTAL_COST" value1="${partnerMDFRequestTotalCost}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_AMOUNT_REQUESTED" value1="${partnerMDFRequestAmountRequested}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequest#MDF_REQUEST_AMOUNT_APPROVED" value1="${partnerMDFRequestAmountApproved}" />
	</command>

	<command name="chooseAllianceManager">
		<execute function="Click" locator1="PartnerMDFRequest#MDF_REQUEST_CHOOSE_ALLIANCE_MANAGER_BUTTON" />

		<execute function="Select" locator1="PartnerMDFRequest#MODAL_SELECT_ALLIANCE_MANAGER" value1="${partnerMDFRequestAllianceManager}" />

		<execute macro="Partner#clickSubmitButtonInModal" />
	</command>

	<command name="clickNewClaimButton">
		<execute function="KeyPress" locator1="Partner#NAVBAR_HOME" value1="\PAGE_DOWN" />

		<execute function="Click" locator1="PartnerMDFRequest#MDF_REQUEST_NEW_CLAIM_BUTTON" />
	</command>

	<command name="clickReimbursementClaim">
		<if>
			<and>
				<isset var="partnerMDFClaimNumber" />
				<not>
					<contains string="${partnerMDFClaimNumber}" substring="{partnerMDFClaimNumber}" />
				</not>
			</and>
			<then>
				<var name="key_mdfClaimNumber" value="${partnerMDFClaimNumber}" />

				<execute function="Click" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_OPTIONS_NUMBER" />
			</then>
			<else>
				<var name="key_mdfClaim" value="${partnerMDFClaimID}" />

				<execute function="Click" locator1="PartnerMDFRequest#MDF_REQUEST_CLAIM_OPTIONS" />
			</else>
		</if>
	</command>

	<command name="viewReimbursementClaim">
		<execute macro="PartnerMDFRequest#clickReimbursementClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
			<var name="partnerMDFClaimNumber" value="${partnerMDFClaimNumber}" />
		</execute>

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION_VIEW" />
	</command>

	<command name="viewReimbursementClaimOptions">
		<execute macro="PartnerMDFRequest#clickReimbursementClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
			<var name="partnerMDFClaimNumber" value="${partnerMDFClaimNumber}" />
		</execute>

		<execute macro="Partner#viewDropdownOptions">
			<var name="partnerNoOptionsList" value="${partnerNoOptionsList}" />
			<var name="partnerOptionsList" value="${partnerOptionsList}" />
		</execute>

		<execute macro="PartnerMDFRequest#clickReimbursementClaim">
			<var name="partnerMDFClaimID" value="${partnerMDFClaimID}" />
			<var name="partnerMDFClaimNumber" value="${partnerMDFClaimNumber}" />
		</execute>
	</command>
</definition>