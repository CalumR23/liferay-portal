<definition>
	<command name="assertMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />
		<var method="StringUtil#upperCase('${partnerMDFRequestStatus}')" name="partnerMDFRequestStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFPartner#MDF_REQUEST_STATUS" value1="${partnerMDFRequestStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFPartner#MDF_REQUEST_FUNDING_PERIOD" value1="${partnerMDFRequestFundingPeriod}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFPartner#MDF_REQUEST_TOTAL_COST" value1="${partnerMDFRequestTotalCost}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFPartner#MDF_REQUEST_AMOUNT_REQUESTED" value1="${partnerMDFRequestAmountRequested}" />

		<if>
			<and>
				<isset var="partnerMDFRequestReimbursementClaims" />
				<not>
					<contains string="${partnerMDFRequestReimbursementClaims}" substring="{partnerMDFRequestReimbursementClaims}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFPartner#MDF_REQUEST_REIMBURSEMENT_CLAIMS" value1="${partnerMDFRequestReimbursementClaims}" />
			</then>
		</if>
	</command>

	<command name="clickMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<while>
			<condition function="IsElementNotPresent" locator1="PartnerMDFPartner#MDF_REQUEST_ID" />
			<then>
				<execute macro="Partner#clickNextPage" />
			</then>
		</while>

		<execute function="Click" locator1="PartnerMDFPartner#MDF_REQUEST_ID" />
	</command>

	<command name="clickNewMDFRequestButton">
		<execute function="Click" locator1="PartnerMDFPartner#NEW_MDF_REQUEST_BUTTON" />
	</command>

	<command name="deleteMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="Click" locator1="PartnerMDFPartner#MDF_REQUEST_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>
</definition>