<definition>
	<command name="assertSummary">
		<var method="StringUtil#upperCase('${partnerMDFClaimStatus}')" name="partnerMDFClaimStatus" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFClaim#MDF_CLAIM_STATUS" value1="${partnerMDFClaimStatus}" />

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFClaim#MDF_CLAIM_TYPE" value1="${partnerMDFClaimType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFClaim#MDF_CLAIM_AMOUNT_CLAIMED" value1="${partnerMDFClaimAmountClaimed}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFClaim#MDF_CLAIM_PAYMENT_RECEIVED" value1="${partnerMDFClaimPaymentReceived}" />

		<if>
			<and>
				<isset var="partnerMDFClaimCheckNumber" />
				<not>
					<contains string="${partnerMDFClaimCheckNumber}" substring="{partnerMDFClaimCheckNumber}" />
				</not>
			</and>
			<then>
				<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFClaim#MDF_CLAIM_CHECK_NUMBER" value1="${partnerMDFClaimCheckNumber}" />
			</then>
		</if>
	</command>

	<command name="clickPayoutClaimButton">
		<execute function="Click" locator1="PartnerMDFClaim#PAYOUT_CLAIM_BUTTON" />
	</command>

	<command name="fillPayoutClaim">
		<execute function="Type#sendKeys" locator1="PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_NUMBER" value1="${partnerMDFClaimCheckNumber}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_DATE" value1="${partnerMDFClaimCheckDate}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_AMOUNT" value1="${partnerMDFClaimCheckAmount}" />
	</command>
</definition>