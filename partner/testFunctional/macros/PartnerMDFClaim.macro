definition {

	macro assertSummary {
		var partnerMDFClaimStatus = StringUtil.upperCase("${partnerMDFClaimStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFClaim#MDF_CLAIM_STATUS",
			value1 = "${partnerMDFClaimStatus}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFClaim#MDF_CLAIM_TYPE",
			value1 = "${partnerMDFClaimType}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFClaim#MDF_CLAIM_AMOUNT_CLAIMED",
			value1 = "${partnerMDFClaimAmountClaimed}");

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFClaim#MDF_CLAIM_PAYMENT_RECEIVED",
			value1 = "${partnerMDFClaimPaymentReceived}");

		if (isSet(partnerMDFClaimCheckNumber) && isSet(partnerMDFClaimCheckNumber)) {
			AssertTextEquals.assertPartialText(
				locator1 = "PartnerMDFClaim#MDF_CLAIM_CHECK_NUMBER",
				value1 = "${partnerMDFClaimCheckNumber}");
		}
	}

	macro clickPayoutClaimButton {
		Click(locator1 = "PartnerMDFClaim#PAYOUT_CLAIM_BUTTON");
	}

	macro fillPayoutClaim {
		Type.sendKeys(
			locator1 = "PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_NUMBER",
			value1 = "${partnerMDFClaimCheckNumber}");

		Type.sendKeys(
			locator1 = "PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_DATE",
			value1 = "${partnerMDFClaimCheckDate}");

		Type.sendKeys(
			locator1 = "PartnerMDFClaim#MODAL_PAYOUT_CLAIM_CHECK_AMOUNT",
			value1 = "${partnerMDFClaimCheckAmount}");
	}

}