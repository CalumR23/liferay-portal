<definition>
	<command name="addPartnerManagers">
		<execute function="Click" locator1="PartnerCPPartnerAdmin#PAGE_MANAGERS_TAB" />

		<execute macro="Partner#formatRegionCode">
			<var name="regionCode" value="${partnerRegionCode}" />
			<return name="partnerRegionCodeFormatted" />
		</execute>

		<for list="${partnerManagerUserEmailList}" param="partnerManagerUserEmail">
			<execute macro="PartnerCPPartnerAdmin#addRow" />

			<execute function="Select" locator1="PartnerCPPartnerAdmin#SELECT_PARTNER_REGION" value1="${partnerRegionCodeFormatted}" />
			<execute function="Select" locator1="PartnerCPPartnerAdmin#SELECT_PARTNER_TYPE" value1="${partnerManagerType}" />
			<execute function="Select" locator1="PartnerCPPartnerAdmin#SELECT_PARTNER_USER_EMAIL" value1="${partnerManagerUserEmail}" />

			<execute function="Click" locator1="PartnerCPPartnerAdmin#SAVE_BUTTON" />

			<execute macro="Partner#assertSuccess" />

			<execute macro="PartnerCPPartnerAdmin#findRowID">
				<var name="partnerItem1" value="${partnerManagerUserEmail}" />
				<var name="partnerItem2" value="${partnerManagerType}" />
				<var name="partnerItem3" value="${partnerRegionCodeFormatted}" />
			</execute>
		</for>
	</command>

	<command name="addRow">
		<execute function="Click" locator1="PartnerCPPartnerAdmin#ADD_ROW_BUTTON" />
	</command>

	<command name="deletePartnerManagers">
		<execute function="Click" locator1="PartnerCPPartnerAdmin#PAGE_MANAGERS_TAB" />

		<execute macro="Partner#formatRegionCode">
			<var name="regionCode" value="${partnerRegionCode}" />
			<return name="partnerRegionCodeFormatted" />
		</execute>

		<for list="${partnerManagerUserEmailList}" param="partnerManagerUserEmail">
			<execute macro="PartnerCPPartnerAdmin#findRowID">
				<var name="partnerItem1" value="${partnerManagerUserEmail}" />
				<var name="partnerItem2" value="${partnerManagerType}" />
				<var name="partnerItem3" value="${partnerRegionCodeFormatted}" />
			</execute>

			<execute macro="PartnerCPPartnerAdmin#deleteRow">
				<var name="partnerItem1" value="${partnerManagerUserEmail}" />
				<var name="partnerItem2" value="${partnerManagerType}" />
				<var name="partnerItem3" value="${partnerRegionCodeFormatted}" />
			</execute>
		</for>
	</command>

	<command name="deleteRow">
		<var name="key_item1" value="${partnerItem1}" />
		<var name="key_item2" value="${partnerItem2}" />
		<var name="key_item3" value="${partnerItem3}" />

		<execute function="Click" locator1="PartnerCPPartnerAdmin#TABLE_ROW_OPTIONS" />

		<execute function="Click" locator1="PartnerCPPartnerAdmin#DROPDOWN_OPTION_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="findRowID">
		<var name="key_item1" value="${partnerItem1}" />
		<var name="key_item2" value="${partnerItem2}" />
		<var name="key_item3" value="${partnerItem3}" />

		<while>
			<and>
				<condition function="IsElementNotPresent" locator1="PartnerCPPartnerAdmin#TABLE_ROW" />
				<condition function="IsElementNotPresent" locator1="PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON_DISABLED" />
				<condition function="IsElementPresent" locator1="PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON" />
			</and>
			<then>
				<execute function="Click" locator1="PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON" />
			</then>
		</while>

		<execute function="AssertElementPresent" locator1="PartnerCPPartnerAdmin#TABLE_ROW" />
	</command>
</definition>