definition {

	macro addPartnerManagers {
		Click(locator1 = "PartnerCPPartnerAdmin#PARTNER_MANAGERS_TAB");

		var partnerRegionCodeFormatted = Partner.formatRegionCode(regionCode = "${partnerRegionCode}");

		for (var partnerManagerUserEmail : list "${partnerManagerUserEmailList}") {
			PartnerCPPartnerAdmin.addRow();

			Select(
				locator1 = "PartnerCPPartnerAdmin#SELECT_PARTNER_REGION",
				value1 = "${partnerRegionCodeFormatted}");

			Select(
				locator1 = "PartnerCPPartnerAdmin#SELECT_PARTNER_TYPE",
				value1 = "${partnerManagerType}");

			Select(
				locator1 = "PartnerCPPartnerAdmin#SELECT_PARTNER_USER_EMAIL",
				value1 = "${partnerManagerUserEmail}");

			Click(locator1 = "PartnerCPPartnerAdmin#SAVE_BUTTON");

			Partner.assertSuccess();

			PartnerCPPartnerAdmin.findRowID(
				partnerItem1 = "${partnerManagerUserEmail}",
				partnerItem2 = "${partnerManagerType}",
				partnerItem3 = "${partnerRegionCodeFormatted}");
		}
	}

	macro addRow {
		Click(locator1 = "PartnerCPPartnerAdmin#ADD_ROW_BUTTON");
	}

	macro deletePartnerManagers {
		Click(locator1 = "PartnerCPPartnerAdmin#PARTNER_MANAGERS_TAB");

		var partnerRegionCodeFormatted = Partner.formatRegionCode(regionCode = "${partnerRegionCode}");

		for (var partnerManagerUserEmail : list "${partnerManagerUserEmailList}") {
			PartnerCPPartnerAdmin.findRowID(
				partnerItem1 = "${partnerManagerUserEmail}",
				partnerItem2 = "${partnerManagerType}",
				partnerItem3 = "${partnerRegionCodeFormatted}");

			PartnerCPPartnerAdmin.deleteRow(
				partnerItem1 = "${partnerManagerUserEmail}",
				partnerItem2 = "${partnerManagerType}",
				partnerItem3 = "${partnerRegionCodeFormatted}");
		}
	}

	macro deleteRow {
		var key_item1 = "${partnerItem1}";
		var key_item2 = "${partnerItem2}";
		var key_item3 = "${partnerItem3}";

		Click(locator1 = "PartnerCPPartnerAdmin#TABLE_ROW_OPTIONS");

		Click(locator1 = "PartnerCPPartnerAdmin#DROPDOWN_OPTION_DELETE");

		Confirm(value1 = "Are you sure you want to delete this? It will be deleted immediately.");

		Partner.assertSuccess();
	}

	macro findRowID {
		var key_item1 = "${partnerItem1}";
		var key_item2 = "${partnerItem2}";
		var key_item3 = "${partnerItem3}";

		while ((IsElementNotPresent(locator1 = "PartnerCPPartnerAdmin#TABLE_ROW")) && (IsElementNotPresent(locator1 = "PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON_DISABLED")) && (IsElementPresent(locator1 = "PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON"))) {
			Click(locator1 = "PartnerCPPartnerAdmin#PAGINATION_NEXT_BUTTON");
		}

		AssertElementPresent(locator1 = "PartnerCPPartnerAdmin#TABLE_ROW");
	}

}