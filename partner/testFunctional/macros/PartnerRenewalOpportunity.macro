<definition>
	<command name="assertAccountName">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerRenewalOpportunity#RENEWAL_OPPORTUNITY_TITLE" value1="${partnerRenewalOpportunityAccount}" />
	</command>

	<command name="assertTimelineActivity">
		<if>
			<and>
				<isset var="partnerRenewalOpportunityOrder" />
				<not>
					<contains string="${partnerRenewalOpportunityOrder}" substring="{partnerRenewalOpportunityOrder}" />
				</not>
			</and>
			<then>
				<var name="key_partnerRenewalOpportunityOrder" value="${partnerRenewalOpportunityOrder}" />
			</then>
			<else>
				<var name="key_partnerRenewalOpportunityOrder" value="1" />
			</else>
		</if>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerRenewalOpportunity#RENEWAL_OPPORTUNITY_TIMELINE_ACTIVITY_ORDER" value1="${partnerRenewalOpportunityTimelineActivity}" />
	</command>

	<command name="clickRequestChange">
		<execute function="Click" locator1="PartnerRenewalOpportunity#REQUEST_CHANGE_BUTTON" />

		<execute function="Type#sendKeys" locator1="PartnerRenewalOpportunity#REQUEST_CHANGE_TEXTBOX" value1="${partnerRenewalOpportunityComment}" />

		<execute macro="Partner#clickSaveButton" />

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="clickRequestOrderForm">
		<execute function="Click" locator1="PartnerRenewalOpportunity#REQUEST_ORDER_FORM_BUTTON" />

		<execute macro="Partner#assertSuccess" />
	</command>
</definition>