definition {

	macro assertAccountName {
		AssertTextEquals.assertPartialText(
			locator1 = "PartnerRenewalOpportunity#RENEWAL_OPPORTUNITY_TITLE",
			value1 = "${partnerRenewalOpportunityAccount}");
	}

	macro assertTimelineActivity {
		if (isSet(partnerRenewalOpportunityOrder) && isSet(partnerRenewalOpportunityOrder)) {
			var key_partnerRenewalOpportunityOrder = "${partnerRenewalOpportunityOrder}";
		}
		else {
			var key_partnerRenewalOpportunityOrder = "1";
		}

		AssertTextEquals.assertPartialText(
			locator1 = "PartnerRenewalOpportunity#RENEWAL_OPPORTUNITY_TIMELINE_ACTIVITY_ORDER",
			value1 = "${partnerRenewalOpportunityTimelineActivity}");
	}

	macro clickRequestChange {
		Click(locator1 = "PartnerRenewalOpportunity#REQUEST_CHANGE_BUTTON");

		Type.sendKeys(
			locator1 = "PartnerRenewalOpportunity#REQUEST_CHANGE_TEXTBOX",
			value1 = "${partnerRenewalOpportunityComment}");

		Partner.clickSaveButton();

		Partner.assertSuccess();
	}

	macro clickRequestOrderForm {
		Click(locator1 = "PartnerRenewalOpportunity#REQUEST_ORDER_FORM_BUTTON");

		Partner.assertSuccess();
	}

}