<definition>
	<command name="addActivity">
		<execute function="Click" locator1="PartnerMDFRequestForm#ADD_MARKETING_ACTIVITY_BUTTON" />

		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_NAME" value1="${partnerMDFRequestActivityName}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TYPE" value1="${partnerMDFRequestActivityType}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TACTIC" value1="${partnerMDFRequestActivityTactic}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_CAMPAIGN" value1="${partnerMDFRequestActivityCampaign}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_START_DATE" value1="${partnerMDFRequestActivityStartDate}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_END_DATE" value1="${partnerMDFRequestActivityEndDate}" />

		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE" value1="${partnerMDFRequestActivityLineItem}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE_COST" value1="${partnerMDFRequestActivityLineItemCost}" />

		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TARGET_AUDIENCE" value1="${partnerMDFRequestActivityTargetAudience}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TARGET_LEAD_GOAL" value1="${partnerMDFRequestActivityTargetLeadGoal}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_FOLLOW_UP_STRATEGY" value1="${partnerMDFRequestActivityFollowUpStrategy}" />

		<execute function="Click" locator1="PartnerMDFRequestForm#SAVE_MARKETING_ACTIVITY_BUTTON" />

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="assertSuccessPage">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequestForm#SUBMISSION_FORM_TITLE" value1="MDF Request Submitted Successfully" />
	</command>

	<command name="clickSeeMDFRequestsButton">
		<execute function="Click" locator1="PartnerMDFRequestForm#SEE_MDF_REQUESTS_BUTTON" />
	</command>

	<command name="editBusinessGoals">
		<execute macro="Partner#unselectOptions">
			<var name="selectOptionList" value="${partnerMDFRequestBusinessGoals}" />
			<var name="unselectOptionList" value="${partnerMDFRequestUnselectBusinessGoals}" />
		</execute>

		<execute macro="Partner#clickSaveAndContinueButton" />
	</command>

	<command name="editGeneralInformation">
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_CURRENCY_CODE" value1="${partnerMDFRequestCurrencyCode}" />
		<execute function="SelectFieldText" locator1="PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER" value1="${partnerMDFRequestPhoneNumber}" />
	</command>

	<command name="fillBusinessGoals">
		<for list="${partnerMDFRequestBusinessGoals}" param="businessGoal">
			<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_BUSINESS_GOALS" value1="${businessGoal}" />
		</for>

		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_VERTICAL_MARKET_FOCUS" value1="${partnerMDFRequestMarketFocus}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_MARKETING_PLAN" value1="${partnerMDFRequestMarketingPlan}" />
	</command>

	<command name="fillGeneralInformation">
		<var name="key_fundingPeriod" value="${partnerMDFRequestFundingPeriod}" />

		<execute function="Click" locator1="PartnerMDFRequestForm#MDF_REQUEST_FUNDING_PERIOD" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_COMPANY_NAME" value1="${partnerMDFRequestCompanyName}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_REGION" value1="${partnerMDFRequestRegion}" />
		<execute function="Select" locator1="PartnerMDFRequestForm#MDF_REQUEST_CURRENCY_CODE" value1="${partnerMDFRequestCurrencyCode}" />
		<execute function="Type#sendKeys" locator1="PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER" value1="${partnerMDFRequestPhoneNumber}" />
	</command>

	<command name="viewDisabledGeneralInformation">
		<var name="key_companyName" value="${partnerMDFRequestCompanyName}" />
		<var name="key_fundingPeriod" value="${partnerMDFRequestFundingPeriod}" />
		<var name="key_region" value="${partnerMDFRequestRegion}" />

		<execute function="AssertElementPresent" locator1="PartnerMDFRequestForm#MDF_REQUEST_FUNDING_PERIOD_DISABLED" />
		<execute function="AssertElementPresent" locator1="PartnerMDFRequestForm#MDF_REQUEST_COMPANY_NAME_DISABLED" />
		<execute function="AssertElementPresent" locator1="PartnerMDFRequestForm#MDF_REQUEST_REGION_DISABLED" />
	</command>
</definition>