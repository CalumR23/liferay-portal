definition {

	macro addActivity {
		Click(locator1 = "PartnerMDFRequestForm#ADD_MARKETING_ACTIVITY_BUTTON");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_NAME",
			value1 = "${partnerMDFRequestActivityName}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TYPE",
			value1 = "${partnerMDFRequestActivityType}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TACTIC",
			value1 = "${partnerMDFRequestActivityTactic}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_CAMPAIGN",
			value1 = "${partnerMDFRequestActivityCampaign}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_START_DATE",
			value1 = "${partnerMDFRequestActivityStartDate}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_END_DATE",
			value1 = "${partnerMDFRequestActivityEndDate}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE",
			value1 = "${partnerMDFRequestActivityLineItem}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE_COST",
			value1 = "${partnerMDFRequestActivityLineItemCost}");

		SelectFieldText(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TOTAL_MDF_REQUESTED");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TOTAL_MDF_REQUESTED",
			value1 = "${partnerMDFRequestActivityTotalMDFRequested}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TARGET_AUDIENCE",
			value1 = "${partnerMDFRequestActivityTargetAudience}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_TARGET_LEAD_GOAL",
			value1 = "${partnerMDFRequestActivityTargetLeadGoal}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_ACTIVITY_FOLLOW_UP_STRATEGY",
			value1 = "${partnerMDFRequestActivityFollowUpStrategy}");

		Click(locator1 = "PartnerMDFRequestForm#SAVE_MARKETING_ACTIVITY_BUTTON");
	}

	macro assertConflict {
		AssertElementPresent(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_FAILURE_MESSAGE");
	}

	macro assertSuccessPage {
		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequestForm#SUBMISSION_FORM_TITLE",
			value1 = "MDF Request Submitted Successfully");
	}

	macro clickSeeMDFRequestsButton {
		Click(locator1 = "PartnerMDFRequestForm#SEE_MDF_REQUESTS_BUTTON");
	}

	macro deleteMDFRequestConflict {
		Partner.pause(pauseTime = "2000");

		if (IsElementPresent(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_FAILURE_MESSAGE")) {
			PartnerMarketingMDF.deleteMDFRequestConflict(
				partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
				roleName = "${roleName}");

			// LRQA-44000 Uncomment if not impersonating

			//Partner.logoutUserCP();
			//Partner.loginUser(roleName = "${roleName}");

			Partner.gotoMarketingMDF(roleName = "${roleName}");

			PartnerMarketingMDF.clickNewMDFRequestButton();

			PartnerMDFRequestForm.fillGeneralInformation(
				partnerMDFRequestCompanyName = "${partnerMDFRequestCompanyName}",
				partnerMDFRequestCurrencyCode = "${partnerMDFRequestCurrencyCode}",
				partnerMDFRequestFundingPeriod = "${partnerMDFRequestFundingPeriod}",
				partnerMDFRequestPhoneNumber = "${partnerMDFRequestPhoneNumber}",
				partnerMDFRequestRegion = "${partnerMDFRequestRegion}");

			Partner.clickSaveAndContinueButton();
		}
	}

	macro editBusinessGoals {
		Partner.unselectOptions(
			selectOptionList = "${partnerMDFRequestBusinessGoals}",
			unselectOptionList = "${partnerMDFRequestUnselectBusinessGoals}");

		Partner.clickSaveAndContinueButton();
	}

	macro editGeneralInformation {
		if (isSet(partnerMDFRequestFundingPeriod) && isSet(partnerMDFRequestFundingPeriod)) {
			for (var fundingPeriod : list "${partnerMDFRequestFundingPeriod}") {
				var key_fundingPeriod = "${fundingPeriod}";

				Click(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_FUNDING_PERIOD");
			}
		}

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_CURRENCY_CODE",
			value1 = "${partnerMDFRequestCurrencyCode}");

		SelectFieldText(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER",
			value1 = "${partnerMDFRequestPhoneNumber}");
	}

	macro fillBusinessGoals {
		for (var businessGoal : list "${partnerMDFRequestBusinessGoals}") {
			Select(
				locator1 = "PartnerMDFRequestForm#MDF_REQUEST_BUSINESS_GOALS",
				value1 = "${businessGoal}");
		}

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_VERTICAL_MARKET_FOCUS",
			value1 = "${partnerMDFRequestMarketFocus}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_MARKETING_PLAN",
			value1 = "${partnerMDFRequestMarketingPlan}");
	}

	macro fillGeneralInformation {
		for (var fundingPeriod : list "${partnerMDFRequestFundingPeriod}") {
			var key_fundingPeriod = "${fundingPeriod}";

			Click(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_FUNDING_PERIOD");
		}

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_COMPANY_NAME",
			value1 = "${partnerMDFRequestCompanyName}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_REGION",
			value1 = "${partnerMDFRequestRegion}");

		Select(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_CURRENCY_CODE",
			value1 = "${partnerMDFRequestCurrencyCode}");

		Type.sendKeys(
			locator1 = "PartnerMDFRequestForm#MDF_REQUEST_PHONE_NUMBER",
			value1 = "${partnerMDFRequestPhoneNumber}");
	}

	macro viewDisabledGeneralInformation {
		var key_companyName = "${partnerMDFRequestCompanyName}";
		var key_fundingPeriod = "${partnerMDFRequestFundingPeriod}";
		var key_region = "${partnerMDFRequestRegion}";

		AssertElementPresent(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_FUNDING_PERIOD_DISABLED");

		AssertElementPresent(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_COMPANY_NAME_DISABLED");

		AssertElementPresent(locator1 = "PartnerMDFRequestForm#MDF_REQUEST_REGION_DISABLED");
	}

}