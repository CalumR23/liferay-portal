<definition>
	<command name="assertSuccessPage">
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFRequestForm#SUBMISSION_FORM_TITLE" value1="Thank you, your opportunity has been registered." />
		<execute function="AssertElementPresent" locator1="PartnerOpportunityForm#SEE_OPPORTUNITIES_BUTTON" />
	</command>

	<command name="clickSeeOpportunitiesButton">
		<execute function="Click" locator1="PartnerOpportunityForm#SEE_OPPORTUNITIES_BUTTON" />
	</command>

	<command name="fillNewOpportunity">
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_ACCOUNT_NAME" value1="${partnerOpportunityProspectAccountName}" />
		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_INDUSTRY" value1="${partnerOpportunityProspectIndustry}" />
		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_COUNTRY" value1="${partnerOpportunityProspectCountry}" />

		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_FIRST_NAME" value1="${partnerOpportunityCustomerFirstName}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_LAST_NAME" value1="${partnerOpportunityCustomerLastName}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_EMAIL_ADDRESS" value1="${partnerOpportunityCustomerEmailAddress}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_PHONE_NUMBER" value1="${partnerOpportunityCustomerPhoneNumber}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_BUSINESS_UNIT" value1="${partnerOpportunityCustomerBusinessUnit}" />
		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_DEPARTMENT" value1="${partnerOpportunityCustomerDepartment}" />
		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_JOB_ROLE" value1="${partnerOpportunityCustomerJobRole}" />

		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_DEAL_SIZE" value1="${partnerOpportunityDealSize}" />
		<execute function="Select" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_PURCHASE_TIME_FRAME" value1="${partnerOpportunityPurchaseTimeFrame}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_DESCRIPTION" value1="${partnerOpportunityDescription}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_ANTICIPATED_PARTNER_SERVICES" value1="${partnerOpportunityAnticipatedPartnerServices}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_ANTICIPATED_LIFERAY_PRODUCTS" value1="${partnerOpportunityAnticipatedLiferayServices}" />
		<execute function="Type#sendKeys" locator1="PartnerOpportunityForm#PARTNER_OPPORTUNITY_COMPLETED_SALES_ACTIVITIES" value1="${partnerOpportunityCompletedSalesActivities}" />
	</command>
</definition>