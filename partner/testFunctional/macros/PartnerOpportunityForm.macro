definition {

	macro assertSuccessPage {
		AssertTextEquals.assertPartialText(
			locator1 = "PartnerMDFRequestForm#SUBMISSION_FORM_TITLE",
			value1 = "Thank you, your opportunity has been registered.");

		AssertElementPresent(locator1 = "PartnerOpportunityForm#SEE_OPPORTUNITIES_BUTTON");
	}

	macro clickSeeOpportunitiesButton {
		Click(locator1 = "PartnerOpportunityForm#SEE_OPPORTUNITIES_BUTTON");
	}

	macro fillNewOpportunity {
		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_ACCOUNT_NAME",
			value1 = "${partnerOpportunityProspectAccountName}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_INDUSTRY",
			value1 = "${partnerOpportunityProspectIndustry}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_PROSPECT_COUNTRY",
			value1 = "${partnerOpportunityProspectCountry}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_FIRST_NAME",
			value1 = "${partnerOpportunityCustomerFirstName}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_LAST_NAME",
			value1 = "${partnerOpportunityCustomerLastName}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_EMAIL_ADDRESS",
			value1 = "${partnerOpportunityCustomerEmailAddress}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_PHONE_NUMBER",
			value1 = "${partnerOpportunityCustomerPhoneNumber}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_BUSINESS_UNIT",
			value1 = "${partnerOpportunityCustomerBusinessUnit}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_DEPARTMENT",
			value1 = "${partnerOpportunityCustomerDepartment}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_CUSTOMER_JOB_ROLE",
			value1 = "${partnerOpportunityCustomerJobRole}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_DEAL_SIZE",
			value1 = "${partnerOpportunityDealSize}");

		Select(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_PURCHASE_TIME_FRAME",
			value1 = "${partnerOpportunityPurchaseTimeFrame}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_DESCRIPTION",
			value1 = "${partnerOpportunityDescription}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_ANTICIPATED_PARTNER_SERVICES",
			value1 = "${partnerOpportunityAnticipatedPartnerServices}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_ANTICIPATED_LIFERAY_PRODUCTS",
			value1 = "${partnerOpportunityAnticipatedLiferayServices}");

		Type.sendKeys(
			locator1 = "PartnerOpportunityForm#PARTNER_OPPORTUNITY_COMPLETED_SALES_ACTIVITIES",
			value1 = "${partnerOpportunityCompletedSalesActivities}");
	}

}