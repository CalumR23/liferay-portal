<definition>
	<command name="assertBusinessPlan">
		<var name="key_businessPlan" value="${partnerBusinessPlanID}" />
		<var method="StringUtil#upperCase('${partnerBusinessPlanStatus}')" name="partnerBusinessPlanStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_PARTNER" value1="${partnerBusinessPlanPartner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_PARTNER_REGION" value1="${partnerBusinessPlanPartnerRegion}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_STATUS" value1="${partnerBusinessPlanStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER" value1="${partnerBusinessPlanLiferayBusinessPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER" value1="${partnerBusinessPlanLiferayMarketingPlanOwner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT" value1="${partnerBusinessPlanLiferayRenewalContact}" />
	</command>

	<command name="assertMDFClaim">
		<var name="key_mdfClaim" value="${partnerMDFClaimID}" />
		<var method="StringUtil#upperCase('${partnerMDFClaimStatus}')" name="partnerMDFClaimStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFClaimID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_CLAIM_PARTNER" value1="${partnerMDFClaimPartner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_CLAIM_STATUS" value1="${partnerMDFClaimStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_CLAIM_TYPE" value1="${partnerMDFClaimType}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_CLAIM_AMOUNT_CLAIMED" value1="${partnerMDFClaimAmountClaimed}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_CLAIM_AMOUNT_PAID" value1="${partnerMDFClaimAmountPaid}" />
	</command>

	<command name="assertMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />
		<var method="StringUtil#upperCase('${partnerMDFRequestStatus}')" name="partnerMDFRequestStatus" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_REQUEST_PARTNER" value1="${partnerMDFRequestPartner}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_REQUEST_STATUS" value1="${partnerMDFRequestStatus}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_REQUEST_TOTAL_COST" value1="${partnerMDFRequestTotalCost}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_REQUEST_AMOUNT_REQUESTED" value1="${partnerMDFRequestAmountRequested}" />
		<execute function="AssertTextEquals#assertPartialText" locator1="PartnerMDFManager#MDF_REQUEST_AMOUNT_APPROVED" value1="${partnerMDFRequestAmountApproved}" />
	</command>

	<command name="clickBusinessPlan">
		<var name="key_businessPlan" value="${partnerBusinessPlanID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerBusinessPlanID}" />
		</execute>

		<execute function="Click" locator1="PartnerMDFManager#BUSINESS_PLAN_ID" />
	</command>

	<command name="clickMDFClaim">
		<var name="key_mdfClaim" value="${partnerMDFClaimID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFClaimID}" />
		</execute>

		<execute function="Click" locator1="PartnerMDFManager#MDF_CLAIM_ID" />
	</command>

	<command name="clickMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute macro="Partner#findRowID">
			<var name="rowID" value="${partnerMDFRequestID}" />
		</execute>

		<execute function="Click" locator1="PartnerMDFManager#MDF_REQUEST_ID" />
	</command>

	<command name="clickNewBusinessPlanButton">
		<execute function="Click" locator1="PartnerMDFManager#NEW_BUSINESS_PLAN_BUTTON" />
	</command>

	<command name="deleteBusinessPlan">
		<var name="key_businessPlan" value="${partnerBusinessPlanID}" />

		<execute function="Click" locator1="PartnerMDFManager#BUSINESS_PLAN_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>

	<command name="deleteMDFRequest">
		<var name="key_mdfRequest" value="${partnerMDFRequestID}" />

		<execute function="Click" locator1="PartnerMDFManager#MDF_REQUEST_OPTIONS" />

		<execute function="Click" locator1="Partner#DROPDOWN_OPTION_DELETE" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />

		<execute macro="Partner#pause">
			<var name="pauseTime" value="2000" />
		</execute>

		<execute macro="Partner#assertSuccess" />
	</command>
</definition>