<html>
<head>
<title>PartnerRenewalOpportunities</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerRenewalOpportunities</td></tr>
</thead>
<tbody>
<!--RENEWAL_OPPORTUNITIES_DASHBOARD-->
<tr>
	<td>RENEWAL_OPPORTUNITY_ACCOUNT</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_START_DATE</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_END_DATE</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_PARTNER_PRICE</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_STAGE</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_STATUS</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_OPTIONS</td>
	<td>//tr[contains(.,'${key_partnerRenewalOpportunity}')]/td[7]/div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>