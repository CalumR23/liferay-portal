<html>
<head>
<title>PartnerOpportunities</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerOpportunities</td></tr>
</thead>
<tbody>
<!--PARTNER_OPPORTUNITIES_BUTTON-->
<tr>
	<td>ADD_OPPORTUNITY_BUTTON</td>
	<td>//span[contains(.,'Add Opportunity')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PARTNER_OPPORTUNITIES_DASHBOARD-->
<tr>
	<td>PARTNER_OPPORTUNITY_ACCOUNT</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_START_DATE</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_END_DATE</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_PARTNER_PRICE</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_PARTNER_REP</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_LIFERAY_REP</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_STAGE</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_OPTIONS</td>
	<td>//tr[contains(.,'${key_partnerOpportunity}')]/td[8]/div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PARTNER_OPPORTUNITIES_DASHBOARD_DROPDOWN-->
<tr>
	<td>PARTNER_OPPORTUNITY_DROPDOWN</td>
	<td>//div[@class='partner-opportunities-owner-filter dropdown']//a[@class='dropdown-toggle']</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DROPDOWN_OPTION</td>
	<td>//div[@class='partner-opportunities-owner-filter dropdown open']//li/a[contains(.,'${key_partnerOpportunity}')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DROPDOWN_CLOSED</td>
	<td>//div[@class='closed-opportunities-acount-filter dropdown']//a[@class='dropdown-toggle']</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_OPPORTUNITY_DROPDOWN_OPTION_CLOSED</td>
	<td>//div[@class='closed-opportunities-acount-filter dropdown open']//li/a[contains(.,'${key_partnerOpportunity}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>