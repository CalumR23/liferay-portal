<html>
<head>
<title>Partner</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">Partner</td></tr>
</thead>
<tbody>
<!--HOME_PAGE-->
<tr>
	<td>HOME_SIGN_IN_LINK</td>
	<td>//p/a[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--LOGIN_PAGE-->
<tr>
	<td>SIGN_IN_LINK</td>
	<td>//a[contains(.,'Sign In')]</td>
	<td></td>
</tr>
<tr>
	<td>EMAIL_ADDRESS_FIELD</td>
	<td>//label[contains(.,'Email Address')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>PASSWORD_FIELD</td>
	<td>//label[contains(.,'Password')]//following-sibling::input</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_IN_BUTTON</td>
	<td>//form[contains(.,'Sign In')]//div/button</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--NAVIGATION_BAR-->
<tr>
	<td>NAVBAR_HOME</td>
	<td>//li[@id='layout_Home']/a</td>
	<td></td>
</tr>
<tr>
	<td>NAVBAR_MANAGEMENT</td>
	<td>//li[@id='layout_Management']/a</td>
	<td></td>
</tr>
<tr>
	<td>NAVBAR_SALES</td>
	<td>//li[@id='layout_Sales']/a</td>
	<td></td>
</tr>
<tr>
	<td>NAVBAR_MARKETING</td>
	<td>//li[@id='layout_Marketing']/a</td>
	<td></td>
</tr>
<tr>
	<td>GENERAL_TAB</td>
	<td>//li/a[contains(.,'${key_tabName}')]</td>
	<td></td>
</tr>
<tr>
	<td>BACK_ARROW</td>
	<td>//*[local-name()='svg' and contains(@class,'lexicon-icon-angle-left')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--DROPDOWN_MENU-->
<tr>
	<td>USER_DROPDOWN_ICON</td>
	<td>//span[@class='user-avatar-image']/div</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_OUT_LINK</td>
	<td>//li/a[text()='Sign Out']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SUCCESS_MESSAGE-->
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[contains(@class,'alert-success')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--GENERAL_BUTTONS-->
<tr>
	<td>NEXT_BUTTON</td>
	<td>//span[text()='Next']</td>
	<td></td>
</tr>
<tr>
	<td>PREVIOUS_BUTTON</td>
	<td>//span[text()='Previous']</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_BUTTON</td>
	<td>//span[text()='Cancel']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_DRAFT_BUTTON</td>
	<td>//span[text()='Save Draft']</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_AND_CONTINUE_BUTTON</td>
	<td>//span[text()='Save and Continue']</td>
	<td></td>
</tr>
<tr>
	<td>EDIT_BUTTON</td>
	<td>//span[text()='Edit']</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_BUTTON</td>
	<td>//span[text()='Submit']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_OR_CLAIM_TABLE-->
<tr>
	<td>TABLE_ROW_ID</td>
	<td>//tr[contains(.,'${key_rowID}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_LAST_ROW_ID</td>
	<td>//tbody//tr[last()-1]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_OPTION_EDIT</td>
	<td>//div[contains(@class,'open')]//ul[contains(@class,'dropdown-menu')]//li//span[contains(.,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_OPTION_DUPLICATE</td>
	<td>//div[contains(@class,'open')]//ul[contains(@class,'dropdown-menu')]//li//span[contains(.,'Duplicate')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_OPTION_DELETE</td>
	<td>//div[contains(@class,'open')]//ul[contains(@class,'dropdown-menu')]//li//span[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PAGINATION_BUTTONS-->
<tr>
	<td>PAGINATION_NEXT_BUTTON_DISABLED</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//li[@class='disabled']/a[normalize-space(text())='Next']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_LAST_BUTTON_DISABLED</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//li[@class='disabled']/a[normalize-space(text())='Last →']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_NEXT_BUTTON</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//a[normalize-space(text())='Next']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_PREVIOUS_BUTTON</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//a[normalize-space(text())='Previous']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_FIRST_BUTTON</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//a[normalize-space(text())='← First']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_LAST_BUTTON</td>
	<td>//div[contains(@id,'PageIteratorBottom')]//a[normalize-space(text())='Last →']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MODAL-->
<tr>
	<td>MODAL_COMMENT</td>
	<td>//textarea[contains(@id,'workflowCommentTemplate')] | //textarea[contains(@id,'submitCommentTemplate')]</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_CANCEL</td>
	<td>//div[contains(@class,'modal-footer')]//button[contains(.,'Cancel')]</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_SUBMIT</td>
	<td>//div[contains(@class,'modal-footer')]//button[contains(.,'Submit')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_OR_CLAIM_HEADER-->
<tr>
	<td>TITLE_ID</td>
	<td>//h1[@class='form-entry-id']</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_BOX</td>
	<td>//div[contains(@class,'form-entry-comments')]</td>
	<td></td>
</tr>
<tr>
	<td>COMMENT_BOX_CONTENT</td>
	<td>//div[contains(@class,'form-entry-comments')]//div[contains(@class,'comment-content')]//span[@class='comment-body' and contains(.,'${key_comment}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--WORKFLOW_BUTTONS-->
<tr>
	<td>REJECT_BUTTON</td>
	<td>//button/span[contains(.,'Reject')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_MORE_INFO_BUTTON</td>
	<td>//button/span[contains(.,'Request More Info')]</td>
	<td></td>
</tr>
<tr>
	<td>SEND_FOR_MANAGER_REVIEW_BUTTON</td>
	<td>//button/span[contains(.,'Send for Manager Review')]</td>
	<td></td>
</tr>
<tr>
	<td>RESEND_FOR_REVIEW_BUTTON</td>
	<td>//button/span[contains(.,'Resend for Review')]</td>
	<td></td>
</tr>
<tr>
	<td>APPROVE_BUTTON</td>
	<td>//button/span[contains(.,'Approve')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--SELECT_OPTIONS-->
<tr>
	<td>SELECT_OPTION</td>
	<td>//select/option[normalize-space(text())='${key_option}']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--OPTIONS_MENU_BUTTONS-->
<tr>
	<td>OPTIONS_VIEW_BUTTON</td>
	<td>//a/span[text()='View']</td>
	<td></td>
</tr>
<tr>
	<td>OPTIONS_DUPLICATE_BUTTON</td>
	<td>//a/span[text()='Duplicate']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>