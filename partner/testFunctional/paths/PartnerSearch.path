<html>
<head>
<title>PartnerSearch</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerSearch</td></tr>
</thead>

<tbody>

<!--SEARCH_RESULTS-->

<tr>
	<td>SEARCH_RESULT_ITEM_TITLE</td>
	<td>//div[contains(@class,'searchcontainer-content')]//li//h5//strong[contains(.,'${key_searchKeyword}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_ITEM_SUBTITLE</td>
	<td>//div[contains(@class,'searchcontainer-content')]//li//h6[contains(.,'${key_searchKeyword}')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_RESULT_EMPTY</td>
	<td>//div[contains(@class,'empty-result-message')]//div[contains(.,'No results were found that matched the keywords:')]//strong[contains(.,' ${key_searchKeyword}')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>