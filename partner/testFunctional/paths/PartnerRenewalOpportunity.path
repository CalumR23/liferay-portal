<html>
<head>
<title>PartnerRenewalOpportunity</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerRenewalOpportunity</td></tr>
</thead>
<tbody>
<!--RENEWAL_OPPORTUNITY_DETAILS-->
<tr>
	<td>RENEWAL_OPPORTUNITY_TITLE</td>
	<td>//h1[@class='card-title']</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_ACCOUNT</td>
	<td>//td[@class='account-name']</td>
	<td></td>"
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_INDUSTRY_TERRITORY</td>
	<td>//td[@class='account-industry-territory']</td>
	<td></td>
</tr>
<tr>
	<td>RENEWAL_OPPORTUNITY_TIMELINE_ACTIVITY_ORDER</td>
	<td>xpath=(//td[@class='activity'])[1]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--RENEWAL_OPPORTUNITY_DETAILS-->
<tr>
	<td>REQUEST_CHANGE_BUTTON</td>
	<td>//a/span[contains(.,'Request Change')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_CHANGE_TEXTBOX</td>
	<td>//textarea[contains(@name,'PartnerRenewalOpportunitiesPortlet_changeRequest')]</td>
	<td></td>
</tr>
<tr>
	<td>REQUEST_ORDER_FORM_BUTTON</td>
	<td>//a/span[contains(.,'Request Order Form')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>