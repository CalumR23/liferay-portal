<html>
<head>
<title>PartnerMDFClaimForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFClaimForm</td></tr>
</thead>
<tbody>
<!--MDF_CLAIM_GENERAL_INFORMATION-->
<tr>
	<td>MDF_CLAIM_TYPE</td>
	<td>//label[contains(.,'${key_mdfClaimType}')]//input[contains(@class,'radio')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_INVOICE_UPLOAD</td>
	<td>//div[@class='proof-of-performance-label' and contains(.,'Invoice')]/following-sibling::button//span[contains(.,'Upload File')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_SELECT_FILE_BUTTON</td>
	<td>//button[contains(.,'Select File')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_CLAIM_UPLOAD_PROOF_OF_PERFORMANCE-->
<tr>
	<td>MDF_CLAIM_ACTIVITY_CHECKBOX</td>
	<td>//div[@class='row activity-head' and contains(.,'${key_mdfClaimActivity}')]//input[@type='checkbox']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_ACTIVITY_POP_UPLOAD</td>
	<td>//div[contains(@class,'activity-container') and contains(.,'${key_mdfClaimActivity}')]//div[@class='proof-of-performance-label' and contains(.,'${key_mdfClaimPOPLabel}')]/following-sibling::button//span[contains(.,'Upload File')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_ACTIVITY_POP_TEXTBOX</td>
	<td>//div[contains(@class,'activity-container') and contains(.,'${key_mdfClaimActivity}')]//label[contains(.,'${key_mdfClaimPOPLabel}')]//following-sibling::textarea</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>