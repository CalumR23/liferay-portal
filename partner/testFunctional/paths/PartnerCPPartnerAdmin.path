<html>
<head>
<title>PartnerCPPartnerAdmin</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerCPPartnerAdmin</td></tr>
</thead>

<tbody>

<!--NAVIGATION-->

<tr>
	<td>PARTNER_REGIONS_TAB</td>
	<td>//a[@title='Partner Regions']</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_MANAGERS_TAB</td>
	<td>//a[@title='Partner Managers']</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_ENTRIES_TAB</td>
	<td>//a[@title='Partner Entries']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ROW_DATA-->

<tr>
	<td>TABLE_ROW</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_item1}') and contains(.,'${key_item2}') and contains(.,'${key_item3}')]</td>
	<td></td>
</tr>
<tr>
	<td>TABLE_ROW_OPTIONS</td>
	<td>//tr[@data-qa-id='row' and contains(.,'${key_item1}') and contains(.,'${key_item2}') and contains(.,'${key_item3}')]//td/div[contains(@class,'dropdown')]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_OPTION_DELETE</td>
	<td>//a[@role='menuitem']/span[contains(.,'Delete')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_NEXT_BUTTON</td>
	<td>//ul[@class='pagination']//li//span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td>PAGINATION_NEXT_BUTTON_DISABLED</td>
	<td>//ul[@class='pagination']//li[@class='disabled']//span[@class='icon-caret-right']</td>
	<td></td>
</tr>
<tr>
	<td>ADD_ROW_BUTTON</td>
	<td>//a[@data-qa-id='addButton']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--ADD_PARTNER_MANAGER-->

<tr>
	<td>SELECT_PARTNER_REGION</td>
	<td>//select[contains(@name,'partnerRegionId')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_PARTNER_TYPE</td>
	<td>//select[contains(@name,'PartnerAdminPortlet_type')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_PARTNER_USER_EMAIL</td>
	<td>//select[contains(@name,'partnerManagerUserId')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_BUTTON</td>
	<td>//span[contains(.,'Save')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>