<html>
<head>
<title>PartnerMDFPartner</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFPartner</td></tr>
</thead>
<tbody>
<!--MDF_REQUEST_BUTTON-->
<tr>
	<td>NEW_MDF_REQUEST_BUTTON</td>
	<td>//span[contains(.,'New MDF Request')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUESTS_DASHBOARD-->
<tr>
	<td>MDF_REQUEST_ID</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_STATUS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[2]/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_FUNDING_PERIOD</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_TOTAL_COST</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_REQUESTED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_REIMBURSEMENT_CLAIMS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_OPTIONS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[7]//*[local-name()='svg' and contains(@class,'ellipsis')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>