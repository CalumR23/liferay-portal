<html>
<head>
<title>PartnerRebatePaymentForm</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerRebatePaymentForm</td></tr>
</thead>

<tbody>

<!--PARTNER_INFORMATION-->

<tr>
	<td>LIFERAY_PARTNER_NAME</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_partnerEntryName')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_STREET</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_partnerStreet1')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_CITY</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_partnerCity')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_COUNTRY</td>
	<td>//select[contains(@name,'RebatePaymentFormPortlet_partnerCountryId')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_ZIP</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_partnerZip')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_REGION</td>
	<td>//select[contains(@name,'RebatePaymentFormPortlet_partnerRegionId')]</td>
	<td></td>
</tr>
<tr>
	<td>PARTNER_LEAD_CONTACT_USER</td>
	<td>//select[contains(@name,'RebatePaymentFormPortlet_leadContactUserId')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--REBATE_METHOD-->

<tr>
	<td>REBATE_METHOD_LIFERAY_CREDIT_NOTE</td>
	<td>//input[contains(@id,'RebatePaymentFormPortlet_rebateMethod_1')]</td>
	<td></td>
</tr>
<tr>
	<td>REBATE_METHOD_LIFERAY_CREDIT_NOTE_CHECKED</td>
	<td>//input[@checked and contains(@id,'RebatePaymentFormPortlet_rebateMethod_1')]</td>
	<td></td>
</tr>
<tr>
	<td>REBATE_METHOD_PARTNER_INVOICE</td>
	<td>//input[contains(@id,'RebatePaymentFormPortlet_rebateMethod_3')]</td>
	<td></td>
</tr>
<tr>
	<td>REBATE_METHOD_PARTNER_INVOICE_CHECKED</td>
	<td>//input[@checked and contains(@id,'RebatePaymentFormPortlet_rebateMethod_3')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--PARTNER_BANK_ACCOUNT_DETAILS-->

<tr>
	<td>BANK_NAME</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_bankName')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_STREET</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_bankStreet1')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_CITY</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_bankCity')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_COUNTRY</td>
	<td>//select[contains(@name,'RebatePaymentFormPortlet_bankCountryId')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_ZIP</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_bankZip')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_REGION</td>
	<td>//select[contains(@name,'RebatePaymentFormPortlet_bankRegionId')]</td>
	<td></td>
</tr>
<tr>
	<td>BANK_CODE</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_bankCode')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NAME</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_accountName')]</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_NUMBER</td>
	<td>//input[contains(@name,'RebatePaymentFormPortlet_accountNumber')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>