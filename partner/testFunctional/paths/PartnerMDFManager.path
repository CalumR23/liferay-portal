<html>
<head>
<title>PartnerMDFManager</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFManager</td></tr>
</thead>
<tbody>
<!--MDF_REQUESTS_DASHBOARD-->
<tr>
	<td>MDF_REQUEST_ID</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_PARTNER</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_STATUS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[3]//span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_TOTAL_COST</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_REQUESTED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_APPROVED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_DATE_SUBMITTED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_LAST_MODIFIED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_OPTIONS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[9]//*[local-name()='svg' and contains(@class,'ellipsis')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_CLAIMS_DASHBOARD-->
<tr>
	<td>MDF_CLAIM_ID</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_PARTNER</td>
