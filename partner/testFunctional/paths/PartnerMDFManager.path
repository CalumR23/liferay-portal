</tr>
<tr>
	<td>BUSINESS_PLAN_LAST_MODIFIED</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_OPTIONS</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[9]//*[local-name()='svg' and contains(@class,'ellipsis')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>