<html>
<head>
<title>PartnerBusinessPlan</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerBusinessPlan</td></tr>
</thead>
<tbody>
<!--BUSINESS_PLAN_SUMMARY-->
<tr>
	<td>BUSINESS_PLAN_STATUS</td>
	<td>//div[@class='form-entry-status']//span[2]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_YEAR</td>
	<td>//h5[contains(.,'Year')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_TOTAL_REVENUE_PROJECTIONS</td>
	<td>//h5[contains(.,'Total Revenue Projections')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_NUMBER_OF_GOALS</td>
	<td>//h5[contains(.,'Number of Goals')]/following-sibling::span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--BUSINESS_PLAN_ACCOUNT_INFORMATION-->
<tr>
	<td>BUSINESS_PLAN_PARTNER_COMPANY</td>
	<td>//td[contains(.,'Company Name:')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_PARTNER_REGION</td>
	<td>//td[contains(.,'Region:')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_PARTNER_CURRENCY</td>
	<td>//td[contains(.,'Currency:')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_PARTNER_BUSINESS_PLAN_OWNER</td>
	<td>//h4[contains(.,'Partner Information')]/following-sibling::table//td[contains(.,'Business Plan Owner')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_PARTNER_MARKETING_PLAN_OWNER</td>
	<td>//h4[contains(.,'Partner Information')]/following-sibling::table//td[contains(.,'Marketing Plan Owner')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER</td>
	<td>//h4[contains(.,'Liferay Information')]/following-sibling::table//td[contains(.,'Business Plan Owner')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER</td>
	<td>//h4[contains(.,'Liferay Information')]/following-sibling::table//td[contains(.,'Marketing Plan Owner')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT</td>
	<td>//td[contains(.,'Renewal Contact:')]/following-sibling::td</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>