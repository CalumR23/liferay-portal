<html>
<head>
<title>PartnerMDFRequest</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFRequest</td></tr>
</thead>
<tbody>
<!--MDF_REQUESTS_SUMMARY-->
<tr>
	<td>MDF_REQUEST_STATUS</td>
	<td>//div[@class='form-entry-status']//span[2]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_FUNDING_PERIOD</td>
	<td>//div[@class='funding-periods']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_TOTAL_COST</td>
	<td>//div[@class='total-cost']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_REQUESTED</td>
	<td>//div[@class='requested-funds']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_APPROVED</td>
	<td>//div[@class='approved-funds']/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUESTS_GENERAL_INFORMATION-->
<tr>
	<td>MDF_REQUEST_CHOOSE_ALLIANCE_MANAGER_BUTTON</td>
	<td>//i[contains(@class,'glyphicon-edit')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--CHOOSE_ALLIANCE_MANAGER_MODAL-->
<tr>
	<td>MODAL_SELECT_ALLIANCE_MANAGER</td>
	<td>//select[contains(@id,'MDFRequestManagerPortlet_regionName')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUESTS_MARKETING_ACTIVITIES-->
<tr>
	<td>MDF_REQUEST_ACTIVITY_NAME</td>
	<td>//div[@class='activity' and contains(.,'${key_activity}')]//span[@class='info-title']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_TACTIC</td>
	<td>//div[@class='activity' and contains(.,'${key_activity}')]//span[@class='activity-type-tactic']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_DATES</td>
	<td>//div[@class='activity' and contains(.,'${key_activity}')]//span[@class='activity-dates']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUESTS_BUSINESS_GOALS-->
<tr>
	<td>MDF_REQUEST_BUSINESS_GOALS</td>
	<td>//span[@class='sales-goals']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_VERTICAL_MARKET_FOCUS</td>
	<td>//span[@class='market-focuses']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_MARKETING_PLAN</td>
	<td>//span[@class='marketing-plan-goals']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUESTS_REIMBURSEMENT_CLAIMS-->
<tr>
	<td>MDF_REQUEST_NEW_CLAIM_BUTTON</td>
	<td>//a/span[contains(.,'New Claim')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_TITLE</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//span[@class='claim-id']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_TYPE</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//span[@class='claim-amounts']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_AMOUNTS</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//div[@class='claim-info' and contains(.,'Amount Claimed')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_ACTIVITIES</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//span[@class='claim-activities']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_STATUS</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//div[@class='claim-status']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_OPTIONS</td>
	<td>//div[@class='row claim' and contains(.,'${key_mdfClaim}')]//*[local-name()='svg']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CLAIM_OPTIONS_NUMBER</td>
	<td>xpath=(//div[@class='row claim']//*[local-name()='svg'])[${key_mdfClaimNumber}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>