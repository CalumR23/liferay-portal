<html>
<head>
<title>PartnerManagement</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerManagement</td></tr>
</thead>

<tbody>

<!--MDF_REQUESTS_DASHBOARD-->

<tr>
	<td>MDF_REQUEST_ID</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_PARTNER</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_STATUS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[3]//span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_TOTAL_COST</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_REQUESTED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_AMOUNT_APPROVED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_DATE_SUBMITTED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_LAST_MODIFIED</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_OPTIONS</td>
	<td>//tr[contains(.,'${key_mdfRequest}')]/td[9]//div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--MDF_CLAIMS_DASHBOARD-->

<tr>
	<td>MDF_CLAIM_ID</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_PARTNER</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_STATUS</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[3]//span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_TYPE</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_AMOUNT_CLAIMED</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_AMOUNT_PAID</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_DATE_SUBMITTED</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_OPTIONS</td>
	<td>//tr[contains(.,'${key_mdfClaim}')]/td[8]//span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>

<!--BUSINESS_PLANS_DASHBOARD-->

<tr>
	<td>NEW_BUSINESS_PLAN_BUTTON</td>
	<td>//span[contains(.,'New Business Plan')]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_FILTER_BY_YEAR</td>
	<td>//div[contains(@class,'dropdown year-filter')]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_FILTER_BY_YEAR_OPTION</td>
	<td>//div[contains(@class,'dropdown year-filter')]//li/a[contains(.,'Year ${key_businessPlanYear}')]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_ID</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[1]/a</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_PARTNER</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_REGION_CODE</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_STATUS</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[4]//span</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_BUSINESS_PLAN_OWNER</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_MARKETING_PLAN_OWNER</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LIFERAY_RENEWAL_CONTACT</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[7]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_LAST_MODIFIED</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[8]</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_OPTIONS</td>
	<td>//tr[contains(.,'${key_businessPlan}')]/td[9]/div</td>
	<td></td>
</tr>
<tr>
	<td>BUSINESS_PLAN_OPTIONS2</td>
	<td>//tr[contains(.,'${key_businessPlanRegionCode}') and contains(.,'${key_businessPlanCompany}')]/td[9]/div</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>