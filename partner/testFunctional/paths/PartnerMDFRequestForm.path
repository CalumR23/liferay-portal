<html>
<head>
<title>PartnerMDFRequestForm</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFRequestForm</td></tr>
</thead>
<tbody>
<!--MDF_REQUEST_GENERAL_INFORMATION-->
<tr>
	<td>MDF_REQUEST_FUNDING_PERIOD</td>
	<td>//div[contains(@class,'funding-period-checkbox')]//label[contains(.,'${key_fundingPeriod}')]/input</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_FUNDING_PERIOD_DISABLED</td>
	<td>//label[contains(.,'${key_fundingPeriod}')]//input[contains(@class,'field disabled funding-period-checkbox')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_COMPANY_NAME</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_dossieraAccountKey')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_COMPANY_NAME_DISABLED</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_dossieraAccountKey') and contains(@class,'disabled') and contains(.,'${key_companyName}')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_REGION</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_countryId')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_REGION_DISABLED</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_countryId') and contains(@class,'disabled') and contains(.,'${key_region}')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_PARTNER_LEVEL_DISABLED</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_partnerLevel') and contains(@class,'disabled')  and @value='${key_partnerLevel}']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ALLIANCE_MANAGER_DISABLED</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_allianceManager') and contains(@class,'disabled') and @value='${key_allianceManager}']</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_CURRENCY_CODE</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_currencyCode')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_PHONE_NUMBER</td>
	<td>//input[contains(@id,'PartnerMDFPortlet_phoneNumber')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_FAILURE_MESSAGE</td>
	<td>//div[contains(@class,'alert-danger') and contains(.,'One or more selected funding periods have already been submitted. Please review your previous MDF requests and select a funding period that has not yet been submitted.')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_BUSINESS_GOALS-->
<tr>
	<td>MDF_REQUEST_BUSINESS_GOALS</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_salesGoals')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_VERTICAL_MARKET_FOCUS</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_marketFocuses')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_MARKETING_PLAN</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_marketingPlanGoals')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_ACTIVITY_BUTTONS-->
<tr>
	<td>ADD_MARKETING_ACTIVITY_BUTTON</td>
	<td>//a/span[contains(.,'Add Marketing Activity')]</td>
	<td></td>
</tr>
<tr>
	<td>SAVE_MARKETING_ACTIVITY_BUTTON</td>
	<td>//button/span[contains(.,'Save Activity')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_ACTIVITIES-->
<tr>
	<td>MDF_REQUEST_ACTIVITY_NAME</td>
	<td>//input[contains(@id,'PartnerMDFPortlet_name')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_TYPE</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_type')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_TACTIC</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_tactic')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_CAMPAIGN</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_campaign')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_START_DATE</td>
	<td>//input[contains(@id,'PartnerMDFPortlet_startDate')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_END_DATE</td>
	<td>//input[contains(@id,'PartnerMDFPortlet_endDate')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_ACTIVITY_BUDGET_BREAKDOWN-->
<tr>
	<td>MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_lineItemType')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_LINE_ITEM_EXPENSE_COST</td>
	<td>//input[contains(@id,'PartnerMDFPortlet_lineItemAmount')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_TOTAL_MDF_REQUESTED</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_requestAmount')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_ACTIVITY_TARGET_AND_STRATEGY-->
<tr>
	<td>MDF_REQUEST_ACTIVITY_TARGET_AUDIENCE</td>
	<td>//textarea[contains(@id,'PartnerMDFPortlet_targetAudience')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_TARGET_LEAD_GOAL</td>
	<td>//textarea[contains(@id,'PartnerMDFPortlet_targetLeadGoal')]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_REQUEST_ACTIVITY_FOLLOW_UP_STRATEGY</td>
	<td>//select[contains(@id,'PartnerMDFPortlet_followUpStrategy')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_REQUEST_SUBMISSION-->
<tr>
	<td>SUBMISSION_FORM_TITLE</td>
	<td>//h1[contains(@class,'form-title')]</td>
	<td></td>
</tr>
<tr>
	<td>SEE_MDF_REQUESTS_BUTTON</td>
	<td>//a/span[contains(.,'See MDF Requests')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>