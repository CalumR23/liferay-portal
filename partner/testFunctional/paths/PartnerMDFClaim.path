<html>
<head>
<title>PartnerMDFClaim</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">PartnerMDFClaim</td></tr>
</thead>
<tbody>
<!--MDF_CLAIM_HEADER-->
<tr>
	<td>MDF_CLAIM_ID</td>
	<td>//h1[@class='mdf-claim-id']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--MDF_CLAIMS_SUMMARY-->
<tr>
	<td>MDF_CLAIM_STATUS</td>
	<td>//div[@class='mdf-claim-status']//span[2]</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_TYPE</td>
	<td>//div[@class='type']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_AMOUNT_CLAIMED</td>
	<td>//div[@class='amount-claimed']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_PAYMENT_RECEIVED</td>
	<td>//div[@class='payment-received']/span</td>
	<td></td>
</tr>
<tr>
	<td>MDF_CLAIM_CHECK_NUMBER</td>
	<td>//div[@class='check-number']/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--WORKFLOW_BUTTONS-->
<tr>
	<td>PAYOUT_CLAIM_BUTTON</td>
	<td>//button/span[contains(.,'Payout Claim')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--PAYOUT_CLAIM_MODAL-->
<tr>
	<td>MODAL_PAYOUT_CLAIM_CHECK_NUMBER</td>
	<td>//input[contains(@id,'MDFClaimManagerPortlet_checkNumberTemplate')]</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_PAYOUT_CLAIM_CHECK_DATE</td>
	<td>//input[contains(@id,'MDFClaimManagerPortlet_checkDateTemplate')]</td>
	<td></td>
</tr>
<tr>
	<td>MODAL_PAYOUT_CLAIM_CHECK_AMOUNT</td>
	<td>//input[contains(@id,'DFClaimManagerPortlet_checkAmountTemplate')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>