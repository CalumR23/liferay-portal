<definition>
	<command name="addNewApp">
		<execute function="Click" locator1="MPButton#ADD_NEW_APP_BUTTON" />
	</command>

	<command name="addNewVersion">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#ADD_NEW_VERSION_BUTTON" />
		<execute function="Click" locator1="MPButton#ADD_NEW_VERSION_BUTTON" />
	</command>

	<command name="browse">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#BROWSE_BUTTON" />
		<execute function="Click" locator1="MPButton#BROWSE_BUTTON" />
	</command>

	<command name="button1">
		<var name="key_buttonName" value="${buttonName}" />

		<execute function="ScrollWebElementIntoView" locator1="MPButton#BUTTON_1" />
		<execute function="Click" locator1="MPButton#BUTTON_1" />
	</command>

	<command name="button2">
		<var name="key_buttonName" value="${buttonName}" />

		<execute function="ScrollWebElementIntoView" locator1="MPButton#BUTTON_2" />
		<execute function="Click" locator1="MPButton#BUTTON_2" />
	</command>

	<command name="cancel">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#CANCEL_BUTTON" />
		<execute function="Click" locator1="MPButton#CANCEL_BUTTON" />
	</command>

	<command name="cancelSubmission">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#CANCEL_SUBMISSION_BUTTON" />
		<execute function="Click" locator1="MPButton#CANCEL_SUBMISSION_BUTTON" />
	</command>

	<command name="developerLicenseAddQuantityButton">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#DEVELOPER_LICENSES_ADD_QUANTITY_BUTTON" />
		<execute function="Click" locator1="MPButton#DEVELOPER_LICENSES_ADD_QUANTITY_BUTTON" />
	</command>

	<command name="edit">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#EDIT_BUTTON" />
		<execute function="Click" locator1="MPButton#EDIT_BUTTON" />
	</command>

	<command name="iconBrowse">
		<execute function="ScrollWebElementIntoView" locator1="MPDeveloperAppsAddDetails#ICON_BROWSE_BUTTON" />
		<execute function="Click" locator1="MPDeveloperAppsAddDetails#ICON_BROWSE_BUTTON" />
	</command>

	<command name="next">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#NEXT_BUTTON" />
		<execute function="Click" locator1="MPButton#NEXT_BUTTON" />
	</command>

	<command name="saveAsDraft">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#SAVE_AS_DRAFT_BUTTON" />
		<execute function="Click" locator1="MPButton#SAVE_AS_DRAFT_BUTTON" />
	</command>

	<command name="search">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#SEARCH_BUTTON" />
		<execute function="Click" locator1="MPButton#SEARCH_BUTTON" />
	</command>

	<command name="standardLicenseAddQuantityButton">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#STANDARD_LICENSES_ADD_QUANTITY_BUTTON" />
		<execute function="Click" locator1="MPButton#STANDARD_LICENSES_ADD_QUANTITY_BUTTON" />
	</command>

	<command name="submit">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#SUBMIT_BUTTON" />
		<execute function="Click" locator1="MPButton#SUBMIT_BUTTON" />
	</command>

	<command name="submitForReview">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#SUBMIT_FOR_REVIEW_BUTTON" />
		<execute function="Click" locator1="MPButton#SUBMIT_FOR_REVIEW_BUTTON" />
	</command>

	<command name="uploadBrowse">
		<execute function="ScrollWebElementIntoView" locator1="MPDeveloperAppsAddUpload#UPLOAD_BROWSE_BUTTON" />
		<execute function="Click" locator1="MPDeveloperAppsAddUpload#UPLOAD_BROWSE_BUTTON" />
	</command>

	<command name="uploadTax">
		<execute function="ScrollWebElementIntoView" locator1="MPButton#UPLOAD_TAX_BUTTON" />
		<execute function="Click" locator1="MPButton#UPLOAD_TAX_BUTTON" />
	</command>
</definition>