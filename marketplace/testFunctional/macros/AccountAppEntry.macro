definition {

	macro typeNoteToReviewer {
		Type(
			locator1 = "MPDeveloperApps#NOTE_TO_REVIEWER",
			value1 = "${noteToReviewerMessage}");
	}

	macro viewAppTitle {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#APP_TITLE",
			value1 = "${appTitle}");
	}

	macro viewCompanyName {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#COMPANY_NAME",
			value1 = "${companyName}");
	}

	macro viewCountryViaAppPricing {
		var key_country = "${country}";
		var key_tableTitle = "${tableTitle}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_COUNTRY");
	}

	macro viewCurrentRequirements {
		var key_requirementNum = "requirementNum";

		AssertTextEquals(
			locator1 = "MPDeveloperApps#CURRENT_REQUIREMENTS",
			value1 = "${liferayVersion}");
	}

	macro viewDescription {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#DESCRIPTION",
			value1 = "${appDescription}");
	}

	macro viewDeveloperLicensePriceViaAppPricing {
		var key_license = "developer";
		var key_licenseType = "prices";
		var key_tableTitle = "${tableTitle}";
		var key_value = "${developerLicensePrice}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewDeveloperLicensesPriceViaAppPreview {
		var key_licenseNum = "${licenseNum}";

		AssertTextEquals(
			locator1 = "MPDeveloperApps#DEVELOPER_PRICING_PRICE",
			value1 = "${developerLicensePrice}");
	}

	macro viewDeveloperLicensesUnitsViaAppPreview {
		var key_licenseNum = "${licenseNum}";

		if ("${developerLicenseUnits}" == "1") {
			var val = "${developerLicenseUnits} Instance Unit";
		}
		else {
			var val = "${developerLicenseUnits} Instance Units";
		}

		AssertTextEquals(
			locator1 = "MPDeveloperApps#DEVELOPER_PRICING_LICENSE",
			value1 = "${val}");
	}

	macro viewDeveloperLicenseunitViaAppPricing {
		var key_license = "developer";
		var key_licenseType = "prices";
		var key_tableTitle = "${tableTitle}";
		var key_value = "${developerLicenseUnit}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewDeveloperSubscriptionPriceViaAppPricing {
		var key_licenseType = "support";
		var key_tableTitle = "${tableTitle}";
		var key_value = "developerSubscriptionPrice";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewDeveloperSubscriptionViaAppPreview {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#DEVELOPER_SUBSCRIPTION",
			value1 = "${developerSubscriptionPrice}");
	}

	macro viewDeveloperWebsiteURL {
		var key_developerWebsiteUrl = "${developerWebsiteUrl}";

		AssertElementPresent(locator1 = "MPDeveloperApps#DEVELOPER_WEBSITE_URL");
	}

	macro viewDocumentationURL {
		var key_documentationUrl = "${documentationUrl}";

		AssertElementPresent(locator1 = "MPDeveloperApps#DOCUMENTATION_WEBSITE_URL");
	}

	macro viewLatestChanges {
		if (IsElementPresent(locator1 = "MPDeveloperApps#LATEST_CHANGES_COLLAPSED")) {
			Click(locator1 = "MPDeveloperApps#LATEST_CHANGES_COLLAPSED");
		}

		AssertTextEquals(
			locator1 = "MPDeveloperApps#LATEST_CHANGES",
			value1 = "${latestChanges}");
	}

	macro viewSourceCodeURL {
		var key_sourceCodeUrl = "${sourceCodeUrl}";

		AssertElementPresent(locator1 = "MPDeveloperApps#SOURCE_CODE_URL");
	}

	macro viewStandardLicensePriceViaAppPricing {
		var key_license = "standard";
		var key_licenseType = "prices";
		var key_tableTitle = "${tableTitle}";
		var key_value = "${standardLicensePrice}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewStandardLicensesPriceViaAppPreview {
		var key_licenseNum = "${licenseNum}";

		AssertTextEquals(
			locator1 = "MPDeveloperApps#STANDARD_PRICING_PRICE",
			value1 = "${standardLicensePrice}");
	}

	macro viewStandardLicensesUnitsViaAppPreview {
		var key_licenseNum = "${licenseNum}";

		if ("${standardLicenseUnits}" == "1") {
			var val = "${standardLicenseUnits} Instance Unit";
		}
		else {
			var val = "${standardLicenseUnits} Instance Units";
		}

		AssertTextEquals(
			locator1 = "MPDeveloperApps#STANDARD_PRICING_LICENSE",
			value1 = "${val}");
	}

	macro viewStandardLicenseUnitViaAppPricing {
		var key_license = "standard";
		var key_licenseType = "prices";
		var key_tableTitle = "${tableTitle}";
		var key_value = "${standardLicenseUnit}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewStandardSubscriptionPriceViaAppPricing {
		var key_licenseType = "support";
		var key_tableTitle = "${tableTitle}";
		var key_value = "${standardSubscriptionPrice}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_LICENSES");
	}

	macro viewStandardSubscriptionViaAppPreview {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#STANDARD_SUBSCRIPTION",
			value1 = "${standardSubscriptionPrice}");
	}

	macro viewSummaryAppStatus {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_STATUS",
			value1 = "${appStatus}");
	}

	macro viewSummaryAppTitle {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_APP_TITLE",
			value1 = "${appTitle}");
	}

	macro viewSummaryCategory {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_CATEGORY",
			value1 = "${appCategory}");
	}

	macro viewSummaryCompanyName {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_COMPANY_NAME",
			value1 = "${companyName}");
	}

	macro viewSummaryLicense {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_LICENSE",
			value1 = "${appLicense}");
	}

	macro viewSummarySupport {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_SUPPORT",
			value1 = "${appSupport}");
	}

	macro viewSummaryTrial {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_TRIAL",
			value1 = "${appTrial}");
	}

	macro viewSummaryType {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#SUMMARY_TYPE",
			value1 = "${appType}");
	}

	macro viewSupportURL {
		var key_supportUrl = "${supportUrl}";

		AssertElementPresent(locator1 = "MPDeveloperApps#SUPPORT_URL");
	}

	macro viewTableTitleViaAppPricing {
		var key_tableTitle = "${tableTitle}";

		AssertElementPresent(locator1 = "MPDeveloperApps#APP_PRICING_TABLE_NAME");
	}

	macro viewTags {
		var key_tagNum = "${tagNum}";

		AssertTextEquals(
			locator1 = "MPDeveloperApps#TAGS",
			value1 = "${tag}");
	}

	macro viewVersion {
		AssertTextEquals(
			locator1 = "MPDeveloperApps#VERSION",
			value1 = "Latest Version: ${versionNumber}");
	}

}