<definition>
	<command name="reviewAppDetails">
		<if>
			<isset var="appTitle" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryAppTitle">
					<var name="appTitle" value="${appTitle}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appType" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryType">
					<var name="appType" value="${appType}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appCategory" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryCategory">
					<var name="appCategory" value="${appCategory}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appStatus" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryAppStatus">
					<var name="appStatus" value="${appStatus}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appLicense" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryLicense">
					<var name="appLicense" value="${appLicense}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appSupport" />
			<then>
				<execute macro="AccountAppEntry#viewSummarySupport">
					<var name="appSupport" value="${appSupport}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appTrial" />
			<then>
				<execute macro="AccountAppEntry#viewSummaryTrial">
					<var name="appTrial" value="${appTrial}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appTitle" />
			<then>
				<execute macro="AccountAppEntry#viewAppTitle">
					<var name="appTitle" value="${appTitle}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="companyName" />
			<then>
				<execute macro="AccountAppEntry#viewCompanyName">
					<var name="companyName" value="${companyName}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="appDescription" />
			<then>
				<execute macro="AccountAppEntry#viewDescription">
					<var name="appDescription" value="${appDescription}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="latestChanges" />
			<then>
				<execute macro="AccountAppEntry#viewLatestChanges">
					<var name="latestChanges" value="${latestChanges}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="tags" />
			<then>
				<var name="tagNum" value="1" />

				<for list="${tags}" param="tag">
					<execute macro="AccountAppEntry#viewTags">
						<var name="tagNum" value="${tagNum}" />
						<var name="tags" value="${tags}" />
					</execute>

					<var method="MathUtil#sum('${tagNum}', '1')" name="tagNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="versionNumber" />
			<then>
				<execute macro="AccountAppEntry#viewVersion">
					<var name="versionNumber" value="${versionNumber}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="developerWebsiteUrl" />
			<then>
				<execute macro="AccountAppEntry#viewDeveloperWebsiteURL">
					<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="documentationUrl" />
			<then>
				<execute macro="AccountAppEntry#viewDocumentationURL">
					<var name="documentationUrl" value="${documentationUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="supportUrl" />
			<then>
				<execute macro="AccountAppEntry#viewSupportURL">
					<var name="supportUrl" value="${supportUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="sourceCodeUrl" />
			<then>
				<execute macro="AccountAppEntry#viewSourceCodeURL">
					<var name="sourceCodeUrl" value="${sourceCodeUrl}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="liferayVersionRequirements" />
			<then>
				<var name="requirementNum" value="1" />

				<for list="${liferayVersionRequirements}" param="liferayVersion">
					<execute macro="AccountAppEntry#viewCurrentRequirements">
						<var name="liferayVersion" value="${liferayVersion}" />
						<var name="requirementNum" value="${requirementNum}" />
					</execute>

					<var method="MathUtil#sum('${requirementNum}', '1')" name="requirementNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="standardLicenseUnitsList" />
			<then>
				<var name="licenseNum" value="1" />

				<for list="${standardLicenseUnitsList}" param="standardLicenseUnits">
					<execute macro="AccountAppEntry#viewStandardLicensesUnitsViaAppPreview">
						<var name="licenseNum" value="${licenseNum}" />
						<var name="standardLicenseUnits" value="${standardLicenseUnits}" />
					</execute>

					<var method="MathUtil#sum('${licenseNum}', '1')" name="licenseNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="standardLicensePriceList" />
			<then>
				<var name="licenseNum" value="1" />

				<for list="${standardLicensePriceList}" param="standardLicensePrice">
					<execute macro="AccountAppEntry#viewStandardLicensesPriceViaAppPreview">
						<var name="licenseNum" value="${licenseNum}" />
						<var name="standardLicensePrice" value="${standardLicensePrice}" />
					</execute>

					<var method="MathUtil#sum('${licenseNum}', '1')" name="licenseNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="standardSubscriptionPrice" />
			<then>
				<execute macro="AccountAppEntry#viewStandardSubscriptionViaAppPreview">
					<var name="standardSubscriptionPrice" value="${standardSubscriptionPrice}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="developerLicenseUnitsList" />
			<then>
				<var name="licenseNum" value="1" />

				<for list="${developerLicenseUnitsList}" param="developerLicenseUnits">
					<execute macro="AccountAppEntry#viewDeveloperLicensesUnitsViaAppPreview">
						<var name="developerLicenseUnits" value="${developerLicenseUnits}" />
						<var name="licenseNum" value="${licenseNum}" />
					</execute>

					<var method="MathUtil#sum('${licenseNum}', '1')" name="licenseNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="developerLicensePriceList" />
			<then>
				<var name="licenseNum" value="1" />

				<for list="${developerLicensePriceList}" param="developerLicensePrice">
					<execute macro="AccountAppEntry#viewDeveloperLicensesPriceViaAppPreview">
						<var name="developerLicensePrice" value="${developerLicensePrice}" />
						<var name="licenseNum" value="${licenseNum}" />
					</execute>

					<var method="MathUtil#sum('${licenseNum}', '1')" name="licenseNum" />
				</for>
			</then>
		</if>

		<if>
			<isset var="developerSubscriptionPrice" />
			<then>
				<execute macro="AccountAppEntry#viewDeveloperSubscriptionViaAppPreview">
					<var name="developerSubscriptionPrice" value="${developerSubscriptionPrice}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="noteToReviewerMessage" />
			<then>
				<execute macro="AccountAppEntry#typeNoteToReviewer">
					<var name="noteToReviewerMessage" value="${noteToReviewerMessage}" />
				</execute>
			</then>
		</if>
	</command>

	<command name="reviewAppUploadedFiles">
		<for list="${appPackageList}" param="appPackage">
			<var method="StringUtil#extractLast('${appPackage}', '~')" name="appFileList" />
			<var method="StringUtil#extractFirst('${appPackage}', '~')" name="portalVersionName" />

			<var method="StringUtil#replace('${appFileList}','+',',')" name="appFileList" />

			<for list="${appFileList}" param="fileName">
				<execute function="AssertTextEquals" locator1="MPDeveloperApps#SUMMARY_UPLOADED_FILES" value1="${fileName}">
					<var name="key_portalVersionName" value="${portalVersionName}" />
				</execute>
			</for>
		</for>
	</command>

	<command name="reviewAppPricing">
		<for list="${tableTitleList}" param="tableTitle">
			<if>
				<isset var="tableTitle" />
				<then>
					<execute macro="AccountAppEntry#viewTableTitleViaAppPricing">
						<var name="tableTitle" value="${tableTitle}" />
					</execute>
				</then>
			</if>

			<if>
				<isset var="standardLicensePriceList" />
				<then>
					<for list="${standardLicensePriceList}" param="standardLicensePrice">
						<execute macro="AccountAppEntry#viewStandardLicensePriceViaAppPricing">
							<var name="standardLicensePrice" value="${standardLicensePrice}" />
							<var name="tableTitle" value="${tableTitle}" />
						</execute>
					</for>
				</then>
			</if>

			<if>
				<isset var="developerLicensePriceList" />
				<then>
					<for list="${developerLicensePriceList}" param="developerLicensePrice">
						<execute macro="AccountAppEntry#viewDeveloperLicensePriceViaAppPricing">
							<var name="developerLicensePrice" value="${developerLicensePrice}" />
							<var name="tableTitle" value="${tableTitle}" />
						</execute>
					</for>
				</then>
			</if>

			<if>
				<isset var="standardLicenseUnitsList" />
				<then>
					<for list="${standardLicenseUnitsList}" param="standardLicenseUnit">
						<execute macro="AccountAppEntry#viewStandardLicenseUnitViaAppPricing">
							<var name="standardLicenseUnit" value="${standardLicenseUnit}" />
							<var name="tableTitle" value="${tableTitle}" />
						</execute>
					</for>
				</then>
			</if>

			<if>
				<isset var="developerLicenseUnitsList" />
				<then>
					<for list="${developerLicenseUnitsList}" param="developerLicenseUnit">
						<execute macro="AccountAppEntry#viewDeveloperLicenseunitViaAppPricing">
							<var name="developerLicenseUnit" value="${developerLicenseUnit}" />
							<var name="tableTitle" value="${tableTitle}" />
						</execute>
					</for>
				</then>
			</if>

			<if>
				<isset var="standardSubscriptionPrice" />
				<then>
					<execute macro="AccountAppEntry#viewStandardSubscriptionPriceViaAppPricing">
						<var name="standardSubscriptionPrice" value="${standardSubscriptionPrice}" />
						<var name="tableTitle" value="${tableTitle}" />
					</execute>
				</then>
			</if>

			<if>
				<isset var="developerSubscriptionPrice" />
				<then>
					<execute macro="AccountAppEntry#viewDeveloperSubscriptionPriceViaAppPricing">
						<var name="developerSubscriptionPrice" value="${developerSubscriptionPrice}" />
						<var name="tableTitle" value="${tableTitle}" />
					</execute>
				</then>
			</if>

			<if>
				<isset var="countryList" />
				<then>
					<for list="${countryList}" param="country">
						<execute macro="AccountAppEntry#viewCountryViaAppPricing">
							<var name="country" value="${country}" />
							<var name="tableTitle" value="${tableTitle}" />
						</execute>
					</for>
				</then>
			</if>
		</for>
	</command>
</definition>