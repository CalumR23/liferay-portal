definition {

	macro reviewAppDetails {
		if (isSet(appTitle)) {
			AccountAppEntry.viewSummaryAppTitle(appTitle = "${appTitle}");
		}

		if (isSet(appType)) {
			AccountAppEntry.viewSummaryType(appType = "${appType}");
		}

		if (isSet(appCategory)) {
			AccountAppEntry.viewSummaryCategory(appCategory = "${appCategory}");
		}

		if (isSet(appStatus)) {
			AccountAppEntry.viewSummaryAppStatus(appStatus = "${appStatus}");
		}

		if (isSet(appLicense)) {
			AccountAppEntry.viewSummaryLicense(appLicense = "${appLicense}");
		}

		if (isSet(appSupport)) {
			AccountAppEntry.viewSummarySupport(appSupport = "${appSupport}");
		}

		if (isSet(appTrial)) {
			AccountAppEntry.viewSummaryTrial(appTrial = "${appTrial}");
		}

		if (isSet(appTitle)) {
			AccountAppEntry.viewAppTitle(appTitle = "${appTitle}");
		}

		if (isSet(companyName)) {
			AccountAppEntry.viewCompanyName(companyName = "${companyName}");
		}

		if (isSet(appDescription)) {
			AccountAppEntry.viewDescription(appDescription = "${appDescription}");
		}

		if (isSet(latestChanges)) {
			AccountAppEntry.viewLatestChanges(latestChanges = "${latestChanges}");
		}

		if (isSet(tags)) {
			var tagNum = "1";

			for (var tag : list "${tags}") {
				AccountAppEntry.viewTags(
					tagNum = "${tagNum}",
					tags = "${tags}");

				var tagNum = ${tagNum} + 1;
			}
		}

		if (isSet(versionNumber)) {
			AccountAppEntry.viewVersion(versionNumber = "${versionNumber}");
		}

		if (isSet(developerWebsiteUrl)) {
			AccountAppEntry.viewDeveloperWebsiteURL(developerWebsiteUrl = "${developerWebsiteUrl}");
		}

		if (isSet(documentationUrl)) {
			AccountAppEntry.viewDocumentationURL(documentationUrl = "${documentationUrl}");
		}

		if (isSet(supportUrl)) {
			AccountAppEntry.viewSupportURL(supportUrl = "${supportUrl}");
		}

		if (isSet(sourceCodeUrl)) {
			AccountAppEntry.viewSourceCodeURL(sourceCodeUrl = "${sourceCodeUrl}");
		}

		if (isSet(liferayVersionRequirements)) {
			var requirementNum = "1";

			for (var liferayVersion : list "${liferayVersionRequirements}") {
				AccountAppEntry.viewCurrentRequirements(
					liferayVersion = "${liferayVersion}",
					requirementNum = "${requirementNum}");

				var requirementNum = ${requirementNum} + 1;
			}
		}

		if (isSet(standardLicenseUnitsList)) {
			var licenseNum = "1";

			for (var standardLicenseUnits : list "${standardLicenseUnitsList}") {
				AccountAppEntry.viewStandardLicensesUnitsViaAppPreview(
					licenseNum = "${licenseNum}",
					standardLicenseUnits = "${standardLicenseUnits}");

				var licenseNum = ${licenseNum} + 1;
			}
		}

		if (isSet(standardLicensePriceList)) {
			var licenseNum = "1";

			for (var standardLicensePrice : list "${standardLicensePriceList}") {
				AccountAppEntry.viewStandardLicensesPriceViaAppPreview(
					licenseNum = "${licenseNum}",
					standardLicensePrice = "${standardLicensePrice}");

				var licenseNum = ${licenseNum} + 1;
			}
		}

		if (isSet(standardSubscriptionPrice)) {
			AccountAppEntry.viewStandardSubscriptionViaAppPreview(standardSubscriptionPrice = "${standardSubscriptionPrice}");
		}

		if (isSet(developerLicenseUnitsList)) {
			var licenseNum = "1";

			for (var developerLicenseUnits : list "${developerLicenseUnitsList}") {
				AccountAppEntry.viewDeveloperLicensesUnitsViaAppPreview(
					developerLicenseUnits = "${developerLicenseUnits}",
					licenseNum = "${licenseNum}");

				var licenseNum = ${licenseNum} + 1;
			}
		}

		if (isSet(developerLicensePriceList)) {
			var licenseNum = "1";

			for (var developerLicensePrice : list "${developerLicensePriceList}") {
				AccountAppEntry.viewDeveloperLicensesPriceViaAppPreview(
					developerLicensePrice = "${developerLicensePrice}",
					licenseNum = "${licenseNum}");

				var licenseNum = ${licenseNum} + 1;
			}
		}

		if (isSet(developerSubscriptionPrice)) {
			AccountAppEntry.viewDeveloperSubscriptionViaAppPreview(developerSubscriptionPrice = "${developerSubscriptionPrice}");
		}

		if (isSet(noteToReviewerMessage)) {
			AccountAppEntry.typeNoteToReviewer(noteToReviewerMessage = "${noteToReviewerMessage}");
		}
	}

	macro reviewAppPricing {
		for (var tableTitle : list "${tableTitleList}") {
			if (isSet(tableTitle)) {
				AccountAppEntry.viewTableTitleViaAppPricing(tableTitle = "${tableTitle}");
			}

			if (isSet(standardLicensePriceList)) {
				for (var standardLicensePrice : list "${standardLicensePriceList}") {
					AccountAppEntry.viewStandardLicensePriceViaAppPricing(
						standardLicensePrice = "${standardLicensePrice}",
						tableTitle = "${tableTitle}");
				}
			}

			if (isSet(developerLicensePriceList)) {
				for (var developerLicensePrice : list "${developerLicensePriceList}") {
					AccountAppEntry.viewDeveloperLicensePriceViaAppPricing(
						developerLicensePrice = "${developerLicensePrice}",
						tableTitle = "${tableTitle}");
				}
			}

			if (isSet(standardLicenseUnitsList)) {
				for (var standardLicenseUnit : list "${standardLicenseUnitsList}") {
					AccountAppEntry.viewStandardLicenseUnitViaAppPricing(
						standardLicenseUnit = "${standardLicenseUnit}",
						tableTitle = "${tableTitle}");
				}
			}

			if (isSet(developerLicenseUnitsList)) {
				for (var developerLicenseUnit : list "${developerLicenseUnitsList}") {
					AccountAppEntry.viewDeveloperLicenseunitViaAppPricing(
						developerLicenseUnit = "${developerLicenseUnit}",
						tableTitle = "${tableTitle}");
				}
			}

			if (isSet(standardSubscriptionPrice)) {
				AccountAppEntry.viewStandardSubscriptionPriceViaAppPricing(
					standardSubscriptionPrice = "${standardSubscriptionPrice}",
					tableTitle = "${tableTitle}");
			}

			if (isSet(developerSubscriptionPrice)) {
				AccountAppEntry.viewDeveloperSubscriptionPriceViaAppPricing(
					developerSubscriptionPrice = "${developerSubscriptionPrice}",
					tableTitle = "${tableTitle}");
			}

			if (isSet(countryList)) {
				for (var country : list "${countryList}") {
					AccountAppEntry.viewCountryViaAppPricing(
						country = "${country}",
						tableTitle = "${tableTitle}");
				}
			}
		}
	}

	macro reviewAppUploadedFiles {
		for (var appPackage : list "${appPackageList}") {
			var appFileList = StringUtil.extractLast("${appPackage}", "~");
			var portalVersionName = StringUtil.extractFirst("${appPackage}", "~");
			var appFileList = StringUtil.replace("${appFileList}", "+", ",");

			for (var fileName : list "${appFileList}") {
				AssertTextEquals(
					key_portalVersionName = "${portalVersionName}",
					locator1 = "MPDeveloperApps#SUMMARY_UPLOADED_FILES",
					value1 = "${fileName}");
			}
		}
	}

	macro reviewDeveloperDownloads {
		for (var appPackage : list "${appPackageList}") {
			var appFileList = StringUtil.extractLast("${appPackage}", "~");
			var portalVersionName = StringUtil.extractFirst("${appPackage}", "~");

			AssertTextEquals.assertPartialText(
				key_portalVersionName = "${portalVersionName}",
				key_versionNumber = "${versionNumber}",
				locator1 = "MPDeveloperApps#DOWNLOAD_PACKAGE_VERSION_LINK",
				value1 = "${portalVersionName}");
		}
	}

}