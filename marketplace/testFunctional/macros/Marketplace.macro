definition {

	macro purchaseFreeApp {
		MPButton.button2(buttonName = "Free");

		MarketplacePurchaseApp.purchaseAccountTabFreeOrTrial(
			legalEntityName = "${legalEntityName}",
			projectName = "${projectName}");
	}

	macro purchasePaidApp {
		MPButton.button2(buttonName = "Buy");

		MarketplacePurchaseApp.purchaseAccountTabPaid(
			legalEntityName = "${legalEntityName}",
			projectName = "${projectName}");

		if ("${licensePurchaseType}" == "add") {
			MarketplacePurchaseApp.purchaseExtendedLicense(
				developerLicenseQuantityList = "${developerLicenseQuantityList}",
				standardLicenseQuantityList = "${standardLicenseQuantityList}");
		}
		else if ("${licensePurchaseType}" == "renew") {
			MarketplacePurchaseApp.purchaseRenewLicense(
				changeRenewLicenseQuantities = "${changeRenewLicenseQuantities}",
				developerLicenseQuantityList = "${developerLicenseQuantityList}",
				renewSubscriptionTypeList = "${renewSubscriptionTypeList}",
				standardLicenseQuantityList = "${standardLicenseQuantityList}");
		}
		else {
			MarketplacePurchaseApp.purchaseLicense(
				developerLicenseQuantityList = "${developerLicenseQuantityList}",
				standardLicenseQuantityList = "${standardLicenseQuantityList}");
		}

		MarketplacePurchaseApp.purchaseDestinationTab(destinationAddressName = "${destinationAddressName}");

		MarketplacePurchaseApp.purchaseSummaryTab(
			developerSummaryQuantityList = "${developerSummaryQuantityList}",
			invoiceEmailAddress = "${invoiceEmailAddress}",
			paymentMethod = "${paymentMethod}",
			standardSummaryQuantityList = "${standardSummaryQuantityList}");

		var purchaseID = selenium.getText("MPPurchaseSummary#YOUR_TRANSACTION_ID_NUMBER");

		var purchaseID = StringUtil.replace("${purchaseID}", "Your transaction ID number is ", "");

		var purchaseID = StringUtil.replace("${purchaseID}", ".", "");

		MarketplaceAdmin.completeInvoicePayment(purchaseID = "${purchaseID}");
	}

	macro purchaseTrialApp {
		MPButton.button2(buttonName = "30-Day Trial");

		MarketplacePurchaseApp.purchaseAccountTabFreeOrTrial(
			legalEntityName = "${legalEntityName}",
			projectName = "${projectName}");
	}

	macro tearDownPurchase {
		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Customers");

		Type(
			locator1 = "MPAdminCustomers#KEYWORDS_FIELD",
			value1 = "${appTitle}");

		MPButton.search();

		while (IsElementPresent(locator1 = "MPAdminCustomers#DELETE")) {
			var key_appTitle = "${appTitle}";

			Click(locator1 = "MPAdminCustomers#APP_ENTRY_NAME");

			ClickNoError(locator1 = "MPAdminCustomers#DELETE_BUTTON");

			Confirm(value1 = "Are you sure you want to delete this order?");

			MPMessage.success();
		}
	}

}