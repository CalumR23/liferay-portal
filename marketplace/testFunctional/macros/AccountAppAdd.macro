definition {

	macro addDetails {
		if (contains("${isFreePaid}", "paid") && (IsElementPresent(locator1 = "MPDeveloperAppsAddDetails#UPGRADE"))) {
			MarketplaceRegistration.convertToPaidDeveloperAccount(
				companyName = "${companyName}",
				userEmailAddress = PropsUtil.get("marketplace.email.address.3"));
		}

		AccountAppAddEntry.checkPricing(isFreePaid = "${isFreePaid}");

		AccountAppAddEntry.typeTitle(appTitle = "${appTitle}");

		AccountAppAddEntry.typeDescription(appDescription = "${appDescription}");

		AccountAppAddEntry.uploadAppIcon(appIconFile = "${appIconFile}");

		AccountAppAddEntry.selectCategory(appCategory = "${appCategory}");

		AccountAppAddEntry.typeDeveloperURL(developerWebsiteUrl = "${developerWebsiteUrl}");

		AccountAppAddEntry.typeSupportURL(supportUrl = "${supportUrl}");

		MPButton.next();

		MPMessage.success();
	}

	macro addLicense {
		AccountAppAddEntry.checkLicenseTerm(licenseTerm = "${licenseTerm}");

		if ("${isSubscription}" == "true") {
			AccountAppAddEntry.checkSubscriptionServices();
		}
		else {
			AccountAppAddEntry.uncheckSubscriptionServices();
		}

		AccountAppAddEntry.typeStandardLicenseQuantity(standardLicenseUnitsList = "${standardLicenseUnitsList}");

		AccountAppAddEntry.typeDeveloperLicenseQuantity(developerLicenseUnitsList = "${developerLicenseUnitsList}");

		if ("${isTrial}" == "true") {
			AccountAppAddEntry.checkTrialLicense();
		}
		else {
			AccountAppAddEntry.uncheckTrialLicense();
		}

		MPButton.next();

		MPMessage.success();
	}

	macro addPricing {
		AccountAppAddEntry.selectCurrency(
			currency = "${currency}",
			tableNum = "1");

		AccountAppAddEntry.typeStandardLicensePrice(
			standardLicensePriceList = "${standardLicensePriceList}",
			tableNum = "1");

		AccountAppAddEntry.typeDeveloperLicensePrice(
			developerLicensePriceList = "${developerLicensePriceList}",
			tableNum = "1");

		AccountAppAddEntry.moveAllCountriesFromPoolToTable(tableNum = "1");

		MPButton.next();

		MPMessage.success();
	}

	macro addPricingWithSubscription {
		AccountAppAddEntry.typeTableTitle(
			tableNum = "1",
			tableTitle = "${tableTitle}");

		AccountAppAddEntry.selectCurrency(
			currency = "${currency}",
			tableNum = "1");

		AccountAppAddEntry.typeStandardLicensePrice(
			standardLicensePriceList = "${standardLicensePriceList}",
			tableNum = "1");

		AccountAppAddEntry.typeDeveloperLicensePrice(
			developerLicensePriceList = "${developerLicensePriceList}",
			tableNum = "1");

		AccountAppAddEntry.typeStandardSubscriptionPrice(
			standardSubscriptionPriceList = "${standardSubscriptionPriceList}",
			tableNum = "1");

		AccountAppAddEntry.typeDeveloperSubscriptionPrice(
			developerSubscriptionPriceList = "${developerSubscriptionPriceList}",
			tableNum = "1");

		AccountAppAddEntry.moveAllCountriesFromPoolToTable(tableNum = "1");

		MPButton.next();

		MPMessage.success();
	}

	macro addUpload {
		AccountAppAddEntry.typeVersionNumber(versionNumber = "${versionNumber}");

		for (var appPackage : list "${appPackageList}") {
			var appFileList = StringUtil.extractLast("${appPackage}", "~");
			var portalVersionName = StringUtil.extractFirst("${appPackage}", "~");
			var appFileList = StringUtil.replace("${appFileList}", "+", ",");

			AccountAppAddEntry.uploadAppFiles(
				appFileList = "${appFileList}",
				portalVersionName = "${portalVersionName}");
		}

		MPButton.next();

		MPMessage.success();
	}

	macro addUploadWithWhatsNewDescription {
		AccountAppAddEntry.typeVersionNumber(versionNumber = "${versionNumber}");

		Type(
			locator1 = "MPDeveloperAppsAddUpload#WHATS_NEW_FIELD",
			value1 = "${whatsNewDescription}");

		for (var appPackage : list "${appPackageList}") {
			var appFileList = StringUtil.extractLast("${appPackage}", "~");
			var portalVersionName = StringUtil.extractFirst("${appPackage}", "~");
			var appFileList = StringUtil.replace("${appFileList}", "+", ",");

			AccountAppAddEntry.uploadAppFiles(
				appFileList = "${appFileList}",
				portalVersionName = "${portalVersionName}");
		}

		MPButton.next();

		MPMessage.success();
	}

	macro clickSubmit {
		MPButton.submit();

		MPMessage.success();
	}

	macro editLicense {
		while (IsElementPresent(locator1 = "MPDeveloperAppsAddLicense#STANDARD_DELETE")) {
			Click(locator1 = "MPDeveloperAppsAddLicense#STANDARD_DELETE");
		}

		AccountAppAddEntry.typeStandardLicenseQuantity(standardLicenseUnitsList = "${standardLicenseUnitsList}");

		while (IsElementPresent(locator1 = "MPDeveloperAppsAddLicense#DEVELOPER_DELETE")) {
			Click(locator1 = "MPDeveloperAppsAddLicense#DEVELOPER_DELETE");
		}

		AccountAppAddEntry.typeDeveloperLicenseQuantity(developerLicenseUnitsList = "${developerLicenseUnitsList}");

		MPButton.next();

		MPMessage.success();
	}

}