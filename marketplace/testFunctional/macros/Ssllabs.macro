<definition>
	<command name="openSsllabs">
		<execute function="Open" locator1="https://www.ssllabs.com/ssltest/analyze.html?d=${serverDomain}" />

		<if>
			<condition function="IsElementPresent" locator1="Ssllabs#CLEAR_CACHE_LINK" />
			<then>
				<execute function="AssertClick" locator1="Ssllabs#CLEAR_CACHE_LINK" value1="Clear cache" />
			</then>
		</if>

		<execute function="AssertElementPresent" locator1="Ssllabs#TABLE" />
	</command>

	<command name="viewGradePG">
		<var name="key_serverIpAddress" value="${serverIpAddress}" />

		<execute function="AssertTextEquals" locator1="Ssllabs#TABLE_SERVER_IP_ADDRESS" value1="${serverIpAddress}" />

		<execute function="Pause" locator1="90000" />

		<execute function="AssertTextEquals" locator1="Ssllabs#TABLE_SERVER_GRADE" value1="${serverGrade}" />
	</command>
</definition>