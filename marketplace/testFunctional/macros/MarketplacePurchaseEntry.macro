definition {

	macro checkEula {
		Check(locator1 = "MPPurchaseSummary#EULA_CHECKBOX");
	}

	macro checkPaymentMethod {
		var key_paymentMethod = "${paymentMethod}";

		Check(locator1 = "MPPurchaseSummary#PAYMENT_METHOD_CHECKBOX");
	}

	macro checkPurchaseType {
		var key_licensePurchaseType = "${licensePurchaseType}";

		Check(locator1 = "MPPurchaseLicense#PURCHASE_TYPE_RADIO");
	}

	macro checkSubscriptionServicesType {
		var key_subscriptionType = "subscriptionType";

		Check(locator1 = "MPPurchaseLicense#SUBSCRIPTION_SERVICES_TYPE_CHECKBOX");
	}

	macro clickChangeRenewInstanceQuantities {
		Click(locator1 = "MPPurchaseLicense#CHANGE_RENEW_INSTANCES_QUANTITY");
	}

	macro clickDestinationAddressCard {
		var key_destinationAddressName = "${destinationAddressName}";

		Click(locator1 = "MPPurchaseDestination#DESTINATION_ADDRESS_CARD");
	}

	macro clickProjectCard {
		var key_projectName = "${projectName}";

		Click(locator1 = "MPPurchaseAccount#PROJECT_CARD");
	}

	macro clickProjectPersonalUse {
		Click(locator1 = "MPApps#PROJECT_PERSONAL_USE");
	}

	macro clickSummaryUpdate {
		Click(locator1 = "MPPurchaseSummary#UPDATE_CART_BUTTON");
	}

	macro confirmCurrentPurchaseProcess {
		AssertTextEquals(
			locator1 = "MPPurchase#PURCHASE_PROCESS_BREADCRUMB_CURRENT",
			value1 = "${currentPurchaseProcess}");
	}

	macro selectDestinationregion {
		Select(
			locator1 = "MPPurchaseDestination#DESTINATION_REGION",
			value1 = "California");
	}

	macro typeDestinationCity {
		Type(
			locator1 = "MPPurchaseDestination#DESTINATION_CITY",
			value1 = "Diamond Bar");
	}

	macro typeDestinationCompanyName {
		Type(
			locator1 = "MPPurchaseDestination#DESTINATION_COMPANY_NAME",
			value1 = "${destinationAddressName}");
	}

	macro typeDestinationStreet1 {
		Type(
			locator1 = "MPPurchaseDestination#DESTINATION_STREET_1",
			value1 = "123 Main Street");
	}

	macro typeDestinationZip {
		Type(
			locator1 = "MPPurchaseDestination#DESTINATION_ZIP",
			value1 = "91765");
	}

	macro typeDeveloperLicenseQuantity {
		var key_units = "${quantity}";

		Type(
			locator1 = "MPPurchaseLicense#DEVELOPER_LICENSE_INSTANCE_QUANTITY",
			value1 = "${quantity}");
	}

	macro typeDeveloperSummaryQuantity {
		var key_units = "${units}";

		Type(
			locator1 = "MPPurchaseSummary#DEVELOPER_INSTANCE_UNITS",
			value1 = "${quantity}");
	}

	macro typeInvoiceEmailAddress {
		Type(
			locator1 = "MPPurchaseSummary#INVOICE_EMAIL_ADDRESS_FIELD",
			value1 = "${invoiceEmailAddress}");
	}

	macro typeLegalEntityName {
		Type(
			locator1 = "MPPurchaseAccount#LEGAL_ENTITY_NAME_FIELD",
			value1 = "${legalEntityName}");
	}

	macro typeNewProjectName {
		Type(
			locator1 = "MPPurchaseAccount#NEW_PROJECT__NAME_FIELD",
			value1 = "${projectName}");
	}

	macro typeStandardLicenseQuantity {
		var key_units = "${quantity}";

		Type(
			locator1 = "MPPurchaseLicense#STANDARD_LICENSE_INSTANCE_QUANTITY",
			value1 = "${quantity}");
	}

	macro typeStandardSummaryQuantity {
		var key_units = "${units}";

		Type(
			locator1 = "MPPurchaseSummary#STANDARD_INSTANCE_UNITS",
			value1 = "${quantity}");
	}

	macro uncheckSubscriptionServicesType {
		var key_subscriptionType = "subscriptionType";

		Uncheck(locator1 = "MPPurchaseLicense#SUBSCRIPTION_SERVICES_TYPE_CHECKBOX");
	}

	macro updateDeveloperSummaryQuantity {
		for (var quantity : list "${developerSummaryQuantityList}") {
			MarketplacePurchaseEntry.typeDeveloperSummaryQuantity(
				quantity = MathUtil.sum("${quantity}", "1"),
				units = "${quantity}");

			MarketplacePurchaseEntry.clickSummaryUpdate();
		}
	}

	macro updateStandardSummaryQuantity {
		for (var quantity : list "${standardSummaryQuantityList}") {
			MarketplacePurchaseEntry.typeStandardSummaryQuantity(
				quantity = MathUtil.sum("${quantity}", "1"),
				units = "${quantity}");

			MarketplacePurchaseEntry.clickSummaryUpdate();
		}
	}

	macro viewDestinationCountry {
		AssertTextPresent(
			locator1 = "MPPurchaseDestination#DESTINATION_COUNTRY",
			value1 = "United States");
	}

}