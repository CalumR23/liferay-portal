<definition>
	<command name="confirmMembershipRequest">
		<execute function="Click" locator1="AccountSidebar#USER_MANAGER" />

		<var name="key_userEmailAddress" value="${userEmailAddress}" />

		<execute function="AssertTextEquals" locator1="CorpMembersProjects#MEMBERSHIP_REQUEST_EMAIL_ADDRESS" value1="${userEmailAddress}" />

		<execute function="Click" locator1="CorpMembersProjects#MEMBERSHIP_REQUEST_USER_CONFIRM_BUTTON" />

		<execute macro="MPMessage#success" />

		<execute function="AssertElementPresent" locator1="CorpMembersProjects#MEMBERSHIP_REQUEST_USER_RESEND_EMAIL_BUTTON" />
	</command>

	<command name="convertToPaidDeveloperAccount">
		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#registerPaidDeveloperForm">
			<var name="developerAddress" value="123 A St" />
			<var name="developerCity" value="Los Angeles" />
			<var name="developerCountry" value="United States" />
			<var name="developerFirstName" value="LiferayQA1" />
			<var name="developerLastName" value="Marketplace" />
			<var name="developerMiddleName" value="Test" />
			<var name="developerPostalCode" value="90210" />
			<var name="developerRegion" value="California" />
			<var name="developerTaxDocument" value="Document_1.pdf" />
			<var name="developerTaxType" value="Other" />
		</execute>

		<if>
			<isset var="${companyName}" />
			<then>
				<execute macro="MarketplaceRegistrationEntry#typeCompanyName">
					<var name="companyName" value="${companyName}" />
				</execute>
			</then>
		</if>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute macro="MarketplaceRegistrationEntry#paypalAccountForm">
			<var name="paypalEmailAddress" value="${userEmailAddress}" />
			<var name="paypalFirstName" value="Joe" />
			<var name="paypalLastName" value="Bloggs" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute macro="MPButton#next" />

		<execute macro="AccountAppAddEntry#confirmCurrentAppAddProcess">
			<var name="currentAppAddProcess" value="App Details" />
		</execute>
	</command>

	<command name="convertToPaidDeveloperEnterAccountInfo">
		<execute function="UploadCommonFile" locator1="MPButton#UPLOAD_TAX_BUTTON" value1="Document_1.pdf" />

		<execute macro="MarketplaceRegistrationEntry#selectTaxDocumentType">
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeFirstName">
			<var name="firstName" value="Test" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeMiddleName">
			<var name="middleName" value="QA" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeLastName">
			<var name="lastName" value="Marketplace" />
		</execute>

		<if>
			<isset var="${companyName}" />
			<then>
				<execute macro="MarketplaceRegistrationEntry#typeCompanyName">
					<var name="companyName" value="${companyName}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplaceRegistrationEntry#typeAddressLine1">
			<var name="companyAddress" value="123 A St" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#selectCountry">
			<var name="companyCountry" value="United States" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#selectRegion">
			<var name="companyRegion" value="California" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeCity">
			<var name="companyCity" value="Los Angeles" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typePostalCode">
			<var name="companyPostalCode" value="90210" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />
	</command>

	<command name="editCompany">
		<var name="key_companyName" value="${companyName}" />

		<execute function="AssertClick" locator1="MPRegistration#PENDING_REGISTRATIONS_COMPANY_LINK" value1="${companyName}" />

		<execute macro="MarketplaceRegistrationEntry#typeCompanyDescription">
			<var name="companyDescription" value="${companyDescription}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeCompanyEmail">
			<var name="companyEmail" value="${companyEmail}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeAddressLine1">
			<var name="companyAddress" value="${companyAddress}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#selectCountry">
			<var name="companyCountry" value="${companyCountry}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#selectRegion">
			<var name="companyRegion" value="${companyRegion}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typeCity">
			<var name="companyCity" value="${companyCity}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typePostalCode">
			<var name="companyPostalCode" value="${companyPostalCode}" />
		</execute>

		<execute macro="MarketplaceRegistrationEntry#typePhone">
			<var name="companyPhone" value="${companyPhone}" />
		</execute>

		<execute function="ScrollWebElementIntoView" locator1="MPRegistrationCompany#SUBMIT_REQUEST"  />
		<execute function="Click" locator1="MPRegistrationCompany#SUBMIT_REQUEST" />

		<execute macro="MPMessage#success" />
	</command>

	<command name="ignoreMembershipRequest">
		<if>
			<condition function="IsElementPresent" locator1="AccountSidebar#USER_MANAGER" />
			<then>
				<var name="key_userEmailAddress" value="${userEmailAddress}" />

				<execute function="Click" locator1="AccountSidebar#USER_MANAGER" />

				<if>
					<condition function="IsElementPresent" locator1="CorpMembersProjects#MEMBERSHIP_REQUEST_EMAIL_ADDRESS" />
					<then>
						<execute function="Click" locator1="CorpMembersProjects#MEMBERSHIP_REQUEST_USER_IGNORE_BUTTON" />
						<execute macro="MPMessage#success" />
					</then>
				</if>
			</then>
		</if>
	</command>

	<command name="registerNewCompany">
		<execute function="ScrollWebElementIntoView" locator1="MPRegistrationCompany#REGISTER_BUTTON"  />
		<execute function="Click" locator1="MPRegistrationCompany#REGISTER_BUTTON" />

		<execute macro="MarketplaceRegistrationEntry#registerCompanyForm">
			<var name="companyAddress" value="${companyAddress}" />
			<var name="companyCity" value="${companyCity}" />
			<var name="companyCountry" value="${companyCountry}" />
			<var name="companyDescription" value="${companyDescription}" />
			<var name="companyEmail" value="${companyEmail}" />
			<var name="companyIcon" value="${companyIcon}" />
			<var name="companyName" value="${companyName}" />
			<var name="companyPhone" value="${companyPhone}" />
			<var name="companyPostalCode" value="${companyPostalCode}" />
			<var name="companyRegion" value="${companyRegion}" />
			<var name="companyTaxDocument" value="${companyTaxDocument}" />
			<var name="companyTaxType" value="${companyTaxType}" />
		</execute>

		<execute function="ScrollWebElementIntoView" locator1="MPRegistrationCompany#SUBMIT_REQUEST"  />
		<execute function="Click" locator1="MPRegistrationCompany#SUBMIT_REQUEST" />

		<execute macro="MPMessage#success" />
	</command>

	<command name="registerNewDeveloper">
		<execute function="Click" locator1="MPRegistration#CREATE_INDIVIDUAL_ACCOUNT_BUTTON" />

		<if>
			<condition function="IsElementPresent" locator1="MPRegistrationDeveloper#TERMS_OF_AGREEMENT" />
			<then>
				<execute macro="MarketplaceRegistrationEntry#registerIndividualDeveloperForm">
					<var name="developerCountry" value="${developerCountry}" />
					<var name="developerPhone" value="${developerPhone}" />
				</execute>

				<execute macro="MPButton#submit" />

				<execute macro="MPMessage#success" />
			</then>
			<else>
				<execute function="AssertTextEquals" locator1="MPRegistrationDeveloper#ALREADY_REGISTERED_DEV_TEXT" value1="This account is already registered to be a developer. Please go to your profile page to update your developer information." />
			</else>
		</if>
	</command>

	<command name="requestJoinCompany">
		<var name="key_companyName" value="${companyName}" />

		<execute function="Click" locator1="MPRegistrationCompany#JOIN_COMPANY_BUTTON" />

		<execute function="AssertElementPresent" locator1="MPRegistrationCompany#REQUEST_MEMBERSHIP_ALERT" />
		<execute function="AssertTextEquals#assertPartialText" locator1="MPRegistrationCompany#REQUEST_MEMBERSHIP_DISCLAIMER" value1="I accept that the administrators of ${companyName} will be able to view my email address to approve my membership request." />

		<execute function="Click" locator1="MPRegistrationCompany#SEND_REQUEST_BUTTON" />

		<execute function="AssertTextEquals" locator1="MPMessage#SUCCESS_MESSAGE" value1="Your request was sent." />
	</command>

	<command name="searchForCompany">
		<var name="key_companyNane" value="${companyName}" />

		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_NAME_SEARCH_FIELD" value1="${companyName}" />

		<execute macro="MPButton#search" />
	</command>

	<command name="setupCompany">
		<var name="key_companyName" value="${companyName}" />

		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />

		<if>
			<condition function="IsElementNotPresent" locator1="MPNavigation#COMPANY_SITE" />
			<then>
				<execute macro="MarketplaceNavigationBar#gotoBecomeDeveloper" />

				<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

				<execute macro="MarketplaceRegistration#registerNewCompany">
					<var name="companyAddress" value="${companyAddress}" />
					<var name="companyCity" value="${companyCity}" />
					<var name="companyCountry" value="${companyCountry}" />
					<var name="companyDescription" value="${companyDescription}" />
					<var method="TestPropsUtil#get('marketplace.email.address.1')" name="companyEmail" />
					<var name="companyIcon" value="${companyIcon}" />
					<var name="companyName" value="${companyName}" />
					<var name="companyPhone" value="${companyPhone}" />
					<var name="companyPostalCode" value="${companyPostalCode}" />
					<var name="companyRegion" value="${companyRegion}" />
					<var name="companyTaxDocument" value="${companyTaxDocument}" />
					<var name="companyTaxType" value="${companyTaxType}" />
				</execute>

				<execute macro="MPUser#logoutAndLogin">
					<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
					<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
				</execute>

				<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

				<execute macro="MarketplaceAdmin#workflowCompanyApprove">
					<var name="companyName" value="${companyName}" />
				</execute>

				<execute macro="MPMessage#success" />
			</then>
		</if>
	</command>

	<command name="tearDownJoinCompany">
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute function="Click" locator1="MPNavigation#NAVIGATION_MENU" />

		<var name="key_companyName" value="${companyName}" />
		<if>
			<condition function="IsElementPresent" locator1="MPNavigation#COMPANY_SITE" />
			<then>
				<execute function="Click" locator1="MPNavigation#COMPANY_SITE" />

				<execute macro="MarketplaceRegistration#ignoreMembershipRequest">
					<var name="userEmailAddress" value="${userEmailAddress}" />
				</execute>
			</then>
		</if>
	</command>

	<command name="tearDownRegistrationCompany">
		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#denySubmission" />

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyName}" />
		</execute>

		<execute macro="MarketplaceAdmin#disableCompany" />
	</command>

	<command name="viewCompanyProfile">
		<var name="key_companyName" value="${companyName}" />

		<execute function="AssertClick" locator1="MPRegistration#PENDING_REGISTRATIONS_COMPANY_LINK" value1="${companyName}" />

		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#COMPANY_NAME_FIELD" value1="${companyName}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD" value1="${companyDescription}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD" value1="${companyEmail}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1" value1="${companyAddress}" />
		<execute function="AssertSelectedLabel" locator1="MPRegistrationCompany#COUNTRY_SELECT" value1="${companyCountry}" />
		<execute function="AssertSelectedLabel" locator1="MPRegistrationCompany#REGION_SELECT" value1="${companyRegion}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#CITY_FIELD" value1="${companyCity}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#POSTAL_CODE_FIELD" value1="${companyPostalCode}" />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#PHONE_FIELD" value1="${companyPhone}" />
	</command>
</definition>