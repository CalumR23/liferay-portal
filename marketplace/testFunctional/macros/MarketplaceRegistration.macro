definition {

	macro confirmMembershipRequest {
		Click(locator1 = "AccountSidebar#USER_MANAGER");

		var key_userEmailAddress = "${userEmailAddress}";

		AssertTextEquals(
			locator1 = "CorpMembersProjects#MEMBERSHIP_REQUEST_EMAIL_ADDRESS",
			value1 = "${userEmailAddress}");

		Click(locator1 = "CorpMembersProjects#MEMBERSHIP_REQUEST_USER_CONFIRM_BUTTON");

		MPMessage.success();

		AssertElementPresent(locator1 = "CorpMembersProjects#MEMBERSHIP_REQUEST_USER_RESEND_EMAIL_BUTTON");
	}

	macro convertToPaidDeveloperAccount {
		Click(locator1 = "MPDeveloperAppsAddDetails#UPGRADE");

		MPButton.button1(buttonName = "Enroll Now");

		MarketplaceRegistrationEntry.registerPaidDeveloperForm(
			developerAddress = "123 A St",
			developerCity = "Los Angeles",
			developerCountry = "United States",
			developerFirstName = "LiferayQA1",
			developerLastName = "Marketplace",
			developerMiddleName = "Test",
			developerPostalCode = "90210",
			developerRegion = "California",
			developerTaxDocument = "Document_1.pdf",
			developerTaxType = "Other");

		if (isSet(companyName)) {
			MarketplaceRegistrationEntry.typeCompanyName(companyName = "${companyName}");
		}

		MPButton.next();

		MPMessage.success();

		MarketplaceRegistrationEntry.paypalAccountForm(
			paypalEmailAddress = "${userEmailAddress}",
			paypalFirstName = "Joe",
			paypalLastName = "Bloggs");

		MPButton.next();

		MPMessage.success();

		MPButton.next();

		AccountAppAddEntry.confirmCurrentAppAddProcess(currentAppAddProcess = "App Details");
	}

	macro convertToPaidDeveloperEnterAccountInfo {
		UploadCommonFile(
			locator1 = "MPButton#UPLOAD_TAX_BUTTON",
			value1 = "Document_1.pdf");

		MarketplaceRegistrationEntry.selectTaxDocumentType(companyTaxType = "Other");

		MarketplaceRegistrationEntry.typeFirstName(firstName = "Test");

		MarketplaceRegistrationEntry.typeMiddleName(middleName = "QA");

		MarketplaceRegistrationEntry.typeLastName(lastName = "Marketplace");

		if (isSet(companyName)) {
			MarketplaceRegistrationEntry.typeCompanyName(companyName = "${companyName}");
		}

		MarketplaceRegistrationEntry.typeAddressLine1(companyAddress = "123 A St");

		MarketplaceRegistrationEntry.selectCountry(companyCountry = "United States");

		MarketplaceRegistrationEntry.selectRegion(companyRegion = "California");

		MarketplaceRegistrationEntry.typeCity(companyCity = "Los Angeles");

		MarketplaceRegistrationEntry.typePostalCode(companyPostalCode = "90210");

		MPButton.next();

		MPMessage.success();
	}

	macro editCompany {
		var key_companyName = "${companyName}";

		AssertClick(
			locator1 = "MPRegistration#PENDING_REGISTRATIONS_COMPANY_LINK",
			value1 = "${companyName}");

		MarketplaceRegistrationEntry.typeCompanyDescription(companyDescription = "${companyDescription}");

		MarketplaceRegistrationEntry.typeCompanyEmail(companyEmail = "${companyEmail}");

		MarketplaceRegistrationEntry.typeAddressLine1(companyAddress = "${companyAddress}");

		MarketplaceRegistrationEntry.selectCountry(companyCountry = "${companyCountry}");

		MarketplaceRegistrationEntry.selectRegion(companyRegion = "${companyRegion}");

		MarketplaceRegistrationEntry.typeCity(companyCity = "${companyCity}");

		MarketplaceRegistrationEntry.typePostalCode(companyPostalCode = "${companyPostalCode}");

		MarketplaceRegistrationEntry.typePhone(companyPhone = "${companyPhone}");

		ScrollWebElementIntoView(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		Click(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		MPMessage.success();
	}

	macro ignoreMembershipRequest {
		if (IsElementPresent(locator1 = "AccountSidebar#USER_MANAGER")) {
			var key_userEmailAddress = "${userEmailAddress}";

			Click(locator1 = "AccountSidebar#USER_MANAGER");

			if (IsElementPresent(locator1 = "CorpMembersProjects#MEMBERSHIP_REQUEST_EMAIL_ADDRESS")) {
				Click(locator1 = "CorpMembersProjects#MEMBERSHIP_REQUEST_USER_IGNORE_BUTTON");

				MPMessage.success();
			}
		}
	}

	macro registerNewCompany {
		ScrollWebElementIntoView(locator1 = "MPRegistrationCompany#REGISTER_BUTTON");

		Click(locator1 = "MPRegistrationCompany#REGISTER_BUTTON");

		MarketplaceRegistrationEntry.registerCompanyForm(
			companyAddress = "${companyAddress}",
			companyCity = "${companyCity}",
			companyCountry = "${companyCountry}",
			companyDescription = "${companyDescription}",
			companyEmail = "${companyEmail}",
			companyIcon = "${companyIcon}",
			companyName = "${companyName}",
			companyPhone = "${companyPhone}",
			companyPostalCode = "${companyPostalCode}",
			companyRegion = "${companyRegion}",
			companyTaxDocument = "${companyTaxDocument}",
			companyTaxType = "${companyTaxType}");

		ScrollWebElementIntoView(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		Click(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		MPMessage.success();
	}

	macro registerNewDeveloper {
		Click(locator1 = "MPRegistration#CREATE_INDIVIDUAL_ACCOUNT_BUTTON");

		if (IsElementPresent(locator1 = "MPRegistrationDeveloper#TERMS_OF_AGREEMENT")) {
			MarketplaceRegistrationEntry.registerIndividualDeveloperForm(
				developerCountry = "${developerCountry}",
				developerPhone = "${developerPhone}");

			MPButton.submit();

			MPMessage.success();
		}
		else {
			AssertTextEquals(
				locator1 = "MPRegistrationDeveloper#ALREADY_REGISTERED_DEV_TEXT",
				value1 = "This account is already registered to be a developer. Please go to your profile page to update your developer information.");
		}
	}

	macro requestJoinCompany {
		var key_companyName = "${companyName}";

		Click(locator1 = "MPRegistrationCompany#JOIN_COMPANY_BUTTON");

		AssertElementPresent(locator1 = "MPRegistrationCompany#REQUEST_MEMBERSHIP_ALERT");

		AssertTextEquals.assertPartialText(
			locator1 = "MPRegistrationCompany#REQUEST_MEMBERSHIP_DISCLAIMER",
			value1 = "I accept that the administrators of ${companyName} will be able to view my email address to approve my membership request.");

		Click(locator1 = "MPRegistrationCompany#SEND_REQUEST_BUTTON");

		AssertTextEquals(
			locator1 = "MPMessage#SUCCESS_MESSAGE",
			value1 = "Your request was sent.");
	}

	macro searchForCompany {
		var key_companyNane = "${companyName}";

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		Type(
			locator1 = "MPRegistrationCompany#COMPANY_NAME_SEARCH_FIELD",
			value1 = "${companyName}");

		MPButton.search();
	}

	macro setupCompany {
		var key_companyName = "${companyName}";

		Click(locator1 = "MPNavigation#NAVIGATION_MENU");

		if (IsElementNotPresent(locator1 = "MPNavigation#COMPANY_SITE")) {
			MarketplaceNavigationBar.gotoBecomeDeveloper();

			Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

			MarketplaceRegistration.registerNewCompany(
				companyAddress = "${companyAddress}",
				companyCity = "${companyCity}",
				companyCountry = "${companyCountry}",
				companyDescription = "${companyDescription}",
				companyEmail = PropsUtil.get("marketplace.email.address.1"),
				companyIcon = "${companyIcon}",
				companyName = "${companyName}",
				companyPhone = "${companyPhone}",
				companyPostalCode = "${companyPostalCode}",
				companyRegion = "${companyRegion}",
				companyTaxDocument = "${companyTaxDocument}",
				companyTaxType = "${companyTaxType}");

			MPUser.logoutAndLogin(
				userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
				userPassword = PropsUtil.get("marketplace.email.password.5"));

			MarketplaceAdminNavigator.gotoMPAdmin();

			MarketplaceAdmin.workflowCompanyApprove(companyName = "${companyName}");

			MPMessage.success();
		}
	}

	macro tearDownJoinCompany {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		Open(locator1 = "${marketplaceURL}");

		Click(locator1 = "MPNavigation#NAVIGATION_MENU");

		var key_companyName = "${companyName}";

		if (IsElementPresent(locator1 = "MPNavigation#COMPANY_SITE")) {
			Click(locator1 = "MPNavigation#COMPANY_SITE");

			MarketplaceRegistration.ignoreMembershipRequest(userEmailAddress = "${userEmailAddress}");
		}
	}

	macro tearDownRegistrationCompany {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyName}");

		MarketplaceAdmin.denySubmission();

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyName}");

		MarketplaceAdmin.disableCompany();
	}

	macro viewCompanyProfile {
		var key_companyName = "${companyName}";

		AssertClick(
			locator1 = "MPRegistration#PENDING_REGISTRATIONS_COMPANY_LINK",
			value1 = "${companyName}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#COMPANY_NAME_FIELD",
			value1 = "${companyName}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD",
			value1 = "${companyDescription}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD",
			value1 = "${companyEmail}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1",
			value1 = "${companyAddress}");

		AssertSelectedLabel(
			locator1 = "MPRegistrationCompany#COUNTRY_SELECT",
			value1 = "${companyCountry}");

		AssertSelectedLabel(
			locator1 = "MPRegistrationCompany#REGION_SELECT",
			value1 = "${companyRegion}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#CITY_FIELD",
			value1 = "${companyCity}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#POSTAL_CODE_FIELD",
			value1 = "${companyPostalCode}");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#PHONE_FIELD",
			value1 = "${companyPhone}");
	}

}