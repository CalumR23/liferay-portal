<definition>
	<command name="addApp">
		<execute macro="MPButton#addNewApp" />

		<execute macro="AccountAppAdd#addDetails">
			<var name="appCategory" value="${appCategory}" />
			<var name="appDescription" value="${appDescription}" />
			<var name="appIconFile" value="${appIconFile}" />
			<var name="appTitle" value="${appTitle}" />
			<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
			<var name="isFreePaid" value="${isFreePaid}" />
			<var name="supportUrl" value="${supportUrl}" />
		</execute>

		<execute macro="AccountAppAdd#addUpload">
			<var name="appFileList" value="${appFileList}" />
			<var name="appPackageList" value="${appPackageList}" />
			<var name="portalVersionName" value="${portalVersionName}" />
			<var name="versionNumber" value="${versionNumber}" />
		</execute>
	</command>

	<command name="editAppPaid">
		<execute macro="MPButton#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountNavigator#gotoEditAppLicense" />

		<execute macro="AccountAppAdd#addLicense">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
			<var name="isSubscription" value="${isSubscription}" />
			<var name="isTrial" value="${isTrial}" />
			<var name="licenseTerm" value="${licenseTerm}" />
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<execute macro="AccountAppAdd#addPricing">
			<var name="currency" value="${currency}" />
			<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
			<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
			<var name="tableTitle" value="Default Pricing" />
		</execute>
	</command>

	<command name="editAppPaidWithPerpetualAndSubscription">
		<execute macro="MPButton#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountNavigator#gotoEditAppLicense" />

		<execute macro="AccountAppAdd#addLicense">
			<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
			<var name="isSubscription" value="true" />
			<var name="isTrial" value="${isTrial}" />
			<var name="licenseTerm" value="Perpetual" />
			<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
		</execute>

		<execute macro="AccountAppAdd#addPricingWithSubscription">
			<var name="currency" value="${currency}" />
			<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
			<var name="developerSubscriptionPriceList" value="${developerSubscriptionPriceList}" />
			<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
			<var name="standardSubscriptionPriceList" value="${standardSubscriptionPriceList}" />
			<var name="tableTitle" value="Default Pricing" />
		</execute>
	</command>

	<command name="editAppWithLabs">
		<execute macro="MPButton#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountAppAddEntry#checkLabs" />

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Save as Draft" />
		</execute>
	</command>

	<command name="editAppWithNewVersion">
		<execute macro="MPButton#addNewVersion" />

		<execute macro="MPButton#next" />

		<execute macro="AccountAppAdd#addUploadWithWhatsNewDescription">
			<var name="appFileList" value="${appFileList}" />
			<var name="appPackageList" value="${appPackageList}" />
			<var name="portalVersionName" value="${portalVersionName}" />
			<var name="versionNumber" value="${versionNumber}" />
			<var name="whatsNewDescription" value="Delete when this isn't required anymore" />
		</execute>
	</command>

	<command name="editAppWithScreenCaptures">
		<execute macro="MPButton#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountAppAddEntry#uploadScreenCaptures">
			<var name="screenCapturesList" value="${screenCapturesList}" />
		</execute>

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Save as Draft" />
		</execute>
	</command>

	<command name="editAppWithURLs">
		<execute macro="MPButton#button1">
			<var name="buttonName" value="Edit" />
		</execute>

		<execute macro="AccountAppAddEntry#typeDocumentationUrl">
			<var name="documentationUrl" value="${documentationUrl}" />
		</execute>

		<execute macro="AccountAppAddEntry#typeSourceCodeUrl">
			<var name="sourceCodeUrl" value="${sourceCodeUrl}" />
		</execute>

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Save as Draft" />
		</execute>
	</command>

	<command name="setupAcceptDeveloperTermsOfService">
		<execute macro="AccountNavigator#gotoDevelopmentAppsViaAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<if>
			<condition function="IsElementNotPresent" locator1="MPButton#ADD_NEW_APP_BUTTON" />
			<then>
				<execute macro="MPButton#button2">
					<var name="buttonName" value="I Agree" />
				</execute>

				<execute macro="MPButton#button2">
					<var name="buttonName" value="I Agree" />
				</execute>
			</then>
		</if>
	</command>

	<command name="setupAndSubmitApp">
		<var name="key_appTitle" value="${appTitle}" />

		<execute macro="AccountNavigator#gotoDevelopmentAppsViaAccount">
			<var name="companyName" value="${companyName}" />
		</execute>

		<if>
			<condition function="IsElementNotPresent" locator1="MPDeveloperApps#APP_TITLE_LINK" />
			<then>
				<execute macro="Account#addApp">
					<var name="appCategory" value="${appCategory}" />
					<var name="appDescription" value="${appDescription}" />
					<var name="appFileList" value="${appFileList}" />
					<var name="appIconFile" value="${appIconFile}" />
					<var name="appPackageList" value="${appPackageList}" />
					<var name="appTitle" value="${appTitle}" />
					<var name="developerWebsiteUrl" value="${developerWebsiteUrl}" />
					<var name="isFreePaid" value="${isFreePaid}" />
					<var name="portalVersionName" value="${portalVersionName}" />
					<var name="supportUrl" value="${supportUrl}" />
					<var name="versionNumber" value="${versionNumber}" />
				</execute>

				<if>
					<and>
						<contains string="${licenseTerm}" substring="Perpetual" />
						<equals arg1="${isSubscription}" arg2="true" />
					</and>
					<then>
						<execute macro="AccountNavigator#gotoDevelopmentAppsAppTitleViaAccount">
							<var name="appTitle" value="${appTitle}" />
							<var name="companyName" value="${companyName}" />
						</execute>

						<execute macro="Account#editAppPaidWithPerpetualAndSubscription">
							<var name="currency" value="${currency}" />
							<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
							<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
							<var name="developerSubscriptionPriceList" value="${developerSubscriptionPriceList}" />
							<var name="isSubscription" value="${isSubscription}" />
							<var name="isTrial" value="${isTrial}" />
							<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
							<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
							<var name="standardSubscriptionPriceList" value="${standardSubscriptionPriceList}" />
						</execute>
					</then>
					<elseif>
						<contains string="${isFreePaid}" substring="paid" />
						<then>
							<execute macro="AccountNavigator#gotoDevelopmentAppsAppTitleViaAccount">
								<var name="appTitle" value="${appTitle}" />
								<var name="companyName" value="${companyName}" />
							</execute>

							<execute macro="Account#editAppPaid">
								<var name="currency" value="${currency}" />
								<var name="developerLicensePriceList" value="${developerLicensePriceList}" />
								<var name="developerLicenseUnitsList" value="${developerLicenseUnitsList}" />
								<var name="isSubscription" value="${isSubscription}" />
								<var name="isTrial" value="${isTrial}" />
								<var name="licenseTerm" value="${licenseTerm}" />
								<var name="standardLicensePriceList" value="${standardLicensePriceList}" />
								<var name="standardLicenseUnitsList" value="${standardLicenseUnitsList}" />
							</execute>
						</then>
					</elseif>
				</if>

				<execute macro="AccountNavigator#gotoDevelopmentAppsAppTitleViaAccount">
					<var name="appTitle" value="${appTitle}" />
					<var name="companyName" value="${companyName}" />
				</execute>

				<execute macro="AccountAppAdd#clickSubmit" />

				<var name="pending" value="true" />
			</then>
			<else>
				<execute function="Click" locator1="MPDeveloperApps#APP_TITLE_LINK" />

				<if>
					<and>
						<condition function="IsElementPresent" locator1="MPDeveloperApps#ADD_NEW_VERSION_BUTTON" />
						<equals arg1="${update}" arg2="true" />
					</and>
					<then>
						<execute macro="Account#editAppWithNewVersion">
							<var name="appFileList" value="${appFileList}" />
							<var name="appPackageList" value="${appPackageList}" />
							<var name="portalVersionName" value="${portalVersionName}" />
							<var name="versionNumber" value="${versionNumber}" />
							<var name="whatsNewDescription" value="This is an upgrade to version ${versionNumber}" />
						</execute>

						<execute macro="AccountNavigator#gotoDevelopmentAppsAppTitleViaAccount">
							<var name="appTitle" value="${appTitle}" />
							<var name="companyName" value="${companyName}" />
						</execute>

						<execute macro="AccountAppAdd#clickSubmit" />

						<var name="pending" value="true" />
					</then>
				</if>
			</else>
		</if>

		<if>
			<and>
				<equals arg1="${doApprove}" arg2="true" />
				<equals arg1="${pending}" arg2="true" />
			</and>
			<then>
				<execute macro="MPUser#logoutAndLogin">
					<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
					<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword" />
				</execute>

				<execute macro="MarketplaceAdmin#setupAppApprove">
					<var name="appTitle" value="${appTitle}" />
				</execute>
			</then>
		</if>
	</command>

	<command name="tearDownSubmittedApp">
		<for list="${companyNameList}" param="companyName" >
			<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
				<var name="companyName" value="${companyName}" />
			</execute>

			<for list="${appTitleList}" param="appTitle" >
				<execute macro="AccountNavigator#gotoDevSidebar">
					<var name="devSidebarItem" value="Apps" />
				</execute>

				<execute function="Pause" locator1="1000" />

				<var name="key_appTitle" value="${appTitle}" />
				<if>
					<condition function="IsElementPresent" locator1="MPDeveloperApps#APP_TITLE_LINK" />
					<then>
						<execute macro="AccountNavigator#gotoDevApp">
							<var name="appTitle" value="${appTitle}" />
						</execute>

						<execute function="Pause" locator1="1000" />

						<if>
							<condition function="IsElementPresent" locator1="MPButton#CANCEL_SUBMISSION_BUTTON" />
							<then>
								<execute macro="MPButton#cancelSubmission" />
							</then>
						</if>

						<if>
							<condition function="IsElementPresent" locator1="MPDeveloperApps#DISCARD_CHANGES" />
							<then>
								<execute function="AssertClickNoError" locator1="MPDeveloperApps#DISCARD_CHANGES" value1="Discard Changes" />
								<execute function="Confirm" value1="Are you sure you want to discard all changes?" />

								<execute macro="MPMessage#success" />
							</then>
						</if>
					</then>
				</if>
			</for>
		</for>
	</command>
</definition>