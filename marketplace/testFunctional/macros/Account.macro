definition {

	macro addApp {
		MPButton.addNewApp();

		AccountAppAdd.addDetails(
			appCategory = "${appCategory}",
			appDescription = "${appDescription}",
			appIconFile = "${appIconFile}",
			appTitle = "${appTitle}",
			developerWebsiteUrl = "${developerWebsiteUrl}",
			isFreePaid = "${isFreePaid}",
			supportUrl = "${supportUrl}");

		AccountAppAdd.addUpload(
			appFileList = "${appFileList}",
			appPackageList = "${appPackageList}",
			portalVersionName = "${portalVersionName}",
			versionNumber = "${versionNumber}");
	}

	macro editAppPaid {
		MPButton.button1(buttonName = "Edit");

		AccountNavigator.gotoEditAppLicense();

		AccountAppAdd.addLicense(
			developerLicenseUnitsList = "${developerLicenseUnitsList}",
			isSubscription = "${isSubscription}",
			isTrial = "${isTrial}",
			licenseTerm = "${licenseTerm}",
			standardLicenseUnitsList = "${standardLicenseUnitsList}");

		AccountAppAdd.addPricing(
			currency = "${currency}",
			developerLicensePriceList = "${developerLicensePriceList}",
			standardLicensePriceList = "${standardLicensePriceList}",
			tableTitle = "Default Pricing");
	}

	macro editAppPaidWithPerpetualAndSubscription {
		MPButton.button1(buttonName = "Edit");

		AccountNavigator.gotoEditAppLicense();

		AccountAppAdd.addLicense(
			developerLicenseUnitsList = "${developerLicenseUnitsList}",
			isSubscription = "true",
			isTrial = "${isTrial}",
			licenseTerm = "Perpetual",
			standardLicenseUnitsList = "${standardLicenseUnitsList}");

		AccountAppAdd.addPricingWithSubscription(
			currency = "${currency}",
			developerLicensePriceList = "${developerLicensePriceList}",
			developerSubscriptionPriceList = "${developerSubscriptionPriceList}",
			standardLicensePriceList = "${standardLicensePriceList}",
			standardSubscriptionPriceList = "${standardSubscriptionPriceList}",
			tableTitle = "Default Pricing");
	}

	macro editAppWithLabs {
		MPButton.button1(buttonName = "Edit");

		AccountAppAddEntry.checkLabs();

		MPButton.button1(buttonName = "Save as Draft");
	}

	macro editAppWithNewVersion {
		MPButton.addNewVersion();

		MPButton.next();

		AccountAppAdd.addUploadWithWhatsNewDescription(
			appFileList = "${appFileList}",
			appPackageList = "${appPackageList}",
			portalVersionName = "${portalVersionName}",
			versionNumber = "${versionNumber}",
			whatsNewDescription = "Delete when this isn't required anymore");
	}

	macro editAppWithScreenCaptures {
		MPButton.button1(buttonName = "Edit");

		AccountAppAddEntry.uploadScreenCaptures(screenCapturesList = "${screenCapturesList}");

		MPButton.button1(buttonName = "Save as Draft");
	}

	macro editAppWithURLs {
		MPButton.button1(buttonName = "Edit");

		AccountAppAddEntry.typeDocumentationURL(documentationUrl = "${documentationUrl}");

		AccountAppAddEntry.typeSourceCodeURL(sourceCodeUrl = "${sourceCodeUrl}");

		MPButton.button1(buttonName = "Save as Draft");
	}

	macro setupAcceptDeveloperTermsOfService {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "${companyName}");

		if (IsElementNotPresent(locator1 = "MPButton#ADD_NEW_APP_BUTTON")) {
			MPButton.button2(buttonName = "I Agree");

			MPButton.button2(buttonName = "I Agree");
		}
	}

	macro setupAndSubmitApp {
		var key_appTitle = "${appTitle}";

		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "${companyName}");

		if (IsElementNotPresent(locator1 = "MPDeveloperApps#APP_TITLE_LINK")) {
			Account.addApp(
				appCategory = "${appCategory}",
				appDescription = "${appDescription}",
				appFileList = "${appFileList}",
				appIconFile = "${appIconFile}",
				appPackageList = "${appPackageList}",
				appTitle = "${appTitle}",
				developerWebsiteUrl = "${developerWebsiteUrl}",
				isFreePaid = "${isFreePaid}",
				portalVersionName = "${portalVersionName}",
				supportUrl = "${supportUrl}",
				versionNumber = "${versionNumber}");

			if (contains("${licenseTerm}", "Perpetual") && ("${isSubscription}" == "true")) {
				AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
					appTitle = "${appTitle}",
					companyName = "${companyName}");

				Account.editAppPaidWithPerpetualAndSubscription(
					currency = "${currency}",
					developerLicensePriceList = "${developerLicensePriceList}",
					developerLicenseUnitsList = "${developerLicenseUnitsList}",
					developerSubscriptionPriceList = "${developerSubscriptionPriceList}",
					isSubscription = "${isSubscription}",
					isTrial = "${isTrial}",
					standardLicensePriceList = "${standardLicensePriceList}",
					standardLicenseUnitsList = "${standardLicenseUnitsList}",
					standardSubscriptionPriceList = "${standardSubscriptionPriceList}");
			}
			else if (contains("${isFreePaid}", "paid")) {
				AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
					appTitle = "${appTitle}",
					companyName = "${companyName}");

				Account.editAppPaid(
					currency = "${currency}",
					developerLicensePriceList = "${developerLicensePriceList}",
					developerLicenseUnitsList = "${developerLicenseUnitsList}",
					isSubscription = "${isSubscription}",
					isTrial = "${isTrial}",
					licenseTerm = "${licenseTerm}",
					standardLicensePriceList = "${standardLicensePriceList}",
					standardLicenseUnitsList = "${standardLicenseUnitsList}");
			}

			AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
				appTitle = "${appTitle}",
				companyName = "${companyName}");

			AccountAppAdd.clickSubmit();

			var pending = "true";
		}
		else {
			Click(locator1 = "MPDeveloperApps#APP_TITLE_LINK");

			if ((IsElementPresent(locator1 = "MPDeveloperApps#ADD_NEW_VERSION_BUTTON")) && ("${update}" == "true")) {
				Account.editAppWithNewVersion(
					appFileList = "${appFileList}",
					appPackageList = "${appPackageList}",
					portalVersionName = "${portalVersionName}",
					versionNumber = "${versionNumber}",
					whatsNewDescription = "This is an upgrade to version ${versionNumber}");

				AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
					appTitle = "${appTitle}",
					companyName = "${companyName}");

				AccountAppAdd.clickSubmit();

				var pending = "true";
			}
		}

		if (("${doApprove}" == "true") && ("${pending}" == "true")) {
			MPUser.logoutAndLogin(
				userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
				userPassword = PropsUtil.get("marketplace.email.password.5"));

			MarketplaceAdmin.setupAppApprove(appTitle = "${appTitle}");
		}
	}

	macro tearDownSubmittedApp {
		for (var companyName : list "${companyNameList}") {
			MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyName}");

			for (var appTitle : list "${appTitleList}") {
				AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");

				Pause(locator1 = "1000");

				var key_appTitle = "${appTitle}";

				if (IsElementPresent(locator1 = "MPDeveloperApps#APP_TITLE_LINK")) {
					AccountNavigator.gotoDevApp(appTitle = "${appTitle}");

					Pause(locator1 = "1000");

					if (IsElementPresent(locator1 = "MPButton#CANCEL_SUBMISSION_BUTTON")) {
						MPButton.cancelSubmission();
					}

					if (IsElementPresent(locator1 = "MPDeveloperApps#DISCARD_CHANGES")) {
						AssertClickNoError(
							locator1 = "MPDeveloperApps#DISCARD_CHANGES",
							value1 = "Discard Changes");

						Confirm(value1 = "Are you sure you want to discard all changes?");

						MPMessage.success();
					}
				}
			}
		}
	}

}