definition {

	macro addDestinationAddress {
		if (IsElementPresent(locator1 = "MPPurchaseDestination#ADD_NEW_ADDRESS")) {
			Click(locator1 = "MPPurchaseDestination#ADD_NEW_ADDRESS");
		}

		if (IsElementPresent(locator1 = "MPPurchaseDestination#DESTINATION_COMPANY_NAME")) {
			MarketplacePurchaseEntry.typeDestinationCompanyName(destinationAddressName = "${destinationAddressName}");
		}

		MarketplacePurchaseEntry.typeDestinationStreet1();

		MarketplacePurchaseEntry.viewDestinationCountry();

		MarketplacePurchaseEntry.selectDestinationregion();

		MarketplacePurchaseEntry.typeDestinationCity();

		MarketplacePurchaseEntry.typeDestinationZip();

		MPButton.button1(buttonName = "Save and Continue");
	}

	macro addLicenseQuantity {
		for (var quantity : list "${standardLicenseQuantityList}") {
			MarketplacePurchaseEntry.typeStandardLicenseQuantity(quantity = "${quantity}");
		}

		for (var quantity : list "${developerLicenseQuantityList}") {
			MarketplacePurchaseEntry.typeDeveloperLicenseQuantity(quantity = "${quantity}");
		}
	}

	macro addProject {
		MarketplacePurchaseEntry.clickProjectCard(projectName = "Add a New Project");

		MarketplacePurchaseEntry.typeNewProjectName(projectName = "${projectName}");

		MPButton.button1(buttonName = "Add");

		MPMessage.success();
	}

	macro purchaseAccountTabFreeOrTrial {
		var key_projectName = "${projectName}";

		if (IsElementNotPresent(locator1 = "MPPurchaseAccount#PROJECT_CARD")) {
			MarketplacePurchaseApp.addProject(projectName = "${projectName}");
		}

		MarketplacePurchaseEntry.clickProjectCard(projectName = "${projectName}");

		if (IsElementPresent(locator1 = "MPPurchaseAccount#LEGAL_ENTITY_NAME_FIELD")) {
			MarketplacePurchaseEntry.typeLegalEntityName(legalEntityName = "${legalEntityName}");
		}

		MarketplacePurchaseEntry.checkEula();

		MPButton.button1(buttonName = "Purchase");
	}

	macro purchaseAccountTabPaid {
		var key_projectName = "${projectName}";

		if (IsElementNotPresent(locator1 = "MPPurchaseAccount#PROJECT_CARD")) {
			MarketplacePurchaseApp.addProject(projectName = "${projectName}");
		}

		MarketplacePurchaseEntry.clickProjectCard(projectName = "${projectName}");

		MPButton.next();
	}

	macro purchaseDestinationTab {
		var key_destinationAddressName = "${destinationAddressName}";

		if (IsElementPresent(locator1 = "MPPurchaseDestination#DESTINATION_ADDRESS_CARD")) {
			MarketplacePurchaseEntry.clickDestinationAddressCard(destinationAddressName = "${destinationAddressName}");

			MPButton.next();
		}
		else {
			MarketplacePurchaseApp.addDestinationAddress(destinationAddressName = "${destinationAddressName}");
		}
	}

	macro purchaseExtendedLicense {
		MarketplacePurchaseEntry.checkPurchaseType(licensePurchaseType = "Add Additional Instance Units");

		MPButton.next();

		MarketplacePurchaseEntry.confirmCurrentPurchaseProcess(currentPurchaseProcess = "License");

		MarketplacePurchaseApp.addLicenseQuantity(
			developerLicenseQuantityList = "${developerLicenseQuantityList}",
			standardLicenseQuantityList = "${standardLicenseQuantityList}");

		MPButton.next();

		MarketplacePurchaseEntry.confirmCurrentPurchaseProcess(currentPurchaseProcess = "Destination");
	}

	macro purchaseLicense {
		MarketplacePurchaseApp.addLicenseQuantity(
			developerLicenseQuantityList = "${developerLicenseQuantityList}",
			standardLicenseQuantityList = "${standardLicenseQuantityList}");

		MPButton.next();
	}

	macro purchaseRenewLicense {
		MarketplacePurchaseEntry.checkPurchaseType(licensePurchaseType = "Renew");

		MPButton.next();

		MarketplacePurchaseEntry.confirmCurrentPurchaseProcess(currentPurchaseProcess = "License");

		MPButton.next();

		MarketplacePurchaseEntry.confirmCurrentPurchaseProcess(currentPurchaseProcess = "Destination");
	}

	macro purchaseSummaryTab {
		if (isSet(standardSummaryQuantityList)) {
			MarketplacePurchaseEntry.updateStandardSummaryQuantity(standardSummaryQuantityList = "${standardSummaryQuantityList}");
		}

		if (isSet(developerSummaryQuantityList)) {
			MarketplacePurchaseEntry.updateDeveloperSummaryQuantity(developerSummaryQuantityList = "${developerSummaryQuantityList}");
		}

		MarketplacePurchaseEntry.checkPaymentMethod(paymentMethod = "${paymentMethod}");

		if ("${paymentMethod}" == "Invoice Me") {
			MarketplacePurchaseEntry.typeInvoiceEmailAddress(invoiceEmailAddress = "${invoiceEmailAddress}");
		}

		MarketplacePurchaseEntry.checkEula();

		MPButton.submit();
	}

}