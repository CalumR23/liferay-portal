<definition>
	<command name="addDestinationAddress">
		<if>
			<condition function="IsElementPresent" locator1="MPPurchaseDestination#ADD_NEW_ADDRESS" />
			<then>
				<execute function="Click" locator1="MPPurchaseDestination#ADD_NEW_ADDRESS" />
			</then>
		</if>

		<if>
			<condition function="IsElementPresent" locator1="MPPurchaseDestination#DESTINATION_COMPANY_NAME" />
			<then>
				<execute macro="MarketplacePurchaseEntry#typeDestinationCompanyName">
					<var name="destinationAddressName" value="${destinationAddressName}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#typeDestinationStreet1" />

		<execute macro="MarketplacePurchaseEntry#viewDestinationCountry" />

		<execute macro="MarketplacePurchaseEntry#selectDestinationregion" />

		<execute macro="MarketplacePurchaseEntry#typeDestinationCity" />

		<execute macro="MarketplacePurchaseEntry#typeDestinationZip" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Save and Continue" />
		</execute>
	</command>

	<command name="addLicenseQuantity">
		<for list="${standardLicenseQuantityList}" param="quantity">
			<execute macro="MarketplacePurchaseEntry#typeStandardLicenseQuantity">
				<var name="quantity" value="${quantity}" />
			</execute>
		</for>

		<for list="${developerLicenseQuantityList}" param="quantity">
			<execute macro="MarketplacePurchaseEntry#typeDeveloperLicenseQuantity">
				<var name="quantity" value="${quantity}" />
			</execute>
		</for>
	</command>

	<command name="addProject">
		<execute macro="MarketplacePurchaseEntry#clickProjectCard">
			<var name="projectName" value="Add a New Project" />
		</execute>

		<execute macro="MarketplacePurchaseEntry#typeNewProjectName">
			<var name="projectName" value="${projectName}" />
		</execute>

		<execute macro="Button#button1">
			<var name="buttonName" value="Add" />
		</execute>

		<execute macro="Message#success" />
	</command>

	<command name="purchaseAccountTabFreeOrTrial">
		<var name="key_projectName" value="${projectName}" />

		<if>
			<condition function="IsElementNotPresent" locator1="MPPurchaseAccount#PROJECT_CARD" />
			<then>
				<execute macro="MarketplacePurchaseApp#addProject">
					<var name="projectName" value="${projectName}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#clickProjectCard">
			<var name="projectName" value="${projectName}" />
		</execute>

		<if>
			<condition function="IsElementPresent" locator1="MPPurchaseAccount#LEGAL_ENTITY_NAME_FIELD" />
			<then>
				<execute macro="MarketplacePurchaseEntry#typeLegalEntityName">
					<var name="legalEntityName" value="${legalEntityName}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#checkEula" />

		<execute macro="Button#button1">
			<var name="buttonName" value="Purchase" />
		</execute>
	</command>

	<command name="purchaseAccountTabPaid">
		<var name="key_projectName" value="${projectName}" />

		<if>
			<condition function="IsElementNotPresent" locator1="MPPurchaseAccount#PROJECT_CARD" />
			<then>
				<execute macro="MarketplacePurchaseApp#addProject">
					<var name="projectName" value="${projectName}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#clickProjectCard">
			<var name="projectName" value="${projectName}" />
		</execute>

		<execute macro="Button#next" />
	</command>

	<command name="purchaseDestinationTab">
		<var name="key_destinationAddressName" value="${destinationAddressName}" />

		<if>
			<condition function="IsElementPresent" locator1="MPPurchaseDestination#DESTINATION_ADDRESS_CARD"  />
			<then>
				<execute macro="MarketplacePurchaseEntry#clickDestinationAddressCard">
					<var name="destinationAddressName" value="${destinationAddressName}" />
				</execute>

				<execute macro="Button#next" />
			</then>
			<else>
				<execute macro="MarketplacePurchaseApp#addDestinationAddress">
					<var name="destinationAddressName" value="${destinationAddressName}" />
				</execute>
			</else>
		</if>
	</command>

	<command name="purchaseExtendedLicense">
		<execute macro="MarketplacePurchaseEntry#checkPurchaseType">
			<var name="licensePurchaseType" value="Add Additional Instance Units" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="MarketplacePurchaseEntry#confirmCurrentPurchaseProcess" >
			<var name="currentPurchaseProcess" value="License" />
		</execute>

		<execute macro="MarketplacePurchaseApp#addLicenseQuantity">
			<var name="developerLicenseQuantityList" value="${developerLicenseQuantityList}" />
			<var name="standardLicenseQuantityList" value="${standardLicenseQuantityList}" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="MarketplacePurchaseEntry#confirmCurrentPurchaseProcess" >
			<var name="currentPurchaseProcess" value="Destination" />
		</execute>
	</command>

	<command name="purchaseLicense">
		<execute macro="MarketplacePurchaseApp#addLicenseQuantity">
			<var name="developerLicenseQuantityList" value="${developerLicenseQuantityList}" />
			<var name="standardLicenseQuantityList" value="${standardLicenseQuantityList}" />
		</execute>

		<execute macro="Button#next" />
	</command>

	<command name="purchaseRenewLicense">
		<execute macro="MarketplacePurchaseEntry#checkPurchaseType">
			<var name="licensePurchaseType" value="Renew" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="MarketplacePurchaseEntry#confirmCurrentPurchaseProcess" >
			<var name="currentPurchaseProcess" value="License" />
		</execute>

		<execute macro="Button#next" />

		<execute macro="MarketplacePurchaseEntry#confirmCurrentPurchaseProcess" >
			<var name="currentPurchaseProcess" value="Destination" />
		</execute>
	</command>

	<command name="purchaseSummaryTab">
		<if>
			<isset var="standardSummaryQuantityList" />
			<then>
				<execute macro="MarketplacePurchaseEntry#updateStandardSummaryQuantity">
					<var name="standardSummaryQuantityList" value="${standardSummaryQuantityList}" />
				</execute>
			</then>
		</if>

		<if>
			<isset var="developerSummaryQuantityList" />
			<then>
				<execute macro="MarketplacePurchaseEntry#updateDeveloperSummaryQuantity">
					<var name="developerSummaryQuantityList" value="${developerSummaryQuantityList}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#checkPaymentMethod">
			<var name="paymentMethod" value="${paymentMethod}" />
		</execute>

		<if>
			<equals arg1="${paymentMethod}" arg2="Invoice Me" />
			<then>
				<execute macro="MarketplacePurchaseEntry#typeInvoiceEmailAddress">
					<var name="invoiceEmailAddress" value="${invoiceEmailAddress}" />
				</execute>
			</then>
		</if>

		<execute macro="MarketplacePurchaseEntry#checkEula" />

		<execute macro="Button#submit" />
	</command>
</definition>