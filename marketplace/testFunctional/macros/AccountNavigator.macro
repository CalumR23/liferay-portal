definition {

	var marketplaceURL = PropsUtil.get("portal.marketplace.url");

	macro gotoDevApp {
		var key_appTitle = "${appTitle}";

		Click(locator1 = "MPDeveloperApps#APP_TITLE_LINK");
	}

	macro gotoDeveloperTabViaAccount {
		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyName}");

		AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");

		AccountNavigator.gotoDevApp(appTitle = "${appTitle}");

		Click(locator1 = "MPDeveloperApps#DEVELOPER_TAB");
	}

	macro gotoDevelopmentAppsAppTitleViaAccount {
		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyName}");

		AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");

		AccountNavigator.gotoDevApp(appTitle = "${appTitle}");
	}

	macro gotoDevelopmentAppsViaAccount {
		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyName}");

		AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");
	}

	macro gotoDevSidebar {
		var key_devSidebar = "${devSidebarItem}";

		Click(locator1 = "AccountSidebar#DEVELOPMENT_SIDEBAR");
	}

	macro gotoEditAppDetails {
		Click(locator1 = "MPDeveloperAppsAdd#DETAILS");
	}

	macro gotoEditAppLicense {
		Click(locator1 = "MPDeveloperAppsAdd#LICENSE");
	}

	macro gotoEditAppPricing {
		Click(locator1 = "MPDeveloperAppsAdd#PRICING");
	}

	macro gotoEditAppVersion {
		Click(locator1 = "MPDeveloperAppsAdd#VERSION");
	}

	macro gotoUserApp {
		if (IsElementPresent(locator1 = "AccountSidebar#USER_APPS")) {
			Click(locator1 = "AccountSidebar#USER_APPS");
		}
		else {
			Click(locator1 = "MPNavigation#NAVIGATION_MENU");

			AssertClick(
				locator1 = "MPNavigation#PURCHASED_APPS",
				value1 = "Purchased Apps");
		}

		AssertClick(
			locator1 = "MPApps#PROJECT_PERSONAL_USE",
			value1 = "Personal Use");

		Click(
			key_appTitle = "${appTitle}",
			locator1 = "Marketplace#APP_TITLE");
	}

	macro gotoUserAppViaProjects {
		var key_projectName = "${projectName}";

		if (IsElementPresent(locator1 = "AccountSidebar#USER_PROJECTS")) {
			Click(locator1 = "AccountSidebar#USER_PROJECTS");
		}
		else {
			Click(locator1 = "MPNavigation#NAVIGATION_MENU");

			AssertClick(
				locator1 = "MPNavigation#PURCHASED_APPS",
				value1 = "Purchased Apps");
		}

		Click(locator1 = "MPApps#PROJECT_NAME");

		MouseMove(
			key_appTitle = "${appTitle}",
			locator1 = "AccountSidebar#USER_APPS");

		Click(
			key_appTitle = "${appTitle}",
			locator1 = "Marketplace#APP_TITLE");
	}

}