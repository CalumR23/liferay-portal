definition {

	macro pay {
		Pause(locator1 = "5000");

		if (IsElementNotPresent(locator1 = "Paypal#LOGIN_BUTTON")) {
			AssertClick(
				locator1 = "Paypal#LOGIN_TO_PAYPAL",
				value1 = "Log in to your PayPal account");
		}

		MPPaypalEntry.typeEmailAddress(paypalEmailAddress = PropsUtil.get("marketplace.email.address.4"));

		MPPaypalEntry.typePassword(paypalEmailPassword = PropsUtil.get("marketplace.email.password.4"));

		AssertClick.assertValueClickAtAndWait(
			locator1 = "Paypal#LOGIN_BUTTON",
			value1 = "Log In");

		Pause(locator1 = "10000");

		AssertClick(
			locator1 = "Paypal#PAY_BUTTON",
			value1 = "Pay");

		Pause(locator1 = "60000");
	}

}