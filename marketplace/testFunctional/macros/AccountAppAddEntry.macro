definition {
	macro checkLabs {
		Check(locator1 = "MPDeveloperAppsAddDetails#LABS_CHECKBOX");
	}

	macro checkLicenseTerm {
		var key_licenseTerm = "${licenseTerm}";

		Check(locator1 = "MPDeveloperAppsAddLicense#LICENSE_TERM_RADIO");
	}

	macro checkLocalized {
		Check(locator1 = "MPDeveloperAppsAddDetails#LOCALIZED_CHECKBOX");
	}

	macro checkPricing {
		var key_isFreePaid = "${isFreePaid}";

		Check(locator1 = "MPDeveloperAppsAddDetails#PRICE_RADIO");
	}

	macro checkSecurity {
		Check(locator1 = "MPDeveloperAppsAddDetails#SECURITY_CHECKBOX");
	}

	macro checkSubscriptionServices {
		Check(locator1 = "MPDeveloperAppsAddLicense#OFFER_SUBSCRIPTION_CHECKBOX");
	}

	macro checkTrialLicense {
		Check(locator1 = "MPDeveloperAppsAddLicense#TRIAL_LICENSE_CHECKBOX");
	}

	macro clickDeleteTable {
		var key_tableNum = "${tableNum}";

		Click(locator1 = "MPDeveloperAppsAddPricing#DELETE");
	}

	macro confirmCurrentAppAddProcess {
		AssertTextEquals(
			locator1 = "MPDeveloperAppsAddDetails#APP_ADD_PROCESS_BREADCRUMB_CURRENT",
			value1 = "${currentAppAddProcess}"
		);
	}

	macro deleteTag {
		Click(locator1 = "TAG_DELETE_BUTTON");
	}

	macro inputTagViaAdd {
		Type(locator1 = "TAGS_FIELD", value1 = "${tag}");

		Click(locator1 = "TAGS_ADD");
	}

	macro inputTagViaSelect {
		var key_tag = "${tag}";

		Click(locator1 = "TAGS_SELECT");

		Type(locator1 = "TAG_SELECTOR_SEARCH_INPUT", value1 = "${tag}");

		Click(locator1 = "TAG_SELECTOR_LIST", value1 = "${tag}");

		Click(locator1 = "TAG_SELECTOR_CLOSE_BUTTON");
	}

	macro inputTagViaSuggestions {
		var key_tag = "${tag}";

		Click(locator1 = "TAGS_SUGGESTIONS");

		Type(locator1 = "TAG_SELECTOR_SEARCH_INPUT", value1 = "${tag}");

		Click(locator1 = "TAG_SELECTOR_LIST", value1 = "${tag}");

		Click(locator1 = "TAG_SELECTOR_CLOSE_BUTTON");
	}

	macro inputTagViaTyping {
		Type(locator1 = "TAGS_FIELD", value1 = "${tag}");

		KeyPress(locator1 = "TAGS_FIELD", value1 = "Enter");
	}

	macro moveAllCountriesFromPoolToTable {
		var key_tableNum = "${tableNum}";

		Click(locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_SELECT_ALL");

		if (IsElementPresent(locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE")) {
			MouseOver(locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE");

			MouseDown.mouseDownAt(
				locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE"
			);

			Pause(locator1 = "2000");

			MouseOver(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");

			MouseUp.mouseUpAt(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");
		}
	}

	macro moveAllCountriesFromTableToPool {
		var key_tableNum = "${tableNum}";

		Click(locator1 = "MPDeveloperAppsAddPricing#SELECT_ALL");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");

		MouseDown.mouseDownAt(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");

		Pause(locator1 = "2000");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE");

		MouseUp.mouseUpAt(
			locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE"
		);
	}

	macro moveSelectedCountryToPool {
		var key_country = "${country}";
		var key_tableNum = "${tableNum}";

		Click(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		MouseDown.mouseDownAt(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		Pause(locator1 = "2000");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE");

		MouseUp.mouseUpAt(
			locator1 = "MPDeveloperAppsAddPricing#AVAILABLE_COUNTRIES_ZONE"
		);
	}

	macro moveSelectedCountryToTable {
		var key_country = "${country}";
		var key_tableNum = "${tableNum}";

		Click(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		MouseDown.mouseDownAt(locator1 = "MPDeveloperAppsAddPricing#COUNTRY");

		Pause(locator1 = "2000");

		MouseOver(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");

		MouseUp.mouseUpAt(locator1 = "MPDeveloperAppsAddPricing#COUNTRIES_ZONE");
	}

	macro selectCategory {
		Select(
			locator1 = "MPDeveloperAppsAddDetails#CATEGORY_SELECT",
			value1 = "${appCategory}"
		);
	}

	macro selectCurrency {
		var key_tableNum = "${tableNum}";

		Select(
			locator1 = "MPDeveloperAppsAddPricing#CURRENCY_SELECT",
			value1 = "${currency}"
		);
	}

	macro typeDescription {
		Type(
			locator1 = "MPDeveloperAppsAddDetails#DESCRIPTION",
			value1 = "${appDescription}"
		);
	}

	macro typeDeveloperLicensePrice {
		var licenseNum = "1";

		for (var developerLicensePrice : list "${developerLicensePriceList}") {
			var key_licenseNum = "${licenseNum}";
			var key_tableNum = "${tableNum}";

			Type(
				locator1 = "MPDeveloperAppsAddPricing#DEVELOPER_LICENSE_PRICE_FIELD",
				value1 = "${developerLicensePrice}"
			);

			var licenseNum = MathUtil.sum("${licenseNum}", "1");
		}
	}

	macro typeDeveloperLicenseQuantity {
		while (IsElementPresent(locator1 = "MPDeveloperAppsAddLicense#DEVELOPER_DELETE")) {
			Click(locator1 = "MPDeveloperAppsAddLicense#DEVELOPER_DELETE");
		}

		for (var developerLicenseQuantity : list "${developerLicenseUnitsList}") {
			Type(
				locator1 = "MPDeveloperAppsAddLicense#DEVELOPER_LICENSE_QUANTITY_FIELD",
				value1 = "${developerLicenseQuantity}"
			);

			Pause(locator1 = "1000");

			MPButton.developerLicenseAddQuantityButton();
		}
	}

	macro typeDeveloperSubscriptionPrice {
		var tableNum = "1";

		for (var developerSubscriptionPrice : list "${developerSubscriptionPriceList}") {
			var key_tableNum = "${tableNum}";

			Type(
				locator1 = "MPDeveloperAppsAddPricing#DEVELOPER_SUBSCRIPTION_PRICE_FIELD",
				value1 = "${developerSubscriptionPrice}"
			);

			var tableNum = MathUtil.sum("${tableNum}", "1");
		}
	}

	macro typeDeveloperURL {
		Type(
			locator1 = "MPDeveloperAppsAddDetails#DEVELOPER_WEBSITE_URL",
			value1 = "${developerWebsiteUrl}"
		);
	}

	macro typeDocumentationURL {
		Type(
			locator1 = "MPDeveloperAppsAddDetails#DOCUMENTATION_URL",
			value1 = "${documentationUrl}"
		);
	}

	macro typeSourceCodeURL {
		Type(
			locator1 = "MPDeveloperAppsAddDetails#SOURCE_CODE_URL",
			value1 = "${sourceCodeUrl}"
		);
	}

	macro typeStandardLicensePrice {
		var licenseNum = "1";

		for (var standardLicensePrice : list "${standardLicensePriceList}") {
			var key_licenseNum = "${licenseNum}";
			var key_tableNum = "${tableNum}";

			Type(
				locator1 = "MPDeveloperAppsAddPricing#STANDARD_LICENSE_PRICE_FIELD",
				value1 = "${standardLicensePrice}"
			);

			var licenseNum = MathUtil.sum("${licenseNum}", "1");
		}
	}

	macro typeStandardLicenseQuantity {
		while (IsElementPresent(locator1 = "MPDeveloperAppsAddLicense#STANDARD_DELETE")) {
			Click(locator1 = "MPDeveloperAppsAddLicense#STANDARD_DELETE");
		}

		for (var standardLicenseQuantity : list "${standardLicenseUnitsList}") {
			Type(
				locator1 = "MPDeveloperAppsAddLicense#STANDARD_LICENSE_QUANTITY_FIELD",
				value1 = "${standardLicenseQuantity}"
			);

			Pause(locator1 = "1000");

			MPButton.standardLicenseAddQuantityButton();
		}
	}

	macro typeStandardSubscriptionPrice {
		var tableNum = "1";

		for (var standardSubscriptionPrice : list "${standardSubscriptionPriceList}") {
			var key_tableNum = "${tableNum}";

			Type(
				locator1 = "MPDeveloperAppsAddPricing#STANDARD_SUBSCRIPTION_PRICE_FIELD",
				value1 = "${standardSubscriptionPrice}"
			);

			var tableNum = MathUtil.sum("${tableNum}", "1");
		}
	}

	macro typeSupportURL {
		Type(
			locator1 = "MPDeveloperAppsAddDetails#SUPPORT_URL",
			value1 = "${supportUrl}"
		);
	}

	macro typeTableTitle {
		var key_tableNum = "${tableNum}";

		Type(
			locator1 = "MPDeveloperAppsAddPricing#TITLE_FIELD",
			value1 = "${tableTitle}"
		);
	}

	macro typeTitle {
		Type(locator1 = "MPDeveloperAppsAddDetails#TITLE", value1 = "${appTitle}");
	}

	macro typeVersionNumber {
		Type(
			locator1 = "MPDeveloperAppsAddUpload#VERSION_NUMBER_FIELD",
			value1 = "${versionNumber}"
		);
	}

	macro uncheckSubscriptionServices {
		Uncheck(locator1 = "MPDeveloperAppsAddLicense#OFFER_SUBSCRIPTION_CHECKBOX");
	}

	macro uncheckTrialLicense {
		Uncheck(locator1 = "MPDeveloperAppsAddLicense#TRIAL_LICENSE_CHECKBOX");
	}

	macro uploadAppFiles {
		var key_portalVersionName = "${portalVersionName}";

		Check.noAssert(locator1 = "MPDeveloperAppsAddUpload#LIFERAY_VERSIONS_CHECKBOX");

		for (var fileName : list "${appFileList}") {
			Click(locator1 = "MPDeveloperAppsAddUpload#UPLOAD_AREA");

			MPSikuli.uploadFile(fileName = "${fileName}");
		}

		AssertElementNotPresent(locator1 = "MPDeveloperAppsAddUpload#UPLOAD_ERROR");
	}

	macro uploadAppIcon {
		UploadCommonFile(
			locator1 = "MPDeveloperAppsAddDetails#ICON_BROWSE_BUTTON",
			value1 = "${appIconFile}"
		);
	}

	macro uploadScreenCaptures {
		ScrollWebElementIntoView(
			locator1 = "MPDeveloperAppsAddDetails#SCREEN_CAPTURES_UPLOAD_AREA"
		);

		Pause(locator1 = "5000");

		for (var screenShCapture : list "${screenCapturesList}") {
			Click(locator1 = "MPDeveloperAppsAddDetails#SCREEN_CAPTURES_UPLOAD_AREA");

			MPSikuli.uploadFile(fileName = "${screenShCapture}");

			Pause(locator1 = "5000");
		}
	}
}