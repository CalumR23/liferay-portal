<definition>
	<var method="PropsUtil#get('portal.login.url')" name="loginURL" />
	<var method="PropsUtil#get('portal.logout.url')" name="logoutURL" />
	<var method="PropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

	<command name="login">
		<execute function="Open" locator1="${loginURL}" />

		<execute function="Type" locator1="MPLogin#EMAIL_ADDRESS_FIELD" value1="${userEmailAddress}" />
		<execute function="Type" locator1="MPLogin#PASSWORD_FIELD" value1="${userPassword}" />
		<execute function="Click" locator1="MPLogin#SIGN_IN_BUTTON" />

		<execute function="AssertElementPresent" locator1="MPLogin#LOGGED_IN_AS_CONFIRMATION" />

		<execute function="Open" locator1="${marketplaceURL}" />
	</command>

	<command name="logout">
		<execute function="Open" locator1="${logoutURL}" />
		<execute function="Open" locator1="${marketplaceURL}" />
	</command>

	<command name="logoutAndLogin">
		<execute macro="MPUser#logout" />

		<execute macro="MPUser#login">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userPassword" value="${userPassword}" />
		</execute>
	</command>
</definition>