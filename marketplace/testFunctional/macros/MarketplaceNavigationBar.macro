definition {

	var marketplaceURL = PropsUtil.get("portal.marketplace.url");

	macro gotoAccountHome {
		Open(locator1 = "${marketplaceURL}");

		Click(locator1 = "MPNavigation#NAVIGATION_MENU");

		Click(locator1 = "MPNavigation#ACCOUNT_HOME");
	}

	macro gotoBecomeDeveloper {
		var key_devSubmenuItem = "Become a Developer";

		Open(locator1 = "${marketplaceURL}");

		Click(locator1 = "MPNavigation#DEVELOPERS");

		Click(locator1 = "MPNavigation#DEVELOPERS_SUBMENU");
	}

	macro gotoCompanyAccount {
		var key_companyName = "${companyName}";

		Open(locator1 = "${marketplaceURL}");

		Click(locator1 = "MPNavigation#NAVIGATION_MENU");

		Click(locator1 = "MPNavigation#COMPANY_SITE");
	}

	macro gotoMarketplace {
		var key_devSubmenuItem = "Marketplace";

		Open(locator1 = "${marketplaceURL}");

		Click(locator1 = "MPNavigation#DEVELOPERS");

		Click(locator1 = "MPNavigation#DEVELOPERS_SUBMENU");
	}

}