<definition>
	<command name="checkAgree">
		<execute function="Check" locator1="MPRegistrationCompany#AGREE_CHECKBOX" />
	</command>

	<command name="paypalAccountForm">
		<execute function="Type" locator1="MPRegistrationCompany#FIRST_NAME_FIELD" value1="${paypalFirstName}" />
		<execute function="Type" locator1="MPRegistrationCompany#LAST_NAME_FIELD" value1="${paypalLastName}" />
		<execute function="Type" locator1="MPRegistrationCompany#PAYMENT_EMAIL_FIELD" value1="${paypalEmailAddress}" />
	</command>

	<command name="registerCompanyForm">
		<execute function="UploadCommonFile" locator1="MPRegistrationCompany#LOGO_BUTTON" value1="${companyIcon}" />
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_NAME_FIELD" value1="${companyName}" />
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD" value1="${companyDescription}" />
		<execute function="Type" locator1="MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1" value1="${companyAddress}" />
		<execute function="Select" locator1="MPRegistrationCompany#COUNTRY_SELECT" value1="${companyCountry}" />
		<execute function="Select" locator1="MPRegistrationCompany#REGION_SELECT" value1="${companyRegion}" />
		<execute function="Type" locator1="MPRegistrationCompany#CITY_FIELD" value1="${companyCity}" />
		<execute function="Type" locator1="MPRegistrationCompany#POSTAL_CODE_FIELD" value1="${companyPostalCode}" />
		<execute function="Type" locator1="MPRegistrationCompany#PHONE_FIELD" value1="${companyPhone}" />
		<execute function="Type" locator1="MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD" value1="${companyEmail}" />
		<execute function="UploadCommonFile" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON" value1="${companyTaxDocument}" />
		<execute function="Select" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT" value1="${companyTaxType}" />
		<execute function="Check" locator1="MPRegistrationCompany#AGREE_CHECKBOX" />
	</command>

	<command name="registerIndividualDeveloperForm">
		<execute function="Select" locator1="MPRegistrationDeveloper#COUNTRY_FIELD" value1="${developerCountry}" />
		<execute function="Type" locator1="MPRegistrationDeveloper#PHONE_NUMBER_FIELD" value1="${developerPhone}" />
		<execute function="Click#clickAt" locator1="MPRegistrationDeveloper#TERMS_OF_AGREEMENT" />
		<execute function="KeyPress" locator1="MPRegistrationDeveloper#TERMS_OF_AGREEMENT" value1="\END" />
		<execute function="Check" locator1="MPRegistrationDeveloper#TERMS_OF_AGREEMENT_CHECKBOX" />
	</command>

	<command name="registerPaidDeveloperForm">
		<execute function="UploadCommonFile" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON" value1="${developerTaxDocument}" />
		<execute function="Select" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT" value1="${developerTaxType}" />
		<execute function="Type" locator1="MPRegistrationCompany#FIRST_NAME_FIELD" value1="${developerFirstName}" />
		<execute function="Type" locator1="MPRegistrationCompany#MIDDLE_NAME_FIELD" value1="${developerMiddleName}" />
		<execute function="Type" locator1="MPRegistrationCompany#LAST_NAME_FIELD" value1="${developerLastName}" />
		<execute function="Type" locator1="MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1" value1="${developerAddress}" />
		<execute function="Select" locator1="MPRegistrationCompany#COUNTRY_SELECT" value1="${developerCountry}" />
		<execute function="Select" locator1="MPRegistrationCompany#REGION_SELECT" value1="${developerRegion}" />
		<execute function="Type" locator1="MPRegistrationCompany#CITY_FIELD" value1="${developerCity}" />
		<execute function="Type" locator1="MPRegistrationCompany#POSTAL_CODE_FIELD" value1="${developerPostalCode}" />
	</command>

	<command name="selectCountry">
		<execute function="Select" locator1="MPRegistrationCompany#COUNTRY_SELECT" value1="${companyCountry}" />
	</command>

	<command name="selectRegion">
		<execute function="Select" locator1="MPRegistrationCompany#REGION_SELECT" value1="${companyRegion}" />
	</command>

	<command name="selectTaxDocumentType">
		<execute function="Select" locator1="MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT" value1="${companyTaxType}" />
	</command>

	<command name="typeAddressLine1">
		<execute function="Type" locator1="MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1" value1="${companyAddress}" />
	</command>

	<command name="typeCity">
		<execute function="Type" locator1="MPRegistrationCompany#CITY_FIELD" value1="${companyCity}" />
	</command>

	<command name="typeCompanyDescription">
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD" value1="${companyDescription}" />
	</command>

	<command name="typeCompanyEmail">
		<execute function="Type" locator1="MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD" value1="${companyEmail}" />
	</command>

	<command name="typeCompanyName">
		<execute function="Type" locator1="MPRegistrationCompany#COMPANY_NAME_FIELD" value1="${companyName}" />
	</command>

	<command name="typeFirstName">
		<execute function="Type" locator1="MPRegistrationCompany#FIRST_NAME_FIELD" value1="${firstName}" />
	</command>

	<command name="typeLastName">
		<execute function="Type" locator1="MPRegistrationCompany#LAST_NAME_FIELD" value1="${lastName}" />
	</command>

	<command name="typeMiddleName">
		<execute function="Type" locator1="MPRegistrationCompany#MIDDLE_NAME_FIELD" value1="${middleName}" />
	</command>

	<command name="typePaymentEmail">
		<execute function="Type" locator1="MPRegistrationCompany#PAYMENT_EMAIL_FIELD" value1="${paymentEmailAddress}" />
	</command>

	<command name="typePhone">
		<execute function="Type" locator1="MPRegistrationCompany#PHONE_FIELD" value1="${companyPhone}" />
	</command>

	<command name="typePostalCode">
		<execute function="Type" locator1="MPRegistrationCompany#POSTAL_CODE_FIELD" value1="${companyPostalCode}" />
	</command>
</definition>