definition {

	macro checkAgree {
		Check(locator1 = "MPRegistrationCompany#AGREE_CHECKBOX");
	}

	macro paypalAccountForm {
		Type(
			locator1 = "MPRegistrationCompany#FIRST_NAME_FIELD",
			value1 = "${paypalFirstName}");

		Type(
			locator1 = "MPRegistrationCompany#LAST_NAME_FIELD",
			value1 = "${paypalLastName}");

		Type(
			locator1 = "MPRegistrationCompany#PAYMENT_EMAIL_FIELD",
			value1 = "${paypalEmailAddress}");
	}

	macro registerCompanyForm {
		UploadCommonFile(
			locator1 = "MPRegistrationCompany#LOGO_BUTTON",
			value1 = "${companyIcon}");

		Type(
			locator1 = "MPRegistrationCompany#COMPANY_NAME_FIELD",
			value1 = "${companyName}");

		Type(
			locator1 = "MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD",
			value1 = "${companyDescription}");

		Type(
			locator1 = "MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1",
			value1 = "${companyAddress}");

		Select(
			locator1 = "MPRegistrationCompany#COUNTRY_SELECT",
			value1 = "${companyCountry}");

		Select(
			locator1 = "MPRegistrationCompany#REGION_SELECT",
			value1 = "${companyRegion}");

		Type(
			locator1 = "MPRegistrationCompany#CITY_FIELD",
			value1 = "${companyCity}");

		Type(
			locator1 = "MPRegistrationCompany#POSTAL_CODE_FIELD",
			value1 = "${companyPostalCode}");

		Type(
			locator1 = "MPRegistrationCompany#PHONE_FIELD",
			value1 = "${companyPhone}");

		Type(
			locator1 = "MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD",
			value1 = "${companyEmail}");

		UploadCommonFile(
			locator1 = "MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON",
			value1 = "${companyTaxDocument}");

		Select(
			locator1 = "MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT",
			value1 = "${companyTaxType}");

		Check(locator1 = "MPRegistrationCompany#AGREE_CHECKBOX");
	}

	macro registerIndividualDeveloperForm {
		Select(
			locator1 = "MPRegistrationDeveloper#COUNTRY_FIELD",
			value1 = "${developerCountry}");

		Type(
			locator1 = "MPRegistrationDeveloper#PHONE_NUMBER_FIELD",
			value1 = "${developerPhone}");

		Click.clickAt(locator1 = "MPRegistrationDeveloper#TERMS_OF_AGREEMENT");

		KeyPress(
			locator1 = "MPRegistrationDeveloper#TERMS_OF_AGREEMENT",
			value1 = "\END");

		Check(locator1 = "MPRegistrationDeveloper#TERMS_OF_AGREEMENT_CHECKBOX");
	}

	macro registerPaidDeveloperForm {
		UploadCommonFile(
			locator1 = "MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_BUTTON",
			value1 = "${developerTaxDocument}");

		Select(
			locator1 = "MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT",
			value1 = "${developerTaxType}");

		Type(
			locator1 = "MPRegistrationCompany#FIRST_NAME_FIELD",
			value1 = "${developerFirstName}");

		Type(
			locator1 = "MPRegistrationCompany#MIDDLE_NAME_FIELD",
			value1 = "${developerMiddleName}");

		Type(
			locator1 = "MPRegistrationCompany#LAST_NAME_FIELD",
			value1 = "${developerLastName}");

		Type(
			locator1 = "MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1",
			value1 = "${developerAddress}");

		Select(
			locator1 = "MPRegistrationCompany#COUNTRY_SELECT",
			value1 = "${developerCountry}");

		Select(
			locator1 = "MPRegistrationCompany#REGION_SELECT",
			value1 = "${developerRegion}");

		Type(
			locator1 = "MPRegistrationCompany#CITY_FIELD",
			value1 = "${developerCity}");

		Type(
			locator1 = "MPRegistrationCompany#POSTAL_CODE_FIELD",
			value1 = "${developerPostalCode}");
	}

	macro selectCountry {
		Select(
			locator1 = "MPRegistrationCompany#COUNTRY_SELECT",
			value1 = "${companyCountry}");
	}

	macro selectRegion {
		Select(
			locator1 = "MPRegistrationCompany#REGION_SELECT",
			value1 = "${companyRegion}");
	}

	macro selectTaxDocumentType {
		Select(
			locator1 = "MPRegistrationCompany#VALIDATION_TAX_DOCUMENT_TYPE_SELECT",
			value1 = "${companyTaxType}");
	}

	macro typeAddressLine1 {
		Type(
			locator1 = "MPRegistrationCompany#HEADQUARTERS_ADDRESS_LINE_1",
			value1 = "${companyAddress}");
	}

	macro typeCity {
		Type(
			locator1 = "MPRegistrationCompany#CITY_FIELD",
			value1 = "${companyCity}");
	}

	macro typeCompanyDescription {
		Type(
			locator1 = "MPRegistrationCompany#COMPANY_DESCRIPTION_FIELD",
			value1 = "${companyDescription}");
	}

	macro typeCompanyEmail {
		Type(
			locator1 = "MPRegistrationCompany#VALIDATION_COMPANY_EMAIL_FIELD",
			value1 = "${companyEmail}");
	}

	macro typeCompanyName {
		Type(
			locator1 = "MPRegistrationCompany#COMPANY_NAME_FIELD",
			value1 = "${companyName}");
	}

	macro typeFirstName {
		Type(
			locator1 = "MPRegistrationCompany#FIRST_NAME_FIELD",
			value1 = "${firstName}");
	}

	macro typeLastName {
		Type(
			locator1 = "MPRegistrationCompany#LAST_NAME_FIELD",
			value1 = "${lastName}");
	}

	macro typeMiddleName {
		Type(
			locator1 = "MPRegistrationCompany#MIDDLE_NAME_FIELD",
			value1 = "${middleName}");
	}

	macro typePaymentEmail {
		Type(
			locator1 = "MPRegistrationCompany#PAYMENT_EMAIL_FIELD",
			value1 = "${paymentEmailAddress}");
	}

	macro typePhone {
		Type(
			locator1 = "MPRegistrationCompany#PHONE_FIELD",
			value1 = "${companyPhone}");
	}

	macro typePostalCode {
		Type(
			locator1 = "MPRegistrationCompany#POSTAL_CODE_FIELD",
			value1 = "${companyPostalCode}");
	}

}