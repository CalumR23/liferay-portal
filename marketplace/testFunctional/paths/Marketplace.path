<html>
<head>
<title>Marketplace</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Marketplace</td></tr>
</thead>

<tbody>
<tr>
	<td>CHECKBOX_FILTER</td>
	<td>xpath=(//input[contains(@type,'checkbox')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_IMAGE</td>
	<td>xpath=(//div[contains(@class,'image-container')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>CARD_LINK</td>
	<td>xpath=(//a[contains(@class,'search-results-card')])[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_1</td>
	<td>//*[contains(@class,'alert-danger')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_MESSAGE_2</td>
	<td>//*[contains(@class,'portlet-msg-error')]</td>
	<td></td>
</tr>
<tr>
	<td>ERROR_BLOCK</td>
	<td>//div[contains(@class,'block error')]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_LINK</td>
	<td>xpath=(//h4[contains(@class,'nav-item-header')]/following-sibling::ul//a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>FOOTER_SOCIAL_MEDIA_LINK</td>
	<td>xpath=(//div[contains(@class,'social-nav')]//li/a)[${key_positionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM</td>
	<td>xpath=(//*[contains(@class,'mktoForm')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_INPUT_FIELD</td>
	<td>xpath=(//input[contains(@class,'mktoRequired')])[${key_inputPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_SELECT_FIELD</td>
	<td>xpath=(//select[contains(@class,'mktoField')])[${key_selectPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_SUBMIT_BUTTON</td>
	<td>//*[contains(@class,'mktoButton') and contains(@type,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>MARKETING_FORM_TEXT_AREA</td>
	<td>xpath=(//textarea[contains(@class,'mktoField')])[${key_textAreaPositionValue}]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_1</td>
	<td>//h1[contains(.,'Sorry, this page does not exist.')]</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_DOES_NOT_EXIST_MESSAGE_2</td>
	<td>//h2[contains(.,"This page doesn't exist!")]</td>
	<td></td>
</tr>
<tr>
    <td>PAGE_LINK</td>
    <td>xpath=(//div[contains(@class,'pt-md-5')]/div[contains(@class,'align-items-start')]//a)[${key_positionValue}]</td>
    <td></td>
</tr>
<tr>
	<td>REQUEST_A_LIVE_DEMO_FOOTER_ROW</td>
	<td>//div[contains(@class,'fixed-footer-row')]</td>
	<td></td>
</tr>

<!--PAGINATION-->

<tr>
	<td>FIRST_LINK</td>
	<td>xpath=(//ul//a[contains(@class,'page-link')]/span[contains(@class,'sr-only')])[1]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK</td>
	<td>//li/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td>NEXT_LINK_DISABLED</td>
	<td>//li[contains(@class,'disabled')]/a[contains(.,'Next')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>