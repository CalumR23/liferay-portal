<html>
<head>
<title>Marketplace</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Marketplace</td></tr>
</thead>

<tbody>
<tr>
	<td>MARKETPLACE_BANNER</td>
	<td>//a[contains(@class,'banner')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_FIELD</td>
	<td>//input[contains(@id,'keywords')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEGORY_MENU</td>
	<td>//select[contains(@id,'CategoryId')]</td>
	<td></td>
</tr>
<tr>
	<td>PORTAL_VERSION_MENU</td>
	<td>//select[contains(@id,'buildNumber')]</td>
	<td></td>
</tr>
<tr>
	<td>PRICE_MENU</td>
	<td>//select[contains(@id,'licenseType')]</td>
	<td></td>
</tr>
<tr>
	<td>SEARCH_BUTTON</td>
	<td>//input[contains(@class,'submit')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_CATEGORY</td>
	<td>//h2[contains(.,'${key_appCategory}')]</td>
	<td></td>
</tr>
<tr>
	<td>APP_TITLE</td>
	<td>//a[@title='${key_appTitle}']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>