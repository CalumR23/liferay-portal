<html>
<head>
<title>MPNavigation</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MPNavigation</td></tr>
</thead>

<tbody>

<!--Marketplace Navigation Bar-->

<tr>
	<td>MARKETPLACE</td>
	<td>//div[contains(@class,'banner')]//a[contains(@title,'liferay-marketplace')]</td>
	<td></td>
</tr>
<tr>
	<td>LIFERAY</td>
	<td>//div[contains(@class,'banner')]//img[contains(@alt,'Liferay')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU</td>
	<td>//div[contains(@class,'banner')]//div[contains(@class,'class-toggle-off-click menu-navigation')]|//div[contains(@id,'mainMenu')]</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MENU_SIGN_IN</td>
	<td>//div[contains(@class,'banner')]//a[.='Sign In']</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_REGISTER</td>
	<td>//div[contains(@class,'banner')]//li[contains(@class,'register')]/a</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPERS</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Developers')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPERS_SUBMENU</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Developers')]/../ul/li/a[contains(.,'${key_devSubmenuItem}')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPERS_BECOME_A_DEVELOPER</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Become a Developer')]</td>
	<td></td>
</tr>

<!--Categories Menu-->

<tr>
	<td>CATEGORIES</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Categories')]</td>
	<td></td>
</tr>
<tr>
	<td>CATEORIES_SUBCATEGORY</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'${key_categoryType}')]</td>
	<td></td>
</tr>

<!--Overview-->

<tr>
	<td>OVERVIEW</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Overview')]</td>
	<td></td>
</tr>
<tr>
	<td>OVERVIEW_GETTING_STARTED</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Getting Started')]</td>
	<td></td>
</tr>
<tr>
	<td>OVERVIEW_USER_GUIDE</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'User Guide')]</td>
	<td></td>
</tr>
<tr>
	<td>OVERVIEW_COMMUNITY_FORUM</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Community Forum')]</td>
	<td></td>
</tr>

<!--Marketplace Navigation Menu-->

<tr>
	<td>CONTROL_PANEL</td>
	<td>//div[contains(@class,'banner')]//a[.='Control Panel']</td>
	<td></td>
</tr>
<tr>
	<td>ACCOUNT_HOME</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Account Home')]</td>
	<td></td>
</tr>
<tr>
	<td>PURCHASED_APPS</td>
	<td>//div[contains(@class,'banner')]//a[contains(.,'Purchased Apps')]</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_SITE</td>
	<td>//div[contains(@class,'banner')]//a[.='${key_companyName}']</td>
	<td></td>
</tr>
<tr>
	<td>SIGN_OUT</td>
	<td>//div[contains(@class,'banner')]//a[.='Sign Out']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>