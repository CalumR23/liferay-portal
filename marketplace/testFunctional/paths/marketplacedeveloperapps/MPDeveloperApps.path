<html>
<head>
<title>MPDeveloperApps</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MPDeveloperApps</td></tr>
</thead>

<tbody>

<!--Main-->

<tr>
	<td>APP_TITLE_LINK</td>
	<td>//a[contains(@href,'developer-apps') and .=' ${key_appTitle} ']</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_APP_TITLE</td>
	<td>//div[@class='summary container']/div/div/ul/li/a</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_COMPANY_NAME</td>
	<td>//div[@class='summary container']/div/div/ul/li[2]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_TYPE</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_CATEGORY</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_STATUS</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_LICENSE</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[4]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_SUPPORT</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[5]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_TRIAL</td>
	<td>//div[@class='summary container']/table/tbody/tr/td[6]</td>
	<td></td>
</tr>
<tr>
	<td>SUMMARY_UPLOADED_FILES</td>
	<td>//span[@class='liferay-version' and contains(.,'${key_portalVersionName}')]/../div//td[contains(@class,'file-name')]</td>
	<td></td>
</tr>

<!--App View-->

<tr>
	<td>PREVIEW_TAB</td>
	<td>//div/a[contains(.,'App Preview')]</td>
	<td></td>
</tr>
<tr>
	<td>PRICING_TAB</td>
	<td>//div/a[contains(.,'App Pricing')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_TAB</td>
	<td>//nav[@class='tab-nav']//a[contains(.,'Developer')]</td>
	<td></td>
</tr>

<!--App Preview-->

<tr>
	<td>APP_TITLE</td>
	<td>//div[@class='app-heading']/div[@class='title']/h1</td>
	<td></td>
</tr>
<tr>
	<td>COMPANY_NAME</td>
	<td>//div[@class='app-heading']/div[@class='title']/div[@class='owner']/a</td>
	<td></td>
</tr>
<tr>
	<td>DESCRIPTION</td>
	<td>//div[contains(@class,'description')]</td>
	<td></td>
</tr>
<tr>
	<td>LATEST_CHANGES</td>
	<td>//div[contains(@class,'panel-content')]</td>
	<td></td>
</tr>
<tr>
	<td>LATEST_CHANGES_COLLAPSED</td>
	<td>//div[contains(@class,'lfr-collapsible lfr-panel-basic lfr-collapsed')]/div</td>
	<td></td>
</tr>
<tr>
	<td>TAGS</td>
	<td>//div[contains(@class,'tags-summary')]/a[${key_TagNum}]</td>
	<td></td>
</tr>

<!-- Developer Tab -->

<tr>
	<td>DOWNLOAD_PACKAGE_VERSION_LINK</td>
	<td>//td[contains(@class,'version-number') and contains(.,'${key_versionNumber}')]/../td//a[contains(.,'${key_portalVersionName}')]</td>
	<td></td>
</tr>

<!--App Preview - Sidebar-->

<tr>
	<td>VERSION</td>
	<td>//li[contains(.,'Latest Version')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_WEBSITE_URL</td>
	<td>//div[contains(@class,'developer-website')]/a[@href='${key_developerWebsiteUrl}']</td>
	<td></td>
</tr>
<tr>
	<td>DOCUMENTATION_WEBSITE_URL</td>
	<td>//div[contains(@class,'documentation-website')]/a[@href='${key_documentationUrl}']</td>
	<td></td>
</tr>
<tr>
	<td>SUPPORT_URL</td>
	<td>//div[contains(@class,'support')]/a[@href='${key_supportUrl}']</td>
	<td></td>
</tr>
<tr>
	<td>SOURCE_CODE_URL</td>
	<td>//div[contains(@class,'source-code')]/a[@href='${key_sourceCodeUrl}']</td>
	<td></td>
</tr>
<tr>
	<td>CURRENT_REQUIREMENTS</td>
	<td>//ul[contains(@class,'requirements')]/li[${key_requirementNum}]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_PRICING_LICENSE</td>
	<td>//ul[4]/li[${key_licenseNum}]/span[contains(@class,'license')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_PRICING_PRICE</td>
	<td>//ul[4]/li[${key_licenseNum}]/span[contains(@class,'price')]</td>
	<td></td>
</tr>
<tr>
	<td>STANDARD_SUBSCRIPTION</td>
	<td>//ul[4]/li/span[.='Subscription Services']/../span[contains(@class,'price')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_PRICING_LICENSE</td>
	<td>//ul[5]/li[${key_licenseNum}]/span[contains(@class,'license')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_PRICING_PRICE</td>
	<td>//ul[5]/li[${key_licenseNum}]/span[contains(@class,'price')]</td>
	<td></td>
</tr>
<tr>
	<td>DEVELOPER_SUBSCRIPTION</td>
	<td>//ul[5]/li/span[.='Subscription Services']/../span[contains(@class,'price')]</td>
	<td></td>
</tr>

<!--App Pricing-->

<tr>
	<td>APP_PRICING_TABLE_NAME</td>
	<td>//div[.=' ${key_tableTitle} ']</td>
	<td></td>
</tr>
<tr>
	<td>APP_PRICING_LICENSES</td>
	<td>//div[.=' ${key_tableTitle} ']/../div/div[contains(@class,'${key_licenseType}')]/div[contains(@class,'${key_license}')]/div[.=' ${key_value} ']</td>
	<td></td>
</tr>
<tr>
	<td>APP_PRICING_COUNTRY</td>
	<td>//div[.=' ${key_tableTitle} ']/../div/div/div[contains(@class,'countries')]/ul/li[.='${key_country}']</td>
	<td></td>
</tr>

<!--App Controls-->

<tr>
	<td>EDIT_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Edit')]</td>
	<td></td>
</tr>
<tr>
	<td>UPDATE_PRICING_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Update Pricing')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_NEW_VERSION_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Add New Version')]</td>
	<td></td>
</tr>
<tr>
	<td>SUBMIT_FOR_REVIEW_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/span/span/input[contains(@value,'Submit for Review')]</td>
	<td></td>
</tr>
<tr>
	<td>REMOVE_FROM_STORE_BUTTON</td>
	<td>//div[contains(@class,'aui-button-holder container')]/div/a[contains(.,'Remove from Store')]</td>
	<td></td>
</tr>
<tr>
	<td>DISCARD_CHANGES</td>
	<td>//a[contains(.,'Discard Changes')]</td>
	<td></td>
</tr>
<tr>
	<td>CANCEL_SUBMISSION</td>
	<td>//input[contains(@value,'Cancel Submission')]</td>
	<td></td>
</tr>
<tr>
	<td>NOTE_TO_REVIEWER</td>
	<td>//textarea[contains(@id,'statusMessage')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>