<definition component-name="marketplace">
	<property name="testray.main.component.name" value="MarketplaceRegistration" />

	<var name="companyNameStatic" static="true" value="" />
	<var name="marketplaceRegisterDeveloperURL" static="true" value="" />
	<var name="marketplaceURL" static="true" value="" />

	<set-up>
		<var method="PropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />
		<var method="StringUtil#randomString(5)" name="rndString" />

		<var name="companyNameStatic" value="QA.Company.${rndString}" />
		<var name="marketplaceRegisterDeveloperURL" value="${marketplaceURL}/become-a-developer" />

		<execute macro="MPUser#logoutAndLogin">
			<var method="PropsUtil#get('marketplace.email.address.6')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.6')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />
		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

		<execute macro="MarketplaceRegistration#registerNewCompany">
			<var name="companyAddress" value="123 A St" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var method="PropsUtil#get('marketplace.email.address.6')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
			<var name="key_companyName" value="${companyNameStatic}" />
		</execute>
	</set-up>

	<tear-down>
		<execute macro="MPUser#logoutAndLogin">
			<var method="PropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdmin#teardownCompany">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MPUser#logout" />
	</tear-down>

	<command name="DenyCompany" priority="5">
		<execute macro="MPUser#logoutAndLogin">
			<var method="PropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceAdmin#denySubmission" />

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPAdminDevelopers#DEVELOPER_STATUS" value1="Denied" />
	</command>

	<command name="DisableCompany" priority="5">
		<execute macro="MPUser#logoutAndLogin">
			<var method="PropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdmin#workflowCompanyApprove">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceAdmin#disableCompany" />

		<execute macro="MarketplaceAdminNavigator#gotoDeveloper">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPAdminDevelopers#DEVELOPER_STATUS" value1="Expired" />
	</command>
</definition>