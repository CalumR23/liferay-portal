@component-name = "marketplace"
definition {

	property testray.main.component.name = "MarketplaceRegistration";

	static var companyNameStatic = "";
	static var marketplaceRegisterDeveloperURL = "";
	static var marketplaceURL = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");
		var rndString = StringUtil.randomString("5");

		var companyNameStatic = "QA.Company.${rndString}";
		var marketplaceRegisterDeveloperURL = "${marketplaceURL}/become-a-developer";

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.6"),
			userPassword = PropsUtil.get("marketplace.email.password.6"));

		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		MarketplaceRegistration.registerNewCompany(
			companyAddress = "123 A St",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test.",
			companyEmail = PropsUtil.get("marketplace.email.address.6"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other",
			key_companyName = "${companyNameStatic}");
	}

	tearDown {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdmin.teardownCompany(companyName = "${companyNameStatic}");

		MPUser.logout();
	}

	@priority = "5"
	test DenyCompany {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyNameStatic}");

		MarketplaceAdmin.denySubmission();

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyNameStatic}");

		AssertTextEquals(
			locator1 = "MPAdminDevelopers#DEVELOPER_STATUS",
			value1 = "Denied");
	}

	@priority = "5"
	test DisableCompany {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdmin.workflowCompanyApprove(companyName = "${companyNameStatic}");

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyNameStatic}");

		MarketplaceAdmin.disableCompany();

		MarketplaceAdminNavigator.gotoDeveloper(companyName = "${companyNameStatic}");

		AssertTextEquals(
			locator1 = "MPAdminDevelopers#DEVELOPER_STATUS",
			value1 = "Expired");
	}

}