			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchasePaidApp(
			destinationAddressName = "QA.buy.project",
			developerLicenseQuantityList = "1",
			invoiceEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			legalEntityName = "QA.buy.project",
			licensePurchaseType = "renew",
			paymentMethod = "Invoice Me",
			projectName = "QA.buy.project",
			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");
	}

