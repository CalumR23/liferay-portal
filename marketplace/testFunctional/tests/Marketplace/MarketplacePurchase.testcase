@component-name = "marketplace"
definition {

	property testray.main.component.name = "Marketplace";

	static var appTitleStatic = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.1"),
			userPassword = PropsUtil.get("marketplace.email.password.1"));

		Open(locator1 = "${marketplaceURL}");
	}

	tearDown {
		while (IsElementPresent(locator1 = "MPButton#CANCEL_BUTTON")) {
			MPButton.cancel();
		}

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.1"),
			userPassword = PropsUtil.get("marketplace.email.password.1"));

		Account.tearDownSubmittedApp(
			appTitleList = "${appTitleStatic}",
			companyNameList = "Account Home");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		Marketplace.tearDownPurchase(appTitle = "${appTitleStatic}");

		MPUser.logout();
	}

	@priority = "5"
	test PurchaseFreeAppViaProject {
		var appTitleStatic = "QA.Buy.F";
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		Account.setupAndSubmitApp(
			appCategory = "index=3",
			appDescription = "Free License",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			companyName = "Account Home",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			doApprove = "true",
			isFreePaid = "free",
			isTrial = "true",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchaseFreeApp(
			legalEntityName = "QA.buy.project",
			projectName = "QA.buy.project");

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");
	}

	@priority = "5"
	test PurchasePaidAppAndAddAdditionalUnitsViaProject {
		var appTitleStatic = "QA.Buy.PT";
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		Account.setupAndSubmitApp(
			addCountryList = "all",
			appCategory = "index=3",
			appDescription = "Paid License, Trial",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			companyName = "Account Home",
			currency = "USD",
			developerLicensePriceList = "10.00",
			developerLicenseUnitsList = "1",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			doApprove = "true",
			isFreePaid = "paid-license",
			isTrial = "true",
			licenseTerm = "Perpetual",
			standardLicensePriceList = "10.00",
			standardLicenseUnitsList = "1",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchasePaidApp(
			destinationAddressName = "QA.buy.project",
			developerLicenseQuantityList = "1",
			invoiceEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			legalEntityName = "QA.buy.project",
			paymentMethod = "Invoice Me",
			projectName = "QA.buy.project",
			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchasePaidApp(
			destinationAddressName = "QA.buy.project",
			developerLicenseQuantityList = "1",
			invoiceEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			legalEntityName = "QA.buy.project",
			licensePurchaseType = "add",
			paymentMethod = "Invoice Me",
			projectName = "QA.buy.project",
			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");
	}

	@priority = "5"
	test PurchasePaidAppAndRenewExistingLicensesViaProject {
		var appTitleStatic = "QA.Buy.NT";
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		Account.setupAndSubmitApp(
			addCountryList = "all",
			appCategory = "index=3",
			appDescription = "Non-Perpetual License, Trial.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			companyName = "Account Home",
			currency = "USD",
			developerLicensePriceList = "10.00",
			developerLicenseUnitsList = "1",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			doApprove = "true",
			isFreePaid = "paid-license",
			isTrial = "true",
			licenseTerm = "Non-Perpetual",
			standardLicensePriceList = "10.00",
			standardLicenseUnitsList = "1",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchasePaidApp(
			destinationAddressName = "QA.buy.project",
			developerLicenseQuantityList = "1",
			invoiceEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			legalEntityName = "QA.buy.project",
			paymentMethod = "Invoice Me",
			projectName = "QA.buy.project",
			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigator.searchForApp(appTitle = "${appTitleStatic}");

		Marketplace.purchasePaidApp(
			changeRenewLicenseQuantities = "true",
			destinationAddressName = "QA.buy.project",
			developerLicenseQuantityList = "1",
			invoiceEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			legalEntityName = "QA.buy.project",
			licensePurchaseType = "renew",
			paymentMethod = "Invoice Me",
			projectName = "QA.buy.project",
			standardLicenseQuantityList = "1");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		AccountNavigator.gotoUserAppViaProjects(
			appTitle = "${appTitleStatic}",
			projectName = "QA.buy.project");
	}

	@priority = "5"
	test PurchasePaidAppAndRenewExistingSubscriptionsViaProject {
