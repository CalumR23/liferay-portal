		</execute>

		<execute macro="Marketplace#purchaseTrialApp">
			<var name="legalEntityName" value="QA.buy.project" />
			<var name="projectName" value="QA.buy.project" />
		</execute>

		<execute macro="AccountNavigator#gotoUserAppViaProjects">
			<var name="appTitle" value="${appTitleStatic}" />
			<var name="projectName" value="QA.buy.project" />
		</execute>
	</command>
</definition>