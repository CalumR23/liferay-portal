@component-name = "marketplace"
definition {

	property testray.main.component.name = "MarketplaceRegistration";

	static var companyNameStatic = "";
	static var marketplaceRegisterDeveloperURL = "";
	static var marketplaceURL = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");
		var rndString = StringUtil.randomString("5");

		var companyNameStatic = "QA.Company.${rndString}";
		var marketplaceRegisterDeveloperURL = "${marketplaceURL}/become-a-developer";

		MPUser.login(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceURL}");
	}

	tearDown {
		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		Open(locator1 = "${marketplaceURL}");

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdminNavigator.gotoAdminTab(adminTab = "Developers");

		MarketplaceAdmin.teardownCompany(companyName = "${companyNameStatic}");

		Open(locator1 = "${marketplaceURL}");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		MarketplaceRegistration.tearDownJoinCompany(
			companyName = "${companyNameStatic}",
			userEmailAddress = PropsUtil.get("marketplace.email.address.1"));

		MPUser.logout();
	}

	@priority = "5"
	test EditSubmission {
		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		MarketplaceRegistration.registerNewCompany(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a company description.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		AssertTextPresent(
			locator1 = "MPRegistration#PENDING_REGISTRATIONS",
			value1 = "Pending Registrations");

		MarketplaceRegistration.editCompany(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is an edited company description.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California");

		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		AssertTextPresent(
			locator1 = "MPRegistration#PENDING_REGISTRATIONS",
			value1 = "Pending Registrations");

		MarketplaceRegistration.viewCompanyProfile(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is an edited company description.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California");
	}

	@priority = "5"
	test JoinCompany {
		MarketplaceRegistration.setupCompany(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test for joining a company.",
			companyEmail = PropsUtil.get("marketplace.email.address.1"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.1"),
			userPassword = PropsUtil.get("marketplace.email.password.1"));

		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		MarketplaceRegistration.searchForCompany(companyName = "${companyNameStatic}");

		MarketplaceRegistration.requestJoinCompany(companyName = "${companyNameStatic}");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyNameStatic}");

		MarketplaceRegistration.confirmMembershipRequest(userEmailAddress = PropsUtil.get("marketplace.email.address.1"));
	}

	@priority = "5"
	test RegisterCompanyPaid {
		MarketplaceRegistration.setupCompany(
			companyAddress = "123 A St",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Account.setupAcceptDeveloperTermsOfService(companyName = "${companyNameStatic}");

		MarketplaceNavigationBar.gotoCompanyAccount(companyName = "${companyNameStatic}");

		AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");

		MPButton.addNewApp();

		MarketplaceRegistration.convertToPaidDeveloperAccount(
			companyName = "${companyNameStatic}",
			userEmailAddress = PropsUtil.get("marketplace.email.address.3"));
	}

	@priority = "5"
	test RegisterDuplicateCompany {
		MarketplaceRegistration.setupCompany(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test to create a duplicate company.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		Click(locator1 = "MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON");

		Click(locator1 = "MPRegistrationCompany#REGISTER_BUTTON");

		MarketplaceRegistrationEntry.registerCompanyForm(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test to create a duplicate company.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		ScrollWebElementIntoView(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		Click(locator1 = "MPRegistrationCompany#SUBMIT_REQUEST");

		AssertTextEquals(
			locator1 = "MPMessage#FAIL_MESSAGE",
			value1 = "Your request failed to complete.");

		AssertTextEquals(
			locator1 = "MPRegistrationCompany#DUPLICATE_COMPANY_ERROR_MESSAGE",
			value1 = "Your company is already registered.");
	}

	@priority = "5"
	test RegisterNewCompany {
		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		MarketplaceRegistration.searchForCompany(companyName = "${companyNameStatic}");

		MarketplaceRegistration.registerNewCompany(
			companyAddress = "123 A St",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");
	}

	@priority = "5"
	test RegisterPaidCompanyCancel {
		MarketplaceRegistration.setupCompany(
			companyAddress = "123 Main Street",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test.",
			companyEmail = PropsUtil.get("marketplace.email.address.2"),
			companyIcon = "Document_3.png",
			companyName = "${companyNameStatic}",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Account.setupAcceptDeveloperTermsOfService(companyName = "${companyNameStatic}");

		Click(locator1 = "MPButton#ADD_NEW_APP_BUTTON");

		Click(locator1 = "MPDeveloperAppsAddDetails#UPGRADE");

		MPButton.button1(buttonName = "Enroll Now");

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Upload the required tax form and confirm your contact information to receive payments.");

		MarketplaceRegistrationEntry.registerPaidDeveloperForm(
			companyName = "${companyNameStatic}",
			developerAddress = "123 A St",
			developerCity = "Los Angeles",
			developerCountry = "United States",
			developerFirstName = "LiferayQA1",
			developerLastName = "Marketplace",
			developerMiddleName = "Test",
			developerPostalCode = "90210",
			developerRegion = "California",
			developerTaxDocument = "Document_1.pdf",
			developerTaxType = "Other");

		MPButton.next();

		MPMessage.success();

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Confirm or create a PayPal account to receive payments.");

		MPButton.next();

		MPMessage.requestFailed();

		Click(locator1 = "MPRegistrationDeveloper#BACK_BUTTON");

		AssertTextEquals(
			locator1 = "MPDeveloperAppsAdd#DETAILS",
			value1 = "App Details");

		Click(locator1 = "MPDeveloperAppsAddDetails#UPGRADE");

		MPButton.button1(buttonName = "Enroll Now");

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Upload the required tax form and confirm your contact information to receive payments.");

		MarketplaceRegistrationEntry.registerPaidDeveloperForm(
			companyName = "${companyNameStatic}",
			developerAddress = "123 A St",
			developerCity = "Los Angeles",
			developerCountry = "United States",
			developerFirstName = "LiferayQA1",
			developerLastName = "Marketplace",
			developerMiddleName = "Test",
			developerPostalCode = "90210",
			developerRegion = "California",
			developerTaxDocument = "Document_1.pdf",
			developerTaxType = "Other");

		MPButton.next();

		MPMessage.success();

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Confirm or create a PayPal account to receive payments.");

		MarketplaceRegistrationEntry.paypalAccountForm(
			paypalEmailAddress = PropsUtil.get("marketplace.email.address.3"),
			paypalFirstName = "Joe",
			paypalLastName = "WrongName");

		MPButton.next();

		MPMessage.requestFailed();

		MPButton.button1(buttonName = "Back");

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Upload the required tax form and confirm your contact information to receive payments.");

		MarketplaceRegistrationEntry.registerPaidDeveloperForm(
			companyName = "${companyNameStatic}",
			developerAddress = "123 A St",
			developerCity = "Los Angeles",
			developerCountry = "United States",
			developerFirstName = "LiferayQA1",
			developerLastName = "Marketplace",
			developerMiddleName = "Test",
			developerPostalCode = "90210",
			developerRegion = "California",
			developerTaxDocument = "Document_1.pdf",
			developerTaxType = "Other");

		MPButton.next();

		MPMessage.success();

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Confirm or create a PayPal account to receive payments.");

		MarketplaceRegistrationEntry.paypalAccountForm(
			paypalEmailAddress = PropsUtil.get("marketplace.email.address.3"),
			paypalFirstName = "Joe",
			paypalLastName = "Bloggs");

		MPButton.next();

		MPMessage.success();

		AssertTextEquals(
			locator1 = "MPRegistrationConvertPaidDev#UPGRADE_STEP",
			value1 = "Pay the $99 annual fee. Launch promotion, fee waved for a limited time.");

		MPButton.cancel();

		AssertTextEquals(
			locator1 = "MPDeveloperAppsAdd#DETAILS",
			value1 = "App Details");
	}

}