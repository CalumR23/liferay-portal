<definition component-name="marketplace">
	<property name="testray.main.component.name" value="MarketplaceRegistration" />

	<var name="companyNameStatic" static="true" value="" />
	<var name="marketplaceRegisterDeveloperURL" static="true" value="" />
	<var name="marketplaceURL" static="true" value="" />

	<set-up>
		<var method="TestPropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />
		<var method="StringUtil#randomString(5)" name="rndString" />

		<var name="companyNameStatic" value="QA.Company.${rndString}" />
		<var name="marketplaceRegisterDeveloperURL" value="${marketplaceURL}/become-a-developer" />

		<execute macro="MPUser#login">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />
	</set-up>

	<tear-down>
		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.5')" name="userPassword"  />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdminNavigator#gotoAdminTab">
			<var name="adminTab" value="Developers" />
		</execute>

		<execute macro="MarketplaceAdmin#teardownCompany">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceRegistration#tearDownJoinCompany">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MPUser#logout" />
	</tear-down>

	<command name="EditSubmission" priority="5">
		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />
		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />

		<execute macro="MarketplaceRegistration#registerNewCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a company description." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />
		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />
		<execute function="AssertTextPresent" locator1="MPRegistration#PENDING_REGISTRATIONS" value1="Pending Registrations" />

		<execute macro="MarketplaceRegistration#editCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is an edited company description." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
		</execute>

		<execute macro="MarketplaceRegistration#viewCompanyProfile">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is an edited company description." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
		</execute>
	</command>

	<command name="JoinCompany" priority="5">
		<execute macro="MarketplaceRegistration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test for joining a company." />
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />

		<execute macro="MarketplaceRegistration#searchForCompany">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceRegistration#requestJoinCompany" >
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.1')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.1')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceRegistration#confirmMembershipRequest">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
		</execute>
	</command>

	<command name="RegisterCompanyPaid" priority="5">
		<execute macro="MarketplaceRegistration#setupCompany">
			<var name="companyAddress" value="123 A St" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute macro="MPButton#addNewApp" />

		<execute macro="MarketplaceRegistration#convertToPaidDeveloperAccount">
			<var name="companyName" value="${companyNameStatic}" />
			<var method="TestPropsUtil#get('marketplace.email.address.3')" name="userEmailAddress"  />
		</execute>
	</command>

	<command name="RegisterDuplicateCompany" priority="5">
		<execute macro="MarketplaceRegistration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test to create a duplicate company." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />
		<execute function="Click" locator1="MPRegistration#CREATE_COMPANY_ACCOUNT_BUTTON" />
		<execute function="Click" locator1="MPRegistrationCompany#REGISTER_BUTTON" />

		<execute macro="MarketplaceRegistrationEntry#registerCompanyForm">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test to create a duplicate company." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute function="ScrollWebElementIntoView" locator1="MPRegistrationCompany#SUBMIT_REQUEST"  />
		<execute function="Click" locator1="MPRegistrationCompany#SUBMIT_REQUEST" />

		<execute function="AssertTextEquals" locator1="MPMessage#FAIL_MESSAGE" value1="Your request failed to complete." />
		<execute function="AssertTextEquals" locator1="MPRegistrationCompany#DUPLICATE_COMPANY_ERROR_MESSAGE" value1="Your company is already registered." />
	</command>

	<command name="RegisterNewCompany" priority="5">
		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />

		<execute macro="MarketplaceRegistration#searchForCompany">
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="MarketplaceRegistration#registerNewCompany">
			<var name="companyAddress" value="123 A St" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>
	</command>

	<command name="RegisterPaidCompanyCancel" priority="5">
		<execute macro="MarketplaceRegistration#setupCompany">
			<var name="companyAddress" value="123 Main Street" />
			<var name="companyCity" value="Los Angeles" />
			<var name="companyCountry" value="United States" />
			<var name="companyDescription" value="This is a test." />
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="companyEmail" />
			<var name="companyIcon" value="Document_3.png" />
			<var name="companyName" value="${companyNameStatic}" />
			<var name="companyPhone" value="555-555-5555" />
			<var name="companyPostalCode" value="90210" />
			<var name="companyRegion" value="California" />
			<var name="companyTaxDocument" value="Document_1.pdf" />
			<var name="companyTaxType" value="Other" />
		</execute>

		<execute macro="MPUser#logoutAndLogin">
			<var method="TestPropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="TestPropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceNavigationBar#gotoCompanyAccount" >
			<var name="companyName" value="${companyNameStatic}" />
		</execute>

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Click" locator1="MPButton#ADD_NEW_APP_BUTTON" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Upload the required tax form and confirm your contact information to receive payments." />

		<execute macro="MarketplaceRegistrationEntry#registerPaidDeveloperForm">
			<var name="companyName" value="${companyNameStatic}" />
			<var name="developerAddress" value="123 A St" />
			<var name="developerCity" value="Los Angeles" />
			<var name="developerCountry" value="United States" />
			<var name="developerFirstName" value="LiferayQA1" />
			<var name="developerLastName" value="Marketplace" />
			<var name="developerMiddleName" value="Test" />
			<var name="developerPostalCode" value="90210" />
			<var name="developerRegion" value="California" />
			<var name="developerTaxDocument" value="Document_1.pdf" />
			<var name="developerTaxType" value="Other" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Confirm or create a PayPal account to receive payments." />

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#requestFailed" />

		<execute function="Click" locator1="MPRegistrationDeveloper#BACK_BUTTON" />

		<execute function="AssertTextEquals" locator1="MPDeveloperAppsAdd#DETAILS" value1="App Details" />

		<execute function="Click" locator1="MPDeveloperAppsAddDetails#UPGRADE" />

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Enroll Now" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Upload the required tax form and confirm your contact information to receive payments." />

		<execute macro="MarketplaceRegistrationEntry#registerPaidDeveloperForm">
			<var name="companyName" value="${companyNameStatic}" />
			<var name="developerAddress" value="123 A St" />
			<var name="developerCity" value="Los Angeles" />
			<var name="developerCountry" value="United States" />
			<var name="developerFirstName" value="LiferayQA1" />
			<var name="developerLastName" value="Marketplace" />
			<var name="developerMiddleName" value="Test" />
			<var name="developerPostalCode" value="90210" />
			<var name="developerRegion" value="California" />
			<var name="developerTaxDocument" value="Document_1.pdf" />
			<var name="developerTaxType" value="Other" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Confirm or create a PayPal account to receive payments." />

		<execute macro="MarketplaceRegistrationEntry#paypalAccountForm">
			<var method="TestPropsUtil#get('marketplace.email.address.3')" name="paypalEmailAddress"  />
			<var name="paypalFirstName" value="Joe" />
			<var name="paypalLastName" value="WrongName" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#requestFailed" />

		<execute macro="MPButton#button1">
			<var name="buttonName" value="Back" />
		</execute>

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Upload the required tax form and confirm your contact information to receive payments." />

		<execute macro="MarketplaceRegistrationEntry#registerPaidDeveloperForm">
			<var name="companyName" value="${companyNameStatic}" />
			<var name="developerAddress" value="123 A St" />
			<var name="developerCity" value="Los Angeles" />
			<var name="developerCountry" value="United States" />
			<var name="developerFirstName" value="LiferayQA1" />
			<var name="developerLastName" value="Marketplace" />
			<var name="developerMiddleName" value="Test" />
			<var name="developerPostalCode" value="90210" />
			<var name="developerRegion" value="California" />
			<var name="developerTaxDocument" value="Document_1.pdf" />
			<var name="developerTaxType" value="Other" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Confirm or create a PayPal account to receive payments." />

		<execute macro="MarketplaceRegistrationEntry#paypalAccountForm">
			<var method="TestPropsUtil#get('marketplace.email.address.3')" name="paypalEmailAddress"  />
			<var name="paypalFirstName" value="Joe" />
			<var name="paypalLastName" value="Bloggs" />
		</execute>

		<execute macro="MPButton#next" />

		<execute macro="MPMessage#success" />

		<execute function="AssertTextEquals" locator1="MPRegistrationConvertPaidDev#UPGRADE_STEP" value1="Pay the $99 annual fee. Launch promotion, fee waved for a limited time." />

		<execute macro="MPButton#cancel" />

		<execute function="AssertTextEquals" locator1="MPDeveloperAppsAdd#DETAILS" value1="App Details" />
	</command>
</definition>