@component-name = "marketplace"
definition {

	property testray.main.component.name = "MarketplaceRegistration";

	static var marketplaceRegisterDeveloperURL = "";
	static var marketplaceURL = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");

		var marketplaceRegisterDeveloperURL = "${marketplaceURL}/become-a-developer";

		MPUser.login(
			userEmailAddress = PropsUtil.get("marketplace.email.address.2"),
			userPassword = PropsUtil.get("marketplace.email.password.2"));

		Open(locator1 = "${marketplaceURL}");
	}

	tearDown {
		Open(locator1 = "${marketplaceURL}");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.5"),
			userPassword = PropsUtil.get("marketplace.email.password.5"));

		MarketplaceAdminNavigator.gotoMPAdmin();

		MarketplaceAdmin.tearDownPaidRegistration(
			developerName = "LiferayQA1 Marketplace",
			developerType = "User",
			searchKeywords = "QA");

		MPUser.logout();
	}

	@priority = "5"
	test RegisterDeveloperFree {
		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		MarketplaceRegistration.registerNewDeveloper(
			developerCountry = "United States",
			developerPhone = "555-555-5555");
	}

	@priority = "5"
	test RegisterDeveloperPaid {
		Open(locator1 = "${marketplaceRegisterDeveloperURL}");

		MarketplaceRegistration.registerNewDeveloper(
			developerCountry = "United States",
			developerPhone = "555-555-5555");

		Open(locator1 = "${marketplaceURL}");

		MarketplaceNavigationBar.gotoAccountHome();

		AccountNavigator.gotoDevSidebar(devSidebarItem = "Apps");

		Click(locator1 = "MPButton#ADD_NEW_APP_BUTTON");

		MarketplaceRegistration.convertToPaidDeveloperAccount(userEmailAddress = PropsUtil.get("marketplace.email.address.3"));

		AccountAppAddEntry.checkPricing(isFreePaid = "paid-license");

		AssertChecked(
			key_isFreePaid = "paid-license",
			locator1 = "MPDeveloperAppsAddDetails#PRICE_RADIO");
	}

}