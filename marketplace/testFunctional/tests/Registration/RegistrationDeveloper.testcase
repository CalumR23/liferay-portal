<definition component-name="marketplace">
	<property name="testray.main.component.name" value="MarketplaceRegistration" />

	<var name="marketplaceRegisterDeveloperURL" static="true" value="" />
	<var name="marketplaceURL" static="true" value="" />

	<set-up>
		<var method="PropsUtil#get('portal.marketplace.url')" name="marketplaceURL" />

		<var name="marketplaceRegisterDeveloperURL" value="${marketplaceURL}/become-a-developer" />

		<execute macro="MPUser#login">
			<var method="PropsUtil#get('marketplace.email.address.2')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.2')" name="userPassword" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />
	</set-up>

	<tear-down>
		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MPUser#logoutAndLogin">
			<var method="PropsUtil#get('marketplace.email.address.5')" name="userEmailAddress" />
			<var method="PropsUtil#get('marketplace.email.password.5')" name="userPassword" />
		</execute>

		<execute macro="MarketplaceAdminNavigator#gotoMPAdmin" />

		<execute macro="MarketplaceAdmin#tearDownPaidRegistration">
			<var name="developerName" value="LiferayQA1 Marketplace" />
			<var name="developerType" value="User" />
			<var name="searchKeywords" value="QA" />
		</execute>

		<execute macro="MPUser#logout" />
	</tear-down>

	<command name="RegisterDeveloperFree" priority="5">
		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />

		<execute macro="MarketplaceRegistration#registerNewDeveloper">
			<var name="developerCountry" value="United States" />
			<var name="developerPhone" value="555-555-5555" />
		</execute>
	</command>

	<command name="RegisterDeveloperPaid" priority="5">
		<execute function="Open" locator1="${marketplaceRegisterDeveloperURL}" />

		<execute macro="MarketplaceRegistration#registerNewDeveloper">
			<var name="developerCountry" value="United States" />
			<var name="developerPhone" value="555-555-5555" />
		</execute>

		<execute function="Open" locator1="${marketplaceURL}" />

		<execute macro="MarketplaceNavigationBar#gotoAccountHome" />

		<execute macro="AccountNavigator#gotoDevSidebar">
			<var name="devSidebarItem" value="Apps" />
		</execute>

		<execute function="Click" locator1="MPButton#ADD_NEW_APP_BUTTON" />

		<execute macro="MarketplaceRegistration#convertToPaidDeveloperAccount">
			<var method="PropsUtil#get('marketplace.email.address.3')" name="userEmailAddress" />
		</execute>

		<execute macro="AccountAppAddEntry#checkPricing">
			<var name="isFreePaid" value="paid-license" />
		</execute>

		<execute function="AssertChecked" locator1="MPDeveloperAppsAddDetails#PRICE_RADIO">
			<var name="key_isFreePaid" value="paid-license" />
		</execute>
	</command>
</definition>