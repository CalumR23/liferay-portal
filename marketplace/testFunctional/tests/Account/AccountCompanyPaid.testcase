@component-name = "marketplace"
definition {

	property testray.main.component.name = "MarketplaceCompany";

	static var appTitleStatic = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");
		var rndString = StringUtil.randomString("8");

		var appTitleStatic = "QA.App.${rndString}";

		MPUser.login(
			userEmailAddress = PropsUtil.get("marketplace.email.address.6"),
			userPassword = PropsUtil.get("marketplace.email.password.6"));

		Open(locator1 = "${marketplaceURL}");

		MarketplaceRegistration.setupCompany(
			companyAddress = "123 A St",
			companyCity = "Los Angeles",
			companyCountry = "United States",
			companyDescription = "This is a test.",
			companyEmail = PropsUtil.get("marketplace.email.address.6"),
			companyIcon = "Document_3.png",
			companyName = "QA.Company",
			companyPhone = "555-555-5555",
			companyPostalCode = "90210",
			companyRegion = "California",
			companyTaxDocument = "Document_1.pdf",
			companyTaxType = "Other",
			key_companyName = "QA.Company");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.6"),
			userPassword = PropsUtil.get("marketplace.email.password.6"));

		Account.setupAcceptDeveloperTermsOfService(companyName = "QA.Company");
	}

	tearDown {
		Account.tearDownSubmittedApp(
			appTitleList = "${appTitleStatic}",
			companyNameList = "QA.Company");

		MPUser.logout();
	}

	@priority = "5"
	test AddPaidAppAsCompany {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "QA.Company");

		Account.addApp(
			addCountryList = "all",
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app1-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "paid-license",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "QA.Company");

		Account.editAppPaid(
			currency = "USD",
			developerLicensePriceList = "10.00",
			developerLicenseUnitsList = "1",
			licenseTerm = "Perpetual",
			standardLicensePriceList = "11.00",
			standardLicenseUnitsList = "1");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "QA.Company");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "QA.Company",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();
	}

}