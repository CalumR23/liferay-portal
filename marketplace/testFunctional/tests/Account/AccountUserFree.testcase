@component-name = "marketplace"
definition {

	property testray.main.component.name = "Marketplace";

	static var appTitleStatic = "";

	setUp {
		var marketplaceURL = PropsUtil.get("portal.marketplace.url");
		var rndString = StringUtil.randomString("8");

		var appTitleStatic = "QA.App.${rndString}";

		MPUser.login(
			userEmailAddress = PropsUtil.get("marketplace.email.address.6"),
			userPassword = PropsUtil.get("marketplace.email.password.6"));

		Open(locator1 = "${marketplaceURL}");
	}

	tearDown {
		Account.tearDownSubmittedApp(
			appTitleList = "${appTitleStatic}",
			companyNameList = "Account Home");

		MPUser.logout();
	}

	@priority = "5"
	test AddAppWithMultipleAppPackages {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay DXP: Digital Enterprise 7.0~com.example.test.app-1.0.0.jar,Liferay CE Portal 7.0 GA3~com.example.test.app-1.0.0.jar,Liferay Portal 6.2 EE GA1~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA6~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA5~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA4~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA3~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA2~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "1.0.0.0");

		AccountApp.reviewAppUploadedFiles(appPackageList = "Liferay DXP: Digital Enterprise 7.0~com.example.test.app-1.0.0.jar,Liferay CE Portal 7.0 GA3~com.example.test.app-1.0.0.jar,Liferay Portal 6.2 EE GA1~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA6~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA5~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA4~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA3~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA2~test-app2-portlet-6.2.0.3.war,Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war");

		AccountAppAdd.clickSubmit();
	}

	@priority = "5"
	test AddFreeAppAsUser {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();
	}

	@priority = "5"
	test AddFreeAppWithLabs {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		Account.editAppWithLabs();

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			labs = "true",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();
	}

	@priority = "5"
	test AddFreeAppWithScreenCaptures {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		Account.editAppWithScreenCaptures(screenCapturesList = "Document_1.jpg,Document_2.jpg,Document_3.jpg,Document_4.jpg");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();
	}

	@priority = "5"
	test AddFreeAppWithURLs {
		AccountNavigator.gotoDevelopmentAppsViaAccount(companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		Account.editAppWithURLs(
			documentationUrl = "http://www.liferay.com/documentation",
			sourceCodeUrl = "http://www.liferay.com/sourcecode");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			documentationUrl = "http://www.liferay.com/documentation",
			sourceCodeUrl = "http://www.liferay.com/sourcecode",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();
	}

	@priority = "5"
	test DiscardChanges {
		AccountNavigator.gotoDevelopmentAppsViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		Account.addApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			versionNumber = "1.0.0.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "1.0.0.0");

		AccountAppAdd.clickSubmit();

		Account.tearDownSubmittedApp(
			appTitleList = "${appTitleStatic}",
			companyNameList = "Account Home");
	}

	@priority = "5"
	test UpdateAppVersion {
		Account.setupAndSubmitApp(
			appCategory = "index=3",
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appIconFile = "marketplace_icon.png",
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			appTitle = "${appTitleStatic}",
			companyName = "Account Home",
			developerWebsiteUrl = "http://www.liferay.com/developer",
			doApprove = "true",
			isFreePaid = "free",
			supportUrl = "http://www.liferay.com/support",
			update = "true",
			versionNumber = "1.0.0.0");

		MPUser.logoutAndLogin(
			userEmailAddress = PropsUtil.get("marketplace.email.address.6"),
			userPassword = PropsUtil.get("marketplace.email.password.6"));

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "1.0.0.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		Account.editAppWithNewVersion(
			appPackageList = "Liferay Portal 6.2 CE GA1~test-app2-portlet-6.2.0.3.war",
			versionNumber = "2.1.3.0");

		AccountNavigator.gotoDevelopmentAppsAppTitleViaAccount(
			appTitle = "${appTitleStatic}",
			companyName = "Account Home");

		AccountApp.reviewAppDetails(
			appDescription = "Depth-first search (DFS) is an algorithm for traversing or searching tree or graph data structures. One starts at the root (selecting some arbitrary node as the root in the case of a graph) and explores as far as possible along each branch before backtracking. A version of depth-first search was investigated in the 19th century by French mathematician Charles Pierre Tremaux as a strategy for solving mazes.",
			appTitle = "${appTitleStatic}",
			companyName = "LiferayQA2 MarketplaceTesting",
			versionNumber = "2.1.3.0");

		AccountAppAdd.clickSubmit();
	}

}