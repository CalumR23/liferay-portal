<definition component-name="marketplace">
	<property name="testray.main.component.name" value="Marketplace" />

	<command name="ViewGrades" priority="5">
		<execute macro="Ssllabs#openSsllabs">
			<var name="serverDomain" value="liferay.com" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverGrade" value="A-" />
			<var name="serverIpAddress" value="173.196.212.15" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverGrade" value="A-" />
			<var name="serverIpAddress" value="38.75.15.21" />
		</execute>

		<execute macro="Ssllabs#openSsllabs">
			<var name="serverDomain" value="www.liferay.com" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverGrade" value="A" />
			<var name="serverIpAddress" value="38.75.15.57" />
		</execute>

		<execute macro="Ssllabs#viewGradePG">
			<var name="serverGrade" value="A" />
			<var name="serverIpAddress" value="173.196.212.35" />
		</execute>
	</command>
</definition>